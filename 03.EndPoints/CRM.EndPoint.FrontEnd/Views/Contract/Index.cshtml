<!-- Modal AddContractModal -->
<div class="modal fade bd-example-modal-lg" dir="ltr" id="AddContractModal" tabindex="-1" role="dialog" data-bs-focus="false" data-bs-backdrop="static" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class=" modal-dialog modal-dialog-centered modal-lg " style="width:100%">
        <div class="mycontainer modal-content col-12" style="padding:10px;direction:rtl">
