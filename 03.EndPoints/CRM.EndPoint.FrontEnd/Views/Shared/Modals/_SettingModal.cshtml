<!-- Modal BaseSetting -->
<div class="modal fade" id="BaseSetting" tabindex="-1" role="dialog" aria-labelledby="baseSettingTitle" data-bs-focus="false">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content col-12">
            <div class="modal-header">
                <h1 class="modal-title" id="baseSettingTitle">تنظیمات</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>

            <div class="modal-body">
                <div class="d-flex flex-column gap-1">
                    @if (User.IsAdmin()) {
                        <a class="buttonGreen-wide" asp-controller="Admin" asp-action="Index">
                            <i class="fa fa-user"></i>
                            کاربران
                        </a>
                    }
                    @if (User.IsAdmin() || User.IsTaminAdmin() || User.IsSalesAdmin() || User.IsFinancialAdmin()) {
                        <a class="buttonGreen-wide" asp-controller="BaseItem" asp-action="Index">
                            <i class="fa fa-building"></i>
                            اطلاعات پایه شرکت
                        </a>
                    }
                    @if (User.IsAdmin() || User.IsFinancial()) {
                        <a class="buttonGreen-wide" asp-controller="BaseItem" asp-action="Financial">
                            <svg style="width: 16px" viewBox="0 0 24 24" fill="currentColor"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M17.997 4.17a3 3 0 0 1 2.003 2.83v12a3 3 0 0 1 -3 3h-10a3 3 0 0 1 -3 -3v-12a3 3 0 0 1 2.003 -2.83a4 4 0 0 0 3.997 3.83h4a4 4 0 0 0 3.98 -3.597zm-5.997 5.83a1 1 0 0 0 -1 1v.05a2.5 2.5 0 0 0 .5 4.95h1a.5 .5 0 1 1 0 1h-2.5a1 1 0 0 0 0 2h1a1 1 0 0 0 2 0v-.05a2.5 2.5 0 0 0 -.5 -4.95h-1a.5 .5 0 1 1 0 -1h2.5a1 1 0 0 0 0 -2h-1a1 1 0 0 0 -1 -1m2 -8a2 2 0 1 1 0 4h-4a2 2 0 1 1 0 -4z" /></svg>
                            اطلاعات پایه مالی
                        </a>
                    }
                    @if (User.IsAdmin()) {
                        <a class="buttonGreen-wide" asp-controller="Asetting" asp-action="Index">
                            <i class="fa fa-cog"></i>
                            تنظیمات پایه
                        </a>
                    }
                    @if (User.IsAdmin()) {
                        <a class="buttonGreen-wide" asp-controller="Asetting" asp-action="RecycleBin">
                            <svg x="0px" y="0px" width="16" height="16" fill="currentColor" viewBox="0 0 48 48"><path d="M20 12.4L5.6 7.59 20 2.45zM43.1 8.99L26.49 14.56 23 13.4 23 2.41zM44.44 11.7L39.9 39.89c-.08.53-.46.98-.97 1.17l-10.94 3.93V17.22L44.44 11.7zM4.25 10.31l20.74 6.91v27.8L9.11 39.79c-.54-.18-.94-.65-1.01-1.22L4.25 10.31zM21.863 28.762l-.025-.077-1.422-2.889-2.543.725 2.007 4.145-2.331-.848-.075-1.191-1.33 2.353 1.68 3.418-.061-1.186 1.785.65c.025.012.05.022.074.031.181.066.343.042.452-.222l1.786-3.013c-.003.004-.007.008-.01.013C22.098 30.259 22.206 29.596 21.863 28.762zM8.92 22.287l.972.947L9.1 24.612c-.099.151-.135.341.08.735l1.99 4.094c.241.675.85 1.597 1.761 2.03l.063.031 2.545.926-.01-3.306-3.889-1.415 1.029-1.802.979.934-1.716-3.454L8.92 22.287zM18.706 25.264l1.325-2.332-.904.249-.992-2.02c-.093-.222-.228-.412-.51-.514-.033-.012-.067-.023-.104-.032l-3.573-1.301c-.018-.008-.036-.015-.052-.021-.037-.014-.068-.023-.09-.031l-.085-.031c-.018-.007-.036-.014-.054-.02-.568-.207-1.227-.216-1.593.269l-.031.049-1.116 1.965 2.756 2.654 1.67-2.705 1.21 2.47-.89.262L18.706 25.264z"></path></svg>
                            سطل زباله
                        </a>
                    }
                    @if (User.IsAdmin() || User.IsSalesAdmin()) {
                        <button class="buttonGreen-wide" onclick="showModalPhonebook()">
                            <svg style="width: 16px" fill="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" /></svg>
                            دفترچه تلفن
                        </button>
                    }
                    @if (User.IsAdmin()) {
                        <a class="buttonGreen-wide" asp-controller="Sms" asp-action="Index">
                            <svg style="width: 16px" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 2c-2.236 0-4.43.18-6.57.524C1.993 2.755 1 4.014 1 5.426v5.148c0 1.413.993 2.67 2.43 2.902 1.168.188 2.352.327 3.55.414.28.02.521.18.642.413l1.713 3.293a.75.75 0 0 0 1.33 0l1.713-3.293a.783.783 0 0 1 .642-.413 41.102 41.102 0 0 0 3.55-.414c1.437-.231 2.43-1.49 2.43-2.902V5.426c0-1.413-.993-2.67-2.43-2.902A41.289 41.289 0 0 0 10 2ZM6.75 6a.75.75 0 0 0 0 1.5h6.5a.75.75 0 0 0 0-1.5h-6.5Zm0 2.5a.75.75 0 0 0 0 1.5h3.5a.75.75 0 0 0 0-1.5h-3.5Z" clip-rule="evenodd" /></svg>
                            مدیریت پیامک
                        </a>
                    }
                    @if (User.IsAdmin()) {
                        <a class="buttonGreen-wide" asp-controller="ASetting" asp-action="ExternalSoftware">
                            <svg style="width: 16px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h6" /><path d="m21 3-9 9" /><path d="M15 3h6v6" /></svg>
                            ارتباطات
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
