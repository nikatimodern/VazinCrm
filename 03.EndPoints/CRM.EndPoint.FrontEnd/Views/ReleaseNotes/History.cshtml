@model List<CRM.Core.Domain.ReleaseNotes.Repositories.ReleaseNoteData>
@using CRM.Core.Domain.ReleaseNotes.Entities
@using CRM.Core.ApplicationServices.ReleaseNotes.Services
<section class="rn rn-page">
    <header class="rn-toolbar"><h1>تغییرات نسخه‌های سامانه</h1><span class="rn-muted">تازه‌ها، بهبودها و رفع اشکال‌ها</span></header>
    @if (Model.Count == 0) { <div class="rn-empty">هنوز تغییری برای نمایش وجود ندارد.</div> }
    @foreach (var note in Model) {
        <article class="rn-release">
            <header><span class="rn-version" dir="ltr">@note.Version</span><h2>@note.Title</h2>
                @if (note.IsImportant) { <span class="rn-tag">مهم</span> }
                <time>@CRM.Framework.BaseServices.GetDatePersian(note.PublishDate) <span class="rn-muted">UTC</span></time>
            </header>
            <p class="rn-description">@note.Description</p>
            @foreach (var item in note.Items) {
                <section class="rn-item"><span class="rn-tag rn-type-@((int)item.Type)">@(item.Type == ReleaseNoteItemType.NewFeature ? "قابلیت جدید" : item.Type == ReleaseNoteItemType.Improvement ? "بهبود" : "رفع اشکال")</span>
                    <h3>@item.Title</h3><p class="rn-description">@item.Description</p>
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl) && ReleaseNoteAdministration.SafeUrl(item.ImageUrl)) { <img src="@item.ImageUrl" loading="lazy" alt="@item.Title" referrerpolicy="no-referrer" /> }
                    @if (!string.IsNullOrWhiteSpace(item.LearnMoreUrl) && ReleaseNoteAdministration.SafeUrl(item.LearnMoreUrl)) { <a href="@item.LearnMoreUrl" target="_blank" rel="noopener noreferrer">بیشتر بدانید ↗</a> }
                </section>
            }
        </article>
    }
</section>
@section Scripts { <script src="~/js/releaseNotesHistory.js?release=7.0.5" asp-append-version="true"></script> }
