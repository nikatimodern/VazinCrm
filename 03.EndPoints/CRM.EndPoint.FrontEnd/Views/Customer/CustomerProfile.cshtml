@model CRM.EndPoint.FrontEnd.Models.Customer.CustomerPanelVModel

<div id="customerProfile-wrapper" class="d-flex flex-column" style="height: calc(100dvh - 88px);">
    <div class="d-flex col-12 flex-wrap gap-1 flex-xxl-column fbold pb-1 pb-xxl-0">
        <div class="d-flex" style=" justify-content:start; flex-direction:column;font-size:clamp(14px,2vw,18px)">
            <p>@Model.CustomerName</p>
        </div>
        @if (User.IsAdmin() || User.IsSalesAdmin()) {
            <div class="d-flex align-items-center justify-content-end justify-content-xxl-start gap-1 flex-grow-1 flex-xxl-grow-0" style="font-size:clamp(11px,2vw,13px)">
                <span>در اختیار: </span>
                <span>@Model.SelExpertRel</span>
            </div>
        }
    </div>

    <div class="flex-grow-1" style="width:100%; display:flex; flex-direction:column; align-items:center;overflow: hidden;">


        <ul class="nav nav-tabs" id="TabFactors" role="tablist" style="display: none;">
            <li class="nav-item" role="presentation">
                <button class="nav-link active text-dark" style="margin-bottom:-2px;isolation:auto" id="preFactorTab" data-bs-toggle="tab" data-bs-target="#preFactorTab-pane" type="button" role="tab" aria-controls="preFactorTab-pane" aria-selected="true">پیش فاکتورها</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link text-dark" style="margin-bottom:-2px;isolation:auto" id="factorTab" data-bs-toggle="tab" data-bs-target="#factorTab-pane" type="button" role="tab" aria-controls="factorTab-pane" aria-selected="false">فاکتورها</button>
            </li>
        </ul>


        <div class="parent-factors tab-content mt-xxl-2 gap-2" id="tabContentFactors" style=" width:100%; justify-content:space-between;display:flex;min-height: 0; ">
            <div class="tab-pane fade show active border-0 flex-grow-1" id="preFactorTab-pane" role="tabpanel" aria-labelledby="preFactorTab" tabindex="0" style="display: flex;flex-direction:column;width:100%">
                <div class="mb-1 justify-content-between px-2" style="display:flex; width:100%">
                    <div class="mp d-flex align-items-center gap-3">
                        <label class="d-none d-xxl-inline-block fbold" style="font-size:20px">پیش فاکتورها</label>

                        <button class="showDeletedPrefactor-icon ms-1">
                            <svg class="closedEye-icon" style="width:16px" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3.28 2.22a.75.75 0 0 0-1.06 1.06l14.5 14.5a.75.75 0 1 0 1.06-1.06l-1.745-1.745a10.029 10.029 0 0 0 3.3-4.38 1.651 1.651 0 0 0 0-1.185A10.004 10.004 0 0 0 9.999 3a9.956 9.956 0 0 0-4.744 1.194L3.28 2.22ZM7.752 6.69l1.092 1.092a2.5 2.5 0 0 1 3.374 3.373l1.091 1.092a4 4 0 0 0-5.557-5.557Z" clip-rule="evenodd" /><path d="m10.748 13.93 2.523 2.523a9.987 9.987 0 0 1-3.27.547c-4.258 0-7.894-2.66-9.337-6.41a1.651 1.651 0 0 1 0-1.186A10.007 10.007 0 0 1 2.839 6.02L6.07 9.252a4 4 0 0 0 4.678 4.678Z" /></svg>
                            <svg class="openEye-icon d-none" style="width:16px" viewBox="0 0 20 20" fill="currentColor"><path d="M10 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z" /><path fill-rule="evenodd" d="M.664 10.59a1.651 1.651 0 0 1 0-1.186A10.004 10.004 0 0 1 10 3c4.257 0 7.893 2.66 9.336 6.41.147.381.146.804 0 1.186A10.004 10.004 0 0 1 10 17c-4.257 0-7.893-2.66-9.336-6.41ZM14 10a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z" clip-rule="evenodd" /></svg>
                        </button>
                    </div>

                    @*<div class="me-1 parentPlusAdd text-end" onclick="showModalAddPfactor(1, '@Model.CustomerId')">
                        <svg style="width: 20px;cursor: pointer" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                    </div>*@

                </div>
                <div class="InfoData" style="width:100%;overflow:auto;" id="PreFactorDivList">
                </div>
            </div>

            <div class="tab-pane fade border-0 flex-grow-1" id="factorTab-pane" role="tabpanel" aria-labelledby="factorTab" tabindex="0" style="display: flex;flex-direction:column;width:100%">
                <div style="display:none;flex-direction:column;justify-content:center;width:100%;min-height: 0;" id="DivFacListId">
                    <div class="fbold mb-1 px-2" id="FactorDivTitleId">
                    </div>
                    <div class="InfoData" style=" width:100%;overflow:auto;" id="DetailDivList">
                    </div>
                </div>
            </div>
        </div>

    </div>

    <partial name="_CustomerFinancialSummaryPartial" />
</div>


<partial name="~/Views/Factor/Modals/_FactorModal.cshtml" />
<partial name="~/Views/Factor/Modals/_FactorSepidarModal.cshtml" />

<partial name="~/Views/PreFactor/Modals/_PreFactorModal.cshtml" />
<partial name="~/Views/PreFactor/Modals/_DeliverModal.cshtml" />
<partial name="~/Views/PreFactor/Modals/_PreFactorAttachmentsModal.cshtml" />
<partial name="~/Views/PreFactor/Modals/_PreFactorMobileModal.cshtml" />
<partial name="~/Views/PreFactor/Modals/_PreFactorChangeUsersModal.cshtml" />

<partial name="~/Views/Order/Modals/_UndeliveredOrderHeadsModal.cshtml" />
<partial name="~/Views/Order/Modals/_CreateOrderModal.cshtml" />

<partial name="~/Views/Accountancy/Modals/_InvoiceListModal.cshtml" />

@section scripts {
    <script>
        customerId = '@Model.CustomerId';
    </script>
    <script src="~/js/customerProfile.js" asp-append-version="true"></script>
}


