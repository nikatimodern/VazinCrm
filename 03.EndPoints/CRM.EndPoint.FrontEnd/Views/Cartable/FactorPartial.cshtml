@using CRM.Core.Domain.Factors.Enum
@model CRM.EndPoint.FrontEnd.Models.Factor.FactorsViewModel ;

@{
    Layout = null;
}
<div style="width:100%;display:flex;flex-direction:column;gap:5px;">
    @foreach (var item in Model.factors.OrderByDescending(f => f.ModifyDate)) {
        <div class="mp" style=" width:100%;display:flex;">
            @if (item.OfficialType == 1) {
                <div class="mp InfoDataHead_PrefactorRasmi" style="display:flex;width:24px !important">
                    <label style="transform: rotate(90deg)">رسمی</label>
                </div>
            } else {
                <div class="mp InfoDataHead_PrefactorNonRasmi" style="display:flex;width:24px !important">
                    <label style="transform: rotate(90deg)">غیررسمی</label>
                </div>
            }
            @if (item.Export == true) {
                <div class=" " style="background-color:lightgreen;border-block: 2px solid darkgreen; width:24px; display:flex;flex-direction:column;align-items:center;justify-content:space-evenly">
                    <label style="font-family:'IRANSansBold'; transform: rotate(90deg)">صـادراتی</label>
                </div>
            }


            <div class="d-flex flex-column flex-sm-row justify-content-between InfoDataItem_Prefactor w-100 py-2">

                <div class="mp flex-column flex-md-row" style=" display:flex;justify-content:space-between; width:100%;direction:rtl;">

                    <div class="col-12 col-md-4 d-flex flex-row flex-md-column flex-wrap gap-md-2 px-2 justify-content-around" style="row-gap:.5rem;column-gap:1rem;">

                        <div class="justify-content-between" style=" display:flex;align-items:center;gap:6px">
                            <label style="color:gray">سریال:</label>
                            <label style="font-family:'IRANSansBold'">@item.SerialNumber</label>
                        </div>
                        <div class="justify-content-between" style="display:flex;align-items:center;gap:6px">
                            <label style="color:gray">پیش فاکتور:</label>
                            @if (ViewBag.PassType == 0) {
                                <label class="hoverLink" style="font-family:'IRANSansBold';" onclick="showPrefac('@item.PfactorSerialNumber')">@item.PfactorSerialNumber</label>
                            } else {
                                <label style="font-family:'IRANSansBold';">@item.PfactorSerialNumber</label>
                            }
                        </div>
                        @if (Model._Setting.Sepidar == true) {
                            <div class="justify-content-between flex-wrap" style="display:flex;align-items:center;gap:6px">
                                <label style="color:gray">فاکتور مالی :</label>

                                @if (item.SnFinancial == null) {
                                    if (item.status == FactorStatus.ابطال_شده) {
                                        <label class="fbold">ابطال شده</label>
                                    } else {
                                        if (Model.Rols.Contains("کارشناس مالی") || Model.Rols.Contains("مدیر مالی") || Model.Rols.Contains("مدیر ارشد")) {
                                            <button class="fMedium buttonBlue" style="padding: 2px 6px;font-size: 12px;" onclick="showSepidarFactorsModal('@item.PfactorSerialNumber', '@item.Id', @ViewBag.PassType,'@item.DealId')">
                                                انتخاب از سپیدار
                                            </button>
                                        } else {
                                            <span>-</span>
                                        }

                                    }
                                } else {
                                    if (Model.Rols.Contains("کارشناس مالی") || Model.Rols.Contains("مدیر مالی") || Model.Rols.Contains("مدیر ارشد")) {
                                        <label class="fbold hoverLink" onclick="showSepidarFactorsModal('@item.PfactorSerialNumber', '@item.Id', @ViewBag.PassType,'@item.DealId')">@item.SnFinancial</label>
                                    } else {
                                        <label class="fbold">@item.SnFinancial</label>
                                    }
                                }

                            </div>
                        }

                        <div class="justify-content-between" style="display:flex;align-items:center; gap:6px">
                            <label style="color:gray">تاریخ:</label>
                            <label style="font-family:'IRANSansBold'">@item.Date</label>
                        </div>

                    </div>

                    <div class="d-md-none my-2 " style="background-color: rgba(0, 0, 0, 0.15); width: 85%;height:1px;margin-inline:auto"></div>

                    <div class="col-12 col-md-5 flex-wrap flex-row flex-md-column gap-2 px-2 justify-content-around" style="text-align:center; display:flex;align-items:center">
                        @*                         <div style="width:100%;display:flex;justify-content:space-between">
                            <label style="width:20%;">کد مشتری:</label>
                            <label style="width:80%;text-align:center; font-family:'IRANSansBold'"> </label>
                        </div> *@
                        <div style=" display:flex;align-items:center;gap:6px">
                            <label style="color:gray">شرکت:</label>
                            <label style="text-align:center; font-family:'IRANSansBold'">@(string.IsNullOrEmpty(item.Customer) ? "-" : item.Customer)</label>
                        </div>
                        <div style=" display:flex;align-items:center; gap:6px">
                            <label style="color:gray">نماینده:</label>
                            <label style="text-align:center; font-family:'IRANSansBold'">@(string.IsNullOrEmpty(item.AgentName) ? "-" : item.AgentName)</label>
                        </div>
                        <div style=" display:flex;align-items:center; gap:6px">
                            <label style="color:gray">کارشناس فروش:</label>
                            <label style="text-align:center; font-family:'IRANSansBold'">@item.SelerFullName</label>
                        </div>
                        <div class="flex-row " style=" display:flex;align-items:center; justify-content:center;gap:6px;">
                            <label style="color:gray">ثبت شده توسط:</label>
                            <label style="font-family:'IRANSansBold'">@item.UserCreator</label>
                        </div>
                    </div>

                    <div class="d-md-none my-2 " style="background-color: rgba(0, 0, 0, 0.15); width: 85%;height:1px;margin-inline:auto"></div>

                    <div class="col-12 col-md-3 flex-md-column justify-content-md-evenly px-3" style="text-align:center; display:flex;align-items:center;justify-content:center;column-gap:24px;row-gap:8px">
                        <div class="flex-row flex-md-column" style=" display:flex;align-items:center; justify-content:center;gap:6px">
                            <label style="color:gray">مبلغ:</label>
                            <label style="font-family:'IRANSansBold'">@string.Format("{0:n0}", item.PaymentAmount) <span style="font-size: 12px"> @(item.CurrencyTypeTxt ?? "ريال")</span></label>
                        </div>
                        <div class="d-flex align-items-center gap-1 gap-md-2">
                            @if (Model._Setting.FactorTowStep == true) {
                                if (item.status == FactorStatus.در_دست_تایید) {
                                    if (Model.Rols.Contains("کارشناس مالی") || Model.Rols.Contains("مدیر مالی") || Model.Rols.Contains("مدیر ارشد")) {
                                        <button class="buttonCancel3" style="font-size: 13px;" onclick="acceptFactor('@item.Id', 3, @ViewBag.PassType, '@item.PfactorSerialNumber', '@item.DealId')">
                                            ابطال
                                        </button>
                                        <button class="buttonGray" style="font-size: 13px;" onclick="acceptFactor('@item.Id', 2, @ViewBag.PassType, '@item.PfactorSerialNumber', '@item.DealId')">
                                            تایید
                                        </button>
                                    } else {
                                        <div class="fbold" style="color:#CC9900">
                                            در دست تایید
                                        </div>
                                    }
                                } else if (item.status == FactorStatus.تایید_شده) {
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="fbold" style="color:darkgreen">
                                            تایید شده
                                        </div>
                                        @if (Model.Rols.Contains("کارشناس مالی") || Model.Rols.Contains("مدیر مالی") || Model.Rols.Contains("مدیر ارشد")) {
                                            <div style="cursor:pointer;color:#333" onclick="acceptFactor('@item.Id', 1, @ViewBag.PassType, '@item.PfactorSerialNumber', '@item.DealId')" data-title="بازگشت">
                                                <svg style="width:16px;height:16px"  fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m15 15 6-6m0 0-6-6m6 6H9a6 6 0 0 0 0 12h3" /></svg>
                                            </div>
                                        }
                                    </div>
                                } else {
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="fbold" style="color:darkred">
                                            ابطال شده
                                        </div>
                                        @if ((Model.Rols.Contains("کارشناس مالی") || Model.Rols.Contains("مدیر مالی") || Model.Rols.Contains("مدیر ارشد"))) {
                                            <div style="cursor:pointer;color:#333" onclick="acceptFactor('@item.Id', 1, @ViewBag.PassType, '@item.PfactorSerialNumber', '@item.DealId')" data-title="بازگشت">
                                                <svg style="width:16px;height:16px"  fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m15 15 6-6m0 0-6-6m6 6H9a6 6 0 0 0 0 12h3" /></svg>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                    <div class="d-sm-none mt-2" style="background-color: rgba(0, 0, 0, 0.15); width: 85%;height:1px;margin-inline:auto"></div>
                </div>

                <div class="flex-row flex-sm-column mt-2 mt-sm-0 mx-0 mx-sm-2 align-items-center" style=" display:flex; justify-content:space-evenly !important;row-gap:8px;font-size:15px">

                    <button class="mp d-flex justify-content-center align-items-center" data-title-right="نمایش فاکتور" style="color:var(--DarkColor); border:none;background-color:transparent" onclick="ShowPreviewFactor('@item.Id')">
                        <i class="mp fa fa-eye"></i>
                    </button>
                    @if (item.CustomerId != null) {
                        <button class="mp d-flex justify-content-center align-items-center" data-title-right="پروفایل" style="color:var(--DarkColor); border:none;background-color:transparent" onclick="openCustomerProfile('@item.CustomerId')">
                            <i class="mp fa fa-user"></i>
                        </button>
                    }
                    @if (Model.Rols.Contains("کارشناس مالی") || Model.Rols.Contains("مدیر مالی") || Model.Rols.Contains("مدیر ارشد")) {
                        <button class="mp d-flex justify-content-center align-items-center" data-title-right="ویرایش" style="color:var(--DarkColor); border:none;background-color:transparent" onclick="upfactor('@item.Id','@item.CustomerId',@ViewBag.PassType)">
                            <i class="mp fa fa-pencil"></i>
                        </button>
                        if (Model.Rols.Contains("مدیر ارشد")) {
                            <button class="mp d-flex justify-content-center align-items-center" data-title-right="حذف" style="color:var(--DarkColor); border:none;background-color:transparent" onclick="delFactor('@item.Id',@ViewBag.PassType,'@item.DealId')">
                                <i class="mp fa fa-trash"></i>
                            </button>
                        }
                    }

                    @*<button class="mp" style="color:var(--DarkColor); border:none;background-color:transparent" onclick="AttachDoc('@item.Id')"><i style="font-size:20px" class="mp fa fa-paperclip"></i></button>*@
                </div>
            </div>
        </div>
    }
</div>
