@{
    Layout = "_LoginLayout";
}

@model CRM.EndPoint.FrontEnd.Models.Login.LoginModel

<div class="erp-auth-content">
    <header class="erp-auth-heading">
        <h1>ورود به سامانه</h1>
    </header>

    <nav class="erp-auth-tabs" aria-label="روش ورود">
        <a asp-controller="Account" asp-action="OtpLogin">ورود با کد یکبارمصرف</a>
        <a asp-controller="Account" asp-action="Login" aria-current="page">ورود با نام کاربری</a>
    </nav>

    <div class="w-100">
        <div class="content__error" id="recaptcha_msg" role="status"></div>
        <form id="loginForm">
            <input type="hidden" name="returnUrl" id="returnUrl" value="@ViewBag.returnUrl" />
            @Html.AntiForgeryToken()

            <div class="form-group" id="email_group">
                <label class="erp-auth-label" for="erpUserName">نام کاربری</label>
                <div class="erp-login-field">
                    <span class="form-group__icon" aria-hidden="true">
                        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.5 20.12a7.5 7.5 0 0 1 15 0 17.9 17.9 0 0 1-15 0Z"/>
                        </svg>
                    </span>
                    <input id="erpUserName" name="userName" type="text" placeholder="نام کاربری خود را وارد کنید"
                           autocomplete="username" autofocus class="form-group__input form-group__input--ltr" value="" />
                </div>
            </div>

            <div class="form-group" id="password_group">
                <label class="erp-auth-label" for="passwordInput">رمز عبور</label>
                <div class="erp-login-field">
                    <button type="button" class="form-group__icon erp-password-icon" id="togglePassword" aria-label="نمایش یا مخفی کردن رمز عبور">
                        <svg id="eyeClosedPassword" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.04 12.32a1 1 0 0 1 0-.64C3.42 7.51 7.36 4.5 12 4.5s8.57 3.01 9.96 7.18a1 1 0 0 1 0 .64C20.58 16.49 16.64 19.5 12 19.5s-8.58-3.01-9.96-7.18Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
                        </svg>
                        <svg id="eyeOpenPassword" style="display:none" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.22A10.48 10.48 0 0 0 1.93 12c1.29 4.34 5.31 7.5 10.07 7.5.99 0 1.95-.14 2.86-.4M6.23 6.23A10.45 10.45 0 0 1 12 4.5c4.76 0 8.77 3.16 10.07 7.5a10.5 10.5 0 0 1-4.3 5.77M3 3l18 18"/>
                        </svg>
                    </button>
                    <input id="passwordInput" name="password" type="password" placeholder="رمز عبور خود را وارد کنید"
                           autocomplete="current-password" class="form-group__input form-group__input--ltr" value="" />
                </div>
            </div>

            <button type="submit" class="buttonGreen2 login-btn erp-auth-primary" id="login_button">
                <span>ورود به سامانه</span>
                <div class="spinner-border spinner-border-sm d-none ms-2" role="status"></div>
            </button>
        </form>

        <div class="erp-auth-links">
            <a asp-controller="Account" asp-action="OtpLogin" asp-route-type="Forgot">رمز عبور را فراموش کرده‌اید؟</a>
        </div>
        <div class="errorLoginText" id="LoginMsg" role="alert" aria-live="polite"></div>
    </div>
</div>

@section Scripts {
    <script>
        const loginButton = document.getElementById("login_button");
        document.getElementById("togglePassword").addEventListener("click", function () {
            const passwordInput = document.getElementById("passwordInput");
            const eyeOpen = document.getElementById("eyeOpenPassword");
            const eyeClosed = document.getElementById("eyeClosedPassword");

            if (passwordInput.type === "password") {
                passwordInput.type = "text";
                eyeOpen.style.display = "block";
                eyeClosed.style.display = "none";
            } else {
                passwordInput.type = "password";
                eyeOpen.style.display = "none";
                eyeClosed.style.display = "block";
            }
        });

        const loginMsgElm = document.getElementById("LoginMsg");
        let passwordLockoutInterval;
        let submitting = false;

        function displayPasswordLockout(seconds) {
            clearInterval(passwordLockoutInterval);
            const endsAt = Date.now() + seconds * 1000;
            const render = () => {
                const remaining = Math.max(0, Math.ceil((endsAt - Date.now()) / 1000));
                if (remaining > 0) {
                    loginMsgElm.innerText = `ورود با رمز عبور مسدود است. ${remaining} ثانیه دیگر تلاش کنید.`;
                    loginButton.disabled = true;
                } else {
                    clearInterval(passwordLockoutInterval);
                    loginMsgElm.innerText = "";
                    if (!submitting) loginButton.disabled = false;
                }
            };
            render();
            passwordLockoutInterval = setInterval(render, 1000);
        }

        document.getElementById("loginForm").addEventListener("submit", async (e) => {
            e.preventDefault();
            if (submitting || loginButton.disabled) return;
            submitting = true;
            toggleElementsDisabled(loginButton);
            loginButton.querySelector(".spinner-border").classList.remove("d-none");

            const model = {
                userName: e.target.userName.value,
                password: e.target.password.value,
                returnUrl: e.target.returnUrl.value,
            };

            try {
                const res = await fetch("/Account/Login", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "RequestVerificationToken": e.target.__RequestVerificationToken.value,
                    },
                    body: JSON.stringify(model),
                });
                const data = await res.json();
                loginMsgElm.innerText = "";

                if (res.ok) {
                    goTo(data.url);
                    return;
                }

                if (res.status === 429 && data.retryAfterSeconds > 0) {
                    displayPasswordLockout(data.retryAfterSeconds);
                } else if (res.status === 405 && Array.isArray(data.errors)) {
                    data.errors.forEach(err => {
                        const pElm = document.createElement("p");
                        pElm.innerText = err;
                        loginMsgElm.appendChild(pElm);
                    });
                } else {
                    loginMsgElm.innerText = data.message || "ورود انجام نشد.";
                }
            } catch {
                loginMsgElm.innerText = "ارتباط با سرور برقرار نشد. دوباره تلاش کنید.";
            } finally {
                submitting = false;
                toggleElementsDisabled(loginButton, false);
                loginButton.querySelector(".spinner-border").classList.add("d-none");
                if (passwordLockoutInterval) {
                    // The server remains authoritative even if the browser is refreshed or modified.
                    const locked = loginMsgElm.innerText.includes("ثانیه دیگر تلاش کنید");
                    loginButton.disabled = locked;
                }
            }
        });
    </script>
}



