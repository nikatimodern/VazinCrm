@using CRM.Core.Domain.Orders.Enums
@model List<OrderHead>

@{
    Layout = null;
    var passType = ViewBag.PassType;
}

@if (Model.Any()) {
    <div class="order-table-grid" style="--order-table-col:@(passType == 3 ? 7 : 5)">
        <div class="order-row order-header">
            @if (passType == 3) {
                <div class="order-cell"></div>
            }
            <div class="order-cell">شماره</div>
            <div class="order-cell">پیش‌فاکتور</div>
            @if (passType == 3) {
                <div class="order-cell">مشتری</div>
            }
            <div class="order-cell">تاریخ</div>
            <div class="order-cell">وضعیت</div>
            <div class="order-cell">عملیات</div>
        </div>

        @foreach (var item in Model) {
            <label class="order-row" for="orderCheck-@item.OrderNumber">
                @if (passType == 3) {
                    <div class="order-cell">
                        <input id="orderCheck-@item.OrderNumber" data-number="@item.OrderNumber" value="@item.Id" type="checkbox" class="form-check-input">
                    </div>
                }
                <div class="order-cell">@item.OrderNumber</div>
                <div class="order-cell">@item.PrefactorSer</div>
                @if (passType == 3) {
                    <div class="order-cell">@item.CustomerTxt</div>
                }
                <div class="order-cell">@item.OrderDate</div>
                <div class="order-cell">@item.Status.ToString()?.Replace("_", " ")</div>
                <div class="order-cell align-items-stretch gap-2 flex-wrap">
                    <button data-title="مشاهده" class="buttonGray d-flex align-items-center justify-content-center py-1 px-2" onclick="PreviewOrderPrint('@item.Id')">
                        <i class="fa fa-eye"></i>
                    </button>
                    @if (passType == 2) {
                        <button class="buttonGreen2" onclick="changeStatusHd('@item.Id', 4, 3, 2)">تحویل شد</button>
                    }
                </div>
            </label>
        }
    </div>
} else {
    <p class="empty-msg">دستور تولیدی ثبت نشده است!</p>
}




