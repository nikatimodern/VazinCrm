
@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}


<div>
    <div class="d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-1 mb-3">
            <button class="buttonGreen0 py-1 px-2" style="font-size: 12px" onclick="showModalTransfer(1)">
                ثبت واریز
            </button>
            <button class="buttonCancel2 py-1 px-2" style="font-size: 12px" onclick="showModalTransfer(2)">
                ثبت برداشت
            </button>
        </div>
        <div class="d-flex column-gap-2 align-items-center justify-content-between flex-wrap">
            <ul class="filter-switch mt-2 mt-md-0">
                <li class="filter-switch-item">
                    <input type="radio" name="transferStatus" id="transfer-all" value="-1" checked>
                    <label for="transfer-all">همه</label>
                </li>
                <li class="filter-switch-item">
                    <input type="radio" name="transferStatus" id="transfer-1" value="1">
                    <label for="transfer-1">
                        در انتظار تایید
                        <span class="badge-count filter-count-badge"></span>
                    </label>
                </li>
                <li class="filter-switch-item">
                    <input type="radio" name="transferStatus" id="transfer-2" value="2">
                    <label for="transfer-2">
                        تایید شده
                        <span class="badge-count filter-count-badge"></span>
                    </label>
                </li>
                @*<li class="filter-switch-item">
                    <input type="radio" name="transferStatus" id="transfer-3" value="3">
                    <label for="transfer-3">رد شده</label>
                </li>*@
            </ul>
        </div>
    </div>
    <div id="transferContainer" style="width: 99%;">
        <partial name="_TransferTable" model='"transferTable"' />
        @* @await Html.PartialAsync("TransferTable", "transferTable") *@
    </div>
</div>



<!-- Modal transfer -->
<div class="modal fade invoice-modal" id="transferModal" tabindex="-1" role="dialog" data-bs-focus="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content col-12" style="padding:10px!important">
            <div class="modalHeader-invoice">ثبت واریز</div>
            <div class="modal-body pb-0" style="padding-inline: 10px">
                <div class="modalContent-invoice">
                    <div class="d-flex flex-column w-100 gap-4 mt-2">
                        <form id="transferForm">
                            <div class="sectionBox-invoice">
                                <span class="sectionTitle-invoice">اطلاعات تراکنش بانکی</span>

                                <div class="flex-center align-items-start flex-wrap row-gap-2 w-100">
                                    <div class="col-12 col-sm-6 col-lg-4 pe-sm-2">
                                        <label>مبلغ (ریال)</label>
                                        <input inputmode="numeric" class="currencyNumber form-control inpAmount" name="amount" type="text" placeholder="مبلغ پرداختی به ریال" required data-currency-hint="next" />
                                        <span class="currencyHint"></span>
                                    </div>

                                    <div class="col-12 col-sm-6 col-lg-4">
                                        <label>تاریخ پرداخت</label>
                                        <input class="sdate form-control" name="transferDate" type="text" placeholder="تاریخ پرداخت" data-mask-date required />
                                    </div>
                                </div>

                                <div class="mt-2 w-100">
                                    <div id="fromAccountContainer">
                                        <label>حساب مبدا</label>
                                        <select class="form-select" name="fromAccountId"></select>
                                        <input class="form-control d-none" placeholder="از کدام حساب و به نام چه کسی پرداخت شده است" name="fromAccountTxt" />
                                    </div>

                                    <div class="mt-3" id="toAccountContainer">
                                        <label>حساب مقصد</label>
                                        <select class="form-select d-none" name="toAccountId"></select>
                                        <input class="form-control" placeholder="به کدام حساب و به نام چه کسی پرداخت شده است" name="toAccountTxt" />
                                    </div>
                                </div>
                            </div>

                            <div class="sectionBox-invoice mt-4">
                                <span class="sectionTitle-invoice">رسید پرداخت</span>
                                <div class="container-uploader">
                                    <input type="file" class="uploadBtn" data-varList="transferAttachment" data-showList="imageDisplayTransfer" id="transferAttach" multiple accept="*" required />

                                    <label for="transferAttach">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" /></svg>
                                        <span>تصویر رسید را انتخاب کنید یا اینجا رها کنید</span>
                                    </label>
                                    <div class="image-display" id="imageDisplayTransfer"></div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="px-0 py-3 w-100">
                <div style="width:100%; height:2px; background-color:var(--DarkColor)"></div>
            </div>

            <div class="gap-1 modal-footer p-0 border-0 justify-content-center">
                <button class="buttonCancel2 m-0" onclick="cancelTransferModal()">انصراف</button>
                <button class="buttonGreen3 m-0" onclick="submitTransferModal()">ثبت</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Transfer.js?release=6.9.4" data-page-bindings="transferTbl,transferModel,transferData,transferAttachment,transferModal,transferFields,showModalTransfer,setTransferModalUI,loadTransferAccounts,cancelTransferModal,submitTransferModal,getAllTransfersDt,editTransfer,deleteTransfer,changeStatusTransfer" asp-append-version="true"></script>
    <script data-page-bindings="">
        document.addEventListener("DOMContentLoaded", async () => {
            getAllTransfersDt("#transferTable");

            const transferRadios = document.querySelectorAll("input[type='radio'][name='transferStatus']");
            transferRadios?.forEach(elm => elm.addEventListener("change", async (e) => {
                transferModel._type = Number(e.target.value);
                transferTbl.ajax.reload(null, false);
            }));
        });
    </script>
}
