                <div style="margin:10px auto; width:98%; height:2px; background-color:rgba(0, 0,0,0.4);"></div>

                <div id="PayContentSumId" style="display:flex; flex-wrap:wrap; width:100%;  justify-content:space-between;"></div>

                <div style="margin:10px auto; width:97%; height:2px; background-color:var(--DarkColor);"></div>


                <div style="width:100%; display:flex;justify-content:center">
                    <button class="buttonCancel2" onclick="$('#InvoiceListModalId').modal('toggle'); ">انصراف</button>
