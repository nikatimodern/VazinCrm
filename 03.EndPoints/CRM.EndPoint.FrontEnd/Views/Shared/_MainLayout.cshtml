<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=8, IE=9" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="robots" content="noindex" />
    <meta name="googlebot" content="noindex" />
    <meta name="googlebot-news" content="noindex" />
    <meta name="slurp" content="noindex" />
    <meta name="msnbot" content="noindex" />
    <meta property="og:title" content="CRM">
    <meta property="og:description" content="سامانه مدیریت ارتباط با مشتری">
    <meta property="og:locale" content="fa_IR">
    <meta property="og:image" content="/static/icons/logo-180x180.png">
    <meta name="twitter:card" content="summary">

    <link rel="apple-touch-icon" sizes="180x180" href="/static/icons/logo-180x180.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/static/icons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/static/icons/favicon-16x16.png">
    <link rel="manifest" href="/manifest.json?v=6.2.0">

    <meta name="apple-mobile-web-app-title" content="VazinCRM">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">

    <meta name="theme-color" content="#004944">

    <title>&rlm;سامانه مدیریت مشتری&zwnj;&rlm;</title>


    <link rel="stylesheet" href="~/lib/Bootstrap/bootstrap5.3.rtl.min.css" />
    <link rel="stylesheet" href="~/lib/toastify/toastify.min.css" />

    <link rel="stylesheet" href="~/css/site.css?v=6.2.0" />
    <link rel="stylesheet" href="~/css/login.css?v=6.2.0" />

</head>
<body dir="rtl">
<div id="FLshowLoading" style="display:none">
    <div>
        <div class="loader"></div>
    </div>
</div>

<div class="parentLogin">
    <div class="d-none p-2" id="historyBackIcon" onclick="window.history.back()">
        <svg style="color: #fff" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" /></svg>
    </div>
    <div class="loginRenderBody">
        @RenderBody()
    </div>
    <div class="d-none d-lg-flex justify-content-start align-items-center" style="width: 50%;">
        @* <img src="~/uploaded/loginimg/img.png" style="width:90%;" /> *@
        @* <img src="~/Img/question.gif" style="width:80%;" /> *@
        <div class="flex-center flex-wrap gap-2">
            <img src="/Img/logo-vazinplast1.png" style="height: 80px" alt="">
            <img src="/Img/logo-vazinplast2.png" style="height: 80px" alt="">
        </div>
    </div>
</div>


<partial name="~/Views/Account/Modals/_SelectAccountModal.cshtml" />
<partial name="Modals/_PwaInstallModal" />

<script>
    document.getElementById("historyBackIcon").classList.toggle("d-none", window.location.pathname === "/");
</script>

<script src="~/lib/Bootstrap/bootstrap5.3.bundle.min.js"></script>
<script src="~/lib/jquery/jquery.min.js"></script>
<script src="~/lib/toastify/toastify-js.js"></script>

<script src="~/js/pwa.js?v=6.2.0"></script>
<script src="~/js/site.js?v=6.2.0"></script>



@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
