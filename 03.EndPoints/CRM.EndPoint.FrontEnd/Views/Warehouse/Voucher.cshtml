@model CRM.EndPoint.FrontEnd.Models.Warehouse.WarehouseVoucherListVModel
@{
    Guid? warehouseId = Guid.TryParse(Context.Request.Query["warehouseId"], out var id) ? id : null;
}
<div class="voucher-wrapper">
    <div class="filter-bar">
        <div class="search-group">
            <input class="form-control" type="text" id="WarehouseVoucherSearchId" placeholder="جستجو..." autocomplete="off">
            <div class="search-icon">
                <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z" clip-rule="evenodd" /></svg>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <div>
                <select class="form-select" id="WarehouseVoucherWarehouseId">
                    <option value="null">همه انبارها</option>
                    @foreach (var warehouse in Model?.Warehouses ?? []) {
                        <option value="@warehouse.Id" selected="@(warehouse.Id == warehouseId)">@warehouse.Title</option>
                    }
                </select>
            </div>

            <ul class="filter-switch flex-grow-1">
                <li class="filter-switch-item">
                    <input type="radio" name="WarehouseVoucherFilter" id="WarehouseVoucherFilterAll" value="-1" checked>
                    <label for="WarehouseVoucherFilterAll">همه</label>
                </li>
                <li class="filter-switch-item">
                    <input type="radio" name="WarehouseVoucherFilter" id="WarehouseVoucherFilter1" value="0">
                    <label for="WarehouseVoucherFilter1">در انتظار تایید تامین</label>
                </li>
                <li class="filter-switch-item">
                    <input type="radio" name="WarehouseVoucherFilter" id="WarehouseVoucherFilter2" value="1">
                    <label for="WarehouseVoucherFilter2">در انتظار تحویل</label>
                </li>
                <li class="filter-switch-item">
                    <input type="radio" name="WarehouseVoucherFilter" id="WarehouseVoucherFilter3" value="2">
                    <label for="WarehouseVoucherFilter3">تحویل شد</label>
                </li>
            </ul>

            <div class="filter-stats">
                نمایش
                <span id="vouchersFrom">@Model.DisplayFrom</span>
                تا
                <span id="vouchersTo">@Model.DisplayTo</span>
                از
                <span id="totalCount">@Model.TotalCount</span>
            </div>
        </div>
    </div>

    <div id="voucherGridContainer">
        <partial name="_WarehouseVouchers" model="Model" />
    </div>

    <div id="voucherPagination" class="pagination-wrapper"></div>
</div>

<partial name="Modals/_WarehouseVoucherModal" />

@section Styles {
    <link rel="stylesheet" href="~/css/warehouse.css?release=7.0.1" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/warehouse/warehouse-voucher.js?release=7.0.1" data-page-bindings="warehouseVoucherState,warehouseVoucherId,warehouseVoucherModal,loadWarehouseVouchers,refreshWarehouseVouchers,warehouseProductListData,showWarehouseVoucherModal,editWarehouseVoucher,cancelWarehouseVoucherModal,createSetVoucherItem,submitWarehouseVoucherModal,confirmWarehouseVoucher,deliverWarehouseVoucher,deleteWarehouseVoucher" asp-append-version="true"></script>
    <script data-page-bindings="">
        document.addEventListener("DOMContentLoaded", () => {

            initSearchInput("WarehouseVoucherSearchId", () => loadWarehouseVouchers());
            initChangeRadio("WarehouseVoucherFilter", () => loadWarehouseVouchers());

            document.getElementById("voucherGridContainer").addEventListener("click", async (e) => {
                const button = e.target.closest(".pagination-btn");
                if (!button) return;
                warehouseVoucherState.page = Number(button.dataset.page);
                window.scrollTo(0, 0);
                await loadWarehouseVouchers(warehouseVoucherState.page);
            });

            document.getElementById("WarehouseVoucherWarehouseId").addEventListener("change", async (e) => {
                const value = e.target.value === "null" ? null : e.target.value;
                setUrlParams({ warehouseId: value });
                await loadWarehouseVouchers(warehouseVoucherState.page);
            });
        });
    </script>
}