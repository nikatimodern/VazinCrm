@model List<CRM.EndPoint.FrontEnd.Models.Supply.SupplyFactorVModel>

@{
    Layout = null;
}

<div class="d-flex flex-column w-100 py-2" style="gap:12px">
    @foreach (var item in Model ?? []) {
        var supplyFactor = item.SupplyFactor;
        var orderSerials = item.OrderSerials;
        <div class="layered-card sf-supply-card @(item.IsAllocationComplete ? "sf-supply-card-complete" : "")" data-supply-factor-id="@supplyFactor.Id" style=" border-radius: 8px; overflow: hidden; transition: border-color 0.2s; padding: 0;">
            <div class="layered-card__layer col-12 col-lg-4 col-xl-3 d-flex">
                <div class="label-vertical" style="background-color: @(supplyFactor.OfficialType == 0 ? "#878787" : "var(--DarkColor)")">
                    @(supplyFactor.OfficialType == 1 ? "رسمی" : "غیررسمی")
                </div>
                <div class="d-flex flex-column justify-content-center flex-grow-1 px-3 py-2">
                    <span class="sf-supply-complete-badge badge bg-success align-self-start mb-2 @(item.IsAllocationComplete ? "" : "d-none")">
                        <i class="fa fa-check" aria-hidden="true"></i> تخصیص تکمیل شده
                    </span>
                    <div class="d-flex justify-content-between align-items-baseline mb-1">
                        <span style="font-size: 13px; color: gray">شماره فاکتور:</span>
                        <span class="fbold">@supplyFactor.SerialNumber</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-baseline">
                        <span style="font-size: 13px; color: gray">تاریخ فاکتور:</span>
                        <span class="fbold">@supplyFactor.Date</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-baseline">
                        <span style="font-size: 13px; color: gray">تاریخ ثبت:</span>
                        <span class="fbold direction-ltr">@(string.Join(" | ", supplyFactor.CreateDateTxt?.Substring(0, 16).Split(' ')))</span>
                    </div>
                </div>
            </div>

            <div class="layered-card__layer col-12 col-lg-5 col-xl-6 d-flex flex-column justify-content-center align-items-center px-3 py-3">
                <div class="d-flex align-items-baseline justify-content-center flex-wrap column-gap-2 mb-2 text-center">
                    <span style="font-size: 13px; color: gray">تامین کننده:</span>
                    <span class="fbold">@supplyFactor.SupplierTxt</span>
                </div>
                @if (orderSerials.Any()) {
                    <div class="d-flex align-items-baseline justify-content-center flex-wrap column-gap-2 mb-2 text-center">
                        <span style="font-size: 13px; color: gray">حواله تولید:</span>
                        <span class="fbold direction-ltr">@string.Join(", ", orderSerials)</span>
                    </div>
                }
                @if (supplyFactor.Deal != null) {
                    <div class="d-flex align-items-baseline justify-content-center flex-wrap column-gap-2 mb-2 text-center">
                        <span style="font-size: 13px; color: gray">شماره سفارش:</span>
                        <span class="fbold direction-ltr">@supplyFactor.Deal.SerialNumber</span>
                    </div>
                }
                <div class="d-flex align-items-baseline justify-content-center flex-wrap column-gap-2 text-center">
                    <span style="font-size: 13px; color: gray">ثبت شده توسط:</span>
                    <span class="fbold">@supplyFactor.UserCreator</span>
                </div>
                @if (!string.IsNullOrEmpty(supplyFactor.Description)) {
                    <div class="d-flex align-items-center justify-content-center flex-wrap column-gap-2 mt-2 text-center">
                        <span style="font-size: 13px; color: gray">توضیحات:</span>
                        <span class="fbold direction-ltr" style="font-size: 13px">@supplyFactor.Description</span>
                    </div>
                }
            </div>

            <div class="layered-card__layer col-12 col-lg-2 d-flex flex-row flex-lg-column justify-content-between justify-content-lg-center align-items-center px-3 py-2">
                <span style="font-size: 12px; color: gray">مبلغ کل:</span>
                <div class="fbold flex-center align-items-baseline column-gap-1">
                    <span style="font-size: 17px;">@string.Format("{0:n0}", supplyFactor.PaymentAmount)</span>
                    <span class="fs-small">ريال</span>
                </div>
            </div>

            <div class="layered-card__layer col-12 col-lg-1 d-flex flex-row flex-lg-column justify-content-center align-items-center px-2 py-2 gap-4 gap-lg-3">
                <button type="button" class="btn btn-sm btn-outline-primary" title="تخصیص آیتم‌های تامین به فروش" onclick="showSupplyAllocations('@supplyFactor.Id')">
                    <i class="fa fa-link" aria-hidden="true"></i><span class="fs-small">تخصیص</span>
                </button>
                <button class="flex-center p-0" data-title-right="پیوست ها" style="color:var(--DarkColor); border:none; background-color:transparent" onclick="showAttachments('@supplyFactor.Id', 8)">
                    <i class="fa fa-paperclip"></i>
                </button>
                <button class="flex-center p-0" data-title-right="ویرایش" style="color:var(--DarkColor); border:none; background-color:transparent" onclick="showEditSupplyFactorModal('@supplyFactor.Id')">
                    <i class="fa fa-pencil"></i>
                </button>
                <button class="flex-center p-0" data-title-right="حذف" style="color:var(--DarkColor); border:none; background-color:transparent" onclick="deleteSupplyFactor('@supplyFactor.Id')">
                    <i class="fa fa-trash"></i>
                </button>
            </div>

        </div>
    }
</div>
