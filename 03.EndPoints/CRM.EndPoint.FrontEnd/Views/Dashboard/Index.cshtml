@{
    Layout = "_Layout";
}

<div class="pb-3">
    <div class="mb-3 d-flex align-items-center gap-2">
        <button class="gap-2 dashGridItem" style="padding: 5px 14px;color: #333;border-radius: 4px;border:none" onclick="ShowFilterPopup(this, ['cusFilterItem'])" data-filterVarConfig="filterDashboardConfig" data-filterCallBack="callbackFilterDashboard" data-filterContentId="ContentDashboardFilterId">
            <span>فیلتر</span>
            <svg style="width: 20px; height: 20px;" fill="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke="none"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 0 1-.659 1.591l-5.432 5.432a2.25 2.25 0 0 0-.659 1.591v2.927a2.25 2.25 0 0 1-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 0 0-.659-1.591L3.659 7.409A2.25 2.25 0 0 1 3 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0 1 12 3Z" /></svg>
        </button>
        <div id="ContentDashboardFilterId"></div>

        @*<div class="d-flex gap-2" style="padding:4px;border-radius:4px;background-color:#fff">
			<div class="gap-2" style="display:flex;align-items: center;flex-wrap: wrap;">
				<p class="dashGridItem fbold gap-2" style="padding: 2px 14px;color: #333;border-radius: 8px;background-color:#F0F1F7" data-type="Date">
					<span>اردیبهشت ماه</span>
				</p>
			</div>
			<div class="gap-2" style="display:flex;align-items: center;flex-wrap: wrap;">
				<p class="dashGridItem fbold gap-2" style="padding: 2px 14px;color: #333;border-radius: 8px;background-color:#F0F1F7" data-type="Date">
					<span>هفته جاری</span>
				</p>
			</div>
		</div>*@

    </div>

    <div class="dashGridContainer">
        <div class="dashGridItem" style="container-type: inline-size">
            <partial name="_DashboardSalesPartial" />
        </div>

        <div class="dashGridItem" style="container-type: inline-size">
            <partial name="_DashboardOrderHeadPartial" />
        </div>

        <div class="dashGridItem" style="container-type: inline-size">
            <partial name="_DashboardCustomersPartial" />
        </div>

        <div class="dashGridItem" style="container-type: inline-size">
            <partial name="_DashboardReportCountPartial" />
        </div>

        <div class="dashGridItem gridItemFinancial">
            @if (User.IsAdmin() || User.IsFinancial() || User.IsManagingDirector())
            {
                <partial name="_DashboardFinancialPartial" />
            }
            else
            {
                <partial name="_DashboardTargetPartial" />
            }
        </div>

<div class="dashGridItem gridItemReports">
            <partial name="_DashboardReportPartial" />
        </div>

        <div class="dashGridItem gridItemTasks">
            <partial name="_DashboardCarizoPartial" />
        </div>

        <div class="dashGridItem gridItemLogs">
            <partial name="_DashboardLogsPartial" />
        </div>

        @*<div class="dashGridItem" style="grid-column: span 2">
            <div class="d-flex flex-column h-100 w-100 p-3">
                <div class="fbold mb-2 d-flex align-items-center gap-2" style="font-size:clamp(15px,1.5vw,18px);color: #00678b;">
                    <div class="d-flex align-items-center justify-content-center">
                        <svg style="width:24px;height:24px" fill="currentColor" viewBox="0 0 256 256"><path d="M168,128a8,8,0,0,1-8,8H96a8,8,0,0,1,0-16h64A8,8,0,0,1,168,128Zm-8,24H96a8,8,0,0,0,0,16h64a8,8,0,0,0,0-16ZM216,40V200a32,32,0,0,1-32,32H72a32,32,0,0,1-32-32V40a8,8,0,0,1,8-8H72V24a8,8,0,0,1,16,0v8h32V24a8,8,0,0,1,16,0v8h32V24a8,8,0,0,1,16,0v8h24A8,8,0,0,1,216,40Zm-16,8H184v8a8,8,0,0,1-16,0V48H136v8a8,8,0,0,1-16,0V48H88v8a8,8,0,0,1-16,0V48H56V200a16,16,0,0,0,16,16H184a16,16,0,0,0,16-16Z"></path></svg>
                    </div>
                    <span>گزارش تولیدات ماهانه</span>
                </div>
                <div class="flex-grow-1">
                    <div class="d-flex flex-column gap-2" style="width:100%">
                        <canvas id="ordersChart" style="height: 400px;"></canvas>
                    </div>
                </div>
            </div>
        </div>*@

    </div>
</div>

<partial name="~/Views/Carizo/Modals/_EditTaskModal.cshtml" />

@section Scripts {
    <script src="~/js/dashboardLoading.js?release=6.9.5" data-page-bindings="dashboardLoading" asp-append-version="true"></script>
    <script src="~/js/dashboard.js?release=6.9.5" data-page-bindings="modelDash,systematicTask,filterDashboardConfig,dashboardRefresh,UpdateDash,refreshDashboardSections,showInfoFactors,getDashReports,getInfoFactors,redirectFromDashboard,getReportsCount,getDashFactors,getOrderCount,getActiveCustomerCount,getLogSystem,getFinancialReport,callbackFilterDashboard" asp-append-version="true"></script>
    @*<script src="~/lib/chartjs/chart.js?release=6.9.5" asp-append-version="true"></script>
    <script src="~/lib/chartjs/chartjs-plugin-annotation.min.js?release=6.9.5" asp-append-version="true"></script>*@
}


