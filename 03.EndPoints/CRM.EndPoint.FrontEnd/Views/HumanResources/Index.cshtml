@model CRM.Core.ApplicationServices.HumanResources.Queries.GetEmployeeDirectory.EmployeeDirectoryPage
@using CRM.Core.Domain.HumanResources.Entities
@using CRM.Core.Domain.HumanResources.Services
@using CRM.Core.Domain.HumanResources.Repositories
@using System.Globalization
@functions {
    private static string PersianDate(DateOnly? date)
    {
        if (!date.HasValue) return "—";
        var value = date.Value.ToDateTime(TimeOnly.MinValue);
        var calendar = new PersianCalendar();
        return $"{calendar.GetYear(value):0000}/{calendar.GetMonth(value):00}/{calendar.GetDayOfMonth(value):00}";
    }
    private static string DateStateLabel(ContractDateState state) => state switch
    {
        ContractDateState.Draft => "پیش‌نویس",
        ContractDateState.Cancelled => "لغوشده",
        ContractDateState.Terminated => "فسخ‌شده",
        ContractDateState.Upcoming => "شروع نشده",
        ContractDateState.Valid => "معتبر",
        ContractDateState.ExpiringSoon => "نزدیک به انقضا",
        ContractDateState.EndsToday => "انقضا در امروز",
        ContractDateState.Expired => "منقضی‌شده",
        _ => "نامشخص"
    };
    private static string DateStateClass(ContractDateState state) => state switch
    {
        ContractDateState.Valid => "hr-state-valid",
        ContractDateState.ExpiringSoon => "hr-state-warning",
        ContractDateState.EndsToday or ContractDateState.Expired or ContractDateState.Terminated => "hr-state-danger",
        _ => "hr-state-neutral"
    };
}
@{
    Layout = "_Layout";
    ViewData["Title"] = "مدیریت پرسنل";
    var selected = Model.Selected;
}
@section Styles {
    <link rel="stylesheet" href="~/css/settingsTheme.css?release=7.5.6" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/humanResources.css?release=7.5.6" asp-append-version="true" />
}
<div id="hrEmployeeWorkspace" class="crm-settings-theme p-2" dir="rtl">
    <section class="InfoData mb-2">
        <header class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
            <div>
                <h1 class="hr-title mb-0"><i class="fa fa-users" aria-hidden="true"></i> مدیریت پرسنل</h1>
                <p class="small text-muted mb-0">پرونده پرسنلی و قراردادهای کاری</p>
            </div>
            @if (Model.CanCreate || !Model.CanView) {
                <button type="button" class="hr-action hr-primary" data-bs-toggle="modal" data-bs-target="#hrCreateEmployee">
                    <i class="fa fa-plus" aria-hidden="true"></i> افزودن پرسنل
                </button>
            }
        </header>
        @if (TempData["HrEmployeeMessage"] is string message) {
            <p role="status" class="@(TempData["HrEmployeeSuccess"] is true ? "text-success" : "text-danger") mb-2">@message</p>
        }
        @if (!Model.CanView) {
            <p role="status" class="hr-notice mb-2"><i class="fa fa-lock" aria-hidden="true"></i>
                نمای اولیه: ثبت و مشاهده اطلاعات واقعی پس از تکمیل سطح دسترسی و آماده‌سازی دیتابیس فعال می‌شود.
            </p>
        }
        <form method="get" asp-action="Index" class="d-flex gap-2 flex-wrap align-items-center mb-2">
            <label class="visually-hidden" for="hrSearch">جستجوی پرسنل</label>
            <input id="hrSearch" name="search" value="@Model.Search" maxlength="100" class="form-control hr-search"
                type="search" placeholder="نام، نام خانوادگی یا کد پرسنلی..." disabled="@(!Model.CanView)" />
            <button type="submit" class="hr-action" disabled="@(!Model.CanView)"><i class="fa fa-search" aria-hidden="true"></i> جستجو</button>
        </form>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0 hr-table">
                <thead><tr><th scope="col">کد پرسنلی</th><th scope="col">نام و نام خانوادگی</th><th scope="col">عملیات</th></tr></thead>
                <tbody>
                    @foreach (var employee in Model.Employees) {
                        <tr class="@(selected?.Id == employee.Id ? "hr-selected" : "")">
                            <td>@employee.PersonnelCode</td><td><strong>@employee.FirstName @employee.LastName</strong></td>
                            <td><a class="hr-action" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@Model.Page" asp-route-employeeId="@employee.Id">پرونده و قراردادها</a></td>
                        </tr>
                    }
                    @if (Model.Employees.Count == 0) {
                        <tr><td colspan="3" class="text-center text-muted py-3">@(Model.CanView ? "پرسنلی پیدا نشد." : "لیست هنوز فعال نیست.")</td></tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.CanView && (Model.Page > 1 || Model.HasNextPage)) {
            <nav class="d-flex align-items-center justify-content-end gap-2 mt-2" aria-label="صفحه‌بندی پرسنل">
                @if (Model.Page > 1) { <a class="hr-action" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page - 1)">قبلی</a> }
                <span class="small">صفحه @Model.Page</span>
                @if (Model.HasNextPage) { <a class="hr-action" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page + 1)">بعدی</a> }
            </nav>
        }
    </section>
    @if (selected != null) {
        <section class="InfoData mb-2">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div>
                    <h2 class="hr-heading mb-1">پرونده پرسنلی: @selected.FirstName @selected.LastName</h2>
                    <small class="text-muted">کد پرسنلی: @selected.PersonnelCode | حساب کاربری: @(selected.HasAccount ? "متصل" : "بدون حساب")</small>
                </div>
                <button type="button" class="hr-action" data-bs-toggle="modal" data-bs-target="#hrEditEmployee">
                    <i class="fa fa-user-edit" aria-hidden="true"></i> @(Model.CanEdit ? "ویرایش اطلاعات" : "مشاهده اطلاعات")
                </button>
            </div>
        </section>
    }
    @if (Model.CanCreate || !Model.CanView) {
        @await Html.PartialAsync("_EmployeeEditor", Model, new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { ["HrEditorMode"] = "create" })
    }
    @if (selected != null) {
        @await Html.PartialAsync("_EmployeeEditor", Model, new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { ["HrEditorMode"] = "edit" })
    }
    @if (selected != null) {
        <section class="InfoData">
            <header class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                <h2 class="hr-heading mb-0"><i class="fa fa-file-alt" aria-hidden="true"></i> قراردادهای پرسنلی</h2>
                @if (Model.CanCreateContract) {
                    <button type="button" class="hr-action hr-primary" data-bs-toggle="modal" data-bs-target="#hrContractEditor" data-operation="1">
                        <i class="fa fa-plus" aria-hidden="true"></i> افزودن قرارداد
                    </button>
                }
            </header>
            @if (!Model.CanViewContracts) {
                <p class="text-muted mb-0">مشاهده قراردادها نیازمند مجوز مستقل است.</p>
            } else {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0 hr-table">
                        <thead><tr><th>شماره</th><th>نوع</th><th>شروع</th><th>پایان</th><th>وضعیت</th><th>زمان باقی‌مانده</th><th>عملیات</th></tr></thead>
                        <tbody>
                        @foreach (var contract in Model.Contracts) {
                            var today = Model.BusinessDate.Value;
                            var state = ContractExpiryPolicy.GetState(contract.Status, contract.StartDate, contract.EndDate, contract.TerminatedOn, today, 30);
                            var remaining = contract.EndDate.HasValue ? contract.EndDate.Value.DayNumber - today.DayNumber : (int?)null;
                            var showRemaining = contract.Status == EmploymentContractStatus.Approved && remaining.HasValue;
                            <tr>
                                <td>@contract.ContractNumber</td>
                                <td>@(contract.Term == EmploymentContractTerm.FixedTerm ? "مدت‌دار" : "بدون تاریخ پایان")</td>
                                <td>@PersianDate(contract.StartDate)</td><td>@PersianDate(contract.EndDate)</td>
                                <td><span class="hr-state @DateStateClass(state)">@DateStateLabel(state)</span></td>
                                <td>@(showRemaining ? (remaining.Value < 0 ? $"{Math.Abs(remaining.Value)} روز گذشته" : remaining.Value == 0 ? "امروز" : $"{remaining.Value} روز") : "—")</td>
                                <td>
                                    <div class="d-flex gap-1 flex-wrap justify-content-center">
                                        @if (contract.Status == EmploymentContractStatus.Draft) {
                                            @if (Model.CanEditContract) {
                                                <button type="button" class="hr-action" data-bs-toggle="modal" data-bs-target="#hrContractEditor" data-operation="2"
                                                    data-contract-id="@contract.Id" data-row-version="@Convert.ToBase64String(contract.RowVersion)"
                                                    data-number="@contract.ContractNumber" data-term="@((int)contract.Term)"
                                                    data-agreement="@PersianDate(contract.AgreementDate)" data-start="@PersianDate(contract.StartDate)"
                                                    data-end="@(contract.EndDate.HasValue ? PersianDate(contract.EndDate) : "")">ویرایش</button>
                                                <button type="button" class="hr-action" data-bs-toggle="modal" data-bs-target="#hrContractEditor" data-operation="5"
                                                    data-contract-id="@contract.Id" data-row-version="@Convert.ToBase64String(contract.RowVersion)" data-number="@contract.ContractNumber">لغو</button>
                                            }
                                            @if (Model.CanApproveContract) {
                                                <button type="button" class="hr-action hr-primary" data-bs-toggle="modal" data-bs-target="#hrContractEditor" data-operation="4"
                                                    data-contract-id="@contract.Id" data-row-version="@Convert.ToBase64String(contract.RowVersion)" data-number="@contract.ContractNumber">تأیید</button>
                                            }
                                        } else if (contract.Status == EmploymentContractStatus.Approved) {
                                            @if (Model.CanCreateContract && contract.EndDate.HasValue) {
                                                <button type="button" class="hr-action" data-bs-toggle="modal" data-bs-target="#hrContractEditor" data-operation="3"
                                                    data-contract-id="@contract.Id" data-row-version="@Convert.ToBase64String(contract.RowVersion)" data-number="@contract.ContractNumber"
                                                    data-start="@(contract.EndDate.Value == DateOnly.MaxValue ? "" : PersianDate(contract.EndDate.Value.AddDays(1)))">تمدید</button>
                                            }
                                            @if (Model.CanTerminateContract) {
                                                <button type="button" class="hr-action" data-bs-toggle="modal" data-bs-target="#hrContractEditor" data-operation="6"
                                                    data-contract-id="@contract.Id" data-row-version="@Convert.ToBase64String(contract.RowVersion)" data-number="@contract.ContractNumber">فسخ</button>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (Model.Contracts.Count == 0) {
                            <tr><td colspan="7" class="text-center text-muted">قراردادی ثبت نشده است.</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
                @if (Model.ContractPage > 1 || Model.HasNextContractPage) {
                    <nav class="d-flex align-items-center justify-content-end gap-2 mt-2" aria-label="صفحه‌بندی قراردادها">
                        @if (Model.ContractPage > 1) {
                            <a class="hr-action" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@Model.Page" asp-route-employeeId="@selected.Id" asp-route-contractPage="@(Model.ContractPage - 1)">قبلی</a>
                        }
                        <span class="small">صفحه @Model.ContractPage</span>
                        @if (Model.HasNextContractPage) {
                            <a class="hr-action" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@Model.Page" asp-route-employeeId="@selected.Id" asp-route-contractPage="@(Model.ContractPage + 1)">بعدی</a>
                        }
                    </nav>
                }
                <small class="text-muted">بازه هشدار اولیه: ۳۰ روز قبل از پایان قرارداد.</small>
            }
        </section>
        @if (Model.CanViewContracts && (Model.CanCreateContract || Model.CanEditContract || Model.CanApproveContract || Model.CanTerminateContract)) {
            @await Html.PartialAsync("_ContractEditor", Model)
        }
    }
</div>

@section Scripts {
    <script src="~/js/humanResources.js?release=7.5.6" asp-append-version="true"></script>
    <script src="~/js/humanResourcesMap.js?release=7.5.6" asp-append-version="true"></script>
}
