@inject CRM.EndPoint.FrontEnd.Security.DocumentAccessPolicy DocumentAccess
@{ var canCreate = await DocumentAccess.HasAsync("SupplyFactor", "Create", Context.RequestAborted); }
@section Styles {

    <link rel="stylesheet" href="~/css/operationsTheme.css?release=7.5.6" asp-append-version="true" />
}

<div id="supplyFactorWorkspace" class="crm-operations-theme w-100">
    <div class="sf-toolbar">
        <div class="sf-toolbar-actions d-flex">
            <button hidden="@(!canCreate)" data-document-permission="SupplyFactor.Create" class="buttonGray2 d-flex align-items-center gap-1" style="padding: 4px 8px" onclick="showSupplyFactorModal()">
                <span style="line-height: 1">ثبت فاکتور جدید</span>
                <svg style="width: 20px" viewBox="0 0 20 20" fill="currentColor"><path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" /></svg>
            </button>
        </div>
        <div class="sf-toolbar-search d-flex align-items-center">
            <div class="search-group flex-grow-1">
                <input class="form-control" id="supplyFactorSearch" placeholder="جستجو">
                <div class="search-icon">
                    <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z" clip-rule="evenodd" /></svg>
                </div>
            </div>
        </div>
        <section class="sf-overview" aria-label="خلاصه وضعیت تخصیص فاکتورهای تامین">
            <div class="sf-overview-card sf-overview-complete">
                <div class="sf-overview-info">
                    <div class="sf-overview-title"><i class="fa fa-check-circle" aria-hidden="true"></i> تخصیص تکمیل‌شده</div>
                    <div class="sf-overview-value" aria-live="polite"><strong data-sf-overview-count="complete">—</strong> از <b data-sf-overview-total>—</b> عدد</div>
                </div>
                <button type="button" class="sf-overview-action" data-sf-status-filter="complete" aria-pressed="false" aria-controls="supplyFactorsContainer" disabled>مشاهده</button>
            </div>
            <div class="sf-overview-card sf-overview-pending">
                <div class="sf-overview-info">
                    <div class="sf-overview-title"><i class="fa fa-clock" aria-hidden="true"></i> تخصیص تکمیل‌نشده</div>
                    <div class="sf-overview-value" aria-live="polite"><strong data-sf-overview-count="pending">—</strong> از <b data-sf-overview-total>—</b> عدد</div>
                </div>
                <button type="button" class="sf-overview-action" data-sf-status-filter="pending" aria-pressed="false" aria-controls="supplyFactorsContainer" disabled>مشاهده</button>
            </div>
        </section>
    </div>
    <div id="supplyFactorsContainer"></div>
    <div id="sfOverviewEmpty" class="sf-overview-empty" role="status" hidden>فاکتوری با شرایط انتخاب‌شده یافت نشد.</div>
</div>


<partial name="Modals/_SupplyFactorModal" />
<partial name="Modals/_SupplyFactorItemModal" />
<partial name="Modals/_SupplyFinancialModal" />
<partial name="~/Views/Shared/Modals/_AddItemInSepidarModal.cshtml" />

@section Scripts {
    <script src="~/js/supplyFinancial.js" data-page-bindings="openSupplyFinancial" asp-append-version="true"></script>
    <script>document.addEventListener("DOMContentLoaded", () => enableMomentumScrollScope(document.getElementById("supplyFactorWorkspace")));</script>
    <script src="~/js/supplyFactor.js?release=7.5.6" data-page-bindings="orderHeadsSupFactorSelectedIds,supplyFactorData,sfItemIndex,incompleteSfItemsCount,supplyFactorDiscountInp,supplyFactorAttInpId,showSupplyFactorModal,initSupplyFactorModal,cancelSupplyFactorModal,addSfItem,calculateSupplyFactorTotals,sfFieldRules,showSupplyFactorItems,deleteSfItem,showUpdateSfItem,updateSfItem,cancelUpdateSfItem,addItemSupplyFactor,canselModalItemSupplyFactor,processSupplyFactorWithAi,updateSupplyFactorValidationState,showAddOrderHeadSfModal,getOrderHeadIdsBySupplier,isSetupSupplyTomSelect,setupSelectOptions,submitSupplyFactorModal,getSupplyFactor,showEditSupplyFactorModal,deleteSupplyFactor,sfAllocationState,sfAllocationPerspective,sfAllocationIsSales,sfAllocationSaving,sfAllocationChoosing,sfAllocationSelector,sfAllocationRequest,sfAllocationAbort,sfAllocationOrigin,sfAllocationInvoiceId,sfAllocationFilter,sfAllocationCurrentItemId,sfAllocationOpen,sfAllocationDrafts,sfPickerTab,sfPickerData,sfPickerTargets,sfPickerForm,sfPickerAbort,sfPickerRequest,sfPickerTimer,sfPickerLoading,sfAllocationText,sfAllocationEscape,sfAllocationNumber,sfAllocationRemaining,sfAllocationNormalize,sfAllocationIcon,sfAllocationSalesWeight,sfAllocationDisplayRecord,sfAllocationTargetLabel,sfAllocationSalesCapacity,sfAllocationSkeleton,sfAllocationEmpty,ensureSupplyAllocationUI,sfAllocationRefreshNeeded,sfAllocationFeedback,showSalesFactorAllocations,showSupplyAllocations,loadSupplyAllocations,sfAllocationCapacity,updateSupplyAllocationLimit,captureSupplyAllocationDrafts,sfAllocationForm,renderSupplyAllocations,renderSupplyAllocationRecords,filterSupplyAllocationItems,navigateSupplyAllocationItem,loadSupplyAllocationPicker,renderSupplyAllocationPicker,updateSupplyPickerSelection,selectSupplyAllocationFactor,clearSupplyAllocationFormError,supplyAllocationFormError,submitSupplyAllocation,persistSupplyAllocation,deleteSupplyAllocation,retrySupplyAllocations" asp-append-version="true"></script>
    <script data-page-bindings="getAllSupplyFactors,updateSupplyFactorOverview">
        document.addEventListener("DOMContentLoaded", () => {
            const workspace = document.getElementById("supplyFactorWorkspace");
            if (!workspace) return;

            workspace.querySelectorAll("[data-sf-status-filter]").forEach(button => {
                button.addEventListener("click", () => {
                    const wasSelected = button.getAttribute("aria-pressed") === "true";
                    workspace.querySelectorAll("[data-sf-status-filter]").forEach(action => {
                        action.setAttribute("aria-pressed", String(action === button && !wasSelected));
                    });
                    updateSupplyFactorOverview(workspace);
                });
            });
            workspace.addEventListener("sf:allocation-status-changed", () => updateSupplyFactorOverview(workspace));
            initSearchInput("supplyFactorSearch", getAllSupplyFactors);
            getAllSupplyFactors();
        });

        const updateSupplyFactorOverview = workspace => {
            const ready = workspace.dataset.sfSummaryReady === "true";
            const cards = [...workspace.querySelectorAll("#supplyFactorsContainer .sf-supply-card")];
            const completeCount = cards.filter(card => card.classList.contains("sf-supply-card-complete")).length;
            const format = value => ready ? value.toLocaleString("fa-IR") : "—";
            workspace.querySelector('[data-sf-overview-count="complete"]').textContent = format(completeCount);
            workspace.querySelector('[data-sf-overview-count="pending"]').textContent = format(cards.length - completeCount);
            workspace.querySelectorAll("[data-sf-overview-total]").forEach(total => {
                total.textContent = format(cards.length);
            });

            const selected = workspace.querySelector('[data-sf-status-filter][aria-pressed="true"]')?.dataset.sfStatusFilter;
            workspace.querySelectorAll("[data-sf-status-filter]").forEach(button => {
                const active = button.dataset.sfStatusFilter === selected;
                button.textContent = active ? "نمایش همه" : "مشاهده";
                button.disabled = !ready;
            });

            let visibleCount = 0;
            cards.forEach(card => {
                const complete = card.classList.contains("sf-supply-card-complete");
                const matches = !selected || (selected === "complete" ? complete : !complete);
                card.hidden = ready && !matches;
                if (matches) visibleCount++;
            });
            workspace.querySelector("#sfOverviewEmpty").hidden = !ready || visibleCount !== 0;
        };

        const getAllSupplyFactors = async () => {
            const workspace = document.getElementById("supplyFactorWorkspace");
            if (!workspace) return;
            const container = workspace.querySelector("#supplyFactorsContainer");
            const requestId = String(Number(container.dataset.sfRequestId || 0) + 1);
            container.dataset.sfRequestId = requestId;
            workspace.dataset.sfSummaryReady = "false";
            updateSupplyFactorOverview(workspace);

            const val = workspace.querySelector("#supplyFactorSearch").value.trim();
            const res = await sendApiRequest({ url: "/Supply/GetAllSupplyFactorsPartial", params: { search: val }, returnFullResponse: true, skeleton: { target: "#supplyFactorsContainer", retry: getAllSupplyFactors } });
            if (!workspace.isConnected || container.dataset.sfRequestId !== requestId || !res) return;

            container.innerHTML = res.data;
            workspace.dataset.sfSummaryReady = "true";
            updateSupplyFactorOverview(workspace);
        };
    </script>
}
