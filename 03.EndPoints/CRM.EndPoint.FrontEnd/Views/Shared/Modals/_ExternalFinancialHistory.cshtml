@model (string ModalId, string Title, string SendId, string ListId, string TabsPartial)

<div class="modal fade" id="@Model.ModalId" tabindex="-1" data-bs-focus="false" aria-labelledby="@(Model.ModalId + "Title")">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="@(Model.ModalId + "Title")">@Model.Title</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(Model.TabsPartial)) {
                    <partial name="@Model.TabsPartial" />
                }
                <div class="external-pf-toolbar">
                    <span data-financial-history-heading>سوابق ثبت در نرم‌افزارهای مالی</span>
                    <button type="button" id="@Model.SendId" class="external-pf-send">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"/><path d="m21.854 2.147-10.94 10.939"/></svg>
                        <span data-financial-history-send-label>ارسال به نرم‌افزار مالی</span>
                    </button>
                </div>
                <div id="@Model.ListId" class="external-pf-list" aria-live="polite"></div>
            </div>
            <div class="modal-footer justify-content-end p-2">
                <button type="button" data-bs-dismiss="modal" class="buttonCancel-white">بستن</button>
            </div>
        </div>
    </div>
</div>
