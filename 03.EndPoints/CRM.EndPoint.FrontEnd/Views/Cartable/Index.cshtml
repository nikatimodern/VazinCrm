@using CRM.EndPoint.FrontEnd.Services
@{
    Layout = "_Layout";

    var isAdmin = User.IsInRole(AppRoles.Admin);
    var isSalesAdmin = User.IsInRole(AppRoles.SalesAdmin);
    var isSalesExpert = User.IsInRole(AppRoles.SalesExpert);
    var isTaminAdmin = User.IsInRole(AppRoles.TaminAdmin);
    var isTaminExpert = User.IsInRole(AppRoles.TaminExpert);
    var isFinancialAdmin = User.IsInRole(AppRoles.FinancialAdmin);
    var isFinancialExpert = User.IsInRole(AppRoles.FinancialExpert);
    var isManagingDirector = User.IsInRole(AppRoles.ManagingDirector);

    var canAccessFinancialExpert = isAdmin || isFinancialExpert;
    var canAccessFinancialAdmin = false; //isAdmin || isFinancialAdmin;
    var canAccessSalesExpert = isAdmin || isSalesExpert;
    var canAccessSalesAdmin = isAdmin || isSalesAdmin;
    var canAccessTaminExpert = isAdmin || isTaminAdmin || isTaminExpert || isManagingDirector;
    var canAccessManagingDirector = isAdmin || isManagingDirector;
}


<div>
    <div id="CartableTabs" class="d-flex justify-content-center flex-wrap-reverse">
        <div class="TCar" id="TPrefactorFactorId" onclick="GetCartable('TPrefactorFactorId')">
            <p>پیش فاکتور و فاکتور</p>
        </div>
        @if (canAccessFinancialExpert) {
            <div class="TCar" id="TFinancialExpertId" onclick="GetCartable('TFinancialExpertId')">
                <span class="badge-count d-none" style="position: absolute;top: -6px;left: 0;z-index: 10"></span>
                <p>کارشناس مالی</p>
            </div>
        }
        @if (canAccessFinancialAdmin) {
            <div class="TCar d-none" id="TFinancialAdminId" onclick="GetCartable('TFinancialAdminId')">
                <p>مدیر مالی</p>
            </div>
        }
        @if (canAccessSalesExpert) {
            <div class="TCar" id="TSalesExpertId" onclick="GetCartable('TSalesExpertId')">
                <span class="badge-count d-none" style="position: absolute;top: -6px;left: 0;z-index: 10"></span>
                <p>کارشناس فروش</p>
            </div>
        }
        @if (canAccessSalesAdmin) {
            <div class="TCar" id="TSalesAdminId" onclick="GetCartable('TSalesAdminId')">
                <span class="badge-count d-none" style="position: absolute;top: -6px;left: 0;z-index: 10"></span>
                <p>مدیر فروش</p>
            </div>
        }
        @if (canAccessTaminExpert) {
            <div class="TCar" id="TTaminExpertId" onclick="GetCartable('TTaminExpertId')">
                <span class="badge-count d-none" style="position: absolute;top: -6px;left: 0;z-index: 10"></span>
                <p>کارشناس تامین</p>
            </div>
        }
        @if (canAccessManagingDirector) {
            <div class="TCar" id="TManagingDirectorId" onclick="GetCartable('TManagingDirectorId')">
                <span class="badge-count d-none" style="position: absolute;top: -6px;left: 0;z-index: 10"></span>
                <p>مدیر عامل</p>
            </div>
        }
    </div>
    <div class="CartableContent mx-auto">
        @*کارتابل پیش فاکتوروفاکتور*@
        <div class="cartable-pane w-100 d-flex justify-content-start align-items-center flex-column d-none" id="CPrefactorFactorId">
            <ul class="nav nav-tabs w-100" id="allTabFactors" role="tablist" style="display: none;">
                <li class="nav-item col-6" role="presentation">
                    <button class="nav-link active text-dark w-100" style="margin-bottom:-2px;isolation:auto" id="allPreFactorTab" data-bs-toggle="tab" data-bs-target="#allPreFactorTab-pane" type="button" role="tab" aria-controls="allPreFactorTab-pane" aria-selected="true">پیش فاکتورها</button>
                </li>
                <li class="nav-item col-6" role="presentation">
                    <button class="nav-link text-dark w-100" style="margin-bottom:-2px;isolation:auto" id="allFactorTab" data-bs-toggle="tab" data-bs-target="#allFactorTab-pane" type="button" role="tab" aria-controls="allFactorTab-pane" aria-selected="false">فاکتورها</button>
                </li>
            </ul>

            <div class="parent-all-factors tab-content d-xxl-grid p-2 col-12" style="grid-template-columns:1fr 1fr;gap:8px;" id="tabContentAllFactors">

                @*پیش فاکتور*@
                <div class="tab-pane fade show active border-0" id="allPreFactorTab-pane" role="tabpanel" aria-labelledby="allPreFactorTab" tabindex="0" style="flex-direction:column;width:100%">

                    <div class="px-2 justify-content-center justify-content-xxl-between" style=" display:flex; font-size:20px; font-family:'IranSansBold'">
                        <label class="d-none d-xxl-block">پیش فاکتورها</label>
                        <div class="justify-content-center justify-content-xxl-end col-12 col-xxl-3 me-xxl-3" style="display:flex;align-items:center;">
                            <p class="mp d-none d-xxl-flex align-items-center gap-2" style="font-family:'IRANSansBold'; font-size:large;color:rgb(84 57 213)">
                                تعداد:
                                <span id="CountId"></span>
                            </p>
                        </div>

                    </div>

                    <div class="InfoData" style="width:100%;display:flex; flex-direction:column;  justify-content:center;align-items:center">
                        <div class="gap-2 px-1 mt-xxl-2 align-items-center justify-content-between justify-content-xxl-center" style="width:100%; display:flex;padding-bottom:8px">

                            <p class="mp d-flex d-xxl-none align-items-center gap-1" style="font-family:'IRANSansBold'; font-size:clamp(15px,2vw,16px);color:rgb(84 57 213)">
                                تعداد:<span id="CountMobileId"></span>
                            </p>

                            <div class="search-group flex-grow-1 flex-md-grow-0 col-md-7 gap-1">
                                <input class="form-control" type="text" id="searchId" placeholder="جستجو..." />
                                <div class="search-icon">
                                    <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z" clip-rule="evenodd" /></svg>
                                </div>
                            </div>

                            <div class="gap-2" style="display:flex;justify-content:space-between;align-items:center ">
                                <div data-filterVarConfig="varList" data-filterCallBack="GetPreFactorPartial" data-filterContentId="ContentFilterId" data-filterInpSearchId="searchId" onclick="ShowFilterPopup(this)" class="btnFilter">
                                    <svg style="width:24px;height:24px;color:#333" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M3.792 2.938A49.069 49.069 0 0 1 12 2.25c2.797 0 5.54.236 8.209.688a1.857 1.857 0 0 1 1.541 1.836v1.044a3 3 0 0 1-.879 2.121l-6.182 6.182a1.5 1.5 0 0 0-.439 1.061v2.927a3 3 0 0 1-1.658 2.684l-1.757.878A.75.75 0 0 1 9.75 21v-5.818a1.5 1.5 0 0 0-.44-1.06L3.13 7.938a3 3 0 0 1-.879-2.121V4.774c0-.897.64-1.683 1.542-1.836Z" clip-rule="evenodd" /></svg>
                                </div>
                                <button class="buttonExcel" onclick="exportExcelPreFactors()">
                                    <svg fill="currentColor" viewBox="0 0 256 256"><path d="M156,208a8,8,0,0,1-8,8H120a8,8,0,0,1-8-8V152a8,8,0,0,1,16,0v48h20A8,8,0,0,1,156,208ZM92.65,145.49a8,8,0,0,0-11.16,1.86L68,166.24,54.51,147.35a8,8,0,1,0-13,9.3L58.17,180,41.49,203.35a8,8,0,0,0,13,9.3L68,193.76l13.49,18.89a8,8,0,0,0,13-9.3L77.83,180l16.68-23.35A8,8,0,0,0,92.65,145.49Zm98.94,25.82c-4-1.16-8.14-2.35-10.45-3.84-1.25-.82-1.23-1-1.12-1.9a4.54,4.54,0,0,1,2-3.67c4.6-3.12,15.34-1.72,19.82-.56a8,8,0,0,0,4.07-15.48c-2.11-.55-21-5.22-32.83,2.76a20.58,20.58,0,0,0-8.95,14.95c-2,15.88,13.65,20.41,23,23.11,12.06,3.49,13.12,4.92,12.78,7.59-.31,2.41-1.26,3.33-2.15,3.93-4.6,3.06-15.16,1.55-19.54.35A8,8,0,0,0,173.93,214a60.63,60.63,0,0,0,15.19,2c5.82,0,12.3-1,17.49-4.46a20.81,20.81,0,0,0,9.18-15.23C218,179,201.48,174.17,191.59,171.31ZM40,112V40A16,16,0,0,1,56,24h96a8,8,0,0,1,5.66,2.34l56,56A8,8,0,0,1,216,88v24a8,8,0,1,1-16,0V96H152a8,8,0,0,1-8-8V40H56v72a8,8,0,0,1-16,0ZM160,80h28.68L160,51.31Z"></path></svg>
                                </button>
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between align-self-start flex-wrap-reverse w-100 gap-1 mb-1 ps-1">
                            <ul class="filter-switch filter-switch-sm filter-switch-light">
                                <li class="filter-switch-item">
                                    <input type="radio" name="financeFilter" id="f0" value="0" checked />
                                    <label for="f0">همه</label>
                                </li>
                                <li class="filter-switch-item">
                                    <input type="radio" name="financeFilter" id="f6" value="6" />
                                    <label for="f6">فاکتور شده</label>
                                </li>
                                <li class="filter-switch-item">
                                    <input type="radio" name="financeFilter" id="f5" value="5" />
                                    <label for="f5">فاکتور نشده</label>
                                </li>
                            </ul>
                            <div id="ContentFilterId" class="ContentFilter"></div>
                        </div>

