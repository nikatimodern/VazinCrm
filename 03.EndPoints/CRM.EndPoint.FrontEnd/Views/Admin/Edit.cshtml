@section scripts{
    <script defer>
        $("#internalsSelect").select2({
            tags: true,
            tokenSeparators: [",", " "],
        });

        async function ToggleUserLockout() {
            const userId = '@Model.Id';
            try {
                FLshowLoading();
                const res = await axios(`/Account/ToggleUserLockout?userId=${userId}`);
                if (res.status === 200) {
                    window.location.reload();
                    FLshowLoading(false);
                }
            } catch (err) {
                toastifyError("عملیات با خطا مواجه شد.");
                console.log(err);
                FLshowLoading(false);
            }
        }

    </script>
}

