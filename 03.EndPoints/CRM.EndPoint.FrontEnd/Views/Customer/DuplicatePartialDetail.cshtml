@model IList<CRM.Core.Domain.Customers.Entities.Customer>

@{
    Layout = null;
}

<div style="display:flex;flex-flow:wrap;justify-content:center;">

    @if (Model.Any())
    {
        @foreach (var item in Model)
        {


            <div class="m-2" style="width:190px">

                <div class="d-flex flex-column" style="border: 1px solid rgba(0, 0, 0, .125);border-radius:25px;  background-color:white; height:100%  ">
                    <div class="image-content" style="padding: 10px 0;">
                        @if (item.Juridical == 1)
                        {
                            <div class="overlay" style="padding:10px; color:aliceblue; font-size:12px;">
                                <p class="fbold" style=" text-align:end; width:100%;">حقوقی</p>
                            </div>
                        }
                        else
                        {
                            <div class="overlay" ></div>
                        }
                        <div class=" card-image">
                            <img  style="width:100%" src="~/Img/User.png" class="rounded-circle" alt="...">
                        </div>
                    </div>

                    <div class="card-content flex-grow-1" style="margin-block:6px;padding: 0px 6px;display:flex; flex-direction:column; justify-content:space-between; width:100%;  margin-top:10px !important">
                        <div style=" height:100% ; width:100%; display:flex;flex-direction:column;justify-content:center;align-items:center  ">
                            <div style="display:flex;flex-wrap:wrap"> <span> کد مشتری : </span> <span class="fbold text-center"> @item.CustomerCode </span>  </div>
                            @if (item.Sex == 1)
                            {
                                <div style="display:flex;flex-wrap:wrap;justify-content:center;"> <span> نام: </span> <span class="fbold text-center">آقای @item.AgentName </span>  </div>
                            }
                            else if (item.Sex == 0)
                            {
                                <div style="display:flex;flex-wrap:wrap;justify-content:center;"><span> نام: </span><span class="fbold text-center">خانم @item.AgentName </span>  </div>
                            }
                            else
                            {
                                <div style=" display:flex;flex-wrap:wrap;justify-content:center;"><span> نام: </span><span class="fbold text-center">@item.AgentName </span>  </div>
                            }

                            <div style="display:flex;flex-wrap:wrap;justify-content:center;"><span> تلفن همراه : </span><span class="fbold text-center">@item.Mobile </span>  </div>
                            @if (item.Juridical == 1)
                            {
                                <div style="display:flex;flex-wrap:wrap; justify-content:center"><span> شرکت: </span><span class="fbold text-center">@item.CompanyName </span>  </div>
                                @* <div style="display:flex"><span> نوع: </span><span class="fbold">حقوقی</span>  </div> *@
                            }
                            else
                            {
                                @* <div style="display:flex"><span> نوع: </span><span class="fbold">حقیقی</span>  </div> *@
                            }

                        </div>
                        <div style="padding:5px; height:100%; align-items:center;justify-content:end; width:100%; display:flex; flex-direction:column;gap: 4px ">
                            <div style="display:flex;flex-wrap:wrap; justify-content:center"><span> توسط: </span><span class="fbold text-center">@item.UserCreator</span>  </div>

                            <div class="d-flex align-items-center justify-content-center" style="color:#fff;width:100%">
                                <a style="  width:50%" class="mp buttonPurple buttonCusPartial " href="/Customer/CustomerDetail?id=@item.Id" target="_blank"><i class="fa fa-search"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        }


    }
    else
    {
        <div style=" height:200px;width:100%;display:flex;flex-direction:column;align-items:center; justify-content:center ">

            <h1>یافت نشد!</h1>
            <h5>هیچ مشتری یافت نشد</h5>

        </div>
    }
</div>

