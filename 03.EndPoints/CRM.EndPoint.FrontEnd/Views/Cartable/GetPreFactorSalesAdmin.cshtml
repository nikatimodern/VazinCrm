@using CRM.Core.Domain.PreFactors.Enum
@model List<CRM.EndPoint.FrontEnd.Models.PreFactors.PreFactorSalesAdminViewModel>
@{ Layout = null; }
<div class="pf-accepted-list">
@foreach (var item in Model) {
    var pf = item.PreFactor;
    <article class="pf-accepted-card @(pf.Pftype == (int)PreFactorEnum.فاقد_اعتبار ? "pf-accepted-card--invalid" : "")">
        <partial name="~/Views/PreFactor/_PreFactorSideLabels.cshtml" model="pf" />
        <div class="InfoDataItem_Prefactor pf-accepted-card__content pf-finance-card">
            <div class="pf-accepted-card__facts" aria-label="مشخصات پیش‌فاکتور">
                <div class="pf-accepted-card__fact"><span>سریال پیش‌فاکتور</span><strong>@pf.SerialNumber</strong></div>
                <div class="pf-accepted-card__fact"><span>تاریخ</span><strong>@pf.Date</strong></div>
                <div class="pf-accepted-card__fact"><span>تاریخ تأیید</span><strong>@(string.IsNullOrEmpty(pf.AcceptedDateTxt) ? "-" : pf.AcceptedDateTxt.Substring(0, 10))</strong></div>
            </div>
            <div class="pf-accepted-card__body">
                <section class="pf-accepted-card__section pf-accepted-card__customer">
                    <h3><span>اطلاعات مشتری</span><i class="fa fa-user" aria-hidden="true"></i></h3>
                    <div class="pf-accepted-card__row"><span>کد مشتری</span><strong>@(pf.CustomerEntity?.CustomerCode.ToString() ?? pf.CustomerCode?.ToString() ?? "-")</strong></div>
                    <div class="pf-accepted-card__row"><span>مشتری</span><strong>@pf.Customer @(string.IsNullOrWhiteSpace(pf.Customer) || string.IsNullOrWhiteSpace(pf.AgentName) ? "" : " | ")@pf.AgentName</strong></div>
                    <div class="pf-accepted-card__row"><span>کارشناس فروش</span><strong>@pf.UserCreator</strong></div>
                    <div class="pf-accepted-card__row"><span>کارشناس تأمین</span><strong>@(string.IsNullOrWhiteSpace(pf.UserTaminTxt) ? "-" : pf.UserTaminTxt)</strong></div>
                </section>
                <section class="pf-accepted-card__section pf-accepted-card__financial">
                    <h3><span>بررسی مالی</span><i class="fa fa-coins" aria-hidden="true"></i></h3>
                    <div class="pf-accepted-card__row"><span>مبلغ</span><strong><bdi dir="ltr">@($"{item.SumTotalAmountTax:n0}")</bdi> <small>@(pf.CurrencyTypeTxt ?? "ريال")</small></strong></div>
                    <div class="pf-accepted-card__row"><span>پیش‌پرداخت</span><strong><bdi dir="ltr">@($"{item.ReceiveAmount:n0}")</bdi> <small>@(pf.CurrencyTypeTxt ?? "ريال")</small></strong></div>
                    <div class="pf-accepted-card__row"><span>مانده حساب تقریبی *</span><strong><bdi dir="ltr">@($"{item.PaymentAmount:n0}")</bdi> <small>@(pf.CurrencyTypeTxt ?? "ريال")</small></strong></div>
                    <div class="pf-accepted-card__row"><span>وضعیت</span><strong>@(pf.AcceptedFinancial == false ? "رد شده از طرف مالی" : pf.PftypeTxt)</strong></div>
                    @if (pf.Pftype == (int)PreFactorEnum.در_انتظار_تایید_مدیر_فروش) {
                        <div class="pf-finance-card__controls">
                            <button type="button" class="pf-finance-card__button" onclick="acceptSalesAdmin('@pf.Id')">تأیید</button>
                            <button type="button" class="pf-finance-card__reject" onclick="showModalNotAccept('@pf.Id', 14)">عدم تأیید</button>
                        </div>
                    }
                </section>
            </div>
            <div class="pf-accepted-card__actions"><div class="pf-accepted-card__action-list">
                    @if (pf.Pftype > (int)PreFactorEnum.در_انتظار_تایید_مسئول_تامین) {
                        <button type="button" class="flex-center" aria-label="نمایش پیش فاکتور" style="color:var(--DarkColor)" data-title-right="نمایش پیش فاکتور" onclick="ShowPreviewPfactor('@pf.Id')"><span class="pf-accepted-card__action-icon" aria-hidden="true">
                            <i class="mp fa fa-eye"></i>
                        </span></button>
                    }
                    @if (pf.CustomerId != null) {
                        <button type="button" class="flex-center" aria-label="پروفایل" style="color:var(--DarkColor)" data-title-right="پروفایل" onclick="openCustomerProfile('@pf.CustomerId','@pf.SerialNumber')"><span class="pf-accepted-card__action-icon" aria-hidden="true">
                            <i class="mp fa fa-user"></i>
                        </span></button>
                    }
                    <button type="button" class="flex-center" aria-label="پیوست ها" style="color:var(--DarkColor)" data-title-right="پیوست ها" onclick="AttachDoc('@pf.Id')"><span class="pf-accepted-card__action-icon" aria-hidden="true">
                        <i class="mp fa fa-paperclip"></i>
                    </span></button>
                    <button type="button" class="flex-center" aria-label="بستن پیش فاکتور" style="color:var(--DarkColor)" data-title-right="بستن پیش فاکتور" onclick="ShowModalExpireDescription('@pf.Id','@string.Format("{0:n0}", pf.PaymentAmount)','@pf.SerialNumber','@pf.Customer @pf.AgentName',3 )"><span class="pf-accepted-card__action-icon" aria-hidden="true">
                        <i class="mp fa fa-times" style="font-size: 18px;"></i>
                    </span></button>
            </div></div>
            @if (!string.IsNullOrEmpty(pf.CommentText)) {
                <div class="pf-accepted-card__description"><span>توضیحات: </span><span style="white-space:pre-line">@Html.Raw(pf.CommentText)</span></div>
            }
        </div>
    </article>
}
</div>
