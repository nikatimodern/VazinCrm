@model OrederPrintViewModel
@{
    Layout = null;
    var isOfficial = Model.OfficialType == 1;
}

<!DOCTYPE html>

<html lang="fa">
<head>
    <meta charset="utf-8">
    <title>دستورتولید @Model.OrderHead.OrderNumber</title>


    <link rel="stylesheet" href="~/lib/Bootstrap/bootstrap5.3.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css?v=3.4.5" />
    <link rel="stylesheet" href="~/css/normalize.min.css">
    <link rel="stylesheet" href="~/css/paper.css?v=3.4.5">

</head>
<body dir="rtl" class="A5 landscape">

<section class="sheet d-flex" style="border-radius:12px">
    <article class="d-flex flex-column flex-grow-1 m-2" style="border: 2px solid gray; border-radius:8px; padding: 10px">

        <div class="d-flex align-items-center justify-content-between fbold p-2">
            <p style="font-size:24px">دستور تولید</p>
            <div class="d-flex flex-column align-items-center justify-content-center">
                <img style="width:20%" src="@Model.Logo" />
                <span style="font-size: 18px">@(isOfficial ? Model.Company.CompanyName : Model.Company.CompanyBrandName)</span>
            </div>
            <div class="d-flex align-items-center gap-2" style="font-size:16px">
                <span>شماره:</span>
                <span style="color:red">@Model.OrderHead.OrderNumber _ @Model.OfficialType</span>
            </div>
        </div>
        <hr class="my-2" />

        <div class="d-flex align-items-center justify-content-between py-2 px-3" style="border:1px solid gray;border-radius:5px;font-size: 14px">
            <p>
                <span class="text-muted">کارشناس فروش:</span>
                <span class="fbold">@Model.OrderHead.UserCreator</span>
            </p>
            <p>
                <span class="text-muted">کارشناس تامین:</span>
                <span class="fbold">@Model.OrderHead.UserTaminTxt</span>
            </p>
            <p>
                <span class="text-muted">تلفن:</span>
                <span class="fbold">@Model.OrderHead.Tel</span>
            </p>
            <p>
                <span class="text-muted">تاریخ:</span>
                <span class="fbold">@Model.OrderHead.OrderDate</span>
            </p>
        </div>

        <div class="w-100 my-2">
            <table class="table table-bordered table-hover table-striped m-0 w-100">
                <thead>
                <tr>
                    <th>ردیف</th>
                    <th>نوع جنس</th>
                    <th>شرح کالا</th>
                    <th>ابعاد</th>
                    <th>نوع دسته</th>
                    <th>کاست</th>
                    <th>رنگ زمینه</th>
                    <th>رنگ چاپ</th>
                    <th>تعداد رنگ</th>
                    <th>نام طرح</th>
                    <th>مقدار</th>
                    <th>ضخامت</th>
                </tr>
                </thead>
                <tbody>
                @{
                    var i = 0;
                    foreach (var item in Model.OrderHead.Orders) {
                        i += 1;
                        <tr style=" height:auto;">
                            <td style="padding-top:6px">@i</td>
                            <td style="padding-top:6px">@item.ProductSmallName</td>
                            <td style="padding-top:6px">@item.Product</td>
                            <td style="padding-top:6px">@item.Dimensions </td>
                            <td style="padding-top:6px">@item.CategoryType</td>
                            <td style="padding-top:6px">@item.Caset</td>
                            <td style="padding-top:6px">@item.BackgroundColor</td>
                            <td style="padding-top:6px">@item.PrintColor</td>
                            <td style="padding-top:6px">@item.CountColor</td>
                            <td style="padding-top:6px">@item.DesignName</td>
                            <td style="padding-top:6px">@item.Weight @item.UnitTxt</td>
                            <td style="padding-top:6px">@item.Thickness</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
        <hr class="my-2" />
        <div style="display:flex;flex-direction:column;width:100%">
            <label style="font-size:14px; ">توضیحات:</label>
            <textarea class="mt-1 fbold" style="min-height: 100px; border:none;resize:none" disabled>@Model.OrderHead.Description</textarea>
        </div>
    </article>
</section>

<div class="d-flex flex-column align-items-center justify-content-center w-100" style="position:fixed;top:80%;" id="previewPrintBtns">
    <div class="btn-group fbold">
        <button class="btn buttonCancel" style="width: 100px" onclick="window.close()">انصراف</button>
        <button class="btn buttonCancel justify-content-between" style="width: 100px" onclick="window.print()">
            <span>چاپ</span>
            <svg style="width: 18px" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5 2.75C5 1.784 5.784 1 6.75 1h6.5c.966 0 1.75.784 1.75 1.75v3.552c.377.046.752.097 1.126.153A2.212 2.212 0 0 1 18 8.653v4.097A2.25 2.25 0 0 1 15.75 15h-.241l.305 1.984A1.75 1.75 0 0 1 14.084 19H5.915a1.75 1.75 0 0 1-1.73-2.016L4.492 15H4.25A2.25 2.25 0 0 1 2 12.75V8.653c0-1.082.775-2.034 1.874-2.198.374-.056.75-.107 1.127-.153L5 6.25v-3.5Zm8.5 3.397a41.533 41.533 0 0 0-7 0V2.75a.25.25 0 0 1 .25-.25h6.5a.25.25 0 0 1 .25.25v3.397ZM6.608 12.5a.25.25 0 0 0-.247.212l-.693 4.5a.25.25 0 0 0 .247.288h8.17a.25.25 0 0 0 .246-.288l-.692-4.5a.25.25 0 0 0-.247-.212H6.608Z" clip-rule="evenodd" /></svg>
        </button>
    </div>
</div>

<script src="~/lib/Bootstrap/bootstrap5.3.bundle.min.js"></script>
</body>
</html>