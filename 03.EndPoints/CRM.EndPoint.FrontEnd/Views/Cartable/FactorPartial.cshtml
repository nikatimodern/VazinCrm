@using CRM.Core.Domain.Factors.Enum
@inject IFileVersionProvider AllocationFileVersions
@model CRM.EndPoint.FrontEnd.Models.Factor.FactorsViewModel ;

@{
    Layout = null;

    var isReadOnly = ViewBag.PassType == 7;
    var isAdminOrFinancial = !isReadOnly && (User.IsAdmin() || User.IsFinancial());
    var canManageAllocations = isAdminOrFinancial;
    var allocationScript = AllocationFileVersions.AddFileVersionToPath(Context.Request.PathBase, Url.Content("~/js/supplyFactor.js"));
    var passType = ViewBag.PassType; // 0: PreFactor/Factor, 1: CustomerProfile, 4: Deal, 5: Supply, 6: Email, 7: Customer approved factors (read-only).
}

@if (canManageAllocations) {
    @Html.AntiForgeryToken()
}

@if (passType == 0) {
    <partial name="~/Views/Factor/_FactorCards.cshtml" model="Model" />
} else {
<div class="d-flex flex-column w-100" style="gap: 5px">
    @foreach (var item in Model.Factors.OrderByDescending(f => f.ModifyDate)) {
        var isReturnFactor = item.ParentReturnedId != null;

        <div class="w-100 d-flex">
            @if (item.OfficialType == 1) {
                <div class="InfoDataHead_PrefactorRasmi">
                    <label style="transform: rotate(90deg)">رسمی</label>
                </div>
            } else {
                <div class="InfoDataHead_PrefactorNonRasmi">
                    <label style="transform: rotate(90deg)">غیررسمی</label>
                </div>
            }
            @if (item.Export == true) {
                <div style="background-color:lightgreen;border-block: 2px solid darkgreen; width:24px; display:flex;flex-direction:column;align-items:center;justify-content:space-evenly">
                    <label style="font-family:'IRANSansBold'; transform: rotate(90deg)">صـادراتی</label>
                </div>
            }

            <div class="d-flex flex-column flex-sm-row justify-content-between InfoDataItem_Prefactor w-100 py-2" style="@(isReturnFactor ? "border-color: darkred;background: rgb(136 0 0 / 5%)" : "")">

                <div class="d-flex flex-column flex-md-row justify-content-between w-100">

                    <div class="col-12 col-md-4 d-flex flex-row flex-md-column flex-wrap row-gap-2 column-gap-3 gap-md-2 px-2 justify-content-around">

                        <div class="justify-content-between" style=" display:flex;align-items:center;gap:6px">
                            <label style="color:gray">سریال:</label>
                            <label style="font-family:'IRANSansBold'">@item.SerialNumber</label>
                        </div>
                        <div class="justify-content-between" style="display:flex;align-items:center;gap:6px">
                            <label style="color:gray">پیش فاکتور:</label>
                            @if (passType == 0) {
                                <label class="hoverLink" style="font-family:'IRANSansBold';" onclick="showPrefac('@item.PfactorSerialNumber')">@item.PfactorSerialNumber</label>
                            } else {
                                <label style="font-family:'IRANSansBold';">@item.PfactorSerialNumber</label>
                            }
                        </div>
                        @if (item.DealSerialNumber != null) {
                            <div class="justify-content-between" style="display:flex;align-items:center;gap:6px">
                                <label style="color:gray">سریال سفارش:</label>
                                <label style="font-family:'IRANSansBold'">@item.DealSerialNumber</label>
                            </div>
                        }

                        <div class="justify-content-between" style="display:flex;align-items:center; gap:6px">
                            <label style="color:gray">تاریخ:</label>
                            <label style="font-family:'IRANSansBold'">@item.Date</label>
                        </div>

                    </div>

                    <div class="d-md-none my-2 " style="background-color: rgba(0, 0, 0, 0.15); width: 85%;height:1px;margin-inline:auto"></div>

                    <div class="col-12 col-md-5 flex-wrap flex-row flex-md-column gap-2 px-2 justify-content-around" style="text-align:center; display:flex;align-items:center">
                        <div style="display:flex;align-items:center;justify-content:space-between;gap:6px;width:100%">
                            <label style="color:gray">کد مشتری:</label>
                            <label style="font-family:'IRANSansBold'">@(item.CustomerCode?.ToString() ?? "-")</label>
                        </div>
                        <div style="display:flex;align-items:center;justify-content:space-between;gap:6px;width:100%">
                            <label style="color:gray">مشتری:</label>
                            <label style="font-family:'IRANSansBold'">@item.Customer @(string.IsNullOrWhiteSpace(item.Customer) || string.IsNullOrWhiteSpace(item.AgentName) ? "" : " | ")@item.AgentName</label>
                        </div>
                        <div style="display:flex;align-items:center;justify-content:space-between;gap:6px;width:100%">
                            <label style="color:gray">کارشناس فروش:</label>
                            <label style="font-family:'IRANSansBold'">@item.SelerFullName</label>
                        </div>

                    </div>

                    <div class="d-md-none my-2 " style="background-color: rgba(0, 0, 0, 0.15); width: 85%;height:1px;margin-inline:auto"></div>

                    <div class="col-12 col-md-3 d-flex flex-column align-items-stretch row-gap-2 px-3">
                        <div class="d-flex align-items-center justify-content-between gap-2">
                            <label style="color:gray">مبلغ:</label>
                            <strong style="color:@(isReturnFactor ? "darkred" : "")">
                                @($"{item.PaymentAmount:N0}") <small>@(item.CurrencyTypeTxt ?? "ريال")</small>
                            </strong>
                        </div>
                        @if (Model._Setting?.FactorTowStep == true || isReturnFactor || item.Returned) {
                            <div class="d-flex align-items-center justify-content-between gap-2">
                                <label style="color:gray">عملیات:</label>
                                <div class="d-flex align-items-center gap-1 gap-md-2 flex-wrap">
                                @if (Model._Setting?.FactorTowStep == true && !isReturnFactor && !item.Returned) {
                                    if (item.status == FactorStatus.در_دست_تایید) {
                                        if (isAdminOrFinancial) {
                                            <button class="buttonCancel3" style="font-size: 13px;" onclick="acceptFactor('@item.Id', 3, @passType)">
                                                ابطال
                                            </button>
                                            <button class="buttonGray" style="font-size: 13px;"
                                                    disabled="@(!item.HasExternalFinancialMapping)"
                                                    title="@(item.HasExternalFinancialMapping ? "تأیید فاکتور" : "ابتدا فاکتور را به یکی از نرم‌افزارهای مالی ارسال کنید")"
                                                    onclick="acceptFactor('@item.Id', 2, @passType)">
                                                تایید
                                            </button>

                                        } else {
                                            <div class="fbold" style="color:#CC9900">
                                                در دست تایید
                                            </div>
                                        }
                                    } else if (item.status == FactorStatus.تایید_شده) {
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="fbold" style="color:darkgreen">
                                                تایید شده
                                            </div>
                                            @if (isAdminOrFinancial) {
                                                <div style="cursor:pointer;color:#333" onclick="acceptFactor('@item.Id', 1, @passType)" data-title="بازگشت">
                                                    <svg style="width:16px;height:16px" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m15 15 6-6m0 0-6-6m6 6H9a6 6 0 0 0 0 12h3" /></svg>
                                                </div>
                                            }
                                        </div>
                                    } else {
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="fbold" style="color:darkred">
                                                ابطال شده
                                            </div>
                                            @if (isAdminOrFinancial) {
                                                <div style="cursor:pointer;color:#333" onclick="acceptFactor('@item.Id', 1, @passType)" data-title="بازگشت">
                                                    <svg style="width:16px;height:16px" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m15 15 6-6m0 0-6-6m6 6H9a6 6 0 0 0 0 12h3" /></svg>
                                                </div>
                                            }
                                        </div>
                                    }
                                } else if (isReturnFactor) {
                                    var text = $"<a href='/factor/PreviewFactorPrint/{item.ParentReturnedId}' target='_blank'>نمایش فاکتور اصلی</a>";
                                    <div class="fbold" style="color:darkred">
                                        <span>فاکتور برگشتی</span>
                                        <span data-bs-toggle="popover" data-bs-html="true" data-bs-content="@Html.Raw(text)">
                                        <svg style="width: 12px;color: #666" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M15 8A7 7 0 1 1 1 8a7 7 0 0 1 14 0ZM9 5a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM6.75 8a.75.75 0 0 0 0 1.5h.75v1.75a.75.75 0 0 0 1.5 0v-2.5A.75.75 0 0 0 8.25 8h-1.5Z" clip-rule="evenodd" /></svg>
                                    </span>
                                    </div>
                                } else if (item.Returned) {
                                    <div class="fbold" style="color:darkred">
                                        برگشت خورده
                                    </div>
                                }
                                </div>
                            </div>
                        }
                        <div class="d-flex align-items-center justify-content-between gap-2">
                            <label style="color:gray">ثبت شده توسط:</label>
                            <strong>@(string.IsNullOrWhiteSpace(item.UserCreator) ? "-" : item.UserCreator)</strong>
                        </div>
                    </div>
                    <div class="d-sm-none mt-2" style="background-color: rgba(0, 0, 0, 0.15); width: 85%;height:1px;margin-inline:auto"></div>
                </div>

                <div class="d-flex flex-sm-column align-items-center justify-content-evenly mt-2 mt-sm-0 mx-0 mx-sm-2" style="row-gap:8px;font-size:15px">
                    @if (isAdminOrFinancial) {
                        if (User.IsAdmin()) {
                            <button class="flex-center" data-title-right="حذف" style="color:var(--DarkColor);" onclick="deleteFactor('@item.Id', @passType)">
                                <i class="fa fa-trash"></i>
                            </button>
                        }

                        <button class="flex-center" data-title-right="ویرایش" style="color:var(--DarkColor);" onclick="upFactor('@item.Id', @passType)">
                            <i class="fa fa-pencil"></i>
                        </button>
                    }


                    @if (canManageAllocations) {
                        <button type="button" class="flex-center" data-title-right="تخصیص‌ها"
                                aria-label="مدیریت تخصیص آیتم‌های فروش" style="color:var(--DarkColor);"
                                data-allocation-script="@allocationScript"
                                onclick="openSalesFactorAllocationWorkspace(this, '@item.Id')">
                            <i class="fa fa-exchange-alt" aria-hidden="true"></i>
                        </button>
                    }

                    <button type="button" class="flex-center" data-title-right="ارتباط مالی" aria-label="ارتباط مالی"
                            onclick="showFactorExternalSoftwaresModal('@item.Id', '@item.SerialNumber')">
                        <i class="fa fa-link" aria-hidden="true"></i>
                    </button>

                    <button class="flex-center" data-title-right="نمایش فاکتور" style="color:var(--DarkColor);" onclick="ShowPreviewFactor('@item.Id')">
                        <i class="fa fa-eye"></i>
                    </button>

                    @if (!isReadOnly && passType != 1 && !User.IsCustomer() && item.CustomerId != null)
                    {
                        <button class="flex-center" data-title-right="پروفایل" style="color:var(--DarkColor);" onclick="openCustomerProfile('@item.CustomerId', '@item.PfactorSerialNumber')">
                            <i class="fa fa-user"></i>
                        </button>
                    }

                    @if ((isAdminOrFinancial) && !isReturnFactor) {
                        <button class="flex-center" data-title-right="فاکتور برگشتی" style="color:darkred" onclick="returnFactor('@item.Id', @passType)">
                            <i class="fa fa-arrow-right"></i>
                            @* <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M19.933 13.041a8 8 0 1 1 -9.925 -8.788c3.899 -1 7.935 1.007 9.425 4.747" /><path d="M20 4v5h-5" /></svg> *@
                        </button>
                    }

                    @if (!User.IsCustomer()) {
                        <button class="flex-center" data-title-right="تاریخچه" style="color:var(--DarkColor)" onclick="showLogEntity('@nameof(Factor)', '@item.Id')">
                            <svg style="width: 18px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" /><path d="M3 3v5h5" /><path d="M12 7v5l4 2" /></svg>
                        </button>
                    }
                </div>
            </div>
        </div>
    }
</div>

}
