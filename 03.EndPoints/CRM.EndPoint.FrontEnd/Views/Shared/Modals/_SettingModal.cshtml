@using CRM.EndPoint.FrontEnd.Models.Menu
@model IReadOnlyList<MenuItem>

<!-- Modal BaseSetting -->
<div class="modal fade" id="BaseSetting" tabindex="-1" role="dialog" aria-labelledby="baseSettingTitle" data-bs-focus="false">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content col-12">
            <div class="modal-header">
                <h1 class="modal-title" id="baseSettingTitle">تنظیمات</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>

            <div class="modal-body">
                <div id="settingsMenuContent" class="d-flex flex-column gap-1">
                    @foreach (var group in Model) {
                        <div class="menu-settings-section-title">@group.Title</div>
                        @foreach (var entry in group.SubItems) {
                            if (entry.DisplayType == MenuDisplayType.Link) {
                                <div class="erp-settings-favorite-row">
                                    <a class="buttonGreen-wide" href="@entry.Url" data-settings-menu-link="@entry.Id"
                                       data-settings-menu-title="@entry.Title" data-settings-menu-group="@group.Title">
                                        @Html.Raw(entry.IconHtml)
                                        @entry.Title
                                    </a>
                                    @if (!string.IsNullOrWhiteSpace(entry.FavoriteTargetId)) {
                                        <button type="button" class="erp-settings-favorite-button @(entry.IsFavorite ? "is-favorite" : "")"
                                                data-menu-favorite="@entry.FavoriteTargetId"
                                                aria-pressed="@(entry.IsFavorite ? "true" : "false")"
                                                aria-label="@(entry.IsFavorite ? "حذف از علاقه‌مندی‌ها" : "افزودن به علاقه‌مندی‌ها")"
                                                title="@(entry.IsFavorite ? "حذف از علاقه‌مندی‌ها" : "افزودن به علاقه‌مندی‌ها")">
                                            <svg viewBox="0 0 24 24" fill="@(entry.IsFavorite ? "currentColor" : "none")" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.77 5.82 21 7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                                        </button>
                                    }
                                </div>
                            } else if (entry.DisplayType is MenuDisplayType.Action or MenuDisplayType.Modal) {
                                <button type="button" class="buttonGreen-wide" onclick="@entry.OnClick">
                                    @Html.Raw(entry.IconHtml)
                                    @entry.Title
                                </button>
                            }
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
