    .user-search-wrap input:focus { border-color:#07877d; box-shadow:0 0 0 3px rgba(7,135,125,.12); }
    .user-clear-search { position:absolute; left:9px; top:50%; transform:translateY(-50%); border:0; background:transparent; color:#7b8794; font-size:22px; line-height:1; cursor:pointer; }
     .user-page-size { display:flex; flex-direction:column; align-items:stretch; gap:7px; color:#667584; font-size:12px; min-width:115px; flex:0 1 125px; }
    .user-page-size select { width:100%; min-height:38px; border-radius:9px; border-color:#dce4eb; }
    /* Final toolbar layout: search/page size on row one, filters on row two, role chips on row three. */
     .user-list-toolbar .user-toolbar-top { grid-area:search; display:flex; align-items:flex-end; gap:16px; width:100%; min-width:0; }
    .user-list-toolbar .user-toolbar-top .user-search-wrap { flex:1 1 auto; min-width:0; }
    .user-list-toolbar .user-toolbar-top .user-page-size { flex:0 0 145px; width:145px; min-width:145px; }
    .user-list-toolbar .user-filter-group { display:flex; flex-direction:column; align-items:stretch; gap:12px; }
    .user-list-toolbar .user-filter-row { display:flex; align-items:flex-end; justify-content:space-around; gap:16px; width:100%; }
    .user-list-toolbar .user-filter-row > .user-filter { flex:1 1 0; min-width:0; }
    .user-list-toolbar .user-filter-row > .user-role-multi-filter { flex:1 1 0; min-width:145px; }
    .user-list-toolbar .user-filter-row > .user-page-size { flex:0 0 145px; min-width:145px; }
    .user-list-toolbar .user-page-size { display:flex; flex-direction:column; align-items:stretch; gap:7px; color:#667584; font-size:12px; }
    .user-list-toolbar .user-page-size select { width:100%; min-height:38px; border-radius:9px; border-color:#dce4eb; }
    .user-list-toolbar .user-role-filter-chips-row { grid-area:chips; min-width:0; }
    .user-list-toolbar .user-role-filter-chips-row:has(.selected-user-role-chips:empty) { display:none; }
    @@media (max-width:1000px) {
        .user-list-toolbar .user-filter-row { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); justify-content:initial; }
        .user-list-toolbar .user-toolbar-top { align-items:flex-end; }
        .user-list-toolbar .user-toolbar-top .user-page-size { flex:0 0 125px; width:125px; min-width:125px; }
    }
    @@media (max-width:600px) {
