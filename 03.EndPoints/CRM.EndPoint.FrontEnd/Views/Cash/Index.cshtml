                    { data: "costCenterTxt" },
                    { data: "costDate" },
                    { data: "amount" },
                    { data: "fee" },
                    { data: "totalAmount" },
                    { data: "costDescription" },
                    { data: "userCreator" },
                    { data: "statusTxt" },
                    {
                        data: null,
                        render: (data, type, row) => `
