@using CRM.Core.Domain.PreFactors.Enum
@model PrefactorViewModel ;

@{
    Layout = null;
    var passType = ViewBag.PassType; // 1: CustomerProfile | 4: Deal
}

<div style="width:100%;display:flex;flex-direction:column;gap:5px ">
    @foreach (var item in Model.data) {
        bool isInvalid = item.Pftype is (int)PreFactorEnum.فاقد_اعتبار or (int)PreFactorEnum.بسته_شده
            or (int)PreFactorEnum.حذف_شده or (int)PreFactorEnum.برگشت_خورده_از_طرف_مدیر_فروش;


        <div class="mp" style="width:100%;display:flex;position:relative">
            @if (item.IsDeleted) {
                <div style="background-color:rgba(250,250,250,0.63); position:absolute;inset:0;z-index:10;border-radius: 5px 10px 10px 5px;"></div>
                <div style="padding:10px; border-radius:50px; background-color:red; color:aliceblue; opacity:30%;  position:absolute;font-family:'IRANSansBold'; font-size:24px; top: 50%;left: 50%;transform: rotate(350deg) translate(-50%, -70%);z-index:20">
                    <p>حذف شده</p>
                </div>
            }

            @if (item.OfficialType == 1) {
                <div class="mp InfoDataHead_PrefactorRasmi" style="display:flex;width:24px !important">
                    <label style="writing-mode: vertical-lr">رسمی</label>
                </div>
            } else {
                <div class="mp InfoDataHead_PrefactorNonRasmi" style="display:flex;width:24px !important">
                    <label style="writing-mode: vertical-lr">غیررسمی</label>
                </div>
            }

            @if (item.Export == true) {
                <div style="background-color:lightgreen;border-block: 2px solid darkgreen; width:24px; display:flex;flex-direction:column;align-items:center;justify-content:space-evenly">
                    <label style="font-family:'IRANSansBold'; writing-mode: vertical-lr">صـادراتی</label>
                </div>
            }
            <div data-serialnumber="@item.SerialNumber" class="d-flex flex-column flex-sm-row justify-content-between InfoDataItem_Prefactor w-100 py-2">
                <div class="d-flex flex-column w-100 justify-content-between">
                    <div class="mp flex-column flex-md-row px-2" style=" display:flex;justify-content:space-between; width:100%;direction:rtl; height:100%">

                        <div class="col-12 col-md-auto flex-md-column flex-wrap column-gap-3 row-gap-2 pe-2 ps-3" style="text-align:center; display:flex;align-items:center; justify-content:space-around">
                            <div class="d-flex align-items-center gap-1">
                                <label style="color:gray">سریال:</label>
                                <label class="fbold">@item.SerialNumber</label>
                            </div>
                            @if (item.DealSerialNumber != null && passType != 4) {
                                <div class="d-flex align-items-center gap-1">
                                    <label style="color:gray">سفارش:</label>
                                    <label class="fbold">@item.DealSerialNumber</label>
                                </div>
                            }
                            <div class="d-flex align-items-center gap-1">
                                <label style="color:gray">تاریخ:</label>
                                <label class="fbold">@item.Date</label>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <label style="color:gray">اعتبار:</label>
                                <label class="fbold">@item.ValidityDade</label>
                            </div>
                        </div>
                        <div class="d-md-none my-2 " style="background-color: rgba(0, 0, 0, 0.15); width: 85%;height:1px;margin-inline:auto"></div>

                        <div class="col-12 col-md flex-wrap column-gap-3 row-gap-2 px-2 ps-0 flex-md-column" style="flex-grow: 1.2;text-align:center; display:flex;align-items:center;justify-content:space-around;column-gap:24px !important">
                            <div style=" display:flex;align-items:center; justify-content:center;gap:6px">
                                <label style="color:gray">مبلغ:</label>
                                <label title="" style="font-family:'IRANSansBold'">@string.Format("{0:n0}", item.SumTotalAmountTax) <span style="font-size: 12px"> @(item.CurrencyTypeTxt ?? "ريال")</span></label>

                            </div>

                            <div style=" display:flex;align-items:center; justify-content:center;gap:6px ">
                                <label style=" color:gray">پیش پرداخت:</label>
                                <label style="font-family:'IRANSansBold'">@string.Format("{0:n0}", item.ReciveAmount) <span style="font-size: 12px"> @(item.CurrencyTypeTxt ?? "ريال")</span></label>
                            </div>
                            <div class="d-flex d-md-none flex-row flex-md-column align-items-center justify-content-center gap-2 gap-md-0">
                                <label style="color:gray">وضعیت:</label>
                                <label class="text-center" style="font-family:'IRANSansBold'">@item.PftypeTxt</label>
                            </div>

                            <div class="d-none d-md-flex" style=" align-items:center; justify-content:center;gap:4px;max-width: 180px;width: 100%">
                                <button class="buttonPurple p-0 flex-grow-1 fMedium" style="height:auto !important; border-radius:5px;font-size: 13px;max-width: 140px " onclick="ShowModalListInvoice('@item.Id', 1,'@item.SerialNumber', @passType, '@item.DealId', @isInvalid.ToString().ToLower())">صورت حساب</button>
                                @*@if (!Model.rols.Contains("مشتری") && !isInvalid) {
                                    if (Model._Setting.FinancialConfirm == true) {
                                        <button data-title="بارگذاری رسید پرداخت" class="buttonPurple p-0" style="height:20px;width:20px; border-radius:5px;" onclick="ShowModalAttachInvoice('@item.Id', 1, 1, @passType, '@item.DealId')">
                                            <svg style="width:14px;height:14px;" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                                        </button>
                                    } else {
                                        <button data-title="واریز پرداختی" class="buttonPurple p-0" style="height:20px;width:20px; border-radius:5px" onclick="ShowModalInvoice('@item.Id', 1, 1, @passType, '@item.DealId')">
                                            <svg style="width:14px;height:14px" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                                        </button>
                                        <button data-title="برگشت مبلغ" class="buttonPurple p-0" style="height:20px;width:20px; border-radius:5px" onclick="ShowModalInvoice('@item.Id', 1, 2,  @passType, '@item.DealId')">
                                            <svg style="width:14px;height:14px" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14" /></svg>
                                        </button>
                                    }
                                }*@
                            </div>
                        </div>
                        <div class="d-md-none my-2" style="background-color: rgba(0, 0, 0, 0.15); width: 85%;height:1px;margin-inline:auto"></div>

                        <div class="col-12 col-md flex-row flex-md-column flex-wrap gap-2 pe-2" style=" display:flex;align-items:center;justify-content:space-around">
                            <div class="d-none d-md-flex flex-row flex-md-column align-items-center justify-content-center gap-2 gap-md-0">
                                <label style="color:gray">وضعیت:</label>
                                <label class="text-center fbold" style="font-size: 13px">@item.PftypeTxt </label>
                            </div>

                            <div class="d-flex d-md-none" style=" align-items:center; justify-content:center;gap:4px">
                                <button class="buttonPurple px-4" style="height:auto !important;border-radius:5px;cursor:pointer; font-family:'IRANSansBold'" onclick="ShowModalListInvoice('@item.Id', 1, '@item.SerialNumber', @passType, '@item.DealId', @isInvalid.ToString().ToLower())">صورت حساب</button>
                                @*@if (!Model.rols.Contains("مشتری") && !isInvalid) {
                                    if (Model._Setting.FinancialConfirm == true) {
                                        <button class="buttonPurple p-0" style="height:20px !important;width:20px !important; border-radius:5px; cursor:pointer;" onclick="ShowModalAttachInvoice('@item.Id', 1, 1, @passType, '@item.DealId')">
                                            <svg style="width:14px;height:14px;" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                                        </button>
                                    } else {
                                        <button class="buttonPurple p-0" style="height:20px !important;width:20px !important; border-radius:5px; cursor:pointer;" onclick="ShowModalInvoice('@item.Id', 1, 1, @passType, '@item.DealId')">
                                            <svg style="width:14px;height:14px;" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                                        </button>

                                        <button class="buttonPurple p-0" style="height:20px !important;width:20px !important; border-radius:5px; cursor:pointer;" onclick="ShowModalInvoice('@item.Id', 1, 2, @passType, '@item.DealId')">
                                            <svg style="width:14px;height:14px;" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14" /></svg>
                                        </button>
                                    }
                                }*@
                            </div>

                            @switch (item.Pftype) {
                                case (int)PreFactorEnum.در_انتظار_واگذاری_به_مسئول_تامین:
                                    if (!Model.rols.Contains("مشتری")) {
                                        <div class="d-flex flex-row flex-md-column align-items-center justify-content-center gap-2">
                                            <form id="@item.Id">
                                                <select style="width:100%;" id="S_@item.Id" name="S_@item.Id" class="test form-select form-select-sm" required>
                                                    @foreach (var i in Model.UserTamin) {
                                                        <option value="@i.Id">@i.FullName</option>
                                                    }
                                                </select>
                                            </form>
                                            <button style="border-radius:4px;height:auto;width:80px " class="buttonGreen px-2" onclick="regUtamin('@item.Id', @passType, '@item.DealId')">ثبت</button>
                                        </div>
                                    }

                                    break;
                                case (int)PreFactorEnum.در_انتظار_تایید_مسئول_تامین:
                                    if (!Model.rols.Contains("مشتری")) {
                                        <button style="font-size: 13px;transition: all 0.3s;" class="ToSend w-auto h-auto d-flex align-items-center justify-content-center gap-1 px-2 py-1" onclick="resendRegUtamin('@item.Id', '@item.UserTaminId', @passType, '@item.DealId')">
                                            <i class="mp fa fa-paper-plane" aria-hidden="true"></i>
                                            <span>ارسال مجدد به تامین</span>
                                        </button>
                                    }

                                    break;
                                case (int)PreFactorEnum.در_انتظار_ارسال_به_مشتری:
                                    if (!Model.rols.Contains("مشتری")) {
                                        <button style="font-size: 13px;transition: all 0.3s" id="BtnSendToId" class="ToSend w-auto h-auto d-flex align-items-center gap-1 px-2 py-1" onclick="showMobileModal('@item.Id', @passType, '@item.DealId')">
                                            <i class="mp fa fa-paper-plane" aria-hidden="true"></i> ارسال شود
                                        </button>
                                    }

                                    break;
                                case (int)PreFactorEnum.در_انتظار_تایید_مشتری:
                                    if (!Model.rols.Contains("مشتری")) {
                                        <div class="d-flex flex-wrap flex-row flex-md-column align-items-center justify-content-center gap-2">
                                            <button style="font-size: 13px;transition: all 0.3s;" id="BtnSendToId" class="ToSend w-auto h-auto d-flex align-items-center justify-content-center gap-1 px-2 py-1" onclick="showMobileModal('@item.Id')">
                                                <i class="mp fa fa-paper-plane" aria-hidden="true"></i>
                                                <span>ارسال مجدد به مشتری</span>
                                            </button>
                                            <button style="font-size: 13px;transition: all 0.3s;" id="BtnSendToId" class="ToSend w-auto h-auto px-2 py-1" onclick="HandAccepting('@item.Id', @passType, '@item.DealId')"> تایید به صورت دستی</button>
                                        </div>

                                        //<button class="mp btn btn-outline-secondary" id="BackCustomerId" style="width:100px" onclick="backStepPf('@item.Id', 2,5)">برگشت</button>
                                    }

                                    break;
                                case (int)PreFactorEnum.فاقد_اعتبار:
                                    break;
                                case (int)PreFactorEnum.در_انتظار_تایید_مدیر_فروش:
                                    <div class="d-flex flex-wrap flex-row flex-md-column align-items-center justify-content-center gap-2" style="font-size: 13px">
                                        @if (!Model.rols.Contains("مشتری")) {
                                            <div style="display:flex;flex-direction:column;align-items:center;justify-content:space-evenly">
                                                <button style="border-radius:4px;height:auto;width:90px;" class="buttonGreen px-2" onclick="showModalCreateOrder(@((int)Model._Setting.SetAmountByRoleType), '@item.Id','@item.CustomerId', '@item.DealId', @item.DealSerialNumber)">حواله تولید</button>
                                            </div>
                                        }
                                    </div>
                                    break;
                                case (int)PreFactorEnum.در_انتظار_تایید_مالی:
                                    <div class="d-flex flex-wrap flex-row flex-md-column align-items-center justify-content-center gap-2" style="font-size: 13px">
                                        @if (!Model.rols.Contains("مشتری")) {
                                            <div style="display:flex;flex-direction:column;align-items:center;justify-content:space-evenly">
                                                <button style="border-radius:4px;height:auto;width:90px;" class="buttonGreen px-2" onclick="showModalCreateOrder(@((int)Model._Setting.SetAmountByRoleType), '@item.Id','@item.CustomerId', '@item.DealId', @item.DealSerialNumber)">حواله تولید</button>
                                            </div>
                                        }
                                    </div>
                                    break;
                                case (int)PreFactorEnum.در_انتظار_تولید:
                                    <div class="d-flex flex-wrap flex-row flex-md-column align-items-center justify-content-center gap-2" style="font-size: 13px">
                                        @if (!Model.rols.Contains("مشتری")) {
                                            <div style="display:flex;flex-direction:column;align-items:center;justify-content:space-evenly">
                                                <button style="border-radius:4px;height:auto;width:90px;" class="buttonGreen px-2" onclick="showModalCreateOrder(@((int)Model._Setting.SetAmountByRoleType), '@item.Id','@item.CustomerId', '@item.DealId', @item.DealSerialNumber)">حواله تولید</button>
                                            </div>
                                        }
                                        <div class="mp d-flex flex-wrap align-items-center justify-content-center gap-2">
                                            <button style="border-radius:4px;height:auto;width:80px " class="buttonGreen px-2" onclick="showModalDeliver('@item.Id',1 )">مانده تولید</button>
                                            @if (!Model.rols.Contains("مشتری")) {
                                                <button style="border-radius:4px;height:auto;width:80px" class="buttonGreen px-2" onclick="delivered('@item.Id', @passType, '@item.DealId')">اتمام کار</button>
                                            }
                                        </div>
                                    </div>
                                    break;
                                case (int)PreFactorEnum.جنس_به_مشتری_تحویل_داده_شد:
                                    <button style="border-radius:4px;height:auto;width:90px;" class="buttonGreen px-2" onclick="backDelivered('@item.Id', @passType, '@item.DealId')">لغو اتمام کار</button>
                                    break;
                            }
                        </div>
                        <div class="d-md-none my-2 " style="background-color: rgba(0, 0, 0, 0.15); width: 85%;height:1px;margin-inline:auto"></div>

                        <div class="col-12 col-md-2 pe-1 flex-row flex-md-column gap-2 flex-wrap" style=" font-size: 13px;display:flex;align-items:center;justify-content:space-evenly">
                            @if (Model._Setting.CrmFactors == true) {
                                if (item.CountFactor == 0) {
                                    <button class="buttonDisabled flex-center flex-column" disabled style="border-radius:4px;height:auto;width: 80px;padding: 0 4px;">
                                        <span>فاکتور ها </span>
                                        <span style="display:flex;justify-content:center;gap: 2px">
                                            <span> @item.CountFactor</span>
                                            <span>عدد</span>
                                        </span>
                                    </button>
                                } else {
                                    <button class="buttonGreen" style="display:flex;flex-direction:column;justify-content:center;align-items:center; border-radius:4px;height:auto;padding: 0 6px;width: 80px" onclick="GetFactorPartial(null, '@item.Id',this,null,0,'@item.SerialNumber',@passType,'@item.DealId')">
                                        <span>فاکتور ها </span>
                                        <span style="display:flex;justify-content:center;gap: 2px">
                                            <span> @item.CountFactor</span>
                                            <span>عدد</span>
                                        </span>
                                    </button>
                                }
                            }

                            @if (Model._Setting.Sepidar == true && !Model.rols.Contains("مشتری")) {
                                if (item.CountFactorSepidar == 0) {
                                    <button class="buttonDisabled flex-center flex-column" disabled style="border-radius:4px;height:auto;width: 80px;padding: 0 4px;">
                                        <span>فاکتور سپیدار </span>
                                        <span style="display:flex;justify-content:center;gap: 2px">
                                            <span> @item.CountFactorSepidar</span>
                                            <span>عدد</span>
                                        </span>
                                    </button>
                                } else {
                                    <button style="display:flex;flex-direction:column;justify-content:center;align-items:center; border-radius:4px;height:auto;padding: 0 6px;width: 80px" class="buttonPurple" onclick="getFacSepidar('@item.Id','@item.SerialNumber',this,@passType,'@item.DealId')">
                                        <span>فاکتور سپیدار </span>
                                        <span style="display:flex;justify-content:center;gap: 2px">
                                            <span> @item.CountFactorSepidar</span>
                                            <span>عدد</span>
                                        </span>
                                    </button>
                                }
                            }
                        </div>
                        <div class="d-sm-none mt-2 " style="background-color: rgba(0, 0, 0, 0.15); width: 85%;height:1px;margin-inline:auto"></div>
                    </div>

                    @{
                        var steps = new List<(int type, string label)> {
                            ((int)PreFactorEnum.در_انتظار_واگذاری_به_مسئول_تامین, "واگذاری تامین"),
                            ((int)PreFactorEnum.در_انتظار_تایید_مسئول_تامین, "تایید تامین"),
                            ((int)PreFactorEnum.در_انتظار_ارسال_به_مشتری, "ارسال به مشتری"),
                            ((int)PreFactorEnum.در_انتظار_تایید_مشتری, "تایید مشتری"),
                            ((int)PreFactorEnum.در_انتظار_تایید_مدیر_فروش, "تایید مدیرفروش"),
                            ((int)PreFactorEnum.در_انتظار_تایید_مالی, "تایید مالی"),
                            ((int)PreFactorEnum.در_انتظار_تولید, "تولید"),
                            ((int)PreFactorEnum.جنس_به_مشتری_تحویل_داده_شد, "تحویل مشتری")
                        };

                        int stepOrder = steps.FindIndex(s => s.type == item.Pftype);
                        double progressValue = (stepOrder - 0.3) / (steps.Count - 1.0);
                    }

                    <div class="progressTracker">
                        <div class="@(stepOrder <= 3 ? "progressTrackerFilledYellow" : "progressTrackerFilled")" style="width: @(stepOrder == steps.Count - 1 ? "100%" : $"calc(100% * {progressValue})")"></div>

                        <div class="d-flex justify-content-between w-100" style="height: 18px;top:-6px">
                            @for (int i = 0; i < steps.Count; i++) {
                                var (type, label) = steps[i];
                                bool isCompleted = stepOrder > i || item.Pftype == (int)PreFactorEnum.جنس_به_مشتری_تحویل_داده_شد;
                                bool isActive = stepOrder == i && item.Pftype != (int)PreFactorEnum.جنس_به_مشتری_تحویل_داده_شد;
                                bool isRejected = type == (int)PreFactorEnum.در_انتظار_تایید_مالی && item.AcceptedFinancial == false;
                                bool isYellow = stepOrder <= 3;


                                var dotClass = "progressTrackerDots";
                                dotClass += isRejected
                                    ? " rejectedTrack"
                                    : isCompleted
                                        ? isYellow ? " completedTrackYellow" : " completedTrack"
                                        : "";
                                dotClass += isActive ? " activeTrack" : "";

                                <div class="d-flex align-items-center justify-content-between flex-column position-relative">
                                    <div class="@dotClass">
                                        <svg class="completed-svg" style="width:100%;height:100%;display:none" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" /></svg>
                                        <svg class="rejected-svg" style="width:100%;height:100%;display:none" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM8.28 7.22a.75.75 0 0 0-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 1 0 1.06 1.06L10 11.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L11.06 10l1.72-1.72a.75.75 0 0 0-1.06-1.06L10 8.94 8.28 7.22Z" clip-rule="evenodd" /></svg>
                                    </div>


                                    <span style="position:absolute;width: max-content;top: 100%;">
                                        <span class="d-none @(!isInvalid ? "d-md-inline-block" : "")">@label</span>
                                        @if (!Model.rols.Contains("مشتری") && type == (int)PreFactorEnum.در_انتظار_واگذاری_به_مسئول_تامین && item.UserTaminId != null) {
                                            var text = "کارشناس تامین: " + item.UserTaminTxt;
                                            <span data-bs-toggle="popover" data-bs-content="@Html.Raw(text)">
                                                <svg style="width: 12px;color: #666" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M15 8A7 7 0 1 1 1 8a7 7 0 0 1 14 0ZM9 5a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM6.75 8a.75.75 0 0 0 0 1.5h.75v1.75a.75.75 0 0 0 1.5 0v-2.5A.75.75 0 0 0 8.25 8h-1.5Z" clip-rule="evenodd" /></svg>
                                            </span>
                                        }
                                    </span>
                                </div>
                            }
                        </div>

                        <div class="mt-3 @(isInvalid ? "d-md-inline-flex" : "d-md-none") flex-center position-absolute" style="top: 0; left: 0; right: 0">
                            <label class="fbold" style="font-size: 13px">
                                @item.PftypeTxt @(item.Pftype == (int)PreFactorEnum.بسته_شده ? $"({item.ExpireValidateDesc})" : "")
                            </label>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(item.CommentText) && !Model.rols.Contains("مشتری")) {
                        <div class="my-2 mt-md-3 mx-auto" style="background-color: rgba(0, 0, 0, 0.15); width: 85%;height:1px"></div>
                        <div class="d-flex" style="flex-wrap:wrap">
                            <div class="px-2 d-flex justify-content-around gap-1">
                                <label style="color:gray">توضیحات:</label>
                                <span class="flex-grow-1" style="white-space: pre-line">@Html.Raw(item.CommentText)</span>
                            </div>
                        </div>
                    }
                    <div class="d-sm-none mt-3" style="background-color: rgba(0, 0, 0, 0.15); width: 85%;height:1px;margin-inline:auto"></div>

                </div>

                <div class="flex-row flex-sm-column mt-2 mt-sm-0 mx-0 mx-sm-2 align-items-center" style=" display:flex; justify-content:space-evenly !important;row-gap:8px;font-size:15px">
                    @if (!Model.rols.Contains("مشتری") && (item.Pftype != (int)PreFactorEnum.جنس_به_مشتری_تحویل_داده_شد || Model.rols.Contains("مدیر ارشد") || Model.rols.Contains("مدیر فروش"))) {
                        if (item.Pftype <= (int)PreFactorEnum.در_انتظار_تایید_مسئول_تامین || Model.rols.Contains("مدیر ارشد")) {
                            <button class="flex-center" data-title-right="حذف" style="color:var(--DarkColor); border:none;background-color:transparent" onclick="delPfactor('@item.Id', @passType, '@item.DealId')">
                                <i class="mp fa fa-trash"></i>
                            </button>
                            <button class="flex-center" data-title-right="ویرایش" style="color:var(--DarkColor); border:none;background-color:transparent" onclick="upPfactor('@item.Id',@passType)">
                                <i class="mp fa fa-pencil"></i>
                            </button>
                        }
                    }

                    @if (item.CustomerId != null && passType == 4) {
                        <button class="flex-center" data-title-right="پروفایل" style="color:var(--DarkColor); border:none;background-color:transparent" onclick="openCustomerProfile('@item.CustomerId', '@item.SerialNumber')">
                            <i class="mp fa fa-user"></i>
                        </button>
                    }

                    @if (item.Pftype > (int)PreFactorEnum.در_انتظار_تایید_مسئول_تامین) {
                        <button class="flex-center" data-title-right="نمایش پیش فاکتور" style="z-index:15;color:var(--DarkColor); border:none;background-color:transparent" onclick="ShowPreviewPfactor('@item.Id')">
                            <i class="mp fa fa-eye"></i>
                        </button>
                    }

                    @if (!Model.rols.Contains("مشتری")) {
                        <button class="flex-center" data-title-right="پیوست ها" style="color:var(--DarkColor); border:none;background-color:transparent" onclick="AttachDoc('@item.Id')">
                            <i style="font-size:15px" class="mp fa fa-paperclip"></i>
                        </button>
                        if (item.Pftype > (int)PreFactorEnum.در_انتظار_تایید_مدیر_فروش) {
                            <button class="flex-center taminDropdownToggle" data-title-right="دستور تولیدها" style="color:var(--DarkColor); border:none;background-color:transparent" data-pfId="@item.Id">
                                <i class="mp fas fa-industry"></i>
                            </button>
                            <div class="taminDropdown"></div>
                        }

                        if (item.Pftype is (int)PreFactorEnum.در_انتظار_تولید or (int)PreFactorEnum.جنس_به_مشتری_تحویل_داده_شد) {
                            if (Model.rols.Contains("کارشناس مالی") || Model.rols.Contains("مدیر مالی") || Model.rols.Contains("مدیر ارشد")) {
                                <button class="flex-center" data-title-right="ثبت فاکتور جدید" style="color:var(--DarkColor); border:none;background-color:transparent" onclick="AddFactor('@item.Id', @passType)">
                                    <i style="font-size:15px" class="mp fa fa-arrow-left"></i>
                                </button>
                            }
                        }

                        if (item.Pftype == (int)PreFactorEnum.فاقد_اعتبار) { /*|| Model.rols.Contains("مدیر ارشد")*/
                            <button class="flex-center" data-title-right="بازگشت" style="color:var(--DarkColor); border:none;background-color:transparent" onclick="Backward('@item.Id', @passType, '@item.DealId')">
                                <i style="font-size:15px" class="mp fa fa-forward"></i>
                            </button>
                        }

                        if (Model.rols.Contains("مدیر ارشد") && item.CustomerId != null) {
                            <button class="flex-center" data-title-right="تغییر کارشناس" style="color:var(--DarkColor); border:none;background-color:transparent" onclick="showModalChangeUserPf('@item.Id', '@item.CustomerId')">
                                <svg style="width: 16px" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M11.078 2.25c-.917 0-1.699.663-1.85 1.567L9.05 4.889c-.02.12-.115.26-.297.348a7.493 7.493 0 0 0-.986.57c-.166.115-.334.126-.45.083L6.3 5.508a1.875 1.875 0 0 0-2.282.819l-.922 1.597a1.875 1.875 0 0 0 .432 2.385l.84.692c.095.078.17.229.154.43a7.598 7.598 0 0 0 0 1.139c.015.2-.059.352-.153.43l-.841.692a1.875 1.875 0 0 0-.432 2.385l.922 1.597a1.875 1.875 0 0 0 2.282.818l1.019-.382c.115-.043.283-.031.45.082.312.214.641.405.985.57.182.088.277.228.297.35l.178 1.071c.151.904.933 1.567 1.85 1.567h1.844c.916 0 1.699-.663 1.85-1.567l.178-1.072c.02-.12.114-.26.297-.349.344-.165.673-.356.985-.57.167-.114.335-.125.45-.082l1.02.382a1.875 1.875 0 0 0 2.28-.819l.923-1.597a1.875 1.875 0 0 0-.432-2.385l-.84-.692c-.095-.078-.17-.229-.154-.43a7.614 7.614 0 0 0 0-1.139c-.016-.2.059-.352.153-.43l.84-.692c.708-.582.891-1.59.433-2.385l-.922-1.597a1.875 1.875 0 0 0-2.282-.818l-1.02.382c-.114.043-.282.031-.449-.083a7.49 7.49 0 0 0-.985-.57c-.183-.087-.277-.227-.297-.348l-.179-1.072a1.875 1.875 0 0 0-1.85-1.567h-1.843ZM12 15.75a3.75 3.75 0 1 0 0-7.5 3.75 3.75 0 0 0 0 7.5Z" clip-rule="evenodd" /></svg>
                            </button>
                        }

                        <button class="flex-center" data-title-right="تاریخچه" style="color:var(--DarkColor)" onclick="showLogEntity('@nameof(PreFactor)', '@item.Id')">
                            <svg style="width: 18px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/></svg>
                        </button>
                    }

                </div>
            </div>
        </div>
    }
</div>



