@model IReadOnlyList<CRM.EndPoint.FrontEnd.Models.Taxation.TaxMemoryRow>
@{
    ViewData["Title"] = "حافظه‌های مالیاتی";
}
@section Styles {
    <link rel="stylesheet" href="~/css/taxation.css?release=7.0.4" asp-append-version="true" />
}
<section class="taxation-page" id="taxationAdmin" dir="rtl">
    <header class="taxation-heading">
        <div><h1>حافظه‌های مالیاتی</h1><p>حافظه فعال و آمادگی گواهی برای محیط آزمایشی را بررسی کنید.</p></div><span class="taxation-status">@Model.Count حافظه</span>
    </header>
    <partial name="_TaxationNavigation" />
    @Html.AntiForgeryToken()
    <p data-admin-status role="status"></p>
    <form method="post" class="taxation-workflow taxation-fields" data-admin-action="memory" data-url="@Url.Action("SaveMemory", "Taxation")">
        <label>شناسه حافظه <input class="form-control form-control-sm" name="fiscalId" required maxlength="6" pattern="[A-Za-z0-9]{6}" dir="ltr" /></label>
        <label>عنوان حافظه <input class="form-control form-control-sm" name="title" required maxlength="120" /></label>
        <button type="submit" class="btn btn-sm taxation-action">افزودن حافظه</button>
    </form>
    @if (Model.Count == 0)
    {
        <div class="taxation-panel taxation-empty"><i class="fas fa-shield-alt" aria-hidden="true"></i><strong>حافظه‌ای ثبت نشده است.</strong></div>
    }
    @foreach (var entry in Model)
    {
        var memory = entry.Memory;
        <article class="taxation-workflow">
            <header class="taxation-workflow-heading"><h2><bdi dir="ltr">@memory.FiscalId</bdi></h2><span class="taxation-status" data-status="@(memory.IsActive ? "Active" : null)">@(memory.IsActive ? "فعال" : "غیرفعال")</span></header>
            <p>@entry.SandboxReadiness</p>
            <form method="post" class="taxation-fields" data-admin-action="memory" data-url="@Url.Action("SaveMemory", "Taxation")">
                <input type="hidden" name="id" value="@memory.Id" />
                <input type="hidden" name="fiscalId" value="@memory.FiscalId" />
                <label>عنوان حافظه <input class="form-control form-control-sm" name="title" value="@memory.Title" maxlength="120" required /></label>
                <button type="submit" class="btn btn-sm taxation-validate">ذخیره عنوان</button>
            </form>
            <form method="post" data-admin-action="state" data-url="@Url.Action(memory.IsActive ? "Deactivate" : "Activate", "Taxation", new { id = memory.Id })">
                <button type="submit" class="btn btn-sm taxation-validate">@(memory.IsActive ? "غیرفعال کردن" : "فعال کردن")</button>
            </form>
        </article>
    }
</section>
@section Scripts {
    <script src="~/js/taxation-admin.js?release=7.0.4" asp-append-version="true"></script>
}
