            dealDetailsModalElement.addEventListener("hidden.bs.modal", () => { detailsRequestId++; });

            followUpModalElement?.querySelectorAll('input[name="overdueFollowUpStatus"]').forEach(input => {
                input.addEventListener("change", () => {
                    const isOpen = input.value === "1";
                    followUpDate.disabled = !isOpen;
                    document.getElementById("overdueFollowUpDateSection").classList.toggle("d-none", !isOpen);
                    document.getElementById("overdueFollowUpDateClear").disabled = followUpDate.disabled;
                    followUpError.classList.add("d-none");
                });
            });
            document.getElementById("overdueFollowUpDateClear")?.addEventListener("click", () => {
                followUpDate.value = "";
                followUpDate.classList.remove("overdue-date-expired");
                expiredDateNote.classList.add("d-none");
            });
            followUpDate?.addEventListener("input", () => {
                followUpDate.classList.remove("overdue-date-expired");
                expiredDateNote.classList.add("d-none");
            });
            followUpModalElement?.addEventListener("hidden.bs.modal", () => {
                followUpRequestId++;
                followUpDeal = null;
            });

            document.getElementById("overdueFollowUpContinue")?.addEventListener("click", async event => {
                if (!followUpDeal) return;
                const status = Number(followUpModalElement.querySelector('input[name="overdueFollowUpStatus"]:checked')?.value);
                const followUpDateValue = status === 1 ? followUpDate.value.trim() || null : null;
                const note = followUpNote.value.trim();
                if (!status) {
                    followUpError.textContent = "وضعیت سفارش را انتخاب کنید.";
                    followUpError.classList.remove("d-none");
                    return;
                }
                followUpError.classList.add("d-none");
                const submitButton = event.currentTarget;
                submitButton.disabled = true;
                try {
                    await axios.post("/OverdueDeal/UpdateFollowUp", {
                        id: followUpDeal.id, status, followUpDate: followUpDateValue, note,
                    });
                    followUpModal?.hide();
                    await loadOverdueDeals();
                    toastifySuccess("پیگیری سفارش ثبت شد.");
                } catch (err) {
                    followUpError.textContent = err.response?.data?.message || "ثبت پیگیری با خطا مواجه شد.";
                    followUpError.classList.remove("d-none");
                } finally {
                    submitButton.disabled = false;
                }
            });

            const escapeHtml = (value) => String(value ?? "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll("\"", "&quot;")
                .replaceAll("'", "&#39;");

            const formatDate = (value) => {
                if (!value) return "—";
                const date = new Date(value);
                if (Number.isNaN(date.getTime())) return "—";
                return new Intl.DateTimeFormat("fa-IR", {
                    year: "numeric", month: "2-digit", day: "2-digit",
                }).format(date);
            };

            const getWaitingDays = (value) => {
                if (!value) return 0;
                const date = new Date(value);
                if (Number.isNaN(date.getTime())) return 0;
                return Math.max(0, Math.floor((Date.now() - date.getTime()) / 86400000));
            };

            const renderCurrentPage = () => {

             

                const total = allDeals.length;
                const effectivePageSize = pageSize === 0 ? Math.max(total, 1) : pageSize;
                const totalPages = Math.max(1, Math.ceil(total / effectivePageSize));
                currentPage = Math.min(currentPage, totalPages);
                const startIndex = (currentPage - 1) * effectivePageSize;
                const pageDeals = allDeals.slice(startIndex, startIndex + effectivePageSize);

                tableBody.innerHTML = pageDeals.map(deal => {
                    const customerName = deal.cusCompanyName || deal.customerName || "—";
                    const waitingDays = getWaitingDays(deal.createDate);
                    return `
                        <tr>
                            <td data-label="شماره سفارش" class="text-nowrap fbold">${escapeHtml(deal.serialNumber)}</td>
                            <td data-label="عنوان سفارش">${escapeHtml(deal.title || "—")}</td>
                            <td data-label="مشتری">${escapeHtml(customerName)}</td>
                            <td data-label="کد مشتری" class="text-nowrap">${escapeHtml(deal.customerCode ?? "—")}</td>
                            <td data-label="تاریخ ثبت" class="text-nowrap">${escapeHtml(formatDate(deal.createDate))}</td>
                            <td data-label="تاریخ پیگیری مجدد" class="text-nowrap">${escapeHtml(formatDate(deal.overdueFollowUpAt))}</td>
                            <td data-label="مدت انتظار" class="text-nowrap"><span class="badge text-bg-danger">${escapeHtml(new Intl.NumberFormat("fa-IR").format(waitingDays))} روز</span></td>
                            <td data-label="ثبت‌کننده">${escapeHtml(deal.userCreator || "—")}</td>
                            <td data-label="توضیحات" style="min-width: 220px; white-space: normal;">${escapeHtml(deal.description || "—")}</td>
                            <td data-label="مشاهده" class="text-center">
                                <button type="button" class="btn btn-sm overdue-view-button overdue-details-button" data-deal-id="${escapeHtml(deal.id)}" title="مشاهده جزئیات" aria-label="مشاهده جزئیات سفارش">
                                    <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                </button>
                                <a class="btn btn-sm overdue-view-button" href="/Deal/Index?dealId=${encodeURIComponent(deal.id)}&serialNumber=${encodeURIComponent(deal.serialNumber)}" target="_blank" rel="noopener" title="نمایش در صفحه سفارشات در تب جدید" aria-label="نمایش سفارش در صفحه سفارشات در تب جدید">
                                    <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M13 5h6v6M19 5l-9 9" />
                                        <path d="M19 13v5a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h5" />
                                    </svg>
                                </a>
                                @if (User.IsInRole("مدیر فروش") || User.IsInRole("مدیر ارشد")) {
                                    <button type="button" class="btn btn-sm overdue-view-button overdue-follow-up-button" data-deal-id="${escapeHtml(deal.id)}" title="پیگیری و تعیین تکلیف سفارش" aria-label="پیگیری و تعیین تکلیف سفارش">
                                        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <rect x="5" y="4" width="14" height="18" rx="2"/>
                                            <path d="M9 4.5V3a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v1.5M8 10h5m-5 4h3m1 3 2 2 3-4"/>
                                        </svg>
                                    </button>
                                }
                            </td>
                        </tr>`;
                }).join("");

                tableWrap.classList.remove("d-none");
                pagination.classList.remove("d-none");
                const paginationText = `${new Intl.NumberFormat("fa-IR").format(total ? startIndex + 1 : 0)} تا ${new Intl.NumberFormat("fa-IR").format(Math.min(startIndex + pageDeals.length, total))} از ${new Intl.NumberFormat("fa-IR").format(total)}`;
                paginationInfo.textContent = paginationText;
                paginationInfoTop.textContent = paginationText;
                pageSizeSelect.value = String(pageSize);
                pageSizeSelectTop.value = String(pageSize);
                paginationTop.classList.remove("d-none");

                paginationButtons.innerHTML = "";
                paginationButtonsTop.innerHTML = "";
                const addPageButton = (label, page, disabled = false, active = false) => {
                    const li = document.createElement("li");
                    li.className = "page-item" + (disabled ? " disabled" : "") + (active ? " active" : "");
                    const button = document.createElement("button");
                    button.type = "button";
                    button.className = "page-link";
                    button.textContent = label;
                    button.disabled = disabled;
                    button.addEventListener("click", () => {
                        currentPage = page;
                        renderCurrentPage();
                    });
                    li.appendChild(button);
                    paginationButtons.appendChild(li);
                    const topLi = li.cloneNode(true);
                    const topButton = topLi.querySelector("button");
                    topButton.addEventListener("click", () => {
                        currentPage = page;
                        renderCurrentPage();
                    });
                    paginationButtonsTop.appendChild(topLi);
                };

                addPageButton("قبلی", Math.max(1, currentPage - 1), currentPage === 1);
                const first = Math.max(1, currentPage - 2);
                const last = Math.min(totalPages, currentPage + 2);
                for (let page = first; page <= last; page++) {
                    addPageButton(new Intl.NumberFormat("fa-IR").format(page), page, false, page === currentPage);
                }
                addPageButton("بعدی", Math.min(totalPages, currentPage + 1), currentPage === totalPages);

                tableBody.querySelectorAll(".overdue-follow-up-button").forEach(button => {
                    button.addEventListener("click", async () => {
                        const requestId = ++followUpRequestId;
                        followUpDeal = null;
                        button.disabled = true;
                        followUpError.classList.add("d-none");
                        document.getElementById("overdueFollowUpModalLabel").textContent = "در حال دریافت سفارش...";
                        followUpModalElement.querySelector('input[name="overdueFollowUpStatus"][value="1"]').checked = true;
                        const failedStatusRadio = followUpModalElement.querySelector('input[name="overdueFollowUpStatus"][value="2"]');
                        failedStatusRadio.disabled = false;
                        document.getElementById("overdueFailedStatusHint").textContent = "سفارش با نتیجه ناموفق بسته می‌شود.";
                        followUpDate.value = "";
                        followUpDate.disabled = true;
                        document.getElementById("overdueFollowUpDateSection").classList.remove("d-none");
                        document.getElementById("overdueFollowUpDateClear").disabled = true;
                        followUpDate.classList.remove("overdue-date-expired");
                        expiredDateNote.classList.add("d-none");
                        followUpNote.value = "";
                        dateTimePicker(followUpModalElement);
                        followUpModal?.show();
                        try {
                            const dealResponse = await axios.get("/OverdueDeal/GetOverdueDealDetails", {
                                params: { id: button.dataset.dealId },
                            });
                            if (requestId !== followUpRequestId) return;
                            followUpDeal = dealResponse.data;
                            document.getElementById("overdueFollowUpModalLabel").textContent =
                                `سفارش ${followUpDeal.serialNumber} · ${followUpDeal.title || followUpDeal.customerName || ""}`;
                            const currentStatus = String(followUpDeal.status);
                            const statusRadio = followUpModalElement.querySelector(`input[name="overdueFollowUpStatus"][value="${currentStatus}"]`);
                            if (statusRadio) statusRadio.checked = true;
                            followUpDate.disabled = currentStatus !== "1";
                            document.getElementById("overdueFollowUpDateSection").classList.toggle("d-none", currentStatus !== "1");
                            document.getElementById("overdueFollowUpDateClear").disabled = followUpDate.disabled;
                            failedStatusRadio.disabled = followUpDeal.factorCount > 0;
                            document.getElementById("overdueFailedStatusHint").textContent = failedStatusRadio.disabled
                                ? "این سفارش فاکتور دارد و نمی‌تواند ناموفق شود."
                                : "سفارش با نتیجه ناموفق بسته می‌شود.";
                            if (followUpDeal.overdueFollowUpAt) {
                                const previousDate = new Date(followUpDeal.overdueFollowUpAt);
                                followUpDate.value = new Intl.DateTimeFormat("fa-IR-u-nu-latn", {
                                    year: "numeric", month: "2-digit", day: "2-digit",
                                }).format(previousDate);
                                const expired = previousDate.getTime() < Date.now();
                                followUpDate.classList.toggle("overdue-date-expired", expired);
                                expiredDateNote.classList.toggle("d-none", !expired);
                            }
                            followUpNote.value = followUpDeal.overdueFollowUpNote || "";
                        } catch (err) {
                            if (requestId !== followUpRequestId) return;
                            followUpDeal = null;
                            followUpError.textContent = err.response?.status === 404
                                ? "این سفارش دیگر در فهرست سفارش‌های معوقه نیست."
                                : "دریافت اطلاعات پیگیری با خطا مواجه شد.";
                            followUpError.classList.remove("d-none");
                        } finally {
                            button.disabled = false;
                        }
                    });
                });

                tableBody.querySelectorAll(".overdue-details-button").forEach(button => {
                    button.addEventListener("click", async () => {
                        const requestId = ++detailsRequestId;
                        button.disabled = true;
                        dealCountsContent.innerHTML = "";
                        dealDetailsContent.textContent = "در حال دریافت جزئیات سفارش...";
                        dealDetailsModal?.show();

                        let deal;
                        try {
                            const response = await axios.get("/OverdueDeal/GetOverdueDealDetails", {
                                params: { id: button.dataset.dealId },
                            });
                            if (requestId !== detailsRequestId) return;
                            deal = response.data;
                        } catch (err) {
                            if (requestId !== detailsRequestId) return;
                            console.error("Failed to load overdue deal details:", err);
                            dealDetailsContent.textContent = err.response?.status === 404
                                ? "این سفارش دیگر در فهرست سفارش‌های معوقه نیست."
                                : "دریافت جزئیات سفارش با خطا مواجه شد. لطفاً دوباره تلاش کنید.";
                            return;
                        } finally {
                            button.disabled = false;
                        }

                        const counts = [
                            {
                                label: "گزارش‌های ثبت‌شده",
                                value: deal.reportCount,
                                color: "var(--overdue-secondary)",
                                icon: "<path d=\"M7 3h10a2 2 0 0 1 2 2v14l-7-3-7 3V5a2 2 0 0 1 2-2Z\"/>",
                            },
                            {
                                label: "پیش‌فاکتورهای صادرشده",
                                value: deal.preFactorCount,
                                totalAmount: deal.preFactorTotalAmount,
                                color: "var(--overdue-primary)",
                                icon: "<path d=\"M7 3h10a2 2 0 0 1 2 2v14l-7-3-7 3V5a2 2 0 0 1 2-2Z\"/><path d=\"M9 8h6M9 11h6\"/>",
                            },
                            {
                                label: "فاکتورها",
                                value: deal.factorCount,
                                totalAmount: deal.factorTotalAmount,
                                color: "var(--overdue-secondary)",
                                icon: "<path d=\"M6 2h9l4 4v16H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Z\"/><path d=\"M14 2v5h5M8 12h8M8 16h8\"/>",
                            },
                            {
                                label: "صورت‌حساب‌های سفارش",
                                value: deal.accountancyCount,
                                totalAmount: deal.accountancyTotalAmount,
                                color: "var(--overdue-primary)",
                                icon: "<path d=\"M5 3h14v18H5z\"/><path d=\"M8 7h8M8 11h8M8 15h5\"/>",
                            },
                        ];
                        dealCountsContent.innerHTML = counts.map(item => `
                            <div class="col-12 col-md-6 col-xl-3">
                                <div class="overdue-count-card ${Number(item.value) > 0 ? "overdue-document-card" : "overdue-count-card-disabled"}"
                                     data-document-kind="${item.label === "گزارش‌های ثبت‌شده" ? "reports" : item.label === "پیش‌فاکتورهای صادرشده" ? "prefactors" : item.label === "فاکتورها" ? "factors" : "payments"}"
                                     ${Number(item.value) > 0 ? 'role="button" tabindex="0" title="برای مشاهده موارد کلیک کنید"' : 'aria-disabled="true"'}>
                                    <div class="count-icon" style="color:${item.color}">
                                        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${item.icon}</svg>
                                    </div>
                                    <div class="count-value" style="font-size:1.25rem">${escapeHtml(item.value ?? 0)}</div>
                                    <div class="count-label">${escapeHtml(item.label)}</div>
                                    ${["پیش‌فاکتورهای صادرشده", "فاکتورها", "صورت‌حساب‌های سفارش"].includes(item.label) ? `
                                        <div class="count-total-label">${item.label === "صورت‌حساب‌های سفارش" ? "جمع واریزی نقدی و تهاتری" : "جمع کل"}</div>
                                        <div class="count-total-value">${new Intl.NumberFormat("fa-IR", { maximumFractionDigits: 0 }).format(Number(item.totalAmount ?? 0))} ریال</div>
                                    ` : ""}
                                </div>
                            </div>`).join("");

                        const openDocumentModal = async (kind) => {

                            if (kind === "payments") {
                                returnToDetailsAfterPayments = true;
                                dealDetailsModalElement.addEventListener("hidden.bs.modal", async () => {
                                    document.getElementById("TitleListInvoiceId").textContent = `صورت‌حساب‌های سفارش ${deal.serialNumber}`;
                                    await showModalDealInvoices(deal);
                                }, { once: true });
                                dealDetailsModal?.hide();
                                return;
                            }

                     


                            if (kind === "prefactors" || kind === "factors") {
                                const dealDocument = {
                                    id: deal.id,
                                    serialNumber: deal.serialNumber,
                                    customerId: deal.customerId,
                                    customerName: deal.customerName,
                                    customerCode: deal.customerCode,
                                    mobileNumber: deal.mobileNumber,
                                    userCreatorID: deal.userCreatorID,
                                    financialStatus: deal.financialStatus
                                };


                                    if (kind === "prefactors") {
                                        await showModalDealPreFactors(dealDocument);
                                    } else {
                                        await showModalDealFactors(dealDocument);
                                    }



                                // dealDetailsModalElement.addEventListener("hidden.bs.modal", async () => {

                                // }, { once: true });
                                // dealDetailsModal?.hide();

                                return;
                            }

                            const isReports = kind === "reports";
                            const titleByKind = {
                                reports: "گزارش‌های ثبت‌شده سفارش",
                                prefactors: "پیش‌فاکتورهای سفارش",
                                factors: "فاکتورهای سفارش"
                            };
                            dealReportsTitle.textContent = titleByKind[kind] || "جزئیات سفارش";
                            dealReportsContent.innerHTML = "";
                            dealReportsError.classList.add("d-none");
                            dealReportsLoading.classList.remove("d-none");
                            returnToDetailsAfterReports = true;
                            dealDetailsModalElement.addEventListener("hidden.bs.modal", () => dealReportsModal?.show(), { once: true });
                            dealDetailsModal?.hide();

                            try {
                                const response = await axios.post(
                                    `/Report/GetAllReportPartial?dealId=${encodeURIComponent(deal.id)}`,
                                    { filt: null, serVal: null, _type: -1, Count: -1 }
                                );
                                dealReportsContent.innerHTML = response.data?.html || "";
                                if (!response.data?.html) {
                                    dealReportsContent.textContent = "گزارشی برای این سفارش ثبت نشده است.";
                                }
                            } catch (error) {
                                console.error("Failed to load order documents:", error);
                                dealReportsError.textContent = "دریافت اطلاعات با خطا مواجه شد. لطفاً دوباره تلاش کنید.";
                                dealReportsError.classList.remove("d-none");
                            } finally {
                                dealReportsLoading.classList.add("d-none");
                            }
                        };

                        dealCountsContent.querySelectorAll(".overdue-document-card").forEach(card => {
                            const kind = card.dataset.documentKind;
                            const activate = () => openDocumentModal(kind);
                            card.addEventListener("click", activate);
                            card.addEventListener("keydown", event => {
                                if (event.key === "Enter" || event.key === " ") {
                                    event.preventDefault();
                                    activate();
                                }
                            });
                        });

                        const details = [
                            ["شماره سفارش", deal.serialNumber], ["عنوان سفارش", deal.title],
                            ["نام مشتری", deal.customerName], ["نام شرکت", deal.cusCompanyName],
                            ["کد مشتری", deal.customerCode], ["موبایل", deal.mobileNumber],
                            ["تاریخ ثبت", formatDate(deal.createDate)],
                            ["مدت انتظار", new Intl.NumberFormat("fa-IR").format(getWaitingDays(deal.createDate)) + " روز"],
                            ["ثبت‌کننده", deal.userCreator], ["توضیحات", deal.commentText],
                        ];
                        dealDetailsContent.innerHTML = details.map(([label, value]) => `
                            <div class="overdue-detail-cell ${label === "توضیحات" ? "overdue-detail-comment" : ""}" title="${escapeHtml(value || "—")}">
                                <span class="overdue-detail-label">${escapeHtml(label)}:</span>
                                <span class="overdue-detail-value">${escapeHtml(value || "—")}</span>
                            </div>`).join("");
                    });
                });
            };

            window.callbackFilterOverdueDeal = async () => {
                overdueFilter = window.filterDealConfig?.filterVar ?? null;
                overdueSearchVal = window.filterDealConfig?.varSearch ?? searchInput.value.trim();
                searchInput.value = overdueSearchVal || "";
                currentPage = 1;
                await loadOverdueDeals();
            };

            const loadOverdueDeals = async () => {
                const requestId = ++listRequestId;
                const withFollowUp = document.getElementById("overdueFilterActive").checked;
                document.getElementById("overdueDealsSubtitle").textContent = withFollowUp
                    ? "سفارش‌های ثبت‌شده از ۵ شهریور ۱۴۰۵ با فرصت پیگیری فعال" : "سفارش‌های ثبت‌شده از ۵ شهریور ۱۴۰۵ با بیش از ۱۴ روز انتظار";
                emptyTitle.textContent = withFollowUp ? "سفارش دارای فرصتی وجود ندارد" : "سفارش معوقه‌ای وجود ندارد";
                emptyText.textContent = withFollowUp
                    ? "سفارش ثبت‌شده‌ای در این بازه زمانی با فرصت پیگیری فعال پیدا نشد."
                    : "سفارش باز معوقه‌ای در این بازه زمانی پیدا نشد.";

                loading.classList.remove("d-none");
                error.classList.add("d-none");
                empty.classList.add("d-none");
                tableWrap.classList.add("d-none");
                tableBody.innerHTML = "";
                refreshButton.disabled = true;

                try {
                    const requestModel = { filt: overdueFilter, serVal: searchInput.value.trim() || null };
                    const response = await axios.post("/OverdueDeal/GetOverdueDeals", requestModel, {
                        params: { sortBy, sortDirection, withFollowUp },
                    });
                    if (requestId !== listRequestId) return;
                    allDeals = response.data?.data ?? [];
                    const overdueCount = Number(response.data?.overdueCount);
                    if (Number.isFinite(overdueCount)) {
                        document.querySelectorAll('a.menu-link[href="/OverdueDeal/Index"]').forEach(link => {
                            link.classList.toggle("blink-button", overdueCount > 0);
                            let badge = link.querySelector(".badge-count-overdue");
                            if (overdueCount <= 0) {
                                badge?.remove();
                                return;
                            }
                            if (!badge) {
                                badge = document.createElement("span");
                                badge.className = "badge-count badge-count-menuItem badge-count-overdue";
                                (link.querySelector(".menu-item-title") ?? link).appendChild(badge);
                            }
                            badge.textContent = String(overdueCount);
                        });
                    }
                    updateSortIndicators();
                    count.textContent = new Intl.NumberFormat("fa-IR").format(allDeals.length);
                    currentPage = Math.min(currentPage, Math.max(1, Math.ceil(allDeals.length / (pageSize || Math.max(allDeals.length, 1)))));

                    if (allDeals.length === 0) {
                        pagination.classList.add("d-none");
                        paginationTop.classList.add("d-none");
                        empty.classList.remove("d-none");
                        return;
                    }

                    renderCurrentPage();
                } catch (err) {
                    if (requestId !== listRequestId) return;
                    console.error("Failed to load overdue deals:", err);
                    error.textContent = err.response?.status === 403
                        ? "شما مجوز مشاهده این اطلاعات را ندارید."
                        : "دریافت سفارشات معوقه با خطا مواجه شد. لطفاً دوباره تلاش کنید.";
                    error.classList.remove("d-none");
                } finally {
                    if (requestId === listRequestId) {
                        loading.classList.add("d-none");
                        refreshButton.disabled = false;
                    }
                }
            };

            const updateSortIndicators = () => {
                document.querySelectorAll(".overdue-sort-button").forEach(button => {
                    const active = button.dataset.sortBy.toLowerCase() === sortBy.toLowerCase();
                    button.setAttribute("aria-sort", active
                        ? (sortDirection === "asc" ? "ascending" : "descending")
                        : "none");
                    const indicator = button.querySelector(".sort-indicator");
                    if (indicator) indicator.textContent = active
                        ? (sortDirection === "asc" ? "↑" : "↓")
                        : "↕";
                });
            };

            document.querySelectorAll(".overdue-sort-button").forEach(button => {
                button.addEventListener("click", () => {
                    const selectedSort = button.dataset.sortBy;
                    if (sortBy.toLowerCase() === selectedSort.toLowerCase()) {
                        sortDirection = sortDirection === "asc" ? "desc" : "asc";
                    } else {
                        sortBy = selectedSort;
                        sortDirection = "asc";
                    }
                    currentPage = 1;
                    loadOverdueDeals();
                });
            });

            const onPageSizeChange = (value) => {
                pageSize = Number(value);
                currentPage = 1;
                if (allDeals.length) renderCurrentPage();
            };
            pageSizeSelect.addEventListener("change", () => onPageSizeChange(pageSizeSelect.value));
            pageSizeSelectTop.addEventListener("change", () => onPageSizeChange(pageSizeSelectTop.value));
            followUpFilter.forEach(input => input.addEventListener("change", () => {
                if (!input.checked) return;
                currentPage = 1;
                loadOverdueDeals();
            }));
            const submitOverdueSearch = () => {
                overdueSearchVal = searchInput.value.trim();
                overdueDealSearchVal = overdueSearchVal;
                window.filterDealConfig.varSearch = overdueSearchVal;
                currentPage = 1;
                return loadOverdueDeals();
            };
            document.getElementById("overdueSearchForm").addEventListener("submit", event => {
                event.preventDefault();
                submitOverdueSearch();
            });
            searchInput.addEventListener("search", () => {
                if (!searchInput.value) submitOverdueSearch();
            });
            refreshButton.addEventListener("click", loadOverdueDeals);
            loadOverdueDeals();
        });
    </script>
    <script src="~/js/deal/deal-documents.js?release=7.5.6" data-page-bindings="currentDealDocumentData,showModalDealPreFactors,showModalDealFactors,showModalDealReports,showModalDealOrders,showModalDealSupplyFactors,showModalDealInvoices,getPreFactorFromDeal,getReportFromDeal,getSupplyFactorsFromDeal,getOrdersFromDeal,getInvoicesFromDeal,refreshDealPreFactors,refreshDealFactors,refreshDealReports,refreshDealOrders,refreshDealSupplyFactors,deletedPrefactorToggle" asp-append-version="true"></script>
}
