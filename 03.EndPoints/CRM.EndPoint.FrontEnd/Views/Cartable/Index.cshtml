                                <div style="position:relative;display: flex;align-items: center;justify-content: center;">
                                    <div id="dropdown-pFactor-filterList-toggle">
                                        <svg style="width: 18px" viewBox="0 0 576 512"><path d="M151.6 469.6C145.5 476.2 137 480 128 480s-17.5-3.8-23.6-10.4l-88-96c-11.9-13-11.1-33.3 2-45.2s33.3-11.1 45.2 2L96 365.7 96 64c0-17.7 14.3-32 32-32s32 14.3 32 32l0 301.7 32.4-35.4c11.9-13 32.2-13.9 45.2-2s13.9 32.2 2 45.2l-88 96zM320 480c-17.7 0-32-14.3-32-32s14.3-32 32-32l32 0c17.7 0 32 14.3 32 32s-14.3 32-32 32l-32 0zm0-128c-17.7 0-32-14.3-32-32s14.3-32 32-32l96 0c17.7 0 32 14.3 32 32s-14.3 32-32 32l-96 0zm0-128c-17.7 0-32-14.3-32-32s14.3-32 32-32l160 0c17.7 0 32 14.3 32 32s-14.3 32-32 32l-160 0zm0-128c-17.7 0-32-14.3-32-32s14.3-32 32-32l224 0c17.7 0 32 14.3 32 32s-14.3 32-32 32L320 96z" /></svg>

                                    </div>
                                    <div class="dropdown-pFactor-filterList">
                                        <div class="dropdown-pFactor-filter">
                                            <input type="checkbox" name="" id="pfFilterAll" />
                                            <label class="w-100" for="pfFilterAll">همه</label>
                                        </div>
                                        <div class="dropdown-pFactor-filter">
                                            <input type="checkbox" name="2" id="pfFilter2" />
                                            <label class="w-100" for="pfFilter2">در انتظار ارسال به مشتری</label>
                                        </div>
                                        <div class="dropdown-pFactor-filter">
                                            <input type="checkbox" name="3" id="pfFilter3" />
                                            <label class="w-100" for="pfFilter3">در انتظار تایید مشتری</label>
                                        </div>
                                        <div class="dropdown-pFactor-filter">
                                            <input type="checkbox" name="0" id="pfFilter0" />
                                            <label class="w-100" for="pfFilter0">در انتظار واگذاری به مسئول تامین</label>
                                        </div>
                                        <div class="dropdown-pFactor-filter">
                                            <input type="checkbox" name="7" id="pfFilter7" />
                                            <label class="w-100" for="pfFilter7">جنس به مشتری تحویل داده شد</label>
                                        </div>
                                        <div class="dropdown-pFactor-filter">
                                            <input type="checkbox" name="4" id="pfFilter4" />
                                            <label class="w-100" for="pfFilter4">فاقد اعتبار</label>
                                        </div>
                                        <div class="dropdown-pFactor-filter">
                                            <input type="checkbox" name="8" id="pfFilter8" />
                                            <label class="w-100" for="pfFilter8">بسته شده فاقد اعتبار</label>
                                        </div>
