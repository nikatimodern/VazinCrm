<!-- Modal SetAmountSales -->
<div class="modal fade" id="setAmountSalesModal" tabindex="-1" data-bs-focus="false" role="dialog" data-bs-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content col-12" style="padding:8px!important;">
            <div class="flex-center position-relative" style="height:32px; background: #02514C; color:white;border-radius:5px">
                <span class="modal-title fbold" style="font-size: 16px;"></span>

                @*
                <div data-bs-theme="dark" class="flex-center top-0 bottom-0 position-absolute" style="left: 6px">
                    <button type="button" class="btn-close opacity-100" data-bs-dismiss="modal"></button>
                </div>*@
            </div>

            <div class="modal-body pb-0 px-1 px-md-2" style=" display:flex;flex-direction:column; justify-content:space-between; width:100% !important;">
                <div class="col-12 d-flex flex-column" style="font-size:clamp(12px,2vw,14px)">
                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex align-items-center justify-content-between gap-5">
                            <div class="d-flex gap-2 fbold" style="color: #fff">
                                <span class="badge badge-gray pf-official-badge"></span>
                                <span class="badge badge-green pf-export-badge">صادراتی</span>
                            </div>
                        </div>
                        <div id="amountSalesContainer">
                            <form id="setAmountSalesForm" class="py-2 d-flex flex-column w-100 overflow-auto" style="max-height: calc(100dvh - 230px)">
                            </form>
                        </div>
                    </div>
                </div>
                <div class="mx-auto my-3" style="width:98%; height:2px; background-color:#1a2d41;"></div>
                <div class="d-flex justify-content-center gap-1">
                    <button class="btnGroupBase btnRight btnRightRed" type="button" onclick="toggleSalesModal()">انصراف</button>
                    <button class="btnGroupBase btnLeft btnLeftGreen fMedium" style="line-height: 1.1" type="button" onclick="submitSalesModal()">
                        تایید
                    </button>
                </div>

            </div>
        </div>
    </div>
</div>