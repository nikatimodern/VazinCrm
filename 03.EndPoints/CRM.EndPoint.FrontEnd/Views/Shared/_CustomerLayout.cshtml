        <div class="modal-content col-12 px-1 px-sm-2" style="background-color:#dfdfdf; padding-block:10px !important">

            <div style="height:28px;  display:flex; justify-content:center; align-items:center;  background: linear-gradient(to bottom, #025751, #00302d); color:white;border-radius:5px">
                <label class="fbold">جزئیات</label>
            </div>

            <div id="DeliverDetailBodyId">
