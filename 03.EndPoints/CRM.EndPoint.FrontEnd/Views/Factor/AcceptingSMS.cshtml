@using CRM.Core.Domain.PreFactors.Enum
@using CRM.EndPoint.FrontEnd.Models.Factor

@model UpdateCustomerVModel
@{
    Layout = null;
    var pfId = Model?.PreFactor?.Id;
    var customerCanChooseInvoiceType = Model?.Setting?.CustomerCanChooseInvoiceType.ToString().ToLower();
}

<!DOCTYPE html>
<html lang="fa">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>سامانه مدیریت مشتری</title>

    <link rel="stylesheet" href="~/lib/Bootstrap/bootstrap5.3.rtl.min.css" />
    <link rel="stylesheet" href="~/lib/SweetAlert/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/lib/toastify/toastify.min.css" />
    <link rel="stylesheet" href="~/lib/viewerJs/css/viewer.min.css" />

    <link rel="stylesheet" href="~/css/site.css?v=3.13.1" />

    <style>

        body {
            color: #333;
            background-color: #f7f7f7;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100dvh;
        }


        .form-label {
            margin-bottom: .25rem;
            font-size: 13px;
        }


        .status-box {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding-block: 12px;
        }


        .status-box img {
            height: 60px;
            margin-bottom: 4px;
        }


        .container-main {
            display: flex;
            flex-direction: column;
            width: 100%;
            max-width: 650px;
            margin: 12px;
            padding: 8px 16px;
            box-shadow: 0 6px 20px rgba(0, 0, 0, .08);
            background-color: #fff;
            border-radius: 12px;
        }


        .info-box {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid #eee;
        }


        .info-box div {
            text-align: center;
            flex: 1;
        }


        .info-title {
            font-size: 13px;
            color: #888;
        }


        .info-value {
            font-family: IRANSansBold;
            font-size: 16px;
            color: #222;
        }


        .pdf-link {
            color: #0d6efd;
            cursor: pointer;
            font-family: IRANSansBold;
            text-align: center;
            padding: 8px;
            border-bottom: 1px solid #eee;
        }


        .pdf-link svg {
            width: 20px;
            margin-left: 6px;
            vertical-align: middle;
        }


        #btnSubmitAcceptForm:disabled {
            opacity: 0.5;
        }


        .signature-box {
            position: relative;
            margin-top: 8px;
        }


        canvas {
            border: 2px dashed #ccc;
            border-radius: 12px;
            background: #fafafa;
            width: 100%;
            height: 240px;
        }


        .clear-btn {
            position: absolute;
            top: 10px;
            left: 10px;
            background: #fff;
            border: 1px solid #ddd;
            border-radius: 50%;
            padding: 6px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, .1);
            transition: 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
        }


        .clear-btn:hover {
            background: #f8f9fa;
            border-color: #bbb;
        }


        .brand {
            text-align: center;
            padding: 15px;
            font-size: 11px;
            border-top: 1px solid #eee;
            margin-top: 10px;
        }


        .swal2-title {
            font-size: 18px;
        }


        .swal2-popup {
            border-radius: 16px;
        }


        .swal2-html-container {
            font-size: 15px;
            margin-bottom: 10px;
        }


        label[for]:has(+ input[required])::after,
        label[for]:has(+ textarea[required])::after {
            content: " *";
            color: red;
        }

    </style>
</head>
<body dir="rtl">
<div id="FLshowLoading" style="z-index: 9000;position: fixed;inset: 0;height:100dvh;display:none">
    <div>
        <div class="loader"></div>
    </div>
</div>

<div class="container-main">
    @if (Model.PreFactor.Pftype == (int)PreFactorEnum.فاقد_اعتبار) {
        <div class="status-box text-center">
            <img src="~/Img/NotAccepted.png" alt="Not Accepted" />
            <h5 class="mt-3">پیش فاکتور شما از اعتبار خارج شده است</h5>
            <p class="mt-2 text-muted">لطفا با کارشناسان فروش تماس بگیرید</p>
        </div>
    } else {
        if (Model.PreFactor.Accepted) {
            <div class="status-box">
                <img src="~/Img/accept-icon.png" alt="Accepted" class="mb-2" />
                <h6 class="mt-2" style="font-size: 15px;margin-bottom: 10px;"> پیش‌فاکتور تأیید شد؛ از اعتماد شما سپاسگزاریم.</h6>
                <button class="btn btn-primary btn-sm rounded-pill px-4 mb-2" onclick="ShowPreviewPfactor('@Model.PreFactor.Id')">
                    نمایش پیش فاکتور تایید شده
                </button>
                <span class="btn btn-secondary btn-sm rounded-pill px-2 mb-3" onclick="showLoginCustomerModal()">
                    ورود به پنل کاربری و پیام رسان
                </span>
                <p class="text-muted mb-3" style="font-size: 12px;">
                    لطفاً نسبت به پرداخت پیش‌پرداخت در اسرع وقت اقدام فرمایید.
                    @* لطفاً مبلغ پیش‌پرداخت را به حساب زیر واریز و تصویر فیش پرداختی را ارسال فرمایید. *@
                </p>

                @if (Model.PreFactor.OfficialType == 1) {
                    <div class="d-flex align-items-center gap-2 flex-wrap justify-content-center">
                        @foreach (var item in Model.BankAccounts ?? []) {
                            <div class="card mb-3">
                                <div class="card-body">
                                    <h6 class="card-title text-center">اطلاعات پرداخت</h6>
                                    <ul class="list-unstyled mb-0" style="font-size: 13px; line-height:2;">
                                        <li>
                                            <span class="text-muted">نام حساب:</span> <b>@item.AccountName (@item.BankName)</b>
                                        </li>
                                        <li>
                                            <span class="text-muted">شماره کارت:</span> <b>@item.CartNumber</b>
                                            <svg onclick="copyToClipboard(@item.CartNumber)" style="width: 16px;color: #888;cursor: pointer" fill="currentColor" viewBox="0 0 256 256"><path d="M216,32H88a8,8,0,0,0-8,8V80H40a8,8,0,0,0-8,8V216a8,8,0,0,0,8,8H168a8,8,0,0,0,8-8V176h40a8,8,0,0,0,8-8V40A8,8,0,0,0,216,32ZM160,208H48V96H160Zm48-48H176V88a8,8,0,0,0-8-8H96V48H208Z"></path></svg>
                                        </li>
                                        <li>
                                            <span class="text-muted">شماره حساب:</span> <b>@item.AccountNumber</b>
                                            <svg onclick="copyToClipboard(@item.AccountNumber)" style="width: 16px;color: #888;cursor: pointer" fill="currentColor" viewBox="0 0 256 256"><path d="M216,32H88a8,8,0,0,0-8,8V80H40a8,8,0,0,0-8,8V216a8,8,0,0,0,8,8H168a8,8,0,0,0,8-8V176h40a8,8,0,0,0,8-8V40A8,8,0,0,0,216,32ZM160,208H48V96H160Zm48-48H176V88a8,8,0,0,0-8-8H96V48H208Z"></path></svg>
                                        </li>
                                        <li>
                                            <span class="text-muted">شماره شبا:</span> <b>@item.ShebaNumber</b>
                                            <svg onclick="copyToClipboard('@item.ShebaNumber'.replace(/^IR\s?/, '').trim())" style="width: 16px;color: #888;cursor: pointer" fill="currentColor" viewBox="0 0 256 256"><path d="M216,32H88a8,8,0,0,0-8,8V80H40a8,8,0,0,0-8,8V216a8,8,0,0,0,8,8H168a8,8,0,0,0,8-8V176h40a8,8,0,0,0,8-8V40A8,8,0,0,0,216,32ZM160,208H48V96H160Zm48-48H176V88a8,8,0,0,0-8-8H96V48H208Z"></path></svg>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        }
                    </div>
                }
                @*@if (Model.Setting.FinancialConfirm == true) {
                    <button id="showLoginCustomerModalBtn" class="btn btn-outline-primary btn-sm rounded-pill px-3 mb-2" onclick="showLoginCustomerModal('receipt')">بارگذاری رسید پرداخت</button>

                    <div id="paymentReceiptContainer" class="align-items-center flex-column" style="display: none">
                        <div class="mb-2 w-100">
                            <span class="form-label fbold">بارگذاری تصویر رسید پرداخت</span>
                            <div class="container-uploader">
                                <input type="file" class="uploadBtn" data-varlist="paymentReceiptList" data-showlist="DivShowPaymentReceipt" id="paymentReceipt" multiple accept="*">
                                <label for="paymentReceipt">
                                    <span>تصویر رسید را انتخاب کنید و ثبت را بزنید</span>
                                    <svg style="width: 16px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" /></svg>
                                </label>
                                <div class="image-display" id="DivShowPaymentReceipt"></div>
                            </div>
                        </div>

                        <button class="btn btn-success btn-sm rounded-pill px-3 mb-3" onclick="submitPaymentReceipt()">ثبت</button>
                    </div>
                }*@
            </div>
        } else {
            <div class="info-box">
                <div>
                    <p class="info-title">شماره پیش‌فاکتور</p>
                    <p class="info-value">@Model.PreFactor.SerialNumber</p>
                </div>
                <div>
                    <p class="info-title">مبلغ</p>
                    <p class="info-value">
                        @($"{Model.PreFactor.PaymentAmount:n0}")
                        <span style="font-size: 11px">ریال</span>
                    </p>
                </div>
            </div>

            <div class="pdf-link" onclick="ShowPreviewPfactor('@Model.PreFactor.Id')">
                مشاهده پیش‌فاکتور
                <svg style="width: 24px" fill="currentColor" viewBox="0 0 256 256"><path d="M44,120H212a4,4,0,0,0,4-4V88a8,8,0,0,0-2.34-5.66l-56-56A8,8,0,0,0,152,24H56A16,16,0,0,0,40,40v76A4,4,0,0,0,44,120ZM152,44l44,44H152Zm72,108.53a8.18,8.18,0,0,1-8.25,7.47H192v16h15.73a8.17,8.17,0,0,1,8.25,7.47,8,8,0,0,1-8,8.53H192v15.73a8.17,8.17,0,0,1-7.47,8.25,8,8,0,0,1-8.53-8V152a8,8,0,0,1,8-8h32A8,8,0,0,1,224,152.53ZM64,144H48a8,8,0,0,0-8,8v55.73A8.17,8.17,0,0,0,47.47,216,8,8,0,0,0,56,208v-8h7.4c15.24,0,28.14-11.92,28.59-27.15A28,28,0,0,0,64,144Zm-.35,40H56V160h8a12,12,0,0,1,12,13.16A12.25,12.25,0,0,1,63.65,184ZM128,144H112a8,8,0,0,0-8,8v56a8,8,0,0,0,8,8h15.32c19.66,0,36.21-15.48,36.67-35.13A36,36,0,0,0,128,144Zm-.49,56H120V160h8a20,20,0,0,1,20,20.77C147.58,191.59,138.34,200,127.51,200Z"></path></svg>
            </div>

            <form id="acceptForm" style="padding: 12px 0">
                <div class="mb-2">
                    <label class="fbold mb-1" for="agentNameCustomer">نام نماینده یا خریدار</label>
                    <input type="text" style="border-radius: 10px" class="form-control" id="agentNameCustomer" name="agentName" value="@Model.PreFactor.AgentName" />
                </div>

                <div class="mb-2">
                    <div class="mb-1 d-flex align-items-end justify-content-between">
                        <span class="fbold ">محل امضاء</span>
                        <span class="text-muted" style="font-size: 11px">در کادر زیر امضاء خود را وارد کنید</span>
                    </div>
                    <div class="signature-box">
                        <canvas id="signatureCanvas" tabindex="0"></canvas>
                        <button type="button" class="clear-btn" id="clearBtn" title="پاک کردن">
                            <svg style="width: 18px;color: #dc3545" fill="currentColor" viewBox="0 0 256 256"><path d="M225,80.4,183.6,39a24,24,0,0,0-33.94,0L31,157.66a24,24,0,0,0,0,33.94l30.06,30.06A8,8,0,0,0,66.74,224H216a8,8,0,0,0,0-16h-84.7L225,114.34A24,24,0,0,0,225,80.4ZM213.67,103,160,156.69,107.31,104,161,50.34a8,8,0,0,1,11.32,0l41.38,41.38a8,8,0,0,1,0,11.31Z"></path></svg>
                        </button>
                    </div>
                </div>

                <div class="form-check mb-2">
                    <input type="checkbox" class="form-check-input" id="chkAccept">
                    <label class="form-check-label fbold" style="font-size: 12px" for="chkAccept">پیش‌فاکتور شماره @Model.PreFactor.SerialNumber مورد تایید می ‌باشد</label>
                </div>

                <button type="submit" id="btnSubmitAcceptForm" class="btn btn-primary w-100 mb-2 p-2 rounded-pill" disabled>
                    تایید
                </button>
            </form>

            <div class="border-top text-center" style="padding-top: 10px;">
                <button type="button" onclick="showLoginCustomerModal('chat')" class="btn btn-sm btn-dark rounded-pill">
                    ارتباط با کارشناسان وزین (پیام رسان)
                </button>
            </div>
            <div class="brand">

                <a class="fMedium" href="//www.natix.ir" target="_blank">WWW.NATIX.IR</a>
                <br>
                طراحی و تولید توسط شرکت مهندسی نرم‌افزاری ناتیکس
            </div>
        }
    }
</div>


<div id="divFrame" style="display:none; justify-content:center; align-items:center;z-index: 9000; height:90dvh; width:100%; top:50%;transform: translateY(-50%);position:fixed;background-color:hsla(1, 100%, 100%,0.9)">
    <div style=" position:fixed;top:30px;right:30px; display:flex;justify-content:start">
        <span class="btn btn-dark d-flex align-items-center justify-content-center p-2" style="cursor:pointer;" onclick="hideDivFrame()">
            <svg style="width: 24px" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
        </span>
    </div>
    <iframe src="" id="IframeId" style="height:100%;width:100%;"></iframe>
</div>


<!-- Modal loginCustomer -->
<div class="modal fade" id="loginCustomerModal" tabindex="-1" role="dialog" data-bs-focus="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #f1f1f1;">
                <h1 class="modal-title fs-5" style="color: #333;">احراز هویت</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="loginCustomerContainer">

                    <div id="selectAccountCustomerContainer" style="display: none">
                        <p class="mb-3 text-muted fMedium" style="font-size: 12px">
                            چند حساب با این شماره یافت شد. لطفاً یکی را انتخاب کنید:
                        </p>
                        <div id="accountCustomerList" class="list-group"></div>
                    </div>


                    <div id="loginOtpCustomerContainer" class="flex-column align-items-center w-100" style="display: flex">
                        <div id="otpCustomerSection" class="w-100 d-flex flex-column">
                            <p class="text-muted fMedium" style="font-size: 12px">لطفا کد ارسال شده به شماره
                                <strong id="phoneNumberOtpCustomerLogin"></strong> را وارد نمایید
                            </p>
                            <div class="input-group mb-2" style="height: 33px">
                                <span class="input-group-text h-100">
                                    <svg style="height: 100%;color: #787c83" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z"></path></svg>
                                </span>
                                <input id="otpCustomerLoginInp" class="form-control bootstrap-only h-100 digitNumber text-start" name="otp" autocomplete="one-time-code" inputmode="numeric" type="text" autofocus maxlength="4" placeholder="کد ورود">
                            </div>
                            <div id="verifyOtpCustomerBtnWrapper" class="w-100 justify-content-between" style="display: flex">
                                <p class="text-muted" style="display: flex;align-items: baseline; gap: 4px;font-size: 12px">
                                    <span>زمان باقی‌مانده: </span>
                                    <strong id="remainingSecondsOtpCustomerLogin"></strong>
                                </p>
                                <button id="verifyOtpCustomerBtn" class="btn btn-sm btn-success">تایید کد</button>
                            </div>
                        </div>
                        <div class="d-flex align-items-center justify-content-between w-100">
                            <p class="fMedium" style="color: #dc3545;font-size: 12px" id="otpCustomerLoginMsg"></p>
                            <button id="resendOtpCustomerBtn" class="btn btn-sm btn-secondary" style="display: none">ارسال مجدد کد</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script src="~/lib/Signature_pad/signature_pad.umd.min.js"></script>
<script src="~/lib/Bootstrap/bootstrap5.3.bundle.min.js"></script>
<script src="~/lib/jquery/jquery.min.js"></script>
<script src="~/lib/SweetAlert/sweetalert2.all.min.js"></script>
<script src="~/lib/trim-canvas/trim-canvas.js"></script>
<script src="~/lib/toastify/toastify-js.js"></script>
@* <script src="~/lib/lightBox2/js/lightbox.min.js"></script> *@
<script src="~/lib/viewerJs/js/viewer.min.js"></script>
<script src="~/js/UploadFile.js?v=3.13.1"></script>
<script src="~/js/site.js?v=3.13.1"></script>


<script>
    var paymentReceiptList = [];
    const mySer = new MyService();
    let signaturePad;
    let userMobile = "@Model.PreFactor.Cus_Mobile";
    let selectedCustomerUserId;
    let verified = @ViewBag.isLogin;

    document.addEventListener("DOMContentLoaded", async () => {
        // signature
        initSignature();
        const chkAccept = document.getElementById("chkAccept");
        chkAccept?.addEventListener("change", (e) => document.getElementById("btnSubmitAcceptForm").disabled = !e.target.checked);

        document.getElementById("acceptForm")?.addEventListener("submit", async (e) => {
            e.preventDefault();

            if (signaturePad.isEmpty()) {
                Swal.fire({ icon: "error", text: "لطفاً امضاء خود را وارد کنید.", confirmButtonText: "باشه", confirmButtonColor: "#0d6efd" });
                return;
            }

            if (!chkAccept.checked) {
                Swal.fire({ icon: "error", text: "لطفا پیش‌فاکتور را تایید نمایید", confirmButtonText: "باشه", confirmButtonColor: "#0d6efd" });
                return;
            }

            if (@customerCanChooseInvoiceType) {
                const result = await Swal.fire({
                    icon: "question",
                    title: "انتخاب نوع فاکتور",
                    text: "لطفاً نوع فاکتور مورد نظر خود را انتخاب کنید:",
                    showDenyButton: true,
                    confirmButtonText: "فاکتور رسمی",
                    denyButtonText: "فاکتور غیررسمی",
                    confirmButtonColor: "var(--DarkColor)",
                    denyButtonColor: "var(--DarkColorLight)",
                });

                if (result.isConfirmed || result.isDenied) {
                    const officialType = result.isConfirmed ? 1 : 0;
                    await sendSignature(officialType);
                }
            } else {
                await sendSignature();
            }
        });


        // attach Receipt
        //ShowPaymentReceiptAttach('@pfId');

        const showLoginCustomerModalBtn = document.getElementById("showLoginCustomerModalBtn");
        const paymentReceiptContainer = document.getElementById("paymentReceiptContainer");
        if (showLoginCustomerModalBtn && paymentReceiptContainer) {
            showLoginCustomerModalBtn.style.display = verified === 1 ? "none" : "";
            paymentReceiptContainer.style.display = verified === 1 ? "flex" : "none";
        }

        const input = document.querySelector("#otpCustomerSection input[autocomplete='one-time-code']");
        const btn = document.getElementById("verifyOtpCustomerBtn");
        await readOtp(input, btn);
    });


    async function sendSignature(officialType = null) {
        try {
            FLshowLoading();

            const trimmedCanvas = trimCanvas(signaturePad.canvas, { copy: true });
            const emzaData = trimmedCanvas.toDataURL();

            const data = {
                id: '@pfId',
                emza: emzaData,
                agentName: document.getElementById("agentNameCustomer").value,
            };

            if (officialType !== null) {
                data.officialType = officialType;
            }

            const res = await fetch(`/Factor/AcceptingSMS`, {
                headers: { "Content-Type": "application/json" },
                method: "POST",
                body: JSON.stringify(data),
            });

            if (res.ok) {
                FLshowLoading();
                window.location.reload();
            }
        } catch (err) {
            console.log(err);
        }
    }


    // attach Receipt
    function submitPaymentReceipt() {
        if (paymentReceiptList.every(item => item.isDeleted)) {
            toastifyError("سند واریزی اجباریست");
            return;
        }

        const model = {
            List: paymentReceiptList,
            pFactorId: '@pfId',
            type: 5,
        };

        FLshowLoading();
        $.post("/Factor/UploadAttachmentInvoice", model, (res) => {
            toastifySuccess("ثبت با موفقیت انجام شد");
            paymentReceiptList = [];
            document.getElementById("paymentReceipt").value = "";
            ShowPaymentReceiptAttach(model.pFactorId);

            FLshowLoading(false);
        }).fail(() => {
            setTimeout(() => submitPaymentReceipt(), 3000);
        });

    }

    const ShowPaymentReceiptAttach = (id) => {
        $.get(`/Factor/GetAttachmentsInvoiceUploaded/${id}`, (res) => {
            paymentReceiptList = res;
            FileUpReload("paymentReceipt");
        });
    };

    let targetAfterLogin;
    const otpCustomerLoginMsgElm = document.getElementById("otpCustomerLoginMsg");
    function showLoginCustomerModal(target = "panel") {
        targetAfterLogin = target;
        if (verified === 1) {
            if (targetAfterLogin === "panel") {
                goTo("/Account/Home", true);
            } else if (targetAfterLogin === "chat") {
                goTo(`/Chat/Main`, true);
            }
            return;
        }


        FLshowLoading();
        fetch(`/Account/RequestOtp?type=Login`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ mobile: userMobile }),
        }).then(res => res.json())
          .then(data => {
              if (data.status === 200) {
                  otpCustomerLoginMsgElm.innerText = "";
                  document.getElementById("phoneNumberOtpCustomerLogin").textContent = userMobile;
                  document.getElementById("verifyOtpCustomerBtnWrapper").style.display = "flex";
                  document.getElementById("otpCustomerLoginInp").value = "";
                  document.getElementById("otpCustomerLoginInp").focus();

                  toastifySuccess(data.message);
                  startOtpCustomerTimer();
              } else {
                  otpCustomerLoginMsgElm.innerText = data.message;
                  document.getElementById("verifyOtpCustomerBtnWrapper").style.display = "none";
              }
              FLshowLoading(false);
          });

        $("#loginCustomerModal").modal("show");
    }


    document.getElementById("verifyOtpCustomerBtn").addEventListener("click", () => verifyCustomerOtp());
    document.getElementById("otpCustomerLoginInp").addEventListener("keyup", (e) => {
        if (e.target.value.length >= 4 || e.key === "Enter") {
            verifyCustomerOtp();
        }
    });

    const showLoginCustomerModalBtn = document.getElementById("showLoginCustomerModalBtn");
    const paymentReceiptContainer = document.getElementById("paymentReceiptContainer");
    function verifyCustomerOtp() {
        const OtpCode = document.querySelector("#loginCustomerContainer input[name='otp']").value;

        fetch(`/Account/VerifyOtpGeneric`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ mobile: userMobile, OtpCode }),
        }).then(res => res.json())
          .then(data => {
              if (data.status === 300) {
                  showAccountCustomerModal(data.accounts);
              } else if (data.status === 200) {
                  otpCustomerLoginMsgElm.innerText = "";
                  toastifySuccess("احراز موفقیت با موفقیت انجام شد");
                  $("#loginCustomerModal").modal("hide");
                  verified = 1;

                  if (targetAfterLogin === "panel") {
                      goTo(data.url, true);
                  } else if (targetAfterLogin === "chat") {
                      goTo(`/Chat/Main`, true);
                  }

                  if (showLoginCustomerModalBtn && paymentReceiptContainer) {
                      showLoginCustomerModalBtn.style.display = "none";
                      paymentReceiptContainer.style.display = "flex";
                  }
              } else {
                  if (showLoginCustomerModalBtn && paymentReceiptContainer) {
                      showLoginCustomerModalBtn.style.display = "";
                      paymentReceiptContainer.style.display = "none";
                  }
                  otpCustomerLoginMsgElm.innerText = data.message;
              }
          });
    }

    let otpIntervalId;
    function startOtpCustomerTimer() {
        otpIntervalId = setInterval(() => {
            fetch(`/Account/CheckTimerCode?type=Login`)
                .then(response => response.json())
                .then(data => {
                    if (data.status) {
                        document.getElementById("remainingSecondsOtpCustomerLogin").innerText = data.elsapsTime + " ثانیه";
                        document.getElementById("resendOtpCustomerBtn").style.display = "none";
                        document.getElementById("verifyOtpCustomerBtnWrapper").style.display = "flex";
                        document.getElementById("otpCustomerLoginInp").focus();
                    } else {
                        clearInterval(otpIntervalId);
                        document.getElementById("resendOtpCustomerBtn").style.display = "flex";
                        document.getElementById("verifyOtpCustomerBtnWrapper").style.display = "none";
                    }
                })
                .catch(error => {
                    console.log("Error", error);
                });
        }, 1000);
    }


    document.getElementById("resendOtpCustomerBtn").addEventListener("click", () => {
        fetch(`/Account/RequestOtp?type=Login`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ mobile: userMobile, userId: selectedCustomerUserId }),
        })
            .then(res => res.json())
            .then(data => {
                if (data.status === 200) {
                    otpCustomerLoginMsgElm.innerText = "";
                    document.getElementById("otpCustomerLoginInp").value = "";
                    toastifySuccess("کد یکبار مصرف مجددا ارسال شد");
                    startOtpCustomerTimer();
                } else {
                    otpCustomerLoginMsgElm.innerText = data.message;
                }
            });
    });

    function showAccountCustomerModal(accounts) {
        const listContainer = document.getElementById("accountCustomerList");
        listContainer.innerHTML = "";

        accounts.forEach(acc => {
            const btn = document.createElement("button");
            btn.type = "button";
            btn.className = "list-group-item list-group-item-action";
            btn.innerHTML = `
                <span class="fbold" style="font-size: 14px">${acc.userName}</span>
                <br>
                <span style="font-size: 11px">${acc.fullName || ""}</span>
            `;

            btn.addEventListener("click", () => {
                FLshowLoading();
                fetch(`/Account/SelectAccount?userId=${acc.id}&type=Login`)
                    .then(res => res.json())
                    .then(data => {
                        if (data.status === 200) {
                            selectedCustomerUserId = acc.id;

                            document.getElementById("selectAccountCustomerContainer").style.display = "none";
                            document.getElementById("loginOtpCustomerContainer").style.display = "flex";

                            otpCustomerLoginMsgElm.innerText = "";
                            toastifySuccess("احراز موفقیت با موفقیت انجام شد");
                            $("#loginCustomerModal").modal("hide");
                            verified = 1;

                            if (targetAfterLogin === "panel") {
                                goTo(data.url, true);
                            }
                            if (showLoginCustomerModalBtn && paymentReceiptContainer) {
                                showLoginCustomerModalBtn.style.display = "none";
                                paymentReceiptContainer.style.display = "flex";
                            }
                            FLshowLoading(false);

                        } else {
                            toastifyError(data.message);
                        }
                    });
            });

            listContainer.appendChild(btn);
        });

        document.getElementById("selectAccountCustomerContainer").style.display = "block";
        document.getElementById("loginOtpCustomerContainer").style.display = "none";
    }


    // signature
    function initSignature() {
        const canvas = document.getElementById("signatureCanvas");
        if (!canvas) return null;

        signaturePad = new SignaturePad(canvas, {
            minWidth: 1,
            maxWidth: 1,
            penColor: "darkblue",
        });


        function resizeCanvas() {
            const ratio = Math.max(window.devicePixelRatio || 1, 1);
            canvas.width = canvas.offsetWidth * ratio;
            canvas.height = canvas.offsetHeight * ratio;
            canvas.getContext("2d").scale(ratio, ratio);
            signaturePad.clear();
        }
        resizeCanvas();

        canvas.addEventListener("pointerdown", () => {
            if (document.activeElement && document.activeElement.tagName === "INPUT") {
                document.activeElement.blur();
            }
        });


        document.getElementById("clearBtn").addEventListener("click", () => signaturePad.clear());
    }


</script>


</body>
</html>
