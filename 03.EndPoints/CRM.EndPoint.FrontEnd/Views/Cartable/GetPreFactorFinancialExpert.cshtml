@using CRM.Core.Domain.PreFactors.Enum
@model List<CRM.EndPoint.FrontEnd.Models.PreFactors.PreFactorFinancialExpertVModel>
@{ Layout = null; }
<div class="pf-accepted-list">
@foreach (var vm in Model) {
    var preFactor = vm.PreFactor;
    var notAcceptedFiAccCount = vm.NotAcceptedFiAccCount;
    var notAcceptedMdAccCount = vm.NotAcceptedMdAccCount;
    var notAcceptedAccCount = notAcceptedMdAccCount + notAcceptedFiAccCount;
    var totalAccCount = vm.TotalAccCount;
    <article class="pf-accepted-card @(preFactor.Pftype == (int)PreFactorEnum.فاقد_اعتبار ? "pf-accepted-card--invalid" : "")">
        <partial name="~/Views/PreFactor/_PreFactorSideLabels.cshtml" model="preFactor" />
        <div class="InfoDataItem_Prefactor pf-accepted-card__content pf-finance-card">
            <div class="pf-accepted-card__facts" aria-label="مشخصات پیش‌فاکتور">
                <div class="pf-accepted-card__fact"><span>سریال پیش‌فاکتور</span><strong>@preFactor.SerialNumber</strong></div>
                <div class="pf-accepted-card__fact"><span>تاریخ</span><strong>@preFactor.Date</strong></div>
                <div class="pf-accepted-card__fact"><span>تاریخ تأیید</span><strong>@(string.IsNullOrEmpty(preFactor.AcceptedDateTxt) ? "-" : preFactor.AcceptedDateTxt.Substring(0, 10))</strong></div>
            </div>
            <div class="pf-accepted-card__body">
                <section class="pf-accepted-card__section pf-accepted-card__customer">
                    <h3><span>اطلاعات مشتری</span><i class="fa fa-user" aria-hidden="true"></i></h3>
                    <div class="pf-accepted-card__row"><span>کد مشتری</span><strong>@(preFactor.CustomerEntity?.CustomerCode.ToString() ?? preFactor.CustomerCode?.ToString() ?? "-")</strong></div>
                    <div class="pf-accepted-card__row"><span>مشتری</span><strong>@preFactor.Customer @(string.IsNullOrWhiteSpace(preFactor.Customer) || string.IsNullOrWhiteSpace(preFactor.AgentName) ? "" : " | ")@preFactor.AgentName</strong></div>
                    <div class="pf-accepted-card__row"><span>کارشناس فروش</span><strong>@preFactor.UserCreator</strong></div>
                    <div class="pf-accepted-card__row"><span>کارشناس تأمین</span><strong>@(string.IsNullOrWhiteSpace(preFactor.UserTaminTxt) ? "-" : preFactor.UserTaminTxt)</strong></div>
                </section>
                <section class="pf-accepted-card__section pf-accepted-card__financial">
                    <h3><span>بررسی مالی</span><i class="fa fa-coins" aria-hidden="true"></i></h3>
                    <div class="pf-accepted-card__row"><span>مبلغ</span><strong><bdi dir="ltr">@($"{preFactor.PaymentAmount:n0}")</bdi> <small>@(preFactor.CurrencyTypeTxt ?? "ريال")</small></strong></div>
                    <div class="pf-accepted-card__row"><span>پیش‌پرداخت</span><strong><bdi dir="ltr">@($"{vm.ReceiveAmount:n0}")</bdi> <small>@(preFactor.CurrencyTypeTxt ?? "ريال")</small></strong></div>
                    <div class="pf-accepted-card__row"><span>وضعیت</span><strong>@preFactor.PftypeTxt</strong></div>
                    <div class="pf-finance-card__controls">
                        @if (totalAccCount > 0) {
                            <button type="button" class="pf-finance-card__invoice" onclick="ShowModalListInvoice('@preFactor.Id', 1,'@preFactor.SerialNumber', 5, false)">
                                صورت‌حساب
                                @if (notAcceptedFiAccCount > 0) { <span title="در انتظار تأیید مالی" aria-label="در انتظار تأیید مالی">@notAcceptedFiAccCount</span> }
                                @if (notAcceptedMdAccCount > 0) { <span class="pf-finance-card__md-count" title="در انتظار تأیید مدیرعامل" aria-label="در انتظار تأیید مدیرعامل">@notAcceptedMdAccCount</span> }
                            </button>
                        }
                                @if (preFactor.Pftype == (int)PreFactorEnum.در_انتظار_تایید_مالی && totalAccCount > 0 && notAcceptedAccCount == 0 && preFactor.AcceptedFinancial != true) {
                                    <button type="button" class="pf-finance-card__button" onclick="acceptFinancial('@preFactor.Id')">
                                        تایید
                                    </button>
                                }

                                @if (preFactor.AcceptedFinancial == null && preFactor.Pftype == (int)PreFactorEnum.در_انتظار_تایید_مالی) {
                                    <button type="button" class="pf-finance-card__button" onclick="showModalNotAccept('@preFactor.Id', 12)">
                                        عدم تایید
                                    </button>
                                } else if (preFactor.AcceptedFinancial == true && preFactor.Pftype != (int)PreFactorEnum.جنس_به_مشتری_تحویل_داده_شد) {
                                    <button type="button" class="pf-finance-card__button" onclick="rejectPreFactor('@preFactor.Id', 12)">
                                        رد تایید
                                    </button>
                                    <button type="button" class="pf-finance-card__button" onclick="showModalNotAccept('@preFactor.Id', 12)">
                                        رد تایید و بازگشت
                                    </button>
                                }

                    </div>
                </section>
            </div>
            <div class="pf-accepted-card__actions"><div class="pf-accepted-card__action-list">
                    <button type="button" class="mp" style="color:var(--DarkColor); border:none;background-color:transparent" aria-label="نمایش پیش فاکتور" data-title-right="نمایش پیش فاکتور" onclick="ShowPreviewPfactor('@preFactor.Id')"><span class="pf-accepted-card__action-icon" aria-hidden="true">
                        <i class="mp fa fa-eye"></i>
                    </span></button>
                    @if (preFactor.CustomerId != null) {
                        <button type="button" class="mp" style="color:var(--DarkColor); border:none;background-color:transparent" aria-label="پروفایل" data-title-right="پروفایل" onclick="openCustomerProfile('@preFactor.CustomerId', '@preFactor.SerialNumber')"><span class="pf-accepted-card__action-icon" aria-hidden="true">
                            <i class="mp fa fa-user"></i>
                        </span></button>
                    }
                    <button type="button" class="mp" style="color:var(--DarkColor); border:none;background-color:transparent" aria-label="پیوست ها" data-title-right="پیوست ها" onclick="AttachDoc('@preFactor.Id')"><span class="pf-accepted-card__action-icon" aria-hidden="true">
                        <i class="mp fa fa-paperclip"></i>
                    </span></button>
            </div></div>
            @if (!string.IsNullOrEmpty(preFactor.CommentText)) {
                <div class="pf-accepted-card__description"><span>توضیحات: </span><span style="white-space:pre-line">@Html.Raw(preFactor.CommentText)</span></div>
            }
        </div>
    </article>
}
</div>
