@using System.Globalization
@using CRM.Core.Domain.Taxation
@using CRM.EndPoint.FrontEnd.Models.Taxation
@using CRM.Framework
@model TaxationReportModel
@{
    ViewData["Title"] = "داشبورد سامانه مؤدیان";
    var filters = Model.Filter;
    var report = Model.Report;
    var counts = report.Statuses.ToDictionary(x => x.Status, x => x.Count);
    var values = new Dictionary<string, string>
    {
        ["from"] = IsoDate(filters.From), ["through"] = IsoDate(filters.Through), ["customer"] = filters.Customer,
        ["kind"] = filters.Kind?.ToString(), ["memoryId"] = filters.MemoryId?.ToString(),
        ["status"] = filters.Status?.ToString(), ["scope"] = filters.Scope.ToString()
    };
}
@section Styles {
    <link rel="stylesheet" href="~/css/taxation.css" asp-append-version="true" />
}
<section class="taxation-page" dir="rtl">
    <header class="taxation-heading">
        <h1>داشبورد سامانه مؤدیان</h1>
        <a asp-action="Index">بازگشت به فهرست</a>
    </header>
    <form class="taxation-filters" method="get" asp-action="Reports">
        <label>از تاریخ فاکتور (میلادی) <input name="from" type="date" class="form-control form-control-sm" value="@IsoDate(filters.From)" /></label>
        <label>تا تاریخ فاکتور (میلادی) <input name="through" type="date" class="form-control form-control-sm" value="@IsoDate(filters.Through)" /></label>
        <label>نام مشتری <input name="customer" type="search" class="form-control form-control-sm" value="@filters.Customer" maxlength="100" /></label>
        <label>نوع سند
            <select name="kind" class="form-select form-select-sm">
                <option value="">همه</option>
                @foreach (var kind in Enum.GetValues<TaxDispatchKind>())
                {
                    <option value="@kind" selected="@(filters.Kind == kind)">@TaxReportLabels.Kind(kind)</option>
                }
            </select>
        </label>
        <label>حافظه
            <select name="memoryId" class="form-select form-select-sm">
                <option value="">همه</option>
                @foreach (var memory in Model.Memories)
                {
                    <option value="@memory.Id" selected="@(filters.MemoryId == memory.Id)">@memory.Title · @memory.FiscalId</option>
                }
            </select>
        </label>
        <label>وضعیت
            <select name="status" class="form-select form-select-sm">
                <option value="">همه</option>
                @foreach (var status in Enum.GetValues<TaxReportStatus>())
                {
                    <option value="@status" selected="@(filters.Status == status)">@TaxReportLabels.Status(status)</option>
                }
            </select>
        </label>
        <label>محیط
            <select name="scope" class="form-select form-select-sm">
                @foreach (var scope in Enum.GetValues<TaxReportScope>())
                {
                    <option value="@scope" selected="@(filters.Scope == scope)">@TaxReportLabels.Scope(scope)</option>
                }
            </select>
        </label>
        <button type="submit" class="btn btn-sm taxation-action">نمایش گزارش</button>
        <a class="btn btn-sm taxation-validate crm-mobile-dense-action" asp-action="ExportReport" asp-all-route-data="values" download>دریافت Excel</a>
    </form>
    <p>محیط @TaxReportLabels.Scope(filters.Scope) · @report.Total.ToString("N0") سند</p>
    <div class="taxation-report-cards">
        @foreach (var status in Enum.GetValues<TaxReportStatus>())
        {
            var count = counts.GetValueOrDefault(status);
            <div class="taxation-report-card" data-report-status="@status">
                <span>@TaxReportLabels.Status(status)</span>
                <strong>@count.ToString("N0")</strong>
                <meter min="0" max="@Math.Max(1, report.Total)" value="@count" aria-label="@TaxReportLabels.Status(status)"></meter>
            </div>
        }
        <div class="taxation-report-card"><span>ارسال‌شده با رسید</span><strong>@report.Acknowledged.ToString("N0")</strong></div>
        <div class="taxation-report-card"><span>اسناد ارجاعی</span><strong>@report.References.ToString("N0")</strong></div>
        <div class="taxation-report-card"><span>درخواست‌های پرداخت</span><strong>@report.Payments.ToString("N0")</strong></div>
    </div>
    @if (report.Rows.Count == 0)
    {
        <p class="taxation-empty">سندی با این فیلترها پیدا نشد.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table taxation-table align-middle">
                <caption class="visually-hidden">گزارش صورتحساب‌های مالیاتی</caption>
                <thead>
                    <tr>
                        <th scope="col">فاکتور ERP</th><th scope="col">مشتری</th><th scope="col">تاریخ فاکتور</th>
                        <th scope="col">مبلغ فاکتور ERP</th><th scope="col">سند</th><th scope="col">حافظه</th>
                        <th scope="col">شناسه مالیاتی</th><th scope="col">وضعیت</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in report.Rows)
                    {
                        <tr>
                            <th scope="row">@row.Number</th>
                            <td>@(row.Customer ?? "ثبت نشده")</td>
                            <td class="text-nowrap">@(row.Date.HasValue ? BaseServices.GetDatePersian(row.Date) : "ثبت نشده")</td>
                            <td class="text-nowrap">@row.Amount.ToString("#,0.########") @row.Currency</td>
                            <td>
                                @if (row.DispatchId.HasValue)
                                {
                                    <a asp-action="Dispatch" asp-route-id="@row.DispatchId">@TaxReportLabels.Kind(row.Kind)</a>
                                }
                                else
                                {
                                    <a asp-action="Preview" asp-route-id="@row.FactorId">پیش‌نمایش</a>
                                }
                            </td>
                            <td><bdi dir="ltr">@(row.FiscalId ?? "ثبت نشده")</bdi></td>
                            <td><bdi dir="ltr">@(row.TaxId ?? "ثبت نشده")</bdi></td>
                            <td>@TaxReportLabels.Status(row.Status)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (report.PageCount > 1)
        {
            <nav class="taxation-pagination" aria-label="صفحه‌بندی گزارش">
                @if (report.Page > 1)
                {
                    <a asp-action="Reports" asp-all-route-data="values" asp-route-page="@(report.Page - 1)" rel="prev">قبلی</a>
                }
                <span aria-current="page">صفحه @report.Page از @report.PageCount</span>
                @if (report.Page < report.PageCount)
                {
                    <a asp-action="Reports" asp-all-route-data="values" asp-route-page="@(report.Page + 1)" rel="next">بعدی</a>
                }
            </nav>
        }
    }
</section>
@functions {
    private static string IsoDate(DateTime? value) => value?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
}
