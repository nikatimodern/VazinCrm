<!-- Modal reqAmountAttach -->
<div class="modal fade invoice-modal payment-mode" id="reqAmountAttachModal" tabindex="-1" role="dialog" data-bs-focus="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content col-12" style="padding:10px!important">
            <div class="modalHeader-invoice">ثبت پرداختی</div>
            <div class="modal-body pb-0" style="padding-inline: 10px">
                <div class="modalContent-invoice">
                    <div class="d-flex flex-column w-100 gap-4 mt-2">
                        <form id="reqAmountAttachForm">
                            <div class="sectionBox-invoice">
                                <span class="sectionTitle-invoice">اطلاعات تراکنش بانکی</span>

                                <div class="flex-center align-items-start flex-wrap row-gap-2 w-100">
                                    <div class="col-12 col-sm-6 col-lg-4 pe-sm-2">
                                        <label>مبلغ (ریال)</label>
                                        <div class="position-relative">
                                            <span id="paymentAmountGroupEditIcon" class="position-absolute flex-center top-0 bottom-0 px-2 text-dark cursor-pointer d-none" onclick="showEditAmountPaymentItemModal()">
                                                <i class="fa fa-pencil" style="font-size: 12px"></i>
                                            </span>
                                            <input inputmode="numeric" class="currencyNumber form-control inpAmount" name="amount" type="text" placeholder="مبلغ پرداختی به ریال" required data-currency-hint="#reqAmountCurrencyHint" />
                                        </div>
                                        <span class="currencyHint" id="reqAmountCurrencyHint"></span>
                                    </div>

                                    <div class="col-12 col-sm-6 col-lg-4">
                                        <label>تاریخ پرداخت</label>
                                        <input class="sdate form-control" name="paymentDateTxt" type="text" placeholder="تاریخ پرداخت" data-mask-date required />
                                    </div>
                                </div>

                                <div class="mt-2 w-100">
                                    <div>
                                        <label for="reqAttachFromAccountId">حساب مبدا</label>
                                        <select id="reqAttachFromAccountId" class="form-select" name="fromAccountId" type="text" required></select>
                                        @* <input class="form-control" name="fromAccount" type="text" placeholder="از کدام حساب پرداخت شده است." required /> *@
                                    </div>
                                    <div class="mt-3">
                                        <div class="d-flex gap-2 justify-content-between">
                                            <label for="reqAttachToAccountId">حساب مقصد</label>
                                            <button class="addBankBtn-invoice" type="button" onclick="toggleAddBankAccountModal()">
                                                افزودن شماره‌حساب جدید
                                            </button>
                                        </div>
                                        <select id="reqAttachToAccountId" class="show-dropdown-arrow w-100" name="toAccountId" type="text" required></select>
                                    </div>
                                </div>
                            </div>
                        </form>

                        <div class="sectionBox-invoice mt-4">
                            <span class="sectionTitle-invoice">رسید پرداخت</span>
                            <div class="container-uploader">
                                <input type="file" class="uploadBtn" data-varList="reqAmountAttachment" data-showList="imageDisplayReqAmountAt" id="reqAmountAttach" multiple accept="*" />

                                <label for="reqAmountAttach">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" /></svg>
                                    <span>تصویر رسید را انتخاب کنید یا اینجا رها کنید</span>
                                </label>
                                <div class="image-display" id="imageDisplayReqAmountAt"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="px-0 py-3 w-100">
                <div style="width:100%; height:2px; background-color:var(--DarkColor)"></div>
            </div>

            <div class="gap-1 modal-footer p-0 border-0 justify-content-center">
                <button class="buttonCancel2 m-0" onclick="cancelReqAmountAttach()">انصراف</button>
                <button class="buttonGreen3 m-0" onclick="submitReqAmountAttach()">ثبت</button>
            </div>
        </div>
    </div>
</div>

<partial name="~/Views/Accountancy/Modals/_AddBankAccountModal.cshtml" />