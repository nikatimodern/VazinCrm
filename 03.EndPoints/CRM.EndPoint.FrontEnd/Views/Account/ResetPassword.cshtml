@model CRM.EndPoint.FrontEnd.Models.Login.ResetPasswordModel

@{
    ViewData["Title"] = "بازنشانی رمز عبور";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<div style="display:flex;flex-direction:column; justify-content:start;align-items:center; width:80%;">
    <p class="fbold mb-3" style="font-size:20px;color:#5811b4;">بازنشانی رمز عبور</p>
    <div class="w-100">
        <form id="resetPasswordForm" autofocus>
            @Html.AntiForgeryToken()
            <div class="form-group mb-2 p-0">
                <span class="form-group__icon" style="cursor: pointer" onclick="togglePassword('NewInp')">
                    <svg id="eyeClosedNewPassword" style="width: 26px;height: 26px;color: #787c83" fill="none" viewBox="0 0 24 24" stroke-width="1.25" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
                    <svg id="eyeOpenNewPassword" style="width: 26px;height: 26px;color: #787c83;display: none" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88" /></svg>
                </span>
                <input name="newPassword" type="password" id="NewPasswordInp" placeholder="رمز عبور جدید" autofocus class="form-group__input form-group__input--ltr" />
            </div>

            <div class="form-group mb-2 p-0">
                <span class="form-group__icon" style="cursor: pointer" onclick="togglePassword('ConfirmInp')">
                    <svg id="eyeClosedConfirmPassword" style="width: 26px;height: 26px;color: #787c83" fill="none" viewBox="0 0 24 24" stroke-width="1.25" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
                    <svg id="eyeOpenConfirmPassword" style="width: 26px;height: 26px;color: #787c83;display: none" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88" /></svg>
                </span>
                <input name="confirmPassword" type="password" id="ConfirmPasswordInp" placeholder="تکرار رمز عبور" class="form-group__input form-group__input--ltr" />
            </div>

            <button type="submit" class="col-12 buttonGreen2 login-btn d-flex justify-content-center align-items-center" style="font-size: 16px;height: 38px">تایید و بازنشانی رمز</button>
            <p class="errorLoginText " id="resetPassErrMsg"></p>
        </form>
    </div>
</div>
<script>
    function togglePassword(from) {
        const passwordInput = document.getElementById(from === "ConfirmInp" ? "ConfirmPasswordInp" : "NewPasswordInp");
        const eyeOpen = document.getElementById(from === "ConfirmInp" ? "eyeOpenConfirmPassword" : "eyeOpenNewPassword");
        const eyeClosed = document.getElementById(from === "ConfirmInp" ? "eyeClosedConfirmPassword" : "eyeClosedNewPassword");

        if (passwordInput.type === "password") {
            passwordInput.type = "text";
            eyeOpen.style.display = "block";
            eyeClosed.style.display = "none";
        } else {
            passwordInput.type = "password";
            eyeOpen.style.display = "none";
            eyeClosed.style.display = "block";
        }
    }

    const errorBox = document.getElementById("resetPassErrMsg");
    document.getElementById("resetPasswordForm").addEventListener("submit", async (e) => {
        e.preventDefault();

        const newPassword = document.querySelector("input[name='newPassword']").value;
        const confirmPassword = document.querySelector("input[name='confirmPassword']").value;

        if (newPassword !== confirmPassword) {
            errorBox.innerText = "رمز عبور و تکرار آن یکسان نیست";
            return;
        }
        if (newPassword.length < 3) {
            errorBox.innerText = "رمز عبور باید حداقل 3 کاراکتر باشد";
            return;
        }

        try {
            FLshowLoading();
            const res = await fetch("/Account/ResetPassword", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": document.querySelector("input[name='__RequestVerificationToken']")?.value || "",
                },
                body: JSON.stringify({ newPassword, confirmPassword }),
            });
            const data = await res.json();

            errorBox.innerHTML = "";
            if (data.status === 200) {
                toastifySuccess(data.message);
                setTimeout(() => {
                    FLshowLoading(false);
                    goTo(data.url);
                }, 2000);
            } else if (data.status === 405) {
                data.errors.forEach(err => {
                    const pElm = document.createElement("p");
                    pElm.innerText = err;
                    errorBox.appendChild(pElm);
                });
                FLshowLoading(false);
            } else if (data.status === 404) {
                toastifyError(data.message);
                setTimeout(() => {
                    FLshowLoading(false);
                    goTo(data.url);
                }, 2000);
            } else {
                errorBox.innerText = data.message;
                FLshowLoading(false);
            }
        } catch (err) {
            console.log(err);
        }


    });
</script>