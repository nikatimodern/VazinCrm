@using CRM.Core.Domain.Customers.Enum
@using CRM.EndPoint.FrontEnd.Services
@model IList<CRM.Core.Domain.Customers.Entities.Customer>
@{
    Layout = null;
    bool canManage = ViewBag.AccessAccepte == true;
}

@if (Model.Any()) {
    foreach (var item in Model) {
        var displayName = item.Sex == 1 ? $"آقای {item.AgentName}" : item.Sex == 0 ? $"خانم {item.AgentName}" : item.AgentName;
        <article class="customer-person-card @(item.Juridical == 1 ? "customer-person-card--legal" : "")">
            <header class="customer-person-card__header">
                <span class="customer-person-card__avatar" aria-hidden="true"><i class="fa fa-user"></i></span>
                <div class="customer-person-card__identity">
                    <h2 class="customer-person-card__name" tabindex="0" title="@displayName">@displayName</h2>
                    <div class="customer-person-card__badges">
                        @if (item.RoleType == RoleTypeEnum.تامین_کننده_مشتری) {
                            <span>مشتری</span><span>تأمین‌کننده</span>
                        } else {
                            <span>@item.RoleTypeTxt</span>
                        }
                        <span class="customer-person-card__kind">@(item.Juridical == 1 ? "حقوقی" : "حقیقی")</span>
                    </div>
                </div>
            </header>
            <dl class="customer-person-card__details">
                <div><dt>کد @(item.RoleType == RoleTypeEnum.تامین_کننده ? "تأمین‌کننده" : "مشتری")</dt><dd><bdi>@item.CustomerCode</bdi></dd></div>
                @if (item.Juridical == 1) {
                    <div><dt>شرکت</dt><dd class="customer-person-card__company" tabindex="0" title="@item.CompanyName">@item.CompanyName</dd></div>
                }
            </dl>
            @if (canManage) {
                <div class="customer-person-card__owner"><i class="fa fa-user" aria-hidden="true"></i><span>کارشناس فروش:</span><span>@item.SelExpertRel</span></div>
            }
            <footer class="customer-person-card__footer">
                @if (item.Accepted) {
                    if (item.RoleType != RoleTypeEnum.تامین_کننده) {
                        <a href="/Customer/CustomerProfile?Id=@item.Id" class="customer-person-card__profile"><i class="fa fa-eye" aria-hidden="true"></i><span>مشاهده پروفایل</span></a>
                        <div class="customer-person-card__actions">
                            <button type="button" aria-label="ویرایش" title="ویرایش" onclick="ShowModalUpCustomer('@item.Id')"><i class="fa fa-pencil" aria-hidden="true"></i></button>
                            <button type="button" aria-label="ثبت گزارش" title="ثبت گزارش" onclick="ShowModalReport(@item.ToCamelJson())"><i class="fa fa-text" aria-hidden="true"></i></button>
                            @if (canManage) {
                                <a href="/Customer/CustomerDetail?id=@item.Id" target="_blank" rel="noopener" aria-label="مشاهده جزئیات" title="مشاهده جزئیات"><i class="fa fa-search" aria-hidden="true"></i></a>
                            }
                        </div>
                    } else {
                        <div class="customer-person-card__actions"><button type="button" aria-label="ویرایش تأمین‌کننده" title="ویرایش" onclick="ShowModalUpCustomer('@item.Id')"><i class="fa fa-pencil" aria-hidden="true"></i></button></div>
                    }
                } else {
                    <span class="customer-person-card__pending">در انتظار تأیید</span>
                    @if (canManage) {
                        <div class="customer-person-card__actions">
                            <button type="button" aria-label="تأیید" title="تأیید" onclick="acceptCustomer('@item.Id')"><i class="fa fa-check" aria-hidden="true"></i></button>
                            <button type="button" class="customer-person-card__reject" aria-label="عدم تأیید" title="عدم تأیید" onclick="abortCustomer('@item.Id')"><i class="fa fa-times" aria-hidden="true"></i></button>
                            <a href="/Customer/CustomerDetail?id=@item.Id" target="_blank" rel="noopener" aria-label="مشاهده جزئیات" title="مشاهده جزئیات"><i class="fa fa-search" aria-hidden="true"></i></a>
                        </div>
                    }
                }
            </footer>
        </article>
    }
} else {
    <div class="no-customer-found customer-directory__empty" role="status"><i class="fa fa-users" aria-hidden="true"></i><h2>موردی یافت نشد</h2><p>هیچ شخصی با شرایط انتخاب‌شده پیدا نشد.</p></div>
}
