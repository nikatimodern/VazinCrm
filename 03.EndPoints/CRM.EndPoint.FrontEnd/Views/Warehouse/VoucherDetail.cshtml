@using CRM.Core.Domain.Warehouses.Enums
@model CRM.Core.Domain.Warehouses.Entities.WarehouseVoucher

@{
    var statusClass = Model.Status switch {
        WarehouseVoucherStatusEnum.در_انتظار_تایید_تامین => "status-pending",
        WarehouseVoucherStatusEnum.در_انتظار_تحویل => "status-delivering",
        WarehouseVoucherStatusEnum.تحویل_شده => "status-completed",
        _ => "status-default"
    };
}

<div class="warehouse-voucher">

    <!-- Header -->
    <div class="voucher-header">

        <div class="voucher-header-main">

            <div class="voucher-icon">
                <svg style="width: 26px" fill="currentColor" viewBox="0 0 256 256"><path d="M216,40H40A16,16,0,0,0,24,56V208a8,8,0,0,0,11.58,7.15L64,200.94l28.42,14.21a8,8,0,0,0,7.16,0L128,200.94l28.42,14.21a8,8,0,0,0,7.16,0L192,200.94l28.42,14.21A8,8,0,0,0,232,208V56A16,16,0,0,0,216,40ZM176,144H80a8,8,0,0,1,0-16h96a8,8,0,0,1,0,16Zm0-32H80a8,8,0,0,1,0-16h96a8,8,0,0,1,0,16Z"></path></svg>
            </div>

            <div>
                <div class="voucher-eyebrow">
                    حواله انبار
                </div>

                <div class="voucher-code">
                    @Model.VoucherNumber
                </div>

                <div class="voucher-subtitle">
                    سند خروج کالا از انبار
                </div>
            </div>

        </div>

        <div class="voucher-header-actions">
            <div class="voucher-status @statusClass">
                <span class="status-dot"></span>
                <span class="status-text">@Model.StatusTxt</span>
            </div>

            @*@if ((User.IsAdmin() || Model.Warehouse?.IsMain == false) && Model.Status == WarehouseVoucherStatusEnum.در_انتظار_تایید_تامین) {
                <button type="button" class="voucher-action-btn voucher-action-confirm" onclick="confirmWarehouseVoucher('@Model.Id')">
                    <svg viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M12.416 3.376a.75.75 0 0 1 .208 1.04l-5 7.5a.75.75 0 0 1-1.154.114l-3-3a.75.75 0 0 1 1.06-1.06l2.353 2.353 4.493-6.74a.75.75 0 0 1 1.04-.207Z" clip-rule="evenodd" /></svg>
                    تایید حواله
                </button>
            } else if ((User.IsAdmin() || Model.Warehouse?.IsMain == false) && Model.Status == WarehouseVoucherStatusEnum.در_انتظار_تحویل) {
                <button type="button" class="voucher-action-btn voucher-action-deliver" onclick="deliverWarehouseVoucher('@Model.Id')">
                    <i class="fas fa-box-check"></i>
                    تحویل شد
                </button>
            }*@

            @*<button type="button" class="voucher-action-btn voucher-action-print" title="چاپ حواله" onclick="printWarehouseVoucher()">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0 1 10.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0 .229 2.523a1.125 1.125 0 0 1-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0 0 21 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 0 0-1.913-.247M6.34 18H5.25A2.25 2.25 0 0 1 3 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 0 1 1.913-.247m10.5 0a48.536 48.536 0 0 0-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.659M18 10.5h.008v.008H18V10.5Zm-3 0h.008v.008H15V10.5Z" /></svg>
            </button>*@

        </div>

    </div>


    <!-- Information -->
    <div class="voucher-info">

        <div class="voucher-info-item">
            <span class="info-label">شماره حواله</span>
            <strong class="info-value">@Model.VoucherNumber</strong>
        </div>

        <div class="voucher-info-item">
            <span class="info-label">ثبت‌کننده</span>
            <strong class="info-value">@Model.UserCreator</strong>
        </div>

        <div class="voucher-info-item">
            <span class="info-label">تاریخ ثبت</span>
            <strong class="info-value">
                @(string.Join(" | ", Model.CreateDateTxt?.Substring(0, 16).Split(' ')))
            </strong>
        </div>

        <div class="voucher-info-item">
            <span class="info-label">تعداد اقلام</span>
            <strong class="info-value">
                @Model.WarehouseProductVouchers?.Count قلم کالا
            </strong>
        </div>

    </div>


    <!-- Status Timeline -->
    <div class="voucher-section">

        <div class="section-heading">

            <div>
                <span class="section-kicker">وضعیت فرآیند</span>
                <h3>روند تحویل حواله</h3>
            </div>

        </div>

        @{
            var currentStep = Model.Status switch {
                WarehouseVoucherStatusEnum.در_انتظار_تایید_تامین => 1,
                WarehouseVoucherStatusEnum.در_انتظار_تحویل => 2,
                WarehouseVoucherStatusEnum.تحویل_شده => 3,
                _ => 1
            };
        }

        <div class="voucher-timeline">

            @* مرحله اول *@
            <div class="timeline-item @(currentStep > 1 ? "completed" : currentStep == 1 ? "active" : "")">

                <div class="timeline-marker">
                    <svg fill="currentColor" viewBox="0 0 640 640"><path d="M64.1 128C64.1 92.7 92.8 64 128.1 64L277.6 64C294.6 64 310.9 70.7 322.9 82.7L429.3 189.3C441.3 201.3 448 217.6 448 234.6L448 332.1L316 464.1L273.9 464.1L257.8 410.5C253.1 394.8 238.7 384.1 222.3 384.1C211 384.1 200.4 389.2 193.4 398L133.3 473C125 483.3 126.7 498.5 137 506.7C147.3 514.9 162.5 513.3 170.7 502.9L217.8 444.1L233 494.8C236 505 245.4 511.9 256 511.9L287.5 511.9C286.6 515 285.8 518.2 285.2 521.4L274.3 575.9L128.1 575.9C92.8 575.9 64.1 547.2 64.1 511.9L64.1 127.9zM272.1 122.5L272.1 216C272.1 229.3 282.8 240 296.1 240L389.6 240L272.1 122.5zM332.3 530.9C334.8 518.5 340.9 507.1 349.8 498.2L468.7 379.3L548.7 459.3L429.8 578.2C420.9 587.1 409.5 593.2 397.1 595.7L337.5 607.6C336.6 607.8 335.6 607.9 334.6 607.9C326.6 607.9 320 601.4 320 593.3C320 592.3 320.1 591.4 320.3 590.4L332.2 530.8zM600.1 407.9L571.3 436.7L491.3 356.7L520.1 327.9C542.2 305.8 578 305.8 600.1 327.9C622.2 350 622.2 385.8 600.1 407.9z" /></svg>
                </div>

                <div class="timeline-content">
                    <strong>در انتظار تایید تامین</strong>
                    <span>حواله ثبت شده و منتظر تایید تامین است.</span>
                </div>

            </div>


            <div class="timeline-line @(currentStep > 1 ? "completed" : "")"></div>


            @* مرحله دوم *@
            <div class="timeline-item @(currentStep > 2 ? "completed" : currentStep == 2 ? "active" : "")">

                <div class="timeline-marker">
                    <svg fill="currentColor" viewBox="0 0 640 512"><path d="M624 352h-16V243.9c0-12.7-5.1-24.9-14.1-33.9L494 110.1c-9-9-21.2-14.1-33.9-14.1H416V48c0-26.5-21.5-48-48-48H48C21.5 0 0 21.5 0 48v320c0 26.5 21.5 48 48 48h16c0 53 43 96 96 96s96-43 96-96h128c0 53 43 96 96 96s96-43 96-96h48c8.8 0 16-7.2 16-16v-32c0-8.8-7.2-16-16-16zM160 464c-26.5 0-48-21.5-48-48s21.5-48 48-48 48 21.5 48 48-21.5 48-48 48zm320 0c-26.5 0-48-21.5-48-48s21.5-48 48-48 48 21.5 48 48-21.5 48-48 48zm80-208H416V144h44.1l99.9 99.9V256z" /></svg>
                </div>

                <div class="timeline-content">
                    <strong>در دست تحویل</strong>
                    <span>اقلام حواله در حال تحویل به مقصد هستند.</span>
                </div>

            </div>


            <div class="timeline-line @(currentStep > 2 ? "completed" : "")"></div>


            @* مرحله سوم *@
            <div class="timeline-item @(currentStep >= 3 ? "completed" : "")">

                <div class="timeline-marker">
                    <i class="fas fa-box-check"></i>
                </div>

                <div class="timeline-content">
                    <strong>تحویل شد</strong>
                    <span>تحویل کامل اقلام حواله.</span>
                </div>

            </div>

        </div>

    </div>


    <!-- Products -->
    <div class="voucher-section voucher-products-section">

        <div class="section-heading section-heading-products">

            <div>
                <span class="section-kicker">اقلام حواله</span>
                <h3>محصولات</h3>
            </div>

            <div class="products-count">
                <span>@Model.WarehouseProductVouchers?.Count</span>
                قلم کالا
            </div>

        </div>


        <div class="voucher-table-wrapper">

            <table class="voucher-products-table">

                <thead>
                <tr>
                    <th class="col-index">#</th>
                    <th>محصول</th>
                    <th>شرح محصول</th>
                    <th class="col-amount">مقدار</th>
                </tr>
                </thead>

                <tbody>

                @for (var i = 0; i < Model.WarehouseProductVouchers?.Count; i++) {
                    var product = Model.WarehouseProductVouchers[i];

                    <tr>

                        <td class="row-index">
                            @(i + 1)
                        </td>

                        <td>
                            <div class="product-name">
                                @product.WarehouseProduct.ProductSmallName
                            </div>
                        </td>

                        <td>
                            <div class="product-description">
                                @product.WarehouseProduct.ProductDescription
                            </div>
                        </td>

                        <td>
                            <span class="amount-cell unit-badge">
                                <span>@product.WarehouseProduct.UnitTxt</span> 
                                <span>@product.Weight</span>
                            </span>
                        </td>

                    </tr>
                }

                </tbody>

            </table>

        </div>

    </div>


    <!-- Summary -->
    <div class="voucher-summary">

        <div class="d-flex align-items-center">
            <div class="summary-icon">
                <svg style="width: 20px" fill="currentColor" viewBox="0 0 640 640"><path d="M288 64L288 128C288 136.8 295.2 144 304 144L336 144C344.8 144 352 136.8 352 128L352 64L384 64C419.3 64 448 92.7 448 128L448 256C448 261.5 447.3 266.9 446 272L194 272C192.7 266.9 192 261.5 192 256L192 128C192 92.7 220.7 64 256 64L288 64zM384 576C372.8 576 362.2 573.1 353 568C362.5 551.5 368 532.4 368 512L368 384C368 363.6 362.5 344.5 353 328C362.2 322.9 372.7 320 384 320L416 320L416 384C416 392.8 423.2 400 432 400L464 400C472.8 400 480 392.8 480 384L480 320L512 320C547.3 320 576 348.7 576 384L576 512C576 547.3 547.3 576 512 576L384 576zM64 384C64 348.7 92.7 320 128 320L160 320L160 384C160 392.8 167.2 400 176 400L208 400C216.8 400 224 392.8 224 384L224 320L256 320C291.3 320 320 348.7 320 384L320 512C320 547.3 291.3 576 256 576L128 576C92.7 576 64 547.3 64 512L64 384z" /></svg>
            </div>

            @*<div class="summary-content">
                <span>مجموع اقلام حواله</span>
                <strong>@Model.WarehouseProductVouchers?.Count قلم کالا</strong>
            </div>
            *@

            <div class="summary-divider"></div>

            <div class="summary-content">
                <span>وضعیت فعلی</span>
                <strong class="summary-status @statusClass">
                    <span class="status-dot"></span>
                    @Model.StatusTxt
                </strong>
            </div>

        </div>

        <div class="d-flex align-items-center">
            @if ((User.IsAdmin() || Model.Warehouse?.IsMain == false) && Model.Status == WarehouseVoucherStatusEnum.در_انتظار_تایید_تامین) {
                <button type="button" class="voucher-action-btn voucher-action-confirm" onclick="confirmWarehouseVoucher('@Model.Id')">
                    <svg viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M12.416 3.376a.75.75 0 0 1 .208 1.04l-5 7.5a.75.75 0 0 1-1.154.114l-3-3a.75.75 0 0 1 1.06-1.06l2.353 2.353 4.493-6.74a.75.75 0 0 1 1.04-.207Z" clip-rule="evenodd" /></svg>
                    تایید حواله
                </button>
            } else if ((User.IsAdmin() || Model.Warehouse?.IsMain == false) && Model.Status == WarehouseVoucherStatusEnum.در_انتظار_تحویل) {
                <button type="button" class="voucher-action-btn voucher-action-deliver" onclick="deliverWarehouseVoucher('@Model.Id')">
                    <i class="fas fa-box-check"></i>
                    تحویل شد
                </button>
            }
        </div>
    </div>

</div>


@section Styles {
    <link rel="stylesheet" href="~/css/warehouse.css?release=6.9.7" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/warehouse/warehouse-voucher.js?release=6.9.7" data-page-bindings="warehouseVoucherState,warehouseVoucherId,warehouseVoucherModal,loadWarehouseVouchers,refreshWarehouseVouchers,warehouseProductListData,showWarehouseVoucherModal,editWarehouseVoucher,cancelWarehouseVoucherModal,createSetVoucherItem,submitWarehouseVoucherModal,confirmWarehouseVoucher,deliverWarehouseVoucher,deleteWarehouseVoucher" asp-append-version="true"></script>
}
