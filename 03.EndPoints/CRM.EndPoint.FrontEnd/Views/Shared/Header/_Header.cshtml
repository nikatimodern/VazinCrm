@using CRM.EndPoint.FrontEnd.Services
@{
    var isAdmin = User.IsInRole(AppRoles.Admin);
    var canSeeCartable =
        isAdmin ||
        User.IsInRole(AppRoles.SalesAdmin) ||
        User.IsInRole(AppRoles.TaminExpert) ||
        User.IsInRole(AppRoles.TaminAdmin) ||
        User.IsInRole(AppRoles.FinancialExpert) ||
        User.IsInRole(AppRoles.FinancialAdmin);

    var canSeeAmount =
        isAdmin ||
        User.IsInRole(AppRoles.SalesExpert) ||
        User.IsInRole(AppRoles.TaminExpert) ||
        User.IsInRole(AppRoles.SalesAdmin) ||
        User.IsInRole(AppRoles.TaminAdmin);

    var canSeeReport =
        isAdmin ||
        User.IsInRole(AppRoles.SalesExpert) ||
        User.IsInRole(AppRoles.TaminExpert);
}

<header id="mainHeader">
    <div class="header-container">
        <button id="expandMenuIcon" onclick="toggleMenu()">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
        </button>
        <div class="header-profile" onclick="ShowModalUserSetting()">
            <img id="profileImage" class="profile-image" src="~/Img/User.png" alt="">
            <span id="profileName" class="profile-name"></span>
        </div>
        <div class="header-content">
            <div class="header-actions d-none">
                <button class="header-action-btn" onclick="window.location.reload()">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M19.933 13.041a8 8 0 1 1 -9.925 -8.788c3.899 -1 7.935 1.007 9.425 4.747" /><path d="M20 4v5h-5" /></svg>
                </button>
                <button class="header-action-btn back-btn" onclick="goBack()">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M5 12l14 0" /><path d="M5 12l6 6" /><path d="M5 12l6 -6" /></svg>
                </button>
            </div>
            <div class="header-datetime">
                <p>امروز :</p>
                <p id="dateTimeNowId"></p>
            </div>

            @if (canSeeCartable) {
                <span data-title-bottom="کارتابل" class="header-icon-btn" onclick="GoToCarEnvelope()">
                    <span id="CountEnvelopeId" class="badge-count badge-top-right d-none"></span>
                    <svg style="width:24px" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 3.75H6.912a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H15M2.25 13.5h3.86a2.25 2.25 0 0 1 2.012 1.244l.256.512a2.25 2.25 0 0 0 2.013 1.244h3.218a2.25 2.25 0 0 0 2.013-1.244l.256-.512a2.25 2.25 0 0 1 2.013-1.244h3.859M12 3v8.25m0 0-3-3m3 3 3-3" /></svg>
                </span>
            }

            <div class="header-icon-btn">
                <span id="notificationIconBadge" class="notification-icon-badge d-none"></span>
                <div id="notification-icon" data-title-bottom="اعلانات">
                    <svg style="height:24px" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" /></svg>
                </div>
                <div id="notification-dropdown"></div>
            </div>

            @if (canSeeAmount) {
                <span class="header-icon-btn" data-title-bottom="قیمت ها" style="z-index:1070" onclick="showModalAmount()">
                    <svg style="height:24px" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
                </span>
            }

            @if (canSeeReport) {
                <div class="header-icon-btn" data-title-bottom="ثبت گزارش" onclick="ShowModalReport()">
                    <svg style="width:22px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 7 4 4 20 4 20 7"></polyline><line x1="9" y1="20" x2="15" y2="20"></line><line x1="12" y1="4" x2="12" y2="20"></line></svg>
                </div>
            }

            <a class="header-icon-btn me-2" data-title-bottom="پیام ها" href="/Email/Index">
                <span id="CountEmailId" class="badge-count badge-count-blue badge-top fbold d-none" style="--badge-top: -6px"></span>
                <svg style="height:24px" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" /></svg>
            </a>

            <div class="me-2 position-relative">
                <span id="CountChatId" class="badge-count badge-top-right d-none"></span>
                <a class="buttonGreen2" href="/Chat/Main">پیام رسان</a>
            </div>
        </div>
    </div>
</header>
