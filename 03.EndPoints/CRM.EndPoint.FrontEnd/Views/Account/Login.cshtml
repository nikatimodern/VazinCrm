@{
    Layout = "_LoginLayout";
}

@model CRM.EndPoint.FrontEnd.Models.Login.LoginModel


<div style="display:flex;flex-direction:column; justify-content:start;align-items:center;  width:80%; ">
    <p class="mp fbold text-center" style="font-size:20px;color:#5811b4;">ورود به سامانه مدیریت مشتری</p>

    <div class="w-100">
        <div class="content__error" id="recaptcha_msg"></div>
        <form id="loginForm">
            <input type="hidden" name="returnUrl" id="returnUrl" value="@ViewBag.returnUrl" />
            @Html.AntiForgeryToken()
            <div class="form-group mb-2 p-0" id="email_group">
                <span class="form-group__icon">
                    <svg style="width: 26px;height: 26px;color: #787c83" fill="none" viewBox="0 0 24 24" stroke-width="1.25" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" /></svg>
                </span>
                <input name="userName" type="text" placeholder="نام کاربری" autocomplete="off" autofocus class="form-group__input form-group__input--ltr " value="">
            </div>
            <div class="form-group mb-2 p-0" id="password_group">
                <span class="form-group__icon" style="cursor: pointer" id="togglePassword">
                    <svg id="eyeClosedPassword" style="width: 26px;height: 26px;color: #787c83" fill="none" viewBox="0 0 24 24" stroke-width="1.25" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
                    <svg id="eyeOpenPassword" style="width: 26px;height: 26px;color: #787c83;display: none" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88" /></svg>
                </span>
                <input name="password" id="passwordInput" type="password" placeholder="رمز عبور" class="form-group__input form-group__input--ltr" value="">
            </div>
            <button type="submit" class="col-12 buttonGreen2 login-btn flex-center" id="login_button">
                <span>ورود</span>
                <div class="spinner-border spinner-border-sm d-none ms-2" role="status"></div>
            </button>
        </form>
        <div class="d-flex align-items-center justify-content-between mt-2">
            <a asp-controller="Account" asp-action="OtpLogin" asp-route-type="Forgot" class="link-purple fMedium">فراموشی رمز عبور</a>
            <a asp-controller="Account" asp-action="OtpLogin" class="link-gray fMedium">ورود با رمز یکبار مصرف</a>
        </div>
        <div class="errorLoginText justify-content-center align-items-center" id="LoginMsg"></div>
    </div>
</div>



@section Scripts {
    <script>
        const loginButton = document.getElementById("login_button");
        document.getElementById("togglePassword").addEventListener("click", function () {
            const passwordInput = document.getElementById("passwordInput");
            const eyeOpen = document.getElementById("eyeOpenPassword");
            const eyeClosed = document.getElementById("eyeClosedPassword");

            if (passwordInput.type === "password") {
                passwordInput.type = "text";
                eyeOpen.style.display = "block";
                eyeClosed.style.display = "none";
            } else {
                passwordInput.type = "password";
                eyeOpen.style.display = "none";
                eyeClosed.style.display = "block";
            }
        });

        const loginMsgElm = document.getElementById("LoginMsg");
        let passwordLockoutInterval;
        let submitting = false;

        function displayPasswordLockout(seconds) {
            clearInterval(passwordLockoutInterval);
            const endsAt = Date.now() + seconds * 1000;
            const render = () => {
                const remaining = Math.max(0, Math.ceil((endsAt - Date.now()) / 1000));
                if (remaining > 0) {
                    loginMsgElm.innerText = `ورود با رمز عبور مسدود است. ${remaining} ثانیه دیگر تلاش کنید.`;
                    loginButton.disabled = true;
                } else {
                    clearInterval(passwordLockoutInterval);
                    loginMsgElm.innerText = "";
                    if (!submitting) loginButton.disabled = false;
                }
            };
            render();
            passwordLockoutInterval = setInterval(render, 1000);
        }

        document.getElementById("loginForm").addEventListener("submit", async (e) => {
            e.preventDefault();
            if (submitting || loginButton.disabled) return;
            submitting = true;
            toggleElementsDisabled(loginButton);
            loginButton.querySelector(".spinner-border").classList.remove("d-none");

            const model = {
                userName: e.target.userName.value,
                password: e.target.password.value,
                returnUrl: e.target.returnUrl.value,
            };

            try {
                const res = await fetch("/Account/Login", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "RequestVerificationToken": e.target.__RequestVerificationToken.value,
                    },
                    body: JSON.stringify(model),
                });
                const data = await res.json();
                loginMsgElm.innerText = "";

                if (res.ok) {
                    goTo(data.url);
                    return;
                }

                if (res.status === 429 && data.retryAfterSeconds > 0) {
                    displayPasswordLockout(data.retryAfterSeconds);
                } else if (res.status === 405 && Array.isArray(data.errors)) {
                    data.errors.forEach(err => {
                        const pElm = document.createElement("p");
                        pElm.innerText = err;
                        loginMsgElm.appendChild(pElm);
                    });
                } else {
                    loginMsgElm.innerText = data.message || "ورود انجام نشد.";
                }
            } catch {
                loginMsgElm.innerText = "ارتباط با سرور برقرار نشد. دوباره تلاش کنید.";
            } finally {
                submitting = false;
                toggleElementsDisabled(loginButton, false);
                loginButton.querySelector(".spinner-border").classList.add("d-none");
                if (passwordLockoutInterval) {
                    // The server remains authoritative even if the browser is refreshed or modified.
                    const locked = loginMsgElm.innerText.includes("ثانیه دیگر تلاش کنید");
                    loginButton.disabled = locked;
                }
            }
        });
    </script>
}



