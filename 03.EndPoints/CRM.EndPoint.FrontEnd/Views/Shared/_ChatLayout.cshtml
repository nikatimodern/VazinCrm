<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=8, IE=9" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="robots" content="noindex" />
    <meta name="googlebot" content="noindex" />
    <meta name="googlebot-news" content="noindex" />
    <meta name="slurp" content="noindex" />
    <meta name="msnbot" content="noindex" />

    <meta property="og:title" content="CRM">
    <meta property="og:description" content="سامانه مدیریت ارتباط با مشتری">
    <meta property="og:locale" content="fa_IR">
    <meta property="og:image" content="/static/icons/logo-180x180.png">
    <meta name="twitter:card" content="summary">

    <link rel="apple-touch-icon" sizes="180x180" href="/static/icons/logo-180x180.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/static/icons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/static/icons/favicon-16x16.png">
    <link rel="manifest" href="/manifest.json?v=3.4.5">

    <meta name="apple-mobile-web-app-title" content="VazinCRM">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">

    <meta name="theme-color" content="#004944">

    <title>&rlm;سامانه مدیریت مشتری&zwnj;&rlm;</title>


    <link rel="stylesheet" href="~/lib/Bootstrap/bootstrap5.3.rtl.min.css" />
    <link rel="stylesheet" href="~/lib/toastify/toastify.min.css" />
    <link rel="stylesheet" href="~/lib/CropperJs/cropper.min.css" />
    <link rel="stylesheet" href="~/lib/FontAwesome.Pro.5.15.1.Web/css/solid.min.css" />
    <link rel="stylesheet" href="~/lib/FontAwesome.Pro.5.15.1.Web/css/font-awesome-animation.min.css" />

    <link rel="stylesheet" href="~/css/site.css?v=3.4.5" />
    <link rel="stylesheet" href="~/css/dashboard.css?v=3.4.5" />
    <link rel="stylesheet" href="~/css/reports.css?v=3.4.5" />
    <link rel="stylesheet" href="~/css/email.css?v=3.4.5" />
    <link rel="stylesheet" href="~/css/chat.css?v=3.4.5" />
</head>
<body dir="rtl">
<div id="FLshowLoading" style="z-index: 9000;position: fixed;inset: 0;height:100dvh;display:none">
    <div>
        <div class="loader"></div>
    </div>
</div>

<div id="mainWrapper" style="container-type: inline-size;container-name: mainWrapper; min-height:100dvh;position:relative">
    <header id="mainHeader" class="d-flex align-items-center justify-content-between">
        <div class="profileImg" onclick="ShowModalUserSetting()">
            <div class="mp">
                <img id="ImgUser" class="imgUser" src="~/Img/User.png" alt="">
            </div>
            <div>
                <span>کاربر: </span>
                <span id="NameUser" class="fbold" style="font-size:clamp(12px, 2vw, 13px);white-space:nowrap"></span>
            </div>
        </div>
        <div id="customerLogo">
            <a href="//vazinplast.com" target="_blank" class="d-flex align-items-center gap-2 text-white">
                <img id="logoCompanyIcon" src="~/Img/logo-vazinplast1.png" alt="لوگو" style="height:30px;">
                <img id="logoCompanyText" src="~/Img/logo-vazinplast2.png" alt="متن لوگو" style="height:36px;">
            </a>
        </div>
    </header>

    <div id="mainContent">
        <main role="main">
            @RenderBody()
        </main>
    </div>
</div>






<!-- Modal addChat -->
<div class="modal fade" id="addChatModal" aria-modal="true" role="dialog" tabindex="-1" data-bs-focus="false">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">

            <div class="m-2 mb-0" style="height:30px;display:flex; justify-content:center; align-items:center;  background: linear-gradient(to bottom, #025751, #00302d); color:white;border-radius:5px">
                <label class="fbold">ارسال پیام</label>
            </div>

            <div class="modal-body" style="padding:13px">
                <div style="border:1px solid #8b8b8b;border-radius:6px">
                    <div class="d-flex flex-column w-100">
                        <div class="d-flex justify-content-evenly p-3 pb-0">
                            <div class="d-flex align-items-center gap-1">
                                <input class="valueNumber" type="radio" name="addChat" id="addChatVazin" value="1" checked>
                                <label for="addChatVazin">کارشناسان وزین</label>
                            </div>

                            <div class="d-flex align-items-center gap-1" id="addChatOthersWrapper">
                                <input class="valueNumber" type="radio" name="addChat" id="addChatOthers" value="2">
                                <label for="addChatOthers">سایر</label>
                            </div>
                        </div>

                        <div class="mt-3 mb-2" style="width:100%;background-color: rgba(0,0,0,0.1);height:1px"></div>

                        <div class="d-flex flex-column p-3 pt-0" style="max-height: 500px;overflow: auto">

                            <div id="salesExpertsContainer">
                            </div>
                            <div id="othersContainer" class="d-none">
                                <div class="d-flex flex-column gap-1">
                                    <label for="otherInput">شماره موبایل: </label>
                                    <div class="position-relative">
                                        <span  style="position: absolute;left: 8px;top: 50%;transform: translateY(-50%)">09</span>
                                        <input id="otherInput" autocomplete="off" type="text" inputmode="numeric" class="form-control IranMobileNumber text-end" style="padding-inline: 22px">
                                        <span id="otherInputBtn" class="cursor-pointer" style="position: absolute;right: 4px;top: 50%;transform: translateY(-50%)" onclick="submitOtherInput()">
                                            <svg fill="none" stroke="currentColor" stroke-width="1.5" style="width: 24px; height: 24px;transform: rotate(-90deg);" viewBox="0 0 24 24"><path d="m9 12.75 3 3m0 0 3-3m-3 3v-7.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer justify-content-center" style="border-top:none;padding-top:0">
                <button class="buttonCancel2 my-0" type="button" onclick="cancelAddEmailModal()">انصراف</button>
            </div>

        </div>
    </div>
</div>



<!-- Modal AttachChat -->
<div class="modal fade" dir="ltr" id="AttachChatModal" tabindex="-1" role="dialog" data-bs-focus="false" data-bs-backdrop="static" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content col-12" style="padding:10px 10px 0">
            <div class="modal-body" style=" display:flex;flex-direction:column; justify-content:space-between; width:100% !important;">
                <div class="col-12">
                    <div class="fmp ">
                        <div style="display:flex;justify-content:center">
                            <div class="col-12">
                                <div class="container-uploader">
                                    <input type="file" class="uploadBtn" data-varList="chatAttachment" data-showList="imgDisplayChatAttach" id="chatAttachInp" multiple accept="*" />

                                    <label for="chatAttachInp">
                                        <svg style="width: 16px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" /></svg>
                                        <span>درج تصویر</span>
                                    </label>
                                    <div class="image-display" id="imgDisplayChatAttach"></div>
                                </div>
                            </div>
                            <button class="AddFile_Btn buttonGreen" id="AddFile_BtnId" style="display:none">
                                <i class="fas fa-plus AttachBt"></i>
                            </button>
                        </div>

                    </div>
                </div>

                <div class="mt-3" style="width:100%; display:flex;justify-content:center;gap:4px">
                    <button class="buttonGreen3" onclick="submitChatAttach()">ارسال</button>
                    <button class="buttonCancel2" onclick="toggleAttachChatModal() ">انصراف</button>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Modal UserSetting -->
<div class="modal fade " dir="ltr" id="UserSetting" tabindex="-1" role="dialog" data-bs-focus="false" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class=" modal-dialog modal-dialog-centered " role="document">
        <div class="modal-content ">
            <div class="modal-header" style="direction:rtl;background-color:lightgray">
                <h1 class="modal-title fs-5" id="exampleModalCenterTitle">مشخصات</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class=" modal-body" dir="rtl">
                <div class="ar-container">
                    <div class="ar-content pt-0 pb-2" style="box-shadow: none">
                        <div class=" " style=" display:flex;flex-direction:column;justify-content:center;align-items:center">
                            <input class=" buttonCancel2 mb-2" style="padding: 4px 16px !important;height:auto !important" id="btnDelPersonImg" title="حذف عکس" type="button" value="× حذف عکس" onclick="delPersonImage()" />

                            <div class="mt-2" style="margin-bottom:24px; width:40%; ">
                                <img src="" id="PersonImgPreview" alt="" style="width:100%;aspect-ratio:1;object-fit:cover;object-position:center;border-radius:50%;outline:2px solid rgba(0, 0, 0, 0.2)">
                            </div>
                        </div>
                        <div dir="ltr">
                            <div class="input-group align-items-center my-3 mp gap-2">
                                <input type="text" style="height:28px !important" class="form-control" disabled placeholder="آدرس تصویر" id="AddPersonImgTXT">
                                <div class="input-group-append mp">
                                    <button type="button" class="AddPersonImg_Btn buttonGreen3" style="padding: 4px 16px !important;height:auto !important">درج تصویر</button>
                                </div>
                            </div>
                            <input type="file" name="InpPersonImg" id="InpPersonImg" class="AddPersonImg_Inp mp" accept="image/*" style="display:none">
                        </div>
                        <div class="mt-3">
                            <ul style="padding:0;">
                                <li class="mb-2">
                                    <label>نام</label>
                                    <input type="text" name="PFirstName" id="PFirstName" class="form-control mp">
                                </li>
                                <li class="mb-2">
                                    <label dir="rtl">نام خانوادگی</label>
                                    <input name="PLastName" id="PLastName" class="form-control mp">
                                </li>
                                <li>
                                    <label dir="rtl">تلفن همراه</label>
                                    <input inputmode="numeric" name="PPhoneNumber" id="PPhoneNumber" type="tel" class="form-control mp digitNumber">
                                </li>
                            </ul>
                        </div>
                        <div class="mt-4" style="text-align:end;color:#fff">
                            <a class="d-inline-block buttonCancel2" href="~/account/Logout">خروج از سیستم</a>
                            <button class="buttonGreen3" onclick="SavePersonSetting()">ثبت</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<!-- cropModal -->
<div id="cropModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);justify-content:center;align-items:center;z-index: 2000">
    <div style="position:relative;width:400px;height:400px;background:#fff;overflow: hidden">
        <img id="cropImage" style="width:100%;height:100%;">
        <span id="cropOkBtn" class="d-flex align-items-center justify-content-center" style="position:absolute;bottom:10px;left:50%;transform:translateX(-50%);background: #fff;border-radius: 50%;cursor: pointer;padding: 3px;">
            <svg style="width: 18px" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
        </span>
        <span id="cropCloseBtn" class="d-flex align-items-center justify-content-center" style="position:absolute;top:10px;right:10px;background:#fff;border-radius:50%;cursor:pointer;padding: 2px;">
            <svg style="width: 15px" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
        </span>
    </div>
</div>


<div id="divFrame" style="display:none; justify-content:center; align-items:center;z-index: 9000; height:90dvh; width:100%; top:50%;transform: translateY(-50%);position:fixed;background-color:hsla(1, 100%, 100%,0.9)">
    <div style=" position:fixed;top:30px;right:30px; display:flex;justify-content:start  ">
        <span class="btn btn-dark d-flex align-items-center justify-content-center p-2" style="cursor:pointer;" onclick="hideDivFrame()">
            <svg style="width: 24px" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
        </span>
    </div>
    <iframe src="" id="IframeId" style="height:100%;width:100%;"></iframe>
</div>


<div class="modal fade" id="pwaInstallModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content pwa-modal">

            <div class="modal-body text-center">
                @* <div class="pwa-icon">📲</div> *@

                <h5 class="mb-3">نصب اپلیکیشن سامانه وزین پلاست</h5>
                <p class="text-muted small mt-2">
                    با نصب اپلیکیشن، سریع‌تر وارد شوید و اعلان‌ها را دریافت کنید.
                </p>

                <div class="d-flex gap-2 mt-4">
                    <button id="pwaInstallBtn" class="btn btn-primary w-100">
                        نصب
                    </button>
                    <button class="btn btn-light w-100" data-bs-dismiss="modal">
                        بعداً
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="iosPwaInstallModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content pwa-modal">
            <div class="modal-body text-center">
                <h5 class="mb-3">نصب اپلیکیشن سامانه وزین پلاست</h5>
                <p class="text-muted small mt-2">
                    برای نصب اپلیکیشن روی ios:
                    <br>
                    دکمه <strong>Share</strong> را بزنید
                    و گزینه <strong>Add to Home Screen</strong> را انتخاب کنید.
                </p>

                <button class="btn btn-primary w-100 mt-3" data-bs-dismiss="modal">
                    فهمیدم
                </button>
            </div>

        </div>
    </div>
</div>





<script src="~/lib/Bootstrap/bootstrap5.3.bundle.min.js"></script>
<script src="~/lib/jquery/jquery.min.js"></script>
<script src="~/lib/toastify/toastify-js.js"></script>
<script src="~/lib/axios/axios.min.js"></script>
<script src="~/lib/Signalr/signalr.min.js"></script>
<script src="~/lib/lightBox2/js/lightbox.min.js"></script>
<script src="~/lib/CropperJs/cropper.min.js"></script>
<script src="~/lib/FontAwesome.Pro.5.15.1.Web/js/solid.min.js"></script>
<script src="~/lib/FontAwesome.Pro.5.15.1.Web/js/fontawesome.min.js"></script>

<script src="~/js/pwa.js?v=3.4.5"></script>
<script src="~/js/site.js?v=3.4.5"></script>
<script src="~/js/UploadFile.js?v=3.4.5"></script>

<script src="~/js/DateValidate.js?v=3.4.5"></script>
<script src="~/js/TaskSignalR.js?v=3.4.5"></script>
<script src="~/js/Layout.js?v=3.4.5" defer></script>

<script>
    var baseUrl;
    if ('@Url.Action("", "")' == "/") {

        baseUrl = '@Url.Action("", "")';
    } else {

        baseUrl = '@Url.Action("", "")/';
    }
</script>


@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
