    .user-role-filter-chips-row { grid-area:chips; min-width:0; }
    .user-role-filter-chips-row:has(.selected-user-role-chips:empty) { display:none; }
    .user-search-wrap { position:relative; width:100%; min-width:0; max-width:none; align-self:start; }
    .user-filter-group { grid-area:filters; display:flex; align-items:flex-end; justify-content:flex-start; gap:12px; flex-wrap:wrap; min-width:0; }
    .user-filter { display:flex; flex-direction:column; gap:7px; color:#667584; font-size:12px; min-width:130px; flex:1 1 130px; }
    .user-filter > span { display:flex; align-items:center; gap:6px; min-height:18px; white-space:nowrap; }
