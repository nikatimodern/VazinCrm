<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:title" content="Vazin Plast ERP" />
    <meta property="og:description" content="سامانه یکپارچه مدیریت منابع سازمان وزین پلاست" />
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:image" content="/static/icons/logo-180x180.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/static/icons/logo-180x180.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/static/icons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/static/icons/favicon-16x16.png">
    <link rel="manifest" href="/manifest.json?release=7.5.6">
    <meta name="apple-mobile-web-app-title" content="Vazin Plast ERP">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="theme-color" content="#004944">
    <title>وزین پلاست | ERP</title>

    <link rel="stylesheet" href="~/lib/Bootstrap/bootstrap5.3.rtl.min.css?release=7.5.6" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/toastify/toastify.min.css?release=7.5.6" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css?release=7.5.6" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Login.css?release=7.5.6" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/erpLogin.css?release=7.5.6" asp-append-version="true" />
</head>
<body dir="rtl" class="erp-login-page">
    <div id="FLshowLoading" style="display:none">
        <div><div class="loader"></div></div>
    </div>

    <div class="parentLogin erp-login-shell">
        <button type="button" class="d-none" id="historyBackIcon"
                aria-label="بازگشت" onclick="window.history.back()">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/>
            </svg>
        </button>

        <main class="loginRenderBody">
            <div class="erp-login-inner">
                <div class="erp-brand" aria-label="سامانه وزین پلاست ERP">
                    <img class="erp-brand-logo" src="~/Img/vazin-logo-theme.webp" asp-append-version="true" alt="نشان وزین پلاست" />
                    <span class="erp-brand-names">
                        <strong>وزین پلاست <span class="erp-brand-en">ERP</span></strong>
                        <small>سامانه یکپارچه مدیریت سازمان</small>
                    </span>
                </div>
                @RenderBody()
                <small class="erp-login-footnote">محیط اختصاصی و امن کارکنان و مشتریان وزین پلاست</small>
            </div>
        </main>

        <aside class="erp-login-visual" aria-label="معرفی قابلیت‌های سامانه یکپارچه وزین پلاست">
            <img src="~/Img/erp-login-hero-brand.webp" asp-append-version="true" alt="" class="erp-visual-image" aria-hidden="true" />
            <div class="erp-visual-overlay"></div>
            <div class="erp-visual-content">
                <div class="erp-visual-kicker">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 2 9 5-9 5-9-5 9-5ZM3 12l9 5 9-5M3 17l9 5 9-5"/></svg>
                    <span>VAZIN PLAST ERP</span>
                </div>
                <div class="erp-visual-bottom">
                    <div class="erp-visual-message">
                        <p class="erp-visual-eyebrow">هوشمند، یکپارچه، قابل اطمینان</p>
                        <h2>همه بخش‌های سازمان،<br />در یک سامانه</h2>
                        <p>مدیریت مشتریان، فروش، انبار، امور مالی و گزارش‌ها در یک مسیر یکپارچه</p>
                    </div>
                    <div class="erp-visual-modules" role="list" aria-label="قابلیت‌های شاخص ERP وزین پلاست">
                    <div class="erp-module-card erp-module-card--special" role="listitem">
                        <svg class="erp-module-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 14v-3a9 9 0 0 1 18 0v3"/><path d="M3 14v5a2 2 0 0 0 2 2h2v-8H5a2 2 0 0 0-2 2"/><path d="M21 14v5a2 2 0 0 1-2 2h-2v-8h2a2 2 0 0 1 2 2"/></svg>
                        <strong class="erp-module-title">تحلیل تماس با AI</strong>
                        <span class="erp-module-description">VoIP + هوش مصنوعی</span>
                    </div>
                    <div class="erp-module-card erp-module-card--special" role="listitem">
                        <svg class="erp-module-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3H5a2 2 0 0 0-2 2v2m14-4h2a2 2 0 0 1 2 2v2M3 17v2a2 2 0 0 0 2 2h2m10 0h2a2 2 0 0 0 2-2v-2"/><path d="M8 7h6l3 3v7H8z"/><path d="M14 7v3h3M10 13h5M10 15.5h5"/></svg>
                        <strong class="erp-module-title">ثبت هوشمند فاکتور</strong>
                        <span class="erp-module-description">تصویر به اطلاعات</span>
                    </div>
                    <div class="erp-module-card erp-module-card--special" role="listitem">
                        <svg class="erp-module-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v7c0 1.6 3.6 3 8 3s8-1.4 8-3V5"/><path d="M4 12v7c0 1.6 3.6 3 8 3s8-1.4 8-3v-7"/><path d="M4 12c0 1.6 3.6 3 8 3s8-1.4 8-3"/></svg>
                        <strong class="erp-module-title">اتصال به نرم‌افزارهای مالی</strong>
                        <span class="erp-module-description">سپیدار و سایر سیستم‌ها</span>
                    </div>
                    <div class="erp-module-card" role="listitem">
                        <svg class="erp-module-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.5 13a2 2 0 0 0 2 1.5h10a2 2 0 0 0 2-1.6l1.1-7.2H6"/></svg>
                        <strong class="erp-module-title">فروش و سفارشات</strong>
                        <span class="erp-module-description">سفارش، پیش‌فاکتور، فاکتور</span>
                    </div>
                    <div class="erp-module-card" role="listitem">
                        <svg class="erp-module-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        <strong class="erp-module-title">مدیریت مشتریان</strong>
                        <span class="erp-module-description">مشتریان و تأمین‌کنندگان</span>
                    </div>
                    <div class="erp-module-card" role="listitem">
                        <svg class="erp-module-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="15" rx="2"/><path d="M3 9h18M16 16h2M7 13h5"/></svg>
                        <strong class="erp-module-title">مدیریت مالی</strong>
                        <span class="erp-module-description">چک، پرداخت، مطالبات</span>
                    </div>
                    <div class="erp-module-card" role="listitem">
                        <svg class="erp-module-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 2 9 5-9 5-9-5 9-5ZM3 7v10l9 5 9-5V7M12 12v10"/></svg>
                        <strong class="erp-module-title">مدیریت انبار</strong>
                        <span class="erp-module-description">گردش کالا و موجودی</span>
                    </div>
                    <div class="erp-module-card" role="listitem">
                        <svg class="erp-module-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 21V12h4v9M10 21V7h4v14M16 21V3h4v18M2 21h20"/></svg>
                        <strong class="erp-module-title">گزارش‌های مدیریتی</strong>
                        <span class="erp-module-description">داشبورد و تحلیل</span>
                    </div>
                    <div class="erp-module-card" role="listitem">
                        <svg class="erp-module-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="7" height="7" rx="2"/><rect x="15" y="2" width="7" height="7" rx="2"/><rect x="8.5" y="15" width="7" height="7" rx="2"/><path d="M9 5.5h6M5.5 9v3a3 3 0 0 0 3 3h3.5M18.5 9v3a3 3 0 0 1-3 3h-3.5"/></svg>
                        <strong class="erp-module-title">گردش کار</strong>
                        <span class="erp-module-description">کارتابل و فرآیندها</span>
                    </div>
                    </div>
                </div>
            </div>
        </aside>
    </div>

    <partial name="~/Views/Account/Modals/_SelectAccountModal.cshtml" />

    <script>
        document.getElementById("historyBackIcon").classList.toggle("d-none", window.location.pathname === "/");
    </script>
    <script src="~/lib/Bootstrap/bootstrap5.3.bundle.min.js?release=7.5.6" asp-append-version="true"></script>
    <script src="~/lib/jquery/jquery.min.js?release=7.5.6" asp-append-version="true"></script>
    <script src="~/lib/toastify/toastify-js.js?release=7.5.6" asp-append-version="true"></script>
    <script src="~/js/site.js?release=7.5.6" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>