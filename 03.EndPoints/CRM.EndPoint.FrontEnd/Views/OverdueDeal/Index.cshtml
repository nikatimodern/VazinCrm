@{
    ViewData["Title"] = "سفارشات باز معوقه";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .overdue-filter-button {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #5b21b6;
        border-radius: .7rem;
        background: linear-gradient(135deg, #7c3aed, #4c1d95);
        color: #fff;
        box-shadow: 0 4px 12px rgba(76, 29, 149, .3);
        transition: all .18s ease;
    }


    .overdue-filter-button:hover,
    .overdue-filter-button:focus-visible {
        border-color: #7c3aed;
        background: linear-gradient(135deg, #7c3aed, #5b21b6);
        color: #fff;
        box-shadow: 0 5px 13px rgba(109, 40, 217, .24);
        transform: translateY(-1px);
    }


    .overdue-sort-button {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .2rem .1rem;
        border: 0;
        background: transparent;
        color: inherit;
        font: inherit;
        font-family: IranSansBold;
        cursor: pointer;
        white-space: nowrap;
    }


    .overdue-sort-button:hover,
    .overdue-sort-button:focus-visible {
        color: #6d28d9;
        outline: none;
    }


    .overdue-sort-button .sort-indicator {
        color: #8b5cf6;
        font-size: .85rem;
        opacity: .7;
    }


    .overdue-sort-button[aria-sort="ascending"] .sort-indicator,
    .overdue-sort-button[aria-sort="descending"] .sort-indicator {
        opacity: 1;
        color: #5b21b6;
    }


    .overdue-refresh-button {
        border-color: #0f766e;
        border-radius: .7rem;
        background: #0f766e;
        color: #fff;
        font-family: IranSansBold;
    }


    .overdue-refresh-button:hover {
        border-color: #14b8a6;
        background: #0d9488;
        color: #fff;
    }


    .overdue-count-badge {
        background: #0f766e !important;
        color: #fff !important;
        min-width: 28px;
        padding: .4rem .65rem;
        font-family: IranSansBold;
        box-shadow: 0 3px 8px rgba(15, 118, 110, .3);
    }


    #overdueDealsTableWrap {
        border-radius: 0;
        scrollbar-width: thin;
        scrollbar-color: #c4b5fd #f5f3ff;
    }


    #overdueDealsTableWrap .table {
        --bs-table-bg: transparent;
        margin-bottom: 0;
        border-collapse: separate;
        border-spacing: 0;
        color: #334155;
    }


    #overdueDealsTableWrap thead th {
        padding: 1rem .9rem;
        background: linear-gradient(135deg, #f5f3ff, #ede9fe);
        color: #4c1d95;
        font-size: .82rem;
        font-family: IranSansBold;
        white-space: nowrap;
        border-bottom: 1px solid #ddd6fe;
    }


    #overdueDealsTableWrap tbody td {
        padding: .9rem;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
        transition: background-color .18s ease;
    }


    #overdueDealsTableWrap tbody tr:nth-child(even) {
        background-color: #faf9ff;
    }


    #overdueDealsTableWrap tbody tr:hover td {
        background-color: #f1edff;
    }


    #overdueDealsTableWrap tbody tr:last-child td {
        border-bottom: 0;
    }


    .overdue-view-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 34px;
        border: 1px solid #0f766e;
        border-radius: .65rem;
        background: #0f766e;
        color: #fff;
        transition: all .18s ease;
    }


    .overdue-view-button:hover,
    .overdue-view-button:focus-visible {
        border-color: #4c1d95;
        background: #4c1d95;
        color: #fff;
        transform: translateY(-1px);
    }


    /* Compact order metadata: five columns x two rows on desktop */
    #overdueDealDetailsContent {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: .45rem;
        margin: 0;
    }

    #overdueDealDetailsContent > .overdue-detail-cell {
        min-width: 0;
        padding: .55rem .65rem;
        border: 1px solid #dbe2ea;
        border-radius: .55rem;
        background: #fff;
        display: flex;
        align-items: baseline;
        gap: .35rem;
        overflow: hidden;
    }

    .overdue-detail-label {
        flex: 0 0 auto;
        color: #64748b;
        font-size: .72rem;
        white-space: nowrap;
    }

    .overdue-detail-value {
        min-width: 0;
        color: #1f2937;
        font-family: IranSansBold;
        font-size: .8rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .overdue-detail-cell.overdue-detail-comment {
        grid-column: span 2;
    }

    @@media (max-width: 991.98px) {
        #overdueDealDetailsContent {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 575.98px) {
        #overdueDealDetailsContent {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        #overdueDealDetailsContent > .overdue-detail-cell {
            padding: .45rem .5rem;
            gap: .25rem;
        }

        .overdue-detail-label {
            font-size: .68rem;
        }

        .overdue-detail-value {
            font-size: .74rem;
        }

        .overdue-detail-cell.overdue-detail-comment {
            grid-column: span 2;
        }
    }


    .overdue-prefactor-row {
        align-items: stretch;
        min-width: 0;
    }

    .overdue-prefactor-actions {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        gap: 7px;
        flex: 0 0 28px;
        padding: 8px 4px;
        color: var(--DarkColor);
    }

    .overdue-prefactor-actions button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        padding: 0;
        border: 0;
        background: transparent;
        color: var(--DarkColor);
        cursor: pointer;
        border-radius: 4px;
        transition: background-color .15s ease, color .15s ease;
    }

    .overdue-prefactor-actions button:hover,
    .overdue-prefactor-actions button:focus-visible {
        background: #ede9fe;
        color: #5b21b6;
        outline: none;
    }

    .overdue-prefactor-actions button i {
        font-size: 15px;
    }

    .overdue-prefactor-side {
        flex: 0 0 24px;
        width: 24px;
        min-height: 100%;
        border-radius: 0 8px 8px 0;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .overdue-prefactor-side-text {
        writing-mode: vertical-rl;
        white-space: nowrap;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .2px;
    }

    .overdue-prefactor-card {
        min-width: 0;
        border-radius: 8px 0 0 8px;
        padding: 10px 12px;
        box-shadow: 0 1px 3px rgba(15, 23, 42, .06);
    }

    .overdue-prefactor-main {
        display: grid;
        grid-template-columns: minmax(150px, 1.1fr) minmax(180px, 1fr) minmax(150px, 1fr);
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .overdue-prefactor-meta,
    .overdue-prefactor-financial,
    .overdue-prefactor-customer {
        display: flex;
        flex-direction: column;
        gap: 7px;
        min-width: 0;
    }

    .overdue-prefactor-meta > div,
    .overdue-prefactor-financial > div,
    .overdue-prefactor-customer > div {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 8px;
        min-width: 0;
    }

    .overdue-prefactor-meta span,
    .overdue-prefactor-financial span,
    .overdue-prefactor-customer span {
        color: #6b7280;
        flex: 0 0 auto;
        font-size: 12px;
    }

    .overdue-prefactor-meta strong,
    .overdue-prefactor-financial strong,
    .overdue-prefactor-customer strong {
        font-size: 12px;
        font-weight: 700;
        text-align: left;
        overflow-wrap: anywhere;
    }

    .overdue-prefactor-financial small {
        font-size: 10px;
        font-weight: 400;
        color: #6b7280;
    }

    @@media (max-width: 767.98px) {
        .overdue-prefactor-main {
            grid-template-columns: 1fr;
            gap: 8px;
        }

        .overdue-prefactor-meta,
        .overdue-prefactor-financial,
        .overdue-prefactor-customer {
            flex-direction: row;
            flex-wrap: wrap;
            justify-content: space-between;
            padding-bottom: 7px;
            border-bottom: 1px solid #e5e7eb;
        }

        .overdue-prefactor-meta > div,
        .overdue-prefactor-financial > div,
        .overdue-prefactor-customer > div {
            justify-content: flex-start;
            gap: 5px;
        }

        .overdue-prefactor-meta strong,
        .overdue-prefactor-financial strong,
        .overdue-prefactor-customer strong {
            text-align: right;
        }
    }

    .overdue-count-card-disabled {
        opacity: .52;
        cursor: not-allowed;
        filter: grayscale(.25);
    }

    .overdue-document-card {
        cursor: pointer;
        transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    }

    .overdue-document-card:hover,
    .overdue-document-card:focus-visible {
        border-color: #a78bfa;
        box-shadow: 0 5px 14px rgba(76, 29, 149, .14);
        transform: translateY(-2px);
        outline: none;
    }

    .overdue-reports-card {
        cursor: pointer;
        transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    }

    .overdue-reports-card:hover,
    .overdue-reports-card:focus-visible {
        border-color: #a78bfa;
        box-shadow: 0 5px 14px rgba(76, 29, 149, .14);
        transform: translateY(-2px);
        outline: none;
    }

    .overdue-count-card {
        border: 1px solid #e9d5ff;
        border-radius: .9rem;
        background: linear-gradient(135deg, #faf5ff, #fff);
        padding: 1rem;
        text-align: center;
        height: 100%;
    }


    .overdue-count-card .count-value {
        color: #4c1d95;
        font-size: 1.7rem;
        line-height: 1.3;
        font-family: IranSansBold;
    }


    .overdue-count-card .count-label {
        color: #475569;
        font-family: IranSansBold;
        margin-top: .35rem;
    }


    .overdue-count-card .count-icon {
        color: #0f766e;
        margin-bottom: .4rem;
    }


    #overdueDealsTableWrap .badge.text-bg-danger {
        padding: .45rem .65rem;
        border: 1px solid #fecaca;
        border-radius: 999px;
        background: #fff1f2 !important;
        color: #be123c !important;
        font-size: .75rem;
        font-family: IranSansBold;
    }


    #overdueDealsPagination,
    #overdueDealsPaginationTop {
        background: linear-gradient(110deg, #fff, #faf8ff);
    }


    #overdueDealsPaginationTop {
        border-bottom-color: #ede9fe !important;
    }


    #overdueDealsPagination {
        border-top-color: #ede9fe !important;
        border-radius: 0 0 .9rem .9rem;
    }


    #overdueDealsPagination label,
    #overdueDealsPaginationTop label {
        font-family: IranSansBold;
        color: #5b21b6 !important;
        white-space: nowrap;
    }


    #overduePageSize,
    #overduePageSizeTop {
        min-width: 76px;
        border-color: #ddd6fe;
        border-radius: .65rem;
        box-shadow: none;
    }


    #overduePageSize:focus,
    #overduePageSizeTop:focus {
        border-color: #8b5cf6;
        box-shadow: 0 0 0 .2rem rgba(139, 92, 246, .14);
    }


    #overduePaginationInfo,
    #overduePaginationInfoTop {
        padding: .35rem .7rem;
        border-radius: 999px;
        background: #f3e8ff;
        color: #6d28d9 !important;
        font-family: IranSansBold;
        white-space: nowrap;
    }


    #overduePaginationButtons,
    #overduePaginationButtonsTop {
        gap: .3rem;
        align-items: center;
    }


    #overduePaginationButtons .page-item,
    #overduePaginationButtonsTop .page-item {
        margin: 0;
    }


    #overduePaginationButtons .page-link,
    #overduePaginationButtonsTop .page-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 2.25rem;
        min-height: 2.25rem;
        padding: .35rem .7rem;
        border: 1px solid #e9e2ff;
        border-radius: .65rem !important;
        background: #fff;
        color: #6d28d9;
        font-size: .82rem;
        font-family: IranSansBold;
        box-shadow: 0 2px 5px rgba(76, 29, 149, .04);
        transition: all .18s ease;
    }


    #overduePaginationButtons .page-link:hover:not(:disabled),
    #overduePaginationButtonsTop .page-link:hover:not(:disabled) {
        border-color: #a78bfa;
        background: #f3e8ff;
        transform: translateY(-1px);
    }


    #overduePaginationButtons .page-item.active .page-link,
    #overduePaginationButtonsTop .page-item.active .page-link {
        border-color: #6d28d9;
        background: linear-gradient(135deg, #7c3aed, #5b21b6);
        color: #fff;
        box-shadow: 0 4px 10px rgba(109, 40, 217, .22);
    }


    #overduePaginationButtons .page-item.disabled .page-link,
    #overduePaginationButtonsTop .page-item.disabled .page-link {
        border-color: #f1f5f9;
        background: #f8fafc;
        color: #cbd5e1;
        box-shadow: none;
    }


    @@media (max-width: 767.98px) {
        #overdueDealsPagination,
        #overdueDealsPaginationTop {
            align-items: stretch !important;
        }

        #overdueDealsPagination > div,
        #overdueDealsPaginationTop > div {
            flex-wrap: wrap;
        }

        #overdueDealsPagination nav,
        #overdueDealsPaginationTop nav {
            width: 100%;
            overflow-x: auto;
            padding-bottom: .15rem;
        }

        #overduePaginationButtons,
        #overduePaginationButtonsTop {
            flex-wrap: nowrap;
            width: max-content;
        }

        #overdueDealsTableWrap .table {
            font-size: .86rem;
        }

        #overdueDealsTableWrap thead th,
        #overdueDealsTableWrap tbody td {
            padding: .75rem .65rem;
        }
    }


    @@media (prefers-reduced-motion: reduce) {
        #overdueDealsTableWrap *,
        #overdueDealsPagination *,
        #overdueDealsPaginationTop * {
            transition: none !important;
        }
    }
</style>

<div class="container-fluid py-3" dir="rtl">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
        <div class="d-flex align-items-center gap-2">
            <span class="d-inline-flex align-items-center justify-content-center rounded-3 p-2"
                  style="background: rgba(109, 40, 217, .12); color: #6d28d9;">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M12 2.25a9.75 9.75 0 1 0 0 19.5 9.75 9.75 0 0 0 0-19.5ZM12 6a.75.75 0 0 1 .75.75v5.1l3.03 1.82a.75.75 0 1 1-.772 1.286l-3.375-2.025A.75.75 0 0 1 11.25 12V6.75A.75.75 0 0 1 12 6Z" clip-rule="evenodd" />
                </svg>
            </span>
            <div>
                <h1 class="h5 mb-1">سفارشات باز معوقه</h1>
                <p class="text-muted mb-0">سفارش‌های باز با بیش از ۱۴ روز از زمان ثبت</p>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <input type="hidden" id="overdueDealSearch" value="" />
            <div id="ContentOverdueDealFilterId" class="ContentFilter"></div>
            <button type="button" class="btnFilter overdue-filter-button" data-filterVarConfig="filterDealConfig" data-filterCallBack="callbackFilterOverdueDeal" data-filterContentId="ContentOverdueDealFilterId" data-filterInpSearchId="overdueDealSearch" data-filterVarSearch="overdueDealSearchVal" onclick="ShowFilterPopup(this)" title="فیلتر">
                <svg viewBox="0 0 24 24" width="21" height="21" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3.792 2.938A49.069 49.069 0 0 1 12 2.25c2.797 0 5.54.236 8.209.688a1.857 1.857 0 0 1 1.541 1.836v1.044a3 3 0 0 1-.879 2.121l-6.182 6.182a1.5 1.5 0 0 0-.439 1.061v2.927a3 3 0 0 1-1.658 2.684l-1.757.878A.75.75 0 0 1 9.75 21v-5.818a1.5 1.5 0 0 0-.44-1.06L3.13 7.938a3 3 0 0 1-.879-2.121V4.774c0-.897.64-1.683 1.542-1.836Z" clip-rule="evenodd"></path></svg>
            </button>
            <span class="text-muted small">تعداد:</span>
            <span id="overdueDealCount" class="badge rounded-pill overdue-count-badge">۰</span>
            <button type="button" id="refreshOverdueDeals" class="btn btn-outline-secondary btn-sm overdue-refresh-button">
                <span class="me-1">بروزرسانی</span>
                <svg style="width: 16px" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M13.836 2.477a.75.75 0 0 1 .75.75v3.182a.75.75 0 0 1-.75.75h-3.182a.75.75 0 0 1 0-1.5h1.37l-.84-.841a4.5 4.5 0 0 0-7.08.932.75.75 0 0 1-1.3-.75 6 6 0 0 1 9.44-1.242l.842.84V3.227a.75.75 0 0 1 .75-.75Zm-.911 7.5A.75.75 0 0 1 13.199 11a6 6 0 0 1-9.44 1.241l-.84-.84v1.371a.75.75 0 0 1-1.5 0V9.591a.75.75 0 0 1 .75-.75H5.35a.75.75 0 0 1 0 1.5H3.98l.841.841a4.5 4.5 0 0 0 7.08-.932.75.75 0 0 1 1.025-.273Z" clip-rule="evenodd" /></svg>
            </button>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div id="overdueDealsLoading" class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">در حال دریافت اطلاعات...</span>
                </div>
                <p class="text-muted mt-3 mb-0">در حال دریافت سفارشات معوقه...</p>
            </div>

            <div id="overdueDealsError" class="alert alert-danger m-3 d-none" role="alert"></div>

            <div id="overdueDealsEmpty" class="text-center py-5 d-none">
                <div class="mb-2" style="font-size: 2rem; color: #16a34a;">✓</div>
                <h2 class="h6">سفارش معوقه‌ای وجود ندارد</h2>
                <p class="text-muted mb-0">در حال حاضر سفارشی با وضعیت باز و بیش از ۱۴ روز از زمان ثبت پیدا نشد.</p>
            </div>

            <div id="overdueDealsPaginationTop" class="d-flex flex-wrap align-items-center justify-content-between gap-3 p-3 border-bottom d-none">
                <div class="d-flex align-items-center gap-2">
                    <label for="overduePageSizeTop" class="small text-muted mb-0">تعداد در صفحه</label>
                    <select id="overduePageSizeTop" class="form-select form-select-sm" style="width: auto;">
                        <option value="10">۱۰</option>
                        <option value="20" selected>۲۰</option>
                        <option value="50">۵۰</option>
                        <option value="100">۱۰۰</option>
                        <option value="0">همه</option>
                    </select>
                    <span id="overduePaginationInfoTop" class="small text-muted"></span>
                </div>
                <nav aria-label="صفحه‌بندی بالای سفارشات معوقه">
                    <ul id="overduePaginationButtonsTop" class="pagination pagination-sm mb-0"></ul>
                </nav>
            </div>
            <div id="overdueDealsTableWrap" class="table-responsive d-none">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                    <tr>
                        <th>
                            <button type="button" class="overdue-sort-button text-nowrap" data-sort-by="serialNumber">شماره سفارش
                                <span class="sort-indicator">↕</span></button>
                        </th>
                        <th>
                            <button type="button" class="overdue-sort-button" data-sort-by="title">عنوان سفارش <span class="sort-indicator">↕</span>
                            </button>
                        </th>
                        <th>
                            <button type="button" class="overdue-sort-button" data-sort-by="customer">مشتری <span class="sort-indicator">↕</span>
                            </button>
                        </th>
                        <th>
                            <button type="button" class="overdue-sort-button text-nowrap" data-sort-by="customerCode">کد مشتری
                                <span class="sort-indicator">↕</span></button>
                        </th>
                        <th>
                            <button type="button" class="overdue-sort-button text-nowrap" data-sort-by="createDate">تاریخ ثبت
                                <span class="sort-indicator">↕</span></button>
                        </th>
                        <th>
                            <button type="button" class="overdue-sort-button text-nowrap" data-sort-by="waitingDays">مدت انتظار
                                <span class="sort-indicator">↕</span></button>
                        </th>
                        <th>
                            <button type="button" class="overdue-sort-button" data-sort-by="userCreator">ثبت‌کننده
                                <span class="sort-indicator">↕</span></button>
                        </th>
                        <th>
                            <button type="button" class="overdue-sort-button" data-sort-by="commentText">توضیحات <span class="sort-indicator">↕</span>
                            </button>
                        </th>
                        <th class="text-center text-nowrap">مشاهده</th>
                    </tr>
                    </thead>
                    <tbody id="overdueDealsTableBody"></tbody>
                </table>
            </div>
            <div id="overdueDealsPagination" class="d-flex flex-wrap align-items-center justify-content-between gap-3 p-3 border-top d-none">
                <div class="d-flex align-items-center gap-2">
                    <label for="overduePageSize" class="small text-muted mb-0">تعداد در صفحه</label>
                    <select id="overduePageSize" class="form-select form-select-sm" style="width: auto;">
                        <option value="10">۱۰</option>
                        <option value="20" selected>۲۰</option>
                        <option value="50">۵۰</option>
                        <option value="100">۱۰۰</option>
                        <option value="0">همه</option>
                    </select>
                    <span id="overduePaginationInfo" class="small text-muted"></span>
                </div>
                <nav aria-label="صفحه‌بندی سفارشات معوقه">
                    <ul id="overduePaginationButtons" class="pagination pagination-sm mb-0"></ul>
                </nav>
            </div>
        </div>
    </div>
</div>

