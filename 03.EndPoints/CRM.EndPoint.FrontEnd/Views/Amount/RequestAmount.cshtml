<!-- Modal requestAmount -->
<div class="modal fade" id="requestAmountModal" tabindex="-1" role="dialog" data-bs-focus="false">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content col-12 p-2">
            <div class="text-center text-white rounded py-1 fbold" style="background-color: #6c757d">درخواست وجه</div>
            <div class="modal-body pb-2">
                <form id="requestAmountForm" class="d-flex flex-column gap-2">
                    <div>
                        <label for="reqAmountAmount">مبلغ:</label>
                        <input id="reqAmountAmount" inputmode="numeric" class="form-control currencyNumber inpAmount" name="amount" required>
                    </div>

                    <div>
                        <label for="reqAmountDocType">نوع پرداخت:</label>
                        <select id="reqAmountDocType" class="form-select form-select-sm valueNumber" name="docType" required>
                            <option value="">انتخاب</option>
                            <option value="1">نقدی</option>
                            <option value="2">چکی</option>
                        </select>
                    </div>

                    @*<div>
                        <label for="reqAmountSupplyFactor">فاکتور تامین:</label>
                        <div class="input-group mb-3">
                            <input id="reqAmountSupplyFactor" type="text" class="form-control direction-ltr" placeholder="فاکتور تامین.." disabled required>
                            <button class="btn btn-sm btn-secondary" type="button" onclick="showAddSupplyFactorModal(this)">انتخاب</button>
                        </div>
                    </div>*@
                    <div>
                        <label for="reqAmountOrderHead">بابت حواله تولید:</label>
                        <div class="input-group mb-3">
                            <input id="reqAmountOrderHead" type="text" class="form-control direction-ltr" placeholder="حواله تولید.." disabled required>
                            <button class="btn btn-sm btn-secondary" type="button" onclick="showAddOrderHeadModal()">انتخاب</button>
                        </div>
                        @* <input name="supplierId" class="form-control" id="reqAmountOrderHead" /> *@
                    </div>


                    <div class="d-flex justify-content-center gap-1 mt-2">
                        <button type="button" class="buttonCancel2" style="padding-block: 4px" onclick="toggleRequestAmountModal()">انصراف</button>
                        <button type="button" class="buttonGreen3" style="padding-block: 4px" onclick="submitRequestAmountModal()">ثبت</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


<!-- Modal reqAmountAttach -->
<div class="modal fade " dir="ltr" id="reqAmountAttachModal" tabindex="-1" role="dialog" data-bs-focus="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content col-12" style="padding:10px 10px 0">

            <div class="modal-body" style=" display:flex;flex-direction:column; justify-content:space-between; width:100% !important;">
                <div class="col-12">
                    <div class="fmp ">
                        <div style="display:flex;justify-content:center">
                            <div class="col-12">
                                <div class="container-uploader">
                                    <input type="file" class="uploadBtn" data-varList="reqAmountAttachment" data-showList="imageDisplayReqAmountAt" id="reqAmountAttach" multiple accept="*" />

                                    <label for="reqAmountAttach">
                                        <svg style="width: 16px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" /></svg>
                                        <span>درج تصویر</span>
                                    </label>
                                    <div class="image-display" id="imageDisplayReqAmountAt"></div>
                                </div>
                            </div>
                            <button class="AddFile_Btn buttonGreen" id="AddFile_BtnId" style="display:none">
                                <i class="fas fa-plus AttachBt "></i>
                            </button>
                        </div>

                    </div>
                </div>

                <div class="mt-3" style="width:100%; display:flex;justify-content:center;gap:4px">
                    <button class="buttonGreen3" onclick="submitReqAmountAttach()">ثبت</button>
                    <button class="buttonCancel2" onclick="cancelReqAmountAttach() ">انصراف</button>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let requestAmountData;
        let reqAmountId;
        var reqAmountAttachment = [];

        document.addEventListener("DOMContentLoaded", async () => {
            //getAllRequestAmountDt();
            await getAllRequestAmount();

            document.getElementById("requestAmountSearchId").addEventListener("keyup", async (e) => {
                if (e.key === "Enter") {
                    await getAllRequestAmount();
                }
            });
            const requestAmountRadios = document.querySelectorAll("input[type='radio'][name='requestAmountFilter']");
            requestAmountRadios.forEach(elm => elm.addEventListener("change", async () => {
                await getAllRequestAmount();
            }));
        });


        function toggleRequestAmountModal() {
            ModalToggle("requestAmountModal");
            mySer.emptyForm("requestAmountForm");
            supplyFactorsSelectedIds = [];
            orderHeadsSelectedIds = [];
            requestAmountData = [];
        }

        async function submitRequestAmountModal() {
            if (!await mySer.CheckValidForm("requestAmountForm")) return;
            const model = {
                ...requestAmountData,
                ...mySer.convertFormToJSON("requestAmountForm"),
                requestAmountSupplyFactor: supplyFactorsSelectedIds.map(id => ({ supplyFactorId: id, requestAmountId: requestAmountData.id })),
                requestAmountOrderHeads: orderHeadsSelectedIds.map(id => ({ orderHeadId: id, requestAmountId: requestAmountData.id })),
            };

            try {
                FLshowLoading();
                const apiUrl = model.id ? "/Amount/UpdateRequestAmount" : "/Amount/AddRequestAmount";
                const res = await axios.post(apiUrl, model);
                if (res.status === 200) {
                    toastifySuccess("با موفقیت ثبت شد");
                    getAllRequestAmount();
                    toggleRequestAmountModal();
                }
            } catch (err) {
                console.log(err);
            } finally {
                FLshowLoading(false);
            }

        }


        const getAllRequestAmount = async () => {
            const val = document.getElementById("requestAmountSearchId")?.value.trim() ?? "";
            const type = document.querySelector("input[type='radio'][name='requestAmountFilter']:checked")?.value;
            if (type === undefined) return;
            FLshowLoading();
            const res = await axios(`/Amount/GetAllRequestAmountsPartial?search=${val}&type=${type}&passType=1`);
            document.getElementById("requestAmountContainer").innerHTML = res.data.html;
            FLshowLoading(false);
        };

        async function showEditRequestAmountModal(id) {
            FLshowLoading();
            toggleRequestAmountModal();

            try {
                const res = await axios(`/Amount/GetRequestAmount/${id}`);
                if (res.status === 200) {
                    requestAmountData = res.data.requestAmount;
                    const supplyFactorSerials = res.data.supplyFactorSerials;
                    const orderHeadSerials = res.data.orderHeadSerials;
                    mySer.convertJsonToForm(requestAmountData, "requestAmountForm");
                    supplyFactorsSelectedIds = requestAmountData.requestAmountSupplyFactor.map(r => r.supplyFactorId);
                    orderHeadsSelectedIds = requestAmountData.requestAmountOrderHeads.map(r => r.orderHeadId);

                    const inpElmSupplyFactor = document.getElementById("reqAmountSupplyFactor");
                    if (inpElmSupplyFactor) {
                        inpElmSupplyFactor.value = supplyFactorSerials.join(", ");
                    }

                    const inpElmOrderHead = document.getElementById("reqAmountOrderHead");
                    if (inpElmOrderHead) {
                        inpElmOrderHead.value = orderHeadSerials.join(", ");
                    }
                }

            } catch (err) {
                console.log(err);
            } finally {
                FLshowLoading(false);
            }
        }


        const deleteRequestAmount = async (id) => {
            Swal.fire({
                title: "حذف!",
                text: "آیا مطمئن هستید که میخواهید حذف کنید؟",
                icon: "warning",
                showCancelButton: true,
                cancelButtonColor: "#adadad",
                confirmButtonColor: "#e64942",
                cancelButtonText: "انصراف",
                confirmButtonText: "بله، حذف شود",
            }).then(async (willDelete) => {
                if (willDelete.isConfirmed) {
                    FLshowLoading();
                    const res = await axios(`/Amount/DeleteRequestAmount/${id}`);
                    if (res.status === 200) {
                        toastifySuccess("با موفقیت حذف شد");
                        await getAllRequestAmount();
                    }
                    FLshowLoading(false);
                }
            });
        };


        const showAttachReqAmount = async (id) => {
            reqAmountId = id;
            ModalToggle("reqAmountAttachModal", "show");
            try {
                FLshowLoading();
                const res = await axios(`/Factor/GetAttachment/${id}?type=11`);
                console.log(res);
                reqAmountAttachment = res.data;
                FileUpReload("reqAmountAttach");
            } catch (err) {
                toastifyError("خطای سرور!");
                console.log(err);
            } finally {
                FLshowLoading(false);
            }
        };


        const cancelReqAmountAttach = () => {
            ModalToggle("reqAmountAttachModal", "hide");
            reqAmountAttachment = [];
            document.getElementById("imageDisplayReqAmountAt").innerHTML = "";
            document.getElementById("reqAmountAttach").value = "";
        };


        const submitReqAmountAttach = async () => {
            if (reqAmountAttachment.every(item => item.isDeleted)) {
                toastifyError("رسید واریزی اجباری است");
                return;
            }
            const model = { listAttach: reqAmountAttachment, id: reqAmountId };
            FLshowLoading();
            try {
                const res = await axios.post("/Amount/AttachAndVosolReqAmount", model);
                if (res.status === 200) {
                    toastifySuccess("ثبت با موفقیت انجام شد");
                    cancelReqAmountAttach();
                    await getAllRequestAmount();
                }
            } catch (err) {
                toastifyError("خطای سرور!");
                console.log(err);
            } finally {
                FLshowLoading(false);
            }
        };


