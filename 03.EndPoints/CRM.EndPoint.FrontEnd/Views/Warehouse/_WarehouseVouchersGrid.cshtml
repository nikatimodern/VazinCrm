@using CRM.Core.Domain.Warehouses.Enums
@model IList<CRM.Core.Domain.Warehouses.Entities.WarehouseVoucher>

@if (Model.Any()) {
    <div class="voucher-grid">
        @foreach (var voucher in Model ?? []) {
            var isNewVoucher = voucher.CreateDate >= DateTime.Now.AddDays(-1);

            var statusClass = voucher.Status switch {
                WarehouseVoucherStatusEnum.در_انتظار_تایید_تامین => "status-pending",
                WarehouseVoucherStatusEnum.در_انتظار_تحویل => "status-delivering",
                WarehouseVoucherStatusEnum.تحویل_شده => "status-completed",
                _ => "status-default"
            };

            <article class="voucher-card">
                <header class="voucher-header">
                    <div class="voucher-title">
                        <span class="voucher-number">#@voucher.VoucherNumber</span>
                        @if (isNewVoucher) {
                            <span class="badge-new-blue" title="ثبت شده در ۲۴ ساعت اخیر">
                                <span class="pulse-dot"></span>
                                جدید
                            </span>
                        }

                        <a class="order-number warehouse-link" asp-controller="Warehouse" asp-action="Index" asp-route-warehouse="@voucher.WarehouseId" asp-route-title="@voucher.Warehouse?.Title">
                            انبار: @voucher.Warehouse?.Title
                        </a>
                        @* <span class="order-number">سفارش: @voucher.OrderCode</span> *@
                    </div>
                    <span class="status-badge voucher-status @statusClass">
                    @voucher.StatusTxt
                </span>
                </header>

                <div class="voucher-body">
                    <div class="meta-row">
                        <span class="meta-item">ثبت کننده: <strong>@voucher.UserCreator</strong></span>
                        <span class="meta-item">تاریخ ثبت: <strong dir="ltr">@(string.Join(" | ", voucher.CreateDateTxt?.Substring(0, 16).Split(' ')))</strong></span>
                    </div>

                    <div class="items-table-wrapper">
                        <table class="items-table">
                            <thead>
                            <tr>
                                <th>محصول</th>
                                <th class="text-end">مقدار</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var item in voucher.WarehouseProductVouchers ?? []) {
                                <tr>
                                    <td>
                                        <span class="item-name">@item.WarehouseProduct.ProductSmallName</span>
                                        @if (!string.IsNullOrEmpty(item.WarehouseProduct.ProductDescription)) {
                                            <span class="item-desc">@item.WarehouseProduct.ProductDescription</span>
                                        }
                                    </td>
                                    <td class="text-end font-bold">@item.Weight.ToString("N0") <small>@item.WarehouseProduct.UnitTxt</small>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>

                <footer class="voucher-footer">
                    <div class="footer-management-actions">
                        @* <span class="items-count">@voucher.WarehouseProductVouchers?.Count قلم</span> *@
                        @if ((User.IsAdmin() || voucher.Warehouse?.IsMain == false) && voucher.Status != WarehouseVoucherStatusEnum.تحویل_شده) {
                            <button type="button" class="btn-icon btn-icon-danger" data-title="حذف" onclick="deleteWarehouseVoucher('@voucher.Id')">
                                <svg style="width: 14px" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M5 3.25V4H2.75a.75.75 0 0 0 0 1.5h.3l.815 8.15A1.5 1.5 0 0 0 5.357 15h5.285a1.5 1.5 0 0 0 1.493-1.35l.815-8.15h.3a.75.75 0 0 0 0-1.5H11v-.75A2.25 2.25 0 0 0 8.75 1h-1.5A2.25 2.25 0 0 0 5 3.25Zm2.25-.75a.75.75 0 0 0-.75.75V4h3v-.75a.75.75 0 0 0-.75-.75h-1.5ZM6.05 6a.75.75 0 0 1 .787.713l.275 5.5a.75.75 0 0 1-1.498.075l-.275-5.5A.75.75 0 0 1 6.05 6Zm3.9 0a.75.75 0 0 1 .712.787l-.275 5.5a.75.75 0 0 1-1.498-.075l.275-5.5a.75.75 0 0 1 .786-.711Z" clip-rule="evenodd" /></svg>
                            </button>

                            <button type="button" class="btn-icon btn-icon-secondary" data-title="ویرایش" onclick="editWarehouseVoucher('@voucher.Id')">
                                <svg style="width: 12px;" viewBox="0 0 512 512"><path fill="currentColor" d="M497.9 142.1l-46.1 46.1c-4.7 4.7-12.3 4.7-17 0l-111-111c-4.7-4.7-4.7-12.3 0-17l46.1-46.1c18.7-18.7 49.1-18.7 67.9 0l60.1 60.1c18.8 18.7 18.8 49.1 0 67.9zM284.2 99.8L21.6 362.4.4 483.9c-2.9 16.4 11.4 30.6 27.8 27.8l121.5-21.3 262.6-262.6c4.7-4.7 4.7-12.3 0-17l-111-111c-4.8-4.7-12.4-4.7-17.1 0zM88 424h48v36.3l-64.5 11.3-31.1-31.1L51.7 376H88v48z"></path></svg>
                            </button>
                        }
                    </div>
                    <div class="footer-actions">

                        @if ((User.IsAdmin() || voucher.Warehouse?.IsMain == false) && (User.IsAdmin() || User.IsTaminAdmin()) && voucher.Status == WarehouseVoucherStatusEnum.در_انتظار_تایید_تامین) {
                            <button type="button" class="btn-action btn-confirm" onclick="confirmWarehouseVoucher('@voucher.Id')">
                                <svg viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M12.416 3.376a.75.75 0 0 1 .208 1.04l-5 7.5a.75.75 0 0 1-1.154.114l-3-3a.75.75 0 0 1 1.06-1.06l2.353 2.353 4.493-6.74a.75.75 0 0 1 1.04-.207Z" clip-rule="evenodd" /></svg>
                                تایید حواله
                            </button>
                        }

                        @if ((User.IsAdmin() || voucher.Warehouse?.IsMain == false) && voucher.Status == WarehouseVoucherStatusEnum.در_انتظار_تحویل) {
                            <button type="button" class="btn-action btn-deliver" onclick="deliverWarehouseVoucher('@voucher.Id')">
                                <i class="fas fa-box-check"></i>
                                @* <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 8.5 12 4 4 8.5v7L12 20l8-4.5v-7ZM12 6.3l5.8 3.2L12 12.7 6.2 9.5 12 6.3Zm-6 4.9 5 2.8v3.7l-5-2.8v-3.7Zm7 6.5V14l5-2.8v3.7l-5 2.8Z" /></svg> *@
                                تحویل شد
                            </button>
                        }
                        <a class="btn-action btn-view" asp-action="VoucherDetail" asp-controller="Warehouse" asp-route-id="@voucher.Id">
                            <svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 9.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z" /><path fill-rule="evenodd" d="M1.38 8.28a.87.87 0 0 1 0-.566 7.003 7.003 0 0 1 13.238.006.87.87 0 0 1 0 .566A7.003 7.003 0 0 1 1.379 8.28ZM11 8a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" clip-rule="evenodd" /></svg>
                            مشاهده
                        </a>


                        @* <button class="btn-action" onclick="printVoucher('@voucher.Id')">چاپ</button> *@
                    </div>
                </footer>
            </article>
        }
    </div>
} else {
    <div class="voucher-noResults">
        هیچ حواله‌ای یافت نشد.
    </div>
}
