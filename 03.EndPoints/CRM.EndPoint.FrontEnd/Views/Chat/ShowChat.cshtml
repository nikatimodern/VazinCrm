@model CRM.Core.Domain.Chats.Entities.MainChat

<div class="chat-page">
    <div class="chat-header">
        <div class="me-1 d-flex d-md-none align-items-center justify-content-center cursor-pointer" style="position: absolute;right: 4px" id="back-chatList" onclick="backChatList()">
            <svg style="width: 20px" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" /></svg>
        </div>
        <span class="fMedium">@(ViewBag.FromUserId == Model.ToUserId ? Model.FromUserTxt : Model.ToUserTxt)</span>
    </div>
    <div class="chat-body">
        <div class="chat-messages" id="chatWrapper">
            @if (Model.Chats != null) {
                foreach (var item in Model.Chats) {
                    var isChatFromCurrentUser = item.UserCreatorID == ViewBag.FromUserId;
                    <div class="report-wrapper @(isChatFromCurrentUser ? "" : "flex-row-reverse")">
                        <img class="reporter-image" src="@(string.IsNullOrEmpty(item.UserImage) ? "/Img/User.png" : item.UserImage)" />

                        <div class="report-box w-auto overflow-hidden @(isChatFromCurrentUser ? "bgLightBlue" : "bg-white")" style="max-width: 80%" data-chat-id="@item.Id" data-chat-text="@item.Text" data-chat-file="@item.FileAddress">
                            <span class="reporter-name @(isChatFromCurrentUser ? "" : "text-end")">@item.UserCreator</span>
                            @*<div class="d-flex align-items-center mb-2">
                                <p class="report-text mb-0" style="white-space: break-spaces;word-wrap: anywhere">@item.Text?.Trim()</p>
                                @if (item.FileAddress != null) {
                                    <span style="color: blue">
                                        <a href="@item.FileAddress" download>دانلود</a>
                                    </span>
                                }
                            </div>*@
                            <div class="report-content">
                                @if (item.FileAddress != null) {
                                    var fileExten = System.IO.Path.GetExtension(item.FileAddress);
                                    fileExten = !string.IsNullOrEmpty(fileExten) ? fileExten.TrimStart('.').ToUpper() : null;
                                    var caption = !string.IsNullOrEmpty(item.FileSize) ? $"{item.FileSize} {fileExten}" : "برای دانلود کلیک کنید";

                                    <div class="chat-file-box">
                                        <div class="chat-file-info">
                                            <div class="chat-file-name">@item.FileName</div>
                                            <div class="chat-file-caption">@caption</div>
                                        </div>
                                        <a href="@item.FileAddress" download="@item.FileName" class="chat-file-icon">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v2.625a2.625 2.625 0 0 1-2.625 2.625H7.125A2.625 2.625 0 0 1 4.5 16.875V14.25" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v11.25" /><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 10.5 3.75 3.75 3.75-3.75" /></svg>
                                        </a>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.Text)) {
                                    <p class="report-text mb-0">@item.Text</p>
                                }
                            </div>

                            <div class="d-flex justify-content-between align-items-end gap-1 gap-md-4 @(isChatFromCurrentUser ? "" : "flex-row-reverse")">
                                <div class="report-info align-items-center column-gap-2">
                                    @if (isChatFromCurrentUser) {
                                        if (item.Read) {
                                            <svg class="db-check-icon" style="width: 20px;color: #18a1ff" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M7 12l5 5l10 -10" /><path d="M2 12l5 5m5 -5l5 -5" /></svg>
                                        } else {
                                            <svg class="check-icon" style="width: 20px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M5 12l5 5l10 -10" /></svg>
                                        }
                                    }
                                    <span class="@(isChatFromCurrentUser ? "direction-ltr" : "")">@string.Join(" | ", item.CreateDateTxt?[..16]?.Split(' '))</span>
                                </div>
                                @if (isChatFromCurrentUser) {
                                    <div class="d-flex align-items-center gap-2 align-self-end" style="position:relative">
                                        <div class="task-dropdown__toggle flex-center cursor-pointer" tabindex="0">
                                            <svg style="width:18px;height:18px" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5ZM12 12.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5ZM12 18.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5Z" /></svg>
                                        </div>
                                        <div class="task-dropdown">
                                            <div class="task-dropdown__item itemGray" onclick="editChat('@item.Id', this)">
                                                <svg style="width:16px;height:16px" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" /></svg>
                                                <span>ویرایش</span>
                                            </div>

                                            <div class="task-dropdown__item itemRed" style="color:darkred" onclick="deleteChat('@item.Id')">
                                                <svg style="width:16px;height:16px" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
                                                <span>حذف</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            } else {
                <div style="color: #777">هیچ پیامی یافت نشد.</div>
            }
        </div>

        <div id="chatInputWrapper" class="chat-input-area">
            <div id="chatAttachPreview"></div>
            <div class="position-relative">
                <textarea id="chatInput" class="form-control" placeholder="پیام..."></textarea>
                <input type="file" id="chatAttachInput" onchange="handleChatAttach(this)" accept="*">
                <label for="chatAttachInput" class="chat-attach-btn">
                    <i style="font-size: 16px" class="mp fa fa-paperclip"></i>
                </label>
                <button id="chatSendBtn" onclick="sendChat()">
                    <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="m9 12.75 3 3m0 0 3-3m-3 3v-7.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                </button>
            </div>
        </div>


    </div>
</div>
