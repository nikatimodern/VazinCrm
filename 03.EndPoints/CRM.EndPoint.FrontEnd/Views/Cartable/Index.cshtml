@section scripts {

    <script>
        let targetUserId;
        var smsSendedPfId;
        let f_type = 0;

        let filConfigSession = null;

        let pfType = 0;//ریدیو باتن پیش فاکتور
        let fType = 0;//ریدیو باتن فاکتور

        let fromWarning = false;
        document.addEventListener("UserLoginReady", () => {
            const rols = JSON.parse(sessionStorage.getItem("Rols")) || [];
            rols.forEach(item => ShowActiveCartable(item.name));
        });

        document.addEventListener("DOMContentLoaded", async () => {
            showTaminDropdown();

            //////////////////////preFactor//////////////////////
            const searchPfElm = document.getElementById("searchId");
            searchPfElm.addEventListener("keyup", async (e) => {
                if (e.key === "Enter") {
                    await GetPreFactorPartial(e.target.value, modelPreFactor._type, modelPreFactor.filt);
                }
            });
            searchPfElm.nextElementSibling.addEventListener("click", async () =>
                await GetPreFactorPartial(searchPfElm.value, modelPreFactor._type, modelPreFactor.filt),
            );

            document.querySelectorAll("#allPreFactorTab-pane [name='financeFilter']").forEach(elm => {
                elm.addEventListener("change", async (e) => {
                    pfType = +e.target.value;
                    await GetPreFactorPartial(modelPreFactor.serVal, e.target.value, modelPreFactor.filt);
                });
            });

            //////////////////////factor//////////////////////
            const searchFElm = document.getElementById("f_searchId");
            searchFElm.addEventListener("keyup", async (e) => {
                if (e.key === "Enter") {
                    //document.getElementById('HideFactorPartialId').style.display = 'none';
                    await GetFactorPartial(e.target.value, null, null, modelFactor.filt, modelFactor._type);
                }
            });
            searchFElm.nextElementSibling.addEventListener("click", async () =>
                await GetFactorPartial(searchFElm.value, null, null, modelFactor.filt, modelFactor._type),
            );

            document.querySelectorAll("#allFactorTab-pane [name='f_type']").forEach(elm => {
                elm.addEventListener("change", async (e) => {
                    fType = +e.target.value;
                    await GetFactorPartial(modelFactor.serVal, modelFactor.EntityId, null, modelFactor.filt, e.target.value);
                });
            });

            //////////////////////saleAdmin//////////////////////
            const searchSaleAdminElm = document.getElementById("SalesAdminSearchId");
            searchSaleAdminElm.addEventListener("keyup", async (e) => {
                if (e.key === "Enter") {
                    await GetPreFactorSalesAdmin();
                }
            });
            searchSaleAdminElm.nextElementSibling.addEventListener("click", async () => await GetPreFactorSalesAdmin());

            const salesAdminFilterRadios = document.querySelectorAll("input[type='radio'][name='SalesAdminFilter']");
            salesAdminFilterRadios.forEach(elm => elm.addEventListener("change", async () => await GetPreFactorSalesAdmin()));

            //////////////////////tamin//////////////////////
            const searchTaminElm = document.getElementById("TSearchId");
            searchTaminElm.addEventListener("keyup", async (e) => {
                if (e.key === "Enter") {
                    await GetPreFactorTaminExpert();
                }
            });
            searchTaminElm.nextElementSibling.addEventListener("click", async () => await GetPreFactorTaminExpert());

            const taminFilterRadios = document.querySelectorAll("input[type='radio'][name='TFilter']");
            taminFilterRadios.forEach(elm => elm.addEventListener("change", async () => await GetPreFactorTaminExpert()));


            //////////////////////financial pf//////////////////////
            const searchFinancialPfElm = document.getElementById("FinancialExpertSearchId");
            searchFinancialPfElm.addEventListener("keyup", async (e) => {
                if (e.key === "Enter") {
                    await GetPreFactorFinancialExpert();
                }
            });
            searchFinancialPfElm.nextElementSibling.addEventListener("click", async () => await GetPreFactorFinancialExpert());

            const financialFilterRadios = document.querySelectorAll("input[type='radio'][name='financialExpertFilter']");
            financialFilterRadios.forEach(elm => elm.addEventListener("change", async () => await GetPreFactorFinancialExpert()));

            //////////////////////financial inv//////////////////////
            const searchFinancialInvElm = document.getElementById("FinancialExpertInvoiceSearchId");
            searchFinancialInvElm.addEventListener("keyup", async (e) => {
                if (e.key === "Enter") {
                    await GetInvoicesFinancialExpert();
                }
            });
            searchFinancialInvElm.nextElementSibling.addEventListener("click", async () => await GetInvoicesFinancialExpert());

            const financialInvoiceFilterRadios = document.querySelectorAll("input[type='radio'][name='financialExpertInvoiceFilter']");
            financialInvoiceFilterRadios.forEach(elm => elm.addEventListener("change", async () => await GetInvoicesFinancialExpert()));


            //////////////////////financial req//////////////////////
            const searchFinancialReqElm = document.getElementById("FinancialRequestSearchId");
            searchFinancialReqElm.addEventListener("keyup", async (e) => {
                if (e.key === "Enter") {
                    await GetRequestFinancialExpert();
                }
            });
            searchFinancialReqElm.nextElementSibling.addEventListener("click", async () => await GetRequestFinancialExpert());

            const financialRequestAmountRadios = document.querySelectorAll("input[type='radio'][name='FinancialRequestFilter']");
            financialRequestAmountRadios.forEach(elm => elm.addEventListener("change", async () => await GetRequestFinancialExpert()));


            //////////////////////MD inv//////////////////////
            const searchMDInvElm = document.getElementById("ManagingDirectorSearchId");
            searchMDInvElm.addEventListener("keyup", async (e) => {
                if (e.key === "Enter") {
                    await GetInvoicesManagingDirector();
                }
            });
            searchMDInvElm.nextElementSibling.addEventListener("click", async () => await GetInvoicesManagingDirector());

            const managingFilterRadios = document.querySelectorAll("input[type='radio'][name='managingDirectorFilter']");
            managingFilterRadios.forEach(elm => elm.addEventListener("change", async () => await GetInvoicesManagingDirector()));

            //////////////////////MD req//////////////////////
            const searchMDReqElm = document.getElementById("MDRequestAmountSearchId");
            searchMDReqElm.addEventListener("keyup", async (e) => {
                if (e.key === "Enter") {
                    await GetRequestManagingDirector();
                }
            });
            searchMDReqElm.nextElementSibling.addEventListener("click", async () => await GetRequestManagingDirector());

            const MDRequestAmountRadios = document.querySelectorAll("input[type='radio'][name='MDRequestAmountFilter']");
            MDRequestAmountRadios.forEach(elm => elm.addEventListener("change", async () => await GetRequestManagingDirector()));

            //////////////////////////////////////////////////

            const fFilterFromDash = JSON.parse(sessionStorage.getItem("fFilterFromDash"));
            if (fFilterFromDash) {
                sessionStorage.removeItem("fFilterFromDash");
                filConfigSession = {
                    ContentFilterDiv: "f_ContentFilterId",
                    filterCallBack: "CbFFilter",
                    txtSercheId: "f_searchId",
                    varSearch: "",
                    filterVar: {
                        ...fFilterFromDash.filt,

                    },
                    filterVarConfig: "varList2",
                };
            }

            const warningDetailsObj = JSON.parse(localStorage.getItem("warningDetails"));
            if (warningDetailsObj) {
                fromWarning = true;
                localStorage.removeItem("warningDetails");
                await showPrefac(warningDetailsObj.pFactorSerialNumber.toString());
                await showFac(warningDetailsObj.factorSerialNumber.toString());
            }


            //const tabId = location.hash?.split("=")[1];
            const { tab = "TPrefactorFactorId", sub } = getUrlParams();
            if (document.getElementById(tab)) {
                GetCartable(tab, sub);
            }

        });

        const CarPfExportExcel = () => {
            $("#FLshowLoading").css("display", "");

            const model = {};
            model.serVal = CartablePfSearchVal;
            model._type = pfType;

            if (window[filterVarConfig] != null)
                model.filt = window[filterVarConfig].filterVar;
            else
                model.filt = null;

            fetch("/Cartable/PrefactorExportToExcel", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify(model),


            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! Status: ${response.status}`);
                    } else {
                        $("#FLshowLoading").css("display", "none");
                        return response.blob(); // تبدیل پاسخ به Blob

                    }
                })
                .then(blob => {
                    const url = window.URL.createObjectURL(blob); // ایجاد URL برای Blob
