@section Scripts {
    <script>
        let modelDeal = { filt: null, serVal: null };
        var filterDealConfig = {};
        var dealSearchVal = null;
        let currentDealData = {};
        let isEditMode = false;
        let selectTomCustomers;


        document.addEventListener("DOMContentLoaded", async () => {
            FLshowLoading();

            removeDealsTabsDesktop();
            initSortableDeal();
            showDealDropdown();
            getAllOrders();

            await showTaminDropdown();
            await getAllDeals();

            FLshowLoading(false);

            const searchDealElm = document.getElementById("dealSearchId");
            searchDealElm.addEventListener("keyup", async (e) => {
                if (e.key === "Enter") {
                    modelDeal.serVal = e.target.value.trim();
                    await getAllDeals();
                }
            });
            searchDealElm.nextElementSibling.addEventListener("click", async (e) => {
                modelDeal.serVal = searchDealElm.value.trim();
                await getAllDeals();
            });
        });

        let openDealDropdownToggle = null;
        function showDealDropdown() {
            document.getElementById("allDealsContainer").addEventListener("click", function (e) {
                const clickedToggle = e.target.closest(".deal-dropdown__toggle");
                if (clickedToggle) {
                    if (openDealDropdownToggle && openDealDropdownToggle !== clickedToggle && openDealDropdownToggle.dropdownInstance && openDealDropdownToggle.dropdownInstance.isOpen) {
                        openDealDropdownToggle.dropdownInstance.close();
                        openDealDropdownToggle = null;
                    }

                    if (!clickedToggle.dropdownInstance) {
                        const currentDropdown = clickedToggle.nextElementSibling;
                        clickedToggle.dropdownInstance = new Dropdown({
                            button: clickedToggle,
                            content: currentDropdown,
                            transitionDuration: 200,
                            originalDisplay: "flex",
                            effect: "zoom",
                        });
                    }
                    clickedToggle.dropdownInstance.toggle();

                    openDealDropdownToggle = clickedToggle.dropdownInstance.isOpen ? clickedToggle : null;
                } else {
                    if (openDealDropdownToggle && openDealDropdownToggle.dropdownInstance && openDealDropdownToggle.dropdownInstance.isOpen) {
                        openDealDropdownToggle.dropdownInstance.close();
                        openDealDropdownToggle = null;
                    }
                }
            });
        }

        const deleteDeal = (id) => {
            openDealDropdownToggle.dropdownInstance.close();
            Swal.fire({
                title: "حذف!",
                text: "آیا مطمئن هستید که میخواهید حذف کنید؟",
                icon: "warning",
                showCancelButton: true,
                cancelButtonColor: "#adadad",
                confirmButtonColor: "#e64942",
                cancelButtonText: "انصراف",
                confirmButtonText: "بله، حذف شود",
            }).then((willDelete) => {
                if (willDelete.isConfirmed)
                    deleteDealOk(id);
            });
        };

        async function deleteDealOk(id) {
            try {
                FLshowLoading();
                const res = await axios(`/Deal/DeleteDeal?id=${id}`);

                if (res.status === 200) {
                    await getAllDeals();
                    toastifySuccess("سفارش با موفقیت حذف شد.");
                    FLshowLoading(false);
                }
            } catch {
                setTimeout(async () => await deleteDealOk(id), 3000);
                toastifyError("خطای سرور!");
            }
        }

        async function callbackFilterDeal() {
            modelDeal.filt = window[filterVarConfig].filterVar;
            modelDeal.serVal = window[filterVarConfig].varSearch;

            await getAllDeals();
        }

        const getAllDeals = async () => {
            try {
                FLshowLoading();
                const res = await axios.post(`/Deal/GetAllDeals`, modelDeal);
                if (res.status === 200) {
                    const items = res.data.items;
                    if (window.innerWidth < 1200) {
                        updateTabSwitchState({
                            wrapperSelector: "#dealTabs",
                            tabData: items,
                            searchValue: modelDeal.serVal,
                            filter: modelDeal.filt,
                        });
                    }
                    createDomAllDeals(items.open, "#openDealsContainerId", res.data.isAdmin);
                    createDomAllDeals(items.success, "#successDealsContainerId", res.data.isAdmin);
                    createDomAllDeals(items.failed, "#failedDealsContainerId", res.data.isAdmin);
                    FLshowLoading(false);
                }
            } catch (err) {
                console.log(err);
            }
