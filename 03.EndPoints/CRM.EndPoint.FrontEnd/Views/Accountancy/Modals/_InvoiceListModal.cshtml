<!-- Modal ListInvoice -->
<div class="modal fade" id="InvoiceListModalId" tabindex="-1" data-bs-focus="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content col-12" style="padding:10px!important">
            <div class="d-flex justify-content-center position-relative" style="margin-bottom:10px;background-color:var(--DarkColor);color:white;border-radius:5px">
                <label class="fbold text-center" style="padding:5px; font-size:16px;" id="TitleListInvoiceId">لیست پرداختی ها</label>
                <div data-bs-theme="dark" class="d-flex align-items-center justify-content-center top-0 bottom-0" style="position: absolute;left: 6px">
                    <button type="button" class="btn-close opacity-100" data-bs-dismiss="modal"></button>
                </div>
            </div>
            <div class="modal-body p-0" style=" display:flex;flex-direction:column; justify-content:space-between; width:100% !important;">
                <div id="addInvoiceBtns" class="d-flex justify-content-center align-items-center gap-2 pb-2">
                    <button class="buttonGreen0 deposit-btn py-1 d-flex align-items-center gap-2" onclick="ShowModalAddInvoice(1)">
                        واریزی
                        <svg style="width:14px;height:14px" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                    </button>
                    <button class="buttonCancel2 Admin FinancialExpert FinancialAdmin backward-btn py-1 align-items-center gap-2" style="background-color: #750002;display: none" onclick="ShowModalInvoice(2)">
                        برگشتی
                        <svg style="width:14px;height:14px" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14" /></svg>
                    </button>
                </div>
                <div class="p-2 pt-0 w-100" id="PayContentId"></div>

                <div style="margin:10px auto; width:98%; height:2px; background-color:rgba(0, 0,0,0.4);"></div>

                <div id="PayContentSumId" style="display:flex; flex-wrap:wrap; width:100%;  justify-content:space-between;"></div>

                <div style="margin:10px auto; width:97%; height:2px; background-color:var(--DarkColor);"></div>

                <div class="gap-2" style="width:100%; display:flex;justify-content:center">
                    @* <button class="buttonCancel2" data-bs-dismiss="modal">انصراف</button> *@
                    <button id="changeStatusAllAccBtn" class="buttonGreen3 d-none" onclick="changeStatusAllAcc()">ارسال همه به مالی</button>
                    <button id="acceptFinancialBtn" class="buttonGreen3 d-none">تایید پیش‌فاکتور</button>
                    <button id="notAcceptFinancialBtn" class="buttonGray2 d-none">عدم تایید پیش‌فاکتور</button>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="~/Views/Accountancy/Modals/_InvoiceModal.cshtml" />
<partial name="Modals/_NotAcceptModal" />