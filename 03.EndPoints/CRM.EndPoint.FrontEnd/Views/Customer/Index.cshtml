@model AppUser

@section Styles {
    <link rel="stylesheet" href="~/css/customerIndex.css?v=6.8.9" />
}

<div class="mp" style="align-items:center; flex-direction:column; width:100% ; display:flex;margin-top:0 !important">
    <div class="w-100">
        <div class="d-flex flex-column flex-wrap flex-lg-row gap-3 align-items-center justify-content-center mt-md-2">
            @if (Model.NormalizedUserName is "R.SALAMI" or "ADMIN") {
                <div id="AddCustBtnID">
                    <button class="buttonGreen1 gap-2" onclick="showFormCustomer()" id="btnNew">
                        <i class="fa fa-user" style="font-size:14px;" aria-hidden="true"></i>
                        ثبت جدید
                    </button>
                    <button class="buttonCancel2" onclick="hideFormCustomer()" id="btnCancel" style="display:none;padding: 8px 16px;border-radius: 50px;line-height: 1;">انصراف</button>
                </div>
            }
            <div id="searchCustomerWrapper" class="col-12 col-lg-7 flex-center">
                <div class="search-group">
                    <input class="form-control form-control-lg" id="SearchInp" type="text" placeholder="جستجو برحسب (نام مشتری ، کد مشتری)" />
                    <div class="search-icon" style="padding-inline: 8px">
                        <svg style="width: 22px" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z" clip-rule="evenodd" /></svg>
                    </div>
                </div>
            </div>
            <div id="roleTypeRadios" class="flex-center flex-wrap gap-2">
                @if (User.IsAdmin() || User.IsSalesAdmin() || User.IsTamin() || User.IsFinancial()) {
                    <ul class="filter-switch filter-switch-sm">
                        <li class="filter-switch-item">
                            <input type="radio" name="roleTypeChange" value="-1" id="roleType-all">
                            <label for="roleType-all">همه</label>
                        </li>
                        <li class="filter-switch-item">
                            <input type="radio" name="roleTypeChange" value="1" id="roleType-customer">
                            <label for="roleType-customer">مشتری</label>
                        </li>
                        <li class="filter-switch-item">
                            <input type="radio" name="roleTypeChange" value="2" id="roleType-supplier">
                            <label for="roleType-supplier">تامین کننده</label>
                        </li>
                    </ul>
                }
                <ul class="filter-switch filter-switch-sm">
                    <li class="filter-switch-item">
                        <input type="radio" name="juridicalChange" value="-1" id="juridical-all">
                        <label for="juridical-all">همه</label>
                    </li>
                    <li class="filter-switch-item">
                        <input type="radio" name="juridicalChange" value="1" id="juridical-1">
                        <label for="juridical-1">حقوقی</label>
                    </li>
                    <li class="filter-switch-item">
                        <input type="radio" name="juridicalChange" value="0" id="juridical-0">
                        <label for="juridical-0">حقیقی</label>
                    </li>
                </ul>
            </div>
        </div>

        <partial name="_FormAddCustomerPartial" />

        <div class="mt-3 mt-md-4 pt-md-2" style=" width:100%; display:flex;flex-direction:column;position:relative" id="CuParId">
            <span id="LoadingCusPartId" class="customer-loading-status" role="status" aria-live="polite">در حال دریافت مشتریان</span>
            <div style="max-height: calc(100dvh - 210px); overflow-y: auto; padding-bottom: 10px;">
                <div id="CustomerPartial" aria-busy="true" class="parent px-2 px-md-0 col-sm-8 offset-sm-2 col-lg-12 offset-lg-0" style="display: grid; gap: 1rem;">
                    @for (var card = 0; card < 3; card++) { <partial name="_CustomerSkeleton" /> }
                </div>
                <div id="btnShowAllId" style="display: none; justify-content: center; margin-top: 1rem;">
                    <button onclick="ShowAllCustomer()" class="buttonGreen1 p-0" style="width: 36px; height: 36px;border-radius: 50%;">
                        <svg style="width: 20px" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" /></svg>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="Modals/_AlertCustomerRegisterModal" />
<partial name="Modals/_UpdateCustomerModal" />
<template id="customerSkeletonTemplate"><partial name="_CustomerSkeleton" /></template>

@section Scripts {
    <script src="~/js/customer/customer.js?release=6.9.6" data-page-bindings="JuridicalFlag,CurrentStep,allStep,flagStep1,flagStep2,flagStep3,SearchInp,LoadingCustomer,ShowAllBtn,getCountOfCustomerPartialTop,skipCus,takeCus,customerListRequest,ShowAllCustomer,readCustomerCards,loadCustomers,SearchAllCustomer,getAllCustomers,addToMyCustomer,opLoaded,showFormCustomer,hideFormCustomer,backStep,nextStep,gotoStep,showDivStep,hideDivSteps,changeForm,checkDuplicate,submitFormCustomerBase,abortCustomer,acceptCustomer,senfLoaded,ShowModalUpCustomer,SubmitUpFormCustomer,closeModalUpdate,GetSenfOp,GetAcquaintanceWayOp,GetUpSenfOp,initBaseItemSelect" asp-append-version="true"></script>
}



