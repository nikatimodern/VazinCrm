<!-- Modal Invoice -->
<div class="modal fade invoice-modal" id="InvoiceModalId" tabindex="-1" role="dialog" data-bs-focus="false" data-bs-backdrop="static" aria-labelledby="invoiceModalTitle">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content col-12 invoice-dialog-content">
            <div class="modalHeader-invoice" id="invoiceModalTitle" role="heading" aria-level="2"></div>
            <div class="modal-body invoice-dialog-body">
                <div class="modalContent-invoice">
                    <form id="PayFactorFormId" class="d-flex flex-column w-100 gap-3">
                        <div id="invoiceTypeBoxId" class="sectionBox-invoice invoice-dialog-section">
                            <span class="sectionTitle-invoice">روش پرداخت</span>
                            <div class="invoice-payment-options" role="group" aria-label="روش پرداخت">

                                <label class="invoice-payment-option" for="NagdiId">
                                    <input class="form-check-input valueNumber" type="radio" name="payType" id="NagdiId" value="1" checked>
                                    <span>نقدی</span>
                                </label>

                                <label class="invoice-payment-option" for="ChekiId">
                                    <input class="form-check-input valueNumber" type="radio" name="payType" id="ChekiId" value="2">
                                    <span>چکی</span>
                                </label>

                                <label class="invoice-payment-option" id="DivEtebariId" for="EtebariId">
                                    <input class="form-check-input valueNumber" type="radio" name="payType" id="EtebariId" value="3">
                                    <span>اعتباری</span>
                                </label>

                                <label class="invoice-payment-option" for="TahatoriId">
                                    <input class="form-check-input valueNumber" type="radio" name="payType" id="TahatoriId" value="4">
                                    <span>تهاتری</span>
                                </label>

                                @*<div class="form-check form-check-inline me-0 d-none" id="TransferRadioWrapper">
                                    <input class="form-check-input valueNumber" type="radio" name="payType" id="TransferRadioId" value="6">
                                    <label class="form-check-label" for="TransferRadioId">انتقال</label>
                                </div>*@
                            </div>
                        </div>

                        <div class="beneficiaryWrapper d-none sectionBox-invoice invoice-dialog-section">
                            <span class="sectionTitle-invoice">بابت بدهی به</span>
                            <div>
                                <input class="form-control" name="beneficiary" type="text" placeholder="بابت بدهی به" />
                            </div>
                        </div>

                        <div class="transactionBankBox sectionBox-invoice invoice-dialog-section">
                            <span class="sectionTitle-invoice">اطلاعات تراکنش بانکی</span>
                            <div class="invoice-transaction-fields">
                                <div class="ReceiveDateDiv invoice-field d-none">
                                    <label>تاریخ دریافت چک از مشتری</label>
                                    <input class="sdate form-control" name="reciveDate" type="text" placeholder="ثبت تاریخ" data-mask-date required autocomplete="off"/>
                                </div>

                                <div class="transactionAmountWrapper invoice-field">
                                    <label>مبلغ (ریال)</label>
                                    <input inputmode="numeric" class="currencyNumber form-control inpAmount" name="reciveAmount" type="text" placeholder="مبلغ دریافتی به ریال" required data-currency-hint="next" />
                                    <span class="currencyHint"></span>
                                </div>

                                <div class="VosolDateDiv invoice-field">
                                    <label>تاریخ واریزی</label>
                                    <input class="sdate form-control" name="vosolDate" type="text" placeholder="تاریخ پرداخت" data-mask-date required autocomplete="off" />
                                </div>
                            </div>

                            <div class="toBankAccountWrapperSelect invoice-field">
                                <label>واریز به حساب بانکی</label>
                                <select class="form-select" name="bankAccountId" required></select>
                            </div>

                            <div class="toBankAccountWrapperTxt invoice-field d-none">
                                <label>واریز به حساب بانکی</label>
                                <input class="form-control" name="bankAccountTxt" type="text" placeholder="به کدام (حساب / شبا / کارت) واریز شده است." />
                            </div>

                            <div class="toNameWrapper invoice-field d-none">
                                <label>واریز به نام</label>
                                <input class="form-control" name="toName" type="text" placeholder="نام صاحب حساب واریز شده" />
                            </div>
                        </div>

                    </form>

                    <div class="sanadPayBox sectionBox-invoice invoice-dialog-section">
                        <span class="sectionTitle-invoice">رسید پرداخت</span>
                        <div class="container-uploader invoice-receipt-upload" id="SanadParId">
                            <input type="file" class="uploadBtn" data-varList="SanadPayList" data-showList="DivShowSanadPar" id="upSanadPay" accept="*/*" required />
                            <label for="upSanadPay">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" /></svg>
                                <span>تصویر رسید را انتخاب کنید یا اینجا رها کنید</span>
                            </label>
                            <div class="image-display" id="DivShowSanadPar"></div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer invoice-dialog-footer">
                <button type="button" class="buttonCancel2 invoice-cancel-button" onclick="closeModalInvoice()">انصراف</button>
                <button type="button" class="buttonGreen3 invoice-submit-button" onclick="submitInvoice()">ثبت</button>
            </div>
        </div>
    </div>
</div>

