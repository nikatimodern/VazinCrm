@model CRM.EndPoint.FrontEnd.Models.Warehouse.WarehousePageVModel
@{
    Layout = "_Layout";
    var hasWarehouseId = Context.Request.Query.ContainsKey("warehouse");
}

<div>
    <div id="warehouses-section" class="@(hasWarehouseId ? "d-none" : "")">
        <div class="d-flex align-items-center gap-2 mb-3">
            <span class="section-title-dot" style="background-color: var(--warehouse-primary);"></span>
            <h5 class="fbold text-dark m-0">@(Model.IsManager ? "انبار ها" : "انبار های من")</h5>
        </div>

        <div id="warehousesContainer">
            <partial name="GetAllWarehousesPartial" model="Model" />
        </div>
    </div>

    <div id="warehouseProducts-section" data-is-senior-manager="@User.IsAdmin().ToString().ToLowerInvariant()" class="@(hasWarehouseId ? "" : "d-none")">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div class="d-flex align-items-center gap-2">
                <span class="section-title-dot" style="background-color: #01504b"></span>
                <h5 id="selected-warehouse-title" class="fbold text-dark m-0"></h5>
            </div>

            <div class="section-actions d-flex gap-2 flex-grow-1 justify-content-end">
                <button id="warehouseProductBtn" class="buttonGreen0 d-none" onclick="showWarehouseTransactionModal(1)">
                    ثبت محصول جدید
                    <svg style="width: 18px" viewBox="0 0 20 20" fill="currentColor"><path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" /></svg>
                </button>

                <button id="groupSelectWarehouseProductBtn" class="buttonBlue d-none">
                    ثبت حواله انبار
                    <svg style="width: 18px" viewBox="0 0 20 20" fill="currentColor"><path d="M9.25 13.25a.75.75 0 0 0 1.5 0V4.636l2.955 3.129a.75.75 0 0 0 1.09-1.03l-4.25-4.5a.75.75 0 0 0-1.09 0l-4.25 4.5a.75.75 0 1 0 1.09 1.03L9.25 4.636v8.614Z"></path><path d="M3.5 12.75a.75.75 0 0 0-1.5 0v2.5A2.75 2.75 0 0 0 4.75 18h10.5A2.75 2.75 0 0 0 18 15.25v-2.5a.75.75 0 0 0-1.5 0v2.5c0 .69-.56 1.25-1.25 1.25H4.75c-.69 0-1.25-.56-1.25-1.25v-2.5Z"></path></svg>
                </button>

                <button class="buttonCancel-white" onclick="backToWarehouses()">
                    بازگشت
                    <svg style="width: 16px" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M3.5 9.75A2.75 2.75 0 0 1 6.25 7h5.19L9.22 9.22a.75.75 0 1 0 1.06 1.06l3.5-3.5a.75.75 0 0 0 0-1.06l-3.5-3.5a.75.75 0 1 0-1.06 1.06l2.22 2.22H6.25a4.25 4.25 0 0 0 0 8.5h1a.75.75 0 0 0 0-1.5h-1A2.75 2.75 0 0 1 3.5 9.75Z" clip-rule="evenodd" /></svg>
                </button>
            </div>
        </div>
        <p id="warehouseSystemNotice" class="text-muted small d-none">گردش این انبار سیستمی است؛ عملیات دستی فقط برای مدیر ارشد مجاز است.</p>
        <div id="warehouseSelectionToolbar" class="selection-bar d-none mb-2">
            <div class="d-none d-lg-flex align-items-center gap-3">
                <label class="d-flex align-items-center gap-3">
                    <input type="checkbox" class="select-all" />
                    <span>انتخاب همه</span>
                </label>
            </div>

            <div class="col-12 col-lg-auto flex-center flex-wrap gap-3" style="color: #444">
                <span class="selected-count fbold" style="color: var(--color8)">0</span>
                <span>مورد انتخاب شده</span>

                <button class="clear-selection link-green" style="font-size: 13px">
                    حذف انتخاب
                </button>
            </div>

            <div class="col-12 col-lg-auto d-flex align-items-center justify-content-between justify-content-lg-end gap-3">
                <button class="cancel-selection buttonCancel-white">
                    <svg style="width: 16px" viewBox="0 0 20 20" fill="currentColor"><path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" /></svg>
                    انصراف
                </button>

                <button class="selection-action-btn buttonGreen0" disabled>
                    ثبت همه (<span class="selected-count">0</span>)
                </button>
            </div>
        </div>

        <div>
            <table id="warehouseProductsTable" class="table table-hover table-bordered table-striped nowrap">
                <thead>
                <tr>
                    <th>محصول</th>
                    <th>شرح محصول</th>
                    <th>موجودی</th>
                    <th>واحد</th>
                    <th>ثبت شده توسط</th>
                    <th>عملیات</th>
                </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>

        <hr />

        <section class="warehouse-vouchers-section my-4">

            <div class="section-divider"></div>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="section-title-dot" style="background-color: var(--warehouse-primary)"></span>

                    <div>
                        <h5 class="fbold text-dark m-0">حواله‌های انبار</h5>
                        <small class="text-muted">آخرین حواله‌های ثبت شده در این انبار</small>
                    </div>
                </div>
                <button onclick="showWarehouseVouchersPage()" id="viewAllWarehouseVouchers" class="btn-action btn-view">
                    مشاهده همه حواله‌ها
                    <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.22 14.78a.75.75 0 0 0 1.06 0l4.25-4.25a.75.75 0 0 0 0-1.06l-4.25-4.25a.75.75 0 1 0-1.06 1.06L10.78 10l-3.56 3.72a.75.75 0 0 0 0 1.06Z" clip-rule="evenodd" /></svg>
                </button>
            </div>

            <div id="lastWarehouseVouchersGrid">
            </div>

        </section>
    </div>
</div>


<partial name="Modals/_WarehouseModal" />
<partial name="Modals/_WarehouseTransactionModal" />
<partial name="Modals/_WarehouseTransactionHistoryModal" />
<partial name="Modals/_WarehouseProductModal" />
<partial name="Modals/_WarehouseVoucherModal" />

@section Styles {
    <link rel="stylesheet" href="~/css/warehouse.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/warehouse/warehouse.js" asp-append-version="true"></script>
    <script src="~/js/warehouse/warehouse-voucher.js" asp-append-version="true"></script>
}

