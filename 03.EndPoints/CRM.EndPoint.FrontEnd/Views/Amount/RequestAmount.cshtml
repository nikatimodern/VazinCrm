@{
    Layout = "_Layout";
}

<div class="w-100">
    <div class="d-flex align-items-center justify-content-between flex-wrap mb-3 gap-2">
        <div class="d-flex align-content-center gap-2 col-lg-3">
            <button class="buttonGray2 d-flex align-items-center gap-1" style="padding: 4px 8px" onclick="showRequestAmountModal()">
                <span style="line-height: 1">ثبت درخواست جدید</span>
                <svg style="width: 20px" viewBox="0 0 20 20" fill="currentColor"><path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" /></svg>
            </button>

        </div>
        <div class="d-flex align-items-center gap-2 col-12 col-lg-5">
            @*<div id="ContentRequestAmountFilterId" class="ContentFilter"></div>
            <div class="btnFilter" data-filtervarconfig="filterRequestAmountConfig" data-filtercallback="callbackFilterRequestAmount" data-filtercontentid="ContentRequestAmountFilterId" data-filterinpsearchid="requestAmountSearchId" data-filtervarsearch="requestAmountSearchVal" onclick="ShowFilterPopup(this)">
                <svg style="width:24px;color:#333" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M3.792 2.938A49.069 49.069 0 0 1 12 2.25c2.797 0 5.54.236 8.209.688a1.857 1.857 0 0 1 1.541 1.836v1.044a3 3 0 0 1-.879 2.121l-6.182 6.182a1.5 1.5 0 0 0-.439 1.061v2.927a3 3 0 0 1-1.658 2.684l-1.757.878A.75.75 0 0 1 9.75 21v-5.818a1.5 1.5 0 0 0-.44-1.06L3.13 7.938a3 3 0 0 1-.879-2.121V4.774c0-.897.64-1.683 1.542-1.836Z" clip-rule="evenodd"></path></svg>
            </div>*@
            <div class="search-group flex-grow-1">
                <input class="form-control" type="text" id="requestAmountSearchId" placeholder="جستجو..." />
                <div class="search-icon">
                    <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z" clip-rule="evenodd" /></svg>
                </div>
            </div>
        </div>
        <div class="d-flex align-items-center justify-content-start justify-content-lg-end gap-2 col-lg">
            <ul class="filter-switch">
                <li class="filter-switch-item">
                    <input type="radio" name="requestAmountFilter" id="requestAmountFilterAll" value="-1" checked />
                    <label for="requestAmountFilterAll">همه</label>
                </li>
                <li class="filter-switch-item">
                    <input type="radio" name="requestAmountFilter" id="requestAmountFilter1" value="1" />
                    <label for="requestAmountFilter1">در انتظار تایید</label>
                </li>
                <li class="filter-switch-item">
                    <input type="radio" name="requestAmountFilter" id="requestAmountFilter2" value="2" />
                    <label for="requestAmountFilter2">در انتظار پرداخت</label>
                </li>
                <li class="filter-switch-item">
                    <input type="radio" name="requestAmountFilter" id="requestAmountFilter3" value="3" />
                    <label for="requestAmountFilter3">پرداخت شده</label>
                </li>
            </ul>
        </div>
    </div>
    <div id="requestAmountContainer">
    </div>
</div>



@section Scripts {
    <script>
        let selectOrderHeadType;  // 3: checkBox  4: radio

        let modelRequestAmount = { filt: null, serVal: null };
        var filterRequestAmountConfig = {};
        var requestAmountSearchVal = null;


        const requestContainer = document.getElementById("requestAmountContainer");

        document.addEventListener("DOMContentLoaded", async () => {
            await Promise.all([getAllRequestAmount(), getAllBankAccounts()]);

            const searchReqAmountElm = document.getElementById("requestAmountSearchId");
            searchReqAmountElm.addEventListener("keyup", async (e) => {
                if (e.key === "Enter") {
                    await getAllRequestAmount();
                }
            });

            searchReqAmountElm.nextElementSibling.addEventListener("click", async () => await getAllRequestAmount());

            const requestAmountRadios = document.querySelectorAll("input[type='radio'][name='requestAmountFilter']");
            requestAmountRadios.forEach(elm => elm.addEventListener("change", async () => await getAllRequestAmount()));
        });


        document.addEventListener("settingReady", () => {
            selectOrderHeadType = setting.multiSelectOrderHeadsInRequestAmount ? 3 : 4;
        });


        async function callbackFilterRequestAmount() {
            modelRequestAmount.filt = filterRequestAmountConfig.filterVar;
            modelRequestAmount.serVal = filterRequestAmountConfig.varSearch;

            await getAllRequestAmount();
        }


        const getAllRequestAmount = async () => {
            const val = document.getElementById("requestAmountSearchId")?.value.trim() ?? "";
            const type = document.querySelector("input[type='radio'][name='requestAmountFilter']:checked")?.value;
            if (type === undefined) return;
            FLshowLoading();
            const res = await axios(`/Amount/GetAllRequestAmountsPartial?search=${val}&type=${type}&passType=1`);
            requestContainer.innerHTML = res.data.html;
            FLshowLoading(false);
        };



        let orderHeadsFilterIds = null;
        let tempSelectedIds = [];
        let tempSelectedMap = new Map(); // id -> number
        const addOrderHeadModal = document.getElementById("addOrderHeadModal");
        async function showAddOrderHeadModal() {
            if (!selectOrderHeadType) return;
            tempSelectedMap.clear();
            tempSelectedIds = [...orderHeadsSelectedIds];

            FLshowLoading();
            orderHeadsFilterIds = (await axios(`/Order/GetAllOrderHeadsByCurrentTamin`)).data;
            await getAllOrderHeads();
            FLshowLoading(false);

            // const supplierId = reqAmountModal.querySelector("#reqAmountSupplierId").value;
            // if (supplierId) {
            //     FLshowLoading();
            //     orderHeadsFilterIds = await getOrderHeadIdsBySupplier(supplierId);
            //     await getAllOrderHeads();
            //     FLshowLoading(false);
            // } else {
            //     FLshowLoading();
            //     await getAllOrderHeads();
            //     FLshowLoading(false);
            // }

            // await getAllOrderHeads();
            toggleAddOrderHeadModal();
        }

        function toggleAddOrderHeadModal() {
            addOrderHeadModal.querySelector("#addOrderHeadSearch").value = "";
            ModalToggle(addOrderHeadModal);
        }

        const getAllOrderHeads = async (search = "") => {
            const model = { search, passType: selectOrderHeadType, selectedIds: tempSelectedIds, filterIds: orderHeadsFilterIds };
            const res = await axios.post(`/Order/GetAllOrderHeads`, model);
            addOrderHeadModal.querySelector("#addOrderHeadContainer").innerHTML = res.data;
            restoreSelectedOrderHeads();
        };

        addOrderHeadModal.querySelector("#addOrderHeadContainer").addEventListener("change", (e) => {
            const inp = e.target.closest("input");
            if (!inp) return;

            inp.type === "radio" ? handleRadio(inp) : handleCheckbox(inp);

            const anySelected = tempSelectedIds.length > 0;
            addOrderHeadModal.querySelector("#submitSelectedOrderHeads").classList.toggle("d-none", !anySelected);
        });

        function handleRadio(inp) {
            tempSelectedIds = [inp.value];
            tempSelectedMap.clear();
            tempSelectedMap.set(inp.value, inp.dataset.number);
        }

        function handleCheckbox(inp) {
            if (inp.checked) {
                if (!tempSelectedIds.includes(inp.value)) {
                    tempSelectedIds.push(inp.value);
                    tempSelectedMap.set(inp.value, inp.dataset.number);
                }
            } else {
                const i = tempSelectedIds.indexOf(inp.value);
                if (i !== -1) tempSelectedIds.splice(i, 1);
                tempSelectedMap.delete(inp.value);
            }
        }

        const submitSelectedOrderHeads = () => {
            orderHeadsSelectedIds = [...tempSelectedIds];

            const inpElm = document.getElementById("reqAmountOrderHead");
            inpElm.value = [...tempSelectedMap.values()].join(", ");
            inpElm.classList.remove("AlertReq");

            ModalToggle(addOrderHeadModal);
        };


        addOrderHeadModal.querySelector("#addOrderHeadSearch").addEventListener("keyup", async (e) => {
            if (e.key === "Enter") {
                toggleElementsDisabled(e.target);
                await getAllOrderHeads(e.target.value.trim());
                toggleElementsDisabled(e.target, false);
                e.target.focus();
            }
        });


        function restoreSelectedOrderHeads() {
            addOrderHeadModal.querySelectorAll("#addOrderHeadContainer input").forEach(inp => {
                if (tempSelectedIds.includes(inp.value)) {
                    inp.checked = true;
                    tempSelectedMap.set(inp.value, inp.dataset.number);
                }
            });

            const anySelected = tempSelectedIds.length > 0;
            addOrderHeadModal.querySelector("#submitSelectedOrderHeads").classList.toggle("d-none", !anySelected);
        }
    </script>
}