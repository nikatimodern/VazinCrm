<!-- Modal ModalExpireDescription -->
<div class="modal fade" id="ModalExpireDescription" tabindex="-1" role="dialog" data-bs-focus="false" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class=" modal-dialog modal-dialog-centered " role="document">
        <div class="modal-content">
            <div class="modal-header justify-content-between" style="height:20px;background-color: var(--DarkColor) ; color:white">
                <h6 class="mp modal-title">بستن پیش فاکتور</h6>
                <button type="button" class="mp btn btn " data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true" style="color:white">&times;</span>
                </button>
            </div>
            <div class=" modal-body" dir="rtl">
                <div class="flex-column flex-sm-row gap-2 align-items-center  " style="width:100%; display:flex; justify-content:space-around">
                    <span class="M_ex_Detail text-center" id="M_ex_Serial"></span>
                    <span class="M_ex_Detail text-center" id="M_ex_Name"></span>
                    <span class="M_ex_Detail text-center" id="M_ex_TAmount"></span>
                </div>
                <div>
                    <form id="descExpirePfactor">

                        <div class="form-group">
                            <label style="font-size:15px;font-family:'IRANSansBold'">علت بستن پیش فاکتور</label>
                            <select id="M_ex_Item" name="M_ex_Item" class="form-control" required onchange="M_ex_cheItem(this)">
                                <option value="1">بالا بودن قیمت کالا</option>
                                <option value="2">بالا بودن قیمت کلیشه</option>
                                <option value="3">به تفاهم نرسیدن سر نحوه تسویه</option>
                                <option value="4">صدور فاکتور جدید</option>
                                <option value="0">سایر</option>
                            </select>
                        </div>
                        <div id="descExpirePfactorID" class="form-group" style="display:none">
                            <label style="font-size:15px; font-family:'IRANSansBold'">توضیحات</label>
                            <textarea id="descExpirePfactorIDTXT" name="des" class="form-control" rows="5" style="height:150px !important"></textarea>
                        </div>

                    </form>
                </div>
                <div style="display:flex; justify-content:end">
                    <button class="btn btn-dark" onclick="SubmitdescExpirePfactor()">ثبت</button>
                </div>
            </div>


        </div>
    </div>
</div>
