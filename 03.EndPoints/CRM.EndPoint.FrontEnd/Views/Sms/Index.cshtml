<div class="sms-page">
    <div class="sms-page-header">
        <div>
            <div class="sms-page-title">مدیریت پیامک</div>
            <div class="sms-page-subtitle">گزارش ارسال و پیامک‌های دریافتی</div>
        </div>

        <button type="button" class="btn sms-refresh-btn" id="syncSmsBtn">
            <svg class="sync-icon" style="width: 16px" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M15.312 11.424a5.5 5.5 0 0 1-9.201 2.466l-.312-.311h2.433a.75.75 0 0 0 0-1.5H3.989a.75.75 0 0 0-.75.75v4.242a.75.75 0 0 0 1.5 0v-2.43l.31.31a7 7 0 0 0 11.712-3.138.75.75 0 0 0-1.449-.39Zm1.23-3.723a.75.75 0 0 0 .219-.53V2.929a.75.75 0 0 0-1.5 0V5.36l-.31-.31A7 7 0 0 0 3.239 8.188a.75.75 0 1 0 1.448.389A5.5 5.5 0 0 1 13.89 6.11l.311.31h-2.432a.75.75 0 0 0 0 1.5h4.243a.75.75 0 0 0 .53-.219Z" clip-rule="evenodd" /></svg>
            <div class="spinner-border spinner-border-sm d-none"></div>
            همگام‌سازی پیامک‌ها
        </button>
    </div>

    <div class="sms-summary-grid">
        <div class="sms-summary-card">
            <div class="sms-summary-icon sms-summary-icon-credit">
                <i class="fas fa-wallet"></i>
            </div>
            <div class="sms-summary-content">
                <span>موجودی حساب</span>
                <div class="d-inline-flex gap-1">
                    <strong id="smsCredit">-</strong>
                    @* <svg onclick="loadSmsDashboard()" class="cursor-pointer" style="width: 16px" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M15.312 11.424a5.5 5.5 0 0 1-9.201 2.466l-.312-.311h2.433a.75.75 0 0 0 0-1.5H3.989a.75.75 0 0 0-.75.75v4.242a.75.75 0 0 0 1.5 0v-2.43l.31.31a7 7 0 0 0 11.712-3.138.75.75 0 0 0-1.449-.39Zm1.23-3.723a.75.75 0 0 0 .219-.53V2.929a.75.75 0 0 0-1.5 0V5.36l-.31-.31A7 7 0 0 0 3.239 8.188a.75.75 0 1 0 1.448.389A5.5 5.5 0 0 1 13.89 6.11l.311.31h-2.432a.75.75 0 0 0 0 1.5h4.243a.75.75 0 0 0 .53-.219Z" clip-rule="evenodd" /></svg> *@
                </div>
            </div>
        </div>

        <div class="sms-summary-card">
            <div class="sms-summary-icon sms-summary-icon-provider">
                <i class="fas fa-signal"></i>
            </div>
            <div class="sms-summary-content">
                <span>سرویس فعال</span>
                <strong id="smsProvider">-</strong>
            </div>
        </div>

        <div class="sms-summary-card">
            <div class="sms-summary-icon sms-summary-icon-lines">
                <i class="fas fa-sim-card"></i>
            </div>
            <div class="sms-summary-content">
                <span>خطوط خدماتی</span>
                <strong id="smsLines">-</strong>
            </div>
        </div>
    </div>

    <div class="sms-content-card">
        <div class="sms-tabs">
            <button type="button" class="sms-tab active" data-target="receivesTab">
                <i class="fa-regular fa-comment-dots"></i>
                پیامک‌های دریافتی
                <span class="sms-tab-count d-none" id="receivesCount">0</span>
            </button>

            <button type="button" class="sms-tab" data-target="reportsTab">
                <i class="fa-regular fa-paper-plane"></i>
                گزارش ارسال
                <span class="sms-tab-count d-none" id="reportsCount">0</span>
            </button>
        </div>


        <div class="sms-tab-content" id="receivesTab">
            <div class="table-responsive p-1">
                <table id="smsReceivesTable" class="table sms-table align-middle table-bordered w-100">
                    <thead>
                    <tr>
                        <th>فرستنده</th>
                        <th>متن پیام</th>
                        <th>تاریخ دریافت</th>
                        <th>خط</th>
                    </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>

        <div class="sms-tab-content d-none" id="reportsTab">
            <div class="table-responsive p-1">
                <table id="smsReportsTable" class="table sms-table align-middle table-bordered w-100">
                    <thead>
                    <tr>
                        <th>شماره</th>
                        <th>متن پیام</th>
                        <th>خط</th>
                        <th>نوع</th>
                        <th>تاریخ ارسال</th>
                        <th>وضعیت</th>
                    </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>

    </div>
</div>


@section Scripts {
    <script src="~/js/sms.js" asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/sms.css" asp-append-version="true" />
}
