<!-- Modal ShowPayment -->
<div class="modal fade invoice-modal" id="ShowPaymentModal" tabindex="-1" role="dialog" data-bs-focus="false">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content col-12" style="padding:10px!important">
            <div class="modalHeader-invoice"></div>
            <div class="modal-body pb-0" style="padding-inline: 10px">
                <div class="modalContent-invoice">
                    <form id="ShowPaymentFormId" class="d-flex flex-column w-100 gap-4 mt-2">
                        <div class="beneficiaryWrapper d-none sectionBox-invoice">
                            <span class="sectionTitle-invoice">بابت بدهی به</span>
                            <div>
                                <input class="form-control" disabled name="beneficiary" type="text" placeholder="بابت بدهی به" />
                            </div>
                        </div>

                        <div class="transactionBankBox sectionBox-invoice">
                            <span class="sectionTitle-invoice">اطلاعات تراکنش بانکی</span>
                            <div class="d-flex flex-wrap row-gap-2 justify-content-center align-items-start" style="width:100%">
                                <div class="ReceiveDateDiv col-12 col-sm-6 col-lg-4 pe-sm-2 d-none">
                                    <label>تاریخ دریافت چک از مشتری</label>
                                    <input class="sdate form-control" name="reciveDate" type="text" placeholder="ثبت تاریخ" data-mask-date disabled />
                                </div>

                                <div class="transactionAmountWrapper col-12 col-sm-6 col-lg-4 pe-sm-2">
                                    <label>مبلغ (ریال)</label>
                                    <input inputmode="numeric" class="currencyNumber form-control" name="reciveAmount" type="text" placeholder="مبلغ دریافتی به ریال" disabled data-currency-hint="next" />
                                    <span class="currencyHint"></span>
                                </div>

                                <div class="VosolDateDiv col-12 col-sm-6 col-lg-4">
                                    <label>تاریخ واریزی</label>
                                    <input class="sdate form-control" name="vosolDate" type="text" placeholder="تاریخ پرداخت" data-mask-date disabled />
                                </div>
                            </div>

                            <div class="toBankAccountWrapperSelect my-2 w-100">
                                <label>واریز به حساب بانکی</label>
                                <select disabled class="form-select" name="bankAccountId"></select>
                            </div>

                            <div class="toBankAccountWrapperTxt mb-2 d-none">
                                <label>واریز به حساب بانکی</label>
                                <input disabled class="form-control" name="bankAccountTxt" type="text" placeholder="به کدام (حساب / شبا / کارت) واریز شده است." />
                            </div>

                            <div class="toNameWrapper d-none">
                                <label>واریز به نام</label>
                                <input disabled class="form-control" name="toName" type="text" placeholder="نام صاحب حساب واریز شده" />
                            </div>
                        </div>
                    </form>

                    <div class="sanadPayBox sectionBox-invoice mt-4">
                        <span class="sectionTitle-invoice">رسید پرداخت</span>
                        <div class="container-uploader">
                            <div class="image-display"></div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="px-0 py-3 w-100">
                <div style="width:100%; height:2px; background-color:var(--DarkColor)"></div>
            </div>

            <div class="gap-1 modal-footer p-0 border-0 justify-content-center">
                <button class="buttonCancel2 m-0" data-bs-dismiss="modal">انصراف</button>
            </div>
        </div>
    </div>
</div>
