@model CRM.EndPoint.FrontEnd.Models.Setting.PrefactorTermsPageModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "شرایط پیش‌فاکتور";
}
@section Styles {
    <link rel="stylesheet" href="~/css/settingsTheme.css?release=7.5.6" asp-append-version="true" />
}
<div id="prefactorTermsWorkspace" class="crm-settings-theme mx-auto p-2" style="max-width:1050px" dir="rtl">
    <div class="InfoData">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
            <h5 class="mb-0">شرایط و توضیحات تکمیلی پیش‌فاکتور</h5>
            <a asp-controller="ASetting" asp-action="Index" class="hoverLink">بازگشت به تنظیمات</a>
        </div>
        @if (TempData["PrefactorTermsMessage"] is string message) {
            <p role="status" class="mb-2 text-success">@message</p>
        }
        <p class="small text-muted mb-2">اولویت کمتر، زودتر نمایش داده می‌شود. تغییرات در نمایش پیش‌فاکتورهای قبلی نیز اعمال می‌شوند.</p>
        <form asp-action="Save" method="post" class="d-flex flex-column gap-2 mb-3">
            <input asp-for="Input.Id" type="hidden" />
            <div class="d-flex flex-wrap align-items-center gap-2">
                <strong>@(Model.Input.Id.HasValue ? "ویرایش بند" : "افزودن بند")</strong>
                <label asp-for="Input.Order">اولویت نمایش</label>
                <input asp-for="Input.Order" type="number" min="1" class="form-control form-control-sm" style="width:100px" required />
                <span asp-validation-for="Input.Order" class="text-danger small"></span>
            </div>
            <label asp-for="Input.Text">متن بند</label>
            <textarea asp-for="Input.Text" class="form-control" rows="3" required></textarea>
            <span asp-validation-for="Input.Text" class="text-danger small"></span>
            <div class="d-flex justify-content-end gap-2">
                @if (Model.Input.Id.HasValue) {
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary crm-mobile-dense-action">انصراف</a>
                }
                <button type="submit" class="buttonGreen3">@(Model.Input.Id.HasValue ? "ذخیره تغییرات" : "افزودن")</button>
            </div>
        </form>
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2 border-top pt-2">
            <label for="prefactorTermSearch">جستجو</label>
            <input id="prefactorTermSearch" type="search" class="form-control form-control-sm flex-grow-1" style="width:auto" placeholder="متن بند یا اولویت" />
            <span id="prefactorTermCount" class="small text-muted" aria-live="polite">@Model.Terms.Count بند</span>
        </div>
        <div id="prefactorTermList">
            @foreach (var term in Model.Terms) {
                <div class="prefactor-term-row d-flex flex-wrap align-items-start gap-2 border-bottom py-2" data-order="@term.Order">
                    <strong class="text-center flex-shrink-0" style="min-width:2.5rem" title="اولویت">@term.Order</strong>
                    <div class="prefactor-term-text flex-grow-1" style="flex-basis:220px;white-space:pre-wrap;overflow-wrap:anywhere">@term.Text</div>
                    <div class="d-flex gap-1 ms-auto">
                        <a asp-action="Index" asp-route-editId="@term.Id" class="btn btn-sm btn-outline-secondary crm-mobile-dense-action">ویرایش</a>
                        <a asp-action="ConfirmDelete" asp-route-id="@term.Id" class="btn btn-sm btn-outline-danger crm-mobile-dense-action">حذف</a>
                    </div>
                </div>
            }
        </div>
        <p id="prefactorTermEmpty" class="text-muted text-center py-2 mb-0" hidden="@(Model.Terms.Count > 0)">بندی یافت نشد.</p>
    </div>
</div>
@section Scripts {
    <script src="~/js/prefactorTerms.js?release=7.5.6" asp-append-version="true"></script>
}
