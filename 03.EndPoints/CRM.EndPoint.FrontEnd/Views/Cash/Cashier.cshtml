@{
    Layout = "_Layout";
}


<div class="w-100">
    <div class="row align-items-center justify-content-between flex-wrap mb-2 g-2">
        <div class="d-flex col-lg-3">
            <button class="buttonGray2 d-flex align-items-center gap-1" style="padding: 4px 8px" onclick="toggleCashierModal()">
                <span style="line-height: 1">ثبت تنخواه دار</span>
                <svg style="width: 20px" viewBox="0 0 20 20" fill="currentColor"><path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" /></svg>
            </button>
        </div>
        <div class="col-12 col-lg-5 d-flex align-items-center gap-2 flex-wrap">
            @*<div class="d-flex align-items-center flex-grow-1 gap-2">
                <input class="form-control" id="cashierSearch" placeholder="جستجو">
            </div>*@
        </div>
        <div class="d-flex align-items-start justify-content-start justify-content-lg-end gap-2 col-lg-3">

            @*<div id="ContentDealFilterId" class="ContentFilter"></div>
            <div class="btnFilter d-none d-lg-flex" data-filterVarConfig="filterDealConfig" data-filterCallBack="callbackFilterDeal" data-filterContentId="ContentDealFilterId" data-filterInpSearchId="dealSearchId" data-filterVarSearch="dealSearchVal" onclick="ShowFilterPopup(this)">
                <svg style="width:24px;color:#333" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M3.792 2.938A49.069 49.069 0 0 1 12 2.25c2.797 0 5.54.236 8.209.688a1.857 1.857 0 0 1 1.541 1.836v1.044a3 3 0 0 1-.879 2.121l-6.182 6.182a1.5 1.5 0 0 0-.439 1.061v2.927a3 3 0 0 1-1.658 2.684l-1.757.878A.75.75 0 0 1 9.75 21v-5.818a1.5 1.5 0 0 0-.44-1.06L3.13 7.938a3 3 0 0 1-.879-2.121V4.774c0-.897.64-1.683 1.542-1.836Z" clip-rule="evenodd"></path></svg>
            </div>*@
        </div>
    </div>
    <div id="cashierContainer">

    </div>
</div>


<!-- Modal cashier -->
<div class="modal fade" id="cashierModal" tabindex="-1" role="dialog" data-bs-focus="false">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content col-12 p-2">
            <div class="text-center text-white rounded py-1 fbold" style="background-color: #6c757d">ثبت تنخواه</div>
            <div class="modal-body pb-2">
                <form id="cashierForm" class="d-flex flex-column gap-2">
                    <div>
                        <label for="cashierCostTitle">عنوان تنخواه:</label>
                        <input id="cashierCostTitle" class="form-control" name="title" required>
                    </div>

                    <div>
                        <label for="cashierUser">کاربر:</label>
                        <select id="cashierUser" name="userId" required></select>
                    </div>

                    <div class="d-flex justify-content-center gap-1 mt-2">
                        <button type="button" class="buttonCancel2" style="padding-block: 4px" onclick="toggleCashierModal()">انصراف</button>
                        <button type="button" class="buttonGreen3" style="padding-block: 4px" onclick="submitCashierModal()">ثبت</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", async () => {

            //await getAllCashier();
            @*document.getElementById("cashierSearch").addEventListener("keyup", async (e) => {
                if (e.key === "Enter") {
                }
            });*@
        });

        let selectTomLoaded = false;
        async function toggleCashierModal() {
            if (!selectTomLoaded) {
                await initSelectTomCashier();
                selectTomLoaded = true;
            }
            ModalToggle("cashierModal");
            mySer.emptyForm("cashierForm");
        }


        const initSelectTomCashier = async () => {
            const users = await CrmSer.getUsers(1);
            new TomSelect("#cashierUser", {
                options: users,
                valueField: "id",
                maxItems: 1,
                selectOnTab: true,
            });
        }

        async function submitCashierModal() {
            if (!await mySer.CheckValidForm("cashierForm")) return;
            const model = {
                //...cashierData,
                ...mySer.convertFormToJSON("cashierForm"),
            };
            console.log(model);
            try {
                FLshowLoading();
                const res = await axios.post("/Cash/AddCashier", model);
                if (res.status === 200) {
                    toastifySuccess("با موفقیت ثبت شد");
                    //getAllCashier();
                    toggleCashierModal();
                }
            } catch (err) {
                console.log(err);
            } finally {
                FLshowLoading(false);
            }
        }
    </script>
}
