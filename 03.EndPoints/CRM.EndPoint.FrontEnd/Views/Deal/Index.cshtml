@{
    ViewBag.Title = "title";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="d-flex flex-column w-100">
    <div class="row align-items-center justify-content-between flex-wrap mb-2 g-2">
        <div class="d-flex col-lg-3">
            <button class="buttonGreen0 d-flex align-items-center gap-1" style="padding: 4px 8px" onclick="openDealModal()">
                <span style="line-height: 1">ثبت سفارش جدید</span>
                <svg style="width: 20px" viewBox="0 0 20 20" fill="currentColor"><path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" /></svg>
            </button>
        </div>
        <div class="col-12 col-lg-5 d-flex align-items-center gap-2 flex-wrap">
            <div class="d-flex align-items-center flex-grow-1 gap-2">
                <div class="search-group w-100">
                    <input type="text" class="form-control form-control-sm" id="dealSearchId" placeholder="جستجو">
                    <div class="search-icon">
                        <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z" clip-rule="evenodd" /></svg>
                    </div>
                </div>
                <div class="btnFilter d-lg-none" data-filterVarConfig="filterDealConfig" data-filterCallBack="callbackFilterDeal" data-filterContentId="ContentDealFilterId" data-filterInpSearchId="dealSearchId" data-filterVarSearch="dealSearchVal">
                    <svg style="width:24px;color:#333" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M3.792 2.938A49.069 49.069 0 0 1 12 2.25c2.797 0 5.54.236 8.209.688a1.857 1.857 0 0 1 1.541 1.836v1.044a3 3 0 0 1-.879 2.121l-6.182 6.182a1.5 1.5 0 0 0-.439 1.061v2.927a3 3 0 0 1-1.658 2.684l-1.757.878A.75.75 0 0 1 9.75 21v-5.818a1.5 1.5 0 0 0-.44-1.06L3.13 7.938a3 3 0 0 1-.879-2.121V4.774c0-.897.64-1.683 1.542-1.836Z" clip-rule="evenodd"></path></svg>
                </div>
            </div>
        </div>
        <div class="d-flex align-items-start justify-content-start justify-content-lg-end gap-2 col-lg-3">
            <div id="ContentDealFilterId" class="ContentFilter"></div>
            @*<div>
                <select class="form-select form-select-sm" style="background-position: left 6px center;padding-left:24px;" id="reportCountSelect">
                    <option value="20">20</option>
                    <option value="50" selected>50</option>
                    <option value="100">100</option>
                    <option value="200">200</option>
                    <option value="0">همه</option>
                </select>
            </div>*@
            <div class="btnFilter d-none d-lg-flex" data-filterVarConfig="filterDealConfig" data-filterCallBack="callbackFilterDeal" data-filterContentId="ContentDealFilterId" data-filterInpSearchId="dealSearchId" data-filterVarSearch="dealSearchVal">
                <svg style="width:24px;color:#333" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M3.792 2.938A49.069 49.069 0 0 1 12 2.25c2.797 0 5.54.236 8.209.688a1.857 1.857 0 0 1 1.541 1.836v1.044a3 3 0 0 1-.879 2.121l-6.182 6.182a1.5 1.5 0 0 0-.439 1.061v2.927a3 3 0 0 1-1.658 2.684l-1.757.878A.75.75 0 0 1 9.75 21v-5.818a1.5 1.5 0 0 0-.44-1.06L3.13 7.938a3 3 0 0 1-.879-2.121V4.774c0-.897.64-1.683 1.542-1.836Z" clip-rule="evenodd"></path></svg>
            </div>
        </div>
    </div>
    <ul class="nav nav-tabs" id="dealTabs" role="tablist" style="display: none;">
        <li class="nav-item" role="presentation">
            <button class="nav-link active text-dark position-relative" style="margin-bottom:-2px;isolation:auto" id="openDealTab" data-tab="open" data-bs-toggle="tab" data-bs-target="#openDealTab-pane" type="button" role="tab" aria-controls="openDealTab-pane" aria-selected="true">
                سفارشات باز
                <span class="badge-count filter-count-badge"></span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link text-dark position-relative" style="margin-bottom:-2px;isolation:auto" id="successDealTab" data-tab="success" data-bs-toggle="tab" data-bs-target="#successDealTab-pane" type="button" role="tab" aria-controls="successDealTab-pane" aria-selected="false">
                سفارشات موفق
                <span class="badge-count filter-count-badge"></span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link text-dark position-relative" style="margin-bottom:-2px;isolation:auto" id="failedDealTab" data-tab="failed" data-bs-toggle="tab" data-bs-target="#failedDealTab-pane" type="button" role="tab" aria-controls="failedDealTab-pane" aria-selected="false">
                سفارشات ناموفق
                <span class="badge-count filter-count-badge"></span>
            </button>
        </li>
    </ul>
    <div id="allDealsContainer" class="d-xl-grid allTasksContainer">
        <div class="show active border-0" id="openDealTab-pane" role="tabpanel" tabindex="0">
            <div class="tasks-container" id="openDealsContainerId">
                <div class="deal-column open">
                    <div class="deal-column-header">
                        سفارشات باز
                        <span class="countDeal"></span>
                    </div>
                    <div class="deal-column-list" aria-busy="true" data-status="1">
                        @for (var card = 0; card < 3; card++) {
                            <partial name="_DealSkeleton" />
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="border-0" id="successDealTab-pane" role="tabpanel" tabindex="0">
            <div class="tasks-container" id="successDealsContainerId">
                <div class="deal-column success">
                    <div class="deal-column-header">
                        سفارشات موفق
                        <span class="countDeal"></span>
                    </div>
                    <div class="deal-column-list" aria-busy="true" data-status="3">
                        @for (var card = 0; card < 3; card++) {
                            <partial name="_DealSkeleton" />
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="border-0" id="failedDealTab-pane" role="tabpanel" tabindex="0">
            <div class="tasks-container" id="failedDealsContainerId">
                <div class="deal-column failed">
                    <div class="deal-column-header">
                        سفارشات ناموفق
                        <span class="countDeal"></span>
                    </div>
                    <div class="deal-column-list" aria-busy="true" data-status="2">
                        @for (var card = 0; card < 3; card++) {
                            <partial name="_DealSkeleton" />
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>





<partial name="~/Views/PreFactor/Modals/_PreFactorModal.cshtml" />
<partial name="~/Views/PreFactor/Modals/_DeliverModal.cshtml" />
<partial name="~/Views/PreFactor/Modals/_PreFactorAttachmentsModal.cshtml" />
<partial name="~/Views/PreFactor/Modals/_PreFactorMobileModal.cshtml" />
<partial name="~/Views/PreFactor/Modals/_PreFactorChangeUsersModal.cshtml" />
<partial name="~/Views/PreFactor/Modals/_PreFactorContainerModal.cshtml" />
<partial name="~/Views/PreFactor/Modals/_SendPreFactorToExternalSoftwareModal.cshtml" />

<partial name="~/Views/Factor/Modals/_FactorContainerModal.cshtml" />

<partial name="~/Views/Order/Modals/_UndeliveredOrderHeadsModal.cshtml" />
<partial name="~/Views/Order/Modals/_CreateOrderModal.cshtml" />
<partial name="~/Views/Order/Modals/_OrderHeadsContainerModal.cshtml" />

<partial name="~/Views/Accountancy/Modals/_InvoiceListModal.cshtml" />

<partial name="~/Views/Carizo/Modals/_EditTaskModal.cshtml" />

<partial name="~/Views/Report/Modals/_ReportContainerModal.cshtml" />

<partial name="Modals/_DealModal" />

<template id="dealSkeletonTemplate">
    <partial name="_DealSkeleton" />
</template>

@section Scripts {
    <script src="~/js/deal/deal.js?release=7.0.4" data-page-bindings="modelDeal,filterDealConfig,dealSearchVal,currentDealData,isEditMode,canCreateCustomerTomSelect,selectTomCustomers,dealModalElm,toggleExtraPanelBtn,extraCustomerPanel,dealDropdown,deleteDeal,callbackFilterDeal,dealListRequest,cancelDealListRequest,showDealListError,getAllDeals,createDomAllDeals,assignUserSuspendDeal,editDealModal,selectTomLoaded,openDealModal,closeDealModal,submitDeal,dealMobileElm,initSelectTom,setDealDataByCustomer,showExistingCustomerToast,initSortableDeal,pendingDealStatusChanges,changeStatusDeal,removeDealsTabsDesktop,toggleExtraPanel" asp-append-version="true"></script>
    <script src="~/js/deal/deal-documents.js?release=7.0.4" data-page-bindings="currentDealDocumentData,showModalDealPreFactors,showModalDealFactors,showModalDealReports,showModalDealOrders,showModalDealSupplyFactors,showModalDealInvoices,getPreFactorFromDeal,getReportFromDeal,getSupplyFactorsFromDeal,getOrdersFromDeal,getInvoicesFromDeal,refreshDealPreFactors,refreshDealFactors,refreshDealReports,refreshDealOrders,refreshDealSupplyFactors,deletedPrefactorToggle" asp-append-version="true"></script>
}
