@{
    Layout = "_Layout";
}


<div>
    <div class="d-flex justify-content-between align-items-end flex-row-reverse gap-1 flex-wrap mb-2">
        <div id="cashBalanceContainer" class="flex-grow-1 d-flex justify-content-end">
        </div>
        <div class="d-flex flex-grow-1">
            <button class="buttonGray2 d-flex align-items-center gap-1" style="padding: 4px 8px" data-bs-toggle="modal" data-bs-target="#cashModal">
                <span style="line-height: 1">ثبت تنخواه</span>
                <svg style="width: 20px" viewBox="0 0 20 20" fill="currentColor"><path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" /></svg>
            </button>
        </div>
    </div>
    <div id="cashContainer" style="width: 99%;">
        <table class="table table-striped table-bordered table-hover nowrap w-100" id="cashTable">
            <thead>
            <tr>
                <th>شماره سریال</th>
                <th>تاریخ ثبت</th>
                <th>عنوان هزینه</th>
                <th>مرکز هزینه</th>
                <th>تاریخ پرداخت</th>
                <th>مبلغ</th>
                <th>شرح هزینه</th>
                <th>ثبت توسط</th>
                <th>وضعیت</th>
                <th>عملیات</th>
            </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>


<!-- Modal cash -->
<div class="modal fade" id="cashModal" tabindex="-1" role="dialog" data-bs-focus="false">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content col-12 p-2">
            <div class="text-center text-white rounded py-1 fbold" style="background-color: #6c757d">ثبت تنخواه</div>
            <div class="modal-body pb-2">
                <form id="cashForm" class="d-flex flex-column gap-2">
                    <div>
                        <label for="cashCostTitle">عنوان هزینه:</label>
                        <select id="cashCostTitle" class="form-select form-select-sm" name="costTitleId" required></select>
                    </div>

                    <div>
                        <label for="cashCostCenter">مرکز هزینه:</label>
                        <select id="cashCostCenter" class="form-select form-select-sm" name="costCenterId" required></select>
                    </div>

                    <div>
                        <label for="cashCostDate">تاریخ هزینه:</label>
                        <input id="cashCostDate" class="sdate form-control" name="costDate" data-mask-date required />
                    </div>

                    <div>
                        <label for="cashAmount">مبلغ:</label>
                        <input id="cashAmount" inputmode="numeric" class="form-control currencyNumber inpAmount" name="amount" required>
                    </div>

                    <div>
                        <label for="cashDescription">شرح هزینه:</label>
                        <textarea id="cashDescription" class="form-control h-auto" name="costDescription" rows="3" required></textarea>
                    </div>

                    <div>
                        <label for="cashAtt">تصویر رسید:</label>
                        <div class="container-uploader">
                            <input type="file" class="uploadBtn" data-varList="cashAttachments" data-showList="DivShowCashAtt" id="cashAtt" accept="*/*" multiple required />
                            <label for="cashAtt">
                                <svg style="width: 16px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" /></svg>
                                <span>تصویر رسید را انتخاب یا اینجا رها کنید</span>
                            </label>
                            <div class="image-display" id="DivShowCashAtt"></div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-center gap-1 mt-2">
                        <button type="button" class="buttonCancel2" style="padding-block: 4px" data-bs-dismiss="modal">انصراف</button>
                        <button type="button" class="buttonGreen3" style="padding-block: 4px" onclick="submitCashModal()">ثبت</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var cashAttachments = [];
        var searchVarCash;
        var cashConfigFilter = {};
        const cashModal = document.getElementById("cashModal");
        const costCenterElm = cashModal.querySelector("#cashCostCenter");
        document.addEventListener("DOMContentLoaded", async () => {
            getAllCashesDt();
            await initCashierSelectOpt();
        });

        cashModal.addEventListener("hidden.bs.modal", () => {
            mySer.emptyForm("cashForm");
            cashData = [];
            cashAttachments = [];
        });

        async function initCashierSelectOpt() {
            const baseCashCenter = (await axios(`/Cash/GetAllBaseCashCenter`)).data;
            const baseCash = (await axios(`/Cash/GetAllBaseCash`)).data;
            createOption(costCenterElm, baseCashCenter);
            createOption("cashCostTitle", baseCash);
        }


        let cashData = {};
        async function showEditCashModal(id) {
            FLshowLoading();
            ModalToggle(cashModal);

            try {
                const res = await axios(`/Cash/GetCash/${id}`);
                if (res.status === 200) {
                    console.log(res);
                    cashData = res.data.cash;
                    mySer.convertJsonToForm(cashData, "cashForm");
                    cashAttachments = res.data.attachments;
                    FileUpReload("cashAtt");
                }

            } catch (err) {
                console.log(err);
            } finally {
                FLshowLoading(false);
            }
        }

        const deleteCash = async (id) => {
            Swal.fire({
                title: "حذف!",
                text: "آیا مطمئن هستید که میخواهید حذف کنید؟",
                icon: "warning",
                showCancelButton: true,
                cancelButtonColor: "#adadad",
                confirmButtonColor: "#e64942",
                cancelButtonText: "انصراف",
                confirmButtonText: "بله، حذف شود",
            }).then(async (willDelete) => {
                if (willDelete.isConfirmed) {
                    FLshowLoading();
                    const res = await axios(`/Cash/DeleteCash/${id}`);
                    if (res.status === 200) {
                        toastifySuccess("با موفقیت حذف شد");
                        cashTbl.ajax.reload(null, false);
                    }
                    FLshowLoading(false);
                }
            });
        };


        async function submitCashModal() {
            if (!await mySer.CheckValidForm("cashForm")) return;
            if (cashAttachments.every(item => item.isDeleted)) {
                toastifyError("تصویر رسید اجباری است");
                return;
            }
            const costTitleElm = document.getElementById("cashCostTitle");
            const model = {
                ...cashData,
                ...mySer.convertFormToJSON("cashForm"),
                costCenterTxt: costCenterElm.options[costCenterElm.selectedIndex].text,
                costTitleTxt: costTitleElm.options[costTitleElm.selectedIndex].text,
                attachments: cashAttachments,
            };


            try {
                FLshowLoading();
                const res = await axios.post("/Cash/AddCash", model);
                if (res.status === 200) {
                    toastifySuccess("با موفقیت ثبت شد");
                    cashTbl.ajax.reload(null, false);
                    ModalToggle(cashModal);
                }
            } catch (err) {
                console.log(err);
                if (err.status === 404) {
                    toastifyError(err.response.data);
                }
            } finally {
                FLshowLoading(false);
            }
        }

        async function changeStatusCash(id, status) {
            try {
                FLshowLoading();
                const res = await axios(`/Cash/ChangeStatusCash/${id}?status=${status}`);
                if (res.status === 200) {
                    if (status === 2) {
                        toastifySuccess("تایید شد");
                    }
                    cashTbl.ajax.reload(null, false);
                }
            } catch (err) {
                console.log(err);
                if (err.status === 404) {
                    toastifyError(err.response.data);
                }
            } finally {
                FLshowLoading(false);
            }
        }

        async function changeStatusAllCashToPending() {
            try {
                FLshowLoading();
                const res = await axios(`/Cash/ChangeStatusAllCashToPending`);
                if (res.status === 200) {
                    toastifySuccess("به مالی ارسال شد");
                    cashTbl.ajax.reload(null, false);
                }
            } catch (err) {
                console.log(err);
                if (err.status === 404) {
                    toastifyError(err.response.data);
                }
            } finally {
                FLshowLoading(false);
            }
        }

        let cashTbl;
        let modelCash = {};
        let isManager;
        const getAllCashesDt = () => {
            cashTbl = $("#cashTable").DataTable({
                pageLength: 10,
                lengthMenu: [5, 10, 20, 50, 100, { label: "همه", value: -1 }],
                processing: true,
                serverSide: true,
                searching: true,
                search: {
                    return: true,
                },
                ordering: true,
                order: [[1, "desc"]],
                scrollCollapse: true,
                scrollY: "70dvh",
                responsive: true,
                ajax: {
                    url: `/Cash/GetAllCashesDt`,
                    type: "POST",
                    data: (d) => {
                        d.model = JSON.stringify(modelCash);
                    },
                    dataSrc: function (json) {
                        isManager = json.isManager;
                        initCashierBalanceUI(json.cashierBalance);
                        return json.data;
                    },
                },
                language: {
                    emptyTable: "هیچ رکوردی موجود نمی باشد.",
                    info: "نمایش _START_ تا _END_ از _TOTAL_ ردیف",
                    infoEmpty: "نمایش 0 تا 0 از 0 ردیف",
                    infoFiltered: "(فیلتر شده از _MAX_ ردیف)",
                    lengthMenu: "نمایش _MENU_ ردیف",
                    loadingRecords: "در حال بارگزاری...",
                    search: "",
                    zeroRecords: "رکوردی با این مشخصات پیدا نشد",
                    aria: {
                        sortAscending: ": فعال سازی نمایش به صورت صعودی",
                        sortDescending: ": فعال سازی نمایش به صورت نزولی",
                    },
                },
                columnDefs: [
                    {
                        targets: [8, 9],
                        orderable: false,
                    },
                    {
                        targets: [1],
                        render: data => `<span dir="ltr">${data.slice(0, -3).split(" ").join(" | ")}</span>`,
                    },
                    {
                        targets: [5],
                        render: data => `<span dir="ltr" class="fbold">${data ? data.toLocaleString() : "-"}</span>`,
                    },
                ],
                columns: [
                    { data: "serial", name: "Serial", defaultContent: "-" },
                    { data: "createDateTxt", name: "CreateDateTxt", defaultContent: "-" },
                    { data: "costTitleTxt", name: "CostTitleTxt", defaultContent: "-" },
                    { data: "costCenterTxt", name: "CostCenterTxt", defaultContent: "-" },
                    { data: "costDate", name: "CostDate", defaultContent: "-" },
                    { data: "amount", name: "Amount", defaultContent: "-" },
                    { data: "costDescription", name: "CostDescription", defaultContent: "-" },
                    { data: "userCreator", name: "UserCreator", defaultContent: "-" },
                    {
                        data: "status",
                        render: function (data, type, row) {
                            if (data === 0) { // ثبت موقت
                                //if (isManager) return `<span class="fMedium" style="color: #666">${row.statusTxt}</span>`;

                                return `<button class="buttonGreen2" onclick="changeStatusCash('${row.id}', 1)">ارسال به مالی</button>`;
                            } else if (data === 1) { // در دست تایید
                                if (isManager) return `
                                    <div class="d-inline-flex align-items-center justify-content-center gap-1">
                                        <button class="buttonGreen2" onclick="changeStatusCash('${row.id}', 2)">تایید</button>
                                        <button class="buttonCancel3" onclick="changeStatusCash('${row.id}', 0)">برگشت</button>

                                    </div>
                                `;

                                return `
                                    <div class="d-inline-flex align-items-center justify-content-center gap-1">
                                        <span class="fMedium" style="color: #CC9900">${row.statusTxt}</span>

                                    </div>
                                `;
                            } else { // تایید شده
                                if (isManager) return `
                                    <div class="d-inline-flex align-items-center justify-content-center gap-1">
                                        <span class="fMedium" style="color: darkgreen">${row.statusTxt}</span>
                                        <button class="cursor-pointer" style="color:#333" onclick="changeStatusCash('${row.id}', 1)" data-title-left="بازگشت">
                                            <svg style="width:16px;height:16px" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m15 15 6-6m0 0-6-6m6 6H9a6 6 0 0 0 0 12h3"></path></svg>
                                        </button>
                                    </div>
                                `;

                                return `<span class="fMedium" style="color: darkgreen">${row.statusTxt}</span>`;
                            }
                        },
                    },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return `
                                <div class="d-inline-flex align-items-center justify-content-center gap-1">
                                    <button type="button" style="padding: 6px 7px;box-shadow: none;font-size: 12px" class="buttonGray flex-center" onclick="showAttachments('${row.id}', 10)"><i class="fa fa-paperclip"></i></button>
                                    ${row.status === 0 ? `
                                        <button type="button" style="padding: 6px 6px;box-shadow: none;font-size: 12px" class="buttonGreen3 flex-center" onclick="showEditCashModal('${row.id}')"><i class="fa fa-pencil"></i></button>
                                        <button type="button" style="padding: 6px 7px;box-shadow: none;font-size: 12px" class="buttonCancel2 flex-center" onclick="deleteCash('${row.id}')"><i class="fa fa-trash"></i></button>
                                    ` : ""}
                                </div>
                            `;
                        },
                    },
                ],
                layout: {
                    bottomEnd: "info",
                    bottomStart: {
                        paging: {
                            type: "simple_numbers",
                        },
                    },
                    topEnd: {
                        pageLength: true,
                        buttons: [
                            {
                                extend: "excel",
                                exportOptions: {
                                    columns: [0, 1, 2, 3, 4, 5, 6, 7],
                                },
                                text: `<svg style="color:#fff;width:78%" fill="currentColor" viewBox="0 0 256 256"><path d="M156,208a8,8,0,0,1-8,8H120a8,8,0,0,1-8-8V152a8,8,0,0,1,16,0v48h20A8,8,0,0,1,156,208ZM92.65,145.49a8,8,0,0,0-11.16,1.86L68,166.24,54.51,147.35a8,8,0,1,0-13,9.3L58.17,180,41.49,203.35a8,8,0,0,0,13,9.3L68,193.76l13.49,18.89a8,8,0,0,0,13-9.3L77.83,180l16.68-23.35A8,8,0,0,0,92.65,145.49Zm98.94,25.82c-4-1.16-8.14-2.35-10.45-3.84-1.25-.82-1.23-1-1.12-1.9a4.54,4.54,0,0,1,2-3.67c4.6-3.12,15.34-1.72,19.82-.56a8,8,0,0,0,4.07-15.48c-2.11-.55-21-5.22-32.83,2.76a20.58,20.58,0,0,0-8.95,14.95c-2,15.88,13.65,20.41,23,23.11,12.06,3.49,13.12,4.92,12.78,7.59-.31,2.41-1.26,3.33-2.15,3.93-4.6,3.06-15.16,1.55-19.54.35A8,8,0,0,0,173.93,214a60.63,60.63,0,0,0,15.19,2c5.82,0,12.3-1,17.49-4.46a20.81,20.81,0,0,0,9.18-15.23C218,179,201.48,174.17,191.59,171.31ZM40,112V40A16,16,0,0,1,56,24h96a8,8,0,0,1,5.66,2.34l56,56A8,8,0,0,1,216,88v24a8,8,0,1,1-16,0V96H152a8,8,0,0,1-8-8V40H56v72a8,8,0,0,1-16,0ZM160,80h28.68L160,51.31Z"></path></svg>`,
                                titleAttr: "اکسل",
                                title: "تنخواه",
                                className: "buttonExcel",
                            },
                        ],
                    },
                    topStart: {
                        search: {
                            placeholder: "جستجو",
                        },
                    },
                },

                initComplete: () => initFilterCashTable(),
                drawCallback: function () {
                    const api = this.api();
                    const json = api.ajax.json();

                    const container = document.querySelector(".dt-length");
                    const existingBtn = container.querySelector(".sendAllBtn");

                    const shouldShow = json?.data?.some(i => i.status === 0);

                    if (!shouldShow) {
                        existingBtn?.remove();
                        return;
                    }

                    if (existingBtn) return;

                    const btn = document.createElement("button");
                    btn.className = "buttonGreen2 sendAllBtn";
                    btn.textContent = "ارسال همه به مالی";

                    btn.onclick = async () => {
                        btn.disabled = true;
                        await changeStatusAllCashToPending();
                        btn.disabled = false;
                    };

                    container.prepend(btn);
                },


            });

            function initFilterCashTable() {
                const dtLength = document.querySelector(".dt-length label");
                const dtSearch = document.querySelector(".dt-search");
                const searchInput = dtSearch?.querySelector("input");
                if (!searchInput) return;
                const filterButton = `
                    <div class="btnFilter pe-md-2" data-filterVarConfig="cashConfigFilter" data-filterCallBack="callBackCashFilter" data-filterContentId="contentCashFilterId" data-filterInpSearchId="dt-search-0" data-filterVarSearch="searchVarCash" onclick="ShowFilterPopup(this, ['cusFilterItem'])">
                        <svg style="width:24px;height:24px;color:#333" viewBox="0 0 24 24" fill="currentColor" ><path fill-rule="evenodd" d="M3.792 2.938A49.069 49.069 0 0 1 12 2.25c2.797 0 5.54.236 8.209.688a1.857 1.857 0 0 1 1.541 1.836v1.044a3 3 0 0 1-.879 2.121l-6.182 6.182a1.5 1.5 0 0 0-.439 1.061v2.927a3 3 0 0 1-1.658 2.684l-1.757.878A.75.75 0 0 1 9.75 21v-5.818a1.5 1.5 0 0 0-.44-1.06L3.13 7.938a3 3 0 0 1-.879-2.121V4.774c0-.897.64-1.683 1.542-1.836Z" clip-rule="evenodd" /></svg>
                    </div>
                `;
                const radioBtns = `
                    <div class="d-flex column-gap-2 align-items-center justify-content-between flex-wrap">
                        <ul class="filter-switch mt-2 mt-md-0">
                            <li class="filter-switch-item">
                                <input type="radio" name="cash_type" id="cash_type-all" value="-1" checked>
                                <label for="cash_type-all">همه</label>
                            </li>
                            <li class="filter-switch-item">
                                <input type="radio" name="cash_type" id="cash_type-1" value="1">
                                <label for="cash_type-1">در انتظار تایید</label>
                            </li>
                            <li class="filter-switch-item">
                                <input type="radio" name="cash_type" id="cash_type-2" value="2">
                                <label for="cash_type-2">تایید شده</label>
                            </li>
                        </ul>
                    </div>
                `;
                const contentFilter = `<div id="contentCashFilterId" style="justify-content: start;" class="ContentFilter mt-2 mt-md-0 ms-md-2"></div>`;

                searchInput.insertAdjacentHTML("afterend", filterButton);
                dtSearch.insertAdjacentHTML("afterend", contentFilter);
                dtSearch.insertAdjacentHTML("afterend", radioBtns);
            }

            cashTbl.on("search", function () {
                modelCash.serVal = cashTbl.search();
            });
        };

        const callBackCashFilter = () => {
            modelCash.serVal = window[filterVarConfig]?.varSearch;
            modelCash.filt = window[filterVarConfig]?.filterVar;

            cashTbl.ajax.reload();
        };


        const initCashierBalanceUI = (data) => {
            if (!data) return;

            const container = document.getElementById("cashBalanceContainer");

            const balance = data.totalCredit - data.totalDebit;
            let statusClass = "";
            if (balance < 0) {
                statusClass = "cash-summary--negative";
            } else if (!data.isAccepted) {
                statusClass = "cash-summary--pending";
            }

            const usedPercent =
                data.totalCredit <= 0
                    ? 0
                    : Math.min(Math.round((data.totalDebit / data.totalCredit) * 100), 100);

            container.innerHTML = `
                <div class="cash-summary ${statusClass}">

                    <div class="cash-summary__header">

                        <div class="cash-summary__meta">
                            <span>
                                موجودی:
                                <b>${data.totalCredit.toLocaleString()}</b>
                            </span>
                            <span>
                                هزینه شده:
                                <b>${data.totalDebit.toLocaleString()}</b>
                            </span>
                        </div>
                        <div class="cash-summary__balance-row">
                            <span class="cash-balance-badge">
                                مانده:
                                ${balance.toLocaleString()}
                                <span style="font-size: 11px">ريال</span>
                            </span>
                        </div>

                    </div>

                    <div class="cash-summary__progress">
                        <div class="cash-summary__fill" style="width:${usedPercent}%" data-bs-toggle="popover" data-bs-content="${usedPercent}%" data-bs-custom-class="popover-sm" data-bs-trigger="hover focus" data-bs-placement="right"></div>
                    </div>

                </div>
            `;
        };

        document.body.addEventListener("change", async (e) => {
            if (e.target.matches("input[name='cash_type']")) {
                modelCash._type = Number(e.target.value);
                cashTbl.ajax.reload();
            }
        });

    </script>
}
