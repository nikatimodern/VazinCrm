
@model IList<PreFactorItem>
@{
    Layout = null;
}

<div style="display:flex; flex-direction:column;width:100% ">
    @foreach (var item in Model)
    {
        <div class="mp" style="margin-bottom:5px !important ;width:100%;display:flex;flex-direction:row-reverse">
            <div class="mp InfoDataItemHead" style="display:flex">
                <label style="font-family:'IRANSansBold'">33</label>
            </div>
            <div class="mp InfoDataItem" style="display:flex;justify-content:space-between; width:100%; height:50px;direction:rtl;">
                <div style=" width:35%; display:flex;flex-direction:column;align-items:center;justify-content:center">
                    <label>شرح کالا</label>
                    <label style="font-family:'IRANSansBold'">@item.Product</label>
                </div>
                <div style="width:15%; display:flex;flex-direction:column;align-items:center;justify-content:center">
                    <label style="display:flex">تعداد/مقدار</label>
                    <label style="font-family:'IRANSansBold'">@item.WeightCount</label>
                </div>
                <div style="width:15%; display:flex;flex-direction:column;align-items:center;justify-content:center">
                    <label>واحد</label>
                    <label style="font-family:'IRANSansBold'">@item.Unit</label>
                </div>
                <div style="width:20%; display:flex;flex-direction:column;align-items:center;justify-content:center">
                    <label>مبلغ واحد</label>
                    <label style="font-family:'IRANSansBold'">@item.UnitAmount</label>
                </div>
                <div style="width:20%;display:flex;flex-direction:column;align-items:center;justify-content:center">
                    <label>مبلغ کل</label>
                    <label style="font-family:'IRANSansBold'">@item.TotalAmount</label>
                </div>
                <div class="InfoDataItemOp mp" >
                    <button class=" mp" style="color:#3f0e6e; border:none;background-color:transparent"><i class="mp fa fa-trash" onclick="delPfactorItem()" ></i></button>
                    <button class=" mp" style="color:#3f0e6e; border:none;background-color:transparent"><i class="mp fa fa-pencil" onclick="upPfactorItem()"></i></button>
                </div>
            </div>

        </div>

    }

</div>
