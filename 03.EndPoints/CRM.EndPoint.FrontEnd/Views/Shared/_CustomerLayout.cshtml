@*

let customerJuridical = @Model.Customer?.Juridical;

// customerInfoForm
        document.querySelectorAll("input[type='radio'][name='juridical']")?.forEach(el => {
            el.addEventListener("change", (e) => {
                toggleJuridicalDiv(e.target.value === "1" && @Model.PreFactor.OfficialType === 1);
                toggleAgentMeliCodeRequired(e.target.value === "0" && @Model.PreFactor.OfficialType === 1);
            });
        });
        document.getElementById("customerInfoFormSubmitBtn")?.addEventListener("click", async (e) => {
            e.preventDefault();
            if (!await mySer.CheckValidForm("customerInfoForm")) {
                Swal.fire({
                    icon: "error",
                    text: "لطفاً تمام فیلدهای ضروری را تکمیل کنید.",
                    confirmButtonText: "باشه",
                    confirmButtonColor: "#0d6efd",
                });
                return;
            }
            const data = mySer.convertFormToJSON("customerInfoForm");
            data.id = '@Model.Customer?.Id';
            const workSelect = document.querySelector("#customerInfoForm select[name='workSenf']");
            if (data.workSenf)
                data.workSenfTxt = workSelect.options[workSelect.selectedIndex].text;

            try {
                FLshowLoading();
                const res = await fetch("/Customer/UpCustomer", {
                    headers: { "Content-Type": "application/json" },
                    method: "POST",
                    body: JSON.stringify(data),
                });
                if (res.ok) {
                    Swal.fire({ icon: "success", title: "اطلاعات با موفقیت ثبت شد.", confirmButtonText: "باشه", confirmButtonColor: "#0d6efd" });
                    goTo(`/Customer/CustomerProfile?Id=@Model.Customer?.Id`);
                    FLshowLoading(false);
                }
            } catch (err) {
                console.log(err);
                setTimeout(async () => await SubmitReportForm(), 3000);
            }
        });



// customerInfoForm
    function toggleJuridicalDiv(isShow) {
        const juridicalUpDiv = document.getElementById("JuridicalUpDiv");
        if (!juridicalUpDiv) return;
        const inputsJuridicalUpDiv = juridicalUpDiv.querySelectorAll("input");
        if (isShow) {
            juridicalUpDiv.style.display = "flex";
            inputsJuridicalUpDiv.forEach(el => el.setAttribute("required", "required"));
        } else {
            juridicalUpDiv.style.display = "none";
            inputsJuridicalUpDiv.forEach(el => el.removeAttribute("required"));
            inputsJuridicalUpDiv.forEach(el => el.classList.remove("AlertReq"));
        }
    }

    function toggleAgentMeliCodeRequired(isRequired) {
        const agentMeliCodeInp = document.querySelector("input[name='agentMeliCode']");
        if (!agentMeliCodeInp) return;
        if (isRequired) {
            agentMeliCodeInp.setAttribute("required", "required");
        } else {
            agentMeliCodeInp.removeAttribute("required");
            agentMeliCodeInp.classList.remove("AlertReq");
        }
    }

    toggleJuridicalDiv(customerJuridical === 1 && @Model.PreFactor.OfficialType === 1);
    toggleAgentMeliCodeRequired(customerJuridical === 0 && @Model.PreFactor.OfficialType === 1);


*@