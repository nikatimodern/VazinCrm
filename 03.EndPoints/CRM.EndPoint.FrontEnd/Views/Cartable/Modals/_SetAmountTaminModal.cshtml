<!-- Modal SetAmountTamin -->
<div class="modal fade" id="setAmountTaminModal" tabindex="-1" data-bs-focus="false" role="dialog" data-bs-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content col-12" style="padding:8px!important;">
            <div class="d-flex align-items-center justify-content-center position-relative" style="height:32px; background: #02514C; color:white;border-radius:5px">
                <span class="modal-title fbold" style="font-size: 16px;">ورود مبلغ</span>

                @*<div data-bs-theme="dark" class="d-flex align-items-center justify-content-center top-0 bottom-0" style="position: absolute;left: 6px">
                    <button type="button" class="btn-close opacity-100" onclick="toggleSupplyModal()"></button>
                </div>*@
            </div>

            <div class="modal-body pb-0 px-1 px-md-2" style=" display:flex;flex-direction:column; justify-content:space-between; width:100% !important;">
                <div class="col-12 d-flex flex-column" style="font-size:clamp(12px,2vw,14px)">
                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex align-items-center justify-content-between gap-5">
                            <div class="d-flex gap-2 fbold" style="color: #fff">
                                <span class="badge badge-gray pf-official-badge"></span>
                                <span class="badge badge-green pf-export-badge">صادراتی</span>
                            </div>
                        </div>
                        <div id="amountTaminContainer" class="d-flex flex-column align-items-center w-100 overflow-auto" style="max-height: calc(100dvh - 230px)">
                            <div id="setAmountTaminWrapper" class="py-2 d-flex flex-column w-100">
                            </div>

                            <div style="width: 95%;min-height:1px; margin:3px auto 10px auto;background-color:#878787"></div>
                            <div id="extraTaminWrapper" class="w-100 d-flex flex-column gap-2 d-none">
                                <div class="d-flex flex-column align-items-center justify-content-around" style="background-color: #ccc;border: 1px solid #878787;border-radius: 6px;overflow: hidden">
                                    <div class="w-100 fMedium text-center p-1" style="background-color: #878787;color: #fff">
                                        هزینه اضافی
                                    </div>
                                    <div class="flex-center flex-column gap-2 w-100 p-2 px-1 px-sm-2 px-lg-3">
                                        <div class="infoContainerExtras col-12" style="font-size:clamp(11px,2.5vw,13px)">
                                        </div>
                                        <button onclick="toggleSupplyExtraItemModal()" class="buttonGray py-1 mx-auto flex-center gap-2" style="width:140px;line-height: 1" type="button">
                                            افزودن هزینه اضافی
                                            <svg style="width:16px;height:16px" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <button id="showExtraTaminWrapperBtn" onclick="toggleSupplyExtraItemModal()" class="buttonGray py-1 mx-auto flex-center gap-2" style="width:140px;line-height: 1" type="button">
                                افزودن هزینه اضافی
                                <svg style="width:16px;height:16px" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                            </button>
                            <div id="wasteTaminWrapper" class="w-100 d-flex flex-column gap-2 d-none mt-2">
                                <div class="d-flex flex-column align-items-center justify-content-around" style="background-color: #851b1d33;border: 1px solid #851b1d;border-radius: 6px;overflow: hidden">
                                    <div class="w-100 fMedium text-center p-1" style="background-color: #851b1d;color: #fff">
                                        ضایعات
                                    </div>
                                    <div class="flex-center flex-column gap-2 w-100 p-2 px-1 px-sm-2 px-lg-3">
                                        <div class="infoContainerWaste col-12" style="font-size:clamp(11px,2.5vw,13px)">
                                        </div>
                                        <button onclick="toggleSupplyWasteItemModal()" class="buttonCancel3 mt-2 py-1 mx-auto flex-center gap-2" style="width:140px;line-height: 1" type="button">
                                            افزودن ضایعات
                                            <svg style="width:16px;height:16px" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <button id="showWasteTaminWrapperBtn" onclick="toggleSupplyWasteItemModal()" class="buttonCancel3 mt-2 py-1 mx-auto flex-center gap-2" style="width:140px;line-height: 1" type="button">
                                افزودن ضایعات
                                <svg style="width:16px;height:16px" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="mx-auto my-3" style="width:98%; height:2px; background-color:#1a2d41;"></div>
                <div class="d-flex justify-content-center gap-1">
                    <button class="btnGroupBase btnRight btnRightRed" type="button" onclick="toggleSupplyModal()">انصراف</button>
                    <button class="btnGroupBase btnLeft btnLeftGreen fMedium" style="line-height: 1.1" type="button" onclick="submitSupplyModal()">ثبت</button>
                    @* <button class="btnGroupBase btnLeft btnLeftGreen fMedium" style="line-height: 1.1" type="button" onclick="nextStepTaminModal()">ثبت و بعدی</button> *@
                    @* <button id="submitAndAcceptPreFactorBtn" class="btnGroupBase btnLeftGreen btnLeft fMedium" style="line-height: 1.1" type="button" onclick="submitAndAcceptPreFactor()">ثبت و تایید پیش‌فاکتور</button> *@
                </div>

            </div>
        </div>
    </div>
</div>
