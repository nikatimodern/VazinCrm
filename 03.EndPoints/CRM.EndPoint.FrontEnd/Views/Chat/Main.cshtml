@{
    Layout = "_ChatLayout";
}


<div style="padding-bottom: 10px;height: 100%">
    <div class="email-container">
        <div id="chatList" class="email-list d-md-block" style="min-height: calc(100dvh - 90px);">
            <div class="p-2 ps-1 ps-xl-2 border-bottom d-flex align-items-center justify-content-center">
                <button class="buttonGreen1" onclick="showUsersModal()">پیام جدید</button>
            </div>
            <div id="chatListContainer" style="max-height: calc(100dvh - 160px);"></div>
        </div>

        <div id="chatContainer" class="d-none d-md-block email-content" style="height: calc(100dvh - 90px)"></div>
    </div>
</div>

<partial name="_AddChatModal" />


@section Scripts {
    <script src="~/js/chat.js?release=6.9.3" data-page-bindings="chatAttachment,editingChatId,currentMainChatId,chatContainerElm,chatListElm,otherInputElm,addChatModal,backChatList,showUsersModal,getSalesExpertUsers,initDomUsers,showChat,createMainChat,sendChat,submitOtherInput,cancelAddEmailModal,showListChats,handleChatAttach,removeChatAttach,chatDropdown,deleteChat,editChat,removeChatEdit,initChatDateSticky" asp-append-version="true"></script>
}