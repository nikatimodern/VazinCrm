@{
    Layout = "_LoginLayout";
}

<div class="erp-auth-content">
    <header class="erp-auth-heading">
        <h1>@(ViewBag.type == "Forgot" ? "بازیابی رمز عبور" : "ورود به سامانه")</h1>
        <p>@(ViewBag.type == "Forgot" ? "برای بازیابی رمز، شماره موبایل ثبت‌شده را وارد کنید." : "برای ورود سریع و امن، از کد پیامکی استفاده کنید.")</p>
    </header>

    @if (ViewBag.type != "Forgot")
    {
        <nav class="erp-auth-tabs" aria-label="روش ورود">
            <a asp-controller="Account" asp-action="OtpLogin" aria-current="page">ورود با کد یکبارمصرف</a>
            <a asp-controller="Account" asp-action="Login">ورود با نام کاربری</a>
        </nav>
    }

    <div class="w-100">
        <form id="otpLoginForm">
            <div class="form-group">
                <label for="erpOtpMobile" class="erp-auth-label">شماره موبایل</label>
                <span class="erp-phone-prefix" aria-hidden="true">۰۹</span>
                <span class="form-group__icon" aria-hidden="true">
                    <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.28 6.72 15 15 15h2.25c.62 0 1.13-.5 1.13-1.13v-2.24c0-.52-.35-.97-.85-1.1l-4.42-1.1c-.44-.11-.9.05-1.17.42l-.97 1.29a1.13 1.13 0 0 1-1.21.38 12.04 12.04 0 0 1-7.14-7.14 1.13 1.13 0 0 1 .38-1.21l1.29-.97c.36-.27.53-.73.42-1.17L6.96 3.1c-.13-.5-.58-.85-1.09-.85H4.5c-1.24 0-2.25 1.01-2.25 2.25v2.25Z"/>
                    </svg>
                </span>
                <input inputmode="numeric" autocomplete="tel-national" class="form-group__input form-group__input--ltr IranMobileNumber erp-phone-input"
                       type="text" id="erpOtpMobile" name="mobile" maxlength="9"
                       placeholder="۹۱۲۳۴۵۶۷۸" required autofocus />
            </div>
            <button id="confirmCodeOtpLoginBtn" type="submit" class="buttonGreen2 login-btn erp-auth-primary">
                <span>دریافت کد ورود</span>
                <div class="spinner-border spinner-border-sm d-none ms-2" role="status"></div>
            </button>
            <div class="erp-auth-links">
                <a asp-controller="Account" asp-action="Login">بازگشت به ورود با رمز عبور</a>
            </div>
        </form>

        <div id="otpSection" style="display:none;">
            <p class="erp-otp-note">
                کد یکبارمصرف برای شماره <strong id="phoneNumberLoginOtp"></strong> ارسال شد.
            </p>
            <div class="form-group">
                <label class="erp-auth-label" for="otpLoginInp">کد تأیید چهاررقمی</label>
                <span class="form-group__icon" aria-hidden="true">
                    <svg fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.03 5.91c-.56-.1-1.16.03-1.56.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.82c0-.6.24-1.17.66-1.59l6.5-6.5c.4-.4.53-1 .43-1.56a6 6 0 1 1 11.91-.78Z"/>
                    </svg>
                </span>
                <input inputmode="numeric" class="form-group__input form-group__input--ltr erp-otp-input"
                       id="otpLoginInp" name="otp" autocomplete="one-time-code" type="text"
                       maxlength="4" placeholder="••••" />
            </div>
            <button id="verifyOtpBtn" type="button" class="buttonGreen2 login-btn erp-auth-primary">
                <span>تأیید کد و ادامه</span>
                <div class="spinner-border spinner-border-sm d-none ms-2" role="status"></div>
            </button>
        </div>

        <div class="erp-otp-status">
            <p class="errorLoginText" id="otpLoginMsg" role="alert" aria-live="polite"></p>
            <button id="resendOtpBtn" type="button" class="buttonPurple2 erp-resend" style="display:none">ارسال مجدد کد</button>
            <p class="text-muted" id="remainingCodeOtpLoginId" style="display:none;align-items:baseline;gap:4px;direction:rtl;justify-content:end">
                <span>زمان باقی‌مانده:</span>
                <strong id="remainingSecondsOtpLogin"></strong>
            </p>
        </div>
    </div>
</div>

@section Scripts {

    <script defer>
        let intervalId;
        let mobileVerified;
        let selectedUserId;
        let otpVerifyPending = false;
        let otpBtn = document.getElementById("verifyOtpBtn");
        let mobileLoginBtn = document.getElementById("confirmCodeOtpLoginBtn");

        // Persian numerals in UI, normalized ASCII digits in backend requests.
        // Scoped to login inputs; no global number-handler changes.
        function formatOtpDisplayDigits(input, maxLength) {
            const before = input.value;
            const caret = input.selectionStart;
            const normalized = toEnglishDigits(before).replace(/\D/g, "").slice(0, maxLength);
            input.value = toPersianDigits(normalized);
            if (caret !== null && document.activeElement === input) {
                const position = Math.min(
                    toEnglishDigits(before.slice(0, caret)).replace(/\D/g, "").length,
                    maxLength
                );
                input.setSelectionRange(position, position);
            }
        }

        const mobileInput = document.getElementById("erpOtpMobile");
        const codeInput = document.getElementById("otpLoginInp");
        mobileInput.addEventListener("input", () => formatOtpDisplayDigits(mobileInput, 9));
        codeInput.addEventListener("input", () => formatOtpDisplayDigits(codeInput, 4));

        document.addEventListener("DOMContentLoaded", async () => {
            const input = document.querySelector("#otpSection input[autocomplete='one-time-code']");
            await readOtp(input, otpBtn);
        });


        document.getElementById("otpLoginForm").addEventListener("submit", function (e) {
            e.preventDefault();
            toggleElementsDisabled(mobileLoginBtn);
            mobileLoginBtn.querySelector(".spinner-border").classList.remove("d-none");

            if (toEnglishDigits(this.mobile.value).length < 9) {
                document.getElementById("otpLoginMsg").textContent = "شماره موبایل معتبر نیست!";
                mobileLoginBtn.querySelector(".spinner-border").classList.add("d-none");
                toggleElementsDisabled(mobileLoginBtn, false);
                return;
            }
            const mobile = "09" + toEnglishDigits(this.mobile.value);

            fetch(`/Account/RequestOtp?type=@ViewBag.type`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ mobile }),
            })
                .then(res => res.json())
                .then(data => {
                    if (data.status === 200) {
                        mobileVerified = mobile;
                        sessionStorage.setItem("mobileVerified", JSON.stringify(mobileVerified));
                        document.getElementById("otpLoginMsg").innerText = "";
                        document.getElementById("phoneNumberLoginOtp").innerText = toPersianDigits(mobileVerified);
                        document.getElementById("otpLoginForm").style.display = "none";
                        document.getElementById("otpSection").style.display = "block";
                        document.getElementById("otpLoginInp").value = "";
                        document.getElementById("otpLoginInp").focus();
                        document.getElementById("remainingCodeOtpLoginId").style.display = "flex";
                        document.getElementById("historyBackIcon").classList.remove("d-none");
                        history.pushState({ step: "otp" }, "", "/Account/OtpLogin#otp");

                        toastifySuccess(data.message);
                        startOtpTimer();
                    } else {
                        document.getElementById("otpLoginMsg").innerText = toPersianDigits(data.message);
                        if (data.retryAfterSeconds > 0) {
                            mobileVerified = mobile;
                            sessionStorage.setItem("mobileVerified", JSON.stringify(mobile));
                            startOtpTimer();
                        }
                    }
                    mobileLoginBtn.querySelector(".spinner-border").classList.add("d-none");
                    toggleElementsDisabled(mobileLoginBtn, false);
                });
        });

        window.addEventListener("popstate", (e) => {
            if (!e.state || e.state.step !== "otp") {
                clearInterval(otpIntervalId);
                otpTimerVersion++;
                mobileLoginBtn.disabled = false;
                document.getElementById("otpLoginMsg").innerText = "";
                document.getElementById("remainingCodeOtpLoginId").style.display = "none";

                document.getElementById("otpLoginForm").style.display = "block";
                document.getElementById("otpSection").style.display = "none";
                document.getElementById("resendOtpBtn").style.display = "none";

                document.getElementById("historyBackIcon").classList.add("d-none");
            }
        });

        window.addEventListener("load", () => {
            if (location.hash === "#otp") {
                mobileVerified = JSON.parse(sessionStorage.getItem("mobileVerified") || "null");
                if (!mobileVerified) {
                    history.replaceState(null, "", "/Account/OtpLogin");
                    return;
                }
                document.getElementById("phoneNumberLoginOtp").innerText = toPersianDigits(mobileVerified);
                document.getElementById("otpLoginForm").style.display = "none";
                document.getElementById("otpSection").style.display = "block";
                document.getElementById("remainingCodeOtpLoginId").style.display = "flex";
                history.replaceState({ step: "otp" }, "", location.href);
                startOtpTimer();
            }
        });

        otpBtn.addEventListener("click", () => verifyOtp());
        document.getElementById("otpLoginInp").addEventListener("keyup", (e) => {
            if (e.target.value.length >= 4 || e.key === "Enter") {
                verifyOtp();
            }
        });

        const otpLoginMsgElm = document.getElementById("otpLoginMsg");
        function verifyOtp() {
            if (otpVerifyPending || otpBtn.style.display === "none") return;
            otpVerifyPending = true;
            const inpMobileValue = document.querySelector("input[name='mobile']").value;
            const mobile = inpMobileValue ? "09" + toEnglishDigits(inpMobileValue) : JSON.parse(sessionStorage.getItem("mobileVerified"));
            const OtpCode = toEnglishDigits(document.querySelector("input[name='otp']").value);
            toggleElementsDisabled(otpBtn);
            otpBtn.querySelector(".spinner-border").classList.remove("d-none");

            fetch(`/Account/VerifyOtpGeneric?type=@ViewBag.type`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ mobile, OtpCode }),
            }).then(res => res.json())
              .then(data => {
                  if (data.status === 300) {
                      mobileVerified = mobile;
                      showAccountModal(data.accounts);
                  } else if (data.status === 200) {
                      otpLoginMsgElm.innerText = "";
                      sessionStorage.removeItem("mobileVerified");
                      goTo(data.url);
                  } else if (data.status === 405) {
                      data.errors.forEach(err => {
                          const pElm = document.createElement("p");
                          pElm.innerText = toPersianDigits(err);
                          otpLoginMsgElm.appendChild(pElm);
                      });
                  } else {
                      otpLoginMsgElm.innerText = toPersianDigits(data.message);
                      if (data.retryAfterSeconds > 0 || data.status === 401) startOtpTimer();
                  }
              }).catch(() => {
                  otpLoginMsgElm.innerText = "ارتباط با سرور برقرار نشد. دوباره تلاش کنید.";
              }).finally(() => {
                  otpVerifyPending = false;
                  otpBtn.querySelector(".spinner-border").classList.add("d-none");
                  toggleElementsDisabled(otpBtn, false);
              });
        }

        let otpIntervalId;
        let otpTimerVersion = 0;
        function startOtpTimer() {
            clearInterval(otpIntervalId);
            const timerVersion = ++otpTimerVersion;
            let wasLocked = false;
            const mobile = mobileVerified || JSON.parse(sessionStorage.getItem("mobileVerified") || "null");
            if (!mobile) return;

            async function tick() {
                try {
                    const response = await fetch(`/Account/CheckTimerCode?type=@ViewBag.type&mobile=${encodeURIComponent(mobile)}`);
                    const data = await response.json();
                    if (timerVersion !== otpTimerVersion) return;
                    if (data.status === true) {
                        wasLocked = wasLocked || data.isLocked;
                        document.getElementById("remainingSecondsOtpLogin").innerText = toPersianDigits(data.elsapsTime) + " ثانیه";
                        document.getElementById("remainingCodeOtpLoginId").style.display = "flex";
                        document.getElementById("resendOtpBtn").style.display = "none";
                        mobileLoginBtn.disabled = true;
                        otpBtn.style.display = data.isLocked ? "none" : "flex";
                        if (data.isLocked && !otpLoginMsgElm.innerText)
                            otpLoginMsgElm.innerText = "تلاش‌های ناموفق بیش از حد مجاز؛ پس از پایان زمان کد جدید دریافت کنید.";
                    } else {
                        clearInterval(otpIntervalId);
                        document.getElementById("remainingCodeOtpLoginId").style.display = "none";
                        otpBtn.style.display = "none";
                        mobileLoginBtn.disabled = false;
                        if (wasLocked)
                            otpLoginMsgElm.innerText = "زمان مسدودیت پایان یافت؛ برای ادامه کد جدید دریافت کنید.";
                        document.getElementById("resendOtpBtn").style.display =
                            document.getElementById("otpSection").style.display === "block" ? "flex" : "none";
                    }
                } catch (error) {
                    console.error("OTP timer check failed", error);
                }
            }

            tick();
            otpIntervalId = setInterval(tick, 1000);
        }

        document.getElementById("resendOtpBtn").addEventListener("click", () => {
            mobileVerified = JSON.parse(sessionStorage.getItem("mobileVerified"));
            fetch(`/Account/RequestOtp?type=@ViewBag.type`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ mobile: mobileVerified, userId: selectedUserId }),
            })
                .then(res => res.json())
                .then(data => {
                    if (data.status === 200) {
                        document.getElementById("otpLoginMsg").innerText = "";
                        document.getElementById("otpLoginInp").value = "";
                        document.getElementById("otpLoginInp").focus();
                        toastifySuccess("کد یکبار مصرف مجددا ارسال شد");
                        startOtpTimer();
                    } else {
                        document.getElementById("otpLoginMsg").innerText = toPersianDigits(data.message);
                        if (data.retryAfterSeconds > 0) startOtpTimer();
                    }
                });
        });


        function showAccountModal(accounts) {
            const listContainer = document.getElementById("accountList");
            listContainer.innerHTML = "";

            accounts.forEach(acc => {
                const btn = document.createElement("button");
                btn.type = "button";
                btn.className = "list-group-item list-group-item-action";
                btn.innerHTML = `
                    <span class="fbold" style="font-size: 14px">${acc.userName}</span>
                    <br>
                    <span style="font-size: 11px">${acc.fullName || ""}</span>
                `;

                btn.addEventListener("click", () => {
                    toggleElementsDisabled(otpBtn);
                    otpBtn.querySelector(".spinner-border").classList.remove("d-none");
                    fetch(`/Account/SelectAccount?userId=${acc.id}&type=@ViewBag.type`)
                        .then(res => res.json())
                        .then(data => {
                            if (data.status === 200) {
                                selectedUserId = acc.id;
                                $("#selectAccountModal").modal("toggle");
                                goTo(data.url);

                            } else {
                                toastifyError(data.message);
                            }
                            otpBtn.querySelector(".spinner-border").classList.add("d-none");
                            toggleElementsDisabled(otpBtn, false);
                        });
                });

                listContainer.appendChild(btn);
            });

            $("#selectAccountModal").modal("toggle");
        }


    </script>
}