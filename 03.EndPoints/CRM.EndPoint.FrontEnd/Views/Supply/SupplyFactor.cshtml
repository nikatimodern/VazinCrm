<div class="w-100">
    <div class="row align-items-center justify-content-between flex-wrap mb-2 g-2">
        <div class="d-flex col-lg-3">
            <button class="buttonGray2 d-flex align-items-center gap-1" style="padding: 4px 8px" onclick="showSupplyFactorModal()">
                <span style="line-height: 1">ثبت فاکتور جدید</span>
                <svg style="width: 20px" viewBox="0 0 20 20" fill="currentColor"><path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" /></svg>
            </button>
        </div>
        <div class="col-12 col-lg-5 d-flex align-items-center gap-2 flex-wrap">
            <div class="search-group flex-grow-1">
                <input class="form-control" id="supplyFactorSearch" placeholder="جستجو">
                <div class="search-icon">
                    <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z" clip-rule="evenodd" /></svg>
                </div>
            </div>
        </div>
        <div class="d-flex align-items-start justify-content-start justify-content-lg-end gap-2 col-lg-3">
            @*<div id="ContentDealFilterId" class="ContentFilter"></div>
            <div class="btnFilter d-none d-lg-flex" data-filterVarConfig="filterDealConfig" data-filterCallBack="callbackFilterDeal" data-filterContentId="ContentDealFilterId" data-filterInpSearchId="dealSearchId" data-filterVarSearch="dealSearchVal" onclick="ShowFilterPopup(this)">
                <svg style="width:24px;color:#333" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M3.792 2.938A49.069 49.069 0 0 1 12 2.25c2.797 0 5.54.236 8.209.688a1.857 1.857 0 0 1 1.541 1.836v1.044a3 3 0 0 1-.879 2.121l-6.182 6.182a1.5 1.5 0 0 0-.439 1.061v2.927a3 3 0 0 1-1.658 2.684l-1.757.878A.75.75 0 0 1 9.75 21v-5.818a1.5 1.5 0 0 0-.44-1.06L3.13 7.938a3 3 0 0 1-.879-2.121V4.774c0-.897.64-1.683 1.542-1.836Z" clip-rule="evenodd"></path></svg>
            </div>*@
        </div>
    </div>
    <div id="supplyFactorsContainer"></div>
</div>


<partial name="Modals/_SupplyFactorModal" />
<partial name="Modals/_SupplyFactorItemModal" />

@section Scripts {
    <script src="~/js/supplyFactor.js" asp-append-version="true" data-page-bindings="orderHeadsSupFactorSelectedIds,supplyFactorData,sfItemIndex,incompleteSfItemsCount,supplyFactorDiscountInp,supplyFactorAttInpId,showSupplyFactorModal,initSupplyFactorModal,cancelSupplyFactorModal,addSfItem,calculateSupplyFactorTotals,sfFieldRules,showSupplyFactorItems,deleteSfItem,showUpdateSfItem,updateSfItem,cancelUpdateSfItem,addItemSupplyFactor,canselModalItemSupplyFactor,proccessSupplyFactorWithAi,updateSupplyFactorValidationState,showAddOrderHeadSfModal,getOrderHeadIdsBySupplier,isSetupSupplyTomSelect,setupSelectOptions,submitSupplyFactorModal,getSupplyFactor,showEditSupplyFactorModal,deleteSupplyFactor,sfAllocationState,sfAllocationPerspective,sfAllocationIsSales,sfAllocationSaving,sfAllocationChoosing,sfAllocationSelector,sfAllocationRequest,sfAllocationAbort,sfAllocationOrigin,sfAllocationInvoiceId,sfAllocationFilter,sfAllocationCurrentItemId,sfAllocationOpen,sfAllocationDrafts,sfPickerTab,sfPickerData,sfPickerTargets,sfPickerForm,sfPickerAbort,sfPickerRequest,sfPickerTimer,sfPickerLoading,sfAllocationText,sfAllocationEscape,sfAllocationNumber,sfAllocationRemaining,sfAllocationNormalize,sfAllocationIcon,sfAllocationSalesWeight,sfAllocationDisplayRecord,sfAllocationTargetLabel,sfAllocationSalesCapacity,sfAllocationSkeleton,sfAllocationEmpty,ensureSupplyAllocationUI,sfAllocationRefreshNeeded,sfAllocationFeedback,showSalesFactorAllocations,showSupplyAllocations,loadSupplyAllocations,sfAllocationCapacity,updateSupplyAllocationLimit,captureSupplyAllocationDrafts,sfAllocationForm,renderSupplyAllocations,renderSupplyAllocationRecords,filterSupplyAllocationItems,navigateSupplyAllocationItem,loadSupplyAllocationPicker,renderSupplyAllocationPicker,updateSupplyPickerSelection,selectSupplyAllocationFactor,clearSupplyAllocationFormError,supplyAllocationFormError,submitSupplyAllocation,persistSupplyAllocation,deleteSupplyAllocation,retrySupplyAllocations"></script>
    <script data-page-bindings="getAllSupplyFactors">
        document.addEventListener("DOMContentLoaded", async () => {
            await getAllSupplyFactors();

            initSearchInput("supplyFactorSearch", getAllSupplyFactors);
        });

        const getAllSupplyFactors = async () => {
            const val = document.getElementById("supplyFactorSearch")?.value.trim() ?? "";
            const res = await sendApiRequest({ url: "/Supply/GetAllSupplyFactorsPartial", params: { search: val }, returnFullResponse: true, skeleton: { target: "#supplyFactorsContainer", retry: getAllSupplyFactors } });
            if (!res) return;
            document.getElementById("supplyFactorsContainer").innerHTML = res.data;

        };
    </script>
}