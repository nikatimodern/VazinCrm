@model List<CRM.EndPoint.FrontEnd.Models.ViewModel.Supply.SupplyPaymentVModel>

@if (Model.Count != 0) {
    <table id="supplyPaymentTable" class="paymentTable table table-striped table-bordered table-hover no-footer nowrap">
        <thead>
        <tr>
            <th>شماره</th>
            <th>مبلغ</th>
            <th>از حساب</th>
            <th>به حساب</th>
            <th>نوع</th>
            <th>تاریخ</th>
            <th>فاکتور تامین</th>
            <th>ثبت توسط</th>
            <th>عملیات</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model) {
            var payment = item.Payment;
            var supplyFactorSerials = item.SupplyFactorSerials;
            <tr>
                <td></td>
                <td>@payment.Amount</td>
                <td>@payment.FromAccount</td>
                <td>@payment.ToAccount</td>
                <td>@payment.PaymentTypeTxt</td>
                <td>@payment.PaymentDateTxt</td>
                <td>@payment.UserCreator</td>
                <td>@string.Join(", ", supplyFactorSerials)</td>
                <td>

                </td>
            </tr>
        }
        </tbody>
    </table>
} else {
    <div class="d-flex flex-column align-items-center pb-4">
        <img src="/Img/no-data.jpg" style="width: clamp(120px, 20vw, 180px)" alt="">
        <div style="color: #506a77;font-size: clamp(13px, 2.5vw, 15px)">هیچ پرداختی برای نمایش وجود ندارد!</div>
    </div>
}