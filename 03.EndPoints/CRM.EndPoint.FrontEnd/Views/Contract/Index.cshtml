                <label class="fbold">ثبت قرارداد جدید</label>
            </div>
            <div class=" modal-body" style=" display:flex;flex-direction:column; justify-content:center;align-items:center; width:100% !important;">
                <form class=" InfoData row col-md-12" id="FormContractId" style="justify-content:center; padding:10px; ">
                    <div class="form-group col-md-4">
                        <label>عنوان قرارداد</label>
                        <input class=" form-control" type="text" name="cTitle" required />
                    </div>

                    <div class="form-group col-md-2">
                        <label>پیمانکار</label>
                        <input class=" form-control" type="text" name="contractor" required />
                    </div>

                    <div class="form-group col-md-2">
                        <label>کارفرما</label>
                        <input class=" form-control" type="text" name="employer" required />
                    </div>
                    @*            <div class="col-md-3">

                    <label>مشتری</label>
                    <select class="form-control " id="customer" name="customer" placeholder="نام مشتری" required tabindex="1">
                    </select>

                    </div>*@

                    <div class="form-group col-md-2">
                        <label>از تاریخ</label>
                        <input class="sdate form-control " style="direction:ltr;" type="text" placeholder="yyyy/mm/dd" data-slots="ymd" data-name="dtp2-text" name="fromDateSh" required />
                        @* <input  type="text"  class="sdate mp form-control" id="VisitLocationId" name="FirstVisitDate"> *@
                    </div>

 


                    <div class="form-group col-md-2">
                        <label>تا تاریخ</label>
                        <input class="sdate form-control" style="direction:ltr;" type="text" placeholder="yyyy/mm/dd" data-slots="ymd" data-name="dtp2-text" name="toDateSh" required />
                    </div>
                    <div class="form-group col-md-12">
                        <label>توضیحات</label>
                        <textarea class="form-control" name="description" style=" text-align:start; height:100px !important" ></textarea>
                    </div>
                    <div class="form-group col-12" style="margin-top:10px;">
                        <div class="fmp ">
                            <div style="display:flex;justify-content:center">
                                <div class="mp col-12" >
                                    <div class="mp col-md-12 container-uploader">
                                        <input type="file" class="uploadBtn" data-varList="Attachments" data-showList="AddimageDisplayContract" id="AddContractAtID" multiple accept="*" />
                                        <label for="AddContractAtID">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                                            <span>فایل قرارداد</span>
                                        </label>
                                        <div class="image-display" id="AddimageDisplayContract"></div>
                                    </div>
                                </div>
                                <button class="AddFile_Btn buttonGreen" id="AddFile_BtnId" style="display:none"><i class="fas fa-plus AttachBt "></i></button>
                            </div>

                        </div>
                    </div>



                </form>

                <div style="margin-top:10px; width:100%; display:flex;justify-content:center">
                    <button class="button" style="border-radius:5px" onclick="$('#AddContractModal').modal('toggle') ">انصراف</button>
                    <button class="buttonGreen" style="border-radius:5px" onclick="SubmitContract()">ثبت</button>

                </div>
            </div>
        </div>
    </div>
</div>

