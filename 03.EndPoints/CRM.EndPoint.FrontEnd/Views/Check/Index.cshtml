@model List<CRM.EndPoint.FrontEnd.Models.Check.CheckbookVModel>

@{
    Layout = "_Layout";
    var hasCheckbookId = Context.Request.Query.ContainsKey("cBook");
}

<div>
    <div id="checkbooks-section" class="@(hasCheckbookId ? "d-none" : "")">
        <div class="d-flex align-items-center gap-2 mb-3">
            <span class="section-title-dot"></span>
            <h5 class="fbold text-dark m-0">دسته چک‌ها</h5>
        </div>

        <div id="checkbooksContainer">
            <partial name="GetAllCheckbooksPartial" model="Model" />
        </div>
    </div>

    <div id="checks-section" class="@(hasCheckbookId ? "" : "d-none")">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div class="d-flex align-items-center gap-2">
                <span class="section-title-dot"></span>
                <h5 id="selected-checkbook-title" class="fbold text-dark m-0">لیست چک‌ها</h5>
            </div>
            <div class="section-actions d-flex gap-2 flex-grow-1 justify-content-end">
                <button class="buttonGreen0" onclick="openNewCheckModal()">
                    ثبت چک جدید
                    <svg style="width: 18px" viewBox="0 0 20 20" fill="currentColor"><path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" /></svg>
                </button>
                <button class="buttonCancel-white" onclick="backToCheckbooks()">
                    بازگشت
                    <svg style="width: 16px" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M3.5 9.75A2.75 2.75 0 0 1 6.25 7h5.19L9.22 9.22a.75.75 0 1 0 1.06 1.06l3.5-3.5a.75.75 0 0 0 0-1.06l-3.5-3.5a.75.75 0 1 0-1.06 1.06l2.22 2.22H6.25a4.25 4.25 0 0 0 0 8.5h1a.75.75 0 0 0 0-1.5h-1A2.75 2.75 0 0 1 3.5 9.75Z" clip-rule="evenodd" /></svg>
                </button>
            </div>
        </div>

        <div>
            <table id="checksTable" class="table-hover table table-bordered nowrap table-striped">
                <thead>
                <tr>
                    <th>شماره سریال</th>
                    <th>شماره صیادی</th>
                    <th>مبلغ <span style="font-size: 11px">(ريال)</span></th>
                    <th>تاریخ سررسید</th>
                    <th>در وجه</th>
                    <th>توضیحات</th>
                    <th>وضعیت</th>
                    <th>عملیات</th>
                </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>


<partial name="Modals/_CheckbookModal" />
<partial name="Modals/_NewCheckModal" />


@section Scripts {
    <script src="~/js/check.js?release=6.9.5" data-page-bindings="checksDataTable,checkData,payeeCheckTomSelect,checkbooksSection,checkSection,syncCheckViewWithUrl,GetAllCheckbooks,showNewCheckbookModal,cancelNewCheckbookModal,submitCheckbookModal,initCheckbookTable,getCheckStatusBadgeClass,showChecks,backToCheckbooks,openNewCheckModal,submitCheckForm,cancelNewCheckModal,editCheck,getCheck,deleteCheck,deleteCheckbook,checkbookDropdown,initSelectTomCheck" asp-append-version="true"></script>
}

