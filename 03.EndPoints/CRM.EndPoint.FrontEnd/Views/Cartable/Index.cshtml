        <div id="CartableTabs" style="display:flex;justify-content:center;flex-wrap:wrap-reverse">
            <div class="TCar" id="TPrefactorFactorId" onclick="GetCartable('TPrefactorFactorId')">
                <p>پیش فاکتور و فاکتور</p>
            </div>
            <div class="TCar position-relative" id="TFinancialExpertId" onclick="GetCartable('TFinancialExpertId')">
                <span class="badgeCircle d-none" style="position: absolute;top: -6px;left: 0;z-index: 10;color: #fff"></span>
                <p>کارشناس مالی</p>
            </div>
            <div class="TCar" id="TFinancialAdminId" onclick="GetCartable('TFinancialAdminId')">
                <p>مدیر مالی</p>
            </div>
            <div class="TCar position-relative" id="TSalesExpertId" onclick="GetCartable('TSalesExpertId')">
                <span class="badgeCircle d-none" style="position: absolute;top: -6px;left: 0;z-index: 10;color: #fff"></span>
                <p>کارشناس فروش</p>
            </div>
            <div class="TCar position-relative" id="TSalesAdminId" onclick="GetCartable('TSalesAdminId')">
                <span class="badgeCircle d-none" style="position: absolute;top: -6px;left: 0;z-index: 10;color: #fff"></span>
                <p>مدیر فروش</p>
            </div>
            <div class="TCar position-relative" id="TTaminExpertId" onclick="GetCartable('TTaminExpertId')">
                <span class="badgeCircle d-none" style="position: absolute;top: -6px;left: 0;z-index: 10;color: #fff"></span>
                <p>کارشناس تامین</p>
            </div>
            <div class="TCar position-relative" id="TManagingDirectorId" onclick="GetCartable('TManagingDirectorId')">
                <span class="badgeCircle d-none" style="position: absolute;top: -6px;left: 0;z-index: 10;color: #fff"></span>
                <p>مدیر عامل</p>
            </div>
        </div>

