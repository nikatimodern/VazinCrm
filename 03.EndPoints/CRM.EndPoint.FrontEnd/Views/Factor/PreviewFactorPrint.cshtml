@model CRM.EndPoint.FrontEnd.Models.Factor.FactorViewModel
@{
    Layout = null;
    var isOfficial = Model.Factor.OfficialType == 1;
    var isJuridical = Model._Customer?.Juridical == 1;
}

<!DOCTYPE html>

<html lang="fa">
<head>
    <meta charset="utf-8">
    <title>فاکتور @Model.Factor.SerialNumber</title>

    <link rel="stylesheet" href="~/lib/Bootstrap/bootstrap5.3.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css?v=2.9.6" />
    <link rel="stylesheet" href="~/css/normalize.min.css">
    <link rel="stylesheet" href="~/css/paper.css?v=2.9.6">
</head>

<body dir="rtl" class="A4 landscape">

<section class="sheet d-flex" style="border-radius:12px">
    <article class="d-flex flex-column flex-grow-1 m-3" style="border: 2px solid gray; border-radius:8px; padding: 10px">

        <div class="d-flex justify-content-between align-items-center w-100">
            <div style="width: 120px">
                @if (isOfficial) {
                    <img src="@Model.Logo" style="width:100%" alt="Logo" />
                }
            </div>
            <p class="fbold" style="font-size:24px">فاکتور فروش کالاوخدمات</p>
            <div class="py-2" style="width:135px">
                <div class="d-flex align-items-center w-100">
                    <label class="w-50 text-muted text-end">شماره سریال:</label>
                    <label class="w-50 fbold text-center">@Model.Factor.SerialNumber</label>
                </div>
                <div class="d-flex align-items-center w-100">
                    <label class="w-50 text-muted text-end">تاریخ:</label>
                    <label class="w-50 fbold text-center">@Model.Factor.Date</label>
                </div>
            </div>
        </div>


        <div>
            <p class="w-100 text-center fbold" style="border-radius:5px; border:2px solid gray; background-color:lightgray;">
                مشخصات فروشنده
            </p>
            <div class="px-1">
                <div class="d-flex align-items-center w-100">
                    <div class="col-4 d-flex align-items-center gap-2">
                        <label class="text-muted">نام فروشنده: </label>
                        <label class="fbold">@(isOfficial ? Model.Company.CompanyName : Model.Company.CompanyBrandName)</label>
                    </div>
                    <div class="col-4 d-flex align-items-center gap-2">
                        <label class="text-muted">شماره اقتصادی: </label>
                        <label class="fbold">@(isOfficial ? Model.Company.EghtesadiCode : "")</label>
                    </div>
                    <div class="col-4 d-flex align-items-center gap-2">
                        <label class="text-muted">شماره ملی/شماره ثبت: </label>
                        <label class="fbold">@(isOfficial ? Model.Company.NumberRegister : "")</label>
                    </div>
                </div>
                <div class="d-flex align-items-center w-100">
                    <div class="col-4 d-flex align-items-center gap-2">
                        <label class="text-muted">شناسه ملی: </label>
                        <label class="fbold">@(isOfficial ? Model.Company.ShenaseMeli : "")</label>
                    </div>
                    <div class="col-4 d-flex align-items-center gap-2">
                        <label class="text-muted">کدپستی: </label>
                        <label class="fbold">@(isOfficial ? Model.Company.PostalCode : "")</label>
                    </div>
                    <div class="col-4 d-flex align-items-center gap-2">
                        <label class="text-muted">تلفن: </label>
                        <label class="fbold">
                            @if (isOfficial) {
                                @Model.Company.Mobile @Model.Company.Tel
                            }
                        </label>
                    </div>
                </div>
                <div class="d-flex align-items-center w-100">
                    <div class="col-12 d-flex align-items-center gap-2">
                        <label class="text-muted">نشانی: </label>
                        <label class="fbold">@(isOfficial ? Model.Company.Address : "")</label>
                    </div>
                </div>
            </div>
        </div>

        @*////////////////*@

        <div>

            <div class="w-100 text-center fbold position-relative" style="border-radius:5px; border:2px solid gray; background-color:lightgray;">
                <p>مشخصات خریدار</p>
                <div id="upHeadFactorIcon" class="align-items-center justify-content-center position-absolute" style="display: flex;left: 4px;right: auto;top: 0;bottom: 0" data-title="بروزرسانی" onclick="upHeadFactor('@Model.Factor.Id')">
                    <svg style="width: 16px" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
                </div>
            </div>

            <div class="px-1">
                <div class="d-flex align-items-center w-100">
                    <div class="col-4 d-flex align-items-center gap-2">
                        <label class="text-muted">نام خریدار: </label>
                        <label class="fbold">
                            @(isJuridical ? Model.Factor.Customer : Model.Factor.AgentName)
                        </label>
                    </div>
                    <div class="col-4 d-flex align-items-center gap-2">
                        <label class="text-muted">شماره اقتصادی: </label>
                        <label class="fbold">@(isOfficial && isJuridical ? Model.Factor.Cus_EghtesadiCode : "")</label>
                    </div>
                    <div class="col-4 d-flex align-items-center gap-2">
                        <label class="text-muted">شماره ملی/شماره ثبت: </label>
                        <label class="fbold">
                            @(isOfficial
                                ? (isJuridical ? Model.Factor.Cus_NumberRegister : Model.Factor.AgentMeliCode)
                                : "")
                        </label>
                    </div>
                </div>
                <div class="d-flex align-items-center w-100">
                    <div class="col-4 d-flex align-items-center gap-2">
                        <label class="text-muted">شناسه ملی: </label>
                        <label class="fbold">
                            @(isOfficial
                                ? (isJuridical ? Model.Factor.Cus_ShenaseMeli : Model.Factor.AgentMeliCode) @* در دست اصلاح *@
                                : "")
                        </label>
                    </div>
                    <div class="col-4 d-flex align-items-center gap-2">
                        <label class="text-muted">کدپستی: </label>
                        <label class="fbold">@Model.Factor.Cus_PostalCode</label>
                    </div>
                    <div class="col-4 d-flex align-items-center gap-2">
                        <label class="text-muted">تلفن: </label>
                        <label class="fbold">@Model.Factor.Cus_Mobile @Model.Factor.Cus_Tel</label>
                    </div>
                </div>
                <div class="d-flex align-items-center w-100">
                    <div class="col-12 d-flex align-items-center gap-2">
                        <label class="text-muted">نشانی: </label>
                        <label class="fbold">@Model.Factor.Cus_Address</label>
                    </div>
                </div>
            </div>
        </div>

        @*////////////////*@

        <div>
            <p class="w-100 text-center fbold" style="border-radius:5px; border:2px solid gray; background-color:lightgray;">
                مشخصات کالا یا خدمات مورد معامله
            </p>
            <div class="w-100">
                <table class="table table-bordered table-hover m-0 w-100 @(Model.Factor.FactorItems?.Count >= 5 ? "table-sm" : "")" style="border-color: gray">
                    <thead>
                    <tr>
                        <th>ردیف</th>
                        <th>شرح کالا/خدمت</th>
                        <th>تعداد/مقدار</th>
                        <th>واحد</th>
                        <th>مبلغ واحد</th>
                        <th>مبلغ کل</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Factor.FactorItems) {
                        <tr>
                            <td>@item.Row</td>
                            <td>
                                @item.ProductSmallName @item.Product
                                @(item.Printable == 1 ? " (چـاپدار)" : "")
                            </td>
                            <td>@item.WeightCount</td>
                            <td>@item.UnitTxt</td>
                            <td>@($"{item.UnitAmount:n0}")</td>
                            <td>@($"{item.TotalAmount:n0}")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-flex justify-content-end w-100">
            <div class="col-5" style="background-color:lightgray">
                <div class="d-flex align-items-center" style="border:1px solid gray">
                    <label class="col-6 text-center">جمع: </label>
                    <label class="col-6 text-center fbold">@($"{Model.Factor.SumTotalAmount:n0}")</label>
                </div>
                <div class="d-flex align-items-center" style="border:1px solid gray">
                    <label class="col-6 text-center">تخفیف: </label>
                    <label class="col-6 text-center fbold">@($"{Model.Factor.Discount:n0}")</label>
                </div>
                <div class="d-flex align-items-center" style="border:1px solid gray">
                    <label class="col-6 text-center">مالیات و عوارض: </label>
                    <label class="col-6 text-center fbold">@($"{Model.Factor.TotalTax:n0}")</label>
                </div>
                <div class="d-flex align-items-center" style="font-size:18px; border:1px solid gray">
                    <label class="col-6 text-center">جمع کل: </label>
                    <label class="col-6 text-center fbold">
                        <span>@($"{(Model.Factor.SumTotalAmount + Model.Factor.TotalTax - Model.Factor.Discount):n0}")</span>
                        <span style="font-size: 16px">ريال</span>
                    </label>
                </div>
            </div>
        </div>

        @*<div style="display:flex; ">
            <div style="display:flex; width:40%;border:1px solid gray;padding:5px;">
                <div style="width:50%;">
                    <p style="font-family:'IRANSansBold'">شرایط و نحوه فروش:</p>
                </div>
                <div style="width:50%; display:flex;justify-content:space-around">
                    <p>نقدی</p>
                    <p>غیر نقدی</p>
                </div>
            </div>
        </div>*@

        <div class="d-flex flex-column flex-grow-1" style="border:1px solid gray">
            <div class="d-flex flex-column" style="border-bottom:1px solid gray">
                <label class="fbold ps-1 pt-1">توضیحات:</label>
                <ul style="padding-right: 22px">
                    @foreach (var item in Model.Factor.Descriptions) {
                        <li>@item.Text</li>
                    }
                </ul>
            </div>

            <div class="d-flex flex-grow-1">
                <div class="d-flex flex-column align-items-center col-6" style="border-left:1px solid gray ">
                    <label class="mb-2">مهر و امضای فروشنده</label>
                    @*<img style="width:30%;" src="@(isOfficial ? Model.MohrR : Model.Mohr)" />*@
                </div>
                <div class="d-flex flex-column align-items-center col-6">
                    <label class="mb-2">مهر و امضای خریدار</label>
                    @*<img style="width:30%;" src="@Model.Siq" />
                    <label class="fbold mt-2">@Model.Factor.SignatureDes</label>*@
                </div>
            </div>
        </div>


    </article>
</section>

<div class="d-flex flex-column align-items-center justify-content-center w-100" style="position:fixed;top:80%;" id="previewPrintBtns">
    <div class="btn-group">
        <button class="btn buttonCancel fbold" style="width: 100px" onclick="window.close()">انصراف</button>
        <button class="btn buttonCancel fbold justify-content-between" style="width: 100px" onclick="window.print()">
            <span>چاپ</span>
            <svg style="width: 18px" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5 2.75C5 1.784 5.784 1 6.75 1h6.5c.966 0 1.75.784 1.75 1.75v3.552c.377.046.752.097 1.126.153A2.212 2.212 0 0 1 18 8.653v4.097A2.25 2.25 0 0 1 15.75 15h-.241l.305 1.984A1.75 1.75 0 0 1 14.084 19H5.915a1.75 1.75 0 0 1-1.73-2.016L4.492 15H4.25A2.25 2.25 0 0 1 2 12.75V8.653c0-1.082.775-2.034 1.874-2.198.374-.056.75-.107 1.127-.153L5 6.25v-3.5Zm8.5 3.397a41.533 41.533 0 0 0-7 0V2.75a.25.25 0 0 1 .25-.25h6.5a.25.25 0 0 1 .25.25v3.397ZM6.608 12.5a.25.25 0 0 0-.247.212l-.693 4.5a.25.25 0 0 0 .247.288h8.17a.25.25 0 0 0 .246-.288l-.692-4.5a.25.25 0 0 0-.247-.212H6.608Z" clip-rule="evenodd" /></svg>
        </button>
    </div>
</div>

<div class="Brand" id="BanerId">
    <a style="color: rgb(2, 142, 213); display:flex;flex-direction:column-reverse;align-items:center;" href="//www.natix.ir" target="_blank">
        <span>WWW.NATIX.IR</span><span>طراحی و تولید توسط شرکت مهندسی نرم افزاری نـاتیـکس</span>
    </a>
</div>

<script src="~/lib/Bootstrap/bootstrap5.3.bundle.min.js"></script>
<script>
    const upHeadFactor = async (fId) => {
        const res = await fetch(`/Factor/UpHeadF?Fid=${fId}`);
        if (res.ok) {
            location.reload();
        }
    };
</script>
</body>
</html>
