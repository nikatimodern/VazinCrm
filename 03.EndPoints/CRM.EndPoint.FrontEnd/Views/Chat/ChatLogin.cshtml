@{
    ViewBag.Title = "title";
    Layout = "_ChatLayoutLogin";
}

<div style="display:flex;flex-direction:column; justify-content:start;align-items:center;  width:80%; ">
    <p class="fbold mb-3" style="font-size:20px;color:#5811b4;">ورود به پیام رسان</p>

    <div class="w-100">
        <form id="chatLoginForm">
            <div class="form-group mb-2 p-0">
                <span class="fbold" style="position: absolute;left: 8px;top: 50%;transform: translateY(-50%);font-size: 15px">09</span>
                <input inputmode="numeric" class="form-group__input form-group__input--ltr IranMobileNumber" autocomplete="off" style="padding-inline: 22px" type="text" autofocus name="mobile" placeholder="شماره موبایل" required />
                <span class="form-group__icon">
                    <svg style="width: 26px;height: 26px;color: #787c83" fill="none" viewBox="0 0 24 24" stroke-width="1.25" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" /></svg>
                </span>
            </div>
            <button type="submit" class="col-12 buttonGreen2 login-btn d-flex justify-content-center align-items-center" style="font-size: 16px;height: 38px">ورود</button>
            <p class="errorLoginText" id="chatLoginMsg"></p>
        </form>
    </div>
</div>



@section Scripts {

    <script defer>
        document.addEventListener("DOMContentLoaded", async () => {
            const chatLoginMsg = document.getElementById("chatLoginMsg");
            document.getElementById("chatLoginForm").addEventListener("submit", function (e) {
                e.preventDefault();
                if (this.mobile.value.length < 9) {
                    chatLoginMsg.textContent = "شماره موبایل معتبر نیست!";
                    return;
                }
                const mobile = "09" + this.mobile.value;

                fetch(`/Chat/ChatLogin`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ mobile }),
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.status === 200) {
                            goTo(data.url);
                        } else {
                            chatLoginMsg.innerText = data.error;
                        }
                    })
                    .catch(error => {
                        console.log(error);
                        chatLoginMsg.innerText = "خطایی رخ داده است!";
                    });
            });
        });


    </script>
}