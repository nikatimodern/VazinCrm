@model CRM.Core.Domain.Warehouses.Entities.WarehouseVoucher


<div class="warehouse-voucher">

    <!-- Header -->
    <div class="voucher-header">

        <div class="voucher-header-main">

            <div class="voucher-icon">
                <svg style="width: 26px" fill="currentColor" viewBox="0 0 256 256"><path d="M216,40H40A16,16,0,0,0,24,56V208a8,8,0,0,0,11.58,7.15L64,200.94l28.42,14.21a8,8,0,0,0,7.16,0L128,200.94l28.42,14.21a8,8,0,0,0,7.16,0L192,200.94l28.42,14.21A8,8,0,0,0,232,208V56A16,16,0,0,0,216,40ZM176,144H80a8,8,0,0,1,0-16h96a8,8,0,0,1,0,16Zm0-32H80a8,8,0,0,1,0-16h96a8,8,0,0,1,0,16Z"></path></svg>
            </div>

            <div>
                <div class="voucher-eyebrow">
                    حواله انبار
                </div>

                <div class="voucher-code">
                    @Model.VoucherNumber
                </div>

                <div class="voucher-subtitle">
                    سند خروج کالا از انبار
                </div>
            </div>

        </div>

        <div class="voucher-header-actions">

            <div class="voucher-status">
                <span class="status-dot"></span>
                <span class="status-text">@Model.StatusTxt</span>
            </div>

            <button type="button"
                    class="voucher-action-btn"
                    title="چاپ حواله"
                    onclick="printWarehouseVoucher()">
                <svg style="width: 18px;" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0 1 10.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0 .229 2.523a1.125 1.125 0 0 1-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0 0 21 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 0 0-1.913-.247M6.34 18H5.25A2.25 2.25 0 0 1 3 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 0 1 1.913-.247m10.5 0a48.536 48.536 0 0 0-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.659M18 10.5h.008v.008H18V10.5Zm-3 0h.008v.008H15V10.5Z"></path></svg>
            </button>

        </div>

    </div>


    <!-- Information -->
    <div class="voucher-info">

        <div class="voucher-info-item">
            <span class="info-label">شماره حواله</span>
            <strong class="info-value">
                @Model.VoucherNumber
            </strong>
        </div>

        @*<div class="voucher-info-item">
            <span class="info-label">شماره سفارش</span>
            <strong class="info-value info-link">
                @Model.OrderCode
            </strong>
        </div>*@

        <div class="voucher-info-item">
            <span class="info-label">ثبت‌کننده</span>
            <strong class="info-value">
                @Model.UserCreator
            </strong>
        </div>

        <div class="voucher-info-item">
            <span class="info-label">تاریخ ثبت</span>
            <strong class="info-value">
                @(string.Join(" | ", Model.CreateDateTxt?.Substring(0, 16).Split(' ')))
            </strong>
        </div>

    </div>


    <!-- Status Timeline -->
    <div class="voucher-section">

        <div class="section-heading">

            <div>
                <span class="section-kicker">وضعیت فرآیند</span>
                <h3>روند تحویل حواله</h3>
            </div>

        </div>

        <div class="voucher-timeline">

            <div class="timeline-item completed">
                <div class="timeline-marker">
                    <svg style="width: 18px" viewBox="0 0 20 20" fill="currentColor" ><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" /></svg>
                </div>

                <div class="timeline-content">
                    <strong>در انتظار تایید تامین</strong>
                    <span>حواله ثبت شده و منتظر تایید تامین است.</span>
                </div>
            </div>


            <div class="timeline-line"></div>


            <div class="timeline-item active">
                <div class="timeline-marker">
                    <svg style="width: 20px" fill="currentColor" viewBox="0 0 640 640"><path d="M560.3 301.2C570.7 313 588.6 315.6 602.1 306.7C616.8 296.9 620.8 277 611 262.3L563 190.3C560.2 186.1 556.4 182.6 551.9 180.1L351.4 68.7C332.1 58 308.6 58 289.2 68.7L88.8 180C83.4 183 79.1 187.4 76.2 192.8L27.7 282.7C15.1 306.1 23.9 335.2 47.3 347.8L80.3 365.5L80.3 418.8C80.3 441.8 92.7 463.1 112.7 474.5L288.7 574.2C308.3 585.3 332.2 585.3 351.8 574.2L527.8 474.5C547.9 463.1 560.2 441.9 560.2 418.8L560.2 301.3zM320.3 291.4L170.2 208L320.3 124.6L470.4 208L320.3 291.4zM278.8 341.6L257.5 387.8L91.7 299L117.1 251.8L278.8 341.6z"/></svg>
                </div>

                <div class="timeline-content">
                    <strong>در دست تحویل</strong>
                    <span>اقلام حواله در حال تحویل به مقصد هستند.</span>
                </div>
            </div>


            <div class="timeline-line"></div>


            <div class="timeline-item">
                <div class="timeline-marker">
                    <svg style="width: 18px" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                    </svg>

                    @* <svg style="width: 18px" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd"/></svg> *@
                </div>

                <div class="timeline-content">
                    <strong>تحویل شد</strong>
                    <span>تحویل کامل اقلام حواله.</span>
                </div>
            </div>

        </div>

    </div>


    <!-- Products -->
    <div class="voucher-section voucher-products-section">

        <div class="section-heading section-heading-products">

            <div>
                <span class="section-kicker">اقلام حواله</span>
                <h3>محصولات</h3>
            </div>

            <div class="products-count">
                <span>@Model.WarehouseProductVouchers?.Count</span>
                قلم کالا
            </div>

        </div>


        <div class="voucher-table-wrapper">

            <table class="voucher-products-table">

                <thead>
                <tr>
                    <th class="col-index">#</th>
                    <th>محصول</th>
                    <th>شرح محصول</th>
                    <th class="col-amount">مقدار</th>
                </tr>
                </thead>

                <tbody>

                @for (var i = 0; i < Model.WarehouseProductVouchers?.Count; i++) {
                    var product = Model.WarehouseProductVouchers[i];

                    <tr>

                        <td class="row-index">
                            @(i + 1)
                        </td>

                        <td>
                            <div class="product-name">
                                @product.WarehouseProduct.ProductSmallName
                            </div>
                        </td>

                        <td>
                            <div class="product-description">
                                @product.WarehouseProduct.ProductDescription
                            </div>
                        </td>

                        <td>
                            <span class="amount-cell unit-badge">
                                <span>@product.WarehouseProduct.UnitTxt</span> 
                                <span>@product.Weight</span>
                            </span>
                        </td>

                    </tr>
                }

                </tbody>

            </table>

        </div>

    </div>


    <!-- Summary -->
    <div class="voucher-summary">

        <div class="summary-icon">
            <svg style="width: 20px" fill="currentColor" viewBox="0 0 640 640"><path d="M288 64L288 128C288 136.8 295.2 144 304 144L336 144C344.8 144 352 136.8 352 128L352 64L384 64C419.3 64 448 92.7 448 128L448 256C448 261.5 447.3 266.9 446 272L194 272C192.7 266.9 192 261.5 192 256L192 128C192 92.7 220.7 64 256 64L288 64zM384 576C372.8 576 362.2 573.1 353 568C362.5 551.5 368 532.4 368 512L368 384C368 363.6 362.5 344.5 353 328C362.2 322.9 372.7 320 384 320L416 320L416 384C416 392.8 423.2 400 432 400L464 400C472.8 400 480 392.8 480 384L480 320L512 320C547.3 320 576 348.7 576 384L576 512C576 547.3 547.3 576 512 576L384 576zM64 384C64 348.7 92.7 320 128 320L160 320L160 384C160 392.8 167.2 400 176 400L208 400C216.8 400 224 392.8 224 384L224 320L256 320C291.3 320 320 348.7 320 384L320 512C320 547.3 291.3 576 256 576L128 576C92.7 576 64 547.3 64 512L64 384z"/></svg>
        </div>

        <div class="summary-content">
            <span>مجموع اقلام حواله</span>
            <strong>@Model.WarehouseProductVouchers?.Count قلم کالا</strong>
        </div>

        <div class="summary-divider"></div>

        <div class="summary-content">
            <span>وضعیت فعلی</span>
            <strong class="summary-status">
                <span class="status-dot"></span>
                @Model.Status
            </strong>
        </div>

    </div>

</div>


@section Styles {
    <link rel="stylesheet" href="~/css/warehouse.css" asp-append-version="true" />
}
