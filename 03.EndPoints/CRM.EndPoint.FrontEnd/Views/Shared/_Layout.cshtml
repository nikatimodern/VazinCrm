<script>
    (function setActiveMenu() {
        const currentPath = window.location.pathname.toLowerCase().replace(/\/$/, "");

        // Active کردن لینک فعلی
        document.querySelectorAll(".menu-link").forEach(link => {
            const href = link.getAttribute("href");
            if (!href || href === "#") return;
            const linkUrl = new URL(href, window.location.origin);
            const linkPath = linkUrl.pathname.toLowerCase().replace(/\/$/, "");
            if (linkPath !== currentPath) return;

            link.classList.add("active-menu");
            link.setAttribute("aria-current", "page");

            let parent = link.closest(".has-submenu");
            while (parent) {
                parent.classList.add("open");
                const parentMenuItem = parent.querySelector(":scope > .menu-item");
                parentMenuItem?.classList.add("active-ancestor");
                parentMenuItem?.setAttribute("aria-expanded", "true");
                parent = parent.parentElement?.closest(".has-submenu");
            }
        });


        // باز و بسته کردن submenu
        document.querySelectorAll(".menu-nav .submenu-toggle").forEach((menu, index) => {
            const wrapper = menu.parentElement;
            const submenu = wrapper.querySelector(":scope > .submenu");
            submenu.id = `navigation-submenu-${index}`;
            menu.setAttribute("aria-controls", submenu.id);
            menu.addEventListener("click", function () {
                const open = wrapper.classList.toggle("open");
                menu.setAttribute("aria-expanded", String(open));
                if (!open && submenu.contains(document.activeElement)) menu.focus();
            });
            wrapper.addEventListener("keydown", event => {
                if (event.key !== "Escape" || !wrapper.classList.contains("open")) return;
                event.stopPropagation();
                wrapper.classList.remove("open");
                menu.setAttribute("aria-expanded", "false");
                menu.focus();
            });
        });

        // Animate only intentional interaction, including keyboard and touch input.
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
        const hoveredMenuAnimations = new WeakMap();
        function animateMenuIcon(item, repeat = false) {
            if (reducedMotion.matches) return;
            const icon = item.querySelector(":scope > .menu-icon-frame > .menu-icon");
            if (!icon?.animate) return;
            icon.getAnimations().forEach(animation => animation.cancel());
            const transforms = icon.dataset.menuIcon === "settings-2"
                ? ["rotate(-22deg)", "rotate(0deg)"]
                : icon.dataset.menuIcon === "bell-ring"
                    ? ["rotate(0deg)", "rotate(12deg)", "rotate(-10deg)", "rotate(5deg)", "rotate(0deg)"]
                    : ["translateY(0)", "translateY(-3px) rotate(-5deg)", "translateY(0) rotate(2deg)", "translateY(0)"];
            const frames = transforms.map((transform, index) => ({
                transform,
                offset: index / (transforms.length - 1) * (repeat ? 4 / 7 : 1)
            }));
            if (repeat) frames.push({ transform: transforms.at(-1), offset: 1 });
            const animation = icon.animate(frames, {
                duration: repeat ? 700 : 400,
                iterations: repeat ? Infinity : 1,
                easing: "ease-out"
            });
            if (repeat) hoveredMenuAnimations.set(item, animation);
        }
        document.querySelectorAll(".menu-nav .menu-item.active-menu").forEach(item => item.classList.add("menu-click-orbit"));
        document.querySelectorAll(".menu-nav, #mobileNavbar").forEach(nav => {
            ["pointerover", "focusin", "click"].forEach(eventName => {
                nav.addEventListener(eventName, event => {
                    const item = event.target.closest(".menu-item");
                    if (!item || !nav.contains(item)) return;
                    if (eventName === "pointerover" && item.contains(event.relatedTarget)) return;
                    animateMenuIcon(item, eventName === "pointerover"
                        ? event.pointerType !== "touch"
                        : hoveredMenuAnimations.has(item));
                });
            });
            nav.addEventListener("pointerout", event => {
                const item = event.target.closest(".menu-item");
                if (!item || !nav.contains(item) || item.contains(event.relatedTarget)) return;
                hoveredMenuAnimations.get(item)?.cancel();
                hoveredMenuAnimations.delete(item);
            });
        });
        reducedMotion.addEventListener("change", event => {
            if (!event.matches) return;
            document.querySelectorAll(".menu-icon-frame > .menu-icon").forEach(icon => {
                icon.getAnimations().forEach(animation => animation.cancel());
            });
        });
    })();
</script>

