@using CRM.Core.Domain.RequestAmounts.Enums
@model List<CRM.EndPoint.FrontEnd.Models.RequestAmount.RequestAmountVModel>

@{
    var passType = ViewBag.PassType; //1: requestAmount | 2: cartable MD
    var isFinancial = ViewBag.IsFinancial;
    var isAdmin = ViewBag.IsAdmin;
    var isManager = ViewBag.IsManager;
    var userId = ViewBag.UserId;
    var index = 0;
}

<div class="col-12 mx-auto d-flex flex-column" style="gap:12px">
    @foreach (var item in Model ?? []) {
        index += 1;
        var reqAmount = item.RequestAmount;
        var isCreator = reqAmount.UserCreatorID == userId;
        var supplyFactorSerials = item.SupplyFactorSerials;
        var orderHeadNumbers = item.OrderHeadSerials;
        var customerNames = item.CustomerNames;
        var status = reqAmount.RequestStatus;
        var isFullyPaid = item.TotalPaymentAmount >= reqAmount.AcceptedAmount;
        var canEditDocType = (isFinancial && reqAmount.RequestStatus == RequestStatusEnum.در_انتظار_پرداخت) ||
                             (passType == 2 && reqAmount.RequestStatus == RequestStatusEnum.در_انتظار_تایید_مدیرعامل);

        var bgCssClass = status switch {
            RequestStatusEnum.در_انتظار_پرداخت => "layered-green-light",
            RequestStatusEnum.پرداخت_شده => "layered-green",
            RequestStatusEnum.در_انتظار_تایید_مدیرعامل or RequestStatusEnum.در_انتظار_ارسال_به_مالی => "layered-purple-light",
            //RequestStatusEnum.در_انتظار_تایید_مدیرعامل or RequestStatusEnum.در_انتظار_ارسال_به_مالی => "layered-gold",
            _ => ""
        };

        <div class="layered-card layered-card-pill @(bgCssClass)" data-id="@reqAmount.Id">
            @if (status == RequestStatusEnum.در_انتظار_پرداخت || (status == RequestStatusEnum.پرداخت_شده && !isFullyPaid)) {
                <div class="layered-select-box col-auto py-2 px-1 ps-3">
                    <input type="checkbox" class="card-checkbox" />
                </div>
            }
            <div class="layered-card__layer col-12 col-xl-auto col-xxl-3 d-flex flex-column justify-content-center px-3 py-2">
                <div class="d-flex justify-content-between align-items-baseline mb-1 column-gap-3">
                    <span style="font-size: 13px; color: #777">شماره درخواست:</span>
                    <span class="fbold">@reqAmount.RequestNumber</span>
                </div>
                <div class="d-flex justify-content-between align-items-baseline mb-1 column-gap-3">
                    <span style="font-size: 13px; color: #777">تاریخ درخواست:</span>
                    <span class="fbold direction-ltr">
                        @(string.Join(" | ", reqAmount.CreateDateTxt?.Substring(0, 16).Split(' ')))
                    </span>
                </div>
                <div class="d-flex justify-content-between align-items-baseline column-gap-3">
                    <span style="font-size: 13px; color: #777">ثبت شده توسط:</span>
                    <span class="fbold">@reqAmount.UserCreator</span>
                </div>
            </div>

            <div class="layered-card__layer col-12 col-xl-3 d-flex flex-column justify-content-center align-items-center px-3 px-xl-2 py-2">
                <div class="d-flex flex-wrap justify-content-center align-items-baseline column-gap-2 text-center">
                    <span style="font-size: 13px; color: #777">نوع:</span>
                    <span class="fbold doc-type-wrapper">
                        <span>@reqAmount.RequestAmountTypeTxt</span>
                        <span class="doc-type-text">(@reqAmount.DocTypeTxt)</span>
                        @if (canEditDocType) {
                            <select class="doc-type-select w-auto form-select form-select-sm d-none">
                                <option value="1" selected="@(reqAmount.DocType == RequestAmountDocTypeEnum.نقدی)">نقدی</option>
                                <option value="2" selected="@(reqAmount.DocType == RequestAmountDocTypeEnum.چکی)">چکی</option>
                            </select>

                            <button type="button" class="doc-type-edit-btn edit-icon-btn">
                                <svg style="width: 14px" viewBox="0 0 16 16" fill="currentColor"><path d="M13.488 2.513a1.75 1.75 0 0 0-2.475 0L6.75 6.774a2.75 2.75 0 0 0-.596.892l-.848 2.047a.75.75 0 0 0 .98.98l2.047-.848a2.75 2.75 0 0 0 .892-.596l4.261-4.262a1.75 1.75 0 0 0 0-2.474Z" /><path d="M4.75 3.5c-.69 0-1.25.56-1.25 1.25v6.5c0 .69.56 1.25 1.25 1.25h6.5c.69 0 1.25-.56 1.25-1.25V9A.75.75 0 0 1 14 9v2.25A2.75 2.75 0 0 1 11.25 14h-6.5A2.75 2.75 0 0 1 2 11.25v-6.5A2.75 2.75 0 0 1 4.75 2H7a.75.75 0 0 1 0 1.5H4.75Z" /></svg>
                            </button>
                        }
                    </span>
                </div>
                @if (reqAmount.RequestAmountType == RequestAmountTypeEnum.تنخواه && !string.IsNullOrEmpty(reqAmount.CashierTxt)) {
                    <div class="d-flex flex-wrap justify-content-center align-items-baseline column-gap-2 mt-2 text-center">
                        <span style="font-size: 13px; color: #777">تنخواه دار:</span>
                        <span class="fbold">@reqAmount.CashierTxt</span>
                    </div>
                }
                @if (supplyFactorSerials.Any()) {
                    <div class="d-flex flex-wrap justify-content-center align-items-baseline column-gap-2 mt-2 text-center">
                        <span style="font-size: 13px; color: #777">فاکتور تامین:</span>
                        <span class="fbold direction-ltr">@string.Join(", ", supplyFactorSerials)</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(reqAmount.SupplierTxt)) {
                    <div class="d-flex flex-wrap justify-content-center align-items-baseline column-gap-2 mt-2 text-center">
                        <span style="font-size: 13px; color: #777">تامین کننده:</span>
                        <span class="fbold">@reqAmount.SupplierTxt</span>
                    </div>
                }
                @if (orderHeadNumbers.Any()) {
                    <div class="d-flex flex-wrap justify-content-center align-items-baseline column-gap-2 mt-2 text-center">
                        <span style="font-size: 13px; color: #777">حواله تولید:</span>
                        <span class="fbold">@string.Join(" / ", orderHeadNumbers)</span>
                    </div>
                }
                @if (customerNames.Any()) {
                    <div class="d-flex flex-wrap justify-content-center align-items-baseline column-gap-2 mt-2 text-center">
                        <span style="font-size: 13px; color: #777">مشتری:</span>
                        <span class="fbold">@string.Join(" / ", customerNames)</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(reqAmount.Description)) {
                    <div class="d-flex flex-wrap justify-content-center align-items-baseline column-gap-2 mt-2 text-center">
                        <span style="font-size: 13px; color: #777">توضیحات:</span>
                        <span class="fbold" style="font-size: 13px">@reqAmount.Description</span>
                    </div>
                }
            </div>

            <div class="layered-card__layer col-12 col-xl d-flex flex-row flex-xl-column justify-content-between justify-content-xl-center align-items-center px-3 px-xl-2 py-2">
                <span style="font-size: 13px; color: #777">مبلغ درخواست:</span>
                <div class="fbold flex-center align-items-baseline column-gap-1">
                    <span style="font-size: 17px;">@($"{reqAmount.Amount:n0}")</span>
                    <span style="font-size: 11px;">ريال</span>
                </div>
            </div>
            @if (passType == 1 || passType == 3) {
                <div class="layered-card__layer col-12 col-xl d-flex flex-column justify-content-xl-evenly align-items-center gap-2 px-3 px-xl-2 py-2">
                    <div class="w-100 d-flex column-gap-1 flex-row flex-xl-column justify-content-between justify-content-xl-center align-items-center">
                        <span style="font-size: 13px; color: #777">مبلغ تایید شده:</span>
                        <div class="fbold column-gap-1 @(status is RequestStatusEnum.در_انتظار_پرداخت or RequestStatusEnum.پرداخت_شده ? "badge badge-outline-green" : "")">
                            <span style="font-size: 16px;">@($"{reqAmount.AcceptedAmount:n0}")</span>
                            <span style="font-size: 11px;">ريال</span>
                            <span style="font-size: 16px; color:darkgray">
                            @(reqAmount.AcceptedAmountPercent.HasValue ? $"{reqAmount.AcceptedAmountPercent.Value}%" : "")
                        </span>
                        </div>
                    </div>
                    @if (item.TotalPaymentAmount > 0) {
                        <div class="w-100 d-flex column-gap-1 flex-row flex-xl-column justify-content-between justify-content-xl-center align-items-center">
                            <span style="font-size: 13px; color: #777">مبلغ پرداخت شده:</span>
                            <button class="fbold flex-center badge badge-green" onclick="ShowModalListPayment('@reqAmount.Id')">
                                <span class="d-flex align-items-baseline column-gap-1">
                                    <span style="font-size: 14px;">@($"{item.TotalPaymentAmount:n0}")</span>
                                    <span style="font-size: 10px;">ريال</span>
                                </span>
                                <span class="flex-center ps-2 ms-1" style="border-right: 1px solid whitesmoke">
                                    <i class="fa @(isFinancial ? "fa-pencil" : "fa-eye") " style="font-size: 10px;color: white"></i>
                                </span>
                            </button>
                        </div>
                    }
                </div>

                <div class="layered-card__layer col-12 col-xl-auto col-xxl-1 flex-center flex-row flex-xl-column p-2 px-xl-3 gap-4 gap-xl-3" style="min-width: 140px;">
                    @switch (status) {
                        case RequestStatusEnum.ثبت_اولیه:
                            if (isCreator) {
                                <div class="flex-center flex-xl-column gap-3">
                                    <div class="flex-center flex-row gap-4 gap-xl-3">
                                        <button class="flex-center p-0" data-title-right="ویرایش" style="color:#333" onclick="showEditRequestAmountModal('@reqAmount.Id')">
                                            <i class="fa fa-pencil"></i>
                                        </button>

                                        <button class="flex-center p-0" data-title-right="حذف" style="color:#333" onclick="deleteRequestAmount('@reqAmount.Id')">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </div>
                                    <button class="buttonGreen2" onclick="changeStatusReqAmount('@reqAmount.Id', 1)">ارسال به مدیرعامل</button>
                                </div>
                            } else {
                                <span class="fbold" style="color:#777">@reqAmount.RequestStatusTxt</span>
                            }

                            break;
                        case RequestStatusEnum.در_انتظار_تایید_مدیرعامل:
                        case RequestStatusEnum.در_انتظار_ارسال_به_مالی:
                            <span class="fbold text-center" style="color: rebeccapurple">@reqAmount.RequestStatusTxt</span>
                            break;
                        case RequestStatusEnum.در_انتظار_پرداخت:
                            if (isFinancial) {
                                <div class="flex-center flex-xl-column gap-1">
                                    @if (isFullyPaid) {
                                        <button class="buttonGreen2" onclick="changeStatusReqAmount('@reqAmount.Id', 4)">پرداخت شد</button>
                                    } else {
                                        <button class="buttonGreen2" onclick="showAttachReqAmount('@reqAmount.Id')">ثبت پرداختی</button>
                                    }
                                    <button class="buttonCancel3" onclick="changeStatusReqAmount('@reqAmount.Id', 1)">برگشت</button>
                                </div>
                            } else {
                                <span class="fbold" style="color: #4f817d">@reqAmount.RequestStatusTxt</span>
                            }

                            break;
                        case RequestStatusEnum.پرداخت_شده:
                            if (isFullyPaid) {
                                <div class="flex-center flex-wrap column-gap-1">
                                    <svg style="width: 18px" viewBox="0 0 20 20" fill="#04857c"><path fill-rule="evenodd" d="M16.403 12.652a3 3 0 0 0 0-5.304 3 3 0 0 0-3.75-3.751 3 3 0 0 0-5.305 0 3 3 0 0 0-3.751 3.75 3 3 0 0 0 0 5.305 3 3 0 0 0 3.75 3.751 3 3 0 0 0 5.305 0 3 3 0 0 0 3.751-3.75Zm-2.546-4.46a.75.75 0 0 0-1.214-.883l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" /></svg>
                                    <span class="fbold" style="color: #04857c">@reqAmount.RequestStatusTxt</span>
                                </div>
                            } else {
                                if (isFinancial) {
                                    <div class="flex-center flex-xl-column gap-1">
                                        <button class="buttonGreen2" onclick="showAttachReqAmount('@reqAmount.Id')">ثبت پرداختی</button>
                                    </div>
                                }

                                <div class="flex-center flex-wrap column-gap-2">
                                    <span class="fbold" style="color: #04857c">@reqAmount.RequestStatusTxt</span>
                                    @if (isFinancial) {
                                        <span style="cursor:pointer;color:#333" onclick="changeStatusReqAmount('@reqAmount.Id', 1)" data-title-right="بازگشت به مدیرعامل">
                                            <svg style="width:16px" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="m15 15 6-6m0 0-6-6m6 6H9a6 6 0 0 0 0 12h3" />
                                            </svg>
                                        </span>
                                    }
                                </div>
                            }

                            break;
                    }
                </div>
            } else if (passType == 2) {
                int?[] acceptedAmountPercentList = [25, 50, 75, 100];
                var percent = reqAmount.AcceptedAmountPercent;
                var pendingMd = status == RequestStatusEnum.در_انتظار_تایید_مدیرعامل;

                <div class="layered-card__layer col-12 col-xl d-flex flex-column justify-content-xl-evenly align-items-center gap-2 px-3 px-xl-2 py-2">
                    <div class="w-100 d-flex column-gap-1 flex-row flex-xl-column justify-content-between justify-content-xl-center align-items-center">
                        <span style="font-size: 13px; color: #777" class="flex-shrink-0">مبلغ تایید شده:</span>
                        @if (pendingMd) {
                            <div class="input-group">
                                <input @(pendingMd ? "" : "disabled") type="text" class="acceptedAmount form-control currencyNumber" min="@item.TotalPaymentAmount" oninput="changeAcceptedRequestAmount(this, @reqAmount.Amount)" value="@(reqAmount.AcceptedAmount > 0 ? $"{reqAmount.AcceptedAmount:n0}" : "")" required data-currency-hint="#reqAmountCurrencyHint@(index)">
                                <select class="acceptedAmountPercent form-select form-select-xs" @(pendingMd ? "" : "disabled") style="@(acceptedAmountPercentList.Contains(percent) ? "background-color: #cef5ce" : "border-color: #b5b5b5");color: #333" onchange="changePercentAcceptedRequestAmount(this, @reqAmount.Amount)">
                                    <option value="" selected="@(percent == 0 ? "selected" : null)">درصد</option>
                                    @foreach (var p in acceptedAmountPercentList) {
                                        <option value="@p" selected="@(percent == p ? "selected" : null)">@p%</option>
                                    }
                                </select>
                            </div>
                            <span class="currencyHint" id="reqAmountCurrencyHint@(index)"></span>
                        } else {
                            <div class="fbold column-gap-1 @(status is RequestStatusEnum.در_انتظار_پرداخت or RequestStatusEnum.پرداخت_شده ? "badge badge-outline-green" : "")">
                                <span style="font-size: 16px;">@($"{reqAmount.AcceptedAmount:n0}")</span>
                                <span style="font-size: 11px;">ريال</span>
                                <span style="font-size: 16px; color:darkgray">
                                    @(reqAmount.AcceptedAmountPercent.HasValue ? $"{reqAmount.AcceptedAmountPercent.Value}%" : "")
                                </span>
                            </div>
                        }
                    </div>
                    @if (item.TotalPaymentAmount > 0) {
                        <div class="w-100 d-flex column-gap-1 flex-row flex-xl-column justify-content-between justify-content-xl-center align-items-center">
                            <span style="font-size: 13px; color: #777">مبلغ پرداخت شده:</span>
                            <button class="fbold flex-center badge badge-green" onclick="ShowModalListPayment('@reqAmount.Id')">
                                <span class="d-flex align-items-baseline column-gap-1">
                                    <span style="font-size: 14px;">@($"{item.TotalPaymentAmount:n0}")</span>
                                    <span style="font-size: 10px;">ريال</span>
                                </span>
                                <span class="flex-center ps-2 ms-1" style="border-right: 1px solid whitesmoke">
                                    <i class="fa @(isFinancial ? "fa-pencil" : "fa-eye") " style="font-size: 10px;color: white"></i>
                                </span>
                            </button>
                        </div>
                    }
                </div>

                <div class="layered-card__layer col-12 col-xl-auto col-xxl-1 flex-center flex-row flex-xl-column p-2 px-xl-3 gap-4 gap-xl-3" style="min-width: 140px;">
                    @switch (status) {
                        case RequestStatusEnum.ثبت_اولیه:
                            <span class="fbold" style="color:#777">@reqAmount.RequestStatusTxt</span>
                            break;
                        case RequestStatusEnum.در_انتظار_تایید_مدیرعامل:
                            <div class="inline-flex-center flex-xl-column gap-2">
                                <button class="buttonGreen2" onclick="submitAcceptedRequestAmount(this, '@reqAmount.Id')" @(reqAmount.AcceptedAmount == 0 ? "disabled" : "")>
                                    تایید
                                </button>
                                <button class="buttonCancel3" onclick="changeStatusReqAmount('@reqAmount.Id', 0)">برگشت</button>
                            </div>
                            break;
                        case RequestStatusEnum.در_انتظار_ارسال_به_مالی:
                            var targetStatus = item.TotalPaymentAmount > 0 ? (int)RequestStatusEnum.پرداخت_شده : (int)RequestStatusEnum.در_انتظار_پرداخت;
                            <div class="inline-flex-center flex-xl-column gap-2">
                                <button class="buttonGreen2" onclick="changeStatusReqAmount('@reqAmount.Id', @targetStatus)" @(reqAmount.AcceptedAmount == 0 ? "disabled" : "")>
                                    ارسال به مالی
                                </button>
                                <button class="buttonCancel3" onclick="changeStatusReqAmount('@reqAmount.Id', 1)">برگشت</button>
                            </div>
                            break;
                        case RequestStatusEnum.در_انتظار_پرداخت:
                            <span class="fbold text-center" style="color: #4f817d">@reqAmount.RequestStatusTxt</span>
                            break;
                        case RequestStatusEnum.پرداخت_شده:
                            <div class="flex-center flex-wrap column-gap-1">
                                @if (isFullyPaid) {
                                    <svg style="width: 18px" viewBox="0 0 20 20" fill="#04857c"><path fill-rule="evenodd" d="M16.403 12.652a3 3 0 0 0 0-5.304 3 3 0 0 0-3.75-3.751 3 3 0 0 0-5.305 0 3 3 0 0 0-3.751 3.75 3 3 0 0 0 0 5.305 3 3 0 0 0 3.75 3.751 3 3 0 0 0 5.305 0 3 3 0 0 0 3.751-3.75Zm-2.546-4.46a.75.75 0 0 0-1.214-.883l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" /></svg>
                                }
                                <span class="fbold" style="color: #04857c">@reqAmount.RequestStatusTxt</span>
                            </div>
                            break;
                    }
                </div>
            }
        </div>
    }
</div>
