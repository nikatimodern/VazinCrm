<!-- Modal addRequestAmount -->
<div class="modal fade" id="addRequestAmountModal" tabindex="-1" role="dialog" aria-labelledby="reqAmountModalTitleId" data-bs-focus="false">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-md">
        <div class="modal-content col-12">
            <div class="request-amount-modal-header">
                <h2 id="reqAmountModalTitleId">درخواست وجه</h2>
                <button type="button" class="request-amount-modal-close" aria-label="بستن" onclick="cancelRequestAmountModal()">×</button>
            </div>
            <div class="modal-body pb-2">
                <form id="requestAmountForm" class="d-flex flex-column gap-2">
                    <div id="requestAmountTypeWrapper">
                        <label for="requestAmountTypeId">نوع درخواست:</label>
                        <select id="requestAmountTypeId" class="form-select form-select-sm valueNumber" name="requestAmountType" required>
                            <option value="">انتخاب</option>
                            <option value="1">پیش پرداخت</option>
                            <option value="2">پرداخت فاکتور</option>
                            <option value="3">تنخواه</option>
                            <option value="4">بابت بدهی</option>
                            <option value="5">بابت تضمین</option>
                        </select>
                    </div>


                    <div>
                        <label for="reqAmountAmount">مبلغ:</label>
                        <input id="reqAmountAmount" inputmode="numeric" class="form-control currencyNumber inpAmount" name="amount" required data-currency-hint="next">
                        <span class="currencyHint"></span>
                    </div>

                    <div>
                        <label for="reqAmountDocType">نوع پرداخت:</label>
                        <select id="reqAmountDocType" class="form-select form-select-sm valueNumber" name="docType" required>
                            <option value="">انتخاب</option>
                            <option value="1">نقدی</option>
                            <option value="2">چکی</option>
                        </select>
                    </div>

                    @*<div>
                        <label for="reqAmountSupplyFactor">فاکتور تامین:</label>
                        <div class="input-group mb-3">
                            <input id="reqAmountSupplyFactor" type="text" class="form-control direction-ltr" placeholder="فاکتور تامین.." disabled required>
                            <button class="btn btn-sm btn-secondary" type="button" onclick="showAddSupplyFactorModal(this)">انتخاب</button>
                        </div>
                    </div>*@

                    <div id="reqAmountSupplierWrapper">
                        <label for="reqAmountSupplierId">تامین‌ کننده:</label>
                        <select class="show-dropdown-arrow" name="supplierId" id="reqAmountSupplierId" required>
                        </select>
                        <p id="reqAmountTotalAmountSupFactor" class="mt-2 text-end" style="color: #666"></p>
                    </div>

                    <div id="reqAmountCashierWrapper" class="d-none">
                        <label for="reqAmountCashierId">تنخواه دار:</label>
                        <select class="show-dropdown-arrow" name="cashierId" id="reqAmountCashierId">
                        </select>
                    </div>

                    <div id="reqAmountOrderHeadWrapper" class="d-none">
                        <label for="reqAmountOrderHead">بابت حواله تولید:</label>
                        <div class="input-group">
                            <input id="reqAmountOrderHead" type="text" class="form-control direction-ltr" placeholder="حواله تولید.." disabled>
                            <button class="btn btn-sm btn-secondary" type="button" onclick="showAddOrderHeadRaModal()">انتخاب</button>
                        </div>
                    </div>

                    <div>
                        <label for="reqAmountDescription">توضیحات:</label>
                        <textarea id="reqAmountDescription" class="form-control h-auto px-2 py-1 text-start" name="description" rows="3"></textarea>
                    </div>

                    <div class="request-amount-modal-actions">
                        <button type="button" class="buttonCancel2" style="padding-block: 4px" onclick="cancelRequestAmountModal()">انصراف</button>
                        <button type="button" class="buttonGreen3" style="padding-block: 4px" onclick="submitRequestAmountModal()">ثبت</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
