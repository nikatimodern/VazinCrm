@model CRM.EndPoint.FrontEnd.Models.Login.ResetPasswordModel

@{
    ViewData["Title"] = "بازنشانی رمز عبور";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<div class="erp-auth-content">
    <header class="erp-auth-heading">
        <h1>ساخت رمز عبور جدید</h1>
        <p>رمز عبور جدید را وارد و سپس تأیید کنید.</p>
    </header>

    <div class="w-100">
        <form id="resetPasswordForm">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label class="erp-auth-label" for="NewPasswordInp">رمز عبور جدید</label>
                <span class="form-group__icon erp-password-icon" role="button" tabindex="0" aria-label="نمایش رمز عبور" onclick="togglePassword('NewInp')">
                    <svg id="eyeClosedNewPassword" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.04 12.32a1 1 0 0 1 0-.64C3.42 7.51 7.36 4.5 12 4.5s8.57 3.01 9.96 7.18a1 1 0 0 1 0 .64C20.58 16.49 16.64 19.5 12 19.5s-8.58-3.01-9.96-7.18Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></svg>
                    <svg id="eyeOpenNewPassword" style="display:none" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3l18 18M3.9 8.3A10.5 10.5 0 0 0 1.9 12c1.3 4.3 5.3 7.5 10.1 7.5 1 0 2-.14 2.9-.4M6.2 6.2a10.6 10.6 0 0 1 5.8-1.7c4.8 0 8.8 3.2 10.1 7.5a10.7 10.7 0 0 1-4.3 5.8"/></svg>
                </span>
                <input name="newPassword" type="password" id="NewPasswordInp" placeholder="رمز عبور جدید"
                       autocomplete="new-password" autofocus class="form-group__input form-group__input--ltr" />
            </div>
            <div class="form-group">
                <label class="erp-auth-label" for="ConfirmPasswordInp">تکرار رمز عبور</label>
                <span class="form-group__icon erp-password-icon" role="button" tabindex="0" aria-label="نمایش تکرار رمز عبور" onclick="togglePassword('ConfirmInp')">
                    <svg id="eyeClosedConfirmPassword" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.04 12.32a1 1 0 0 1 0-.64C3.42 7.51 7.36 4.5 12 4.5s8.57 3.01 9.96 7.18a1 1 0 0 1 0 .64C20.58 16.49 16.64 19.5 12 19.5s-8.58-3.01-9.96-7.18Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></svg>
                    <svg id="eyeOpenConfirmPassword" style="display:none" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3l18 18M3.9 8.3A10.5 10.5 0 0 0 1.9 12c1.3 4.3 5.3 7.5 10.1 7.5 1 0 2-.14 2.9-.4M6.2 6.2a10.6 10.6 0 0 1 5.8-1.7c4.8 0 8.8 3.2 10.1 7.5a10.7 10.7 0 0 1-4.3 5.8"/></svg>
                </span>
                <input name="confirmPassword" type="password" id="ConfirmPasswordInp" placeholder="تکرار رمز عبور"
                       autocomplete="new-password" class="form-group__input form-group__input--ltr" />
            </div>
            <p class="erp-reset-help">برای امنیت بیشتر از رمز عبور غیرقابل‌حدس استفاده کنید.</p>
            <button type="submit" class="buttonGreen2 login-btn erp-auth-primary">تأیید و بازنشانی رمز</button>
            <p class="errorLoginText" id="resetPassErrMsg" role="alert" aria-live="polite"></p>
        </form>
        <div class="erp-auth-links">
            <a asp-controller="Account" asp-action="Login">بازگشت به صفحه ورود</a>
        </div>
    </div>
</div>

<script>
    function togglePassword(from) {
        const passwordInput = document.getElementById(from === "ConfirmInp" ? "ConfirmPasswordInp" : "NewPasswordInp");
        const eyeOpen = document.getElementById(from === "ConfirmInp" ? "eyeOpenConfirmPassword" : "eyeOpenNewPassword");
        const eyeClosed = document.getElementById(from === "ConfirmInp" ? "eyeClosedConfirmPassword" : "eyeClosedNewPassword");

        if (passwordInput.type === "password") {
            passwordInput.type = "text";
            eyeOpen.style.display = "block";
            eyeClosed.style.display = "none";
        } else {
            passwordInput.type = "password";
            eyeOpen.style.display = "none";
            eyeClosed.style.display = "block";
        }
    }

    const errorBox = document.getElementById("resetPassErrMsg");
    document.getElementById("resetPasswordForm").addEventListener("submit", async (e) => {
        e.preventDefault();

        const newPassword = document.querySelector("input[name='newPassword']").value;
        const confirmPassword = document.querySelector("input[name='confirmPassword']").value;

        if (newPassword !== confirmPassword) {
            errorBox.innerText = "رمز عبور و تکرار آن یکسان نیست";
            return;
        }
        if (newPassword.length < 3) {
            errorBox.innerText = "رمز عبور باید حداقل 3 کاراکتر باشد";
            return;
        }

        try {
            FLshowLoading();
            const res = await fetch("/Account/ResetPassword", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": document.querySelector("input[name='__RequestVerificationToken']")?.value || "",
                },
                body: JSON.stringify({ newPassword, confirmPassword }),
            });
            const data = await res.json();

            errorBox.innerHTML = "";
            if (data.status === 200) {
                toastifySuccess(data.message);
                setTimeout(() => {
                    FLshowLoading(false);
                    goTo(data.url);
                }, 2000);
            } else if (data.status === 405) {
                data.errors.forEach(err => {
                    const pElm = document.createElement("p");
                    pElm.innerText = err;
                    errorBox.appendChild(pElm);
                });
                FLshowLoading(false);
            } else if (data.status === 404) {
                toastifyError(data.message);
                setTimeout(() => {
                    FLshowLoading(false);
                    goTo(data.url);
                }, 2000);
            } else {
                errorBox.innerText = data.message;
                FLshowLoading(false);
            }
        } catch (err) {
            console.log(err);
        }


    });
</script>