<!-- Modal AddItemOrder -->
<div class="modal fade" id="AddItemOrderModal" tabindex="-1" role="dialog" data-bs-focus="false" data-bs-backdrop="static">
    <div class=" modal-dialog modal-dialog-centered modal-sm ">
        <div class="modal-content col-12" style="padding:10px !important;">
            <div style="height:28px;  display:flex; justify-content:center; align-items:center;  background: linear-gradient(to bottom, #3f5f80, #1a2d41); color:white;border-radius:5px">
                <label class="fbold">افزودن آیتم دستور تولید</label>
            </div>
            <div class=" modal-body pb-2" style=" display:flex;flex-direction:column; justify-content:space-between; width:100% !important;">

                <div style="width:100%; ">
                    <form id="OrderForm" class="d-flex flex-column gap-2 w-100">
                        <div class="d-flex flex-column align-items-center">
                            <label>نوع جنس</label>
                            <input class=" form-control" type="text" name="productSmallName" disabled tabindex="0" />
                        </div>
                        <div class="d-flex flex-column align-items-center">
                            <label> شرح کالا </label>
                            <input class=" form-control" type="text" name="product" tabindex="0" />
                        </div>
                        <div class="d-flex flex-column align-items-center">
                            <label> ابعاد </label>
                            <input class=" form-control" type="text" name="dimensions" tabindex="0" />
                        </div>
                        <div class="d-flex flex-column align-items-center">
                            <label> نوع دسته </label>
                            <input class=" form-control" type="text" name="categoryType" tabindex="0" />
                        </div>
                        <div class="d-flex flex-column align-items-center">
                            <label>کاست</label>
                            <input class=" form-control" type="text" name="caset" tabindex="0" />
                        </div>
                        <div class="d-flex flex-column align-items-center">
                            <label>رنگ زمینه</label>
                            <input class=" form-control" type="text" name="backgroundColor" tabindex="0" />
                        </div>
                        <div class="d-flex flex-column align-items-center">
                            <label>رنگ چاپ</label>
                            <input class=" form-control" type="text" name="printColor" tabindex="0" />
                        </div>
                        <div class="d-flex flex-column align-items-center">
                            <label>تعداد رنگ</label>
                            <input class=" form-control" type="text" name="countColor" tabindex="0" />
                        </div>
                        <div class="d-flex flex-column align-items-center">
                            <label>نام طرح</label>
                            <input class=" form-control" type="text" name="designName" tabindex="0" />
                        </div>
                        <div class="d-flex flex-column align-items-center">
                            <label>مقدار</label>
                            <div class="d-flex align-items-center" style="width: 100%">
                                <input class="form-control" style="border-end-start-radius: 0 !important;border-start-start-radius: 0 !important;direction: ltr" type="text" name="weight" tabindex="0" />
                                <select class="inputGroupText" style="width: auto;height: 2rem" type="text" name="unit" tabindex="0">
                                </select>
                            </div>
                        </div>
                        <div class="d-flex flex-column align-items-center">
                            <label>ضخامت</label>
                            <input class=" form-control" type="text" name="thickness" tabindex="0" />
                        </div>

                    </form>
                </div>
                <div style="padding-block: 16px; width:95%;margin-inline:auto  ">
                    <div style="width:100%; height:2px; background-color:#1a2d41;">
                    </div>
                </div>

                <div style="width:100%; display:flex;justify-content:center;">

                    @*<div id="DivAddOr" class="align-items-center" style="gap:4px;display:flex">
                        <button id="CancelBtnId" class="buttonCancel2" onclick="canselModalItemOrder()">انصراف</button>
                        <button id="AddBtnId" class="buttonGreen3" onclick="AddItemCreator()">ثبت</button>
                    </div>*@
                    <div id="DivUpOr" class="align-items-center" style="display:none;gap:4px">
                        <button class="buttonCancel2" onclick="CancelUpOrder()">انصراف</button>
                        <button class="buttonGreen3" onclick="SubmitUpOrder()">ثبت</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>