@using CRM.EndPoint.FrontEnd.Services.Menu
@using CRM.EndPoint.FrontEnd.IServices.Menu
@inject IMenuService MenuService

@{
    var userMenus = await MenuService.GetMenusAsync(User);
    var fixedIds = new[] { "overdueOpenDeals", "warnings", "releaseNotes" };
    var desktopMenus = userMenus.Where(m => m.ShowInDesktop).ToList();
    var desktopMain = desktopMenus.Where(m => !fixedIds.Contains(m.Id)).ToList();
    var desktopFixed = desktopMenus.Where(m => fixedIds.Contains(m.Id)).ToList();

    var mobileMenus = userMenus.Where(m => m.ShowInMobile).ToList();
    var mobileBottom = mobileMenus.Where(m => m.ShowInMobileBottomMenu).ToList();
    var mobileDrawer = mobileMenus.Where(m => !m.ShowInMobileBottomMenu).ToList();
    var mobileMain = mobileDrawer.Where(m => !fixedIds.Contains(m.Id)).ToList();
    var mobileFixed = mobileDrawer.Where(m => fixedIds.Contains(m.Id)).ToList();
    var settings = userMenus.FirstOrDefault(m => m.Id == "settings");
}

<div id="desktopSidebar" class="sidebar">
    <partial name="Menu/_MenuHeader" model="false" />
    <nav id="desktopNavbar" class="menu-nav" aria-label="منوی اصلی">
        <div class="menu-list">
            <div class="menu-search-row" data-menu-search-row>
    <button type="button" class="menu-item menu-search-trigger" data-menu-search-toggle
            data-tooltip-left="جستجوی صفحات" title="جستجوی صفحات"
            aria-label="جستجوی صفحات" aria-expanded="false">
        <span class="menu-icon-frame" aria-hidden="true">
            <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                 stroke-linecap="round" stroke-linejoin="round" focusable="false">
                <circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/>
            </svg>
        </span>
        <span class="menu-item-title">جستجو</span>
    </button>
    <div class="menu-search-panel" data-menu-search-panel>
        <div class="menu-search-field">
            <svg class="menu-search-field-icon" viewBox="0 0 24 24" width="17" height="17"
                 fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/>
            </svg>
            <input type="search" data-menu-search-input placeholder="جستجو در منو..."
                   autocomplete="off" aria-label="جستجو در صفحات منو" />
            <button type="button" data-menu-search-close title="پاک کردن جستجو" aria-label="پاک کردن جستجو">×</button>
        </div>
        <div class="menu-search-results" data-menu-search-results aria-live="polite" hidden></div>
    </div>
</div>
            @foreach (var item in desktopMain) {
                <partial name="Menu/_MenuItem" model="item" />
            }
        </div>
    </nav>
    <div id="desktopFixedActions" class="menu-fixed-actions menu-nav">
        @foreach (var item in desktopFixed) {
            <partial name="Menu/_MenuItem" model="item" />
        }
    </div>
    <div class="menuFooter">
        <a class="ownerCompany-link" href="https://www.natix.ir" target="_blank" rel="noopener noreferrer">
            <img class="ownerCompany-logo" src="~/Img/ownerLogoEW.png" alt="Natix">
            <div class="ownerCompany-info">
                <span class="ownerCompany-name">ناتیکس</span>
                <span class="ownerCompany-subtitle">شرکت مهندسی نرم افزاری</span>
            </div>
        </a>
    </div>
</div>

<div id="mobileMenuBottom">
    <nav id="mobileNavbar">
        @foreach (var item in mobileBottom) {
            <a class="menu-item menu-link" href="@item.Url">
                @Html.Raw(item.IconHtml)
                <span>@item.Title</span>
            </a>
        }
        <span id="mobileMoreMenuBtn" class="menu-item">
            @Html.Raw(MenuIcons.More)
            <span>بیشتر</span>
        </span>
    </nav>
</div>

<div id="mobileDrawerOverlay"></div>
<div id="mobileDrawer">
    <partial name="Menu/_MenuHeader" model="true" />
    <nav id="mobileDrawerNavbar" class="menu-nav" aria-label="منوی بیشتر">
        <div class="menu-list">
            <div class="menu-search-row" data-menu-search-row>
    <button type="button" class="menu-item menu-search-trigger" data-menu-search-toggle
            data-tooltip-left="جستجوی صفحات" title="جستجوی صفحات"
            aria-label="جستجوی صفحات" aria-expanded="false">
        <span class="menu-icon-frame" aria-hidden="true">
            <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                 stroke-linecap="round" stroke-linejoin="round" focusable="false">
                <circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/>
            </svg>
        </span>
        <span class="menu-item-title">جستجو</span>
    </button>
    <div class="menu-search-panel" data-menu-search-panel>
        <div class="menu-search-field">
            <svg class="menu-search-field-icon" viewBox="0 0 24 24" width="17" height="17"
                 fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/>
            </svg>
            <input type="search" data-menu-search-input placeholder="جستجو در منو..."
                   autocomplete="off" aria-label="جستجو در صفحات منو" />
            <button type="button" data-menu-search-close title="پاک کردن جستجو" aria-label="پاک کردن جستجو">×</button>
        </div>
        <div class="menu-search-results" data-menu-search-results aria-live="polite" hidden></div>
    </div>
</div>
            @foreach (var item in mobileMain) {
                <partial name="Menu/_MenuItem" model="item" />
            }
        </div>
    </nav>
    <div id="mobileDrawerFixedActions" class="menu-fixed-actions menu-nav">
        @foreach (var item in mobileFixed) {
            <partial name="Menu/_MenuItem" model="item" />
        }
    </div>
</div>

<form id="menuFavoritesAntiforgery" class="d-none">@Html.AntiForgeryToken()</form>
<partial name="Modals/_SettingModal" model="@(settings?.SubItems ?? new List<CRM.EndPoint.FrontEnd.Models.Menu.MenuItem>())" />
<partial name="Modals/_WarningModal" />
