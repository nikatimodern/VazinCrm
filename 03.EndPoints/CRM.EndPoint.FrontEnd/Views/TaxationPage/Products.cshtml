@model CRM.EndPoint.FrontEnd.Models.Taxation.TaxProductListModel
@{
    ViewData["Title"] = "تطبیق کالاها";
}
@section Styles {
    <link rel="stylesheet" href="~/css/taxation.css" asp-append-version="true" />
}
<section class="taxation-page" id="taxationAdmin" dir="rtl">
    <header class="taxation-heading">
        <h1>تطبیق کالاها</h1>
        <a asp-action="Index">بازگشت به فهرست</a>
    </header>
    <form class="taxation-filters" method="get" asp-action="Products">
        <label>نام یا شناسه مالیاتی کالا <input class="form-control form-control-sm" name="search" value="@Model.Search" maxlength="100" type="search" /></label>
        <label class="form-check"><input class="form-check-input" type="checkbox" name="unmapped" value="true" checked="@Model.Unmapped" /> فقط کالاهای فاقد تطبیق کامل</label>
        <button type="submit" class="btn btn-sm taxation-action">جستجو</button>
    </form>
    @Html.AntiForgeryToken()
    <p data-admin-status role="status"></p>
    @if (Model.Products.Items.Count == 0)
    {
        <p>کالایی برای نمایش پیدا نشد.</p>
    }
    @foreach (var product in Model.Products.Items)
    {
        <article class="taxation-workflow">
            <h2>@(product.Title ?? "کالای بدون عنوان")</h2>
            @if (product.Units.Count == 0)
            {
                <p>واحد فروش در ERP ثبت نشده است.</p>
            }
            @foreach (var unit in product.Units)
            {
                <form method="post" class="taxation-fields" data-admin-action="mapping" data-url="@Url.Action("MapProduct", "Taxation")">
                    <input type="hidden" name="productId" value="@product.Id" />
                    <input type="hidden" name="unit" value="@unit.Code" />
                    <label>واحد ERP <span class="d-block">@(unit.Title ?? unit.Code.ToString())</span></label>
                    <label>شناسه کالا یا خدمت
                        <input class="form-control form-control-sm" name="goodsId" value="@unit.GoodsId" dir="ltr" inputmode="numeric" required maxlength="13" pattern="[0-9]{13}" />
                    </label>
                    <label>کد واحد مالیاتی
                        <input class="form-control form-control-sm" name="taxUnit" value="@unit.TaxUnit" dir="ltr" inputmode="numeric" required maxlength="8" pattern="[0-9]{1,8}" />
                    </label>
                    <button type="submit" class="btn btn-sm taxation-action">ذخیره تطبیق</button>
                </form>
            }
        </article>
    }
    @if (Model.Products.PageCount > 1)
    {
        <nav class="taxation-pagination" aria-label="صفحه‌بندی کالاها">
            @if (Model.Products.Page > 1)
            {
                <a asp-action="Products" asp-route-search="@Model.Search" asp-route-unmapped="@Model.Unmapped"
                   asp-route-page="@(Model.Products.Page - 1)" rel="prev">قبلی</a>
            }
            <span aria-current="page">صفحه @Model.Products.Page از @Model.Products.PageCount</span>
            @if (Model.Products.Page < Model.Products.PageCount)
            {
                <a asp-action="Products" asp-route-search="@Model.Search" asp-route-unmapped="@Model.Unmapped"
                   asp-route-page="@(Model.Products.Page + 1)" rel="next">بعدی</a>
            }
        </nav>
    }
</section>
@section Scripts {
    <script src="~/js/taxation-admin.js" asp-append-version="true"></script>
}
