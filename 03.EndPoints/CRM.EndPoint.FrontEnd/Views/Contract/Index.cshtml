</div>



@section scripts{
    <script data-page-bindings="upCont,Attachments,Contract,delContract,editContract,showModalAdd,SubmitContract,GetCustomersOpId,GetAllContract,UpSubmitContract">
        var upCont = null;
        var Attachments = [];
       
        $(document).ready(() => {
            GetAllContract();
            //GetCustomersOpId();
       

        })

        class Contract {
            constructor() {

            }

            async getContract(id) {
                return new Promise((resolve, reject) => {

                    document.getElementById("FLshowLoading").style.display = "";

                    $.get(baseUrl + `Contract/GetContract/${id}`, (res) => {
                        document.getElementById("FLshowLoading").style.display = "none";
                        Attachments = res.attachments;
                        resolve(res);
                    })


                })
            }
            ShowContract(con) {
                mySer.convertJsonToForm(con, "upFormContractId");

                FileUpReload("ContractAtID");

                $('#upContractModal').modal('toggle');

            }



            async del(cid) {
                return new Promise(async (resolve, reject) => {

                    document.getElementById("FLshowLoading").style.display = "";

                    $.get(baseUrl + `contract/delContract/${cid}`, (res) => {

                        GetAllContract();
                        resolve()

                    })
                        .fail(async () => {
                           
                            await this.del(cid)
                        })



                })
            }

        }


        const delContract = (id) => {

            Swal.fire({
                title: "حذف!",
                text: "آیا مطمئن هستید که میخواهید حذف کنید؟",
                icon: "warning",
                showCancelButton: true,
                cancelButtonColor: "#adadad",
                confirmButtonColor: "#e64942",
                cancelButtonText: "انصراف",
                confirmButtonText: "بله، حذف شود",
            })
                .then(async (willDelete) => {

                    if (willDelete.isConfirmed) {
                        var co = new Contract();
                        upCont = await co.del(id)
                    }

                });




        }

        const editContract = async (id) => {


            var co = new Contract();
            upCont = await co.getContract(id)
            await co.ShowContract(upCont)

        }
        const showModalAdd = () => {
            mySer.emptyForm("FormContractId");
            $("#AddContractModal").modal('show')

        }
        const SubmitContract = async () => {



            if (await mySer.CheckValidForm("#FormContractId")) {

                document.getElementById("FLshowLoading").style.display = "";
                var data = mySer.convertFormToJSON("#FormContractId");
                data.Attachments = Attachments;

                $.post(baseUrl + "Contract/AddContract", data, (res) => {
                    document.getElementById("FLshowLoading").style.display = "none";
                    if (res.status) {
                        toastifySuccess("ثبت شد")
                        mySer.emptyForm("FormContractId");
                        Attachments = [];
                        $('#AddContractModal').modal('toggle')
                        document.getElementById("imageDisplayContract").innerHTML = "";
                        GetAllContract();
                    }
                    else {
                        toastifyError("مقادیر اجباری را وارد کنید")
                    }
                })
                    .fail(() => {
                        SubmitContract();
                    })
            }
        }
        const GetCustomersOpId = () => {
            $.get(baseUrl + "order/GetCustomersOpId", (res) => {
                $("#customer").select2({
                    data: res,
                    dir: "rtl",
                    placeholder: "انتخاب",
                    selectionCssClass: "form-control"
                });
                $("#customer").val(null).trigger('change');
            })
        }
        const GetAllContract = () => {

            document.getElementById("FLshowLoading").style.display = "";


            document.getElementById("ContractsId").innerHTML = "";

            $.get(baseUrl + "contract/GetAllContract", (res) => {


                $("#ContractsId").append(res);
                document.getElementById("FLshowLoading").style.display = "none";

            })



        }

        const UpSubmitContract =async () => {

            if (await mySer.CheckValidForm("#upFormContractId")) {
                document.getElementById("FLshowLoading").style.display = "";
                var data = mySer.convertFormToJSON("#upFormContractId");
                data.id = upCont.id;
                data.Attachments = Attachments;

                $.post(baseUrl + "Contract/AddContract", data, (res) => {
                    document.getElementById("FLshowLoading").style.display = "none";
                    if (res.status) {
                        toastifySuccess("ویرایش انجام شد")
                        mySer.emptyForm("upFormContractId");
                        $('#upContractModal').modal('toggle')
                        GetAllContract();
                    }
                    else {
                        toastifyError("مقادیر اجباری را وارد کنید")
                    }
                })
                    .fail(() => {
                        UpSubmitContract();
                    })

            }


        }


    </script>
}