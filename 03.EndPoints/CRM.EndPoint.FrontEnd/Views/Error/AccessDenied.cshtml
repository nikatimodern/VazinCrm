@{
    Layout = User.IsCustomer() ? "_CustomerLayout" : "_Layout";
    ViewData["Title"] = "عدم دسترسی";
}

<link rel="stylesheet" href="~/css/accessDenied.css" asp-append-version="true" />

<section class="erp-access-denied" dir="rtl" role="alert" aria-labelledby="erpAccessDeniedTitle">
    <div class="erp-access-denied__symbol" aria-hidden="true">
        <i class="fas fa-shield-alt"></i>
        <span class="erp-access-denied__lock"><i class="fas fa-lock"></i></span>
    </div>
    <h1 id="erpAccessDeniedTitle">شما به این بخش دسترسی ندارید</h1>
    <p>برای دسترسی به این بخش، با مدیر سیستم تماس بگیرید.</p>
</section>
