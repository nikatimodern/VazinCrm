            <div class="mx-auto" style="width:97%; height:2px; background-color:var(--DarkColor);"></div>

            <div class="pt-2" style="width:100%; display:flex;justify-content:center">
                @* <button class="buttonGreen" style="border-radius:5px" onclick="submitPrefactor()">ثبت</button> *@
                <button class="buttonCancel2" style="border-radius:5px" onclick="cancelShowDeliverDetailModal() ">انصراف</button>
            </div>


        </div>
    </div>
</div>


<!-- Modal ListInvoice -->
<div class="modal fade" id="InvoiceListModalId" tabindex="-1" role="dialog" data-bs-focus="false" data-bs-backdrop="static">
    <div class=" modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content col-12" style="padding:10px!important">
            <div style="margin-bottom:10px; display:flex; justify-content:center; background-color:var(--DarkColor);color:white;border-radius:5px">
                <label class="fbold text-center" style="padding:5px; font-size:16px;" id="TitleListInvoiceId">لیست پرداختی ها</label>
            </div>
            <div class="modal-body p-0" style=" display:flex;flex-direction:column; justify-content:space-between; width:100% !important;">

