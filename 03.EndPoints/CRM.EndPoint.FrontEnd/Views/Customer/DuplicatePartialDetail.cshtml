                            {
                                <div style="display:flex;flex-wrap:wrap;justify-content:center;"><span> نام: </span><span class="fbold text-center">خانم @item.AgentName </span>  </div>
                            }
                            else
                            {
                                <div style=" display:flex;flex-wrap:wrap;justify-content:center;"><span> نام: </span><span class="fbold text-center">@item.AgentName </span>  </div>
                            }

                            <div style="display:flex;flex-wrap:wrap;justify-content:center;"><span> تلفن همراه : </span><span class="fbold text-center">@item.Mobile </span>  </div>
                            @if (item.Juridical == 1)
                            {
                                <div style="display:flex;flex-wrap:wrap; justify-content:center"><span> شرکت: </span><span class="fbold text-center">@item.CompanyName </span>  </div>
                                @* <div style="display:flex"><span> نوع: </span><span class="fbold">حقوقی</span>  </div> *@
                            }
                            else
                            {
                                @* <div style="display:flex"><span> نوع: </span><span class="fbold">حقیقی</span>  </div> *@
