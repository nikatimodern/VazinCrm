@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mx-auto col-12">
    <div style="width:100%">
        <div class="report-page-header w-100">
            <div class="d-flex justify-content-between align-items-start flex-wrap" style="column-gap:.5rem;row-gap: .25rem">
                <div class="col-12 col-md-auto d-flex align-items-center gap-2 flex-wrap" style="flex:unset">
                    <div class="d-flex align-items-center justify-content-between flex-grow-1 flex-wrap flex-lg-nowrap" style="gap:4px">
                        <div class="d-flex align-items-center w-100" style="gap:4px">
                            <input type="text" class="form-control form-control-sm " id="reportSearchId" placeholder="جستجو">
                            <div data-filterVarConfig="filterReportConfig" data-filterCallBack="callbackFilterReport" data-filterContentId="ContentReportFilterId" data-filterInpSearchId="reportSearchId" data-filterVarSearch="reportSearchVal" onclick="ShowFilterPopup(this)" class="btnFilter">
                                <svg style="width:24px;height:24px;color:#333" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M3.792 2.938A49.069 49.069 0 0 1 12 2.25c2.797 0 5.54.236 8.209.688a1.857 1.857 0 0 1 1.541 1.836v1.044a3 3 0 0 1-.879 2.121l-6.182 6.182a1.5 1.5 0 0 0-.439 1.061v2.927a3 3 0 0 1-1.658 2.684l-1.757.878A.75.75 0 0 1 9.75 21v-5.818a1.5 1.5 0 0 0-.44-1.06L3.13 7.938a3 3 0 0 1-.879-2.121V4.774c0-.897.64-1.683 1.542-1.836Z" clip-rule="evenodd" /></svg>
                            </div>
                        </div>
                    </div>
                    <ul class="filter-switch">
                        <li class="filter-switch-item">
                            <input type="radio" name="reportStatus" value="-1" id="reportStatus-all" checked>
                            <label for="reportStatus-all">همه</label>
                        </li>
                        <li class="filter-switch-item">
                            <input type="radio" name="reportStatus" value="1" id="reportStatus-follow-up">
                            <label for="reportStatus-follow-up">پیگیری</label>
                        </li>
                        <li class="filter-switch-item">
                            <input type="radio" name="reportStatus" value="2" id="reportStatus-call">
                            <label for="reportStatus-call">تماس های ورودی</label>
                        </li>
                        <li class="filter-switch-item">
                            <input type="radio" name="reportStatus" value="3" id="reportStatus-satisfaction">
                            <label for="reportStatus-satisfaction">رضایتمندی</label>
                        </li>
                    </ul>

                    <div id="ContentReportFilterId" class="ContentFilter"></div>
                </div>
                <div class="d-flex justify-content-between flex-grow-1 gap-2 flex-wrap">

                    <div class="d-flex align-items-center gap-1">
                        <input type="checkbox" id="myReportId" tabindex="-1" />
                        <label for="myReportId">گزارش‌های من</label>
                    </div>

                    <div class="d-flex align-items-center flex-grow-1 justify-content-end" style="row-gap:8px;column-gap:12px">
                        <label class="d-flex align-items-center gap-1" for="reportCountSelect">
                            نمایش
                            <select class="form-select form-select-sm" style="background-position: left 6px center;padding-left:24px;" id="reportCountSelect" tabindex="-1">
                                <option value="20">20</option>
                                <option value="50" selected>50</option>
                                <option value="100">100</option>
                                <option value="200">200</option>
                                <option value="0">همه</option>
                            </select>
                            گزارش
                        </label>

                        <div class="d-flex align-items-center gap-1">
                            <button class="buttonExcel" onclick="ExportExcelReport()" tabindex="-1">
                                <svg style="color:#fff;width:78%" fill="currentColor" viewBox="0 0 256 256"><path d="M156,208a8,8,0,0,1-8,8H120a8,8,0,0,1-8-8V152a8,8,0,0,1,16,0v48h20A8,8,0,0,1,156,208ZM92.65,145.49a8,8,0,0,0-11.16,1.86L68,166.24,54.51,147.35a8,8,0,1,0-13,9.3L58.17,180,41.49,203.35a8,8,0,0,0,13,9.3L68,193.76l13.49,18.89a8,8,0,0,0,13-9.3L77.83,180l16.68-23.35A8,8,0,0,0,92.65,145.49Zm98.94,25.82c-4-1.16-8.14-2.35-10.45-3.84-1.25-.82-1.23-1-1.12-1.9a4.54,4.54,0,0,1,2-3.67c4.6-3.12,15.34-1.72,19.82-.56a8,8,0,0,0,4.07-15.48c-2.11-.55-21-5.22-32.83,2.76a20.58,20.58,0,0,0-8.95,14.95c-2,15.88,13.65,20.41,23,23.11,12.06,3.49,13.12,4.92,12.78,7.59-.31,2.41-1.26,3.33-2.15,3.93-4.6,3.06-15.16,1.55-19.54.35A8,8,0,0,0,173.93,214a60.63,60.63,0,0,0,15.19,2c5.82,0,12.3-1,17.49-4.46a20.81,20.81,0,0,0,9.18-15.23C218,179,201.48,174.17,191.59,171.31ZM40,112V40A16,16,0,0,1,56,24h96a8,8,0,0,1,5.66,2.34l56,56A8,8,0,0,1,216,88v24a8,8,0,1,1-16,0V96H152a8,8,0,0,1-8-8V40H56v72a8,8,0,0,1-16,0ZM160,80h28.68L160,51.31Z"></path></svg>
                            </button>
                            <div style="cursor:pointer;display:flex;justify-content:space-evenly;border-radius:5px !important; padding: 0 !important;height: 28px;width: 34px" class="buttonOrange" onclick="ShowModalReport()">
                                <i class="fa fa-plus"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div>
                <div id="resultFollowUpFilterContainer" class="d-flex flex-wrap gap-2 mt-2 d-none">
                    <div class="resultCallWrapper">
                        <label for="resultCallFilter" style="color: #444">نتیجه تماس:</label>
                        <select class="form-select form-select-sm" name="resultCallId" id="resultCallFilter">
                        </select>
                    </div>
                    <div class="finalResultCallWrapper">
                        <label for="finalResultCallFilter" style="color: #444">نتیجه نهایی:</label>
                        <select class="form-select form-select-sm" name="finalResultCallId" id="finalResultCallFilter">
                        </select>
                    </div>
                    <div class="reasonCancelWrapper">
                        <label for="reasonCancelFilter" style="color: #444">علت انصراف:</label>
                        <select class="form-select form-select-sm" name="reasonCancelId" id="reasonCancelFilter">
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div id="allReportsId"></div>
    </div>
</div>

@section scripts {
    <script defer>
        var ReportTBL = null;
        var reportSearchVal = null;

        async function callbackFilterReport() {
            const reportElement = document.getElementById("myReportId");
            const selFilterChd = filterReportConfig?.filterVar?.SelFilterChd === true;
            reportElement.checked = selFilterChd;
            reportElement.parentElement.classList.toggle("d-none", selFilterChd);

            await getAllReports(filterReportConfig);
        }


        document.addEventListener("DOMContentLoaded", async () => {
            await Promise.all([getAllReports(), initReportHeader()]);

            document.getElementById("reportSearchId").addEventListener("keyup", async (e) => {
                if (e.key === "Enter") {
                    e.preventDefault();
                    filterReportConfig.varSearch = e.target.value;
                    await getAllReports(filterReportConfig);
                }
            });

            document.getElementById("myReportId").addEventListener("change", async (e) => {
                filterReportConfig.filterVar = {
                    ...filterReportConfig.filterVar,
                    SelFilterChd: e.target.checked,
                    selFilter: e.target.checked ? currentUser.id : null,
                };
                await getAllReports(filterReportConfig);
            });

            document.getElementById("reportCountSelect").addEventListener("change", async (e) => {
                filterReportConfig.count = Number(e.target.value);
                await getAllReports(filterReportConfig);
            });

        });


        async function initReportHeader() {
            const baseItem = await getBaseItemsReport();
            createOption("resultCallFilter", baseItem.resultCall, true, "همه");
            createOption("finalResultCallFilter", baseItem.finalResultCall, true, "همه");
            createOption("reasonCancelFilter", baseItem.reasonCancel, true, "همه");

            const container = document.querySelector(".report-page-header");

            const resultCallWrapper = container.querySelector(".resultCallWrapper");
            const finalResultCallWrapper = container.querySelector(".finalResultCallWrapper");
            const reasonCancelWrapper = container.querySelector(".reasonCancelWrapper");

            const resultCallSelect = resultCallWrapper.querySelector("select");
            const finalResultCallSelect = finalResultCallWrapper.querySelector("select");
            const reasonCancelSelect = reasonCancelWrapper.querySelector("select");

            container.querySelectorAll("input[name='reportStatus']").forEach(elm => elm.addEventListener("change", (e) => {
                const showResultFollowUpContainer = Number(e.target.value) === 1;
                container.querySelector("#resultFollowUpFilterContainer").classList.toggle("d-none", !showResultFollowUpContainer);
                reasonCancelWrapper.classList.toggle("d-none", true);
                resultCallSelect.value = "";
                finalResultCallSelect.value = "";
                reasonCancelSelect.value = "";

                callReports();
            }));

            resultCallSelect.addEventListener("change", (e) => {
                const value = e.target.value;
                const showFinalResult = value === "ed0feaf4-9264-4028-b8cf-1a268bfc1c9a"
                    || value === "310df88c-b65b-4f26-9f1e-ab72f489bc1e"
                    || value === "986e7e82-9853-402f-a7f6-36252965ff82";
                const showReasonCancel = value === "986e7e82-9853-402f-a7f6-36252965ff82";

                // if (showReasonCancel) {
                finalResultCallSelect.value = showReasonCancel ? "82769710-880f-43aa-bd83-f5c6016ce38c" : "";
                // }
                reasonCancelWrapper.classList.toggle("d-none", finalResultCallSelect.value !== "82769710-880f-43aa-bd83-f5c6016ce38c");
                reasonCancelSelect.value = "";
                toggleElementsDisabled(finalResultCallSelect, showReasonCancel);

                callReports();
            });

            finalResultCallSelect.addEventListener("change", (e) => {
                const value = e.target.value;
                const showReasonCancel = value === "82769710-880f-43aa-bd83-f5c6016ce38c";

                reasonCancelSelect.value = "";
                reasonCancelWrapper.classList.toggle("d-none", !showReasonCancel);
                toggleElementsRequired(reasonCancelSelect, showReasonCancel);

                callReports();
            });

            reasonCancelSelect.addEventListener("change", () => {
                callReports();
            });

            function callReports() {
                const reportType = container.querySelector("input[name='reportStatus']:checked").value;
                filterReportConfig._type = Number(reportType);
                filterReportConfig.resultCallId = resultCallSelect.value || null;
                filterReportConfig.reasonCancelId = reasonCancelSelect.value || null;
                filterReportConfig.finalResultCallId = finalResultCallSelect.value || null;
                getAllReports(filterReportConfig);
            }
        }

        const ExportExcelReport = async () => {
            $("#FLshowLoading").css("display", "");

            const data = filterReportConfig || {};

            const model = {
                ...data,
                filt: data.filterVar,
                serVal: data.varSearch,
                _type: filterReportConfig._type ?? -1,
                count: filterReportConfig.count ?? 50,
            };

            fetch("/Report/ExportExcelReport", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify(model),
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! Status: ${response.status}`);
                    } else {
                        $("#FLshowLoading").css("display", "none");
                        return response.blob(); // تبدیل پاسخ به Blob
                    }
                })
                .then(blob => {
                    const url = window.URL.createObjectURL(blob); // ایجاد URL برای Blob
                    const a = document.createElement("a");
                    a.href = url;
                    a.download = "ReportsExcel.xlsx"; // نام و فرمت دلخواه فایل
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    window.URL.revokeObjectURL(url); // پاکسازی URL Blob پس از دانلود
                })
                .catch(error => {
                    console.error("Error:", error);
                });
        };


    </script>
}

