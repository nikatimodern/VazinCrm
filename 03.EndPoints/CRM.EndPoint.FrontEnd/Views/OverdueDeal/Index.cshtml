@{
    ViewData["Title"] = "سفارشات باز معوقه";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-3" dir="rtl">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
        <div class="d-flex align-items-center gap-2">
            <span class="d-inline-flex align-items-center justify-content-center rounded-3 p-2"
                  style="background: rgba(109, 40, 217, .12); color: #6d28d9;">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M12 2.25a9.75 9.75 0 1 0 0 19.5 9.75 9.75 0 0 0 0-19.5ZM12 6a.75.75 0 0 1 .75.75v5.1l3.03 1.82a.75.75 0 1 1-.772 1.286l-3.375-2.025A.75.75 0 0 1 11.25 12V6.75A.75.75 0 0 1 12 6Z" clip-rule="evenodd" />
                </svg>
            </span>
            <div>
                <h1 class="h5 mb-1">سفارشات باز معوقه</h1>
                <p class="text-muted mb-0">سفارش‌های باز با بیش از ۱۴ روز از زمان ثبت</p>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted small">تعداد:</span>
            <span id="overdueDealCount" class="badge rounded-pill overdue-count-badge">۰</span>
            <button type="button" id="refreshOverdueDeals" class="btn btn-outline-secondary btn-sm">
                <span class="me-1">بروزرسانی</span>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M20 7v5h-5M4 17v-5h5" />
                    <path d="M5.5 9A7 7 0 0 1 18 6l2 6M4 12l2 6a7 7 0 0 0 12.5-3" />
                </svg>
            </button>
        </div>
    </div>

    <div class="d-flex justify-content-end align-items-center mb-3">
        <input type="hidden" id="overdueDealSearch" value="" />
        <div id="ContentOverdueDealFilterId" class="ContentFilter"></div>
        <button type="button" class="btnFilter" style="display:inline-flex;align-items:center;justify-content:center;cursor:pointer;"
                data-filterVarConfig="filterDealConfig" data-filterCallBack="callbackFilterOverdueDeal"
                data-filterContentId="ContentOverdueDealFilterId" data-filterInpSearchId="overdueDealSearch"
                data-filterVarSearch="overdueDealSearchVal" onclick="ShowFilterPopup(this)" title="فیلتر">
            <svg style="width:24px;color:#333" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3.792 2.938A49.069 49.069 0 0 1 12 2.25c2.797 0 5.54.236 8.209.688a1.857 1.857 0 0 1 1.541 1.836v1.044a3 3 0 0 1-.879 2.121l-6.182 6.182a1.5 1.5 0 0 0-.439 1.061v2.927a3 3 0 0 1-1.658 2.684l-1.757.878A.75.75 0 0 1 9.75 21v-5.818a1.5 1.5 0 0 0-.44-1.06L3.13 7.938a3 3 0 0 1-.879-2.121V4.774c0-.897.64-1.683 1.542-1.836Z" clip-rule="evenodd"></path></svg>
        </button>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div id="overdueDealsLoading" class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">در حال دریافت اطلاعات...</span>
                </div>
                <p class="text-muted mt-3 mb-0">در حال دریافت سفارشات معوقه...</p>
            </div>

            <div id="overdueDealsError" class="alert alert-danger m-3 d-none" role="alert"></div>

            <div id="overdueDealsEmpty" class="text-center py-5 d-none">
                <div class="mb-2" style="font-size: 2rem; color: #16a34a;">✓</div>
                <h2 class="h6">سفارش معوقه‌ای وجود ندارد</h2>
                <p class="text-muted mb-0">در حال حاضر سفارشی با وضعیت باز و بیش از ۱۴ روز از زمان ثبت پیدا نشد.</p>
            </div>

            <div id="overdueDealsTableWrap" class="table-responsive d-none">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-nowrap">شماره سفارش</th>
                            <th>عنوان سفارش</th>
                            <th>مشتری</th>
                            <th class="text-nowrap">کد مشتری</th>
                            <th class="text-nowrap">تاریخ ثبت</th>
                            <th class="text-nowrap">مدت انتظار</th>
                            <th>ثبت‌کننده</th>
                            <th>توضیحات</th>
                        </tr>
                    </thead>
                    <tbody id="overdueDealsTableBody"></tbody>
                </table>
            </div>
            <div id="overdueDealsPagination" class="d-flex flex-wrap align-items-center justify-content-between gap-3 p-3 border-top d-none">
                <div class="d-flex align-items-center gap-2">
                    <label for="overduePageSize" class="small text-muted mb-0">تعداد در صفحه</label>
                    <select id="overduePageSize" class="form-select form-select-sm" style="width: auto;">
                        <option value="10">۱۰</option>
                        <option value="20" selected>۲۰</option>
                        <option value="50">۵۰</option>
                        <option value="100">۱۰۰</option>
                        <option value="0">همه</option>
                    </select>
                    <span id="overduePaginationInfo" class="small text-muted"></span>
                </div>
                <nav aria-label="صفحه‌بندی سفارشات معوقه">
                    <ul id="overduePaginationButtons" class="pagination pagination-sm mb-0"></ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="overdueDealDetailsModal" tabindex="-1" aria-labelledby="overdueDealDetailsModalLabel" aria-hidden="true" dir="rtl">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title" id="overdueDealDetailsModalLabel">جزئیات سفارش</h5>
                <button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3" id="overdueDealDetailsContent"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">بستن</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var filterDealConfig = window.filterDealConfig || {};
        var overdueDealSearchVal = null;

        document.addEventListener("DOMContentLoaded", () => {
            const loading = document.getElementById("overdueDealsLoading");
            const error = document.getElementById("overdueDealsError");
            const empty = document.getElementById("overdueDealsEmpty");
            const tableWrap = document.getElementById("overdueDealsTableWrap");
            const tableBody = document.getElementById("overdueDealsTableBody");
            const count = document.getElementById("overdueDealCount");
            const refreshButton = document.getElementById("refreshOverdueDeals");
            const dealDetailsModalElement = document.getElementById("overdueDealDetailsModal");
            const dealDetailsContent = document.getElementById("overdueDealDetailsContent");
            const dealDetailsModal = window.bootstrap?.Modal
                ? new bootstrap.Modal(dealDetailsModalElement)
                : null;
            const pageSizeSelect = document.getElementById("overduePageSize");
            const pagination = document.getElementById("overdueDealsPagination");
            const paginationInfo = document.getElementById("overduePaginationInfo");
            const paginationButtons = document.getElementById("overduePaginationButtons");
            const searchInput = document.getElementById("overdueDealSearch");
            let allDeals = [];
            let currentPage = 1;
            let pageSize = 20;
            let overdueFilter = null;
            let overdueSearchVal = "";

            const escapeHtml = (value) => String(value ?? "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#39;");

            const formatDate = (value) => {
                if (!value) return "—";
                const date = new Date(value);
                if (Number.isNaN(date.getTime())) return "—";
                return new Intl.DateTimeFormat("fa-IR", {
                    year: "numeric", month: "2-digit", day: "2-digit"
                }).format(date);
            };

            const getWaitingDays = (value) => {
                if (!value) return 0;
                const date = new Date(value);
                if (Number.isNaN(date.getTime())) return 0;
                return Math.max(0, Math.floor((Date.now() - date.getTime()) / 86400000));
            };

            const renderCurrentPage = () => {
                const total = allDeals.length;
                const effectivePageSize = pageSize === 0 ? Math.max(total, 1) : pageSize;
                const totalPages = Math.max(1, Math.ceil(total / effectivePageSize));
                currentPage = Math.min(currentPage, totalPages);
                const startIndex = (currentPage - 1) * effectivePageSize;
                const pageDeals = allDeals.slice(startIndex, startIndex + effectivePageSize);

                tableBody.innerHTML = pageDeals.map(deal => {
                    const customerName = deal.cusCompanyName || deal.customerName || "—";
                    const waitingDays = getWaitingDays(deal.createDate);
                    return `
                        <tr>
                            <td class="text-nowrap fw-semibold">
                                <button type="button" class="btn btn-link p-0 text-decoration-none overdue-deal-number"
                                        data-deal-id="${escapeHtml(deal.id)}" style="color: #6d28d9; font-weight: 700;">
                                    ${escapeHtml(deal.serialNumber)}
                                </button>
                            </td>
                            <td>${escapeHtml(deal.title || "—")}</td>
                            <td>${escapeHtml(customerName)}</td>
                            <td class="text-nowrap">${escapeHtml(deal.customerCode ?? "—")}</td>
                            <td class="text-nowrap">${escapeHtml(formatDate(deal.createDate))}</td>
                            <td class="text-nowrap"><span class="badge text-bg-danger">${escapeHtml(new Intl.NumberFormat("fa-IR").format(waitingDays))} روز</span></td>
                            <td>${escapeHtml(deal.userCreator || "—")}</td>
                            <td style="min-width: 220px; white-space: normal;">${escapeHtml(deal.commentText || "—")}</td>
                        </tr>`;
                }).join("");

                tableWrap.classList.remove("d-none");
                pagination.classList.remove("d-none");
                paginationInfo.textContent = `${new Intl.NumberFormat("fa-IR").format(total ? startIndex + 1 : 0)} تا ${new Intl.NumberFormat("fa-IR").format(Math.min(startIndex + pageDeals.length, total))} از ${new Intl.NumberFormat("fa-IR").format(total)}`;

                paginationButtons.innerHTML = "";
                const addPageButton = (label, page, disabled = false, active = false) => {
                    const li = document.createElement("li");
                    li.className = "page-item" + (disabled ? " disabled" : "") + (active ? " active" : "");
                    const button = document.createElement("button");
                    button.type = "button";
                    button.className = "page-link";
                    button.textContent = label;
                    button.disabled = disabled;
                    button.addEventListener("click", () => {
                        currentPage = page;
                        renderCurrentPage();
                    });
                    li.appendChild(button);
                    paginationButtons.appendChild(li);
                };

                addPageButton("قبلی", Math.max(1, currentPage - 1), currentPage === 1);
                const first = Math.max(1, currentPage - 2);
                const last = Math.min(totalPages, currentPage + 2);
                for (let page = first; page <= last; page++) {
                    addPageButton(new Intl.NumberFormat("fa-IR").format(page), page, false, page === currentPage);
                }
                addPageButton("بعدی", Math.min(totalPages, currentPage + 1), currentPage === totalPages);

                tableBody.querySelectorAll(".overdue-deal-number").forEach(button => {
                    button.addEventListener("click", () => {
                        const deal = pageDeals.find(item => String(item.id).toLowerCase() === button.dataset.dealId.toLowerCase());
                        if (!deal) return;
                        const details = [
                            ["شماره سفارش", deal.serialNumber], ["عنوان سفارش", deal.title],
                            ["نام مشتری", deal.customerName], ["نام شرکت", deal.cusCompanyName],
                            ["کد مشتری", deal.customerCode], ["موبایل", deal.mobileNumber],
                            ["تاریخ ثبت", formatDate(deal.createDate)],
                            ["مدت انتظار", new Intl.NumberFormat("fa-IR").format(getWaitingDays(deal.createDate)) + " روز"],
                            ["ثبت‌کننده", deal.userCreator], ["توضیحات", deal.commentText]
                        ];
                        dealDetailsContent.innerHTML = details.map(([label, value]) => `
                            <div class="col-12 col-md-6"><div class="border rounded-3 p-3 h-100">
                                <div class="small text-muted mb-1">${escapeHtml(label)}</div>
                                <div class="fw-semibold text-break" style="white-space: pre-wrap;">${escapeHtml(value || "—")}</div>
                            </div></div>`).join("");
                        dealDetailsModal?.show();
                    });
                });
            };

            window.callbackFilterOverdueDeal = async () => {
                overdueFilter = window.filterDealConfig?.filterVar ?? null;
                overdueSearchVal = window.filterDealConfig?.varSearch ?? searchInput.value.trim();
                searchInput.value = overdueSearchVal || "";
                currentPage = 1;
                await loadOverdueDeals();
            };

            const loadOverdueDeals = async () => {
                loading.classList.remove("d-none");
                error.classList.add("d-none");
                empty.classList.add("d-none");
                tableWrap.classList.add("d-none");
                tableBody.innerHTML = "";
                refreshButton.disabled = true;

                try {
                    const requestModel = { filt: overdueFilter, serVal: searchInput.value.trim() || null };
                    const response = await axios.post("/OverdueDeal/GetOverdueDeals", requestModel);
                    allDeals = response.data?.data ?? [];
                    allDeals.sort((a, b) => new Date(b.createDate) - new Date(a.createDate));
                    count.textContent = new Intl.NumberFormat("fa-IR").format(allDeals.length);
                    currentPage = Math.min(currentPage, Math.max(1, Math.ceil(allDeals.length / (pageSize || Math.max(allDeals.length, 1)))));

                    if (allDeals.length === 0) {
                        pagination.classList.add("d-none");
                        empty.classList.remove("d-none");
                        return;
                    }

                    renderCurrentPage();
                } catch (err) {
                    console.error("Failed to load overdue deals:", err);
                    error.textContent = err.response?.status === 403
                        ? "شما مجوز مشاهده این اطلاعات را ندارید."
                        : "دریافت سفارشات معوقه با خطا مواجه شد. لطفاً دوباره تلاش کنید.";
                    error.classList.remove("d-none");
                } finally {
                    loading.classList.add("d-none");
                    refreshButton.disabled = false;
                }
            };

            pageSizeSelect.addEventListener("change", () => {
                pageSize = Number(pageSizeSelect.value);
                currentPage = 1;
                if (allDeals.length) renderCurrentPage();
            });
            refreshButton.addEventListener("click", loadOverdueDeals);
            loadOverdueDeals();
        });
    </script>
}
