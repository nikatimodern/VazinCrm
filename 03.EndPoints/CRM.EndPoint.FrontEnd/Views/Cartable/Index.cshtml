                    toastifySuccess("بهای تامین با موفقیت ثبت شد");
                    GetPreFactorTaminExpert();
                    FLshowLoading(false);
                    return true;
                }
            } catch (err) {
                console.log(err);
                setTimeout(async () => await submitAmountTaminModal(), 3000);
                return false;
            }

        };

