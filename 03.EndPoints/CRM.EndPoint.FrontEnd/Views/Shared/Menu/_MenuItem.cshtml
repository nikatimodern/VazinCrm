@model MenuItem

@if (Model.SubItems?.Count > 0) {
    // Menu item with submenu
    <div class="has-submenu @(Model.Id)-menu">
        <span data-tooltip-left="@Model.Title" class="menu-item">
            @Html.Raw(Model.IconHtml)
            <span class="menu-item-title">
                <span>@Model.Title</span>
                <svg class="submenu-arrow" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M9.78 4.22a.75.75 0 0 1 0 1.06L7.06 8l2.72 2.72a.75.75 0 1 1-1.06 1.06L5.47 8.53a.75.75 0 0 1 0-1.06l3.25-3.25a.75.75 0 0 1 1.06 0Z" clip-rule="evenodd" /></svg>
            </span>
        </span>
        <ul class="submenu">
            @foreach (var sub in Model.SubItems) {
                <li>
                    <partial name="Menu/_MenuItem" model="sub" />
                </li>
            }
        </ul>
    </div>
} else if (string.IsNullOrEmpty(Model.Url)) {
    // Menu button
    <button type="button" id="@Model.ElementId" class="menu-item @Model.ClassName" data-tooltip-left="@Model.Title" onclick="@Model.OnClick">
        @Html.Raw(Model.IconHtml)
        <span class="menu-item-title">
            <span>@Model.Title</span>
            @if (Model.HasBadge) {
                <span class="badgeCircle"></span>
            }
        </span>
    </button>
} else {
    // Menu link
    <a href="@Model.Url" id="@Model.ElementId" class="menu-item menu-link @Model.ClassName" data-tooltip-left="@Model.Title">
        @Html.Raw(Model.IconHtml)
        <span class="menu-item-title">
            <span>@Model.Title</span>
            @if (Model.HasBadge) {
                <span class="badgeCircle"></span>
            }
        </span>
    </a>
}