@model CRM.EndPoint.FrontEnd.Models.Admin.AdminViewModel

<div class="modal fade" id="ModalRols" tabindex="-1" role="dialog" data-bs-focus="false" aria-labelledby="rolesModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header" style="direction:rtl;background-color:lightgray">
                <h1 class="modal-title fs-5" id="rolesModalTitle">مدیریت نقش‌های کاربر</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UpdateUserRoles" method="post" id="userRolesForm">
                @Html.AntiForgeryToken()
                <div class="modal-body" dir="rtl">
                    <input type="hidden" name="userName" id="userName" />
                    <div class="mb-3">
                        <label for="rolesUserNameDisplay" class="form-label">نام کاربری</label>
                        <input type="text" id="rolesUserNameDisplay" class="form-control" readonly />
                    </div>
                    <p class="mb-2">نقش‌های موردنظر را انتخاب کنید. نقش‌های تیک‌خورده پس از ثبت برای کاربر باقی می‌مانند.</p>
                    <div id="rolesLoading" class="text-center py-4" style="display:none" aria-live="polite"><span class="spinner-border spinner-border-sm text-success" role="status" aria-hidden="true"></span><div class="mt-2">در حال دریافت اطلاعات نقش‌ها...</div></div>
                    <div id="userRolesList" class="d-flex flex-column gap-2">
                        @foreach (var item in Model.Roles ?? []) {
                            <label class="form-check d-flex align-items-center gap-2 border rounded p-2" style="cursor:pointer">
                                <input class="form-check-input role-checkbox m-0" type="checkbox" name="roleNames" value="@item.Name" />
                                <span class="form-check-label">@item.Name</span>
                            </label>
                        }
                    </div>
                    <div id="rolesLoadError" class="text-danger mt-2" style="display:none">دریافت نقش‌های کاربر ناموفق بود. دوباره تلاش کنید.</div>
                    <div id="rolesSaveError" class="text-danger mt-2" style="display:none"></div>
                    <div id="rolesSaving" class="text-center mt-3" style="display:none" aria-live="polite"><span class="spinner-border spinner-border-sm text-success" role="status" aria-hidden="true"></span><span class="ms-2">در حال ثبت تغییرات...</span></div>
                </div>
                <div class="modal-footer d-flex justify-content-between">
                    <button type="button" class="buttonCancel2" data-bs-dismiss="modal">انصراف</button>
                    <button type="submit" class="buttonGreen3" id="saveUserRolesButton">ثبت تغییرات</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    async function openUserRolesModal(userName) {
        document.getElementById("userName").value = userName;
        document.getElementById("rolesUserNameDisplay").value = userName;
        document.getElementById("rolesLoadError").style.display = "none";
        document.getElementById("rolesLoading").style.display = "block";
        document.getElementById("userRolesList").style.opacity = "0.45";
        document.querySelectorAll("#userRolesList .role-checkbox").forEach(input => input.checked = false);

        const modalElement = document.getElementById("ModalRols");
        bootstrap.Modal.getOrCreateInstance(modalElement).show();

        try {
            if (typeof axios === "undefined") {
                throw new Error("کتابخانه Axios در صفحه بارگذاری نشده است.");
            }

            const response = await axios.get("/Admin/GetUserRoles", {
                params: { userName: userName },
                headers: { "X-Requested-With": "XMLHttpRequest" },
                timeout: 15000
            });
            const currentRoles = response.data;
            if (!Array.isArray(currentRoles)) {
                throw new Error("پاسخ سرور برای نقش‌های کاربر معتبر نیست.");
            }

            document.querySelectorAll("#userRolesList .role-checkbox").forEach(input => {
                input.checked = currentRoles.includes(input.value);
            });
        } catch (error) {
            const errorBox = document.getElementById("rolesLoadError");
            errorBox.textContent = error.response?.data?.message || error.message || "دریافت نقش‌های کاربر ناموفق بود. دوباره تلاش کنید.";
            errorBox.style.display = "block";
        } finally {
            document.getElementById("rolesLoading").style.display = "none";
            document.getElementById("userRolesList").style.opacity = "1";
        }
    }

    document.getElementById("userRolesForm").addEventListener("submit", async function (event) {
        event.preventDefault();
        const form = event.currentTarget;
        const button = document.getElementById("saveUserRolesButton");
        const errorBox = document.getElementById("rolesSaveError");
        errorBox.style.display = "none";

        if (typeof axios === "undefined") {
            errorBox.textContent = "کتابخانه Axios در صفحه بارگذاری نشده است.";
            errorBox.style.display = "block";
            return;
        }

        const payload = new URLSearchParams();
        payload.append("userName", document.getElementById("userName").value);
        const token = form.querySelector('input[name="__RequestVerificationToken"]');
        if (token) payload.append("__RequestVerificationToken", token.value);
        form.querySelectorAll('input[name="roleNames"]:checked').forEach(input => payload.append("roleNames", input.value));

        const oldText = button.textContent;
        button.disabled = true;
        button.textContent = "در حال ثبت...";
        try {
            const response = await axios.post(form.action, payload, {
                headers: { "Content-Type": "application/x-www-form-urlencoded", "X-Requested-With": "XMLHttpRequest" }
            });
            if (!response.data || response.data.success !== true) throw new Error("ثبت نقش‌ها موفق نبود.");
            updateUserRolesTable(document.getElementById("userName").value, response.data.roles || []);
            bootstrap.Modal.getOrCreateInstance(document.getElementById("ModalRols")).hide();
        } catch (error) {
            errorBox.textContent = error.response?.data?.message || error.message || "ثبت نقش‌ها انجام نشد. دوباره تلاش کنید.";
            errorBox.style.display = "block";
        } finally {
            button.disabled = false;
            button.textContent = oldText;
        }
    });

    function updateUserRolesTable(userName, roles) {
        const card = Array.from(document.querySelectorAll("#usersCardList .user-card[data-user-name]"))
            .find(item => item.dataset.userName === userName);
        const cell = card?.querySelector(".user-roles-cell");
        if (!cell) return;

        cell.replaceChildren();
        if (!roles.length) {
            const empty = document.createElement("span");
            empty.className = "user-no-roles";
            empty.textContent = "بدون نقش";
            cell.appendChild(empty);
        } else {
            roles.forEach(role => {
                const chip = document.createElement("span");
                chip.className = "user-role-chip";
                const remove = document.createElement("button");
                remove.type = "button";
                remove.className = "role-remove-button";
                remove.title = "حذف نقش";
                remove.setAttribute("aria-label", "حذف نقش " + role);
                remove.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>';
                remove.addEventListener("click", () => DelUserRole(remove, card.dataset.userId, role, userName));
                const label = document.createElement("span");
                label.textContent = role;
                chip.append(remove, label);
                cell.appendChild(chip);
            });
        }

        const searchable = [card.querySelector("h3")?.textContent, card.querySelector(".user-card-username")?.textContent,
            ...Array.from(card.querySelectorAll(".user-detail strong")).map(item => item.textContent), ...roles].join(" ");
        card.dataset.search = searchable;
        if (typeof renderUserCards === "function") renderUserCards();
    }

    async function removeUserRoleWithoutReload(userId, role, userName) {
        const payload = new URLSearchParams();
        payload.append("id", userId);
        payload.append("role", role);
        const token = document.querySelector('#userRolesForm input[name="__RequestVerificationToken"]');
        if (token) payload.append("__RequestVerificationToken", token.value);
        try {
            await axios.post("/Admin/DelUserRol", payload, {
                headers: { "Content-Type": "application/x-www-form-urlencoded", "X-Requested-With": "XMLHttpRequest" }
            });
            const response = await axios.get("/Admin/GetUserRoles", { params: { userName }, timeout: 15000 });
            updateUserRolesTable(userName, response.data || []);
        } catch {
            window.alert("حذف نقش انجام نشد. دوباره تلاش کنید.");
        }
    }
</script>