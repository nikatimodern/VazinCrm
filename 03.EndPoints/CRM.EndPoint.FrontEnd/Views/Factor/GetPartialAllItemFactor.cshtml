@using CRM.EndPoint.FrontEnd.Models.ViewModel.RemainedPf;

@model IList<AllItemsViewModel>


<div class="p-2" style="width:100%;direction:rtl; max-height: calc(100dvh - 400px);overflow-y: auto;overflow-x: hidden;">

    <table id="AllItemsFactorTable" class="table table-striped table-bordered table-hover no-footer nowrap" style="width:100%">
        <thead>
        <tr>
            <th>نام محصول</th>
            <th>وزن پیش فاکتور</th>
            <th>وزن فاکتورها</th>
            <th>مانده</th>
            <th>عملیات</th>
        </tr>
        </thead>
        <tbody style="font-family:IRANSansBold !important;">
        @foreach (var item in Model) {
            <tr>
                <td>@item.Product</td>
                <td>@item.PfWeightCount</td>
                <td>@item.FWeightCount</td>
                <td>
                    <span style="color:@(item.RemainedFlag ? "green" : "crimson");">@item.Remained</span>
                </td>
                <td>
                    <button class="buttonGreen2" onclick="showModalDeliverItem('@item.PfId','@item.PfItemid')">جزئیات</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>



<script>

    $("#AllItemsFactorTable").DataTable({
        paging: false,
        scrollCollapse: true,
        //scrollY: "calc(100dvh - 400px)",
        responsive: true,
        ordering: false,
        searching: false,
        language: {
            emptyTable: "هیچ رکوردی موجود نمی باشد.",
            info: "نمایش _START_ تا _END_ از _TOTAL_ ردیف",
            infoEmpty: "نمایش 0 تا 0 از 0 ردیف",
            infoFiltered: "(فیلتر شده از _MAX_ ردیف)",
            lengthMenu: "نمایش _MENU_ ردیف",
            loadingRecords: "در حال بارگزاری...",
            search: "",
            zeroRecords: "رکوردی با این مشخصات پیدا نشد",
            aria: {
                sortAscending: ": فعال سازی نمایش به صورت صعودی",
                sortDescending: ": فعال سازی نمایش به صورت نزولی",
            },
        },
        layout: null,
    });


</script>