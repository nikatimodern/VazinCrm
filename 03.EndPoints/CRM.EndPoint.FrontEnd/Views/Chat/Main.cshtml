@{
    Layout = "_ChatLayout";
}


<div style="padding-bottom: 10px;height: 100%">
    <div class="email-container">
        <div id="chatList" class="email-list d-md-block" style="min-height: calc(100dvh - 90px);">
            <div class="p-2 ps-1 ps-xl-2 border-bottom d-flex align-items-center justify-content-center">

                <button class="buttonGreen1" onclick="showUsersModal()">پیام جدید</button>
            </div>
            <div id="chatListContainer" style="max-height: calc(100dvh - 160px);"></div>
        </div>

        <div id="chatContainer" class="d-none d-md-block email-content" style="height: calc(100dvh - 90px)"></div>
    </div>
</div>





@section Scripts {
    <script>
        var chatAttachment = [];
        let editingChatId;
        let currentMainChatId;
        const chatContainerElm = document.getElementById("chatContainer");
        const chatListElm = document.getElementById("chatList");
        const otherInputElm = document.getElementById("otherInput");
        const addChatModal = document.getElementById("addChatModal");

        document.addEventListener("UserLoginReady", () => {
            const isOthers = currentUser.rollNames.length === 0 || currentUser.rollNames.some(item => item.name === "Customer");
            const vazinLogoLink = document.querySelector("#customerLogo a");
            if (isOthers) {
                vazinLogoLink.href = "https://www.vazinplast.com/";
                vazinLogoLink.target = "_blank";

                addChatModal.querySelector("#addChatOthersWrapper")?.remove();
                addChatModal.querySelector("#othersContainer")?.remove();
            } else {
                vazinLogoLink.href = "/Dashboard/Index";
                vazinLogoLink.target = "_self";
            }
        });

        document.addEventListener("DOMContentLoaded", async () => {
            const { mci } = getUrlParams();
            const promises = [];
            if (mci) {
                promises.push(showChat(mci));
            }
            promises.push(getSalesExpertUsers(), showListChats());
            FLshowLoading();
            await Promise.all(promises);
            FLshowLoading(false);


            addChatModal.querySelectorAll("input[type='radio'][name='addChat']").forEach(elm => {
                elm.addEventListener("change", (e) => {
                    if (e.target.value === "1") {
                        document.getElementById("salesExpertsContainer").classList.remove("d-none");
                        document.getElementById("othersContainer").classList.add("d-none");
                    } else {
                        document.getElementById("salesExpertsContainer").classList.add("d-none");
                        document.getElementById("othersContainer").classList.remove("d-none");
                    }
                });
            });

            chatContainerElm.addEventListener("keydown", (e) => {
                if (!e.target.closest("textarea#chatInput")) return;
                if (e.key === "Enter" && !e.shiftKey) {
                    e.preventDefault();
                    sendChat();
                }
            });

            otherInputElm?.addEventListener("keydown", (e) => {
                if (e.key === "Enter") {
                    submitOtherInput();
                }
            });


        });

        function backChatList() {
            setUrlParams({ mci: null });
            chatListElm.classList.remove("d-none");
            chatContainerElm.classList.add("d-none");
        }

        function showUsersModal() {
            ModalToggle(addChatModal);
        }

        async function getSalesExpertUsers() {
            const res = await axios("/Chat/GetSalesExperts");
            const data = res.data;

            const salesExpertsList = addChatModal.querySelector("#salesExpertsContainer");
            salesExpertsList.innerHTML = "";
            const container = initDomUsers(data, 2);
            salesExpertsList.appendChild(container);
        }

        function initDomUsers(users, type) {
            const container = document.createElement("div");
            users.forEach((item) => {
                const wrapper = document.createElement("div");
                wrapper.className = "user__item";
                wrapper.innerHTML = `
                    <div class="d-flex align-items-center gap-2"">
                        <img class="profile-image" style="width:36px;outline-color: #ccc" src="${item.personImageUrl || "/Img/User.png"}" alt="">
                        <span style="font-size:13px">${item.fullName}</span>
                    </div>
                    ${type === 1 && item.countNotRead ? `<span class="badgeCircle text-white">${item.countNotRead ?? ""}</span>` : ""}
				`;

                if (type === 1 && item.mainChatId === currentMainChatId) {
                    chatListElm.querySelectorAll(".user__item").forEach(el => el.classList.remove("active"));
                    wrapper.classList.add("active");
                }

                wrapper.addEventListener("click", async () => {
                    if (type === 1) {
                        await showChat(item.mainChatId);
                        showListChats();
                    } else if (type === 2) {
                        createMainChat(item.id, item.fullName);
                        ModalToggle(addChatModal, "hide");
                    }

                    if (window.innerWidth < 768) {
                        chatListElm.classList.add("d-none");
                        chatContainerElm.classList.remove("d-none");
                    }
                });

                container.appendChild(wrapper);
            });

            return container;
        }


        async function showChat(mainChatId, showLoading = true) {
            currentMainChatId = mainChatId;
            setUrlParams({ mci: mainChatId });

            showLoading && FLshowLoading();
            const res = await axios(`/Chat/ShowChat?mainChatId=${mainChatId}`);
            if (res.status === 200) {
                chatContainerElm.innerHTML = res.data;
                if (window.innerWidth < 768) {
                    chatListElm.classList.add("d-none");
                    chatContainerElm.classList.remove("d-none");
                }
                initChatDateSticky();

                const unread = chatContainerElm.querySelector(".chat-unread-divider");
                if (unread) {
                    unread.scrollIntoView({ block: "center" });
                } else {
                    const chatWrapper = document.getElementById("chatWrapper");
                    if (chatWrapper) chatWrapper.scrollTop = chatWrapper.scrollHeight;
                }
            } else {
                toastifyError("خطای سرور!");
            }
            showLoading && FLshowLoading(false);
        }


        async function createMainChat(userId, userTxt = "") {
            FLshowLoading();
            const res = await axios(`/Chat/CreateMainChat?toUserId=${userId}&toUserTxt=${userTxt}`);
            if (res.status === 200) {
                await showChat(res.data);
                await showListChats();
            } else {
                toastifyError("خطای سرور!");
            }
            FLshowLoading(false);
        }


        async function sendChat() {
            const chatInput = chatContainerElm.querySelector("#chatInput");
            const chatSendBtn = chatContainerElm.querySelector("#chatSendBtn");
            if (!chatInput.value.trim() && !chatAttachment.length) return;
            toggleElementsDisabled(chatSendBtn);
            const model = {
                chat: {
                    id: editingChatId,
                    text: chatInput.value,
                },
                attachments: chatAttachment,
            };

            const res = await axios.post(`/Chat/SendChat`, model);
            if (res.status === 200) {
                chatInput.value = "";
                removeChatAttach();

                await showChat(currentMainChatId, false);
                showListChats();

                if (editingChatId) removeChatEdit();
                if (chatAttachment.length) removeChatAttach();
                chatContainerElm.querySelector("#chatInput").focus();
            } else {
                toastifyError("خطای سرور!");
            }
            toggleElementsDisabled(chatSendBtn, false);
        }

        async function submitOtherInput() {
            if (otherInputElm.value.length < 9) {
                toastifyError("شماره موبایل معتبر نیست!");
                return;
            }
            const mobileNumber = "09" + otherInputElm.value;
            await createMainChat(mobileNumber);
            cancelAddEmailModal();
        }

        function cancelAddEmailModal() {
            ModalToggle(addChatModal, "hide");
            otherInputElm.value = "";
        }


        async function showListChats() {
            const data = (await axios(`/Chat/ShowListChats`)).data;

            const chatListContainer = chatListElm.querySelector("#chatListContainer");
            const container = initDomUsers(data, 1);

            chatListContainer.innerHTML = "";
            chatListContainer.appendChild(container);
        }


        async function handleChatAttach(input) {
            const file = input.files[0];

            const preview = document.getElementById("chatAttachPreview");
            preview.innerHTML = "";

            if (!file) {
                preview.style.display = "none";
                return;
            }

            await addToList(input.files, "chatAttachment");
            preview.style.display = "block";

            const size = (file.size / 1024).toFixed(1) + " KB";

            let thumbHtml;
            if (file.type.startsWith("image/")) {
                const url = URL.createObjectURL(file);
                thumbHtml = `<img src="${url}" class="chat-attach-thumb" alt="">`;
            } else {
                thumbHtml = `
                    <div class="chat-attach-file-icon">
                        <i class="fa fa-file"></i>
                    </div>
                `;
            }

            preview.innerHTML = `
                <div class="chat-attach-preview-item">
                    ${thumbHtml}

                    <div class="chat-attach-info">
                        <div class="chat-attach-name">
                            ${file.name}
                        </div>

                        <div class="chat-attach-size">
                            ${size}
                        </div>
                    </div>

                    <button class="chat-remove-attach" onclick="removeChatAttach()">
                        <svg style="width: 16px" viewBox="0 0 16 16" fill="currentColor"><path d="M5.28 4.22a.75.75 0 0 0-1.06 1.06L6.94 8l-2.72 2.72a.75.75 0 1 0 1.06 1.06L8 9.06l2.72 2.72a.75.75 0 1 0 1.06-1.06L9.06 8l2.72-2.72a.75.75 0 0 0-1.06-1.06L8 6.94 5.28 4.22Z" /></svg>
                    </button>

                </div>
            `;

            const chatWrapper = document.getElementById("chatWrapper");
            if (chatWrapper) chatWrapper.scrollTop = chatWrapper.scrollHeight;
        }

        function removeChatAttach() {
            document.getElementById("chatAttachInput").value = "";

            const preview = document.getElementById("chatAttachPreview");

            preview.innerHTML = "";
            preview.style.display = "none";
            chatAttachment = [];
        }


        const chatDropdown = Dropdown.setupDelegate({
            container: document,
            toggleSelector: ".task-dropdown__toggle",
            options: {
                transitionDuration: 200,
                originalDisplay: "flex",
                effect: "zoom",
                placement: "right",
            },
        });

        function deleteChat(id) {
            chatDropdown.close();
            Swal.fire({
                //title: "حذف!",
                text: "آیا از حذف این پیام اطمینان دارید؟",
                icon: "warning",
                showCancelButton: true,
                cancelButtonColor: "#adadad",
                confirmButtonColor: "#e64942",
                cancelButtonText: "انصراف",
                confirmButtonText: "بله، حذف شود",
            }).then(async (willDelete) => {
                if (willDelete.isConfirmed) {
                    FLshowLoading();
                    const res = await axios(`/Chat/DeleteChat/${id}`);
                    if (res.status === 200) {
                        toastifySuccess("با موفقیت حذف شد");
                        await showChat(currentMainChatId);
                    }
                    FLshowLoading(false);
                }
            });
        }


        function editChat(id) {
            chatDropdown.close();
            const box = chatContainerElm.querySelector(`.report-box[data-chat-id="${id}"]`);
            if (!box) return;

            editingChatId = id;
            const text = box.querySelector(".report-text")?.innerText?.trim() || "";

            const chatInput = chatContainerElm.querySelector("#chatInput");
            const preview = chatContainerElm.querySelector("#chatEditPreview");
            const chatAttachBtn = chatContainerElm.querySelector(".chat-attach-btn");

            chatAttachBtn.classList.add("d-none");
            preview.style.display = "block";

            preview.innerHTML = `
            <div class="chat-edit-preview-item">
                <div class="chat-edit-icon">
                    <svg style="width:18px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897z"/></svg>
                </div>

                <div class="chat-edit-info">
                    <div class="chat-edit-title">
                        ویرایش پیام
                    </div>

                    <div class="chat-edit-text">${text}</div>
                </div>

                <button class="chat-remove-edit" onclick="removeChatEdit()">
                    <svg style="width:16px" viewBox="0 0 16 16" fill="currentColor"><path d="M5.28 4.22a.75.75 0 0 0-1.06 1.06L6.94 8l-2.72 2.72a.75.75 0 1 0 1.06 1.06L8 9.06l2.72 2.72a.75.75 0 1 0 1.06-1.06L9.06 8l2.72-2.72a.75.75 0 0 0-1.06-1.06L8 6.94 5.28 4.22Z"/></svg>
                </button>
            </div>
        `;

            chatInput.value = text;
            chatInput.focus();
        }

        function removeChatEdit() {
            editingChatId = undefined;

            const preview = document.getElementById("chatEditPreview");
            const chatInput = chatContainerElm.querySelector("#chatInput");
            preview.innerHTML = "";
            preview.style.display = "none";

            chatInput.value = "";
            chatContainerElm.querySelector(".chat-attach-btn").classList.remove("d-none");
        }


        function initChatDateSticky() {
            const wrapper = chatContainerElm.querySelector("#chatWrapper");
            const floating = chatContainerElm.querySelector("#chatDateFloating");

            if (!wrapper || !floating) return;

            const groups = [...wrapper.querySelectorAll(".chat-date-group")];

            let timer;
            function updateDate() {
                let current = groups[0];

                groups.forEach(x => {
                    const top = x.offsetTop - wrapper.scrollTop;

                    if (top <= 70)
                        current = x;
                });

                if (!current) return;

                floating.textContent = current.dataset.chatDate;

                floating.style.opacity = 1;

                clearTimeout(timer);

                timer = setTimeout(() => {
                    floating.style.opacity = 0;
                }, 1200);
            }

            wrapper.removeEventListener("scroll", wrapper._dateHandler);

            wrapper._dateHandler = updateDate;

            wrapper.addEventListener("scroll", updateDate);
        }

    </script>
}