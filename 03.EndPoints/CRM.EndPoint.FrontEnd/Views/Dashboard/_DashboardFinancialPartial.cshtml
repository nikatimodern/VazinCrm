<div id="financialReportContainer" class="w-100 h-100">
    <div class="d-flex flex-column h-100 w-100 p-3">
        <div class="d-flex align-items-center justify-content-between w-100 mb-2">
            <div class="fbold d-flex align-items-center gap-2" style="font-size:clamp(15px,1.5vw,18px);color: #1f8557;">
                <div class="d-flex align-items-center justify-content-center">
                    <svg width="24px" height="24px" stroke-width="1.5" viewBox="0 0 24 24" fill="none" color="currentColor"><path d="M3 9.5L12 4L21 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M5 20H19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M10 9L14 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M6 17L6 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M10 17L10 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M14 17L14 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M18 17L18 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                </div>
                <span>گزارش مالی</span>
            </div>
        </div>
        <div class="flex-grow-1 mt-1" style="overflow:auto">
            <div class="financialSummary">
                <div class="financialItem">
                    <div class="financialHead">
                        <span class="financialTitle">موجودی بانک</span>
                    </div>

                    <div class="financialValueWrap">
                        <span class="dashboard-value financialValue direction-ltr" id="bankBalanceId"></span>
                        <span class="financialCurrency">ريال</span>
                    </div>
                </div>

                <div class="financialItem financialDemandItem position-relative">
                    <div class="financialHead">
                        <a class="financialTitle stretched-link text-decoration-none" asp-controller="Supply" asp-action="Demand">مطالبات</a>
                        <span id="demandInfo" data-bs-title="جزئیات" data-bs-toggle="popover" data-bs-html="true" data-bs-placement="top">
                            <svg class="financialInfoIcon" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M15 8A7 7 0 1 1 1 8a7 7 0 0 1 14 0ZM9 5a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM6.75 8a.75.75 0 0 0 0 1.5h.75v1.75a.75.75 0 0 0 1.5 0v-2.5A.75.75 0 0 0 8.25 8h-1.5Z" /></svg>
                        </span>
                    </div>

                    <div class="financialValueWrap">
                        <span class="dashboard-value financialValue direction-ltr" id="totalDemandId"></span>
                        <span class="financialCurrency">ريال</span>
                    </div>
                </div>

                <div class="financialItem">
                    <div class="financialHead">
                        <span class="financialTitle">بدهی</span>
                        <span id="debitInfo" data-bs-title="جزئیات" data-bs-toggle="popover" data-bs-html="true" data-bs-placement="bottom">
                            <svg class="financialInfoIcon" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M15 8A7 7 0 1 1 1 8a7 7 0 0 1 14 0ZM9 5a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM6.75 8a.75.75 0 0 0 0 1.5h.75v1.75a.75.75 0 0 0 1.5 0v-2.5A.75.75 0 0 0 8.25 8h-1.5Z" /></svg>
                        </span>
                    </div>
                    <div class="financialValueWrap">
                        <span class="dashboard-value financialValue direction-ltr" id="totalDebitId"></span>
                        <span class="financialCurrency">ريال</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
