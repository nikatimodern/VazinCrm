<!-- Modal requestAmount -->
<div class="modal fade" id="requestAmountModal" tabindex="-1" role="dialog" data-bs-focus="false">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content col-12 p-2">
            <div class="text-center text-white rounded py-1 fbold" style="background-color: #6c757d">درخواست وجه</div>
            <div class="modal-body pb-2">
                <form id="requestAmountForm" class="d-flex flex-column gap-2">
                    <div>
                        <label for="reqAmountAmount">مبلغ:</label>
                        <input id="reqAmountAmount" inputmode="numeric" class="form-control currencyNumber inpAmount" name="amount" required>
                    </div>

                    <div>
                        <label for="reqAmountDocType">نوع پرداخت:</label>
                        <select id="reqAmountDocType" class="form-select form-select-sm valueNumber" name="docType" required>
                            <option value="">انتخاب</option>
                            <option value="1">نقدی</option>
                            <option value="2">چکی</option>
                        </select>
                    </div>

                    <div>
                        <label for="reqAmountSupplyFactor">فاکتور تامین:</label>
                        <div class="input-group mb-3">
                            <input id="reqAmountSupplyFactor" type="text" class="form-control" placeholder="فاکتور تامین.." disabled required>
                            <button class="btn btn-sm btn-secondary" type="button" onclick="showAddSupplyFactorModal()">انتخاب</button>
                        </div>
                    </div>


                    <div class="d-flex justify-content-center gap-1 mt-2">
                        <button type="button" class="buttonCancel2" style="padding-block: 4px" onclick="toggleSupplyFactorModal()">انصراف</button>
                        <button type="button" class="buttonGreen3" style="padding-block: 4px" onclick="submitRequestAmountModal()">ثبت</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- addSupplyFactor Modal -->
<div class="modal fade" id="addSupplyFactorModal" tabindex="-1" data-bs-focus="false">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" style="border-radius: 12px;overflow: hidden;box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25)">
            <div class="modal-header">
                <div class="d-flex align-items-center justify-content-between w-100">
                    <span class="fbold">انتخاب حواله تولید</span>
                    <div>
                        <input id="addSupplyFactorSearch" type="text" class="form-control" placeholder="جستجو..">
                    </div>
                </div>
            </div>

            <div class="modal-body p-0">
                <div id="addSupplyFactorContainer"></div>
            </div>

            <div class="modal-footer justify-content-center p-2">
                <button style="padding-block:4px" type="button" class="buttonCancel2" onclick="toggleAddSupplyFactorModal()">انصراف</button>
                <button id="submitSelectedSupplyFactor" style="padding-block:4px" type="button" class="buttonGreen3 d-none" onclick="submitSelectedSupplyFactor()">ثبت</button>
            </div>

        </div>
    </div>
</div>


@section Scripts {
    <script>
        const addSupplyFactorModal = document.getElementById("addSupplyFactorModal");
        let supplyFactorsSelectedIds = [];

        document.addEventListener("DOMContentLoaded", async () => {
            //getAllRequestAmountDt();
            await getAllRequestAmount();
        })

        async function showAddSupplyFactorModal() {
            await getAllSupplyFactorsTable();
            addSupplyFactorModal.querySelectorAll("input[type='checkbox']").forEach((checkbox) => {
                if (supplyFactorsSelectedIds.includes(checkbox.value)) {
                    checkbox.checked = true;
                }
            });
            toggleAddSupplyFactorModal();
            addSupplyFactorModal.querySelector("#submitSelectedSupplyFactor").classList.toggle("d-none", !supplyFactorsSelectedIds.length);
        }

        function toggleAddSupplyFactorModal() {
            addSupplyFactorModal.querySelector("#addSupplyFactorSearch").value = "";
            ModalToggle(addSupplyFactorModal);
        }

        const getAllSupplyFactorsTable = async (search = "") => {
            const res = await axios(`/Supply/GetAllSupplyFactorsTablePartial?search=${search}`);

            addSupplyFactorModal.querySelector("#addSupplyFactorContainer").innerHTML = res.data;
        };

        addSupplyFactorModal.querySelector("#addSupplyFactorContainer").addEventListener("change", (e) => {
            const checkbox = e.target.closest("input[type='checkbox']");
            if (!checkbox) return;

            const anyChecked = addSupplyFactorModal.querySelector("#addSupplyFactorContainer input[type='checkbox']:checked");

            addSupplyFactorModal.querySelector("#submitSelectedSupplyFactor").classList.toggle("d-none", !anyChecked);
        });

        const submitSelectedSupplyFactor = () => {
            const checkedBoxes = [...addSupplyFactorModal.querySelectorAll("#addSupplyFactorContainer input[type='checkbox']:checked")];

            supplyFactorsSelectedIds.length = 0;
            supplyFactorsSelectedIds.push(...checkedBoxes.map(cb => cb.value));

            setSupplyFactorsNumber();

            ModalToggle(addSupplyFactorModal);
        };

        const setSupplyFactorsNumber = () => {
            const inpElm = document.getElementById("reqAmountSupplyFactor");
            const checkedBoxes = [...addSupplyFactorModal.querySelectorAll("#addSupplyFactorContainer input[type='checkbox']:checked")];

            inpElm.value = checkedBoxes.map(cb => cb.dataset.number);
        };


        addSupplyFactorModal.querySelector("#addSupplyFactorSearch").addEventListener("keyup", async (e) => {
            if (e.key === "Enter") {
                toggleElementsDisabled(e.target);
                await getAllSupplyFactorsTable(e.target.value.trim());
                toggleElementsDisabled(e.target, false);
                e.target.focus();
            }
        });


        function toggleSupplyFactorModal() {
            ModalToggle("#requestAmountModal");
        }

        async function submitRequestAmountModal() {
            if (!await mySer.CheckValidForm("requestAmountForm")) return;
            const model = {
                ...mySer.convertFormToJSON("requestAmountForm"),
                requestAmountSupplyFactor: supplyFactorsSelectedIds.map(id => ({ supplyFactorId: id })),
            };

            try {
                const res = await axios.post(`/Amount/AddRequestAmount`, model);
                if (res.status === 200) {
                    toastifySuccess("با موفقیت ثبت شد");
                    mySer.emptyForm("requestAmountForm");
                    supplyFactorsSelectedIds = [];
                    ModalToggle("requestAmountModal", "hide");
                }
            } catch (err) {
                console.log(err);
            }

        }


        const getAllRequestAmount = async () => {
            FLshowLoading();
            const res = await axios(`/Amount/GetAllRequestAmountsPartial`);
            document.getElementById("requestAmountContainer").innerHTML = res.data;
            FLshowLoading(false);
        }


        @*let requestAmountTbl;
        let modelRequestAmount = {};
        const getAllRequestAmountDt = () => {
            requestAmountTbl = $("#requestAmountTable").DataTable({
                pageLength: 10,
                lengthMenu: [2, 10, 20, 50, 100, { label: "همه", value: -1 }],
                processing: true,
                serverSide: true,
                searching: true,
                search: {
                    return: true,
                },
                ordering: true,
                order: [[4, "desc"]],
                scrollCollapse: true,
                scrollY: "70dvh",
                responsive: true,
                ajax: {
                    url: `/Amount/GetAllRequestAmountsDt`,
                    type: "POST",
                    data: (d) => {
                        d.model = JSON.stringify(modelRequestAmount);
                    },
                },
                language: {
                    emptyTable: "هیچ رکوردی موجود نمی باشد.",
                    info: "نمایش _START_ تا _END_ از _TOTAL_ ردیف",
                    infoEmpty: "نمایش 0 تا 0 از 0 ردیف",
                    infoFiltered: "(فیلتر شده از _MAX_ ردیف)",
                    lengthMenu: "نمایش _MENU_ ردیف",
                    loadingRecords: "در حال بارگزاری...",
                    search: "",
                    zeroRecords: "رکوردی با این مشخصات پیدا نشد",
                    aria: {
                        sortAscending: ": فعال سازی نمایش به صورت صعودی",
                        sortDescending: ": فعال سازی نمایش به صورت نزولی",
                    },
                },
                columnDefs: [
                    {
                        targets: [0, 1, 2, 3],
                        orderable: false,
                    },
                    {
                        targets: [2, 3],
                        render: data => `<span dir="ltr" class="fbold">${data ? data.toLocaleString() : "-"}</span>`,
                    },
                ],
                columns: [
                    { data: null, render: (data, type, row, meta) => meta.row + 1 },
                    { data: "docTypeTxt", name: "DocTypeTxt", defaultContent: "-" },
                    { data: "amount", name: "Amount", defaultContent: "-" },
                    { data: "acceptedAmount", name: "AcceptedAmount", defaultContent: "-" },
                    { data: "requestStatusTxt", name: "RequestStatusTxt", defaultContent: "-" },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return `
                                <div class="d-inline-flex align-items-center justify-content-center gap-1">
                                    <button type="button" style="padding: 6px 6px;box-shadow: none;font-size: 12px" class="buttonGreen3 flex-center" onclick=''><i class="fa fa-pencil"></i></button>
                                    <button type="button" style="padding: 6px 7px;box-shadow: none;font-size: 12px" class="buttonCancel2 flex-center" onclick='DelBankAccountItem("${row.id}")'><i class="fa fa-trash"></i></button>
                                </div>
                            `;
                        },
                    },
                ],
                layout: {
                    bottomEnd: "info",
                    bottomStart: {
                        paging: {
                            type: "simple_numbers",
                        },
                    },
                    topEnd: {
                        pageLength: true,
                    },
                    topStart: {
                        search: {
                            placeholder: "جستجو",
                        },
                    },
                },
            });
        };*@

    </script>
}