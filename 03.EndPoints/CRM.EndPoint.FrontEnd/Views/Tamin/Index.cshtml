@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div>
    <div style="border-radius:10px;width:99%;">
        <table style=" width:100%" class="table table-striped table-hover nowrap" id="taminTable">
            <thead>
            <tr>
                <th>نام تامین کننده</th>
                <th>محصول</th>
                <th>مقدار</th>
                <th>بهای واحد تامین <span style="font-size: 11px">(ريال) </span></th>
                <th>بهای کل تامین <span style="font-size: 11px"> (ريال)</span></th>
            </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>





@section scripts {
    <script>
        let TaminTBL;
        let modelTamin = { serVal: null, filt: null };
        document.addEventListener("DOMContentLoaded", async () => {
            //getAllTamin();
            //await getAllTaminJson();
        });

        const getAllTaminJson = async () => {
            const res = await axios(`/Tamin/GetOpenOrder`);

        };
        const getAllTamin = () => {
            TaminTBL = $("#taminTable").DataTable({
                pageLength: 10,
                lengthMenu: [5, 10, 20, 50, 100, { label: "همه", value: -1 }],
                processing: true,
                serverSide: true,
                searching: true,
                search: {
                    return: true,
                },
                ordering: false,
                //order: [[1, "desc"]],

                scrollCollapse: true,
                scrollY: "70dvh",
                responsive: true,
                ajax: {
                    url: `/Tamin/GetOpenOrderDt`,
                    type: "POST",
                },
                language: languageDatatable,
                columnDefs: [
                    /*{
                        targets: 0,
                        visible: false,
                        searchable: false,
                    },*/
                    {
                        targets: [2],
                        render: (data, type, row) => {
                            const weight = row.weight != null ? (isNaN(Number(row.weight)) ? row.weight : Number(row.weight).toLocaleString()) : "-";
                            const unit = row.unitTxt ?? "";
                            return `${weight} ${unit}`;
                        },
                    },
                    {
                        targets: [3, 4],
                        render: (data) => {
                            return data != null ? data.toLocaleString() : data;
                        },
                    },

                ],
                columns: [
                    /*{ data: "id",  autoWidth: true },*/
                    { data: "name", defaultContent: "-" },
                    { data: "product", defaultContent: "-" },
                    { data: "weight", defaultContent: "-" },
                    { data: "taminUnitAmount", defaultContent: "-" },
                    { data: "taminTotalAmount", defaultContent: "-" },
                    /*{
                        data: null,
                        render: function (data, type, row) {
                            return `
                                <div class="d-inline-flex align-items-center justify-content-center gap-1">
                                    <button type="button" data-title-right="ویرایش" style="padding: 6px;box-shadow: none;font-size: 12px" class="buttonGreen3 d-flex justify-content-center align-items-center" onclick='ShowUpdateOrder("${row.id}", this)'><i class="fa fa-pencil"></i></button>
                                    <button type="button" data-title-right="حذف" style="padding: 6px 7px;box-shadow: none;font-size: 12px" class="Admin buttonCancel2 d-flex justify-content-center align-items-center" onclick='DelOrderItem("${row.id}", this)'><i class="fa fa-trash"></i></button>
                                </div>
                            `;
                        },
                    },*/
                ],

                layout: {
                    bottomEnd: "info",
                    bottomStart: {
                        paging: {
                            type: "simple_numbers",
                        },
                    },
                    topEnd: {
                        pageLength: true,
                    },
                    topStart: {
                        search: {
                            placeholder: "جستجو",
                        },
                    },
                },
            });
            function initFilterTaminTable() {
                const searchInput = $(".dt-search input");
                const dtLength = $(".dt-length label");
                if (searchInput.length) {
                    const filterButton = $(
                        `<div class="btnFilter" data-filterVarConfig="taminConfigFilter" data-filterCallBack="callBackTaminFilter" data-filterContentId="contentTaminFilterId" data-filterInpSearchId="dt-search-0" data-filterVarSearch="searchVarTamin" onclick="ShowFilterPopup(this)" style="padding:0 5px;margin-right: 8px">
                            <svg style="width:24px;height:24px;color:#333" viewBox="0 0 24 24" fill="currentColor" ><path fill-rule="evenodd" d="M3.792 2.938A49.069 49.069 0 0 1 12 2.25c2.797 0 5.54.236 8.209.688a1.857 1.857 0 0 1 1.541 1.836v1.044a3 3 0 0 1-.879 2.121l-6.182 6.182a1.5 1.5 0 0 0-.439 1.061v2.927a3 3 0 0 1-1.658 2.684l-1.757.878A.75.75 0 0 1 9.75 21v-5.818a1.5 1.5 0 0 0-.44-1.06L3.13 7.938a3 3 0 0 1-.879-2.121V4.774c0-.897.64-1.683 1.542-1.836Z" clip-rule="evenodd" /></svg>
                        </div>`);

                    searchInput.after(filterButton);
                    const contentFilter = `<div id="contentTaminFilterId" class="ContentFilter"></div>`;
                    $(".dt-search").after(contentFilter);
                }
            }
            TaminTBL.on("search.dt", function () {
                modelTamin.serVal = TaminTBL.search();
            });

        };


    </script>
}