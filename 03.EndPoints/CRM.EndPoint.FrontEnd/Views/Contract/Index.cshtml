@inject CRM.EndPoint.FrontEnd.Security.DocumentAccessPolicy Access
@{
    var canCreate = await Access.HasAsync("Contract", "Create", Context.RequestAborted);
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>

</style>


<div class=" " style="display:flex;justify-content:center; align-items:center; flex-direction:column ">
    <div style="width:50% ;margin-bottom:10px;">
        @if (canCreate) {
            <button class="buttonGreen " data-document-permission="Contract.Create" onclick="showModalAdd()">قرارداد جدید</button>
        }

    </div>

    <div style=" width:50% ;height:200px;">
