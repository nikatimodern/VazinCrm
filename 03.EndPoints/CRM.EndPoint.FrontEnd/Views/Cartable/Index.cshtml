                        <div style=" max-height:70dvh;overflow:auto; width:100%; display:flex;  justify-content:center" id="PfAcceptedList"></div>

                    </div>
                </div>


                @*فاکتور*@
                <div class="tab-pane fade border-0" id="allFactorTab-pane" role="tabpanel" aria-labelledby="allFactorTab" tabindex="0" style="flex-direction:column;width:100%">
                    <div class="px-2" style="justify-content:space-between; display:flex; font-size:20px; font-family:'IranSansBold'">
                        <label class="mp d-none d-xxl-block">فاکتورها</label>
                        <div class="justify-content-center justify-content-xxl-end col-12 col-xxl-3 me-xxl-3" style="display:flex;align-items:center;">
                            <p class="mp d-none d-xxl-flex align-items-center gap-2" style="font-family:'IRANSansBold'; font-size:large;color:rgb(84 57 213)">تعداد:
                                <span id="fCountId"></span></p>
                        </div>
                        @*<span class="mp parentPlusAdd" onclick="NewFactor()"><svg class="svg-inline--fa fa-plus fa-w-14 plusAdd mp" aria-hidden="true" focusable="false" data-prefix="fa" data-icon="plus" role="img"  viewBox="0 0 448 512" data-fa-i2svg=""><path fill="currentColor" d="M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z"></path></svg><!-- <i class="plusAdd mp fa fa-plus"></i> Font Awesome fontawesome.com --> </span>*@
                    </div>
