@{
    Layout = "_Layout";
}

<div class="w-100p pb-3">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="d-flex align-content-center gap-2 col-lg-3">
            <button class="buttonGray2 d-flex align-items-center gap-1" style="padding: 4px 8px" onclick="showAddRequestAmountModal()">
                <span style="line-height: 1">ثبت درخواست جدید</span>
                <svg style="width: 20px" viewBox="0 0 20 20" fill="currentColor"><path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" /></svg>
            </button>

        </div>
        <div class="d-flex align-items-center gap-2 col-12 col-lg-5">
            @*<div id="ContentRequestAmountFilterId" class="ContentFilter"></div>
            <div class="btnFilter" data-filtervarconfig="filterRequestAmountConfig" data-filtercallback="callbackFilterRequestAmount" data-filtercontentid="ContentRequestAmountFilterId" data-filterinpsearchid="requestAmountSearchId" data-filtervarsearch="requestAmountSearchVal" onclick="ShowFilterPopup(this)">
                <svg style="width:24px;color:#333" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M3.792 2.938A49.069 49.069 0 0 1 12 2.25c2.797 0 5.54.236 8.209.688a1.857 1.857 0 0 1 1.541 1.836v1.044a3 3 0 0 1-.879 2.121l-6.182 6.182a1.5 1.5 0 0 0-.439 1.061v2.927a3 3 0 0 1-1.658 2.684l-1.757.878A.75.75 0 0 1 9.75 21v-5.818a1.5 1.5 0 0 0-.44-1.06L3.13 7.938a3 3 0 0 1-.879-2.121V4.774c0-.897.64-1.683 1.542-1.836Z" clip-rule="evenodd"></path></svg>
            </div>*@
            <div class="search-group flex-grow-1">
                <input class="form-control" type="text" id="requestAmountSearchId" placeholder="جستجو..." />
                <div class="search-icon">
                    <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z" clip-rule="evenodd" /></svg>
                </div>
            </div>
        </div>
        <div class="d-flex align-items-center justify-content-start justify-content-lg-end gap-2 col-lg">
            <ul class="filter-switch">
                <li class="filter-switch-item">
                    <input type="radio" name="requestAmountFilter" id="requestAmountFilterAll" value="-1" checked />
                    <label for="requestAmountFilterAll">همه</label>
                </li>
                <li class="filter-switch-item">
                    <input type="radio" name="requestAmountFilter" id="requestAmountFilter1" value="1" />
                    <label for="requestAmountFilter1">
                        در انتظار تایید
                        <span class="badgeCircle filter-count-badge"></span>
                    </label>
                </li>
                <li class="filter-switch-item">
                    <input type="radio" name="requestAmountFilter" id="requestAmountFilter2" value="2" />
                    <label for="requestAmountFilter2">
                        در انتظار پرداخت
                        <span class="badgeCircle filter-count-badge"></span>
                    </label>
                </li>
                <li class="filter-switch-item">
                    <input type="radio" name="requestAmountFilter" id="requestAmountFilter3" value="3" />
                    <label for="requestAmountFilter3">
                        پرداخت شده
                        <span class="badgeCircle filter-count-badge"></span>
                    </label>
                </li>
            </ul>
        </div>
    </div>

    <div class="FinancialExpert" style="display: none">
        <button class="selection-toggle-btn buttonGreen2 d-flex align-items-center gap-2 mt-3" style="padding: 4px 8px !important">
            <svg style="width: 18px" viewBox="0 0 20 20" fill="currentColor"><path d="M10 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM6 8a2 2 0 1 1-4 0 2 2 0 0 1 4 0ZM1.49 15.326a.78.78 0 0 1-.358-.442 3 3 0 0 1 4.308-3.516 6.484 6.484 0 0 0-1.905 3.959c-.023.222-.014.442.025.654a4.97 4.97 0 0 1-2.07-.655ZM16.44 15.98a4.97 4.97 0 0 0 2.07-.654.78.78 0 0 0 .357-.442 3 3 0 0 0-4.308-3.517 6.484 6.484 0 0 1 1.907 3.96 2.32 2.32 0 0 1-.026.654ZM18 8a2 2 0 1 1-4 0 2 2 0 0 1 4 0ZM5.304 16.19a.844.844 0 0 1-.277-.71 5 5 0 0 1 9.947 0 .843.843 0 0 1-.277.71A6.975 6.975 0 0 1 10 18a6.974 6.974 0 0 1-4.696-1.81Z" /></svg>
            <span style="line-height: 1">پرداخت گروهی</span>
        </button>
    </div>
    <div class="selection-bar d-none mt-2">
        <div class="d-none d-lg-flex align-items-center gap-3">
            <label class="d-flex align-items-center gap-3">
                <input type="checkbox" class="select-all" />
                <span>انتخاب همه</span>
            </label>
        </div>

        <div class="col-12 col-lg-auto flex-center flex-wrap gap-3" style="color: #444;">
            <span class="selected-count fbold" style="color: var(--color8);">0</span>
            <span>مورد انتخاب شده</span>

            <button class="clear-selection link-green" style="font-size: 13px">
                حذف انتخاب
            </button>
        </div>

        <div class="col-12 col-lg-auto d-flex align-items-center justify-content-between justify-content-lg-end gap-3">
            <button class="cancel-selection buttonCancel-white">
                <svg style="width: 16px" viewBox="0 0 20 20" fill="currentColor"><path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" /></svg>
                انصراف
            </button>

            <button class="selection-action-btn buttonGreen0" disabled>
                پرداخت همه (<span class="selected-count">0</span>)
            </button>
        </div>
    </div>

    <div id="requestAmountContainer" class="mt-3">
    </div>
</div>



@section Scripts {
    <script>
        let modelRequestAmount = { filt: null, serVal: null };
        var filterRequestAmountConfig = {};
        var requestAmountSearchVal = null;


        const requestContainer = document.getElementById("requestAmountContainer");

        document.addEventListener("DOMContentLoaded", async () => {
            await getAllRequestAmount();

            const searchReqAmountElm = document.getElementById("requestAmountSearchId");
            searchReqAmountElm.addEventListener("keyup", async (e) => {
                if (e.key === "Enter") {
                    await getAllRequestAmount();
                }
            });

            searchReqAmountElm.nextElementSibling.addEventListener("click", async () => await getAllRequestAmount());

            const requestAmountRadios = document.querySelectorAll("input[type='radio'][name='requestAmountFilter']");
            requestAmountRadios.forEach(elm => elm.addEventListener("change", async () => await getAllRequestAmount()));
        });


        async function callbackFilterRequestAmount() {
            modelRequestAmount.filt = filterRequestAmountConfig.filterVar;
            modelRequestAmount.serVal = filterRequestAmountConfig.varSearch;

            await getAllRequestAmount();
        }


        const getAllRequestAmount = async () => {
            const val = document.getElementById("requestAmountSearchId")?.value.trim() ?? "";
            const type = document.querySelector("input[type='radio'][name='requestAmountFilter']:checked")?.value;
            if (type === undefined) return;
            FLshowLoading();
            const res = await axios(`/RequestAmount/GetAllRequestAmountsPartial?search=${val}&type=${type}&passType=1`);
            requestContainer.innerHTML = res.data.html;
            updateFilterSwitchState({
                wrapperSelector: ".filter-switch",
                filterData: res.data.filterCounts,
                currentFilterValue: type,
                searchValue: val,
                onChange: async () => {
                    await getAllRequestAmount();
                },
            });
            requestSelection.restoreSelection();
            FLshowLoading(false);
        };


        const requestSelection = new SelectionManager({
            container: "#requestAmountContainer",
            itemSelector: ".layered-card",
            checkboxSelector: ".card-checkbox",
            onAction: async (selectedIds) => {
                if (selectedIds.length === 0) {
                    toastifyError("لطفاً ابتدا درخواست‌های مورد نظر را انتخاب کنید.");
                    return;
                }
                await showSetAmountPaymentItemModal(selectedIds);
            },
        });
    </script>

    <script src="~/js/requestAmount.js" asp-append-version="true"></script>
}