@model IList<CRM.EndPoint.FrontEnd.Models.Warehouse.WarehousVModel>
@{
    Layout = "_Layout";
    var hasWarehouseId = Context.Request.Query.ContainsKey("warehouse");
}

<div>
    <div id="warehouses-section" class="@(hasWarehouseId ? "d-none" : "")">
        <div class="d-flex align-items-center gap-2 mb-3">
            <span class="section-title-dot"></span>
            <h5 class="fbold text-dark m-0">انبار ها</h5>
        </div>

        <div id="warehousesContainer">
            <partial name="GetAllWarehousesPartial" model="Model" />
        </div>
    </div>

    <div id="warehouseProducts-section" class="@(hasWarehouseId ? "" : "d-none")">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="d-flex align-items-center gap-2">
                <span class="section-title-dot"></span>
                <h5 id="selected-checkbook-title" class="fbold text-dark m-0">لیست محصولات</h5>
            </div>

            <div class="d-flex gap-2">
                <button class="buttonGreen0" onclick="ModalToggle('warehouseProductModal')">
                    افزودن محصول جدید
                    <svg style="width: 18px" viewBox="0 0 20 20" fill="currentColor"><path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" /></svg>
                </button>
                <button class="buttonCancel-white" onclick="backToWarehouses()">
                    بازگشت
                    <svg style="width: 16px;transform: scaleX(-1)" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M12.5 9.75A2.75 2.75 0 0 0 9.75 7H4.56l2.22 2.22a.75.75 0 1 1-1.06 1.06l-3.5-3.5a.75.75 0 0 1 0-1.06l3.5-3.5a.75.75 0 0 1 1.06 1.06L4.56 5.5h5.19a4.25 4.25 0 0 1 0 8.5h-1a.75.75 0 0 1 0-1.5h1a2.75 2.75 0 0 0 2.75-2.75Z" clip-rule="evenodd" /></svg>
                </button>
            </div>
        </div>

        <div>
            <table id="warehouseProductsTable" class="table-hover table table-bordered nowrap table-striped">
                <thead>
                <tr>
                    <th>شرح محصول</th>
                    <th>مقدار</th>
                    <th>واحد</th>
                    <th>عملیات</th>
                </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>



<partial name="Modals/_WarehouseModal" />
<partial name="Modals/_WarehouseProductModal" />

@section Scripts {
    <script src="~/js/warehouse.js" asp-append-version="true"></script>
}
