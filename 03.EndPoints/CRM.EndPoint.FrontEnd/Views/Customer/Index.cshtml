@model AppUser

@section Styles {
    <link rel="stylesheet" href="~/css/customerIndex.css?release=7.5.6" asp-append-version="true" />
}

<div class="customer-directory">
    <div class="w-100">
        <header class="customer-directory__header">
            <div class="customer-directory__title">
                <span class="customer-directory__title-icon"><i class="fa fa-users" aria-hidden="true"></i></span>
                <div><h1>اشخاص</h1><p>مشتریان و تأمین‌کنندگان</p></div>
            </div>
            @if (Model.NormalizedUserName is "R.SALAMI" or "ADMIN") {
                <div id="AddCustBtnID">
                    <button type="button" class="customer-directory__new" onclick="showFormCustomer()" id="btnNew">
                        <i class="fa fa-plus" aria-hidden="true"></i>
                        ثبت جدید
                    </button>
                    <button type="button" class="customer-directory__cancel" onclick="hideFormCustomer()" id="btnCancel" style="display:none">انصراف</button>
                </div>
            }
        </header>
        <div id="customerToolbar" class="customer-directory__toolbar">
            <div id="searchCustomerWrapper" class="customer-directory__search" role="search">
                <div class="search-group customer-search">
                    <input class="form-control" id="SearchInp" type="text" placeholder="جستجو بر اساس نام یا کد مشتری" aria-label="جستجو بر اساس نام یا کد مشتری" />
                    <button type="button" class="search-icon" aria-label="جستجو">
                        <svg style="width: 22px" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z" clip-rule="evenodd" /></svg>
                    </button>
                </div>
            </div>
            <div id="roleTypeRadios" class="customer-directory__filters">
                @if (User.IsAdmin() || User.IsSalesAdmin() || User.IsTamin() || User.IsFinancial()) {
                    <div class="customer-filter-group">
                        <span>نقش:</span>
                        <ul class="filter-switch filter-switch-sm">
                        <li class="filter-switch-item">
                            <input type="radio" name="roleTypeChange" value="-1" id="roleType-all">
                            <label for="roleType-all">همه</label>
                        </li>
                        <li class="filter-switch-item">
                            <input type="radio" name="roleTypeChange" value="1" id="roleType-customer">
                            <label for="roleType-customer">مشتری</label>
                        </li>
                        <li class="filter-switch-item">
                            <input type="radio" name="roleTypeChange" value="2" id="roleType-supplier">
                            <label for="roleType-supplier">تامین کننده</label>
                        </li>
                        </ul>
                    </div>
                }
                <div class="customer-filter-group">
                    <span>نوع:</span>
                    <ul class="filter-switch filter-switch-sm">
                    <li class="filter-switch-item">
                        <input type="radio" name="juridicalChange" value="-1" id="juridical-all">
                        <label for="juridical-all">همه</label>
                    </li>
                    <li class="filter-switch-item">
                        <input type="radio" name="juridicalChange" value="1" id="juridical-1">
                        <label for="juridical-1">حقوقی</label>
                    </li>
                    <li class="filter-switch-item">
                        <input type="radio" name="juridicalChange" value="0" id="juridical-0">
                        <label for="juridical-0">حقیقی</label>
                    </li>
                    </ul>
                </div>
            </div>
        </div>

        <partial name="_FormAddCustomerPartial" />

        <div class="customer-directory__list" id="CuParId">
            <span id="LoadingCusPartId" class="customer-loading-status" role="status" aria-live="polite">در حال دریافت مشتریان</span>
            <div id="customerScrollRegion" class="customer-directory__scroll">
                <div id="CustomerPartial" aria-busy="true" class="customer-directory__grid">
                    @for (var card = 0; card < 3; card++) { <partial name="_CustomerSkeleton" /> }
                </div>
                <div id="btnShowAllId" style="display: none; justify-content: center; margin-top: 1rem;">
                    <button type="button" onclick="ShowAllCustomer()" class="customer-directory__more"><span>نمایش بیشتر</span>
                        <svg style="width: 20px" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" /></svg>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="Modals/_AlertCustomerRegisterModal" />
<partial name="Modals/_UpdateCustomerModal" />
<template id="customerSkeletonTemplate"><partial name="_CustomerSkeleton" /></template>

@section Scripts {
    <script src="~/js/customer/customer.js?release=7.5.6" data-page-bindings="JuridicalFlag,CurrentStep,allStep,flagStep1,flagStep2,flagStep3,SearchInp,LoadingCustomer,ShowAllBtn,getCountOfCustomerPartialTop,skipCus,takeCus,customerListRequest,ShowAllCustomer,readCustomerCards,loadCustomers,SearchAllCustomer,getAllCustomers,addToMyCustomer,opLoaded,showFormCustomer,hideFormCustomer,backStep,nextStep,gotoStep,showDivStep,hideDivSteps,changeForm,checkDuplicate,submitFormCustomerBase,abortCustomer,acceptCustomer,senfLoaded,ShowModalUpCustomer,SubmitUpFormCustomer,closeModalUpdate,GetSenfOp,GetAcquaintanceWayOp,GetUpSenfOp,initBaseItemSelect" asp-append-version="true"></script>
}



