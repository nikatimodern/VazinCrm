@{
    Layout = "_Layout";
}

<div class="w-100">
    <div class="row align-items-center justify-content-between flex-wrap mb-3 g-2">
        <div class="d-flex col-lg-3">
            <button class="buttonPurple2 d-flex align-items-center gap-1" style="padding: 4px 8px" onclick="togglePaymentModal()">
                <span style="line-height: 1">ثبت پرداختی جدید</span>
                <svg style="width: 20px" viewBox="0 0 20 20" fill="currentColor"><path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" /></svg>
            </button>
        </div>
        <div class="col-12 col-lg-5 d-flex align-items-center gap-2 flex-wrap">
            @* <input class="form-control w-100" type="text" id="paymentSearchId" placeholder="جستجو..." /> *@
            @*<div class="d-flex align-items-center flex-grow-1 gap-2">
                <input type="text" class="form-control form-control-sm" id="dealSearchId" placeholder="جستجو">
                <div class="btnFilter d-lg-none" data-filterVarConfig="filterDealConfig" data-filterCallBack="callbackFilterDeal" data-filterContentId="ContentDealFilterId" data-filterInpSearchId="dealSearchId" data-filterVarSearch="dealSearchVal" onclick="ShowFilterPopup(this)">
                    <svg style="width:24px;color:#333" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M3.792 2.938A49.069 49.069 0 0 1 12 2.25c2.797 0 5.54.236 8.209.688a1.857 1.857 0 0 1 1.541 1.836v1.044a3 3 0 0 1-.879 2.121l-6.182 6.182a1.5 1.5 0 0 0-.439 1.061v2.927a3 3 0 0 1-1.658 2.684l-1.757.878A.75.75 0 0 1 9.75 21v-5.818a1.5 1.5 0 0 0-.44-1.06L3.13 7.938a3 3 0 0 1-.879-2.121V4.774c0-.897.64-1.683 1.542-1.836Z" clip-rule="evenodd"></path></svg>
                </div>
            </div>*@
        </div>
        <div class="d-flex align-items-start justify-content-start justify-content-lg-end gap-2 col-lg-3">
            @*<div id="ContentDealFilterId" class="ContentFilter"></div>
            <div class="btnFilter d-none d-lg-flex" data-filterVarConfig="filterDealConfig" data-filterCallBack="callbackFilterDeal" data-filterContentId="ContentDealFilterId" data-filterInpSearchId="dealSearchId" data-filterVarSearch="dealSearchVal" onclick="ShowFilterPopup(this)">
                <svg style="width:24px;color:#333" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M3.792 2.938A49.069 49.069 0 0 1 12 2.25c2.797 0 5.54.236 8.209.688a1.857 1.857 0 0 1 1.541 1.836v1.044a3 3 0 0 1-.879 2.121l-6.182 6.182a1.5 1.5 0 0 0-.439 1.061v2.927a3 3 0 0 1-1.658 2.684l-1.757.878A.75.75 0 0 1 9.75 21v-5.818a1.5 1.5 0 0 0-.44-1.06L3.13 7.938a3 3 0 0 1-.879-2.121V4.774c0-.897.64-1.683 1.542-1.836Z" clip-rule="evenodd"></path></svg>
            </div>*@
        </div>
    </div>
    <div id="paymentContainer">
        <table class="table table-striped table-bordered table-hover nowrap w-100" id="supplyPaymentTable">
            <thead>
            <tr>
                <th>شماره پرداخت</th>
                <th>تاریخ ثبت</th>
                <th>مبلغ</th>
                <th>از حساب</th>
                <th>به حساب</th>
                <th>نوع</th>
                <th>تاریخ پرداخت</th>
                <th>فاکتور تامین</th>
                <th>ثبت توسط</th>
                <th>عملیات</th>
            </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>



<!-- Modal Payment -->
<div class="modal fade invoice-modal payment-mode" id="PaymentModalId" tabindex="-1" role="dialog" data-bs-focus="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content col-12" style="padding:10px!important">
            <div class="modalHeader-invoice"></div>
            <div class="modal-body pb-0" style="padding-inline: 10px">
                <div class="modalContent-invoice">
                    <form id="paymentFormId" class="d-flex flex-column w-100 gap-4 mt-2">
                        <div class="sectionBox-invoice">
                            <span class="sectionTitle-invoice">روش پرداخت</span>
                            <div class="d-flex justify-content-evenly flex-wrap" style="font-size:clamp(14px,2vw,19px)">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input valueNumber" type="radio" name="paymentType" id="NagdiId" value="1" checked>
                                    <label class="form-check-label" for="NagdiId">نقدی</label>
                                </div>

                                <div class="form-check form-check-inline">
                                    <input class="form-check-input valueNumber" type="radio" name="paymentType" id="ChekiId" value="2">
                                    <label class="form-check-label" for="ChekiId">چکی</label>
                                </div>
                            </div>
                        </div>

                        <div class="sectionBox-invoice">
                            <span class="sectionTitle-invoice">اطلاعات تراکنش بانکی</span>
                            <div class="flex-center flex-wrap row-gap-2 w-100">
                                <div class="col-12 col-sm-6 col-lg-4 pe-sm-2">
                                    <label>مبلغ (ریال)</label>
                                    <input inputmode="numeric" class="currencyNumber form-control inpAmount" name="amount" type="text" placeholder="مبلغ پرداختی به ریال" required />
                                </div>

                                <div class="col-12 col-sm-6 col-lg-4">
                                    <label>تاریخ پرداخت</label>
                                    <input class="sdate form-control" name="paymentDateTxt" type="text" placeholder="تاریخ پرداخت" data-mask-date required />
                                </div>
                            </div>

                            <div class="mt-2 w-100">
                                <div>
                                    <label>حساب مبدا</label>
                                    @* <select class="form-select" name="fromAccount" type="text" required></select> *@
                                    <input class="form-control" name="fromAccount" type="text" placeholder="از کدام حساب پرداخت شده است." required />
                                </div>
                                <div class="mt-2">
                                    <label>حساب مقصد</label>
                                    <input class="form-control" name="toAccount" type="text" placeholder="به کدام حساب و به نام چه کسی پرداخت شده است." required />
                                </div>
                            </div>
                        </div>
                        <div class="sectionBox-invoice">
                            <span class="sectionTitle-invoice">فاکتور تامین</span>
                            <div>
                                <label for="paymentSupplyFactor">بابت فاکتور:</label>
                                <div class="input-group">
                                    <input id="paymentSupplyFactor" type="text" class="form-control direction-ltr" placeholder="فاکتور تامین.." disabled required>
                                    <button class="btn btn-sm btn-secondary" type="button" onclick="showAddSupplyFactorModal(this)">انتخاب</button>
                                </div>
                            </div>
                        </div>
                    </form>

                    <div class="sectionBox-invoice mt-4">
                        <span class="sectionTitle-invoice">رسید پرداخت</span>
                        <div class="container-uploader">
                            <input type="file" class="uploadBtn" data-varList="paymentAttachments" data-showList="DivShowPayment" id="paymentAtt" accept="*/*" />
                            <label for="paymentAtt">
                                <svg style="width: 16px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" /></svg>
                                <span>تصویر رسید را انتخاب کنید یا اینجا رها کنید</span>
                            </label>
                            <div class="image-display" id="DivShowPayment"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="px-0 py-3 w-100">
                <div style="width:100%; height:2px; background-color:var(--DarkColor)"></div>
            </div>

            <div class="gap-1 modal-footer p-0 border-0 justify-content-center">
                <button class="buttonCancel2 m-0" onclick="cancelPaymentModal()">انصراف</button>
                <button class="buttonGreen3 m-0" onclick="submitPaymentModal()">ثبت</button>
            </div>
        </div>
    </div>
</div>




@section Scripts {
    <script>
        var paymentAttachments = [];
        let paymentData = [];
        const paymentModal = document.getElementById("PaymentModalId");
        document.addEventListener("DOMContentLoaded", async () => {
            @*const data = await getAllBankAccountsJson();
            const select = paymentModal.querySelector("select[name='fromAccount']");
            createOption(select, data);*@;

            getAllPaymentsDt();
        });

        const togglePaymentModal = async () => {
            paymentModal.querySelector(".modalHeader-invoice").innerText = "ثبت پرداختی";
            paymentModal.classList.add("payment-mode");

            ModalToggle(paymentModal);
        };

        const cancelPaymentModal = () => {
            paymentAttachments = [];
            supplyFactorsSelectedIds = [];
            paymentData = [];
            document.getElementById("DivShowPayment").innerHTML = "";
            document.getElementById("paymentAtt").value = "";
            mySer.emptyForm("paymentFormId");
            ModalToggle(paymentModal);
        };

        const submitPaymentModal = async () => {
            if (!await mySer.CheckValidForm("paymentFormId")) return;
            if (paymentAttachments.every(item => item.isDeleted)) {
                toastifyError("تصویر رسید اجباری است");
                return;
            }

            const model = {3
                ...paymentData,
                ...mySer.convertFormToJSON("paymentFormId"),
                paymentSupplyFactors: supplyFactorsSelectedIds.map(id => ({ supplyFactorId: id })),
                attachments: paymentAttachments,
            };

            FLshowLoading();
            try {
                const apiUrl = model.id ? "/Supply/UpdatePayment" : "/Supply/AddPayment";
                const res = await axios.post(apiUrl, model);
                if (res.status === 200) {
                    toastifySuccess("با موفقیت ثبت شد");
                    cancelPaymentModal();
                    paymentTbl.ajax.reload();
                }
            } catch (err) {
                console.log(err);
            } finally {
                FLshowLoading(false);
            }
        };

        const getAllPayments = async () => {
            FLshowLoading();
            const res = await axios(`/Supply/GetAllSupplyPaymentPartial`);
            document.getElementById("paymentContainer").innerHTML = res.data;
            FLshowLoading(false);
        };

        const deletePayment = async (id) => {
            Swal.fire({
                title: "حذف!",
                text: "آیا مطمئن هستید که میخواهید حذف کنید؟",
                icon: "warning",
                showCancelButton: true,
                cancelButtonColor: "#adadad",
                confirmButtonColor: "#e64942",
                cancelButtonText: "انصراف",
                confirmButtonText: "بله، حذف شود",
            }).then(async (willDelete) => {
                if (willDelete.isConfirmed) {
                    FLshowLoading();
                    const res = await axios(`/Supply/DeletePayment/${id}`);
                    if (res.status === 200) {
                        toastifySuccess("با موفقیت حذف شد");
                        paymentTbl.ajax.reload();
                    }
                    FLshowLoading(false);
                }
            });
        };

        async function showEditPaymentModal(id) {
            FLshowLoading();
            await togglePaymentModal();

            try {
                const res = await axios(`/Supply/GetPayment/${id}`);
                if (res.status === 200) {
                    paymentData = res.data.payment;
                    const factorSerials = res.data.supplyFactorSerials;
                    mySer.convertJsonToForm(paymentData, "paymentFormId");
                    supplyFactorsSelectedIds = paymentData.paymentSupplyFactors.map(p => p.supplyFactorId);

                    const inpElm = document.getElementById("paymentSupplyFactor");
                    inpElm.value = factorSerials.join(", ");
                    paymentAttachments = res.data.attachments;
                    FileUpReload("paymentAtt");
                }

            } catch (err) {
                console.log(err);
            } finally {
                FLshowLoading(false);
            }
        }


        let paymentTbl;
        let modelPayment = {};
        const getAllPaymentsDt = () => {
            paymentTbl = $("#supplyPaymentTable").DataTable({
                pageLength: 10,
                lengthMenu: [5, 10, 20, 50, 100, { label: "همه", value: -1 }],
                processing: true,
                serverSide: true,
                searching: true,
                search: {
                    return: true,
                },
                ordering: true,
                order: [[1, "desc"]],
                scrollCollapse: true,
                scrollY: "70dvh",
                responsive: true,
                ajax: {
                    url: `/Supply/GetAllSupplyPaymentDt`,
                    type: "POST",
                    data: (d) => {
                        d.model = JSON.stringify(modelPayment);
                    },
                },
                language: {
                    emptyTable: "هیچ رکوردی موجود نمی باشد.",
                    info: "نمایش _START_ تا _END_ از _TOTAL_ ردیف",
                    infoEmpty: "نمایش 0 تا 0 از 0 ردیف",
                    infoFiltered: "(فیلتر شده از _MAX_ ردیف)",
                    lengthMenu: "نمایش _MENU_ ردیف",
                    loadingRecords: "در حال بارگزاری...",
                    search: "",
                    zeroRecords: "رکوردی با این مشخصات پیدا نشد",
                    aria: {
                        sortAscending: ": فعال سازی نمایش به صورت صعودی",
                        sortDescending: ": فعال سازی نمایش به صورت نزولی",
                    },
                },
                columnDefs: [
                    {
                        targets: [3, 4, 5, 7, 8, 9],
                        orderable: false,
                    },
                    {
                        targets: [1],
                        render: data => `<span dir="ltr">${data.slice(0, -3).split(" ").join(" | ")}</span>`,
                    },
                    {
                        targets: [2],
                        render: data => `<span dir="ltr" class="fbold">${data ? data.toLocaleString() : "-"}</span>`,
                    },
                    {
                        targets: [7],
                        render: data => `<span dir="ltr">${data?.join(", ") || "-"}</span>`,
                    },
                ],
                columns: [
                    { data: "payment.paymentNumber", name: "PaymentNumber", defaultContent: "-" },
                    { data: "payment.createDateTxt", name: "CreateDateTxt", defaultContent: "-" },
                    { data: "payment.amount", name: "Amount", defaultContent: "-" },
                    { data: "payment.fromAccount", name: "FromAccount", defaultContent: "-" },
                    { data: "payment.toAccount", name: "ToAccount", defaultContent: "-" },
                    { data: "payment.paymentTypeTxt", name: "PaymentTypeTxt", defaultContent: "-" },
                    { data: "payment.paymentDateTxt", name: "PaymentDateTxt", defaultContent: "-" },
                    { data: "supplyFactorSerials", name: "SupplyFactorSerials", defaultContent: "-" },
                    { data: "payment.userCreator", name: "UserCreator", defaultContent: "-" },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return `
                                <div class="d-inline-flex align-items-center justify-content-center gap-1">
                                    <button type="button" style="padding: 6px 7px;box-shadow: none;font-size: 12px" class="buttonGray flex-center" onclick="showAttachments('${row.payment.id}', 9)"><i class="fa fa-paperclip"></i></button>
                                    <button type="button" style="padding: 6px 6px;box-shadow: none;font-size: 12px" class="buttonGreen3 flex-center" onclick="showEditPaymentModal('${row.payment.id}')"><i class="fa fa-pencil"></i></button>
                                    <button type="button" style="padding: 6px 7px;box-shadow: none;font-size: 12px" class="buttonCancel2 flex-center" onclick="deletePayment('${row.payment.id}')"><i class="fa fa-trash"></i></button>
                                </div>
                            `;
                        },
                    },
                ],
                layout: {
                    bottomEnd: "info",
                    bottomStart: {
                        paging: {
                            type: "simple_numbers",
                        },
                    },
                    topEnd: {
                        pageLength: true,
                    },
                    topStart: {
                        search: {
                            placeholder: "جستجو",
                        },
                    },
                },
            });
        };

    </script>
}