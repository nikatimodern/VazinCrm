@using CRM.Core.Domain.RequestAmounts.Entities
@model List<CRM.EndPoint.FrontEnd.Models.ViewModel.Amount.RequestAmountVModel>

@{
    var passType = ViewBag.PassType; //1: requestAmount | 2: cartable MD
    var isFinancial = ViewBag.IsFinancial;
    var userId = ViewBag.UserId;
}

<div class="col-12 mx-auto d-flex flex-column" style="gap:12px;padding-bottom: 12px;">
    @foreach (var item in Model) {
        var reqAmount = item.RequestAmount;
        var isCreator = reqAmount.UserCreatorID == userId;
        var supplyFactorSerials = item.SupplyFactorSerials;
        var orderHeadNumbers = item.OrderHeadSerials;
        var status = reqAmount.RequestStatus;

        var bgCssClass = status switch {
            RequestStatusEnum.در_انتظار_پرداخت => "layered-green-light",
            RequestStatusEnum.واریز_شد => "layered-green",
            RequestStatusEnum.در_انتظار_تایید_مدیرعامل or RequestStatusEnum.در_انتظار_ارسال_به_مالی => "layered-purple-light",
            //RequestStatusEnum.در_انتظار_تایید_مدیرعامل or RequestStatusEnum.در_انتظار_ارسال_به_مالی => "layered-gold",
            _ => ""
        };

        <div class="layered-card layered-card-pill @(bgCssClass)">

            <div class="layered-card__layer col-12 col-lg-3 d-flex flex-column justify-content-center px-3 px-lg-4 py-2">
                <div class="d-flex justify-content-between align-items-baseline mb-1">
                    <span style="font-size: 13px; color: #777">شماره درخواست:</span>
                    <span class="fbold">@reqAmount.RequestNumber</span>
                </div>
                <div class="d-flex justify-content-between align-items-baseline mb-1">
                    <span style="font-size: 13px; color: #777">تاریخ درخواست:</span>
                    <span class="fbold direction-ltr">
                        @(string.Join(" | ", reqAmount.CreateDateTxt?.Substring(0, 16).Split(' ')))
                    </span>
                </div>
                <div class="d-flex justify-content-between align-items-baseline">
                    <span style="font-size: 13px; color: #777">ثبت شده توسط:</span>
                    <span class="fbold">@reqAmount.UserCreator</span>
                </div>
            </div>

            <div class="layered-card__layer col-12 col-lg-3 col-xl-4 d-flex flex-column justify-content-center align-items-center px-3 py-2">
                <div class="d-flex flex-wrap justify-content-center align-items-baseline column-gap-2 text-center">
                    <span style="font-size: 13px; color: #777">نوع:</span>
                    <span class="fbold">
                        @reqAmount.DocTypeTxt @(reqAmount.Prepayment ? "(پیش پرداخت)" : "")
                    </span>
                </div>
                @if (supplyFactorSerials.Any()) {
                    <div class="d-flex flex-wrap justify-content-center align-items-baseline column-gap-2 mt-2 text-center">
                        <span style="font-size: 13px; color: #777">فاکتور تامین:</span>
                        <span class="fbold direction-ltr">@string.Join(", ", supplyFactorSerials)</span>
                    </div>
                }
                @if (orderHeadNumbers.Any()) {
                    <div class="d-flex flex-wrap justify-content-center align-items-baseline column-gap-2 mt-2 text-center">
                        <span style="font-size: 13px; color: #777">حواله تولید:</span>
                        <span class="fbold direction-ltr">@string.Join(", ", orderHeadNumbers)</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(reqAmount.SupplierTxt)) {
                    <div class="d-flex flex-wrap justify-content-center align-items-baseline column-gap-2 mt-2 text-center">
                        <span style="font-size: 13px; color: #777">تامین کننده:</span>
                        <span class="fbold direction-ltr">@reqAmount.SupplierTxt</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(reqAmount.Description)) {
                    <div class="d-flex flex-wrap justify-content-center align-items-baseline column-gap-2 mt-2 text-center">
                        <span style="font-size: 13px; color: #777">توضیحات:</span>
                        <span class="fbold direction-ltr">@reqAmount.Description</span>
                    </div>
                }
            </div>

            <div class="layered-card__layer col-12 col-lg-2 d-flex flex-row flex-lg-column justify-content-between justify-content-lg-center align-items-center px-3 py-2">
                <span style="font-size: 13px; color: #777">مبلغ درخواست:</span>
                <div class="fbold flex-center align-items-baseline column-gap-1">
                    <span style="font-size: 17px;">@string.Format("{0:n0}", reqAmount.Amount)</span>
                    <span style="font-size: 11px;">ريال</span>
                </div>
            </div>
            @if (passType == 1) {
                <div class="layered-card__layer col d-flex flex-row flex-lg-column justify-content-between justify-content-lg-center align-items-center px-3 py-2">
                    <span style="font-size: 13px; color: #777">مبلغ تایید شده:</span>
                    <div class="fbold flex-center align-items-baseline column-gap-1 @(status is RequestStatusEnum.در_انتظار_پرداخت or RequestStatusEnum.واریز_شد ? "badgeGreen" : "")">
                        <span style="font-size: 16px;">@($"{reqAmount.AcceptedAmount:n0}")</span>
                        <span style="font-size: 11px;">ريال</span>
                    </div>
                </div>

                <div class="layered-card__layer col-12 col-lg-1 flex-center flex-row flex-lg-column p-2 gap-4 gap-lg-3">
                    @switch (status) {
                        case RequestStatusEnum.ثبت_اولیه:
                            if (isFinancial && !isCreator) {
                                <span class="fbold" style="color:#777">@reqAmount.RequestStatusTxt</span>
                            } else {
                                <div class="flex-center flex-column gap-3">
                                    <div class="flex-center flex-row gap-4 gap-lg-3">
                                        <button class="flex-center p-0" data-title-right="ویرایش" style="color:#333" onclick="showEditRequestAmountModal('@reqAmount.Id')">
                                            <i class="fa fa-pencil"></i>
                                        </button>

                                        <button class="flex-center p-0" data-title-right="حذف" style="color:#333" onclick="deleteRequestAmount('@reqAmount.Id')">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </div>
                                    <button class="buttonGreen2" onclick="changeStatusReqAmount('@reqAmount.Id', 1)">ارسال به مدیرعامل</button>
                                </div>
                            }

                            break;
                        case RequestStatusEnum.در_انتظار_تایید_مدیرعامل:
                        case RequestStatusEnum.در_انتظار_ارسال_به_مالی:
                            <span class="fbold text-center" style="color: rebeccapurple">@reqAmount.RequestStatusTxt</span>
                            break;
                        case RequestStatusEnum.در_انتظار_پرداخت:
                            if (isFinancial) {
                                <div class="flex-center flex-column gap-1">
                                    <button class="buttonGreen2" onclick="showAttachReqAmount('@reqAmount.Id')">واریز شد</button>
                                    <button class="buttonCancel3" onclick="changeStatusReqAmount('@reqAmount.Id', 1)">برگشت</button>
                                </div>
                            } else {
                                <span class="fbold" style="color: #4f817d">@reqAmount.RequestStatusTxt</span>
                            }

                            break;
                        case RequestStatusEnum.واریز_شد:
                            var attachFn = isFinancial ? $"showAttachReqAmount('{reqAmount.Id}')" : $"showAttachments('{reqAmount.Id}', 11)";

                            <button class="flex-center p-0" data-title-right="پیوست ها" style="color:var(--DarkColor)" onclick="@attachFn">
                                <i class="fa fa-paperclip"></i>
                            </button>
                            <div class="flex-center gap-2">
                                <span class="fbold" style="color: #04857c">واریز شد</span>
                                @if (isFinancial) {
                                    <span style="cursor:pointer;color:#333" onclick="changeStatusReqAmount('@reqAmount.Id', 3)" data-title="بازگشت">
                                        <svg style="width:16px" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m15 15 6-6m0 0-6-6m6 6H9a6 6 0 0 0 0 12h3" /></svg>
                                    </span>
                                }
                            </div>
                            break;
                    }
                </div>
            } else if (passType == 2) {
                decimal[] percents = [25, 50, 75, 100];
                var percent = (reqAmount.AcceptedAmount * 100) / reqAmount.Amount;
                var pendingMd = status == RequestStatusEnum.در_انتظار_تایید_مدیرعامل;

                <div class="layered-card__layer col-12 col-lg-3 col-xl-2 d-flex flex-row flex-lg-column justify-content-between justify-content-lg-center align-items-center px-3 py-2 gap-2">
                    <span style="font-size: 13px; color: #777" class="flex-shrink-0">مبلغ تایید شده:</span>
                    <div class="input-group">
                        <input name="acceptedAmount" @(pendingMd ? "" : "disabled") type="text" class="form-control currencyNumber" oninput="changeAcceptedRequestAmount(this, @reqAmount.Amount, @reqAmount.AcceptedAmount)" value="@(reqAmount.AcceptedAmount > 0 ? $"{reqAmount.AcceptedAmount:n0}" : "")" required>
                        <select class="form-select form-select-xs no-placeholder-style" @(pendingMd ? "" : "disabled") style="background-color: @(percents.Contains(percent) ? "#e3f7e3" : "");" onchange="changePercentAcceptedRequestAmount(this, @reqAmount.Amount, @reqAmount.AcceptedAmount)">
                            <option value="" selected="@(percent == 0 ? "selected" : null)">درصد</option>
                            @foreach (var p in percents) {
                                <option value="@p" selected="@(percent == p ? "selected" : null)">@p%</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="layered-card__layer col-12 col-lg-1 flex-center flex-row flex-lg-column px-2 py-2 gap-4 gap-lg-3">
                    @switch (status) {
                        case RequestStatusEnum.ثبت_اولیه:
                            <span class="fbold" style="color:#777">@reqAmount.RequestStatusTxt</span>
                            break;
                        case RequestStatusEnum.در_انتظار_تایید_مدیرعامل:
                            <div class="d-inline-flex flex-column align-items-center justify-content-center gap-2">
                                <button class="buttonGreen2" onclick="submitAcceptedRequestAmount(this, '@reqAmount.Id')" @(reqAmount.AcceptedAmount == 0 ? "disabled" : "")>
                                    تایید
                                </button>
                                <button class="buttonCancel3" onclick="changeStatusReqAmount('@reqAmount.Id', 0)">برگشت</button>
                            </div>
                            break;
                        case RequestStatusEnum.در_انتظار_ارسال_به_مالی:
                            <div class="d-inline-flex flex-column align-items-center justify-content-center gap-2">
                                <button class="buttonGreen2" onclick="changeStatusReqAmount('@reqAmount.Id', 3)" @(reqAmount.AcceptedAmount == 0 ? "disabled" : "")>
                                    ارسال به مالی
                                </button>
                                <button class="buttonCancel3" onclick="changeStatusReqAmount('@reqAmount.Id', 1)">برگشت</button>
                            </div>
                            break;
                        case RequestStatusEnum.در_انتظار_پرداخت:
                            <span class="fbold text-center" style="color: #4f817d">@reqAmount.RequestStatusTxt</span>
                            break;
                        case RequestStatusEnum.واریز_شد:
                            <button class="flex-center p-0" data-title-right="پیوست ها" style="color:var(--DarkColor)" onclick="showAttachments('@reqAmount.Id', 11)">
                                <i class="fa fa-paperclip"></i>
                            </button>
                            <span class="fbold text-center" style="color: #04857c">@reqAmount.RequestStatusTxt</span>
                            break;
                    }

                </div>
            }
        </div>
    }
</div>
