@using CRM.Core.Domain.ASettings.Entities
@using CRM.Core.Domain.PreFactors.Enum
@model CRM.EndPoint.FrontEnd.Models.Cartable.TaminViewModel
@{ Layout = null; }
<div class="pf-accepted-list">
    @foreach (var item in Model.PreFactors) {
        <article class="pf-accepted-card @(item.Pftype == (int)PreFactorEnum.فاقد_اعتبار ? "pf-accepted-card--invalid" : item.SupplyMismatch ? "factor-card--returned" : "")">
            @if (!Model.IsAdmin && item.UserTaminId.ToString() != Model.UserId) {
                <div class="disabled-overlay"></div>
            }
            <partial name="~/Views/PreFactor/_PreFactorSideLabels.cshtml" model="item" />
            <div class="InfoDataItem_Prefactor pf-accepted-card__content supply-card">
                <div class="pf-accepted-card__facts">
                    <div class="pf-accepted-card__fact"><span>سریال پیش‌فاکتور</span><strong>@item.SerialNumber</strong></div>
                    @if (item.DealSerialNumber != null) {
                        <div class="pf-accepted-card__fact"><span>سریال سفارش</span><strong>@item.DealSerialNumber</strong></div>
                    }
                    <div class="pf-accepted-card__fact"><span>تاریخ</span><strong>@item.Date</strong></div>
                    <div class="pf-accepted-card__fact">
                        <span>تاریخ تأیید</span><strong>@(string.IsNullOrEmpty(item.AcceptedDateTxt) ? "-" : item.AcceptedDateTxt.Substring(0, 10))</strong>
                    </div>
                </div>
                <div class="pf-accepted-card__body">
                    <section class="pf-accepted-card__section pf-accepted-card__customer">
                        <h3><span>اطلاعات مشتری</span><i class="fa fa-user" aria-hidden="true"></i></h3>
                        <div class="pf-accepted-card__row"><span>کد مشتری</span><strong>@(item.CustomerEntity?.CustomerCode.ToString() ?? item.CustomerCode?.ToString() ?? "-")</strong></div>
                        <div class="pf-accepted-card__row"><span>مشتری</span><strong>@item.Customer @(string.IsNullOrWhiteSpace(item.Customer) || string.IsNullOrWhiteSpace(item.AgentName) ? "" : " | ")@item.AgentName</strong></div>
                        <div class="pf-accepted-card__row"><span>کارشناس فروش</span><strong>@item.UserCreator</strong></div>
                        <div class="pf-accepted-card__row"><span>کارشناس تأمین</span><strong>@(string.IsNullOrWhiteSpace(item.UserTaminTxt) ? "-" : item.UserTaminTxt)</strong></div>
                    </section>
                    <section class="pf-accepted-card__section pf-accepted-card__financial">
                        <h3><span>اطلاعات تأمین</span><i class="fa fa-industry" aria-hidden="true"></i></h3>
                        <div class="pf-accepted-card__row"><span>مبلغ پیش‌فاکتور</span><strong>
                                <bdi dir="ltr">@string.Format("{0:n0}", item.PaymentAmount)</bdi>
                                <small>@(item.CurrencyTypeTxt ?? "ريال")</small></strong></div>
                        @if (Model.Setting.SetAmountByRoleType != SetAmountRoleEnum.فروش) {
                            <div class="pf-accepted-card__row"><span>بهای تأمین</span><strong>
                                    <bdi dir="ltr">@string.Format("{0:n0}", item.TotalSupplyAmount ?? 0)</bdi>
                                    <small>@(item.CurrencyTypeTxt ?? "ريال")</small></strong></div>
                        }
                        <div class="pf-accepted-card__row"><span>وضعیت</span><strong>@item.PftypeTxt</strong></div>
                        @if (item.SupplyMismatch) {
                            <div class="supply-card__warning">مغایرت تأمین</div>
                        }
                        <div class="pf-finance-card__controls supply-card__controls">
                            @if (item.Pftype > (int)PreFactorEnum.در_انتظار_تایید_مسئول_تامین && Model.Setting.SetAmountByRoleType != SetAmountRoleEnum.فروش) {
                                <button type="button" class="px-2 py-0 btn @(item.SupplyMismatch ? "btn-outline-danger" : item.NoSupply ? "btn-outline-secondary" : "btn-success")" style="min-width: 90px"
                                        onclick="showSetSupplyModal('@item.Id', @Model.Setting.SetSupplyAmountByTamin.ToString().ToLower(), @Model.Setting.SetSupplyByTamin.ToString().ToLower())">
                                    @if (!item.SupplyMismatch && !item.NoSupply) {
                                        <i class="fa fa-check me-1" aria-hidden="true"></i>
                                    }
                                    بهای تامین
                                </button>
                                <button type="button" class="px-2 py-0 btn btn-outline-secondary" style="min-width: 90px" onclick="showModalSetAmount('@item.Id', false)">
                                    بهای فروش
                                </button>
                            }
                            <div class="d-flex flex-wrap align-items-center justify-content-center gap-2">
                                @if (item.Pftype == (int)PreFactorEnum.در_انتظار_تایید_مسئول_تامین) {
                                    <button type="button" class="px-2 py-0 btn btn-outline-secondary" style="min-width: 90px" id="NotAcceptTaminExpertId" onclick="showModalNotAccept('@item.Id', 13)">
                                        عدم تایید
                                    </button>

                                    <button type="button" class="px-2 py-0 btn btn-secondary" style="min-width: 90px" onclick="showModalSetAmount('@item.Id')">تایید</button>
                                } else if (item.Pftype == (int)PreFactorEnum.در_انتظار_ارسال_به_مشتری || item.Pftype == (int)PreFactorEnum.در_انتظار_تایید_مشتری) {
                                    <button type="button" class="px-2 py-0 btn btn-outline-secondary" style="min-width: 90px" onclick="rejectPreFactor('@item.Id', 13)">
                                        رد تایید
                                    </button>
                                    <button type="button" class="px-2 py-0 btn btn-outline-secondary" style="min-width: 90px" onclick="showModalNotAccept('@item.Id', 13)">
                                        رد تایید و بازگشت
                                    </button>
                                }
                            </div>

                            @if (item.Pftype is (int)PreFactorEnum.در_انتظار_تایید_مدیر_فروش or (int)PreFactorEnum.در_انتظار_تایید_مالی or (int)PreFactorEnum.در_انتظار_تولید or (int)PreFactorEnum.جنس_به_مشتری_تحویل_داده_شد) {
                                <button type="button" class="px-2 py-0 btn btn-outline-secondary" style="min-width: 90px" onclick="showModalCreateOrder(@((int)Model.Setting.SetAmountByRoleType),'@item.Id','@item.CustomerId')">
                                    حواله تولید
                                </button>
                            }
                        </div>
                    </section>
                </div>
                @if (Model.Setting.SetAmountByRoleType != SetAmountRoleEnum.فروش) {
                    var steps = new List<(int type, string label)> {
                        ((int)TaminStepEnum.تعیین_مبلغ_فروش, "تعیین مبلغ فروش"),
                        ((int)TaminStepEnum.تعیین_تامین_کننده, "تعیین تأمین‌کننده"),
                        ((int)TaminStepEnum.در_انتظار_تایید, "تأیید")
                    };
                    int stepOrder = steps.FindIndex(s => s.type == (int)item.TaminStep);
                    <div class="pf-accepted-card__progress">
                        <div class="pf-accepted-card__steps supply-card__steps">
                            @for (int i = 0; i < steps.Count; i++) {
                                bool completed = stepOrder > i || item.TaminStep == TaminStepEnum.تایید_شده;
                                bool active = stepOrder == i && item.TaminStep != TaminStepEnum.تایید_شده;
                                <div class="pf-accepted-card__step @(completed ? "pf-accepted-card__step--completed" : "")" aria-current="@(active ? "step" : null)">
                                    <span class="progressTrackerDots @(completed ? "completedTrack" : active ? "activeTrack" : "")">@if (completed) {
                                            <i class="fa fa-check" aria-hidden="true"></i>
                                        }</span>
                                    <span class="pf-accepted-card__step-label">@steps[i].label</span>
                                </div>
                            }
                        </div>
                    </div>
                }
                <div class="pf-accepted-card__actions">
                    <div class="pf-accepted-card__action-list">

                        <button type="button" class="mp" style="color:var(--DarkColor); border:none;background-color:transparent" aria-label="نمایش پیش فاکتور" data-title-right="نمایش پیش فاکتور" onclick="ShowPreviewPfactor('@item.Id')"><span class="pf-accepted-card__action-icon" aria-hidden="true">
                        <i class="mp fa fa-eye"></i>
                    </span></button>

                        @if (item.CustomerId != null) {
                            <button type="button" class="mp" style="color:var(--DarkColor); border:none;background-color:transparent" aria-label="پروفایل" data-title-right="پروفایل" onclick="openCustomerProfile('@item.CustomerId', '@item.SerialNumber')"><span class="pf-accepted-card__action-icon" aria-hidden="true">
                            <i class="mp fa fa-user"></i>
                        </span></button>
                        }

                        <button type="button" class="mp" style="color:var(--DarkColor); border:none;background-color:transparent" aria-label="پیوست ها" data-title-right="پیوست ها" onclick="AttachDoc('@item.Id')"><span class="pf-accepted-card__action-icon" aria-hidden="true">
                        <i class="mp fa fa-paperclip"></i>
                    </span></button>

                    </div>
                </div>
                @if (!string.IsNullOrEmpty(item.CommentText)) {
                    <div class="pf-accepted-card__description">
                        <span>توضیحات: </span><span style="white-space:pre-line">@Html.Raw(item.CommentText)</span></div>
                }
            </div>
        </article>
    }
</div>
