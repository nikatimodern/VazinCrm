@model List<IdentityRole>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div style="display:flex; justify-content:center">

    <div class="bg-light col-12 col-md-7" style=" margin:0 auto !important">
        <div style="display:flex; justify-content:space-between; align-items: center;padding:10px">
            <h4 class="mb-0" style="font-family:IRANSansBold">نقش ها</h4>
            <div>
                <button class="buttonGray2 d-flex align-items-center gap-2" onclick="goTo('/RoleManager/create')">
                    <i class="fa fa-plus"></i>
                    افزودن
                </button>
            </div>
        </div>
        <table class="table table-bordered table-striped table-hover mb-0" style="text-align:center">
            <tr>
                <th>نام</th>
                <th>عملیات</th>
            </tr>
            <div class="line" style="border-bottom-color: #888"></div>
            @if (Model.Count() == 0) {
                <tr>
                    <td colspan="3" class="text-center">No Role Exists</td>
                </tr>
            } else {
                foreach (IdentityRole role in Model) {
                    <tr>
                        @*<td>@role.Id</td>*@
                        <td>@role.Name</td>


                        <td>
                            <form asp-action="Delete" asp-route-id="@role.Id" method="post">
                                @*<button class="button">ویرایش</button>*@
                                <button type="submit" class="buttonCancel2" style="line-height: 1">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </table>
    </div>

</div>



