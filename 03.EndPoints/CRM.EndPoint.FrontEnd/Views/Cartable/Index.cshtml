                        <div class="gap-2 mt-xxl-2 d-flex align-items-center justify-content-between justify-content-xxl-center px-1" style="width:100%;padding-bottom:8px">
                            <p class="fbold d-flex d-xxl-none align-items-center gap-1" style="font-size:clamp(15px,2vw,16px);color:rgb(84 57 213)">
                                تعداد:<span id="fCountMobileId"></span>
                            </p>

                            <div class="search-group col-md-7 flex-grow-1 flex-md-grow-0">
