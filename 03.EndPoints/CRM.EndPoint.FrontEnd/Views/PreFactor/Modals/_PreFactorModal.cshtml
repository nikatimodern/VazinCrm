<!-- Modal PreFactor -->
<div class="modal fade" id="PreFactor" tabindex="-1" role="dialog" data-bs-focus="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-xxl">
        <div class="modal-content col-12">
            <div class="modal-header pb-0 border-0">
                <div class="w-100 flex-center text-white fbold" style="background-color:rebeccapurple;border-radius:5px;height: 24px;">
                    صدور پیش فاکتور
                </div>
            </div>

            <div class="modal-body d-flex flex-column justify-content-between w-100">
                <div>
                    <div class="d-flex flex-column-reverse flex-lg-row gap-3 px-2 align-items-center justify-content-between w-100">
                        <div class="col-12 col-lg-3 d-flex align-items-end justify-content-between flex-grow-1">
                            <form class="d-flex flex-column justify-content-between row-gap-3" id="PfHeadFormId" style="flex-grow:0.6">
                                <div class="d-flex justify-content-evenly">
                                    <div class="d-flex w-100 justify-content-around flex-column gap-1 gap-lg-2" id="officialAlert">
                                        <div class="mp d-flex align-items-center gap-1">
                                            <label class="fbold" for="official">رسمی</label>
                                            <input type="radio" name="official" id="official" value="1" data-alertid="officialAlert" required />
                                        </div>
                                        <div class="mp d-flex align-items-center gap-1">
                                            <label class="fbold" for="unofficial">غیر رسمی</label>
                                            <input type="radio" name="official" id="unofficial" value="0" data-alertid="officialAlert" required />
                                        </div>
                                    </div>
                                    <div class="d-flex w-100 justify-content-around flex-column gap-1 gap-lg-2" id="exportAlert">
                                        <div class="mp d-flex align-items-center gap-1">
                                            <label class="fbold" for="export">صادراتی</label>
                                            <input type="radio" name="export" id="export" value="1" data-alertid="exportAlert" required />
                                        </div>
                                        <div class="mp d-flex align-items-center gap-1">
                                            <label class="fbold" for="unexport">غیر صادراتی</label>
                                            <input type="radio" name="export" id="unexport" value="0" data-alertid="exportAlert" required />
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <label for="currencyTypeSelect">نوع ارز</label>
                                    <select class="form-select form-select-sm w-auto" name="currencyType" id="currencyTypeSelect">
                                        <option value="0" selected>ریال</option>
                                        @*<option value="1">دلار</option>
                                        <option value="2">یورو</option>*@
                                    </select>
                                </div>
                            </form>
                            <div class="d-lg-none">
                                <button class="btn btn-sm btn-secondary" onclick="ModalToggle('ItemPreFactorModal')">افزودن</button>
                            </div>
                        </div>
                        <div class="col-12 col-lg-5 col-xl-4 d-flex flex-column gap-1">
                            <div class="d-flex align-items-center w-100">
                                <label class="col-3 text-center">شماره سریال:</label>
                                <div class="col-9">
                                    <input class="form-control" type="text" name="serialNumber" id="serialNumber" placeholder="شماره سریال" disabled />
                                </div>
                            </div>
                            <div class="d-flex align-items-center w-100">
                                <label class="col-3 text-center">تاریخ:</label>
                                <div class="col-9">
                                    <input class="sdate form-control" type="text" name="date" id="date" placeholder="yyyy/mm/dd" data-slots="ymd" required />
                                </div>
                            </div>
                            <div class="d-flex align-items-center w-100">
                                <label class="col-3 text-center">تاریخ اعتبار:</label>
                                <div class="col-9">
                                    <input class="sdate form-control" type="text" name="validityDade" id="validityDade" placeholder="yyyy/mm/dd" data-slots="ymd" required />
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="d-none d-lg-block my-3 mx-auto" style="width: 97%;height:2px;background-color:rebeccapurple"></div>

                <div class="d-flex justify-content-between w-100 flex-column-reverse flex-xl-row">

                    <div class="col-12 col-xl-9 d-flex flex-column justify-content-between bodyPreFactorModal">

                        <div id="PreFacItemContainer" class="d-none d-lg-flex justify-content-between w-100">
                            <form id="PreFacItem" class="w-100 pf-item-form">
                                <div class="d-flex flex-column align-items-center">
                                    <div class="d-flex justify-content-between column-gap-2 w-100">
                                        <label>محصول</label>
                                        <div id="PfPrintableAlertId" class="d-flex gap-2" style="font-size:10px">
                                            <div class="d-flex align-items-center gap-1">
                                                <label for="printableF">غیر چاپدار</label>
                                                <input type="radio" name="printable" id="printableF" class="valueNumber" data-alertId="PfPrintableAlertId" value="0" required />
                                            </div>
                                            <div class="d-flex align-items-center gap-1">
                                                <label for="printableT">چاپدار</label>
                                                <input type="radio" name="printable" id="printableT" class="valueNumber" data-alertId="PfPrintableAlertId" value="1" required />
                                            </div>
                                        </div>
                                    </div>
                                    <select class="w-100 center fs-6 show-dropdown-arrow" name="productCode" id="productCode" required>
                                    </select>
                                </div>
                                <div class="d-flex flex-column align-items-center">
                                    <label>شرح کالا</label>
                                    <input class="form-control" type="text" name="product" id="product" />
                                </div>
                                <div class="d-flex flex-column align-items-center">
                                    <label>تعداد/مقدار </label>
                                    <input class="form-control" type="number" name="weightCount" min="0" id="weightCount" required />
                                </div>
                                <div class="d-flex flex-column align-items-center">
                                    <label>واحد</label>
                                    <select class="form-control valueNumber" style="width: 100%" name="unit" id="unit" required></select>
                                </div>

                                <div class="unitAmountBoxPrefactorModal" style="display:flex;flex-direction:column;align-items:center; ">
                                    <label>مبلغ واحد</label>
                                    <input inputmode="numeric" class="currencyNumber form-control inpAmount" type="text" name="unitAmount" id="unitAmount" required data-currency-hint="next" />
                                    <span class="currencyHint"></span>
                                </div>

                                <div>
                                    <label for="itemDiscount">تخفیف</label>
                                    <input inputmode="numeric" class="currencyNumber form-control inpAmount" type="text" name="discount" id="itemDiscount" value="0" autocomplete="off" data-currency-hint="next" />
                                    <span class="currencyHint"></span>
                                </div>

                                <div class="totalAmountBoxPrefactorModal">
                                    <label>مبلغ نهایی</label>
                                    <input inputmode="numeric" class="currencyNumber form-control inpAmount" type="text" name="totalAmount" id="totalAmount" disabled />
                                </div>

                                <div>
                                    <label>&nbsp;</label>
                                    <button id="AddBtnId" class="buttonPurple2 flex-center w-100 p-0" style="height: 2rem" type="button" onclick="addPfItem()">
                                        <svg style="width: 18px;height: 18px" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                                    </button>
                                    <div id="UpBtnId" style="display:none;flex-direction:column">
                                        <button class="buttonGreen3 flex-center w-100 p-0" onclick="updatePfItem()" type="button" style="height: 26px">
                                            <svg style="width: 18px;height: 18px" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                                        </button>
                                        <button class="buttonCancel2 flex-center w-100 p-0" onclick="cancelUpdatePfItem()" type="button" style="height: 26px">
                                            <svg style="width: 18px;height: 18px" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                        <div class="InfoData flex-grow-1 mt-2" style="width:100%;height:auto;min-height:60px;max-height:200px;overflow:auto;border-color:rebeccapurple;;scrollbar-color: rebeccapurple #0000;" id="preFactorItemId">
                        </div>
                        <div class="d-flex flex-column flex-lg-row align-items-center justify-content-end w-100 mt-3 amountsPreFactorModalBox">
                            <div class="d-none d-lg-block d-xl-none col-12 col-lg-6 col-xl-12 descriptionPreFactorBox">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <label for="prePaymentPercentTablet" style="font-size: 13px;line-height: 1">درصد پیش‌پرداخت:</label>
                                    <select class="form-select form-select-sm w-auto" id="prePaymentPercentTablet">
                                        <option value="30">30</option>
                                        <option value="50" selected>50</option>
                                        <option value="60">60</option>
                                        <option value="70">70</option>
                                        <option value="80">80</option>
                                        <option value="90">90</option>
                                        <option value="100">100</option>
                                    </select>
                                </div>
                                <div class="h-100 w-100 d-flex flex-column">
                                    <div class="d-flex w-100 position-relative">
                                        <textarea id="descriptionIdTablet" rows="6" class="form-control" style="height:54px;padding:4px 4px 4px 36px" type="text" placeholder="توضیحات"></textarea>
                                        <button style="position: absolute;left: 1px;bottom: 1px;display: flex;justify-content: center;align-items: center;top: 1px;padding-inline: 8px;box-shadow: none" class="buttonPurple2" onclick="addPfDescriptionItem()">
                                            <svg style="width: 18px;height: 18px" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                                        </button>
                                    </div>
                                    <div class="d-flex w-100 mt-3 flex-grow-1 pe-1 overflow-auto" style="max-height:106px;scroll-behavior:smooth;scrollbar-color: rebeccapurple #0000" id="PfactorDescIdTablet">
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-lg-6 col-xl-11 d-flex flex-column gap-1 pe-1">
                                <div class="col-12 d-flex justify-content-around">
                                    <label class="col-4 col-xl-2 text-center">جمع مبلغ کل :</label>
                                    <label class="col-8 col-xl-10 form-controlLable" name="sumTotalAmount" id="sumTotalAmount" value="0" disabled></label>
                                </div>
                                <div class="col-12 d-flex justify-content-around">
                                    <label class="col-4 col-xl-2 text-center">تخفیف :</label>
                                    <div class="col-8 col-xl-10">
                                        <input inputmode="numeric" class="form-control currencyNumber" name="discount" id="discount" type="text" value="0" onkeyup="calculatePreFactorTotals()" />
                                    </div>
                                </div>
                                <div class="col-12 d-flex justify-content-around">
                                    <label class="col-4 col-xl-2 text-center">مالیات و عوارض :</label>
                                    <label class="col-8 col-xl-10 form-controlLable" name="totalTax" id="totalTax" type="text" value="0"></label>
                                </div>
                                <div class="col-12 d-flex justify-content-around">
                                    <label class="col-4 col-xl-2 text-center">مبلغ نهایی :</label>
                                    <label class="col-8 col-xl-10 form-controlLable" name="paymentAmount" id="paymentAmount" type="text" value="0"></label>
                                </div>
                            </div>

                            <div class="d-lg-none mt-3 descriptionPreFactorBox">
                                <button class="btn btn-sm btn-secondary" onclick="ModalToggle('preFactorDescriptionModal')">افزودن توضیحات</button>
                            </div>
                        </div>
                    </div>

                    <div class="d-none d-xl-block col-12 col-xl-3 ps-3 pt-3 pt-xl-0 descriptionPreFactorBox">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <label for="prePaymentPercent" style="font-size: 13px;line-height: 1">درصد پیش‌پرداخت:</label>
                            <select class="form-select form-select-sm w-auto" id="prePaymentPercent">
                                <option value="30">30</option>
                                <option value="50" selected>50</option>
                                <option value="60">60</option>
                                <option value="70">70</option>
                                <option value="80">80</option>
                                <option value="90">90</option>
                                <option value="100">100</option>
                            </select>
                        </div>
                        <div class="h-100 w-100 d-flex flex-column">
                            <div class="w-100 d-flex position-relative">
                                <textarea id="descriptionId" rows="6" class="form-control w-100" style="height:130px;padding:4px 4px 4px 36px" type="text" placeholder="توضیحات"></textarea>
                                <button style="position: absolute;left: 1px;bottom: 1px;display: flex;justify-content: center;align-items: center;top: 1px;padding-inline: 8px;box-shadow: none" class="buttonPurple2" onclick="addPfDescriptionItem()">
                                    <svg style="width: 18px;height: 18px" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                                </button>
                            </div>
                            <div class="flex-grow-1 pe-1 w-100 d-flex mt-3 overflow-auto" style="max-height:310px;scroll-behavior:smooth;scrollbar-color: rebeccapurple #0000" id="PfactorDescId">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="my-3 mx-auto" style="width: 97%;height:2px;background-color:rebeccapurple"></div>
                <div class="d-flex justify-content-center w-100 gap-1">
                    <button class="buttonCancel2" onclick="cancelPreFactor()">انصراف</button>
                    <button class="buttonGreen3" onclick="submitPreFactor()">ثبت</button>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="_PreFactorDescriptionModal.cshtml" />
<partial name="_PreFactorItemModal.cshtml" />

