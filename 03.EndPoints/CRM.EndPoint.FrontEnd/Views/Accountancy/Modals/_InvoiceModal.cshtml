<!-- Modal Invoice -->
<div class="modal fade invoice-modal" id="InvoiceModalId" tabindex="-1" role="dialog" data-bs-focus="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content col-12" style="padding:10px!important">
            <div class="modalHeader-invoice"></div>
            <div class="modal-body pb-0" style="padding-inline: 10px">
                <div class="modalContent-invoice">
                    <form id="PayFactorFormId" class="d-flex flex-column w-100 gap-4 mt-2">
                        <div class="sectionBox-invoice">
                            <span class="sectionTitle-invoice">روش پرداخت</span>
                            <div class="d-flex justify-content-evenly flex-wrap" style="font-size:clamp(14px,2vw,19px)">

                                <div class="form-check form-check-inline">
                                    <input class="form-check-input valueNumber" type="radio" name="payType" id="NagdiId" value="1" checked>
                                    <label class="form-check-label" for="NagdiId">نقدی</label>
                                </div>

                                <div class="form-check form-check-inline">
                                    <input class="form-check-input valueNumber" type="radio" name="payType" id="ChekiId" value="2">
                                    <label class="form-check-label" for="ChekiId">چکی</label>
                                </div>

                                <div class="form-check form-check-inline" id="DivEtebariId">
                                    <input class="form-check-input valueNumber" type="radio" name="payType" id="EtebariId" value="3">
                                    <label class="form-check-label" for="EtebariId">اعتباری</label>
                                </div>

                                <div class="form-check form-check-inline me-0">
                                    <input class="form-check-input valueNumber" type="radio" name="payType" id="TahatoriId" value="4">
                                    <label class="form-check-label" for="TahatoriId">تهاتری</label>
                                </div>

                                <div class="form-check form-check-inline me-0 d-none" id="TransferRadioWrapper">
                                    <input class="form-check-input valueNumber" type="radio" name="payType" id="TransferRadioId" value="6">
                                    <label class="form-check-label" for="TransferRadioId">انتقال</label>
                                </div>
                            </div>
                        </div>

                        <div class="beneficiaryWrapper d-none sectionBox-invoice">
                            <span class="sectionTitle-invoice">بابت بدهی به</span>
                            <div>
                                <input class="form-control" name="beneficiary" type="text" placeholder="بابت بدهی به" />
                            </div>
                        </div>

                        <div class="transactionBankBox sectionBox-invoice">
                            <span class="sectionTitle-invoice">اطلاعات تراکنش بانکی</span>
                            <div class="d-flex flex-wrap row-gap-2 justify-content-center align-items-start w-100">
                                <div class="ReceiveDateDiv col-12 col-sm-6 col-lg-4 pe-sm-2 d-none">
                                    <label>تاریخ دریافت چک از مشتری</label>
                                    <input class="sdate form-control" name="reciveDate" type="text" placeholder="ثبت تاریخ" data-mask-date required />
                                </div>

                                <div class="transactionAmountWrapper col-12 col-sm-6 col-lg-4 pe-sm-2">
                                    <label>مبلغ (ریال)</label>
                                    <input inputmode="numeric" class="currencyNumber form-control inpAmount" name="reciveAmount" type="text" placeholder="مبلغ دریافتی به ریال" required data-currency-hint="next" />
                                    <span class="currencyHint"></span>
                                </div>

                                <div class="VosolDateDiv col-12 col-sm-6 col-lg-4">
                                    <label>تاریخ واریزی</label>
                                    <input class="sdate form-control" name="vosolDate" type="text" placeholder="تاریخ پرداخت" data-mask-date required />
                                </div>
                            </div>

                            <div class="toBankAccountWrapperSelect my-2 w-100">
                                <label>واریز به حساب بانکی</label>
                                <select class="form-select" name="bankAccountId" required></select>
                            </div>

                            <div class="toBankAccountWrapperTxt mb-2 d-none">
                                <label>واریز به حساب بانکی</label>
                                <input class="form-control" name="bankAccountTxt" type="text" placeholder="به کدام (حساب / شبا / کارت) واریز شده است." />
                            </div>

                            <div class="toNameWrapper d-none">
                                <label>واریز به نام</label>
                                <input class="form-control" name="toName" type="text" placeholder="نام صاحب حساب واریز شده" />
                            </div>
                        </div>

                    </form>

                    <div class="sanadPayBox sectionBox-invoice mt-4">
                        <span class="sectionTitle-invoice">رسید پرداخت</span>
                        <div class="container-uploader" id="SanadParId">
                            <input type="file" class="uploadBtn" data-varList="SanadPayList" data-showList="DivShowSanadPar" id="upSanadPay" accept="*/*" />
                            <label for="upSanadPay">
                                <svg style="width: 16px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" /></svg>
                                <span>تصویر رسید را انتخاب کنید یا اینجا رها کنید</span>
                            </label>
                            <div class="image-display" id="DivShowSanadPar"></div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="px-0 py-3 w-100">
                <div style="width:100%; height:2px; background-color:var(--DarkColor)"></div>
            </div>

            <div class="gap-1 modal-footer p-0 border-0 justify-content-center">
                <button class="buttonCancel2 m-0" onclick="closeModalInvoice()">انصراف</button>
                <button class="buttonGreen3 m-0" onclick="submitInvoice()">ثبت</button>
            </div>
        </div>
    </div>
</div>

