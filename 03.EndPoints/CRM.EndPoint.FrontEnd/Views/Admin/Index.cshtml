    .user-role-options { display:grid; grid-template-columns:repeat(auto-fit,minmax(135px,1fr)); gap:9px; max-height:45vh; overflow-y:auto; }
    .user-role-option { display:flex; align-items:center; gap:9px; min-width:0; padding:11px; border:1px solid #e1e8ef; border-radius:10px; background:#f8fafc; cursor:pointer; }
    .user-role-option:has(input:checked) { border-color:#07877d; background:#eaf7f5; color:#087e74; }
    .user-role-option input { accent-color:#07877d; flex:0 0 auto; }
    .user-role-option span { overflow-wrap:anywhere; font-size:13px; }
    .user-search-wrap > .fa-search { position:absolute; right:13px; top:50%; transform:translateY(-50%); color:#8b98a5; pointer-events:none; }
