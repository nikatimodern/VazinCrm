@section Scripts {
    <script>
        var filterDealConfig = window.filterDealConfig || {};
        var overdueDealSearchVal = null;

        document.addEventListener("DOMContentLoaded", () => {
            const loading = document.getElementById("overdueDealsLoading");
            const error = document.getElementById("overdueDealsError");
            const empty = document.getElementById("overdueDealsEmpty");
            const tableWrap = document.getElementById("overdueDealsTableWrap");
            const tableBody = document.getElementById("overdueDealsTableBody");
            const count = document.getElementById("overdueDealCount");
            const refreshButton = document.getElementById("refreshOverdueDeals");
            const dealDetailsModalElement = document.getElementById("overdueDealDetailsModal");
            const dealDetailsContent = document.getElementById("overdueDealDetailsContent");
            const dealCountsContent = document.getElementById("overdueDealCountsContent");
            const dealReportsModalElement = document.getElementById("overdueDealReportsModal");
            const dealReportsTitle = document.getElementById("overdueDealReportsModalLabel");
            const dealReportsContent = document.getElementById("overdueDealReportsContent");
            const dealReportsLoading = document.getElementById("overdueDealReportsLoading");
            const dealReportsError = document.getElementById("overdueDealReportsError");
            const dealReportsModal = window.bootstrap?.Modal
                ? new bootstrap.Modal(dealReportsModalElement)
                : null;
            let returnToDetailsAfterReports = false;
            dealReportsModalElement.addEventListener("hidden.bs.modal", () => {
                if (returnToDetailsAfterReports) {
                    returnToDetailsAfterReports = false;
                    dealDetailsModal?.show();
                }
            });
            const dealDetailsModal = window.bootstrap?.Modal
                ? new bootstrap.Modal(dealDetailsModalElement)
                : null;
            const pageSizeSelect = document.getElementById("overduePageSize");
            const pageSizeSelectTop = document.getElementById("overduePageSizeTop");
            const pagination = document.getElementById("overdueDealsPagination");
            const paginationTop = document.getElementById("overdueDealsPaginationTop");
            const paginationInfo = document.getElementById("overduePaginationInfo");
            const paginationInfoTop = document.getElementById("overduePaginationInfoTop");
            const paginationButtons = document.getElementById("overduePaginationButtons");
            const paginationButtonsTop = document.getElementById("overduePaginationButtonsTop");
            const searchInput = document.getElementById("overdueDealSearch");
            let allDeals = [];
            let currentPage = 1;
            let pageSize = 20;
            let overdueFilter = null;
            let overdueSearchVal = "";
            let sortBy = "createDate";
            let sortDirection = "desc";

            const escapeHtml = (value) => String(value ?? "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll("\"", "&quot;")
                .replaceAll("'", "&#39;");

            const formatDate = (value) => {
                if (!value) return "—";
                const date = new Date(value);
                if (Number.isNaN(date.getTime())) return "—";
                return new Intl.DateTimeFormat("fa-IR", {
                    year: "numeric", month: "2-digit", day: "2-digit",
                }).format(date);
            };

            const getWaitingDays = (value) => {
                if (!value) return 0;
                const date = new Date(value);
                if (Number.isNaN(date.getTime())) return 0;
                return Math.max(0, Math.floor((Date.now() - date.getTime()) / 86400000));
            };

            const renderCurrentPage = () => {
                const total = allDeals.length;
                const effectivePageSize = pageSize === 0 ? Math.max(total, 1) : pageSize;
                const totalPages = Math.max(1, Math.ceil(total / effectivePageSize));
                currentPage = Math.min(currentPage, totalPages);
                const startIndex = (currentPage - 1) * effectivePageSize;
                const pageDeals = allDeals.slice(startIndex, startIndex + effectivePageSize);

                tableBody.innerHTML = pageDeals.map(deal => {
                    const customerName = deal.cusCompanyName || deal.customerName || "—";
                    const waitingDays = getWaitingDays(deal.createDate);
                    return `
                        <tr>
                            <td class="text-nowrap fbold">${escapeHtml(deal.serialNumber)}</td>
                            <td>${escapeHtml(deal.title || "—")}</td>
                            <td>${escapeHtml(customerName)}</td>
                            <td class="text-nowrap">${escapeHtml(deal.customerCode ?? "—")}</td>
                            <td class="text-nowrap">${escapeHtml(formatDate(deal.createDate))}</td>
                            <td class="text-nowrap"><span class="badge text-bg-danger">${escapeHtml(new Intl.NumberFormat("fa-IR").format(waitingDays))} روز</span></td>
                            <td>${escapeHtml(deal.userCreator || "—")}</td>
                            <td style="min-width: 220px; white-space: normal;">${escapeHtml(deal.commentText || "—")}</td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm overdue-view-button" data-deal-id="${escapeHtml(deal.id)}" title="مشاهده جزئیات" aria-label="مشاهده جزئیات سفارش">
                                    <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                </button>
                            </td>
                        </tr>`;
                }).join("");

                tableWrap.classList.remove("d-none");
                pagination.classList.remove("d-none");
                const paginationText = `${new Intl.NumberFormat("fa-IR").format(total ? startIndex + 1 : 0)} تا ${new Intl.NumberFormat("fa-IR").format(Math.min(startIndex + pageDeals.length, total))} از ${new Intl.NumberFormat("fa-IR").format(total)}`;
                paginationInfo.textContent = paginationText;
                paginationInfoTop.textContent = paginationText;
                pageSizeSelect.value = String(pageSize);
                pageSizeSelectTop.value = String(pageSize);
                paginationTop.classList.remove("d-none");

                paginationButtons.innerHTML = "";
                paginationButtonsTop.innerHTML = "";
                const addPageButton = (label, page, disabled = false, active = false) => {
                    const li = document.createElement("li");
                    li.className = "page-item" + (disabled ? " disabled" : "") + (active ? " active" : "");
                    const button = document.createElement("button");
                    button.type = "button";
                    button.className = "page-link";
                    button.textContent = label;
                    button.disabled = disabled;
                    button.addEventListener("click", () => {
                        currentPage = page;
                        renderCurrentPage();
                    });
                    li.appendChild(button);
                    paginationButtons.appendChild(li);
                    const topLi = li.cloneNode(true);
                    const topButton = topLi.querySelector("button");
                    topButton.addEventListener("click", () => {
                        currentPage = page;
                        renderCurrentPage();
                    });
                    paginationButtonsTop.appendChild(topLi);
                };

                addPageButton("قبلی", Math.max(1, currentPage - 1), currentPage === 1);
                const first = Math.max(1, currentPage - 2);
                const last = Math.min(totalPages, currentPage + 2);
                for (let page = first; page <= last; page++) {
                    addPageButton(new Intl.NumberFormat("fa-IR").format(page), page, false, page === currentPage);
                }
                addPageButton("بعدی", Math.min(totalPages, currentPage + 1), currentPage === totalPages);

                tableBody.querySelectorAll(".overdue-view-button").forEach(button => {
                    button.addEventListener("click", () => {
                        const deal = pageDeals.find(item => String(item.id).toLowerCase() === button.dataset.dealId.toLowerCase());
                        if (!deal) return;

                        const hasCustomer = deal.hasCustomer === true;
                        const moneyFormat = value => new Intl.NumberFormat("fa-IR", {
                            maximumFractionDigits: 0,
                        }).format(Number(value ?? 0));
                        const debtAmount = Number(deal.debtAmount ?? 0) + Number(deal.returnedAmount ?? 0);
                        const cashReceived = Number(deal.receivableAmount ?? 0);
                        const remainingReceivable = Math.max(0, debtAmount - cashReceived);
                        const counts = [
                            {
                                label: "گزارش‌های ثبت‌شده",
                                value: deal.reportCount,
                                color: "#4c1d95",
                                icon: "<path d=\"M7 3h10a2 2 0 0 1 2 2v14l-7-3-7 3V5a2 2 0 0 1 2-2Z\"/>",
                            },
                            {
                                label: "پیش‌فاکتورهای صادرشده",
                                value: deal.preFactorCount,
                                color: "#0f766e",
                                icon: "<path d=\"M7 3h10a2 2 0 0 1 2 2v14l-7-3-7 3V5a2 2 0 0 1 2-2Z\"/><path d=\"M9 8h6M9 11h6\"/>",
                            },
                            {
                                label: "فاکتورها",
                                value: deal.factorCount,
                                color: "#4c1d95",
                                icon: "<path d=\"M6 2h9l4 4v16H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Z\"/><path d=\"M14 2v5h5M8 12h8M8 16h8\"/>",
                            },
                            {
                                label: "صورت‌حساب‌های مشتری",
                                value: hasCustomer ? deal.accountancyCount : "—",
                                color: "#0f766e",
                                icon: "<path d=\"M5 3h14v18H5z\"/><path d=\"M8 7h8M8 11h8M8 15h5\"/>",
                            },
                            {
                                label: "مجموع بدهکاری",
                                value: hasCustomer ? moneyFormat(debtAmount) + " ریال" : "بدون مشتری",
                                color: "#b45309",
                                icon: "<path d=\"M12 5v14M5 12h14\"/>",
                            },
                            {
                                label: "مانده طلب از مشتری",
                                value: hasCustomer ? moneyFormat(remainingReceivable) + " ریال" : "بدون مشتری",
                                color: "#be123c",
                                icon: "<path d=\"M4 7h16M6 3h12v18H6z\"/><path d=\"M9 12h6\"/>",
                            },
                        ];
                        dealCountsContent.innerHTML = counts.map(item => `
                            <div class="col-12 col-md-4 col-xl-2">
                                <div class="overdue-count-card ${Number(item.value) > 0 && ["گزارش‌های ثبت‌شده", "پیش‌فاکتورهای صادرشده", "فاکتورها"].includes(item.label) ? "overdue-document-card" : "overdue-count-card-disabled"}"
                                     data-document-kind="${item.label === "گزارش‌های ثبت‌شده" ? "reports" : item.label === "پیش‌فاکتورهای صادرشده" ? "prefactors" : item.label === "فاکتورها" ? "factors" : ""}"
                                     ${Number(item.value) > 0 && ["گزارش‌های ثبت‌شده", "پیش‌فاکتورهای صادرشده", "فاکتورها"].includes(item.label) ? 'role="button" tabindex="0" title="برای مشاهده موارد کلیک کنید"' : 'aria-disabled="true"'}>
                                    <div class="count-icon" style="color:${item.color}">
                                        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${item.icon}</svg>
                                    </div>
                                    <div class="count-value" style="font-size:1.25rem">${escapeHtml(item.value ?? 0)}</div>
                                    <div class="count-label">${escapeHtml(item.label)}</div>
                                </div>
                            </div>`).join("");

                        const openDocumentModal = async (kind) => {
                            if (kind === "prefactors") {
                                const preFactorDeal = {
                                    id: deal.id,
                                    serialNumber: deal.serialNumber,
                                    customerId: deal.customerId,
                                    customerName: deal.customerName,
                                    customerCode: deal.customerCode,
                                    mobileNumber: deal.mobileNumber,
                                    userCreatorID: deal.userCreatorID,
                                    financialStatus: deal.financialStatus
                                };
                                showModalDealPreFactors(preFactorDeal);
                                // dealDetailsModalElement.addEventListener("hidden.bs.modal", () => {
                                    
                                // }, { once: true });
                                //dealDetailsModal?.hide();
                                return;
                            }

                            const isReports = kind === "reports";
                            const titleByKind = {
                                reports: "گزارش‌های ثبت‌شده سفارش",
                                prefactors: "پیش‌فاکتورهای سفارش",
                                factors: "فاکتورهای سفارش"
                            };
                            dealReportsTitle.textContent = titleByKind[kind] || "جزئیات سفارش";
                            dealReportsContent.innerHTML = "";
                            dealReportsError.classList.add("d-none");
                            dealReportsLoading.classList.remove("d-none");
                            returnToDetailsAfterReports = true;
                            dealDetailsModalElement.addEventListener("hidden.bs.modal", () => dealReportsModal?.show(), { once: true });
                            dealDetailsModal?.hide();

                            try {
                                if (isReports) {
                                    const response = await axios.post(
                                        `/Report/GetAllReportPartial?dealId=${encodeURIComponent(deal.id)}`,
                                        { filt: null, serVal: null, _type: -1, Count: -1 }
                                    );
                                    dealReportsContent.innerHTML = response.data?.html || "";
                                    if (!response.data?.html) {
                                        dealReportsContent.textContent = "گزارشی برای این سفارش ثبت نشده است.";
                                    }
                                } else {
                                    const response = await axios.get("/OverdueDeal/GetDealFactors", { params: { dealId: deal.id } });
                                    const items = response.data?.data || [];
                                    if (!items.length) {
                                        dealReportsContent.innerHTML = '<div class="text-center text-muted py-4">موردی برای این سفارش ثبت نشده است.</div>';
                                    } else {
                                        const money = value => new Intl.NumberFormat("fa-IR", { maximumFractionDigits: 0 }).format(Number(value ?? 0));
                                        dealReportsContent.innerHTML = `
                                            <div class="d-flex flex-column gap-2">
                                                ${items.map(item => {
                                                    const serial = escapeHtml(item.serialNumber ?? "—");
                                                    const date = escapeHtml(item.date ?? "—");
                                                    const customer = escapeHtml([item.customer, item.agentName].filter(Boolean).join(" - ") || "—");
                                                    const amount = money(item.sumTotalAmountTax ?? (Number(item.sumTotalAmount ?? 0) + Number(item.totalTax ?? 0)));
                                                    const status = escapeHtml(item.statusTxt ?? "—");
                                                    const currency = escapeHtml(item.currencyTypeTxt || "ریال");
                                                    const badge = item.officialType === 1 ? "رسمی" : "غیررسمی";
                                                    return `
                                                        <div class="d-flex w-100 overdue-prefactor-row" dir="rtl">
                                                            <div class="${item.officialType === 1 ? "InfoDataHead_PrefactorRasmi" : "InfoDataHead_PrefactorNonRasmi"} overdue-prefactor-side">
                                                                <span class="overdue-prefactor-side-text">${badge}</span>
                                                            </div>
                                                            <article class="InfoDataItem_Prefactor overdue-prefactor-card flex-grow-1 w-100">
                                                                <div class="overdue-prefactor-main">
                                                                    <div class="overdue-prefactor-meta">
                                                                        <div><span>سریال:</span><strong>${serial}</strong></div>
                                                                        <div><span>تاریخ:</span><strong>${date}</strong></div>
                                                                        ${item.pfactorSerialNumber ? `<div><span>شماره پیش‌فاکتور:</span><strong>${escapeHtml(item.pfactorSerialNumber)}</strong></div>` : ""}
                                                                    </div>
                                                                    <div class="overdue-prefactor-financial">
                                                                        <div><span>مبلغ:</span><strong>${amount} <small>${currency}</small></strong></div>
                                                                        <div><span>دریافتی:</span><strong>${money(item.reciveAmount)} <small>${currency}</small></strong></div>
                                                                        <div><span>مانده:</span><strong>${money(item.paymentAmount)} <small>${currency}</small></strong></div>
                                                                    </div>
                                                                    <div class="overdue-prefactor-customer">
                                                                        <div><span>مشتری:</span><strong>${customer}</strong></div>
                                                                        <div><span>وضعیت:</span><strong>${status}</strong></div>
                                                                    </div>
                                                                </div>
                                                            </article>
                                                            <div class="overdue-prefactor-actions" aria-label="ابزارهای سند">
                                                                <button type="button" title="نمایش" aria-label="نمایش" onclick="ShowPreviewFactor('${escapeHtml(item.id)}')"><i class="fa fa-eye"></i></button>
                                                                <button type="button" title="ویرایش" aria-label="ویرایش" onclick="upFactor('${escapeHtml(item.id)}', 0)"><i class="fa fa-pencil"></i></button>
                                                                <button type="button" title="حذف" aria-label="حذف" onclick="deleteFactor('${escapeHtml(item.id)}', 0)"><i class="fa fa-trash"></i></button>
                                                                <button type="button" title="پیوست‌ها" aria-label="پیوست‌ها" onclick="showAttachments('${escapeHtml(item.id)}', 3)"><i class="fa fa-paperclip"></i></button>
                                                                <button type="button" title="تاریخچه" aria-label="تاریخچه" onclick="showLogEntity('Factor', '${escapeHtml(item.id)}')"><i class="fa fa-history"></i></button>
                                                            </div>
                                                        </div>`;
                                                }).join("")}
                                            </div>`;
                                    }
                                }
                            } catch (error) {
                                console.error("Failed to load order documents:", error);
                                dealReportsError.textContent = "دریافت اطلاعات با خطا مواجه شد. لطفاً دوباره تلاش کنید.";
                                dealReportsError.classList.remove("d-none");
                            } finally {
                                dealReportsLoading.classList.add("d-none");
                            }
                        };

                        dealCountsContent.querySelectorAll(".overdue-document-card").forEach(card => {
                            const kind = card.dataset.documentKind;
                            const activate = () => openDocumentModal(kind);
                            card.addEventListener("click", activate);
                            card.addEventListener("keydown", event => {
                                if (event.key === "Enter" || event.key === " ") {
                                    event.preventDefault();
                                    activate();
                                }
                            });
                        });

                        const details = [
                            ["شماره سفارش", deal.serialNumber], ["عنوان سفارش", deal.title],
                            ["نام مشتری", deal.customerName], ["نام شرکت", deal.cusCompanyName],
                            ["کد مشتری", deal.customerCode], ["موبایل", deal.mobileNumber],
                            ["تاریخ ثبت", formatDate(deal.createDate)],
                            ["مدت انتظار", new Intl.NumberFormat("fa-IR").format(getWaitingDays(deal.createDate)) + " روز"],
                            ["ثبت‌کننده", deal.userCreator], ["توضیحات", deal.commentText],
                        ];
                        dealDetailsContent.innerHTML = details.map(([label, value]) => `
                            <div class="overdue-detail-cell ${label === "توضیحات" ? "overdue-detail-comment" : ""}" title="${escapeHtml(value || "—")}">
                                <span class="overdue-detail-label">${escapeHtml(label)}:</span>
                                <span class="overdue-detail-value">${escapeHtml(value || "—")}</span>
                            </div>`).join("");
                        dealDetailsModal?.show();
                    });
                });
            };

            window.callbackFilterOverdueDeal = async () => {
                overdueFilter = window.filterDealConfig?.filterVar ?? null;
                overdueSearchVal = window.filterDealConfig?.varSearch ?? searchInput.value.trim();
                searchInput.value = overdueSearchVal || "";
                currentPage = 1;
                await loadOverdueDeals();
            };

            const loadOverdueDeals = async () => {
                loading.classList.remove("d-none");
                error.classList.add("d-none");
                empty.classList.add("d-none");
                tableWrap.classList.add("d-none");
                tableBody.innerHTML = "";
                refreshButton.disabled = true;

                try {
                    const requestModel = { filt: overdueFilter, serVal: searchInput.value.trim() || null };
                    const response = await axios.post("/OverdueDeal/GetOverdueDeals", requestModel, {
                        params: { sortBy, sortDirection },
                    });
                    allDeals = response.data?.data ?? [];
                    updateSortIndicators();
                    count.textContent = new Intl.NumberFormat("fa-IR").format(allDeals.length);
                    currentPage = Math.min(currentPage, Math.max(1, Math.ceil(allDeals.length / (pageSize || Math.max(allDeals.length, 1)))));

                    if (allDeals.length === 0) {
                        pagination.classList.add("d-none");
                        paginationTop.classList.add("d-none");
                        empty.classList.remove("d-none");
                        return;
                    }

                    renderCurrentPage();
                } catch (err) {
                    console.error("Failed to load overdue deals:", err);
                    error.textContent = err.response?.status === 403
                        ? "شما مجوز مشاهده این اطلاعات را ندارید."
                        : "دریافت سفارشات معوقه با خطا مواجه شد. لطفاً دوباره تلاش کنید.";
                    error.classList.remove("d-none");
                } finally {
                    loading.classList.add("d-none");
                    refreshButton.disabled = false;
                }
            };

            const updateSortIndicators = () => {
                document.querySelectorAll(".overdue-sort-button").forEach(button => {
                    const active = button.dataset.sortBy.toLowerCase() === sortBy.toLowerCase();
                    button.setAttribute("aria-sort", active
                        ? (sortDirection === "asc" ? "ascending" : "descending")
                        : "none");
                    const indicator = button.querySelector(".sort-indicator");
                    if (indicator) indicator.textContent = active
                        ? (sortDirection === "asc" ? "↑" : "↓")
                        : "↕";
                });
            };

            document.querySelectorAll(".overdue-sort-button").forEach(button => {
                button.addEventListener("click", () => {
                    const selectedSort = button.dataset.sortBy;
                    if (sortBy.toLowerCase() === selectedSort.toLowerCase()) {
                        sortDirection = sortDirection === "asc" ? "desc" : "asc";
                    } else {
                        sortBy = selectedSort;
                        sortDirection = "asc";
                    }
                    currentPage = 1;
                    loadOverdueDeals();
                });
            });

            const onPageSizeChange = (value) => {
                pageSize = Number(value);
                currentPage = 1;
                if (allDeals.length) renderCurrentPage();
            };
            pageSizeSelect.addEventListener("change", () => onPageSizeChange(pageSizeSelect.value));
            pageSizeSelectTop.addEventListener("change", () => onPageSizeChange(pageSizeSelectTop.value));
            refreshButton.addEventListener("click", loadOverdueDeals);
            loadOverdueDeals();
        });
    </script>
    <script src="~/js/deal/deal-documents.js" asp-append-version="true"></script>
}
