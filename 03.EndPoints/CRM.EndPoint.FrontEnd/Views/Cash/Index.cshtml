        // ۵. تنظیم اولیه بر اساس رول کاربر (پس از لود شدن کامل صفحه)
        $(document.ready || function (f) {
            f();
        })(function () {
            // تابع اصلی کدهای دیتاتیبل قبلی خودت را صدا می‌زنیم
            getAllCashesDt();

            // اگر کاربر مالی بود، دیفالت روی گروهی تنظیم شود
            if (typeof isManager !== "undefined" && isManager) {
                switchView("groups");
            }


        });
        // ۴. توابع تایید و رد کامل گروه از داخل مودال
        async function approveCurrentGroup() {
            if (!currentSelectedGroupId) return;

            // ارسال ریکوئست به بک‌اند برای تایید گروهی
            const response = await changeStatusGroupCashToApproved(currentSelectedGroupId);
            if (response.isSuccess) {
                bootstrap.Modal.getInstance(document.getElementById("cashGroupDetailModal")).hide();
                cashGroupTbl.ajax.reload(null, false); // ریلود جدول اصلی
            }

        }

    </script>
