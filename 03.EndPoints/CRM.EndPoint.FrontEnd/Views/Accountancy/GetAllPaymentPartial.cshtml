@using CRM.EndPoint.FrontEnd.Models.Payment;
@using CRM.Core.Domain.Accountancies.Enum

@model PaymentPartialVModel

@if (Model.Items.Any()) {
    var fromCartableFinancial = Model.PassType == 55 || Model.PassType == 56;
    var fromFinancial = Model.PassType == 5 || fromCartableFinancial;
    <table id="@($"allPaymentTable{Model.PassType}")" class="paymentTable table table-striped table-bordered table-hover no-footer nowrap">
        <thead>
        <tr>
            <th>شماره ثبت</th>
            <th>تاریخ ثبت</th>
            @if (fromCartableFinancial) {
                <th>مشتری</th>
                <th>پیش‌فاکتور</th>
            }
            <th>نوع</th>
            <th>مبلغ</th>
            <th>تاریخ واریز</th>
            <th>ثبت توسط</th>
            <th>عملیات</th>
            <th>وضعیت</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items.OrderByDescending(f => f.CreateDate)) {
            var isCreator = item.UserCreatorID == Model.UserId;

            <tr class="@((item.PayType == PayTypeEnum.اعتباری || item.PayType == PayTypeEnum.چکی) && item.Vosoled ? "payment-vosoled" : "")">
                <td>@item.SerialNum</td>
                <td>@string.Join(" | ", item.CreateDateTxt?.Substring(0, 16).Split(' ').Reverse())</td>
                @if (fromCartableFinancial) {
                    <td class="wrap-text">@item.CustomerName</td>
                    <td>@item.pfSerialNumber</td>
                }
                <td>
                    <span>@item.PayTypeTxt</span>
                    @if (item.AccType == AcEnum.برگشتی) {
                        <span style="color: darkred">(@item.AccTypeTxt)</span>
                    }
                </td>
                <td class="fbold">
                    @($"{(item.AccType == AcEnum.برگشتی ? item.BackWard : item.credit):n0}")
                    <span style="font-size: 11px"> ریال</span>
                </td>
                <td>@item.VosolDate</td>
                <td>@item.UserCreator</td>
                <td>
                    <span class="d-inline-flex flex-column align-items-center justify-content-center gap-2">

                        @{
                            var canManage = isCreator || Model.IsCreatorParent || Model.IsAdmin || Model.IsSalesAdmin;
                            var canViewActions = canManage || Model.IsFinancial;
                            var canEdit = item.Status is AccStatusEnum.ثبت_اولیه or AccStatusEnum.رد_شده;

                            var canVosol = item.Status == AccStatusEnum.تایید_شده &&
                                             (item.PayType == PayTypeEnum.اعتباری || item.PayType == PayTypeEnum.چکی) &&
                                             !item.Vosoled && item.IsTransferred != true;

                            var canTransfer = Model.IsFinancial &&
                                              item.Status == AccStatusEnum.تایید_شده &&
                                              item.PayType == PayTypeEnum.چکی &&
                                              !item.Vosoled && item.IsTransferred != true;
                        }

                        <span class="inline-flex-center flex-column gap-2">
                            @if (Model.IsCustomer) {
                                <button class="inline-flex-center" data-title-right="پیوست ها" style="color:var(--DarkColor)" onclick="showAttachments('@item.Id')">
                                    <i class="fa fa-paperclip"></i>
                                </button>
                            } else if (fromFinancial && !isCreator) {
                                <button class="buttonGray" onclick="showPayment('@item.Id')">مشاهده</button>
                            } else if (canViewActions) {
                                <span class="inline-flex-center gap-2">
                                    @if (canManage) {
                                        if (canEdit) {
                                            <button class="inline-flex-center" data-title-right="حذف" style="color:var(--DarkColor)" onclick="delPayment('@item.Id', '@item.DealId')">
                                                <i class="fa fa-trash"></i>
                                            </button>

                                            <button class="inline-flex-center" data-title-right="ویرایش" style="color:var(--DarkColor)" onclick="ShowEditModalInvoice('@item.Id', 1)">
                                                <i class="fa fa-pencil"></i>
                                            </button>

                                            <button class="inline-flex-center" data-title-right="پیوست ها" style="color:var(--DarkColor)" onclick="showAttachments('@item.Id')">
                                                <i class="fa fa-paperclip"></i>
                                            </button>
                                        } else {
                                            <button class="buttonGray" onclick="showPayment('@item.Id')">مشاهده</button>
                                        }
                                    }

                                    @if (canVosol) {
                                        <button class="buttonBlue2" style="padding: 2px 6px !important" onclick="ShowVosolInvoiceModal('@item.Id', '@item.pfid', @((int)item.InvoiceType))">
                                            وصول
                                        </button>
                                    }

                                </span>
                            } else {
                                <button class="buttonGray" onclick="showPayment('@item.Id')">مشاهده</button>
                            }
                        </span>
                    </span>
                </td>
                <td>
                    <span class="paymentTable-statusCol inline-flex-center gap-2">
                        @if (!Model.IsCustomer && !string.IsNullOrEmpty(item.CommentText)) {
                            <span data-bs-toggle="popover" data-bs-title="توضیحات" data-bs-content="@Html.Raw(item.CommentText)">
                                <svg style="width: 20px" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" /></svg>
                            </span>
                        }

                        @* <span class="d-inline-flex gap-2 align-items-center flex-wrap"> *@
                        @switch (item.Status) {
                            case AccStatusEnum.ثبت_اولیه:
                                if (!fromFinancial
                                    && (isCreator || Model.IsCreatorParent || Model.IsAdmin || Model.IsSalesAdmin)) {
                                    <button class="buttonGreen2" onclick="changeStatusAcc('@item.Id')">ارسال به مالی</button>
                                } else {
                                    <span class="fbold" style="color:#777">در دست ارسال</span>
                                }

                                break;

                            case AccStatusEnum.در_دست_تایید:
                                if (
                                    fromFinancial
                                    && (Model.IsAdmin ||
                                        (Model.IsFinancial && (item.PayType == PayTypeEnum.نقدی || item.PayType == PayTypeEnum.چکی)) ||
                                        ((Model.IsManagingDirector || Model.IsTamin) && item.PayType == PayTypeEnum.تهاتری) ||
                                        (Model.IsManagingDirector && item.PayType == PayTypeEnum.اعتباری)
                                    )
                                ) {
                                    <button class="buttonCancel3 btn-accept" style="min-width: 28px" onclick="showModalNotAccept('@item.Id', 0)">رد</button>
                                    <button class="buttonGreen2 btn-accept" onclick="acceptAccountancy('@item.Id', @((int)AccStatusEnum.تایید_شده))">تایید</button>
                                } else {
                                    <span class="fbold" style="color: #CC9900">در دست تایید</span>
                                }

                                break;
                            case AccStatusEnum.تایید_شده:
                                if (!Model.IsCustomer && !string.IsNullOrEmpty(item.AcceptedUser)) {
                                    var text = "تایید شده توسط " + item.AcceptedUser;
                                    <span data-bs-toggle="popover" data-bs-content="@Html.Raw(text)">
                                        <svg style="width: 14px;color: #666" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M15 8A7 7 0 1 1 1 8a7 7 0 0 1 14 0ZM9 5a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM6.75 8a.75.75 0 0 0 0 1.5h.75v1.75a.75.75 0 0 0 1.5 0v-2.5A.75.75 0 0 0 8.25 8h-1.5Z" clip-rule="evenodd" /></svg>
                                    </span>
                                }

                                if ((item.PayType == PayTypeEnum.اعتباری || item.PayType == PayTypeEnum.چکی) && item.Vosoled) {
                                    <span class="fbold hoverLink" style="color:#0074bb" onclick="showPayment('@item.Id', true)">وصول شده</span>
                                } else {
                                    <span class="fbold" style="color:darkgreen">تایید شده</span>
                                    if (
                                        fromFinancial
                                        && (Model.IsAdmin ||
                                            (Model.IsFinancial && (item.PayType == PayTypeEnum.نقدی || item.PayType == PayTypeEnum.چکی)) ||
                                            ((Model.IsManagingDirector || Model.IsTamin) && item.PayType == PayTypeEnum.تهاتری) ||
                                            (Model.IsManagingDirector && item.PayType == PayTypeEnum.اعتباری)
                                        )
                                    ) {
                                        <span style="cursor:pointer;color:#333" onclick="acceptAccountancy('@item.Id', @((int)AccStatusEnum.در_دست_تایید))" data-title-right="بازگشت">
                                            <svg style="width:16px" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m15 15 6-6m0 0-6-6m6 6H9a6 6 0 0 0 0 12h3" /></svg>
                                        </span>
                                    }
                                }

                                break;
                            case AccStatusEnum.رد_شده:
                                <span class="fbold" style="color:darkred">رد شده</span>
                                if (!fromFinancial && (isCreator || Model.IsCreatorParent || Model.IsAdmin || Model.IsSalesAdmin)) {
                                    <button class="buttonGreen2" onclick="changeStatusAcc('@item.Id')">ارسال به مالی</button>
                                }

                                break;
                        }
                        @* </span> *@
                    </span>

                </td>
            </tr>
        }
        </tbody>
    </table>
} else {
    <div style="margin:0 auto 16px; width:100%; height:2px; background-color:rgba(0, 0, 0, 0.4);"></div>
    <div style="display:flex;justify-content:center;width:100%;text-align:center;align-items:center">
        <div class="mb-0 py-2" style="font-size:clamp(18px, 2vw, 22px)">هیچ صورت‌حسابی یافت نشد.</div>
    </div>
}