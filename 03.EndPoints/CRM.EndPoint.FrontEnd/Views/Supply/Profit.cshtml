@{
    ViewBag.Title = "Index";
    Layout = "_Layout";
}

<div>
    <div style="border-radius:10px;width:99%;">
        <table style=" width:100%" class="table table-striped table-hover nowrap" id="supplyProfitTable">
            <thead>
            <tr>
                <th>ردیف</th>
                <th>شماره سفارش</th>
                <th>عنوان سفارش</th>
                <th>تاریخ سفارش</th>
                <th>کارشناس فروش</th>
                <th>کارشناس تامین</th>
                <th>بهای تمام شده</th>
                <th>مبلغ فروش فاکتور</th>
                <th>سود ناویژه عملیاتی</th>
                <th>درصد سود</th>
                @* <th>پیش‌فاکتور</th> *@
                @* <th>مشتری</th> *@
                @* <th>تامین کننده ها</th> *@
            </tr>
            </thead>
            <tbody>
            </tbody>
            <tfoot class="fbold">
            <tr>
                <td>جمع کل</td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td style="direction: ltr"></td>
                <td style="direction: ltr"></td>
                <td style="direction: ltr"></td>
            </tr>
            </tfoot>
        </table>
    </div>
</div>



@*<div>
    <h4 class="mb-4 fbold border-bottom pb-2">تامین‌کنندگان و محصولات مرتبط</h4>
    <div id="SupplierContainer" class="w-100 d-grid gap-2" style="grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));grid-auto-rows: minmax(150px, auto);">
    </div>
</div>*@

<partial name="Modals/_SuppliesDetailsModal" />
<partial name="~/Views/Factor/Modals/_FactorContainerModal.cshtml" />
<partial name="~/Views/Accountancy/Modals/_InvoiceListModal.cshtml" />

@section scripts {
    <script data-page-bindings="supplyProfitTBL,supplyProfitConfigFilter,modelSupplyProfit,getAllSupplyProfit,showFactors,showSupplies,getAllSuppliesDetails,initSuppliesDataTable,callBackSupplyProfitFilter">
        /*document.addEventListener("DOMContentLoaded", async () => {
            await getGroupedOrdersBySupplier();
        });


        async function getGroupedOrdersBySupplier() {
            const res = await axios(`/Supply/GetGroupedOrdersBySupplier`);

            if (res.status === 200) {
                const supplierContainer = document.getElementById("SupplierContainer");
                supplierContainer.innerHTML = res.data;
            }
        }*/

        let supplyProfitTBL;
        var supplyProfitConfigFilter = {};
        let modelSupplyProfit = { serVal: null, filt: null, _type: -1 };
        document.addEventListener("DOMContentLoaded", async () => {
            getAllSupplyProfit();
        });

        const getAllSupplyProfit = () => {
            supplyProfitTBL = $("#supplyProfitTable").DataTable({
                pageLength: 10,
                lengthMenu: [5, 10, 20, 50, 100, { label: "همه", value: -1 }],
                processing: true,
                serverSide: true,
                searching: true,
                search: {
                    return: true,
                },
                ordering: true,
                order: [[3, "desc"]],
                scrollCollapse: true,
                scrollY: "70dvh",
                responsive: true,
                ajax: {
                    url: `/Supply/GetSuppliesProfitDt`,
                    type: "POST",
                    data: (d) => {
                        d.model = JSON.stringify(modelSupplyProfit);
                    },
                },
                language: languageDatatable,
                columnDefs: [
                    /*{
                        targets: 1,
                        render: (data, type, row) => `<span class="hoverLink" onclick="ShowPreviewPfactor('${row.pfId}')">${data}</span>`,
                    },*/
                    /*{
                        targets: 2,
                        render: (data, type, row) => `
                          <span class="hoverLink" onclick="openCustomerProfile('${row.customerId}')">
                            ${data} (${row.customerCode})
                          </span>
                        `,
                    },*/

                    /*{
                        targets: 2,
                        render: data => data.join(" / ") || "-",
                    },*/
                    {
                        targets: [6],
                        render: (data, type, row) => data ? `<span dir="ltr" class="hoverLink main-font" onclick="showSupplies('${row.dealId}')">${data.toLocaleString()}</span>` : "-",
                    },
                    {
                        targets: [7],
                        render: (data, type, row) => data ? `<span dir="ltr" class="hoverLink main-font" onclick="showFactors('${row.dealId}')">${data.toLocaleString()}</span>` : "-",
                    },
                    {
                        targets: 8,
                        render: (data) => {
                            return data !== -1
                                ? `<span dir="ltr" class="fbold" style="color: ${data <= 0 ? "darkred" : "darkgreen"};font-size: 16px">${data.toLocaleString()}</span>`
                                : `<i class="fMedium" style="color: #333">ثبت نشده</i>`;
                        },
                    },
                    {
                        targets: 9,
                        render: (data) => {
                            return data !== null
                                ? `<span dir="ltr" class="fMedium" style="color: ${data <= 0 ? "darkred" : "darkgreen"};font-size: 16px">${data}%</span>`
                                : "-";
                        },
                    },
                    {
                        targets: [0, 1, 2, 4, 5],
                        orderable: false,
                    },

                ],
                columns: [
                    { data: null, render: (data, type, row, meta) => meta.row + 1 },
                    { data: "dealSerialNumber", name: "DealSerialNumber", defaultContent: "-" },
                    { data: "dealTitle", name: "DealTitle", defaultContent: "-", visible: true },
                    { data: "dealDate", name: "DealDate", defaultContent: "-" },
                    { data: "userCreatorDeal", name: "UserCreatorDeal", defaultContent: "-" },
                    { data: "userTaminTxt", name: "UserTaminTxt", defaultContent: "-" },
                    { data: "totalSuppliesAmount", name: "TotalSuppliesAmount", defaultContent: "-" },
                    { data: "totalFactorsAmount", name: "TotalFactorsAmount", defaultContent: "-" },
                    { data: "profit", name: "Profit", defaultContent: "-" },
                    { data: "profitPercent", name: "ProfitPercent", defaultContent: "-" },
                    // { data: "pfSerialNumber", name: "PfSerialNumber", defaultContent: "-" },
                    // { data: "customerName", name: "CustomerName", defaultContent: "-" },
                    // { data: "suppliersNameList", name: "SuppliersNameList" },
                ],

                layout: {
                    bottomEnd: "info",
                    bottomStart: {
                        paging: {
                            type: "simple_numbers",
                        },
                    },
                    topEnd: {
                        pageLength: true,
                        buttons: [
                            {
                                extend: "excel",
                                text: `<svg fill="currentColor" viewBox="0 0 256 256"><path d="M156,208a8,8,0,0,1-8,8H120a8,8,0,0,1-8-8V152a8,8,0,0,1,16,0v48h20A8,8,0,0,1,156,208ZM92.65,145.49a8,8,0,0,0-11.16,1.86L68,166.24,54.51,147.35a8,8,0,1,0-13,9.3L58.17,180,41.49,203.35a8,8,0,0,0,13,9.3L68,193.76l13.49,18.89a8,8,0,0,0,13-9.3L77.83,180l16.68-23.35A8,8,0,0,0,92.65,145.49Zm98.94,25.82c-4-1.16-8.14-2.35-10.45-3.84-1.25-.82-1.23-1-1.12-1.9a4.54,4.54,0,0,1,2-3.67c4.6-3.12,15.34-1.72,19.82-.56a8,8,0,0,0,4.07-15.48c-2.11-.55-21-5.22-32.83,2.76a20.58,20.58,0,0,0-8.95,14.95c-2,15.88,13.65,20.41,23,23.11,12.06,3.49,13.12,4.92,12.78,7.59-.31,2.41-1.26,3.33-2.15,3.93-4.6,3.06-15.16,1.55-19.54.35A8,8,0,0,0,173.93,214a60.63,60.63,0,0,0,15.19,2c5.82,0,12.3-1,17.49-4.46a20.81,20.81,0,0,0,9.18-15.23C218,179,201.48,174.17,191.59,171.31ZM40,112V40A16,16,0,0,1,56,24h96a8,8,0,0,1,5.66,2.34l56,56A8,8,0,0,1,216,88v24a8,8,0,1,1-16,0V96H152a8,8,0,0,1-8-8V40H56v72a8,8,0,0,1-16,0ZM160,80h28.68L160,51.31Z"></path></svg>`,
                                titleAttr: "اکسل",
                                title: "بهای تمام شده",
                                className: "buttonExcel",
                            },
                            "spacer",
                            {
                                extend: "print",
                                text: `<svg style="color:#fff;width:76%" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0 1 10.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0 .229 2.523a1.125 1.125 0 0 1-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0 0 21 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 0 0-1.913-.247M6.34 18H5.25A2.25 2.25 0 0 1 3 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 0 1 1.913-.247m10.5 0a48.536 48.536 0 0 0-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.659M18 10.5h.008v.008H18V10.5Zm-3 0h.008v.008H15V10.5Z" /></svg>`,
                                titleAttr: "چاپ",
                                title: "بهای تمام شده",
                                className: "buttonPrint",
                                // autoPrint: false,
                            },
                        ],
                    },
                    topStart: {
                        search: {
                            placeholder: "جستجو",
                        },
                    },
                },
                // colReorder: false,
                footerCallback: function () {
                    let api = this.api();
                    let json = api.ajax.json();

                    let totalSuppliesAmountAll = json.totals.totalSuppliesAmountAll.toLocaleString();
                    let totalFactorsAmountAll = json.totals.totalFactorsAmountAll.toLocaleString();
                    let profitAll = json.totals.profitAll.toLocaleString();

                    /*let colIndex5 = api.colReorder.transpose(5);
                    let colIndex6 = api.colReorder.transpose(6);
                    let colIndex7 = api.colReorder.transpose(7);*/

                    api.column(6).footer().innerHTML = `<span>${totalSuppliesAmountAll}</span>`;
                    api.column(7).footer().innerHTML = `<span>${totalFactorsAmountAll}</span>`;
                    api.column(8)
                       .footer().innerHTML = `<span style="color: ${profitAll <= 0 ? "darkred" : "darkgreen"};font-size: 16px">${profitAll}</span>`;
                },
                initComplete: () => initFilterSupplyTable(),
            });

            function initFilterSupplyTable() {
                const dtSearch = document.querySelector(".dt-search");
                const searchInput = dtSearch.querySelector("input");
                if (!searchInput) return;
                const filterButton = `
                    <div class="btnFilter pe-md-2" data-filterVarConfig="supplyProfitConfigFilter" data-filterCallBack="callBackSupplyProfitFilter" data-filterContentId="contentSupplyProfitFilterId" data-filterInpSearchId="dt-search-0" onclick="ShowFilterPopup(this, ['cusFilterItem'])">
                        <svg style="width:24px;height:24px;color:#333" viewBox="0 0 24 24" fill="currentColor" ><path fill-rule="evenodd" d="M3.792 2.938A49.069 49.069 0 0 1 12 2.25c2.797 0 5.54.236 8.209.688a1.857 1.857 0 0 1 1.541 1.836v1.044a3 3 0 0 1-.879 2.121l-6.182 6.182a1.5 1.5 0 0 0-.439 1.061v2.927a3 3 0 0 1-1.658 2.684l-1.757.878A.75.75 0 0 1 9.75 21v-5.818a1.5 1.5 0 0 0-.44-1.06L3.13 7.938a3 3 0 0 1-.879-2.121V4.774c0-.897.64-1.683 1.542-1.836Z" clip-rule="evenodd" /></svg>
                    </div>
                `;
                const contentFilter = `<div id="contentSupplyProfitFilterId" class="ContentFilter mt-2 mt-md-0 ms-md-2"></div>`;
                searchInput.insertAdjacentHTML("afterend", filterButton);
                dtSearch.insertAdjacentHTML("afterend", contentFilter);

                const radioBtns = `
                    <div class="d-flex column-gap-2 align-items-center justify-content-between flex-wrap">
                        <ul class="filter-switch mt-2 mt-md-0">
                            <li class="filter-switch-item">
                                <input type="radio" name="supProfit_type" id="supProfit_type-all" value="-1" checked>
                                <label for="supProfit_type-all">همه</label>
                            </li>
                            <li class="filter-switch-item">
                                <input type="radio" name="supProfit_type" id="supProfit_type-1" value="1">
                                <label for="supProfit_type-1">ثبت شده</label>
                            </li>
                            <li class="filter-switch-item">
                                <input type="radio" name="supProfit_type" id="supProfit_type-2" value="2">
                                <label for="supProfit_type-2">ثبت نشده</label>
                            </li>
                        </ul>
                    </div>
                `;

                dtSearch.insertAdjacentHTML("afterend", radioBtns);

            }

            supplyProfitTBL.on("search", function () {
                modelSupplyProfit.serVal = supplyProfitTBL.search();
            });

        };

        async function showFactors(dealId) {
            FLshowLoading();
            await getAllFactorsModal(dealId, 4);
            ModalToggle("#FactorsModal");
            FLshowLoading(false);
        }

        async function showSupplies(dealId) {
            await getAllSuppliesDetails(dealId);
            ModalToggle("#SuppliesDetailsModal");
        }

        async function getAllSuppliesDetails(dealId) {
            const data = await sendApiRequest({
                url: "/Supply/GetSuppliesDetails",
                params: { dealId },
            });
            if (!data) return;

            document.getElementById("suppliesBodyModal").innerHTML = data;
            initSuppliesDataTable();
        }


        const initSuppliesDataTable = () => {
            $("#suppliesDetailsTable").DataTable({
                paging: false,
                scrollCollapse: true,
                scrollY: "calc(100dvh - 400px)",
                responsive: true,
                ordering: false,
                searching: false,
                language: languageDatatable,

                columnDefs: [
                    {
                        targets: [0, 2],
                        className: "wrap-text-minw",
                    },
                ],
                layout: null,
                initComplete: () => {
                    document.querySelectorAll("#suppliesDetailsTable_wrapper > div.row").forEach((row) => {
                        row.classList.add("d-flex", "flex-wrap");
                        row.classList.remove("row");
                    });
                },
            });
        };


        function callBackSupplyProfitFilter() {
            modelSupplyProfit.serVal = supplyProfitConfigFilter.varSearch;
            modelSupplyProfit.filt = supplyProfitConfigFilter.filterVar;

            supplyProfitTBL.ajax.reload();
        }

        document.addEventListener("change", async (e) => {
            if (e.target.matches("input[name='supProfit_type']")) {
                modelSupplyProfit._type = Number(e.target.value);
                supplyProfitTBL.ajax.reload();
            }
        });

    </script>

}