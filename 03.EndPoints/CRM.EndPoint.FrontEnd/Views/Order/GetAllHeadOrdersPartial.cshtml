@using CRM.Core.Domain.Deals.Enums
@using CRM.Core.Domain.Orders.Enums
@model List<OrderHead>
@{
    Layout = null;
    var passType = ViewBag.PassType;

    var showAddRequestAmountBtn = passType != 4 && (User.IsAdmin() || User.IsTamin() || User.IsFinancial());
}

@foreach (var item in Model ?? []) {
    var requestCount = item.RequestAmountOrderHeads?.Count;
    var isDealClosed = item.Deal?.FinancialStatus == DealFinancialStausEnum.تایید_شده;
    <div class="orderBox @($"orderBox_col{(int)item.Status}")" data-id="@item.Id">
        <div class="d-flex flex-column justify-content-between p-2 w-100" style="column-gap:14px">
            <div class="order-card-facts">
                <div><span>شماره حواله</span><strong>@item.OrderNumber</strong></div>
                <div><span>پیش‌فاکتور</span><button type="button" class="order-card-prefactor" onclick="ShowPreviewPfactor('@item.Prefactor')">@item.PrefactorSer</button></div>
                <div><span>تاریخ</span><strong>@item.OrderDate</strong></div>
            </div>
            <div class="order-card-people">
                <div class="order-card-customer">
                    <div class="order-card-field"><span>مشتری</span><strong>@item.CustomerTxt</strong></div>
                    <div class="order-card-field order-card-customer-code"><span>کد مشتری</span><button type="button" class="order-card-profile" onclick="openCustomerProfile('@item.Customer', '@item.PrefactorSer')">@(item.CustomerCode?.ToString() ?? "-")</button></div>
                </div>
                <div class="order-card-staff">
                    <div class="order-card-field"><span>کارشناس فروش</span><strong class="order-card-sales-name" title="@item.UserCreator" tabindex="0">@item.UserCreator</strong></div>
                    <div class="order-card-field order-card-supply-expert"><span>کارشناس تأمین</span><strong>@item.UserTaminTxt</strong></div>
                </div>
            </div>
            <div class="order-card-actions">
                <div class="order-card-icon-actions">
                    <button class="flex-center px-2" data-title="مشاهده" style="color:var(--DarkColor)" onclick="PreviewOrderPrint('@item.Id')">
                        <i class="mp fa fa-eye"></i>
                    </button>
                    @if (!isDealClosed) {
                        <button class="flex-center px-2" data-title="ویرایش" style="color:var(--DarkColor)" onclick="ShowUpdateHeadOrder('@item.Id', @passType, '@item.DealId')">
                            <i class="mp fa fa-pencil"></i>
                        </button>
                        <button class="flex-center px-2" data-title="حذف" style="color:var(--DarkColor)" onclick="DelHeadOrderItem('@item.Id', @passType)">
                            <i class="mp fa fa-trash"></i>
                        </button>
                    } else {
                        const string text = "سفارش این حواله تولید، تایید مالی شده است.";
                        <label class="inline-flex-center gap-1" style="color:var(--DarkColor)" data-title="@text">
                            <svg style="width: 18px" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.403 12.652a3 3 0 0 0 0-5.304 3 3 0 0 0-3.75-3.751 3 3 0 0 0-5.305 0 3 3 0 0 0-3.751 3.75 3 3 0 0 0 0 5.305 3 3 0 0 0 3.75 3.751 3 3 0 0 0 5.305 0 3 3 0 0 0 3.751-3.75Zm-2.546-4.46a.75.75 0 0 0-1.214-.883l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" /></svg>
                            <span style="font-size: 12px" class="fMedium">تایید مالی</span>
                        </label>
                    }
                </div>

                <div class="order-card-workflow-actions">
                    @if (showAddRequestAmountBtn) {
                        <div class="@(requestCount > 0 ? "buttonGroup" : "")">
                            <button class="buttonGray" onclick="showAddRequestAmountModal('@item.Id', '@item.OrderNumber')">درخواست پیش‌پرداخت</button>
                            @if (requestCount > 0) {
                                <button class="buttonGray d-flex align-content-center gap-1" onclick="showAllRequestAmountModal('@item.Id', '@item.OrderNumber')">
                                    <i class="fa fa-eye"></i>
                                    <span>(@requestCount)</span>
                                </button>
                            }
                        </div>
                    }
                    <div class="order-card-status-actions">
                        @if (item.Status == OrderHeadStatusEnum.تولید || item.Status == OrderHeadStatusEnum.آماده_تحویل) {
                            <button class="buttonGray @(passType != 4 ? "d-xl-none" : "")" onclick="changeStatusHd('@item.Id', @(item.Status == OrderHeadStatusEnum.تولید ? 1 : 2), @((int)item.Status), @passType)">مرحله قبل</button>
                        }
                        @if (item.Status == OrderHeadStatusEnum.ثبت_اولیه) {
                            <button class="buttonGreen2 @(passType != 4 ? "d-xl-none" : "")" onclick="changeStatusHd('@item.Id', 2, @((int)item.Status), @passType)">طراحی و تولید</button>
                        } else if (item.Status == OrderHeadStatusEnum.تولید) {
                            <button class="buttonGreen2 @(passType != 4 ? "d-xl-none" : "")" onclick="changeStatusHd('@item.Id', 3, @((int)item.Status), @passType)">آماده تحویل</button>
                        } else if (item.Status == OrderHeadStatusEnum.آماده_تحویل) {
                            <button class="buttonGreen2" onclick="changeStatusHd('@item.Id', 4, @((int)item.Status), @passType)">تحویل شد</button>
                        } else if (item.Status == OrderHeadStatusEnum.تحویل_شده) {
                            <button class="buttonGray" onclick="changeStatusHd('@item.Id', 3, @((int)item.Status), @passType)">مرحله قبل</button>
                        }
                    </div>
                </div>
            </div>

        </div>
    </div>
}
