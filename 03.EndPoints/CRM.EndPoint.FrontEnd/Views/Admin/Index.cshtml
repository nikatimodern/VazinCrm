@model CRM.EndPoint.FrontEnd.Models.Admin.AdminViewModel

<div class="user-management-page" dir="rtl">
    <div class="user-page-header">
        <div>
            <h2>مدیریت کاربران</h2>
            <p>جستجو، مشاهده و مدیریت کاربران سیستم</p>
        </div>
        <div class="user-page-actions">
            <button class="buttonGreen0 d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#createUserModal">
                <i class="fa fa-plus"></i> کاربر جدید
            </button>
            <button class="buttonGray2 d-flex align-items-center gap-2" onclick="goTo('/RoleManager/index')">
                <i class="fa fa-user"></i> نقش جدید
            </button>
        </div>
    </div>

    <section class="user-list-panel">
        <div class="user-list-toolbar">
            <div class="user-search-wrap">
                <i class="fa fa-search" aria-hidden="true"></i>
                <input id="userSearchInput" type="search" class="form-control" placeholder="جستجوی نام، نام کاربری، تلفن، ایمیل یا نقش..." autocomplete="off" />
                <button type="button" id="clearUserSearch" class="user-clear-search" aria-label="پاک کردن جستجو" title="پاک کردن جستجو">×</button>
            </div>
            <label class="user-page-size">
                <span>نمایش در هر صفحه</span>
                <select id="userPageSize" class="form-select form-select-sm">
                    <option value="5">۵</option>
                    <option value="10" selected>۱۰</option>
                    <option value="20">۲۰</option>
                    <option value="50">۵۰</option>
                    <option value="all">همه</option>
                </select>
            </label>
        </div>

        <div class="user-results-summary">
            <span id="userResultsCount">در حال آماده‌سازی فهرست کاربران...</span>
            <span id="userPageSummary"></span>
        </div>

        <div id="usersCardList" class="users-card-grid" aria-live="polite" aria-busy="true">
            <div id="usersLoadingState" class="users-loading-state">
                <div class="users-loading-orbit"><span></span><span></span><span></span><i class="fa fa-users"></i></div>
                <strong>در حال بارگذاری کاربران</strong>
                <span>لطفاً چند لحظه صبر کنید؛ اطلاعات در حال دریافت است.</span>
                <div class="users-skeleton-grid" aria-hidden="true">
                    <div class="user-skeleton"><div class="skeleton-heading"><i></i><b></b><em></em></div><div class="skeleton-line"></div><div class="skeleton-line short"></div><div class="skeleton-line"></div><div class="skeleton-footer"></div></div>
                    <div class="user-skeleton"><div class="skeleton-heading"><i></i><b></b><em></em></div><div class="skeleton-line"></div><div class="skeleton-line short"></div><div class="skeleton-line"></div><div class="skeleton-footer"></div></div>
                    <div class="user-skeleton"><div class="skeleton-heading"><i></i><b></b><em></em></div><div class="skeleton-line"></div><div class="skeleton-line short"></div><div class="skeleton-line"></div><div class="skeleton-footer"></div></div>
                </div>
            </div>
        </div>

        <div id="userEmptySearch" class="user-empty-state" style="display:none">
            <i class="fa fa-search" aria-hidden="true"></i>
            <strong>نتیجه‌ای پیدا نشد</strong>
            <span>عبارت جستجو را تغییر دهید یا آن را پاک کنید.</span>
        </div>

        <nav id="userPagination" class="user-pagination" aria-label="صفحه‌بندی کاربران"></nav>
    </section>
</div>

<partial name="Modals/_RolesModal" model="Model" />
<partial name="Modals/_CreateUserModal" model="new CRM.EndPoint.FrontEnd.Models.Login.CreateModel()" />

<style>
    .users-loading-state { grid-column:1/-1; display:flex; flex-direction:column; align-items:center; gap:9px; padding:24px 8px 12px; text-align:center; color:#81909c; }
    .users-loading-state > strong { font-size:15px; color:#344b59; }
    .users-loading-state > span { font-size:12px; }
    .users-loading-orbit { width:58px; height:58px; position:relative; display:grid; place-items:center; color:#07877d; margin-bottom:2px; }
    .users-loading-orbit > i { font-size:23px; z-index:1; }
    .users-loading-orbit > span { position:absolute; inset:1px; border:2px solid transparent; border-top-color:#07877d; border-left-color:#b4e3dc; border-radius:50%; animation: usersOrbit 1.1s linear infinite; }
    .users-loading-orbit > span:nth-child(2) { inset:7px; border-top-color:#75c8bd; border-right-color:#d5efeb; animation-duration:1.7s; animation-direction:reverse; }
    .users-loading-orbit > span:nth-child(3) { inset:-5px; border-bottom-color:#d4ebe7; border-right-color:#b5ded8; animation-duration:2.3s; }
    .users-skeleton-grid { width:100%; display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr)); gap:14px; margin-top:12px; text-align:right; }
    .user-skeleton { padding:15px; border:1px solid #e5edf1; border-radius:14px; background:#f7fafc; overflow:hidden; }
    .skeleton-heading { display:flex; align-items:center; gap:10px; padding-bottom:15px; border-bottom:1px solid #e9eff3; }
    .skeleton-heading i { width:40px; height:40px; border-radius:12px; }
    .skeleton-heading b { width:36%; height:11px; border-radius:8px; }
    .skeleton-heading em { width:18%; height:19px; border-radius:20px; margin-right:auto; }
    .skeleton-line { height:9px; width:85%; border-radius:8px; margin-top:17px; }
    .skeleton-line.short { width:55%; margin-top:12px; }
    .skeleton-footer { height:30px; width:100%; border-radius:8px; margin-top:20px; }
    .user-skeleton .skeleton-heading i, .user-skeleton .skeleton-heading b, .user-skeleton .skeleton-heading em, .user-skeleton .skeleton-line, .user-skeleton .skeleton-footer { background:linear-gradient(100deg,#e9eff3 20%,#f8fbfc 40%,#e9eff3 60%); background-size:200% 100%; animation: usersShimmer 1.35s ease-in-out infinite; }
    @@keyframes usersOrbit { to { transform:rotate(360deg); } }
    @@keyframes usersShimmer { to { background-position-x:-200%; } }
    .user-management-page { width:100%; color:#243342; }
    .user-page-header { display:flex; justify-content:space-between; align-items:center; gap:16px; flex-wrap:wrap; margin-bottom:18px; }
    .user-page-header h2 { font-size:20px; font-weight:700; margin:0 0 5px; }
    .user-page-header p { margin:0; color:#7a8794; font-size:13px; }
    .user-page-actions { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
    .user-list-panel { background:#fff; border:1px solid #e4eaf0; border-radius:16px; padding:16px; box-shadow:0 5px 24px rgba(28,45,64,.05); }
    .user-list-toolbar { display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:12px; }
    .user-search-wrap { position:relative; flex:1 1 300px; max-width:560px; }
    .user-search-wrap > .fa-search { position:absolute; right:13px; top:50%; transform:translateY(-50%); color:#8b98a5; pointer-events:none; }
    .user-search-wrap input { border-radius:10px; min-height:42px; padding-right:38px; padding-left:38px; border-color:#dce4eb; }
    .user-search-wrap input:focus { border-color:#07877d; box-shadow:0 0 0 3px rgba(7,135,125,.12); }
    .user-clear-search { position:absolute; left:9px; top:50%; transform:translateY(-50%); border:0; background:transparent; color:#7b8794; font-size:22px; line-height:1; cursor:pointer; }
    .user-page-size { display:flex; align-items:center; gap:8px; color:#667584; font-size:13px; }
    .user-page-size select { width:85px; border-radius:8px; }
    .user-results-summary { display:flex; align-items:center; justify-content:space-between; gap:8px; flex-wrap:wrap; color:#7b8794; font-size:12px; padding:4px 2px 14px; }
    .users-card-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(min(100%,320px),1fr)); gap:14px; align-items:stretch; }
    .user-card { min-width:0; display:flex; flex-direction:column; background:#f7fafc; border:1px solid #e1e9ef; border-radius:14px; padding:15px; box-shadow:0 2px 8px rgba(27,43,58,.045); transition:box-shadow .2s ease,transform .2s ease,border-color .2s ease; }
    .user-card:hover { transform:translateY(-2px); border-color:#c7dcd9; box-shadow:0 8px 22px rgba(27,43,58,.08); }
    .user-card-employee { border-right:3px solid #0b9385; }
    .user-card-locked { border-right:3px solid #dc4c4c; background:#fffafa; }
    .user-card-top { display:flex; align-items:center; gap:10px; min-width:0; padding-bottom:13px; border-bottom:1px solid #edf1f4; }
    .user-avatar { width:42px; height:42px; flex:0 0 42px; display:grid; place-items:center; border-radius:12px; background:#e8f6f3; color:#07877d; font-size:18px; }
    .user-card-locked .user-avatar { background:#ffeded; color:#c83c3c; }
    .user-card-identity { min-width:0; flex:1; }
    .user-card-identity h3 { margin:0 0 4px; font-size:15px; font-weight:700; overflow-wrap:anywhere; }
    .user-card-username { color:#84919d; font-size:12px; direction:ltr; display:inline-block; }
    .user-status { border-radius:20px; padding:4px 8px; font-size:10px; white-space:nowrap; background:#eef2f5; color:#687785; }
    .user-status-active { background:#e3f7ee; color:#168458; }
    .user-status-locked { background:#ffe8e8; color:#bd3535; }
    .user-card-details { display:grid; gap:10px; padding:13px 0; }
    .user-detail { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; font-size:12px; }
    .user-detail > span { color:#85919d; flex:0 0 auto; }
    .user-detail > span i { width:16px; color:#93a1ad; }
    .user-detail > strong { min-width:0; text-align:left; overflow-wrap:anywhere; font-weight:500; color:#344554; }
    .user-card-roles { padding-top:11px; border-top:1px solid #edf1f4; flex:1; }
    .user-section-label { display:block; color:#84919d; font-size:11px; margin-bottom:8px; }
    .user-roles-cell { display:flex; align-items:center; flex-wrap:wrap; gap:6px; min-height:25px; }
    .user-role-chip { display:inline-flex; align-items:center; gap:5px; border:1px solid #dce9e7; border-radius:7px; background:#f0f8f7; color:#286f69; padding:4px 7px; font-size:11px; max-width:100%; }
    .role-remove-button { display:inline-grid; place-items:center; border:0; background:transparent; color:#8b9a9a; padding:0; cursor:pointer; }
    .role-remove-button:hover { color:#c53d3d; }
    .role-remove-button svg { width:14px; height:14px; fill:none; stroke:currentColor; stroke-width:1.8; }
    .user-no-roles { color:#a0aab4; font-size:12px; }
    .user-card-actions { display:flex; gap:7px; flex-wrap:wrap; padding-top:14px; margin-top:12px; border-top:1px solid #edf1f4; }
    .user-action { display:inline-flex; align-items:center; justify-content:center; gap:6px; border:1px solid #dfe6ec; border-radius:8px; padding:7px 10px; background:#fff; color:#526271; font-size:12px; text-decoration:none; cursor:pointer; transition:background .15s ease,border-color .15s ease; }
    .user-action:hover { background:#f5f8fa; border-color:#c8d5df; color:#263d4d; }
    .user-action-edit { color:#087e74; }
    .user-action-roles { color:#4c6595; }
    .user-action-delete { color:#bf3f3f; margin-right:auto; }
    .user-empty-state { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:7px; padding:38px 16px; text-align:center; color:#8a97a3; }
    .user-empty-state > i { font-size:27px; color:#a8b6c1; margin-bottom:5px; }
    .user-empty-state strong { color:#516170; font-size:14px; }
    .user-empty-state span { font-size:12px; }
    .user-load-error { grid-column:1/-1; display:flex; flex-direction:column; align-items:center; gap:10px; padding:32px 12px; color:#8a97a3; }
    .user-load-error > i { color:#c78336; font-size:25px; }
    .user-pagination { display:flex; align-items:center; justify-content:center; gap:5px; flex-wrap:wrap; padding-top:18px; }
    .user-page-button { min-width:34px; height:34px; padding:0 10px; border:1px solid #e0e7ed; border-radius:8px; background:#fff; color:#536474; cursor:pointer; }
    .user-page-button:hover:not(:disabled), .user-page-button.is-active { border-color:#07877d; background:#07877d; color:#fff; }
    .user-page-button:disabled { opacity:.4; cursor:not-allowed; }
    .user-card.newly-created-user-row { border-color:#0d9488; box-shadow:0 0 0 3px rgba(13,148,136,.16),0 8px 22px rgba(27,43,58,.08); animation: newUserHighlight 1s ease-in-out 3; }
    @@keyframes newUserHighlight { 0%,100% { background-color:#fff; } 50% { background-color:#d9fbeb; } }
    @@media (max-width:600px) {
        .user-list-panel { padding:10px; }
        .user-page-header { align-items:flex-start; }
        .user-page-actions { width:100%; }
        .user-page-actions > button { flex:1; justify-content:center; }
        .user-card { padding:12px; }
    }
</style>

@section Scripts {
<script>
    let currentUserPage = 1;
    let userPageSize = 10;
    let userSearchTerm = "";

    document.addEventListener("DOMContentLoaded", () => {
        document.getElementById("userSearchInput").addEventListener("input", event => {
            userSearchTerm = normalizeUserSearch(event.target.value);
            currentUserPage = 1;
            renderUserCards();
        });
        document.getElementById("clearUserSearch").addEventListener("click", () => {
            document.getElementById("userSearchInput").value = "";
            userSearchTerm = "";
            currentUserPage = 1;
            renderUserCards();
        });
        document.getElementById("userPageSize").addEventListener("change", event => {
            userPageSize = event.target.value === "all" ? Infinity : Number(event.target.value);
            currentUserPage = 1;
            renderUserCards();
        });
        loadUsers();
    });

    async function loadUsers() {
        const list = document.getElementById("usersCardList");
        list.setAttribute("aria-busy", "true");
        try {
            const response = await fetch("/Admin/GetUsers", {
                method: "GET",
                headers: { "X-Requested-With": "XMLHttpRequest" },
                credentials: "same-origin",
                cache: "no-store"
            });
            if (!response.ok) throw new Error("دریافت فهرست کاربران با خطا مواجه شد.");
            list.innerHTML = await response.text();
            list.setAttribute("aria-busy", "false");
            renderUserCards();
        } catch (error) {
            list.setAttribute("aria-busy", "false");
            list.innerHTML = `<div class="user-load-error"><i class="fa fa-exclamation-triangle"></i><strong>بارگذاری کاربران انجام نشد</strong><span></span><button type="button" class="user-action user-action-roles" id="retryLoadUsers">تلاش مجدد</button></div>`;
            list.querySelector(".user-load-error span").textContent = error.message || "اتصال به سرور ناموفق بود.";
            document.getElementById("retryLoadUsers").addEventListener("click", loadUsers);
            document.getElementById("userResultsCount").textContent = "دریافت اطلاعات ناموفق بود";
        }
    }

    function normalizeUserSearch(value) {
        return (value || "").toLocaleLowerCase("fa-IR").trim();
    }

    function getAllUserCards() {
        return Array.from(document.querySelectorAll("#usersCardList .user-card"));
    }

    function renderUserCards() {
        const loadingState = document.getElementById("usersLoadingState");
        if (loadingState) return;
        const cards = getAllUserCards();
        const filtered = cards.filter(card => {
            const searchable = normalizeUserSearch(card.textContent);
            return !userSearchTerm || searchable.includes(userSearchTerm);
        });

        const pageSize = userPageSize === Infinity ? Math.max(filtered.length, 1) : userPageSize;
        const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
        currentUserPage = Math.min(currentUserPage, totalPages);
        const start = (currentUserPage - 1) * pageSize;
        const visible = new Set(filtered.slice(start, start + pageSize));

        cards.forEach(card => { card.style.display = visible.has(card) ? "" : "none"; });
        document.getElementById("userResultsCount").textContent = filtered.length === cards.length
            ? `تعداد کاربران: ${cards.length.toLocaleString("fa-IR")}`
            : `نتیجه جستجو: ${filtered.length.toLocaleString("fa-IR")} از ${cards.length.toLocaleString("fa-IR")} کاربر`;
        document.getElementById("userPageSummary").textContent = filtered.length
            ? `نمایش ${(start + 1).toLocaleString("fa-IR")} تا ${Math.min(start + pageSize, filtered.length).toLocaleString("fa-IR")}`
            : "";

        const emptyState = document.getElementById("userEmptySearch");
        emptyState.style.display = filtered.length === 0 ? "flex" : "none";
        const emptyTitle = emptyState.querySelector("strong");
        const emptyMessage = emptyState.querySelector("span");
        if (emptyTitle) emptyTitle.textContent = cards.length === 0 ? "کاربری ثبت نشده است" : "نتیجه‌ای پیدا نشد";
        if (emptyMessage) emptyMessage.textContent = cards.length === 0 ? "برای شروع، کاربر جدیدی ثبت کنید." : "عبارت جستجو را تغییر دهید یا آن را پاک کنید.";

        renderUserPagination(totalPages);
    }

    function renderUserPagination(totalPages) {
        const container = document.getElementById("userPagination");
        container.replaceChildren();
        if (totalPages <= 1 || userPageSize === Infinity) return;

        const addButton = (label, page, options = {}) => {
            const button = document.createElement("button");
            button.type = "button";
            button.className = "user-page-button" + (options.active ? " is-active" : "");
            button.textContent = label;
            button.disabled = Boolean(options.disabled);
            if (options.active) button.setAttribute("aria-current", "page");
            button.addEventListener("click", () => {
                currentUserPage = page;
                renderUserCards();
            });
            container.appendChild(button);
        };

        addButton("قبلی", Math.max(1, currentUserPage - 1), { disabled: currentUserPage === 1 });
        const pages = new Set([1, totalPages]);
        for (let page = Math.max(1, currentUserPage - 2); page <= Math.min(totalPages, currentUserPage + 2); page++) {
            pages.add(page);
        }
        const sortedPages = Array.from(pages).sort((a, b) => a - b);
        let previousPage = 0;
        sortedPages.forEach(page => {
            if (previousPage && page - previousPage > 1) {
                const dots = document.createElement("span");
                dots.textContent = "…";
                dots.className = "px-1 text-muted";
                container.appendChild(dots);
            }
            addButton(page.toLocaleString("fa-IR"), page, { active: page === currentUserPage });
            previousPage = page;
        });
        addButton("بعدی", Math.min(totalPages, currentUserPage + 1), { disabled: currentUserPage === totalPages });
    }

    function createRoleChip(userId, userName, role) {
        const chip = document.createElement("span");
        chip.className = "user-role-chip";
        const remove = document.createElement("button");
        remove.type = "button";
        remove.className = "role-remove-button";
        remove.title = "حذف نقش";
        remove.setAttribute("aria-label", "حذف نقش " + role);
        remove.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>';
        remove.addEventListener("click", () => DelUserRole(remove, userId, role, userName));
        const label = document.createElement("span");
        label.textContent = role;
        chip.append(remove, label);
        return chip;
    }

    function appendCreatedUserToTable(user) {
        const card = document.createElement("article");
        card.className = "user-card newly-created-user-row";
        card.dataset.userName = user.userName;
        card.dataset.userId = user.id;
        card.dataset.search = [user.firstName, user.lastName, user.userName, user.phoneNumber, user.email, user.internalTels].filter(Boolean).join(" ");
        const fullName = [user.firstName, user.lastName].filter(Boolean).join(" ");
        card.innerHTML = `
            <div class="user-card-top">
                <div class="user-avatar" aria-hidden="true"><i class="fa fa-user"></i></div>
                <div class="user-card-identity"><h3></h3><span class="user-card-username"></span></div>
                <span class="user-status user-status-active">فعال</span>
            </div>
            <div class="user-card-details">
                <div class="user-detail"><span><i class="fa fa-phone"></i> تلفن همراه</span><strong data-field="phone"></strong></div>
                <div class="user-detail"><span><i class="fa fa-envelope"></i> ایمیل</span><strong data-field="email" dir="ltr"></strong></div>
                <div class="user-detail"><span><i class="fa fa-phone-square"></i> شماره داخلی</span><strong data-field="internal"></strong></div>
            </div>
            <div class="user-card-roles"><span class="user-section-label">نقش‌ها</span><div class="user-roles-cell"><span class="user-no-roles">بدون نقش</span></div></div>
            <div class="user-card-actions">
                <a class="user-action user-action-edit"><i class="fa fa-pencil"></i> ویرایش</a>
                <button type="button" class="user-action user-action-roles"><i class="fa fa-shield"></i> مدیریت نقش‌ها</button>
                <button type="button" class="user-action user-action-delete"><i class="fa fa-trash"></i> حذف</button>
            </div>`;
        card.querySelector("h3").textContent = fullName || user.userName || "کاربر جدید";
        card.querySelector(".user-card-username").textContent = String.fromCharCode(64) + (user.userName || "");
        card.querySelector('[data-field="phone"]').textContent = user.phoneNumber || "-";
        card.querySelector('[data-field="email"]').textContent = user.email || "-";
        card.querySelector('[data-field="internal"]').textContent = user.internalTels || "-";
        const edit = card.querySelector(".user-action-edit");
        edit.href = "/Admin/Edit?id=" + encodeURIComponent(user.id);
        card.querySelector(".user-action-roles").addEventListener("click", () => openUserRolesModal(user.userName));
        card.querySelector(".user-action-delete").addEventListener("click", event => deleteUser(event.currentTarget, user.id));
        document.getElementById("usersCardList").appendChild(card);

        document.getElementById("userSearchInput").value = "";
        userSearchTerm = "";
        currentUserPage = Math.ceil(getAllUserCards().length / (userPageSize === Infinity ? Math.max(getAllUserCards().length, 1) : userPageSize));
        renderUserCards();
        card.scrollIntoView({ behavior: "smooth", block: "center" });
        card.focus({ preventScroll: true });
        window.setTimeout(() => card.classList.remove("newly-created-user-row"), 4000);
    }

    async function DelUserRole(buttonElement, id, role, userName) {
        if (typeof axios === "undefined") {
            Swal.fire({ icon: "error", text: "کتابخانه Axios در صفحه بارگذاری نشده است." });
            return;
        }
        const chip = buttonElement.closest(".user-role-chip");
        if (!chip || chip.dataset.deleting === "true") return;
        const original = chip.innerHTML;
        chip.dataset.deleting = "true";
        chip.style.opacity = ".55";
        chip.style.pointerEvents = "none";
        chip.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-label="در حال حذف"></span>';
        try {
            const payload = new URLSearchParams({ id, role });
            const token = document.querySelector('#userRolesForm input[name="__RequestVerificationToken"]');
            if (token) payload.append("__RequestVerificationToken", token.value);
            await axios.post("/Admin/DelUserRol", payload, {
                headers: { "Content-Type": "application/x-www-form-urlencoded", "X-Requested-With": "XMLHttpRequest" },
                timeout: 15000
            });
            const response = await axios.get("/Admin/GetUserRoles", { params: { userName }, timeout: 15000 });
            updateUserRolesTable(userName, response.data || []);
        } catch (error) {
            chip.innerHTML = original;
            chip.style.opacity = "";
            chip.style.pointerEvents = "";
            delete chip.dataset.deleting;
            Swal.fire({ icon: "error", text: error.response?.data?.message || "حذف نقش انجام نشد. دوباره تلاش کنید." });
        }
    }

    async function deleteUser(buttonElement, id) {
        const confirmation = await Swal.fire({
            title: "حذف دائمی!",
            text: "آیا از حذف این کاربر مطمئن هستید؟ این عمل غیرقابل بازگشت است و کاربر برای همیشه پاک می‌شود.",
            icon: "warning", showCancelButton: true, cancelButtonColor: "#adadad", confirmButtonColor: "#e64942",
            cancelButtonText: "انصراف", confirmButtonText: "بله، حذف شود", theme: "dark"
        });
        if (!confirmation.isConfirmed) return;
        if (typeof axios === "undefined") {
            Swal.fire({ icon: "error", text: "کتابخانه Axios در صفحه بارگذاری نشده است." });
            return;
        }
        const card = buttonElement.closest(".user-card");
        if (!card || card.dataset.deleting === "true") return;
        const old = buttonElement.innerHTML;
        card.dataset.deleting = "true";
        card.style.opacity = ".6";
        card.style.pointerEvents = "none";
        buttonElement.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-label="در حال حذف"></span>';
        try {
            const payload = new URLSearchParams({ id });
            const token = document.querySelector('#userRolesForm input[name="__RequestVerificationToken"]');
            if (token) payload.append("__RequestVerificationToken", token.value);
            const response = await axios.post("/Admin/Delete", payload, {
                headers: { "Content-Type": "application/x-www-form-urlencoded", "X-Requested-With": "XMLHttpRequest" }, timeout: 15000
            });
            if (!response.data?.success) throw new Error(response.data?.message || "حذف کاربر ناموفق بود.");
            card.remove();
            renderUserCards();
            await Swal.fire({ icon: "success", title: "حذف شد", text: "کاربر با موفقیت حذف شد.", timer: 1500, showConfirmButton: false });
        } catch (error) {
            card.style.opacity = "";
            card.style.pointerEvents = "";
            delete card.dataset.deleting;
            buttonElement.innerHTML = old;
            Swal.fire({ icon: "error", title: "خطا در حذف", text: error.response?.data?.message || error.message || "حذف کاربر انجام نشد. دوباره تلاش کنید." });
        }
    }
</script>
}
