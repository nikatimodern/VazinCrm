@inject CRM.EndPoint.FrontEnd.Security.DocumentAccessPolicy DocumentAccess
@using CRM.Core.Domain.PreFactors.Enum
@model PreFactor
@{
    var passType = ViewData["PassType"] as int? ?? 0; // 0: Cartable | 1: CustomerProfile | 4: Deal
    var hasAccess = ViewData["HasAccess"] as bool? ?? false;
    var acceptedCard = ViewData["AcceptedCard"] as bool? ?? false;
    var enforced = DocumentAccess.IsEnforced("PreFactor");
    var closed = ViewData["DealClosed"] as bool? ?? false;
    var ct = Context.RequestAborted;
    var canEdit = !closed && (enforced ? await DocumentAccess.AllowsPreFactorAsync(Model, "Edit", ct) : hasAccess);
    var canDelete = !closed && (enforced ? await DocumentAccess.AllowsPreFactorAsync(Model, "Delete", ct) : hasAccess);
    var canChangeStatus = !closed && (enforced ? await DocumentAccess.AllowsPreFactorAsync(Model, "ChangeStatus", ct) : hasAccess);
    var canExport = enforced ? await DocumentAccess.AllowsPreFactorAsync(Model, "ExportExternal", ct) : (User.IsFinancial() || User.IsAdmin() || User.IsInRole("مدیر عامل"));
    var canAssign = !closed && User.IsAdmin() && (!enforced || await DocumentAccess.AllowsPreFactorAsync(Model, "AssignTamin", ct));
    var canCreateFactor = DocumentAccess.IsEnforced("Factor")
        ? await DocumentAccess.HasAsync("Factor", "Create", ct)
        : (User.IsAdmin() || User.IsFinancial());
}

<div class="@(acceptedCard ? "pf-accepted-card__action-list" : "d-flex flex-row flex-sm-column mt-2 mt-sm-0 mx-0 mx-sm-2 align-items-center justify-content-evenly")" style="@(acceptedCard ? null : "row-gap:8px;font-size:15px")">

    @if ((canEdit || canDelete) && Model.Pftype != (int)PreFactorEnum.جنس_به_مشتری_تحویل_داده_شد) {
        if (Model.Pftype <= (int)PreFactorEnum.در_انتظار_تایید_مسئول_تامین || User.IsAdmin()) {
            if (canDelete) {
            <button data-document-permission="PreFactor.Delete" type="button" class="flex-center" aria-label="حذف" data-title-right="حذف" style="color:var(--DarkColor)" onclick="deletePreFactor('@Model.Id', @passType)">
                <span class="pf-accepted-card__action-icon" style="@(acceptedCard ? null : "display:contents")" aria-hidden="true">
                    <i class="mp fa fa-trash"></i>
                </span>
            </button>
            }
            if (canEdit) {
            <button data-document-permission="PreFactor.Edit" type="button" class="flex-center" aria-label="ویرایش" data-title-right="ویرایش" style="color:var(--DarkColor)" onclick="upPfactor('@Model.Id', @passType)">
                <span class="pf-accepted-card__action-icon" style="@(acceptedCard ? null : "display:contents")" aria-hidden="true">
                    <i class="mp fa fa-pencil"></i>
                </span>
            </button>
            }
        }
    }

    @if (Model.Pftype > (int)PreFactorEnum.در_انتظار_تایید_مسئول_تامین) {
        <button type="button" class="flex-center" aria-label="نمایش پیش‌فاکتور" data-title-right="نمایش پیش‌فاکتور" style="z-index:15;color:var(--DarkColor)" onclick="ShowPreviewPfactor('@Model.Id')">
            <span class="pf-accepted-card__action-icon" style="@(acceptedCard ? null : "display:contents")" aria-hidden="true">
                <i class="mp fa fa-eye"></i>
            </span>
        </button>
    }

    @if (Model.CustomerId != null && passType != 1) {
        <button type="button" class="flex-center" aria-label="پروفایل" data-title-right="پروفایل" style="color:var(--DarkColor)" onclick="openCustomerProfile('@Model.CustomerId', '@Model.SerialNumber')">
            <span class="pf-accepted-card__action-icon" style="@(acceptedCard ? null : "display:contents")" aria-hidden="true">
                <i class="mp fa fa-user"></i>
            </span>
        </button>
    }

    @if (acceptedCard && canExport) {
        <button type="button" class="flex-center" aria-label="ارتباط مالی" data-title-right="ارتباط مالی" data-document-permission="PreFactor.ExportExternal" onclick="showPreFactorExternalSotwaresModal('@Model.Id', '@Model.SerialNumber')">
            <span class="pf-accepted-card__action-icon" style="@(acceptedCard ? null : "display:contents")" aria-hidden="true">
                <i class="fa fa-link" aria-hidden="true"></i>
            </span>
        </button>
    }

    @if (!User.IsCustomer()) {
        if (canEdit) {
            <button type="button" class="flex-center" aria-label="پیوست ها" data-title-right="پیوست ها" style="color:var(--DarkColor)" data-document-permission="PreFactor.Edit" onclick="AttachDoc('@Model.Id')">
                <span class="pf-accepted-card__action-icon" style="@(acceptedCard ? null : "display:contents")" aria-hidden="true">
                    <i class="fa fa-paperclip"></i>
                </span>
            </button>
        } else {
            <button type="button" class="flex-center" aria-label="پیوست ها" data-title-right="پیوست ها" style="color:var(--DarkColor)" onclick="showAttachments('@Model.Id', 2)">
                <span class="pf-accepted-card__action-icon" style="@(acceptedCard ? null : "display:contents")" aria-hidden="true">
                    <i class="fa fa-paperclip"></i>
                </span>
            </button>
        }

        if (Model.Pftype >= (int)PreFactorEnum.در_انتظار_تایید_مدیر_فروش) {
            <button type="button" class="flex-center taminDropdownToggle" aria-label="دستور تولیدها" data-title-right="دستور تولیدها" style="color:var(--DarkColor)" data-pfId="@Model.Id">
                <span class="pf-accepted-card__action-icon" style="@(acceptedCard ? null : "display:contents")" aria-hidden="true">
                    <i class="fas fa-industry"></i>
                </span>
            </button>
            <div class="taminDropdown"></div>
        }

        if (canCreateFactor && !closed && (Model.Pftype is (int)PreFactorEnum.در_انتظار_تولید or (int)PreFactorEnum.جنس_به_مشتری_تحویل_داده_شد)) {
            <button type="button" class="flex-center" aria-label="ثبت فاکتور جدید" data-title-right="ثبت فاکتور جدید" style="color:var(--DarkColor)" data-document-permission="Factor.Create" onclick="AddFactor('@Model.Id', @passType)">
                <span class="pf-accepted-card__action-icon" style="@(acceptedCard ? null : "display:contents")" aria-hidden="true">
                    <i class="fa fa-arrow-left"></i>
                </span>
            </button>
        }

        if (canChangeStatus && Model.Pftype == (int)PreFactorEnum.فاقد_اعتبار) {
            <button type="button" class="flex-center" aria-label="بازگشت" data-title-right="بازگشت" style="color:var(--DarkColor)" data-document-permission="PreFactor.ChangeStatus" onclick="Backward('@Model.Id', @passType)">
                <span class="pf-accepted-card__action-icon" style="@(acceptedCard ? null : "display:contents")" aria-hidden="true">
                    <i class="fa fa-forward"></i>
                </span>
            </button>
        }

        if (canAssign) {
            <button type="button" class="flex-center" aria-label="تغییر کارشناس" data-title-right="تغییر کارشناس" style="color:var(--DarkColor)" data-document-permission="PreFactor.AssignTamin" onclick="showModalChangeUsersPf('@Model.Id', '@Model.CustomerId')">
                <span class="pf-accepted-card__action-icon" style="@(acceptedCard ? null : "display:contents")" aria-hidden="true">
                    <svg style="width: 16px" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M11.078 2.25c-.917 0-1.699.663-1.85 1.567L9.05 4.889c-.02.12-.115.26-.297.348a7.493 7.493 0 0 0-.986.57c-.166.115-.334.126-.45.083L6.3 5.508a1.875 1.875 0 0 0-2.282.819l-.922 1.597a1.875 1.875 0 0 0 .432 2.385l.84.692c.095.078.17.229.154.43a7.598 7.598 0 0 0 0 1.139c.015.2-.059.352-.153.43l-.841.692a1.875 1.875 0 0 0-.432 2.385l.922 1.597a1.875 1.875 0 0 0 2.282.818l1.019-.382c.115-.043.283-.031.45.082.312.214.641.405.985.57.182.088.277.228.297.35l.178 1.071c.151.904.933 1.567 1.85 1.567h1.844c.916 0 1.699-.663 1.85-1.567l.178-1.072c.02-.12.114-.26.297-.349.344-.165.673-.356.985-.57.167-.114.335-.125.45-.082l1.02.382a1.875 1.875 0 0 0 2.28-.819l.923-1.597a1.875 1.875 0 0 0-.432-2.385l-.84-.692c-.095-.078-.17-.229-.154-.43a7.614 7.614 0 0 0 0-1.139c-.016-.2.059-.352.153-.43l.84-.692c.708-.582.891-1.59.433-2.385l-.922-1.597a1.875 1.875 0 0 0-2.282-.818l-1.02.382c-.114.043-.282.031-.449-.083a7.49 7.49 0 0 0-.985-.57c-.183-.087-.277-.227-.297-.348l-.179-1.072a1.875 1.875 0 0 0-1.85-1.567h-1.843ZM12 15.75a3.75 3.75 0 1 0 0-7.5 3.75 3.75 0 0 0 0 7.5Z" clip-rule="evenodd" /></svg>
                </span>
            </button>
        }

        <button type="button" class="flex-center" aria-label="تاریخچه" data-title-right="تاریخچه" style="color:var(--DarkColor)" onclick="showLogEntity('@nameof(PreFactor)', '@Model.Id')">
            <span class="pf-accepted-card__action-icon" style="@(acceptedCard ? null : "display:contents")" aria-hidden="true">
                <svg style="width: 18px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" /><path d="M3 3v5h5" /><path d="M12 7v5l4 2" /></svg>
            </span>
        </button>
    }
</div>
