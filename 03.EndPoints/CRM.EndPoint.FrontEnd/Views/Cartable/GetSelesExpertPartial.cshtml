                                            <label class="fbold text-center">@(string.IsNullOrEmpty(item.AgentName) ? "-" : item.AgentName)</label>
                                        </div>
                                    </div>

                                    <div class=" my-2 d-md-none d-xxl-block" style="background-color: rgba(0, 0, 0, 0.15); width: 85%;height:1px;margin-inline:auto"></div>

                                    <div class="col px-2 d-flex flex-wrap gap-2 align-items-center justify-content-around">
                                        <button style="height:auto; width:auto;padding:4px 8px;font-size:14px;" id="BtnSendToId" class="d-flex gap-2 align-items-center justify-content-center ToSend" onclick="showMobileModal('@item.Id', 3)">
                                            <i class="mp fa fa-paper-plane" aria-hidden="true"></i> ارسال مجدد
                                        </button>
                                        <button style="height:auto; width:auto;padding:4px 8px;font-size:14px;" id="BtnSendToId" class="ToSend" onclick="HandAccepting('@item.Id', 3)"> تایید به صورت دستی</button>
                                    </div>

                                    <div class=" my-2 d-md-none d-xxl-block" style="background-color: rgba(0, 0, 0, 0.15); width: 85%;height:1px;margin-inline:auto"></div>

                                    <div class=" col col-md-4 col-xxl-auto px-2" style="display:flex;align-items:center;justify-content:start;gap:8px">
                                        <label style="color:gray;min-width:44px">مبلغ:</label>
                                        <label class="text-center" style="color:crimson; font-size:14px; font-family:'IRANSansBold'">@string.Format("{0:n0}", item.PaymentAmount) <span style="font-size: 12px"> @(item.CurrencyTypeTxt ?? "ريال")</span></label>
                                    </div>

                                </div>
                                <div style=" display:flex;flex-direction:column;  justify-content:space-evenly !important">
                                    <button class="mp d-flex justify-content-center align-items-center" data-title-right="نمایش پیش فاکتور" style="color:var(--DarkColor); border:none;background-color:transparent" onclick="ShowPreviewPfactor('@item.Id')">
                                        <i class="mp fa fa-eye"></i></button>
                                    @if (item.CustomerId != null) {
                                        <button class="mp " style="color:var(--DarkColor); border:none;background-color:transparent" data-title-right="پروفایل" onclick="openCustomerProfile('@item.CustomerId', '@item.SerialNumber')">
                                            <i class="mp fa fa-user"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
