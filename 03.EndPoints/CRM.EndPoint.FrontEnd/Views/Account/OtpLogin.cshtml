@{
    Layout = "_LoginLayout";
}

<div class="d-flex flex-column align-items-center" style="width:80%; ">
    <p class="mb-3 text-center" style="color: #5811b4">
        <span class="fbold" style="font-size:20px">
            @(ViewBag.type switch {
                "Forgot" => "بازنشانی رمز عبور",
                _ => "ورود به سامانه وزین پلاست",
            })
        </span>
    </p>

    <div class="w-100">
        <form id="otpLoginForm">
            <div class="form-group mb-2 p-0">
                <span class="fbold" style="position: absolute;left: 8px;top: 50%;transform: translateY(-50%);font-size: 15px">09</span>
                <input inputmode="numeric" autocomplete="off" class="form-group__input form-group__input--ltr IranMobileNumber" style="padding-inline: 22px" type="text" autofocus name="mobile" placeholder="شماره موبایل" required />
                <span class="form-group__icon">
                    <svg style="width: 26px;height: 26px;color: #787c83" fill="none" viewBox="0 0 24 24" stroke-width="1.25" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" /></svg>
                </span>
            </div>
            <button id="confirmCodeOtpLoginBtn" type="submit" class="col-12 buttonGreen2 login-btn flex-center" style="font-size: 16px;height: 38px">
                <span>ارسال کد ورود</span>
                <div class="spinner-border spinner-border-sm d-none ms-2" role="status"></div>
            </button>
            @if (ViewBag.type != "Forgot") {
                <div class="d-flex align-items-center justify-content-end fs-6 mt-2 mt-md-1">
                    <a asp-controller="Account" asp-action="Login" class="link-gray fMedium">ورود با نام کاربری</a>
                </div>
            }
        </form>
        <div id="otpSection" style="display:none;">
            <p class="text-muted fMedium" style="text-align:right;">کد یکبار مصرف به شماره <strong id="phoneNumberLoginOtp"></strong> ارسال شد</p>
            <div class="form-group mb-2 p-0">
                <span class="form-group__icon">
                    <svg style="width: 26px;height: 26px;color: #787c83" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z" /></svg>
                </span>
                <input inputmode="numeric" class="form-group__input form-group__input--ltr digitNumber" id="otpLoginInp" name="otp" autocomplete="one-time-code" type="text" autofocus maxlength="4" placeholder="کد تایید" />
            </div>
            <button id="verifyOtpBtn" class="col-12 buttonGreen2 login-btn justify-content-center align-items-center" style="font-size: 16px;height: 38px;display: flex">
                <span>تایید کد</span>
                <div class="spinner-border spinner-border-sm d-none ms-2" role="status"></div>
            </button>
        </div>
        <div class="d-flex align-items-center justify-content-between w-100 mt-2" style="direction: rtl;">
            <p class="errorLoginText mt-0" id="otpLoginMsg"></p>
            <button id="resendOtpBtn" class="buttonPurple2" style="display: none">ارسال مجدد کد</button>
            <p class="text-muted" id="remainingCodeOtpLoginId" style="display: none;align-items: baseline;gap: 4px;direction: rtl;justify-content: end">
                <span>زمان باقی‌مانده: </span>
                <strong id="remainingSecondsOtpLogin"></strong>
            </p>
        </div>
    </div>
</div>



@section Scripts {

    <script defer>
        let intervalId;
        let mobileVerified;
        let selectedUserId;
        let otpVerifyPending = false;
        let otpBtn = document.getElementById("verifyOtpBtn");
        let mobileLoginBtn = document.getElementById("confirmCodeOtpLoginBtn");

        document.addEventListener("DOMContentLoaded", async () => {
            const input = document.querySelector("#otpSection input[autocomplete='one-time-code']");
            await readOtp(input, otpBtn);
        });


        document.getElementById("otpLoginForm").addEventListener("submit", function (e) {
            e.preventDefault();
            toggleElementsDisabled(mobileLoginBtn);
            mobileLoginBtn.querySelector(".spinner-border").classList.remove("d-none");

            if (this.mobile.value.length < 9) {
                document.getElementById("otpLoginMsg").textContent = "شماره موبایل معتبر نیست!";
                mobileLoginBtn.querySelector(".spinner-border").classList.add("d-none");
                toggleElementsDisabled(mobileLoginBtn, false);
                return;
            }
            const mobile = "09" + this.mobile.value;

            fetch(`/Account/RequestOtp?type=@ViewBag.type`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ mobile }),
            })
                .then(res => res.json())
                .then(data => {
                    if (data.status === 200) {
                        mobileVerified = mobile;
                        sessionStorage.setItem("mobileVerified", JSON.stringify(mobileVerified));
                        document.getElementById("otpLoginMsg").innerText = "";
                        document.getElementById("phoneNumberLoginOtp").innerText = mobileVerified;
                        document.getElementById("otpLoginForm").style.display = "none";
                        document.getElementById("otpSection").style.display = "block";
                        document.getElementById("otpLoginInp").value = "";
                        document.getElementById("otpLoginInp").focus();
                        document.getElementById("remainingCodeOtpLoginId").style.display = "flex";
                        document.getElementById("historyBackIcon").classList.remove("d-none");
                        history.pushState({ step: "otp" }, "", "/Account/OtpLogin#otp");

                        toastifySuccess(data.message);
                        startOtpTimer();
                    } else {
                        document.getElementById("otpLoginMsg").innerText = data.message;
                        if (data.retryAfterSeconds > 0) {
                            mobileVerified = mobile;
                            sessionStorage.setItem("mobileVerified", JSON.stringify(mobile));
                            startOtpTimer();
                        }
                    }
                    mobileLoginBtn.querySelector(".spinner-border").classList.add("d-none");
                    toggleElementsDisabled(mobileLoginBtn, false);
                });
        });

        window.addEventListener("popstate", (e) => {
            if (!e.state || e.state.step !== "otp") {
                clearInterval(otpIntervalId);
                otpTimerVersion++;
                mobileLoginBtn.disabled = false;
                document.getElementById("otpLoginMsg").innerText = "";
                document.getElementById("remainingCodeOtpLoginId").style.display = "none";

                document.getElementById("otpLoginForm").style.display = "block";
                document.getElementById("otpSection").style.display = "none";
                document.getElementById("resendOtpBtn").style.display = "none";

                document.getElementById("historyBackIcon").classList.add("d-none");
            }
        });

        window.addEventListener("load", () => {
            if (location.hash === "#otp") {
                mobileVerified = JSON.parse(sessionStorage.getItem("mobileVerified") || "null");
                if (!mobileVerified) {
                    history.replaceState(null, "", "/Account/OtpLogin");
                    return;
                }
                document.getElementById("phoneNumberLoginOtp").innerText = mobileVerified;
                document.getElementById("otpLoginForm").style.display = "none";
                document.getElementById("otpSection").style.display = "block";
                document.getElementById("remainingCodeOtpLoginId").style.display = "flex";
                history.replaceState({ step: "otp" }, "", location.href);
                startOtpTimer();
            }
        });

        otpBtn.addEventListener("click", () => verifyOtp());
        document.getElementById("otpLoginInp").addEventListener("keyup", (e) => {
            if (e.target.value.length >= 4 || e.key === "Enter") {
                verifyOtp();
            }
        });

        const otpLoginMsgElm = document.getElementById("otpLoginMsg");
        function verifyOtp() {
            if (otpVerifyPending || otpBtn.style.display === "none") return;
            otpVerifyPending = true;
            const inpMobileValue = document.querySelector("input[name='mobile']").value;
            const mobile = inpMobileValue ? "09" + inpMobileValue : JSON.parse(sessionStorage.getItem("mobileVerified"));
            const OtpCode = document.querySelector("input[name='otp']").value;
            toggleElementsDisabled(otpBtn);
            otpBtn.querySelector(".spinner-border").classList.remove("d-none");

            fetch(`/Account/VerifyOtpGeneric?type=@ViewBag.type`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ mobile, OtpCode }),
            }).then(res => res.json())
              .then(data => {
                  if (data.status === 300) {
                      mobileVerified = mobile;
                      showAccountModal(data.accounts);
                  } else if (data.status === 200) {
                      otpLoginMsgElm.innerText = "";
                      sessionStorage.removeItem("mobileVerified");
                      goTo(data.url);
                  } else if (data.status === 405) {
                      data.errors.forEach(err => {
                          const pElm = document.createElement("p");
                          pElm.innerText = err;
                          otpLoginMsgElm.appendChild(pElm);
                      });
                  } else {
                      otpLoginMsgElm.innerText = data.message;
                      if (data.retryAfterSeconds > 0 || data.status === 401) startOtpTimer();
                  }
              }).catch(() => {
                  otpLoginMsgElm.innerText = "ارتباط با سرور برقرار نشد. دوباره تلاش کنید.";
              }).finally(() => {
                  otpVerifyPending = false;
                  otpBtn.querySelector(".spinner-border").classList.add("d-none");
                  toggleElementsDisabled(otpBtn, false);
              });
        }

        let otpIntervalId;
        let otpTimerVersion = 0;
        function startOtpTimer() {
            clearInterval(otpIntervalId);
            const timerVersion = ++otpTimerVersion;
            let wasLocked = false;
            const mobile = mobileVerified || JSON.parse(sessionStorage.getItem("mobileVerified") || "null");
            if (!mobile) return;

            async function tick() {
                try {
                    const response = await fetch(`/Account/CheckTimerCode?type=@ViewBag.type&mobile=${encodeURIComponent(mobile)}`);
                    const data = await response.json();
                    if (timerVersion !== otpTimerVersion) return;
                    if (data.status === true) {
                        wasLocked = wasLocked || data.isLocked;
                        document.getElementById("remainingSecondsOtpLogin").innerText = data.elsapsTime + " ثانیه";
                        document.getElementById("remainingCodeOtpLoginId").style.display = "flex";
                        document.getElementById("resendOtpBtn").style.display = "none";
                        mobileLoginBtn.disabled = true;
                        otpBtn.style.display = data.isLocked ? "none" : "flex";
                        if (data.isLocked && !otpLoginMsgElm.innerText)
                            otpLoginMsgElm.innerText = "تلاش‌های ناموفق بیش از حد مجاز؛ پس از پایان زمان کد جدید دریافت کنید.";
                    } else {
                        clearInterval(otpIntervalId);
                        document.getElementById("remainingCodeOtpLoginId").style.display = "none";
                        otpBtn.style.display = "none";
                        mobileLoginBtn.disabled = false;
                        if (wasLocked)
                            otpLoginMsgElm.innerText = "زمان مسدودیت پایان یافت؛ برای ادامه کد جدید دریافت کنید.";
                        document.getElementById("resendOtpBtn").style.display =
                            document.getElementById("otpSection").style.display === "block" ? "flex" : "none";
                    }
                } catch (error) {
                    console.error("OTP timer check failed", error);
                }
            }

            tick();
            otpIntervalId = setInterval(tick, 1000);
        }

        document.getElementById("resendOtpBtn").addEventListener("click", () => {
            mobileVerified = JSON.parse(sessionStorage.getItem("mobileVerified"));
            fetch(`/Account/RequestOtp?type=@ViewBag.type`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ mobile: mobileVerified, userId: selectedUserId }),
            })
                .then(res => res.json())
                .then(data => {
                    if (data.status === 200) {
                        document.getElementById("otpLoginMsg").innerText = "";
                        document.getElementById("otpLoginInp").value = "";
                        document.getElementById("otpLoginInp").focus();
                        toastifySuccess("کد یکبار مصرف مجددا ارسال شد");
                        startOtpTimer();
                    } else {
                        document.getElementById("otpLoginMsg").innerText = data.message;
                        if (data.retryAfterSeconds > 0) startOtpTimer();
                    }
                });
        });


        function showAccountModal(accounts) {
            const listContainer = document.getElementById("accountList");
            listContainer.innerHTML = "";

            accounts.forEach(acc => {
                const btn = document.createElement("button");
                btn.type = "button";
                btn.className = "list-group-item list-group-item-action";
                btn.innerHTML = `
                    <span class="fbold" style="font-size: 14px">${acc.userName}</span>
                    <br>
                    <span style="font-size: 11px">${acc.fullName || ""}</span>
                `;

                btn.addEventListener("click", () => {
                    toggleElementsDisabled(otpBtn);
                    otpBtn.querySelector(".spinner-border").classList.remove("d-none");
                    fetch(`/Account/SelectAccount?userId=${acc.id}&type=@ViewBag.type`)
                        .then(res => res.json())
                        .then(data => {
                            if (data.status === 200) {
                                selectedUserId = acc.id;
                                $("#selectAccountModal").modal("toggle");
                                goTo(data.url);

                            } else {
                                toastifyError(data.message);
                            }
                            otpBtn.querySelector(".spinner-border").classList.add("d-none");
                            toggleElementsDisabled(otpBtn, false);
                        });
                });

                listContainer.appendChild(btn);
            });

            $("#selectAccountModal").modal("toggle");
        }


    </script>
}