@{
    ViewData["Title"] = "کنترل کیفیت مشتریان";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/qualityControlCustomer.css?release=7.5.6" asp-append-version="true" />
}

<section id="qualityControlCustomerPage" class="qc-customer-page" dir="rtl">
    <div class="qc-client-dashboard-top">
    <section class="qc-client-overview" aria-label="خلاصه وضعیت کنترل کیفیت مشتریان">
        <div class="qc-client-overview-card qc-client-overview-contact">
            <div class="qc-client-overview-head">
                <div class="qc-client-overview-heading">
                    <span class="qc-client-overview-icon" aria-hidden="true"><i class="fa fa-headset"></i></span>
                    <div class="qc-client-overview-title">وضعیت تماس مشتریان</div>
                </div>
            </div>
            <div class="qc-client-contact-summary-grid">
                <div class="qc-client-contact-summary-item">
                    <span class="qc-client-contact-summary-label">شماره نامعتبر</span>
                    <div class="qc-client-contact-summary-value">
                        <strong id="qcSummaryInvalidCustomers">—</strong><span>مشتری</span>
                    </div>
                    <button type="button" class="qc-client-overview-action" data-qc-card-status="4"
                            title="مشاهده مشتریان با شماره نامعتبر" aria-pressed="false">مشاهده</button>
                </div>
                <div class="qc-client-contact-summary-item">
                    <span class="qc-client-contact-summary-label">بدون پاسخ</span>
                    <div class="qc-client-contact-summary-value">
                        <strong id="qcSummaryNoAnswerCustomers">—</strong><span>مشتری</span>
                    </div>
                    <button type="button" class="qc-client-overview-action" data-qc-card-status="3"
                            title="مشاهده مشتریان بدون پاسخ" aria-pressed="false">مشاهده</button>
                </div>
            </div>
            <div class="qc-client-contact-summary-foot">
                <span>پیگیری امروز: <strong id="qcSummaryDueToday">—</strong></span>
                <span>فردا: <strong id="qcSummaryTomorrow">—</strong></span>
                <span>کل تلاش‌های بی‌پاسخ: <strong id="qcSummaryNoAnswerAttempts">—</strong></span>
            </div>
        </div>
        <div class="qc-client-overview-card qc-client-overview-discrepancy">
            <div class="qc-client-overview-head">
                <div class="qc-client-overview-heading">
                    <span class="qc-client-overview-icon" aria-hidden="true"><i class="fa fa-exclamation-triangle"></i></span>
                    <div class="qc-client-overview-title">اقلام دارای مغایرت</div>
                </div>
                <button type="button" class="qc-client-overview-action" data-qc-card-status="2"
                        title="مشاهده مشتریان دارای مغایرت" aria-pressed="false">مشاهده</button>
            </div>
            <div class="qc-client-overview-value">
                <strong id="qcSummaryDiscrepancyItems">—</strong><span>قلم از <b id="qcSummaryDiscrepancyTotalItems">—</b> قلم</span>
            </div>
            <div class="qc-client-overview-breakdown">
                <span>مغایرت‌های ثبت‌شده در کنترل کیفیت</span>
            </div>
        </div>
        <div class="qc-client-overview-card qc-client-overview-pending">
            <div class="qc-client-overview-head">
                <div class="qc-client-overview-heading">
                    <span class="qc-client-overview-icon" aria-hidden="true"><i class="fa fa-search"></i></span>
                    <div class="qc-client-overview-title">نیازمند بررسی</div>
                </div>
                <button type="button" class="qc-client-overview-action" data-qc-card-status="0"
                        aria-pressed="true">مشاهده</button>
            </div>
            <div class="qc-client-overview-value">
                <strong id="qcSummaryUnreviewedItems">—</strong>
                <span>قلم از <b id="qcSummaryPendingTotalItems">—</b> قلم</span>
            </div>
            <div class="qc-client-overview-breakdown qc-client-pending-breakdown">
                <div class="qc-client-pending-queue">
                    <span>در صف: <strong id="qcSummaryPendingItems">—</strong> قلم</span>
                    <span title="اقلام مشتریان دارای شماره نامعتبر یا عدم پاسخ فعال">موقتاً خارج از صف: <strong id="qcSummaryPausedItems">—</strong> قلم</span>
                </div>
                <span class="qc-client-pending-customers">مشتریان تکمیل‌نشده:
                    <strong id="qcSummaryUnfinishedCustomers">—</strong>
                    از <strong id="qcSummaryPendingTotalCustomers">—</strong> مشتری</span>
            </div>
        </div>
        <div class="qc-client-overview-card qc-client-overview-reviewed">
            <div class="qc-client-overview-head">
                <div class="qc-client-overview-heading">
                    <span class="qc-client-overview-icon" aria-hidden="true"><i class="fa fa-clipboard-check"></i></span>
                    <div class="qc-client-overview-title">اقلام بررسی‌شده</div>
                </div>
                <button type="button" class="qc-client-overview-action" data-qc-card-status="5"
                        aria-pressed="false">مشاهده</button>
            </div>
            <div class="qc-client-overview-value">
                <strong id="qcSummaryReviewedItems">—</strong><span>قلم از <b id="qcSummaryTotalItems">—</b> قلم</span>
            </div>
            <div class="qc-client-overview-breakdown">
                <span>بدون مغایرت: <strong id="qcSummaryNoDiscrepancyItems">—</strong></span>
            </div>
            <div class="qc-client-overview-progress">
                <div class="qc-client-progress-caption">
                    <span>مشتریان تکمیل‌شده: <strong id="qcSummaryCompletedCustomers">—</strong>
                        از <strong id="qcSummaryReviewedTotalCustomers">—</strong> مشتری</span>
                </div>
                <div id="qcSummaryProgressTrack" class="qc-client-progress-track" role="progressbar"
                     aria-label="درصد پیشرفت بررسی اقلام" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                    <span id="qcSummaryProgressFill" class="qc-client-progress-fill"></span>
                    <strong id="qcSummaryProgressPercent" class="qc-client-progress-percent">۰٪</strong>
                </div>
            </div>
        </div>
        </section>
    </div>

    <div class="qc-client-toolbar">
        <form id="qcCustomerSearchForm" role="search" class="qc-client-search">
            <label for="qcCustomerSearch" class="visually-hidden">جستجوی مشتری</label>
            <div class="qc-client-search-group">
                <input id="qcCustomerSearch" type="search" class="form-control"
                       placeholder="نام، کد یا موبایل مشتری" autocomplete="off" />
                <button type="submit" class="qc-client-button qc-client-primary qc-client-search-submit"
                        title="جستجو" aria-label="جستجو"><i class="fa fa-search" aria-hidden="true"></i></button>
            </div>
        </form>
        <div class="qc-client-filter">
            <label for="qcCustomerStatus">وضعیت بررسی</label>
            <select id="qcCustomerStatus" class="form-select">
                <option value="">همه</option>
                <option value="0">نیازمند بررسی</option>
                <option value="1">تکمیل‌شده</option>
                <option value="2">دارای مغایرت</option>
                <option value="3">عدم پاسخ</option>
                <option value="4">شماره نامعتبر</option>
                <option value="5">دارای اقلام بررسی‌شده</option>
            </select>
        </div>
        <div class="qc-client-filter qc-client-sort">
            <label for="qcCustomerSort">مرتب‌سازی</label>
            <select id="qcCustomerSort" class="form-select">
                <option value="pending" selected>بیشترین اقلام بررسی‌نشده</option>
                <option value="discrepancy">بیشترین اقلام دارای مغایرت</option>
                <option value="reviewed">بیشترین اقلام بررسی‌شده</option>
                <option value="latest">آخرین تغییرات</option>
                <option value="invoices">بیشترین تعداد فاکتور</option>
                <option value="orders">بیشترین تعداد سفارش</option>
                <option value="name">نام مشتری (الفبایی)</option>
                <option value="code">کد مشتری (صعودی)</option>
            </select>
        </div>
        <div class="qc-client-filter qc-client-size">
            <label for="qcCustomerPageSize">تعداد</label>
            <select id="qcCustomerPageSize" class="form-select">
                <option value="5" selected>۵</option>
                <option value="10">۱۰</option>
                <option value="25">۲۵</option>
                <option value="50">۵۰</option>
            </select>
        </div>
        <button id="qcCustomerClearFilters" type="button" class="qc-client-button qc-client-clear-filters"
                title="پاک کردن فیلترها"><i class="fa fa-trash-alt" aria-hidden="true"></i> پاک کردن فیلترها</button>
    </div>
    <div id="qcCustomerQueueFeedback" class="qc-client-feedback" role="status" aria-live="polite"></div>
    <div id="qcCustomerQueue" class="qc-client-queue" role="list"></div>
    <div class="qc-client-paging">
        <span id="qcCustomerQueueCount"></span>
        <nav id="qcCustomerPages" aria-label="صفحه‌بندی مشتریان"></nav>
    </div>

    <div class="modal fade qc-client-history-modal" id="qcContactHistoryModal" tabindex="-1"
         aria-labelledby="qcContactHistoryTitle" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h2 class="modal-title h5" id="qcContactHistoryTitle">تاریخچه تماس مشتری</h2>
                        <div id="qcContactHistoryCustomer" class="qc-client-subtitle"></div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
                </div>
                <div class="modal-body">
                    <div class="qc-client-history-toolbar">
                        <span id="qcContactHistoryFeedback" role="status" aria-live="polite"></span>
                        <label id="qcContactHistoryDeletedFilter" class="qc-client-history-filter" hidden>
                            <input id="qcContactHistoryShowDeleted" type="checkbox" />
                            نمایش سوابق حذف‌شده
                        </label>
                    </div>
                    <div id="qcContactHistoryEntries" class="qc-client-history-entries" role="list"></div>
                </div>
                <div class="modal-footer qc-client-history-footer">
                    <div id="qcContactHistoryPages"></div>
                    <button type="button" class="qc-client-button qc-client-secondary"
                            data-bs-dismiss="modal">بستن</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade qc-client-notes-modal" id="qcCustomerNotesModal" tabindex="-1"
         aria-labelledby="qcCustomerNotesModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h2 class="modal-title h5" id="qcCustomerNotesModalTitle">توضیحات مشتری</h2>
                        <div id="qcCustomerNotesModalSubtitle" class="qc-client-subtitle"></div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
                </div>
                <div class="modal-body">
                            <section class="qc-client-customer-notes" aria-labelledby="qcCustomerNotesTitle">
                                <div class="qc-client-notes-heading">
                                    <h3 id="qcCustomerNotesTitle"><i class="fa fa-sticky-note" aria-hidden="true"></i> یادداشت‌های کنترل کیفیت مشتری</h3>
                                    <span id="qcCustomerNotesCount" class="qc-client-notes-count" aria-live="polite"></span>
                                </div>
                                <div id="qcCustomerNotesList" class="qc-client-notes-list" aria-live="polite">
                                    <span class="qc-client-notes-placeholder">در حال دریافت سوابق…</span>
                                </div>
                                <button id="qcCustomerNotesMore" type="button"
                                        class="qc-client-button qc-client-outline qc-client-notes-more" hidden>مشاهده یادداشت‌های بیشتر</button>
                                <label class="qc-client-note-label" for="qcCustomerNoteText">یادداشت جدید</label>
                                <textarea id="qcCustomerNoteText" class="form-control" rows="2" maxlength="4000"
                                          placeholder="نکات مهم مشتری، نتیجه تماس یا موارد پیگیری را بنویسید..."></textarea>
                                <div class="qc-client-notes-actions">
                                    <span id="qcCustomerNoteFeedback" role="status" aria-live="polite"></span>
                                    <button id="qcCustomerNoteClear" type="button"
                                            class="qc-client-button qc-client-secondary" disabled>پاک کردن متن</button>
                                    <button id="qcCustomerNoteSave" type="button"
                                            class="qc-client-button qc-client-primary" disabled>
                                        <i class="fa fa-save" aria-hidden="true"></i> ثبت یادداشت
                                    </button>
                                </div>
                            </section>
                </div>
                <div class="modal-footer">
                    <button type="button" class="qc-client-button qc-client-secondary" data-bs-dismiss="modal">بستن</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade qc-client-modal" id="qcCustomerReviewModal" tabindex="-1" data-bs-focus="false"
         aria-labelledby="qcCustomerModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h2 class="modal-title h5" id="qcCustomerModalTitle">کنترل کیفیت اقلام مشتری</h2>
                        <div id="qcCustomerModalSubtitle" class="qc-client-subtitle"></div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
                </div>
                <div class="modal-body" id="qcCustomerReviewScroll">
                    <form id="qcCustomerReviewForm">
                        @Html.AntiForgeryToken()
                        <div id="qcCustomerFormFeedback" class="qc-client-feedback" role="status" aria-live="polite"></div>
                        <div id="qcCustomerReviewSummary" class="qc-client-review-summary"></div>
                        <div id="qcInvoiceItemSearchBar" class="qc-client-item-search" hidden>
                            <label for="qcInvoiceItemSearch">جستجو در اقلام فاکتورها</label>
                            <input id="qcInvoiceItemSearch" type="search" class="form-control"
                                   placeholder="نام یا مشخصات کالا، مقدار یا تأمین‌کننده..." autocomplete="off" />
                            <button id="qcInvoiceItemSearchClear" type="button" class="qc-client-button qc-client-secondary" disabled>
                                پاک کردن
                            </button>
                            <span id="qcInvoiceItemSearchCount" class="qc-client-search-count" aria-live="polite"></span>
                        </div>
                        <div id="qcInvoiceItemSearchEmpty" class="qc-client-search-empty" role="status" hidden>
                            قلمی مطابق جستجو پیدا نشد.
                        </div>
                        <div id="qcCustomerReviewContent" class="qc-client-review-content"></div>
                    </form>
                </div>
                <div class="modal-footer qc-client-footer">
                    <span id="qcCustomerSaveHint" class="qc-client-save-hint"></span>
                    <button type="button" id="qcCustomerSaveAll" class="qc-client-button qc-client-primary" disabled>
                        <i class="fa fa-save" aria-hidden="true"></i>
                        ثبت کلی اقلام بررسی‌نشده بدون مغایرت
                    </button>
                    <button type="button" class="qc-client-button qc-client-secondary" data-bs-dismiss="modal">بستن</button>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/qualityControlCustomer.js?release=7.5.6" asp-append-version="true"></script>
}
