@section Styles {

    <link rel="stylesheet" href="~/css/operationsTheme.css?release=7.5.6" asp-append-version="true" />
}

@{
    ViewData["Title"] = "سفارشات باز معوقه";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .overdue-filter-button {
        width: 28px;
        height: 28px;
        flex: 0 0 28px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #5b21b6;
        border-radius: .55rem;
        background: linear-gradient(135deg, #7c3aed, #4c1d95);
        color: #fff;
        box-shadow: 0 2px 7px rgba(76, 29, 149, .2);
        transition: all .18s ease;
    }

    .overdue-filter-button svg { width: 16px; height: 16px; }


        .overdue-filter-button:hover,
        .overdue-filter-button:focus-visible {
            border-color: #7c3aed;
            background: linear-gradient(135deg, #7c3aed, #5b21b6);
            color: #fff;
            box-shadow: 0 3px 8px rgba(109, 40, 217, .22);
        }


    .overdue-sort-button {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .2rem .1rem;
        border: 0;
        background: transparent;
        color: inherit;
        font: inherit;
        font-family: IranSansBold;
        cursor: pointer;
        white-space: nowrap;
    }


        .overdue-sort-button:hover,
        .overdue-sort-button:focus-visible {
            color: #6d28d9;
            outline: none;
        }


        .overdue-sort-button .sort-indicator {
            color: #8b5cf6;
            font-size: .85rem;
            opacity: .7;
        }


        .overdue-sort-button[aria-sort="ascending"] .sort-indicator,
        .overdue-sort-button[aria-sort="descending"] .sort-indicator {
            opacity: 1;
            color: #5b21b6;
        }


    .overdue-refresh-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .35rem;
        min-height: 28px;
        padding: 0 .65rem;
        border-color: #0f766e;
        border-radius: .55rem;
        background: #0f766e;
        color: #fff;
        font-family: IranSansBold;
    }


        .overdue-refresh-button:hover {
            border-color: #14b8a6;
            background: #0d9488;
            color: #fff;
        }


    .overdue-count-badge {
        background: #0f766e !important;
        color: #fff !important;
        min-width: 28px;
        padding: .4rem .65rem;
        font-family: IranSansBold;
        box-shadow: 0 3px 8px rgba(15, 118, 110, .3);
    }


    #overdueDealsTableWrap {
        border-radius: 0;
        scrollbar-width: thin;
        scrollbar-color: #c4b5fd #f5f3ff;
    }


        #overdueDealsTableWrap .table {
            --bs-table-bg: transparent;
            margin-bottom: 0;
            border-collapse: separate;
            border-spacing: 0;
            color: #334155;
        }


        #overdueDealsTableWrap thead th {
            padding: 1rem .9rem;
            background: linear-gradient(135deg, #f5f3ff, #ede9fe);
            color: #4c1d95;
            font-size: .82rem;
            font-family: IranSansBold;
            white-space: nowrap;
            border-bottom: 1px solid #ddd6fe;
        }


        #overdueDealsTableWrap tbody td {
            padding: .9rem;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
            transition: background-color .18s ease;
        }


        #overdueDealsTableWrap tbody tr:nth-child(even) {
            background-color: #faf9ff;
        }


        #overdueDealsTableWrap tbody tr:hover td {
            background-color: #f1edff;
        }


        #overdueDealsTableWrap tbody tr:last-child td {
            border-bottom: 0;
        }


    .overdue-view-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 34px;
        border: 1px solid #0f766e;
        border-radius: .65rem;
        background: #0f766e;
        color: #fff;
        transition: all .18s ease;
    }


        .overdue-view-button:hover,
        .overdue-view-button:focus-visible {
            border-color: #4c1d95;
            background: #4c1d95;
            color: #fff;
            transform: translateY(-1px);
        }


    /* Compact order metadata: five columns x two rows on desktop */
    #overdueDealDetailsContent {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: .45rem;
        margin: 0;
    }

        #overdueDealDetailsContent > .overdue-detail-cell {
            min-width: 0;
            padding: .55rem .65rem;
            border: 1px solid #dbe2ea;
            border-radius: .55rem;
            background: #fff;
            display: flex;
            align-items: baseline;
            gap: .35rem;
            overflow: hidden;
        }

    .overdue-detail-label {
        flex: 0 0 auto;
        color: #64748b;
        font-size: .72rem;
        white-space: nowrap;
    }

    .overdue-detail-value {
        min-width: 0;
        color: #1f2937;
        font-family: IranSansBold;
        font-size: .8rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .overdue-detail-cell.overdue-detail-comment {
        grid-column: span 2;
    }

    @@media (max-width: 991.98px) {
        #overdueDealDetailsContent {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 575.98px) {
        #overdueDealDetailsContent {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

            #overdueDealDetailsContent > .overdue-detail-cell {
                padding: .45rem .5rem;
                gap: .25rem;
            }

        .overdue-detail-label {
            font-size: .68rem;
        }

        .overdue-detail-value {
            font-size: .74rem;
        }

        .overdue-detail-cell.overdue-detail-comment {
            grid-column: span 2;
        }
    }


    .overdue-prefactor-row {
        align-items: stretch;
        min-width: 0;
    }

    .overdue-prefactor-actions {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        gap: 7px;
        flex: 0 0 28px;
        padding: 8px 4px;
        color: var(--DarkColor);
    }

        .overdue-prefactor-actions button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 22px;
            height: 22px;
            padding: 0;
            border: 0;
            background: transparent;
            color: var(--DarkColor);
            cursor: pointer;
            border-radius: 4px;
            transition: background-color .15s ease, color .15s ease;
        }

            .overdue-prefactor-actions button:hover,
            .overdue-prefactor-actions button:focus-visible {
                background: #ede9fe;
                color: #5b21b6;
                outline: none;
            }

            .overdue-prefactor-actions button i {
                font-size: 15px;
            }

    .overdue-prefactor-side {
        flex: 0 0 24px;
        width: 24px;
        min-height: 100%;
        border-radius: 0 8px 8px 0;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .overdue-prefactor-side-text {
        writing-mode: vertical-rl;
        white-space: nowrap;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .2px;
    }

    .overdue-prefactor-card {
        min-width: 0;
        border-radius: 8px 0 0 8px;
        padding: 10px 12px;
        box-shadow: 0 1px 3px rgba(15, 23, 42, .06);
    }

    .overdue-prefactor-main {
        display: grid;
        grid-template-columns: minmax(150px, 1.1fr) minmax(180px, 1fr) minmax(150px, 1fr);
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .overdue-prefactor-meta,
    .overdue-prefactor-financial,
    .overdue-prefactor-customer {
        display: flex;
        flex-direction: column;
        gap: 7px;
        min-width: 0;
    }

        .overdue-prefactor-meta > div,
        .overdue-prefactor-financial > div,
        .overdue-prefactor-customer > div {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 8px;
            min-width: 0;
        }

        .overdue-prefactor-meta span,
        .overdue-prefactor-financial span,
        .overdue-prefactor-customer span {
            color: #6b7280;
            flex: 0 0 auto;
            font-size: 12px;
        }

        .overdue-prefactor-meta strong,
        .overdue-prefactor-financial strong,
        .overdue-prefactor-customer strong {
            font-size: 12px;
            font-weight: 700;
            text-align: left;
            overflow-wrap: anywhere;
        }

        .overdue-prefactor-financial small {
            font-size: 10px;
            font-weight: 400;
            color: #6b7280;
        }

    @@media (max-width: 767.98px) {
        .overdue-prefactor-main {
            grid-template-columns: 1fr;
            gap: 8px;
        }

        .overdue-prefactor-meta,
        .overdue-prefactor-financial,
        .overdue-prefactor-customer {
            flex-direction: row;
            flex-wrap: wrap;
            justify-content: space-between;
            padding-bottom: 7px;
            border-bottom: 1px solid #e5e7eb;
        }

            .overdue-prefactor-meta > div,
            .overdue-prefactor-financial > div,
            .overdue-prefactor-customer > div {
                justify-content: flex-start;
                gap: 5px;
            }

            .overdue-prefactor-meta strong,
            .overdue-prefactor-financial strong,
            .overdue-prefactor-customer strong {
                text-align: right;
            }
    }

    .count-total-label {
        margin-top: 7px;
        color: #6b7280;
        font-size: .76rem;
        font-weight: 600;
    }

    .count-total-value {
        color: #263449;
        font-size: .82rem;
        font-weight: 800;
        line-height: 1.45;
        direction: rtl;
        overflow-wrap: anywhere;
    }

    .overdue-count-card-disabled {
        opacity: .52;
        cursor: not-allowed;
        filter: grayscale(.25);
    }

    .overdue-document-card {
        cursor: pointer;
        transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    }

        .overdue-document-card:hover,
        .overdue-document-card:focus-visible {
            border-color: #a78bfa;
            box-shadow: 0 5px 14px rgba(76, 29, 149, .14);
            transform: translateY(-2px);
            outline: none;
        }

    .overdue-reports-card {
        cursor: pointer;
        transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    }

        .overdue-reports-card:hover,
        .overdue-reports-card:focus-visible {
            border-color: #a78bfa;
            box-shadow: 0 5px 14px rgba(76, 29, 149, .14);
            transform: translateY(-2px);
            outline: none;
        }

    .overdue-count-card {
        border: 1px solid #e9d5ff;
        border-radius: .9rem;
        background: linear-gradient(135deg, #faf5ff, #fff);
        padding: 1rem;
        text-align: center;
        height: 100%;
    }

    .overdue-follow-up-modal {
        border: 0;
        border-radius: 1rem;
        overflow: hidden;
    }

    .overdue-follow-up-modal .modal-header {
        background: #f7faf9;
        border-bottom: 1px solid #dcebe7;
    }

    .overdue-follow-up-options {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: .75rem;
    }

    .overdue-follow-up-option {
        display: flex;
        align-items: flex-start;
        gap: .75rem;
        padding: 1rem;
        border: 1px solid #d5e4e1;
        border-radius: .8rem;
        background: #fff;
        cursor: pointer;
    }

    .overdue-follow-up-option:has(input:checked) {
        border-color: #0f766e;
        background: #f0fdfa;
        box-shadow: 0 0 0 2px #ccfbf1;
    }

    .overdue-follow-up-option:has(input:disabled) {
        background: #f8fafc;
        color: #64748b;
        cursor: not-allowed;
    }

    .overdue-follow-up-option input { margin-top: .3rem; accent-color: #0f766e; }
    .overdue-follow-up-option span { display: flex; flex-direction: column; gap: .25rem; }
    .overdue-follow-up-option small { color: #64748b; line-height: 1.7; }
    .overdue-date-expired { border-color: #dc2626 !important; color: #b91c1c !important; background: #fef2f2 !important; }
    .overdue-date-expired-note { color: #b91c1c; }

    .overdue-date-clear {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        border-color: #ddd6fe;
        background: #f5f3ff;
        color: #6d28d9;
    }

    .overdue-date-clear:hover,
    .overdue-date-clear:focus-visible {
        border-color: #a78bfa;
        background: #ede9fe;
        color: #4c1d95;
    }

    .overdue-date-clear:disabled { opacity: .45; }

    .overdue-mode-filter.filter-switch {
        flex-wrap: nowrap;
        align-items: center;
        /* height: 32px; */
        padding: 2px;
        border: 1px solid #ddd6fe;
        border-radius: .55rem;
        background: #f5f3ff;
    }

    .overdue-mode-filter.filter-switch label {
        color: #6d28d9;
        font-size: 12px;
    }

    .overdue-mode-filter .filter-switch-item input:checked + label {
        background: #6d28d9;
        color: #fff;
        box-shadow: 0 2px 6px rgba(76, 29, 149, .2);
    }

    .overdue-mode-filter .filter-switch-item input:focus-visible + label {
        outline: 2px solid #a78bfa;
        outline-offset: 2px;
    }

    @@media (max-width: 575px) {
        .overdue-follow-up-options { grid-template-columns: 1fr; }
    }


        .overdue-count-card .count-value {
            color: #4c1d95;
            font-size: 1.7rem;
            line-height: 1.3;
            font-family: IranSansBold;
        }


        .overdue-count-card .count-label {
            color: #475569;
            font-family: IranSansBold;
            margin-top: .35rem;
        }


        .overdue-count-card .count-icon {
            color: #0f766e;
            margin-bottom: .4rem;
        }


    #overdueDealsTableWrap .badge.text-bg-danger {
        padding: .45rem .65rem;
        border: 1px solid #fecaca;
        border-radius: 999px;
        background: #fff1f2 !important;
        color: #be123c !important;
        font-size: .75rem;
        font-family: IranSansBold;
    }


    #overdueDealsPagination,
    #overdueDealsPaginationTop {
        background: linear-gradient(110deg, #fff, #faf8ff);
    }


    #overdueDealsPaginationTop {
        border-bottom-color: #ede9fe !important;
    }


    #overdueDealsPagination {
        border-top-color: #ede9fe !important;
        border-radius: 0 0 .9rem .9rem;
    }


        #overdueDealsPagination label,
        #overdueDealsPaginationTop label {
            font-family: IranSansBold;
            color: #5b21b6 !important;
            white-space: nowrap;
        }


    #overduePageSize,
    #overduePageSizeTop {
        min-width: 76px;
        border-color: #ddd6fe;
        border-radius: .65rem;
        box-shadow: none;
    }


        #overduePageSize:focus,
        #overduePageSizeTop:focus {
            border-color: #8b5cf6;
            box-shadow: 0 0 0 .2rem rgba(139, 92, 246, .14);
        }


    #overduePaginationInfo,
    #overduePaginationInfoTop {
        padding: .35rem .7rem;
        border-radius: 999px;
        background: #f3e8ff;
        color: #6d28d9 !important;
        font-family: IranSansBold;
        white-space: nowrap;
    }


    #overduePaginationButtons,
    #overduePaginationButtonsTop {
        gap: .3rem;
        align-items: center;
    }


        #overduePaginationButtons .page-item,
        #overduePaginationButtonsTop .page-item {
            margin: 0;
        }


        #overduePaginationButtons .page-link,
        #overduePaginationButtonsTop .page-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 2.25rem;
            min-height: 2.25rem;
            padding: .35rem .7rem;
            border: 1px solid #e9e2ff;
            border-radius: .65rem !important;
            background: #fff;
            color: #6d28d9;
            font-size: .82rem;
            font-family: IranSansBold;
            box-shadow: 0 2px 5px rgba(76, 29, 149, .04);
            transition: all .18s ease;
        }


            #overduePaginationButtons .page-link:hover:not(:disabled),
            #overduePaginationButtonsTop .page-link:hover:not(:disabled) {
                border-color: #a78bfa;
                background: #f3e8ff;
                transform: translateY(-1px);
            }


        #overduePaginationButtons .page-item.active .page-link,
        #overduePaginationButtonsTop .page-item.active .page-link {
            border-color: #6d28d9;
            background: linear-gradient(135deg, #7c3aed, #5b21b6);
            color: #fff;
            box-shadow: 0 4px 10px rgba(109, 40, 217, .22);
        }


        #overduePaginationButtons .page-item.disabled .page-link,
        #overduePaginationButtonsTop .page-item.disabled .page-link {
            border-color: #f1f5f9;
            background: #f8fafc;
            color: #cbd5e1;
            box-shadow: none;
        }


    @@media (max-width: 767.98px) {
        #overdueDealsPagination,
        #overdueDealsPaginationTop {
            align-items: stretch !important;
        }

            #overdueDealsPagination > div,
            #overdueDealsPaginationTop > div {
                flex-wrap: wrap;
            }

            #overdueDealsPagination nav,
            #overdueDealsPaginationTop nav {
                width: 100%;
                overflow-x: auto;
                padding-bottom: .15rem;
            }

        #overduePaginationButtons,
        #overduePaginationButtonsTop {
            flex-wrap: nowrap;
            width: max-content;
        }

        #overdueDealsTableWrap .table {
            font-size: .86rem;
        }

        #overdueDealsTableWrap thead th,
        #overdueDealsTableWrap tbody td {
            padding: .75rem .65rem;
        }
    }


    @@media (prefers-reduced-motion: reduce) {
        #overdueDealsTableWrap *,
        #overdueDealsPagination *,
        #overdueDealsPaginationTop * {
            transition: none !important;
        }
    }

    /* Page-scoped design tokens and compact actions for the overdue-deals table. */
    .overdue-deal-page {
        --overdue-primary: #004944;
        --overdue-primary-action: #00665c;
        --overdue-primary-light: #e7f3f0;
        --overdue-secondary: #5811b4;
        --overdue-secondary-light: #f3edfc;
        --overdue-danger: #c2185b;
        --overdue-danger-light: #fce8f0;
        --overdue-text: #212529;
        --overdue-muted: #545961;
        --overdue-border: #dde1e8;
    }

    .overdue-deal-page .overdue-filter-button {
        border-color: var(--overdue-secondary);
        background: var(--overdue-secondary);
        box-shadow: 0 2px 7px rgb(88 17 180 / 18%);
    }

    .overdue-deal-page .overdue-filter-button:hover,
    .overdue-deal-page .overdue-filter-button:focus-visible {
        border-color: var(--overdue-secondary);
        background: #45108f;
    }

    .overdue-deal-page .overdue-sort-button:hover,
    .overdue-deal-page .overdue-sort-button:focus-visible {
        color: var(--overdue-secondary);
    }

    .overdue-deal-page .overdue-sort-button .sort-indicator,
    .overdue-deal-page .overdue-sort-button[aria-sort="ascending"] .sort-indicator,
    .overdue-deal-page .overdue-sort-button[aria-sort="descending"] .sort-indicator {
        color: var(--overdue-secondary);
    }

    .overdue-deal-page .overdue-refresh-button,
    .overdue-deal-page .overdue-count-badge {
        border-color: var(--overdue-primary-action);
        background: var(--overdue-primary-action) !important;
    }

    .overdue-deal-page .overdue-refresh-button:hover {
        border-color: var(--overdue-primary);
        background: var(--overdue-primary) !important;
    }

    .overdue-deal-page #overdueDealsTableWrap {
        scrollbar-color: var(--overdue-border) var(--overdue-primary-light);
    }

    .overdue-deal-page #overdueDealsTableWrap .table {
        color: var(--overdue-text);
    }

    .overdue-deal-page #overdueDealsTableWrap thead th {
        background: var(--overdue-primary-light);
        color: var(--overdue-primary);
        border-bottom-color: var(--overdue-border);
    }

    .overdue-deal-page #overdueDealsTableWrap tbody tr:nth-child(even) {
        background-color: #f8fbfa;
    }

    .overdue-deal-page #overdueDealsTableWrap tbody tr:hover td {
        background-color: var(--overdue-primary-light);
    }

    .overdue-deal-page #overdueDealsTableWrap tbody td:last-child {
        width: 1%;
        white-space: nowrap;
    }

    .overdue-deal-page .overdue-view-button {
        width: 32px;
        height: 30px;
        margin-inline: 1px;
        border-color: var(--overdue-primary-action);
        border-radius: .5rem;
        background: var(--overdue-primary-action);
    }

    .overdue-deal-page .overdue-view-button svg {
        width: 17px;
        height: 17px;
    }

    .overdue-deal-page .overdue-view-button:hover,
    .overdue-deal-page .overdue-view-button:focus-visible {
        border-color: var(--overdue-primary);
        background: var(--overdue-primary);
        transform: translateY(-1px);
    }

    .overdue-deal-page #overdueDealsTableWrap .badge.text-bg-danger {
        background: var(--overdue-danger-light) !important;
        color: var(--overdue-danger) !important;
        border: 1px solid rgb(194 24 91 / 20%);
    }

    .overdue-deal-page .overdue-prefactor-actions button:hover,
    .overdue-deal-page .overdue-prefactor-actions button:focus-visible,
    .overdue-deal-page .overdue-date-clear:hover,
    .overdue-deal-page .overdue-date-clear:focus-visible {
        background: var(--overdue-secondary-light);
        color: var(--overdue-secondary);
    }

    .overdue-deal-page .overdue-date-clear,
    .overdue-deal-page .overdue-mode-filter.filter-switch {
        border-color: var(--overdue-border);
        background: var(--overdue-secondary-light);
        color: var(--overdue-secondary);
    }

    .overdue-deal-page .overdue-mode-filter.filter-switch label,
    .overdue-deal-page .overdue-count-card .count-value,
    .overdue-deal-page #overdueDealsPagination label,
    .overdue-deal-page #overdueDealsPaginationTop label {
        color: var(--overdue-secondary) !important;
    }

