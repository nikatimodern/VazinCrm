@{
    ViewBag.Title = "Index";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/supplyDemand.css?release=7.5.2" asp-append-version="true" />
}

<style>
    #MotalebatTable_wrapper table.dataTable {
        font-size: clamp(11px, .8vw, 14px);
    }
    #MotalebatTable_wrapper table.dataTable thead th,
    #MotalebatTable_wrapper table.dataTable tfoot th {
        white-space: normal;
        line-height: 1.4;
        padding: 6px 4px;
    }
    #MotalebatTable_wrapper table.dataTable tbody td {
        padding: 6px 4px !important;
    }
    #MotalebatTable_wrapper table.dataTable td.wrap-text-minw {
        min-width: 120px;
    }
    #MotalebatTable_wrapper .demand-amount {
        display: inline-flex;
        align-items: baseline;
        gap: 4px;
        white-space: nowrap;
    }
    #MotalebatTable_wrapper .demand-currency {
        font-size: .8em;
        font-weight: normal;
        opacity: .7;
    }
    #customerDepositsModal .paymentTable tr.payment-unapproved > td {
        background-color: #fff1f2 !important;
        box-shadow: none !important;
    }
</style>

<div id="supplyDemandWorkspace">
    <h1>مطالبات مشتریان</h1>
    <div class="demand-table-panel">
        @*<table style=" width:100%" class="table table-striped table-hover nowrap" id="supplyDemandTable">
            <thead>
            <tr>
                <th>ردیف</th>
                <th>نام مشتری</th>
                <th>کارشناس فروش</th>
                <th>شماره سفارش</th>
                <th>تاریخ سفارش</th>
                <th>جمع مبلغ فاکتورهای سفارش</th>
                <th>دریافت نقدی</th>
                <th>مطالبات</th>
            </tr>
            </thead>
            <tbody>
            </tbody>
            <tfoot class="fbold">
            <tr>
                <td>جمع کل</td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td style="direction: ltr"></td>
                <td style="direction: ltr"></td>
                <td style="direction: ltr"></td>
            </tr>
            </tfoot>
        </table>*@
        <table style=" width:100%" class="table table-striped table-hover nowrap" id="MotalebatTable">
            <thead>
            <tr>
                <th>ردیف</th>
                <th>مشتری</th>
                <th>تعداد فاکتور</th>
                <th>جمع مبالغ فاکتور</th>
                <th>تعداد واریزی ها</th>
                <th>جمع واریزی ها</th>
                <th>تعداد برگشتی ها</th>
                <th>جمع برگشتی ها</th>
                <th>مطالبات</th>
                <th>میزان بدهی</th>
            </tr>
            </thead>
            <tbody>
            </tbody>
            <tfoot class="fbold">
            <tr>
                <th>جمع کل</th>
                <th></th>
                @for (var column = 2; column < 10; column++) {
                    <th class="direction-ltr"></th>
                }
            </tr>
            </tfoot>
        </table>
    </div>
</div>

@*<partial name="~/Views/Factor/Modals/_FactorContainerModal.cshtml" />
<partial name="~/Views/Accountancy/Modals/_InvoiceListModal.cshtml" />*@

<partial name="~/Views/Factor/Modals/_FactorContainerModal.cshtml" />
<partial name="~/Views/Accountancy/Modals/_InvoiceModal.cshtml" />
<partial name="~/Views/Accountancy/Modals/_InvoiceTransferModal.cshtml" />
<partial name="~/Views/Accountancy/Modals/_InvoiceVosolModal.cshtml" />

<div class="modal fade" id="customerDepositsModal" tabindex="-1" aria-labelledby="customerDepositsTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="customerDepositsTitle">واریزی‌های مشتری</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <fieldset id="customerDepositsFilter" class="border-0 p-0 mb-3 d-flex gap-3" aria-label="فیلتر واریزی‌ها">
                    <label class="d-flex align-items-center gap-1">
                        <input type="radio" name="customerDepositsFilter" value="all" /> همه
                    </label>
                    <label class="d-flex align-items-center gap-1">
                        <input type="radio" name="customerDepositsFilter" value="realized" checked /> واریزی
                    </label>
                </fieldset>
                <div id="customerDepositsContent"></div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script data-page-bindings="supplyDemandTBL,supplyDemandConfigFilter,modelSupplyDemand,renderDemandAmount,showFactors,showInvoices,callBackSupplyDemandFilter">
        let supplyDemandTBL;
        var supplyDemandConfigFilter = {};
        let modelSupplyDemand = { serVal: null, filt: null, _type: -1 };
        function renderDemandAmount(value) {
            return `<span class="demand-amount" dir="rtl"><bdi dir="ltr">${(value ?? 0).toLocaleString()}</bdi><small class="demand-currency">ریال</small></span>`;
        }
        document.addEventListener("DOMContentLoaded", async () => {
            enableMomentumScrollScope(document.getElementById("supplyDemandWorkspace"));
            getAllRpMotalebat();
            document.getElementById("MotalebatTable").addEventListener("click", async (event) => {
                const button = event.target.closest("[data-factor-customer-id]");
                if (!button || loadingCustomerFactors) return;
                loadingCustomerFactors = true;
                try {
                    const loaded = await getAllFactorsModal(button.dataset.factorCustomerId, 7);
                    if (!loaded) return;
                    document.getElementById("factorsTitleModal").textContent = `فاکتورهای تأییدشده مالیِ ${button.dataset.customerName}`;
                    ModalToggle("#FactorsModal", "show");
                } finally {
                    loadingCustomerFactors = false;
                }
            });
            document.getElementById("customerDepositsModal").addEventListener("shown.bs.modal", () => {
                const table = document.querySelector("#customerDepositsContent table");
                if (table && $.fn.dataTable.isDataTable(table))
                    $(table).DataTable().columns.adjust().responsive.recalc();
            });
            document.getElementById("MotalebatTable").addEventListener("click", async (event) => {
                const button = event.target.closest("[data-deposit-customer-id], [data-return-customer-id]");
                if (!button || loadingCustomerDeposits) return;
                const returnsOnly = Boolean(button.dataset.returnCustomerId);
                const customerId = button.dataset.returnCustomerId || button.dataset.depositCustomerId;
                selectedDepositCustomerId = returnsOnly ? null : customerId;
                selectedDepositsRealizedOnly = !returnsOnly;
                if (!await loadCustomerDeposits(customerId, !returnsOnly, returnsOnly)) return;
                document.getElementById("customerDepositsFilter").classList.toggle("d-none", returnsOnly);
                document.querySelector('input[name="customerDepositsFilter"][value="realized"]').checked = true;
                document.getElementById("customerDepositsTitle").textContent = `${returnsOnly ? "برگشتی‌های" : "واریزی‌های"} ${button.dataset.customerName}`;
                ModalToggle("#customerDepositsModal", "show");
            });
            document.getElementById("customerDepositsFilter").addEventListener("change", async (event) => {
                if (!selectedDepositCustomerId || loadingCustomerDeposits) return;
                const realizedOnly = event.target.value === "realized";
                selectedDepositsRealizedOnly = realizedOnly;
                if (!await loadCustomerDeposits(selectedDepositCustomerId, realizedOnly))
                    document.querySelector(`input[name="customerDepositsFilter"][value="${realizedOnly ? "all" : "realized"}"]`).checked = true;
            });
        });

        let loadingCustomerDeposits = false;
        let loadingCustomerFactors = false;
        let selectedDepositCustomerId = null;
        let selectedDepositsRealizedOnly = true;

        window.refreshSupplyDemandDeposits = async () => {
            if (!selectedDepositCustomerId || loadingCustomerDeposits) return;
            await loadCustomerDeposits(selectedDepositCustomerId, selectedDepositsRealizedOnly);
        };

        window.refreshSupplyDemandTable = () => {
            if (supplyDemandTBL)
                supplyDemandTBL.ajax.reload(null, false);
        };

        async function loadCustomerDeposits(customerId, realizedOnly, returnsOnly = false) {
            loadingCustomerDeposits = true;
            document.getElementById("customerDepositsFilter").disabled = true;
            FLshowLoading();
            try {
                const result = await getAllPaymentPartial(customerId, 5, 57, !returnsOnly, realizedOnly, returnsOnly);
                if (!result?.html) return false;
                const content = document.getElementById("customerDepositsContent");
                const oldTable = content.querySelector("table");
                if (oldTable && $.fn.dataTable.isDataTable(oldTable))
                    $(oldTable).DataTable().destroy();
                content.innerHTML = result.html;
                if (content.querySelector("table")) initPaymentPartial(57);
                return true;
            } finally {
                loadingCustomerDeposits = false;
                document.getElementById("customerDepositsFilter").disabled = false;
                FLshowLoading(false);
            }
        }

        const getAllRpMotalebat = () => {
            supplyDemandTBL = $("#MotalebatTable").DataTable({
                pageLength: 10,
                lengthMenu: [5, 10, 20, 50, 100, { label: "همه", value: -1 }],
                processing: true,
                serverSide: true,
                autoWidth: false,
                searching: true,
                search: {
                    return: true,
                },
                ordering: true,
                order: [[8, "desc"]],
                scrollCollapse: true,
                scrollY: "70dvh",
                responsive: true,
                ajax: {
                    url: `/Supply/GetRpMotalebat`,
                    type: "POST",
                    data: (d) => {
                        d.model = JSON.stringify(modelSupplyDemand);
                    },
                },
                language: languageDatatable,
                columnDefs: [
                    {
                        targets: "_all",
                        orderSequence: ["desc", "asc"],
                    },
                    {
                        targets: [1],
                        render: (data) => data ? `<span dir="ltr">${data.toLocaleString()}</span>` : "-",
                    },
                    {
                        targets: [3],
                        render: (data, type, row) => {
                            if (type !== "display") return data;
                            if (!row.customerId) return renderDemandAmount(data);
                            const button = document.createElement("button");
                            button.type = "button";
                            button.className = "hoverLink main-font border-0 bg-transparent p-0";
                            button.dir = "ltr";
                            button.dataset.factorCustomerId = row.customerId;
                            button.dataset.customerName = row.customer || "مشتری";
                            button.setAttribute("aria-label", `مشاهده فاکتورهای تأییدشده مالیِ ${row.customer || "مشتری"}`);
                            button.innerHTML = renderDemandAmount(data);
                            return button.outerHTML;
                        },
                    },
                    {
                        targets: [5, 7],
                        render: (data, type, row, meta) => {
                            if (type !== "display") return data;
                            if (!row.customerId) return renderDemandAmount(data);
                            const button = document.createElement("button");
                            button.type = "button";
                            button.className = "hoverLink main-font border-0 bg-transparent p-0";
                            button.dir = "ltr";
                            const returnsOnly = meta.col === 7;
                            button.dataset[returnsOnly ? "returnCustomerId" : "depositCustomerId"] = row.customerId;
                            button.dataset.customerName = row.customer || "مشتری";
                            button.setAttribute("aria-label", `مشاهده ${returnsOnly ? "برگشتی‌های" : "واریزی‌های"} ${row.customer || "مشتری"}`);
                            button.innerHTML = renderDemandAmount(data);
                            return button.outerHTML;
                        },
                    },
                    {
                        targets: [8, 9],
                        render: (data, type, row, meta) => type === "display"
                            ? `<span class="fbold" style="color: ${meta.col === 9 ? "#C2185B" : data > 0 ? "#00665C" : data < 0 ? "#C2185B" : "inherit"}">${renderDemandAmount(meta.col === 9 ? Math.abs(data) : data)}</span>`
                            : data,
                    },
                    {
                        targets: [0, 1],
                        orderable: false,
                    },
                ],
                columns: [
                    { data: null, render: (data, type, row, meta) => meta.settings._iDisplayStart + meta.row + 1 },
                    {
                        data: null,
                        name: "Customer",
                        autoWidth: true,
                        defaultContent: "-",
                        className: "wrap-text-minw",
                        render: function (data, type, row) {
                            const code = row.customerCode || "";
                            const name = row.customer || "";
                            if (code) return `${name} (کد مشتری: ${code})`;
                            return `${name}`;
                        },
                    },
                    { data: "factorCount", name: "FactorCount", defaultContent: "-" },
                    { data: "factorSum", name: "FactorSum", defaultContent: "-" },
                    { data: "accCount", name: "AccCount", defaultContent: "-" },
                    { data: "accSum", name: "AccSum", defaultContent: "-" },
                    { data: "retAccBackCount", name: "RetAccBackCount", defaultContent: "-" },
                    { data: "retAccBackSum", name: "RetAccBackSum", defaultContent: "-" },
                    { data: "receivableSum", name: "ReceivableSum", defaultContent: "-", className: "direction-ltr" },
                    { data: "debtSum", name: "DebtSum", defaultContent: "-", className: "direction-ltr" },
                ],

                layout: {
                    bottomEnd: "info",
                    bottomStart: {
                        paging: {
                            type: "simple_numbers",
                        },
                    },
                    topEnd: {
                        pageLength: true,
                        buttons: [
                            {
                                extend: "excel",
                                text: `<svg fill="currentColor" viewBox="0 0 256 256"><path d="M156,208a8,8,0,0,1-8,8H120a8,8,0,0,1-8-8V152a8,8,0,0,1,16,0v48h20A8,8,0,0,1,156,208ZM92.65,145.49a8,8,0,0,0-11.16,1.86L68,166.24,54.51,147.35a8,8,0,1,0-13,9.3L58.17,180,41.49,203.35a8,8,0,0,0,13,9.3L68,193.76l13.49,18.89a8,8,0,0,0,13-9.3L77.83,180l16.68-23.35A8,8,0,0,0,92.65,145.49Zm98.94,25.82c-4-1.16-8.14-2.35-10.45-3.84-1.25-.82-1.23-1-1.12-1.9a4.54,4.54,0,0,1,2-3.67c4.6-3.12,15.34-1.72,19.82-.56a8,8,0,0,0,4.07-15.48c-2.11-.55-21-5.22-32.83,2.76a20.58,20.58,0,0,0-8.95,14.95c-2,15.88,13.65,20.41,23,23.11,12.06,3.49,13.12,4.92,12.78,7.59-.31,2.41-1.26,3.33-2.15,3.93-4.6,3.06-15.16,1.55-19.54.35A8,8,0,0,0,173.93,214a60.63,60.63,0,0,0,15.19,2c5.82,0,12.3-1,17.49-4.46a20.81,20.81,0,0,0,9.18-15.23C218,179,201.48,174.17,191.59,171.31ZM40,112V40A16,16,0,0,1,56,24h96a8,8,0,0,1,5.66,2.34l56,56A8,8,0,0,1,216,88v24a8,8,0,1,1-16,0V96H152a8,8,0,0,1-8-8V40H56v72a8,8,0,0,1-16,0ZM160,80h28.68L160,51.31Z"></path></svg>`,
                                titleAttr: "اکسل",
                                title: "بهای تمام شده",
                                className: "buttonExcel",
                            },
                            "spacer",
                            {
                                extend: "print",
                                text: `<svg style="color:#fff;width:76%" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0 1 10.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0 .229 2.523a1.125 1.125 0 0 1-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0 0 21 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 0 0-1.913-.247M6.34 18H5.25A2.25 2.25 0 0 1 3 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 0 1 1.913-.247m10.5 0a48.536 48.536 0 0 0-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.659M18 10.5h.008v.008H18V10.5Zm-3 0h.008v.008H15V10.5Z" /></svg>`,
                                titleAttr: "چاپ",
                                title: "بهای تمام شده",
                                className: "buttonPrint",
                                // autoPrint: false,
                            },
                        ],
                    },
                    topStart: {
                        search: {
                            placeholder: "جستجو",
                        },
                    },
                },
                footerCallback: function () {
                    const api = this.api();
                    const totals = api.ajax.json()?.totals;
                    api.columns().every(function (index) {
                        if (index < 2) return;
                        const footer = this.footer();
                        if (!footer) return;
                        const value = totals?.[this.dataSrc()];
                        if (value == null) {
                            footer.textContent = "-";
                            footer.style.color = "inherit";
                            return;
                        }
                        if ([3, 5, 7, 8, 9].includes(index))
                            footer.innerHTML = renderDemandAmount(index === 9 ? Math.abs(value) : value);
                        else
                            footer.textContent = value.toLocaleString();
                        footer.style.color = index === 9 ? "#C2185B"
                            : index === 8 && value > 0 ? "#00665C" : "inherit";
                    });
                },
                initComplete: () => initFilterSupplyTable(),
            });

            function initFilterSupplyTable() {
                const dtSearch = document.querySelector("#MotalebatTable_wrapper .dt-search");
                const searchInput = dtSearch?.querySelector("input");
                if (!searchInput) return;
                const filterButton = `
                    <div class="btnFilter pe-md-2" data-filterVarConfig="supplyDemandConfigFilter" data-filterCallBack="callBackSupplyDemandFilter" data-filterContentId="contentSupplyDemandFilterId" data-filterInpSearchId="${searchInput.id}" onclick="ShowFilterPopup(this, ['selFilterItem'])">
                        <svg style="width:24px;height:24px;color:#333" viewBox="0 0 24 24" fill="currentColor" ><path fill-rule="evenodd" d="M3.792 2.938A49.069 49.069 0 0 1 12 2.25c2.797 0 5.54.236 8.209.688a1.857 1.857 0 0 1 1.541 1.836v1.044a3 3 0 0 1-.879 2.121l-6.182 6.182a1.5 1.5 0 0 0-.439 1.061v2.927a3 3 0 0 1-1.658 2.684l-1.757.878A.75.75 0 0 1 9.75 21v-5.818a1.5 1.5 0 0 0-.44-1.06L3.13 7.938a3 3 0 0 1-.879-2.121V4.774c0-.897.64-1.683 1.542-1.836Z" clip-rule="evenodd" /></svg>
                    </div>
                `;
                const contentFilter = `<div id="contentSupplyDemandFilterId" class="ContentFilter mt-2 mt-md-0 ms-md-2"></div>`;
                searchInput.insertAdjacentHTML("afterend", filterButton);
                const refreshButton = document.createElement("button");
                refreshButton.type = "button";
                refreshButton.className = "border-0 bg-transparent p-1 ms-2 d-inline-flex align-items-center justify-content-center";
                refreshButton.setAttribute("aria-label", "بروزرسانی جدول");
                refreshButton.innerHTML = `<svg style="width: 18px;height: 18px;color: #333" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"></path></svg>`;
                refreshButton.title = "دریافت مجدد اطلاعات و محاسبه جدول";
                refreshButton.addEventListener("click", () => {
                    if (!refreshButton.disabled) supplyDemandTBL.ajax.reload(null, false);
                });
                dtSearch.querySelector(".btnFilter").insertAdjacentElement("afterend", refreshButton);
                $("#MotalebatTable").on("processing.dt", (event, settings, processing) => {
                    refreshButton.disabled = processing;
                    refreshButton.setAttribute("aria-busy", String(processing));
                });
                dtSearch.insertAdjacentHTML("afterend", contentFilter);
            }

            supplyDemandTBL.on("search", function () {
                modelSupplyDemand.serVal = supplyDemandTBL.search();
            });

        };
        const getAllSupplyDemand = () => {
            supplyDemandTBL = $("#supplyDemandTable").DataTable({
                pageLength: 10,
                lengthMenu: [5, 10, 20, 50, 100, { label: "همه", value: -1 }],
                processing: true,
                serverSide: true,
                searching: true,
                search: {
                    return: true,
                },
                ordering: true,
                order: [[4, "desc"]],
                scrollCollapse: true,
                scrollY: "70dvh",
                responsive: true,
                ajax: {
                    url: `/Supply/GetSuppliesDemandsDt`,
                    type: "POST",
                    data: (d) => {
                        d.model = JSON.stringify(modelSupplyDemand);
                    },
                },
                language: languageDatatable,
                columnDefs: [
                    {
                        targets: [5],
                        render: (data, type, row) => data ? `<span dir="ltr" class="hoverLink main-font" onclick="showFactors('${row.dealId}')">${data.toLocaleString()}</span>` : "-",
                    },
                    {
                        targets: [6],
                        render: (data, type, row) => data ? `<span dir="ltr" class="hoverLink main-font" onclick="showInvoices('${row.dealId}')">${data.toLocaleString()}</span>` : "-",

                    },
                    {
                        targets: [7],
                        render: data => `<span dir="ltr" class="fbold" style="color: ${data < 0 ? "#C2185B" : "#00665C"};font-size: 16px">${data.toLocaleString()}</span>`,
                    },
                    {
                        targets: [0, 1, 2, 3],
                        orderable: false,
                    },

                ],
                columns: [
                    { data: null, render: (data, type, row, meta) => meta.row + 1 },
                    { data: "customerName", name: "CustomerName", defaultContent: "-" },
                    { data: "userCreatorDeal", name: "UserCreatorDeal", defaultContent: "-" },
                    { data: "dealSerialNumber", name: "DealSerialNumber", defaultContent: "-" },
                    { data: "dealDate", name: "DealDate", defaultContent: "-" },
                    { data: "totalFactorsAmount", name: "TotalFactorsAmount", defaultContent: "-" },
                    { data: "totalAccAmount", name: "TotalAccAmount", defaultContent: "-" },
                    { data: "demand", name: "Demand", defaultContent: "-" },
                ],

                layout: {
                    bottomEnd: "info",
                    bottomStart: {
                        paging: {
                            type: "simple_numbers",
                        },
                    },
                    topEnd: {
                        pageLength: true,
                        buttons: [
                            {
                                extend: "excel",
