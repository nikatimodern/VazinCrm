@model CRM.Core.Domain.Targets.Models.TargetSetup
@{
    ViewData["Title"] = "مدیریت تارگت‌ها";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var persianYear = new System.Globalization.PersianCalendar().GetYear(DateTime.Today);
}

@section Styles {
    <link rel="stylesheet" href="~/css/targets.css?release=7.5.1" asp-append-version="true" />
}

<section class="target-page" id="targetPage" dir="rtl" data-current-year="@persianYear">
    <header class="target-page-header">
        <div>
            <h1>مدیریت تارگت‌ها</h1>
            <p>ثبت هدف‌های سالانه، تقسیم ماهانه و تخصیص به کارشناسان فروش</p>
        </div>
        <button type="button" class="target-btn target-btn-primary" id="targetNew">+ تارگت جدید</button>
    </header>
    <div class="target-list-panel">
        <div class="target-list-header">
            <h2>تارگت‌های ثبت‌شده</h2>
            <button class="target-btn target-btn-muted" type="button" id="targetRefresh">به‌روزرسانی</button>
        </div>
        <div id="targetListFeedback" role="status" aria-live="polite"></div>
        <div id="targetList" class="target-list"></div>
    </div>

    <div class="modal fade target-modal" id="targetWizard" tabindex="-1" data-bs-focus="false"
         aria-labelledby="targetWizardTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl modal-fullscreen-sm-down">
            <form class="modal-content" id="targetWizardForm" novalidate>
                    @Html.AntiForgeryToken()
                    <div class="modal-header target-modal-header">
                        <div class="target-modal-title">
                            <h2 id="targetWizardTitle">تارگت جدید</h2>
                            <span id="targetModalStatus">پیش‌نویس</span>
                        </div>
                        <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="بستن"></button>
                    </div>
                    <div class="target-steps" aria-label="مراحل ثبت تارگت">
                        <button type="button" data-target-step="0" class="active"><span>۱</span> سالانه</button>
                        <button type="button" data-target-step="1"><span>۲</span> ماهانه</button>
                        <button type="button" data-target-step="2"><span>۳</span> تخصیص کارشناسان</button>
                        <button type="button" data-target-step="3"><span>۴</span> بررسی نهایی</button>
                    </div>
                    <div class="modal-body target-modal-body">
                        <details class="target-summary" id="targetPreviousSummary" open>
                            <summary>خلاصه اطلاعات مراحل قبل</summary>
                            <div id="targetSummaryContent"></div>
                        </details>
                        <p class="target-feedback" id="targetFormFeedback" role="alert" aria-live="polite" hidden></p>

                        <section data-target-panel="0" class="target-step-panel">
                            <div class="target-step-heading target-annual-heading">
                                <div class="target-annual-intro">
                                    <h3>تعریف اهداف سالانه</h3>
                                    <p>سال شمسی و هدف سالانه هر شاخص را وارد کنید.</p>
                                </div>
                                <div class="target-annual-actions">
                                    <label class="target-year-field" for="targetYear" data-target-editor>
                                        <span>سال شمسی</span>
                                        <input id="targetYear" name="year" type="text" inputmode="numeric" pattern="[0-9]{4}" maxlength="4"
                                               value="@persianYear" required />
                                    </label>
                                    <button type="button" class="target-btn target-btn-outline target-table-toggle" data-target-table-toggle>نمایش همه به‌صورت جدول</button>
                                </div>
                            </div>
                            <div id="targetAnnualFields" class="target-form-grid" data-target-editor></div>
                            <div class="target-flat-view" data-target-table-view hidden></div>
                        </section>

                        <section data-target-panel="1" class="target-step-panel" hidden>
                            <div class="target-step-heading">
                                <div class="target-step-heading-row"><h3>تقسیم اهداف بین ماه‌ها</h3><button type="button" class="target-btn target-btn-outline target-table-toggle" data-target-table-toggle>نمایش همه به‌صورت جدول</button></div>
                                <p>سیستم تقسیم اولیه را انجام می‌دهد؛ تمام مقادیر قابل ویرایش هستند.</p>
                            </div>
                            <div class="target-stage-editor" data-target-editor>
                                <nav id="targetMonthlyTabs" class="target-month-tabs" aria-label="انتخاب ماه برای تارگت‌گذاری"></nav>
                                <div class="target-toolbar">
                                    <button type="button" class="target-btn target-btn-muted" id="targetRebalance">تقسیم مجدد پیش‌فرض</button>
                                    <span id="targetMonthlyFeedback" role="status"></span>
                                </div>
                                <div id="targetMonthlyFields" class="target-month-grid"></div>
                            </div>
                            <div class="target-flat-view" data-target-table-view hidden></div>
                        </section>

                        <section data-target-panel="2" class="target-step-panel" hidden>
                            <div class="target-step-heading">
                                <div class="target-step-heading-row target-expert-heading-row">
                                    <h3>تخصیص تارگت به کارشناسان</h3>
                                    <div class="target-expert-heading-actions">
                                        <div class="target-expert-picker" id="targetExpertPicker">
                                            <label for="targetExpertSelect">کارشناس فروش</label>
                                            <select id="targetExpertSelect" aria-label="انتخاب کارشناس فروش"></select>
                                            <span id="targetExpertProgress" aria-live="polite"></span>
                                        </div>
                                        <button type="button" class="target-btn target-btn-outline target-table-toggle" data-target-table-toggle>نمایش همه به‌صورت جدول</button>
                                    </div>
                                </div>
                                <p>برای هر ماه، سهم کارشناسان را مشخص کنید.</p>
                            </div>
                            <div class="target-stage-editor" data-target-editor>
                                <nav id="targetExpertTabs" class="target-month-tabs" aria-label="انتخاب ماه تخصیص به کارشناسان"></nav>
                                <details class="target-month-summary">
                                    <summary>مشاهده اهداف ماه انتخاب‌شده</summary>
                                    <div id="targetCurrentMonthTargets" class="target-month-totals"></div>
                                </details>
                                <div id="targetExpertFields" class="target-expert-grid"></div>
                                <div id="targetAllocationFeedback" role="status" aria-live="polite"></div>
                            </div>
                            <div class="target-flat-view" data-target-table-view hidden></div>
                        </section>

                        <section data-target-panel="3" class="target-step-panel" hidden>
                            <div class="target-step-heading">
                                <div class="target-step-heading-row"><h3>بررسی و ثبت نهایی</h3><button type="button" class="target-btn target-btn-outline target-table-toggle" data-target-table-toggle>نمایش همه به‌صورت جدول</button></div>
                                <p>مجموع هدف‌های ماهانه و سهم کارشناسان را پیش از ثبت نهایی بررسی کنید.</p>
                            </div>
                            <div id="targetReview" data-target-editor></div>
                            <div class="target-flat-view" data-target-table-view hidden></div>
                        </section>
                    </div>
                    <div class="modal-footer target-modal-footer">
                        <button type="button" class="target-btn target-btn-muted" id="targetBack">مرحله قبل</button>
                        <div class="target-footer-actions">
                            <button type="button" class="target-btn target-btn-outline" id="targetSaveDraft">ذخیره پیش‌نویس</button>
                            <button type="button" class="target-btn target-btn-primary" id="targetNext">مرحله بعد</button>
                            <button type="button" class="target-btn target-btn-primary" id="targetFinish" hidden>ثبت نهایی</button>
                        </div>
                    </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/targets.js?release=7.5.1" asp-append-version="true"></script>
}
