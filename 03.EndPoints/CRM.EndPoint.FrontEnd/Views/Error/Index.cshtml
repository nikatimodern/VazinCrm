@{
    var statusCode = ViewBag.StatusCode;
    var errorMessage = ViewBag.ErrorMessage;
    Layout = statusCode == 404 ? "_Layout" : null;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <title>خطای @statusCode</title>
    <link rel="stylesheet" href="~/css/site.css">
    <style>
        .err-container {
            & {
                width: 100%;
                max-width: 500px;
                margin: auto;
                padding: 24px;
                text-align: center;
            }

            & .icon {
                margin: 0 auto 0;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
            }


            & .icon img {
                width: 100%;
                max-width: 320px;
            }


            & h1 {
                margin: 0 0 16px;
                font-size: 32px;
                color: #1f2937;
                font-family: IRANSansBold, serif;
            }

            & h3 {
                margin: 0 0 32px;
                font-size: 18px;
                color: #1f2937;
                font-family: IRANSansMedium, serif;
                font-weight: normal;
            }


            & p {
                margin: 0 0 24px;
                font-size: 14px;
                line-height: 1.8;
                color: #4b5563;
            }


            & button {
                all: unset;
                cursor: pointer;
                display: inline-block;
                padding: .5rem 1rem;
                border-radius: .5rem;
                background: #004944;
                color: #fff;
                font-size: 1rem;
                transition: transform .1s ease, box-shadow .1s ease;
            }


            & button:active {
                transform: translateY(1px);
                box-shadow: 0 2px 6px rgba(0, 0, 0, .15) inset;
            }


            @@media (max-width: 480px) {
                & h3 {
                    font-size: 16px;
                }

                & h1 {
                    font-size: 26px;
                }

                & .icon img {
                    max-width: 280px;
                }

                & p {
                    font-size: 13px;
                }
            }


        }
    </style>
</head>
<body>

<div class="err-container">
    <div class="icon">
        <img src="@(statusCode == 404 ? "/static/404.png" : "/static/500.png")" alt="error">
    </div>
    <h1>خطای @statusCode</h1>
    @switch (statusCode) {
        case 404: {
            <h3>@(string.IsNullOrEmpty(errorMessage) ? "صفحه‌ای که دنبال آن بودید پیدا نشد!" : errorMessage)</h3>
            <a href="/">
                <button>بازگشت به صفحه اصلی</button>
            </a>
            break;
        }
        case >= 500: {
            <h3>در حال حاضر امکان پردازش درخواست وجود ندارد!</h3>
            <button onclick="location.reload()">بارگذاری مجدد</button>
            break;
        }
        default: {
            <h3>در انجام درخواست مشکلی به وجود آمده!</h3>
            <button onclick="location.reload()">بارگذاری مجدد</button>
            break;
        }
    }

</div>

</body>
</html>