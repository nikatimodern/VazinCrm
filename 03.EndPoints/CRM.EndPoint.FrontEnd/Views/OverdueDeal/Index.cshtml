            const pageSizeSelect = document.getElementById("overduePageSize");
            const pageSizeSelectTop = document.getElementById("overduePageSizeTop");
            const pagination = document.getElementById("overdueDealsPagination");
            const paginationTop = document.getElementById("overdueDealsPaginationTop");
            const paginationInfo = document.getElementById("overduePaginationInfo");
            const paginationInfoTop = document.getElementById("overduePaginationInfoTop");
            const paginationButtons = document.getElementById("overduePaginationButtons");
            const paginationButtonsTop = document.getElementById("overduePaginationButtonsTop");
            const searchInput = document.getElementById("overdueDealSearch");
            let allDeals = [];
            let currentPage = 1;
            let pageSize = 20;
            let overdueFilter = null;
            let overdueSearchVal = "";
            let sortBy = "createDate";
            let sortDirection = "desc";
            let listRequestId = 0;
            let detailsRequestId = 0;
            let followUpDeal = null;
            let followUpRequestId = 0;
            const followUpModalElement = document.getElementById("overdueFollowUpModal");
            const followUpModal = followUpModalElement && window.bootstrap?.Modal
                ? new bootstrap.Modal(followUpModalElement) : null;
            const followUpDate = document.getElementById("overdueFollowUpDate");
            const followUpNote = document.getElementById("overdueFollowUpNote");
            const followUpError = document.getElementById("overdueFollowUpError");
            const expiredDateNote = document.getElementById("overdueFollowUpExpiredNote");
            window.overdueFollowUpDateSelected = () => {
                followUpDate.classList.remove("overdue-date-expired");
                expiredDateNote.classList.add("d-none");
