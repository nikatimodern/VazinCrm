<!-- Modal Filter -->
<div class="modal fade " dir="ltr" id="FilterModal" tabindex="-1" role="dialog" data-bs-focus="false" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class=" modal-dialog modal-dialog-centered " role="document">
        <div class="mp modal-content col-12  " style="border-radius:10px;">
            <div class=" modal-body" style=" direction:rtl; display:flex;justify-content:center ">
                <form id="FilterFormId" class="InfoData" style=" padding-inline: 8px !important; width:100%; display:flex;flex-direction:column;height:100%;justify-content:space-between;gap:10px ">
                    <div id="cusFilterItem" style=" display:flex;flex-direction:column;align-items:start ">
                        <div class="checkbox-wrapper-20">
                            <div class="switch">
                                <label for="CusFilterChd" style="font-family:IRANSansBold; font-size:clamp(16px,2vw,18px);">مشتری</label>

                                <input id="CusFilterChd" name="CusFilterChd" class="input" type="checkbox" />
                                <label for="CusFilterChd" class="slider"></label>
                            </div>
                        </div>
                        <div class="disableDiv" id="CusFilterDivContent" style="margin-top:10px; width:100%">
                            <select style="width:100%;" class="form-control" id="customerFilter" name="customerFilter">
                            </select>
                        </div>
                    </div>
                    @if (User.IsAdmin() || User.IsSalesAdmin() || User.IsTaminAdmin() || User.IsFinancial() || User.IsManagingDirector()) {
                        <div id="selFilterItem" class="d-flex flex-column">
                            <div class="checkbox-wrapper-20">
                                <div class="switch">
                                    <label id="SelFilterLabel" for="SelFilterChd" style="font-family:IRANSansBold; font-size:clamp(16px,2vw,18px);">کارشناس فروش</label>

                                    <input id="SelFilterChd" name="SelFilterChd" class="input" type="checkbox" />
                                    <label for="SelFilterChd" class="slider"></label>
                                </div>
                            </div>
                            <div class="disableDiv" id="SelFilterDivContent" style="margin-top:10px; width:100%">
                                <select style="width:100%;" class="form-control" id="selFilter" name="selFilter">
                                </select>
                            </div>
                        </div>
                    }
                    <div id="dateFilterItem" style=" display:flex;flex-direction:column;align-items:start ">
                        <div class="d-flex align-items-end justify-content-between flex-wrap gap-2 w-100">
                            <div class="checkbox-wrapper-20">
                                <div class="switch">
                                    <label for="DateFilterChk" style="font-family:IRANSansBold; font-size:clamp(16px,2vw,18px);">تاریخ</label>

                                    <input id="DateFilterChk" name="DateFilterChk" class="input" type="checkbox" />
                                    <label for="DateFilterChk" class="slider"></label>
                                </div>
                            </div>
                            <div class="d-flex align-items-center justify-content-end flex-grow-1 gap-2 disableDiv" id="dateFilterBtnId">
                                <button type="button" class="buttonGray yearBtn" style="font-size:11px" onclick="getDateFilter(1, this)">سال جاری</button>
                                <button type="button" class="buttonGray monthBtn" style="font-size:11px" onclick="getDateFilter(2, this)">ماه جاری</button>
                                <button type="button" class="buttonGray weekBtn" style="font-size:11px" onclick="getDateFilter(3, this)">هفته جاری</button>
                                <button type="button" class="buttonGray dayBtn" style="font-size:11px" onclick="getDateFilter(4, this)">روز جاری</button>
                            </div>
                        </div>

                        <div class="disableDiv gap-2" id="DateFilterDivContent" style="  margin-top:10px; width:100%;  display:flex; justify-content:space-evenly ">
                            <div style="display:flex;align-items:center;gap:4px;flex-grow:1">
                                <label style="font-family:IRANSansBold; ">از:</label>
                                <input class="sdate form-control" data-onSelect="onSelectFilterDate" name="fromDate" placeholder="ابتدا" />
                            </div>
                            <div style="display:flex;align-items:center;gap:4px;flex-grow:1">
                                <label style="font-family:IRANSansBold; ">تا:</label>
                                <input class="sdate form-control" data-onSelect="onSelectFilterDate" name="toDate" placeholder="امروز" />
                            </div>
                        </div>
                    </div>

                    <div class="gap-1 mt-2" style=" display:flex;flex-direction:row-reverse; justify-content:end; ">
                        <button style="padding-block:4px" type="button" class="buttonGreen3" onclick="FilterAccepted()"> تایید</button>
                        <button style="padding-block:4px" type="button" data-bs-dismiss="modal" class="buttonCancel2">انصراف</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


