@model CRM.EndPoint.FrontEnd.Models.Admin.AdminViewModel

<div class="col-md-12 d-flex flex-column align-items-center justify-content-center">
    <div class="col-12 col-md-12">
        <div class="mb-2 d-flex justify-content-between align-items-center">
            <p class="fmp" style="font-size:16px; font-family:'IRANSansBold'">لیست کاربران ثبت شده</p>
            <div class="d-flex align-items-center gap-2">
                <button class="buttonGreen0 d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#createUserModal">
                    <i class="fa fa-plus"></i> کاربر جدید
                </button>
                <button class="buttonGray2 d-flex align-items-center gap-1" onclick="goTo('/RoleManager/index')">
                    <i class="fa fa-user"></i> نقش جدید
                </button>
            </div>
        </div>

        <div style="width: 99%">
            <table id="usersTable" class="table-hover table table-bordered table-striped display responsive nowrap pt-2 w-100">
                <thead>
                <tr>
                    <th>نام</th>
                    <th>نام خانوادگی</th>
                    <th>نام کاربری</th>
                    <th>نقش ها</th>
                    <th>تلفن همراه</th>
                    <th>پست الکترونیکی</th>
                    <th>شماره داخلی</th>
                    <th>عملیات</th>
                </tr>
                </thead>
                <tbody>
                @if (!Model.Users.Any()) {
                    <tr>
                        <td colspan="6" class="text-center">کاریری بافت نشد</td>
                    </tr>
                } else {
                    foreach (var user in Model.Users) {
                        var isLock = user.LockoutEnd.HasValue && user.LockoutEnd.Value > DateTime.UtcNow;
                        <tr data-user-name="@user.UserName" data-user-id="@user.Id" class="@(isLock ? "tableRow-bgRed" : user.IsEmployee ? "tableRow-bgGreen" : "")">
                            <td>@user.FirstName</td>
                            <td>@user.LastName</td>
                            <td>@user.UserName</td>
                            <td class="user-roles-cell">
                                <span class="d-flex align-items-center flex-wrap gap-1">
                                    @if (user.RolsUsers.Any()) {
                                        foreach (var item in user.RolsUsers) {
                                            <span class="buttonGray d-flex align-items-center gap-1">
                                                <span class="role-remove-button d-flex align-items-center justify-content-center border-0 cursor-pointer" role="button" title="حذف نقش" onclick="DelUserRole(this, '@user.Id', '@item', '@user.UserName')">
                                                    <svg style="width: 16px;height: 16px" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
                                                </span>
                                                @item
                                            </span>
                                        }
                                    }
                                </span>
                            </td>
                            <td>@user.PhoneNumber</td>
                            <td>@user.Email</td>
                            <td>@user.InternalTels</td>
                            <td style="color:#02615a">

                                <a style="cursor: pointer;color: #04857c" asp-action="Edit" asp-route-id="@user.Id">
                                    <i class="fa fa-pencil" style="font-size: 16px;"></i>
                                </a>
                                <span style="color: #631617;">
                                    <span class="delete-user-button" style="color: #9d0000;cursor: pointer" onclick="deleteUser(this, '@user.Id')">
                                        <i class="fa fa-trash" style="font-size: 16px;"></i>
                                    </span>
                                </span>
                                <span style="cursor: pointer;color: #04857c" onclick="openUserRolesModal('@user.UserName')">
                                    <i class="fa fa-user" style="font-size: 16px"></i>
                                </span>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>


<partial name="Modals/_RolesModal" model="Model" />
<partial name="Modals/_CreateUserModal" model="new CRM.EndPoint.FrontEnd.Models.Login.CreateModel()" />

<style>
    #usersTable tbody tr.newly-created-user-row > td {
        animation: newUserHighlight 1s ease-in-out 3;
        outline: 2px solid #0d9488;
        outline-offset: -2px;
    }

    @@keyframes newUserHighlight {
        0%, 100% { background-color: transparent; }
        50% { background-color: #b7f7d8; }
    }
</style>

@section Scripts {
    <script defer>
        document.addEventListener("DOMContentLoaded", function () {
            $("#usersTable").DataTable({
                pageLength: 10,
                lengthMenu: [5, 10, 20, 50, { label: "همه", value: -1 }],
                scrollCollapse: true,
                scrollY: "70dvh",
                responsive: true,
                order: [[1, "asc"]],
                language: languageDatatable,
                layout: layoutDatatable,
                columnDefs: [
                    {
                        targets: [4, 5, 3],
                        orderable: false,
                    },
                ],
            });
        });

        function appendCreatedUserToTable(user) {
            const row = document.createElement("tr");
            row.dataset.userName = user.userName;
            row.dataset.userId = user.id;
            [user.firstName, user.lastName, user.userName].forEach(value => {
                const cell = document.createElement("td");
                cell.textContent = value || "";
                row.appendChild(cell);
            });
            const rolesCell = document.createElement("td");
            rolesCell.className = "user-roles-cell";
            rolesCell.innerHTML = '<span class="d-flex align-items-center flex-wrap gap-1"></span>';
            row.appendChild(rolesCell);
            [user.phoneNumber, user.email, user.internalTels || ""].forEach(value => {
                const cell = document.createElement("td");
                cell.textContent = value || "";
                row.appendChild(cell);
            });
            const actions = document.createElement("td");
            actions.style.color = "#02615a";
            const edit = document.createElement("a");
            edit.href = "/Admin/Edit?id=" + encodeURIComponent(user.id);
            edit.style.cssText = "cursor:pointer;color:#04857c;margin-left:6px";
            edit.innerHTML = '<i class="fa fa-pencil" style="font-size:16px"></i>';
            const deleteWrap = document.createElement("span");
            deleteWrap.style.cssText = "color:#631617;margin-left:6px";
            const deleteButton = document.createElement("span");
            deleteButton.className = "delete-user-button";
            deleteButton.style.cssText = "color:#9d0000;cursor:pointer";
            deleteButton.onclick = () => deleteUser(deleteButton, user.id);
            deleteButton.innerHTML = '<i class="fa fa-trash" style="font-size:16px"></i>';
            deleteWrap.appendChild(deleteButton);
            const roleButton = document.createElement("span");
            roleButton.style.cssText = "cursor:pointer;color:#04857c";
            roleButton.onclick = () => openUserRolesModal(user.userName);
            roleButton.innerHTML = '<i class="fa fa-user" style="font-size:16px"></i>';
            actions.append(edit, deleteWrap, roleButton);
            row.appendChild(actions);

            // Make the newly created user visible even if DataTables is on another page.
            const table = $("#usersTable").DataTable();
            table.row.add(row).draw(false);
            table.search(user.userName).draw();

            const createdRow = Array.from(document.querySelectorAll("#usersTable tbody tr"))
                .find(item => item.dataset.userId === String(user.id));

            if (createdRow) {
                createdRow.tabIndex = -1;
                createdRow.classList.add("newly-created-user-row");
                createdRow.scrollIntoView({ behavior: "smooth", block: "center" });
                createdRow.focus({ preventScroll: true });

                window.setTimeout(() => {
                    createdRow.classList.remove("newly-created-user-row");
                }, 4000);
            }
        }

        async function DelUserRole(buttonElement, id, role, userName) {
            if (typeof axios === "undefined") {
                Swal.fire({ icon: "error", text: "کتابخانه Axios در صفحه بارگذاری نشده است." });
                return;
            }

            const badge = buttonElement.closest(".buttonGray");
            if (!badge || badge.dataset.deleting === "true") return;

            const originalContent = badge.innerHTML;
            badge.dataset.deleting = "true";
            badge.style.pointerEvents = "none";
            badge.style.opacity = "0.65";
            badge.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-label="در حال حذف"></span><span>در حال حذف...</span>';

            try {
                const payload = new URLSearchParams();
                payload.append("id", id);
                payload.append("role", role);
                const token = document.querySelector('#userRolesForm input[name="__RequestVerificationToken"]');
                if (token) payload.append("__RequestVerificationToken", token.value);

                await axios.post("/Admin/DelUserRol", payload, {
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded",
                        "X-Requested-With": "XMLHttpRequest"
                    },
                    timeout: 15000
                });

                const rolesResponse = await axios.get("/Admin/GetUserRoles", {
                    params: { userName: userName },
                    headers: { "X-Requested-With": "XMLHttpRequest" },
                    timeout: 15000
                });

                if (typeof updateUserRolesTable === "function") {
                    updateUserRolesTable(userName, rolesResponse.data || []);
                } else {
                    badge.remove();
                }
            } catch (error) {
                badge.innerHTML = originalContent;
                badge.style.pointerEvents = "";
                badge.style.opacity = "";
                delete badge.dataset.deleting;
                Swal.fire({
                    icon: "error",
                    text: error.response?.data?.message || "حذف نقش انجام نشد. دوباره تلاش کنید."
                });
            }
        }
        async function deleteUser(buttonElement, id) {
            const confirmation = await Swal.fire({
                title: "حذف دائمی!",
                text: "آیا از حذف این کاربر مطمئن هستید؟ این عمل غیرقابل بازگشت است و کاربر برای همیشه پاک می‌شود.",
                icon: "warning",
                showCancelButton: true,
                cancelButtonColor: "#adadad",
                confirmButtonColor: "#e64942",
                cancelButtonText: "انصراف",
                confirmButtonText: "بله، حذف شود",
                theme: "dark",
            });

            if (!confirmation.isConfirmed) return;
            if (typeof axios === "undefined") {
                Swal.fire({ icon: "error", text: "کتابخانه Axios در صفحه بارگذاری نشده است." });
                return;
            }

            const row = buttonElement.closest("tr");
            if (!row || row.dataset.deleting === "true") return;

            const originalContent = buttonElement.innerHTML;
            row.dataset.deleting = "true";
            row.style.opacity = "0.6";
            row.style.pointerEvents = "none";
            buttonElement.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-label="در حال حذف"></span>';
            buttonElement.title = "در حال حذف کاربر...";

            try {
                const token = document.querySelector('#userRolesForm input[name="__RequestVerificationToken"]');
                const payload = new URLSearchParams({ id: id });
                if (token) payload.append("__RequestVerificationToken", token.value);

                const response = await axios.post("/Admin/Delete", payload, {
                    headers: { "Content-Type": "application/x-www-form-urlencoded", "X-Requested-With": "XMLHttpRequest" },
                    timeout: 15000
                });

                if (!response.data || response.data.success !== true) {
                    throw new Error(response.data?.message || "حذف کاربر ناموفق بود.");
                }

                $("#usersTable").DataTable().row(row).remove().draw(false);
                await Swal.fire({
                    icon: "success",
                    title: "حذف شد",
                    text: "کاربر با موفقیت حذف شد.",
                    timer: 1500,
                    showConfirmButton: false
                });
            } catch (error) {
                row.style.opacity = "";
                row.style.pointerEvents = "";
                delete row.dataset.deleting;
                buttonElement.innerHTML = originalContent;
                buttonElement.title = "";
                Swal.fire({
                    icon: "error",
                    title: "خطا در حذف",
                    text: error.response?.data?.message || error.message || "حذف کاربر انجام نشد. دوباره تلاش کنید."
                });
            }
        }

    </script>


}

