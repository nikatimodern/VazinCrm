@using CRM.Core.Domain.Reports.Enum
@model List<CRM.Core.Domain.Reports.Entities.Report>
@{
    ViewData["Title"] = "GetAllReportPartial";
    // Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container-reports">

    @if (Model.Count == 0) {
        <div class="d-flex flex-column align-items-center pb-4">
            <img src="/Img/no-data.jpg" style="width: clamp(120px, 20vw, 180px)" alt="">
            <div style="color: #506a77;font-size: clamp(13px, 2.5vw, 15px)">هیچ گزارشی برای نمایش وجود ندارد!</div>
        </div>
    }
    @foreach (var item in Model.OrderByDescending(f => f.CreateDate)) {
        var badgeClass = item.ReportType switch {
            ReportTypeEnum.گزارش_پیگیری => "report-follow-up",
            ReportTypeEnum.گزارش_تماس_های_ورودی => "report-call",
            ReportTypeEnum.گزارش_رضایتمندی => "report-satisfaction",
            _ => ""
        };
        var hasTimeline = item.AI && item.Participants != null && item.Participants.Count > 1;
        <div class="report-wrapper">
            @* <img class="reporter-image" src="@(string.IsNullOrEmpty(item.UserImage) ? "/Img/User.png" : item.UserImage)" /> *@
            <div class="report-sidebar-timeline @(hasTimeline ? "has-timeline" : "")">
                <img class="reporter-image main-avatar" src="@(string.IsNullOrEmpty(item.UserImage) ? "/Img/User.png" : item.UserImage)" />

                @if (hasTimeline) {
                    <div class="timeline-connection-line"></div>

                    var transfers = item.Participants.OrderBy(p => p.SortOrder).Skip(1).ToList();
                    foreach (var participant in transfers) {
                        <img class="reporter-image transfer-avatar"
                             src="@(string.IsNullOrEmpty(participant.UserImage) ? "/Img/User.png" : participant.UserImage)"
                             title="انتقال به: @participant.UserFullName" />
                    }
                }
            </div>
            <div class="report-box @badgeClass">
                <div class="report-badges">
                    @if (item.AI) {
                        if (item.CallRecordingId != null && (ViewBag.IsManager || item.UserCreatorID == ViewBag.CurrentUserId)) {
                            <button data-title-right="پخش ضبط تماس" onclick="playAudio('/Report/GetCallAudio?callId=@(item.CallRecordingId)')">
                                <svg style="width: 22px;color: #5b21b6" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12Zm14.024-.983a1.125 1.125 0 0 1 0 1.966l-5.603 3.113A1.125 1.125 0 0 1 9 15.113V8.887c0-.857.921-1.4 1.671-.983l5.603 3.113Z" clip-rule="evenodd" /></svg>
                            </button>
                        }

                        <span class="report-ai-badge" title="تولید شده با هوش مصنوعی">
                            <img src="~/Img/ai-svg.svg" class="ai-svg-icon" alt="AI" />
                        </span>
                    }
                    <span class="report-type-badge">@item.ReportTypeTxt</span>
                </div>

                <div class="d-flex flex-column w-100">
                    <span class="reporter-name">@item.CustomerTxt</span>

                    <div class="report-text">
                        <span style="white-space: pre-wrap">@item.ReportText?.Trim()</span>
                        @if (!string.IsNullOrEmpty(item.ResultCallTxt) || !string.IsNullOrEmpty(item.FinalResultCallTxt) || !string.IsNullOrEmpty(item.ReasonCancelTxt)) {
                            <p class="d-flex flex-wrap column-gap-2">
                                @if (!string.IsNullOrEmpty(item.ResultCallTxt)) {
                                    <span>(نتیجه تماس: @item.ResultCallTxt)</span>
                                }
                                @if (!string.IsNullOrEmpty(item.FinalResultCallTxt)) {
                                    <span>(نتیجه نهایی: @item.FinalResultCallTxt)</span>
                                }
                                @if (!string.IsNullOrEmpty(item.ReasonCancelTxt)) {
                                    <span>(علت انصراف: @item.ReasonCancelTxt)</span>
                                }
                            </p>
                        }
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-end gap-1 gap-md-4">
                    <div class="report-info">
                        <div class="d-flex align-items-center gap-1 gap-md-2">
                            <svg style="width: 14px; height: 14px" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M6.75 2.25A.75.75 0 0 1 7.5 3v1.5h9V3A.75.75 0 0 1 18 3v1.5h.75a3 3 0 0 1 3 3v11.25a3 3 0 0 1-3 3H5.25a3 3 0 0 1-3-3V7.5a3 3 0 0 1 3-3H6V3a.75.75 0 0 1 .75-.75Zm13.5 9a1.5 1.5 0 0 0-1.5-1.5H5.25a1.5 1.5 0 0 0-1.5 1.5v7.5a1.5 1.5 0 0 0 1.5 1.5h13.5a1.5 1.5 0 0 0 1.5-1.5v-7.5Z" clip-rule="evenodd" /></svg>
                            <span>@item.RegDateTxt</span>
                        </div>

                        <div class="d-flex align-items-center gap-1 gap-md-2">
                            <svg style="width: 14px; height: 14px" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M1 8a7 7 0 1 1 14 0A7 7 0 0 1 1 8Zm7.75-4.25a.75.75 0 0 0-1.5 0V8c0 .414.336.75.75.75h3.25a.75.75 0 0 0 0-1.5h-2.5v-3.5Z" clip-rule="evenodd" /></svg>
                            <span>@item.RegTimeTxt?.Substring(0, item.RegTimeTxt.Length - 3)</span>
                        </div>

                        <div class="d-flex align-items-center gap-1 gap-md-2">
                            <svg style="width: 14px; height: 14px" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M1.5 4.5a3 3 0 0 1 3-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 0 1-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 0 0 6.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 0 1 1.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 0 1-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5Z" clip-rule="evenodd" /></svg>
                            <span>@item.RepTel</span>
                        </div>

                        <div class="d-flex align-items-center gap-1 gap-md-2">
                            <svg style="width: 14px; height: 14px" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM3.751 20.105a8.25 8.25 0 0 1 16.498 0 .75.75 0 0 1-.437.695A18.683 18.683 0 0 1 12 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 0 1-.437-.695Z" clip-rule="evenodd" /></svg>
                            <span>@item.UserCreator</span>
                        </div>
                        @if (item.DealSerialNumber != null && ViewBag.PassType != 4) {
                            <div class="d-flex align-items-center gap-1 gap-md-2">
                                <i class="fas fa-file-contract"></i>
                                <span>سفارش @item.DealSerialNumber</span>
                            </div>
                        }
                    </div>
                    @*  <div>
                        <div class="report-dropdown__toggle" style="cursor:pointer" tabindex="0">
                            <svg style="width:18px;height:18px" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5ZM12 12.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5ZM12 18.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5Z" /></svg>
                        </div>
                        <div class="report-dropdown">
                            <div class="report-dropdown__item" onclick="ShowUpdateReport('@item.Id')">
                                <svg style="width:18px;height:18px" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" /></svg>
                                <span>ویرایش</span>
                            </div>

                            <div class="report-dropdown__item" onclick="DelReport('@item.Id')">
                                <svg style="width:18px;height:18px" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
                                <span>حذف</span>
                            </div>
                        </div>
                    </div> *@
                    <div class="d-flex align-items-center gap-1">
                        <div class="report-dropdown__item" style="color:#8d6400" data-title="افزودن فعالیت" onclick="showTaskModal('@item.Id', 'Report')">
                            <svg style="width:20px;height:20px" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" /></svg>
                        </div>
                        <div class="report-dropdown__item" data-title="ویرایش" onclick="ShowUpdateReport('@item.Id', @ViewBag.PassType)">
                            <svg style="width:18px;height:18px" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" /></svg>
                        </div>
                        <div class="report-dropdown__item" data-title="حذف" onclick="DelReport('@item.Id', @ViewBag.PassType, '@item.DealId')">
                            <svg style="width:18px;height:18px" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>