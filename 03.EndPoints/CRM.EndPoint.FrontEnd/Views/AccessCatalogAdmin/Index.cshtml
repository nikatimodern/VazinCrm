@{
    ViewData["Title"] = "مدیریت سطح دسترسی";
}
<section id="accessCatalog" class="ac-page" dir="rtl">
    @Html.AntiForgeryToken()
    <header class="ac-header">
        <div>
            <h1>مدیریت سطح دسترسی</h1>
            <p>تعریف انتیتی‌های قابل کنترل و مجوزهای مربوط به هر کدام</p>
        </div>
    </header>

    <nav class="ac-main-tabs" role="tablist" aria-label="بخش‌های مدیریت سطح دسترسی">
        <button type="button" id="acCatalogTab" data-main-tab="catalog" class="is-active"
                role="tab" aria-controls="acCatalogPanel" aria-selected="true">انتیتی‌ها و دسترسی‌ها</button>
        <button type="button" id="acRolesTab" data-main-tab="roles"
                role="tab" aria-controls="acRolesPanel" aria-selected="false" tabindex="-1">دسترسی نقش‌ها</button>
        <button type="button" id="acUsersTab" data-main-tab="users"
                role="tab" aria-controls="acUsersPanel" aria-selected="false" tabindex="-1">دسترسی کاربران</button>
    </nav>

    <div id="acCatalogPanel" role="tabpanel" aria-labelledby="acCatalogTab">
    <div class="ac-layout">
        <aside class="ac-panel ac-entity-panel" aria-label="فهرست انتیتی‌ها">
            <div class="ac-panel-heading">
                <h2>انتیتی‌ها <span class="ac-count" data-entity-count>۰</span></h2>
                <div class="ac-toolbar-actions">
                    <button type="button" class="ac-btn ac-btn-primary" data-action="new-entity">
                        <i class="fas fa-plus" aria-hidden="true"></i> افزودن انتیتی
                    </button>
                    <button type="button" class="ac-icon-button" data-action="reload" title="تازه‌سازی" aria-label="تازه‌سازی">
                        <i class="fas fa-sync-alt" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
            <label class="ac-search">
                <i class="fas fa-search" aria-hidden="true"></i>
                <input type="search" data-entity-search placeholder="جست‌وجوی انتیتی..." maxlength="150" aria-label="جست‌وجوی انتیتی" />
            </label>
            <div class="ac-entities" data-entities aria-live="polite">
                <p class="ac-muted">در حال دریافت اطلاعات...</p>
            </div>
        </aside>
        <section class="ac-panel ac-permission-panel" aria-label="دسترسی‌های انتیتی">
            <div class="ac-panel-heading ac-permission-heading">
                <div>
                    <h2 data-selected-title>دسترسی‌های انتیتی</h2>
                    <p data-selected-key>برای شروع یک انتیتی انتخاب کنید.</p>
                </div>
                <div class="ac-toolbar-actions">
                    <button type="button" class="ac-btn ac-btn-primary" data-action="new-permission" disabled>
                        <i class="fas fa-plus" aria-hidden="true"></i> افزودن دسترسی
                    </button>
                </div>
            </div>
            <div class="ac-permission-guide">
                <i class="fas fa-info-circle" aria-hidden="true"></i>
                تعریف دسترسی در این مرحله فقط برای ثبت در فهرست است و هنوز روی عملیات برنامه اعمال نمی‌شود.
            </div>
            <div class="ac-permissions" data-permissions aria-live="polite">
                <div class="ac-empty"><i class="fas fa-shield-alt" aria-hidden="true"></i><p>یک انتیتی را از فهرست انتخاب کنید.</p></div>
            </div>
        </section>
    </div>
    </div>

    <div id="acRolesPanel" role="tabpanel" aria-labelledby="acRolesTab" hidden>
        <div class="ac-layout ac-role-layout">
            <aside class="ac-panel" aria-label="فهرست نقش‌ها">
                <div class="ac-panel-heading">
                    <h2>نقش‌ها <span class="ac-count" data-role-count>۰</span></h2>
                    <button class="ac-icon-button" type="button" data-action="reload-roles"
                            title="تازه‌سازی نقش‌ها" aria-label="تازه‌سازی نقش‌ها">
                        <i class="fas fa-sync-alt" aria-hidden="true"></i>
                    </button>
                </div>
                <label class="ac-search">
                    <i class="fas fa-search" aria-hidden="true"></i>
                    <input type="search" data-role-search placeholder="جست‌وجوی نقش..." aria-label="جست‌وجوی نقش" maxlength="150" />
                </label>
                <div class="ac-roles-list" data-roles-list aria-live="polite">
                    <p class="ac-muted">برای مشاهده نقش‌ها این تب را انتخاب کنید.</p>
                </div>
            </aside>
            <section class="ac-panel" aria-label="مجوزهای نقش انتخاب‌شده">
                <div class="ac-panel-heading ac-role-detail-heading">
                    <div>
                        <h2 data-role-title>دسترسی‌های نقش</h2>
                        <p data-role-subtitle>برای شروع یک نقش انتخاب کنید.</p>
                    </div>
                    <div class="ac-toolbar-actions">
                        <button class="ac-btn ac-btn-muted" type="button" data-action="reset-role" disabled>بازگرداندن تغییرات</button>
                        <button class="ac-btn ac-btn-primary" type="button" data-action="save-role" disabled>
                            <i class="fas fa-save" aria-hidden="true"></i> ذخیره دسترسی‌ها
                        </button>
                    </div>
                </div>
                <div class="ac-role-tools">
                    <label class="ac-search ac-role-search">
                        <i class="fas fa-search" aria-hidden="true"></i>
                        <input type="search" data-role-permission-search placeholder="جست‌وجوی انتیتی یا مجوز..."
                               aria-label="جست‌وجوی دسترسی‌ها" maxlength="150" />
                    </label>
                    <span class="ac-selected-count" data-role-selected>۰ دسترسی انتخاب شده</span>
                </div>
                <p class="ac-role-notice">
                    <i class="fas fa-info-circle" aria-hidden="true"></i>
                    این تنظیمات فعلاً فقط ثبت و نگهداری می‌شوند؛ اعمال مجوز روی عملیات برنامه در مرحله بعد انجام می‌شود.
                </p>
                <p class="ac-error ac-role-error" data-role-error role="alert" hidden></p>
                <div class="ac-role-groups" data-role-groups aria-live="polite">
                    <div class="ac-empty"><i class="fas fa-user-shield" aria-hidden="true"></i>
                        <p>یک نقش انتخاب کنید تا مجوزهای انتیتی‌ها نمایش داده شوند.</p>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <div id="acUsersPanel" class="ac-users-panel" role="tabpanel" aria-labelledby="acUsersTab" hidden>
        <div class="ac-layout ac-role-layout">
            <aside class="ac-panel" aria-label="کاربران">
                <div class="ac-panel-heading">
                    <h2>کاربران <span class="ac-count" data-users-count>۰</span></h2>
                    <button type="button" class="ac-icon-button" data-action="reload-users" title="تازه‌سازی" aria-label="تازه‌سازی کاربران">
                        <i class="fas fa-sync-alt" aria-hidden="true"></i>
                    </button>
                </div>
                <label class="ac-search">
                    <i class="fas fa-search" aria-hidden="true"></i>
                    <input type="search" data-users-search maxlength="150" placeholder="نام، نام کاربری یا تلفن..."
                           aria-label="جست‌وجوی کاربران" />
                </label>
                <div class="ac-user-type-filter">
                    <label for="acUserTypeFilter">نوع کاربر</label>
                    <select id="acUserTypeFilter" data-users-type aria-label="فیلتر نوع کاربر">
                        <option value="employee" selected>کارمندان</option>
                        <option value="customer">مشتریان</option>
                        <option value="supplier">تأمین‌کنندگان</option>
                        <option value="all">همه کاربران</option>
                    </select>
                </div>
                <div class="ac-users-list" data-users-list aria-live="polite">
                    <p class="ac-muted">برای نمایش کاربران این تب را انتخاب کنید.</p>
                </div>
                <div class="ac-users-pagination">
                    <button class="ac-btn ac-btn-muted" type="button" data-action="user-prev" disabled>قبلی</button>
                    <span data-users-page>صفحه ۱</span>
                    <button class="ac-btn ac-btn-muted" type="button" data-action="user-next" disabled>بعدی</button>
                </div>
            </aside>
            <section class="ac-panel" aria-label="نقش‌ها و دسترسی‌های کاربر">
                <div class="ac-panel-heading ac-role-detail-heading">
                    <div>
                        <h2 data-user-title>دسترسی‌های کاربر</h2>
                        <p data-user-position>برای شروع یک کاربر را انتخاب کنید.</p>
                        <p data-user-subtitle></p>
                    </div>
                    <div class="ac-toolbar-actions">
                        <button class="ac-btn ac-btn-muted" type="button" data-action="reset-user" disabled>بازگرداندن تغییرات</button>
                        <button class="ac-btn ac-btn-primary" type="button" data-action="save-user" disabled>
                            <i class="fas fa-save" aria-hidden="true"></i> ذخیره دسترسی‌های کاربر
                        </button>
                    </div>
                </div>
                <div class="ac-user-role-section">
                    <div class="ac-user-role-header">
                        <strong>نقش‌های کاربر</strong>
                        <span data-user-roles-count>۰ نقش</span>
                    </div>
                    <div class="ac-user-role-list" data-user-roles>
                        <p class="ac-muted">نقش‌ها پس از انتخاب کاربر نمایش داده می‌شوند.</p>
                    </div>
                    <p>سمت کاری کاربر مستقل از نقش‌هاست و در این صفحه تغییر نمی‌کند.</p>
                </div>
                <div class="ac-role-tools">
                    <label class="ac-search ac-role-search">
                        <i class="fas fa-search" aria-hidden="true"></i>
                        <input type="search" data-user-permission-search maxlength="150"
                               placeholder="جست‌وجوی مجوز یا انتیتی..." aria-label="جست‌وجوی دسترسی‌های کاربر" />
                    </label>
                    <label class="ac-user-only-overrides">
                        <input type="checkbox" data-user-only-overrides />
                        فقط استثناهای اختصاصی
                    </label>
                    <span class="ac-selected-count" data-user-effective-count>۰ مجوز مؤثر</span>
                </div>
                <p class="ac-role-notice">
                    <i class="fas fa-info-circle" aria-hidden="true"></i>
                    مجوزهای نقش‌ها پویا هستند. «محدودیت اختصاصی» بر همه نقش‌ها اولویت دارد و
                    «اجازه اختصاصی» دسترسی مستقلی ایجاد می‌کند. اعمال واقعی مجوزها روی عملیات برنامه در مرحله بعد است.
                </p>
                <div class="ac-user-tools">
                    <button class="ac-btn ac-btn-muted" type="button" data-action="user-clear-overrides" disabled>
                        بازگرداندن همه مجوزها به نقش‌ها
                    </button>
                </div>
                <p class="ac-error ac-role-error" data-user-error role="alert" hidden></p>
                <div class="ac-role-groups ac-user-permission-groups" data-user-permissions aria-live="polite">
                    <div class="ac-empty"><i class="fas fa-user-shield" aria-hidden="true"></i>
                        <p>یک کاربر انتخاب کنید تا مجوزهای مؤثر او نمایش داده شوند.</p>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <div class="modal fade" id="acEntityModal" tabindex="-1" aria-hidden="true" aria-labelledby="acEntityModalTitle">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content ac-modal" data-entity-form>
                <div class="modal-header"><h2 class="modal-title" id="acEntityModalTitle">انتیتی جدید</h2>
                    <button class="ac-close" type="button" data-bs-dismiss="modal" aria-label="بستن">×</button>
                </div>
                <div class="modal-body">
                    <div class="ac-fields">
                        <label>مدل از DbContext
                            <select name="model" required data-model-select><option value="">انتخاب مدل...</option></select>
                        </label>
                        <label>عنوان فارسی
                            <input name="title" maxlength="150" required placeholder="مانند سفارشات" />
                        </label>
                        <label>کلید یکتا
                            <input name="key" maxlength="64" dir="ltr" required pattern="[A-Za-z][A-Za-z0-9]*" placeholder="Orders" />
                        </label>
                        <label>توضیحات (اختیاری)
                            <textarea name="description" maxlength="1000" rows="2"></textarea>
                        </label>
                        <label class="ac-check"><input type="checkbox" name="isActive" checked /> فعال</label>
                    </div>
                    <p class="ac-error" data-entity-error role="alert" hidden></p>
                </div>
                <div class="modal-footer">
                    <button class="ac-btn ac-btn-muted" type="button" data-bs-dismiss="modal">انصراف</button>
                    <button class="ac-btn ac-btn-primary" type="submit">ذخیره انتیتی</button>
                </div>
            </form>
        </div>
    </div>

    <div class="modal fade" id="acPermissionModal" tabindex="-1" aria-hidden="true" aria-labelledby="acPermissionModalTitle">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content ac-modal" data-permission-form>
                <div class="modal-header"><h2 class="modal-title" id="acPermissionModalTitle">دسترسی جدید</h2>
                    <button class="ac-close" type="button" data-bs-dismiss="modal" aria-label="بستن">×</button>
                </div>
                <div class="modal-body">
                    <p class="ac-form-context" data-permission-entity></p>
                    <div class="ac-fields">
                        <label>عنوان دسترسی
                            <input name="title" maxlength="150" required placeholder="مانند مشاهده" />
                        </label>
                        <label>کلید دسترسی
                            <input name="key" maxlength="64" dir="ltr" required pattern="[A-Za-z][A-Za-z0-9]*" placeholder="View" />
                        </label>
                        <p class="ac-key-preview" data-key-preview></p>
                        <label>توضیحات (اختیاری)
                            <textarea name="description" maxlength="1000" rows="2"></textarea>
                        </label>
                        <label class="ac-check"><input type="checkbox" name="isActive" checked /> فعال</label>
                    </div>
                    <p class="ac-error" data-permission-error role="alert" hidden></p>
                </div>
                <div class="modal-footer">
                    <button class="ac-btn ac-btn-muted" type="button" data-bs-dismiss="modal">انصراف</button>
                    <button class="ac-btn ac-btn-primary" type="submit">ذخیره دسترسی</button>
                </div>
            </form>
        </div>
    </div>
</section>
@section Styles {
    <link rel="stylesheet" href="~/css/accessCatalog.css?release=7.5.5" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/accessCatalog.js?release=7.5.5" asp-append-version="true"></script>
}
