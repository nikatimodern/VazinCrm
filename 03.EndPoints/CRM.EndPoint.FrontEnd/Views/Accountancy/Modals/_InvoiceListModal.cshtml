<!-- Modal ListInvoice -->
<div class="modal fade" id="InvoiceListModalId" tabindex="-1" data-bs-focus="false">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content invoice-list-content">
            <div class="modal-header invoice-list-header">
                <h5 class="modal-title invoice-list-title" id="TitleListInvoiceId">لیست پرداختی‌ها</h5>
                <button type="button" class="btn-close invoice-list-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body invoice-list-body">
                @if (!User.IsCustomer()) {
                    <div id="addInvoiceBtns" class="invoice-list-actions d-flex justify-content-center align-items-center gap-2">
                        <button class="buttonGreen0 deposit-btn py-1 d-flex align-items-center gap-2" onclick="ShowModalAddInvoice()">
                            واریزی
                            <svg style="width:14px;height:14px" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                        </button>
                        @if (User.IsAdmin() || User.IsFinancial()) {
                            <button class="buttonCancel2 backward-btn py-1 align-items-center gap-2" onclick="ShowModalInvoice(2)">
                                برگشتی
                               <svg style="width:14px;height:14px" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14" /></svg>
                            </button>
                        }
                    </div>
                }
                <div class="invoice-list-table" id="PayContentId"></div>
                <div class="invoice-list-summary" id="PayContentSumId"></div>

                @if (!User.IsCustomer()) {
                    <div class="invoice-list-footer gap-2">
                        @* <button class="buttonCancel2" data-bs-dismiss="modal">انصراف</button> *@
                        <button id="changeStatusAllAccBtn" class="buttonGreen3 d-none" onclick="changeStatusAllAcc()">ارسال همه به مالی</button>
                        <button id="acceptFinancialBtn" class="buttonGreen3 d-none" onclick="acceptFinancialFromModal()">تایید پیش‌فاکتور</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (!User.IsCustomer()) {
    <partial name="_InvoiceModal.cshtml" />
    <partial name="_InvoiceTransferModal.cshtml" />
    <partial name="_InvoiceVosolModal.cshtml" />
    <partial name="Modals/_NotAcceptModal" />
}
