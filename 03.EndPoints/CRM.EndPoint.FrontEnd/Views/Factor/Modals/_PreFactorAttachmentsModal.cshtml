<!-- Modal AccepedAttachment -->
<div class="modal fade " dir="ltr" id="Attachments" tabindex="-1" role="dialog" data-bs-focus="false" data-bs-backdrop="static" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content col-12" style="padding:10px 10px 0">

            <div class="modal-body" style=" display:flex;flex-direction:column; justify-content:space-between; width:100% !important;">
                <div class="col-12">
                    <div class="fmp ">
                        <div style="display:flex;justify-content:center">
                            <div class="col-12">
                                <div class="container-uploader">
                                    <input type="file" class="uploadBtn" data-varList="AccepedAttachment" data-showList="imageDisplayAcAt" id="AcAtID" multiple accept="*" />

                                    <label for="AcAtID">
                                        <svg style="width: 16px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" /></svg>
                                        <span>درج تصویر</span>
                                    </label>
                                    <div class="image-display" id="imageDisplayAcAt"></div>
                                </div>
                            </div>
                            <button class="AddFile_Btn buttonGreen" id="AddFile_BtnId" style="display:none">
                                <i class="fas fa-plus AttachBt "></i>
                            </button>
                        </div>

                    </div>
                </div>
                <div class="mt-3" style="width:100%; display:flex;justify-content:center;gap:4px">
                    <button class="buttonGreen3" onclick="SubmitAcAttach()">ثبت</button>
                    <button class="buttonCancel2" onclick="cancelAttachment() ">انصراف</button>
                </div>
            </div>
        </div>
    </div>
</div>