@{
    Layout = "_Layout";
}


<div class="w-100">
    <div class="row align-items-center justify-content-between flex-wrap mb-2 g-2">
        <div class="d-flex col-lg-3">
            <button class="buttonGray2 d-flex align-items-center gap-1" style="padding: 4px 8px" onclick="showCashierModal()">
                <span style="line-height: 1">ثبت تنخواه دار</span>
                <svg style="width: 20px" viewBox="0 0 20 20" fill="currentColor"><path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" /></svg>
            </button>
        </div>
        <div class="col-12 col-lg-5 d-flex align-items-center gap-2 flex-wrap">
            @*<div class="d-flex align-items-center flex-grow-1 gap-2">
                <input class="form-control" id="cashierSearch" placeholder="جستجو">
            </div>*@
        </div>
        <div class="d-flex align-items-start justify-content-start justify-content-lg-end gap-2 col-lg-3">

            @*<div id="ContentDealFilterId" class="ContentFilter"></div>
            <div class="btnFilter d-none d-lg-flex" data-filterVarConfig="filterDealConfig" data-filterCallBack="callbackFilterDeal" data-filterContentId="ContentDealFilterId" data-filterInpSearchId="dealSearchId" data-filterVarSearch="dealSearchVal" onclick="ShowFilterPopup(this)">
                <svg style="width:24px;color:#333" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M3.792 2.938A49.069 49.069 0 0 1 12 2.25c2.797 0 5.54.236 8.209.688a1.857 1.857 0 0 1 1.541 1.836v1.044a3 3 0 0 1-.879 2.121l-6.182 6.182a1.5 1.5 0 0 0-.439 1.061v2.927a3 3 0 0 1-1.658 2.684l-1.757.878A.75.75 0 0 1 9.75 21v-5.818a1.5 1.5 0 0 0-.44-1.06L3.13 7.938a3 3 0 0 1-.879-2.121V4.774c0-.897.64-1.683 1.542-1.836Z" clip-rule="evenodd"></path></svg>
            </div>*@
        </div>
    </div>
    <div id="cashierContainer">
        <table class="table table-striped table-bordered table-hover nowrap w-100" id="cashierTable">
            <thead>
            <tr>
                <th>کاربر</th>
                <th>ثبت توسط</th>
                <th>تاریخ ثبت</th>
                <th>موجودی شارژ</th>
                <th>هزینه شده</th>
                <th>مانده</th>
                <th>عملیات</th>
            </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>


<!-- Modal cashier -->
<div class="modal fade" id="cashierModal" tabindex="-1" role="dialog" data-bs-focus="false">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content col-12 p-2">
            <div class="text-center text-white rounded py-1 fbold" style="background-color: #6c757d">ثبت تنخواه دار</div>
            <div class="modal-body pb-2">
                <form id="cashierForm" class="d-flex flex-column gap-2">
                    @*<div>
                        <label for="cashierCostTitle">مرکز هزینه:</label>
                        <input id="cashierCostTitle" class="form-control" name="title" required>
                    </div>*@

                    <div>
                        <label for="cashierUser">کاربر:</label>
                        <select id="cashierUser" class="show-dropdown-arrow" name="userId" required></select>
                    </div>

                    <div class="d-flex justify-content-center gap-1 mt-2">
                        <button type="button" class="buttonCancel2" style="padding-block: 4px" data-bs-dismiss="modal">انصراف</button>
                        <button type="button" class="buttonGreen3" style="padding-block: 4px" onclick="submitCashierModal()">ثبت</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let cashierTbl;
        let cashierData = {};
        const cashierModal = document.getElementById("cashierModal");
        document.addEventListener("DOMContentLoaded", async () => {
            getAllCashiersDt();
        });

        let selectTomLoaded = false;
        async function showCashierModal() {
            if (!selectTomLoaded) {
                await initSelectTomCashier();
                selectTomLoaded = true;
            }
            ModalToggle(cashierModal, "show");
        }


        cashierModal.addEventListener("hidden.bs.modal", () => {
            cashierData = {};
            mySer.emptyForm("cashierForm");
        });


        const initSelectTomCashier = async () => {
            const users = await CrmSer.getUsers(1);
            new TomSelect("#cashierUser", {
                options: users,
                valueField: "id",
                maxItems: 1,
                selectOnTab: true,
            });
        };

        async function showEditCashierModal(id) {
            FLshowLoading();
            await showCashierModal();

            try {
                const res = await axios(`/Cash/GetCashier/${id}`);
                if (res.status === 200) {
                    cashierData = res.data;
                    cashierModal.querySelector("#cashierUser").tomselect.setValue([...cashierData.cashierUsers.map(i => i.userId)]);
                    mySer.convertJsonToForm(cashierData, "cashierForm");
                }

            } catch (err) {
                console.log(err);
            } finally {
                FLshowLoading(false);
            }
        }

        const deleteCashier = async (id) => {
            Swal.fire({
                title: "حذف!",
                text: "آیا مطمئن هستید که میخواهید حذف کنید؟",
                icon: "warning",
                showCancelButton: true,
                cancelButtonColor: "#adadad",
                confirmButtonColor: "#e64942",
                cancelButtonText: "انصراف",
                confirmButtonText: "بله، حذف شود",
            }).then(async (willDelete) => {
                if (willDelete.isConfirmed) {
                    FLshowLoading();
                    const res = await axios(`/Cash/DeleteCashier/${id}`);
                    if (res.status === 200) {
                        toastifySuccess("با موفقیت حذف شد");
                        cashierTbl.ajax.reload();
                    }
                    FLshowLoading(false);
                }
            });
        };

        async function submitCashierModal() {
            if (!await mySer.CheckValidForm("cashierForm")) return;
            const cashierUserElm = cashierModal.querySelector("#cashierUser");
            const model = {
                ...cashierData,
                ...mySer.convertFormToJSON("cashierForm"),
                userTxt: cashierUserElm.options[cashierUserElm.selectedIndex].text,
            };
            //model.cashierUsers = selectedUsers.map(i => ({ userId: i, cashierId: cashierData.id }));

            try {
                FLshowLoading();
                const res = await axios.post("/Cash/AddCashier", model);
                if (res.status === 200) {
                    toastifySuccess("با موفقیت ثبت شد");
                    cashierTbl.ajax.reload();
                    ModalToggle(cashierModal, "hide");
                }
            } catch (err) {
                console.log(err);
            } finally {
                FLshowLoading(false);
            }
        }

        const getAllCashiersDt = () => {
            cashierTbl = $("#cashierTable").DataTable({
                pageLength: 10,
                lengthMenu: [5, 10, 20, 50, 100, { label: "همه", value: -1 }],
                processing: true,
                serverSide: true,
                searching: true,
                search: {
                    return: true,
                },
                ordering: true,
                order: [[2, "desc"]],
                scrollCollapse: true,
                scrollY: "70dvh",
                responsive: true,
                ajax: {
                    url: `/Cash/GetAllCashiersDt`,
                    type: "POST",
                },
                language: languageDatatable,
                columns: [
                    { data: "cashier.userTxt" },
                    { data: "cashier.userCreator", orderable: false },
                    { data: "cashier.createDateTxt", render: data => renderDateTimeHtml(data) },
                    { data: "totalCredit", render: data => renderMoneyHtml(data, { className: "fbold" }) },
                    {
                        data: "totalDebit",
                        render: (data, _, row) => {
                            return `
                            <span class="d-inline-flex align-items-center gap-2">
                                ${renderMoneyHtml(data, { className: "fbold" })}
                                ${!row.isAccepted && data ? `
                                    <span class="info-icon-popover" style="color: #666" data-bs-toggle="popover" data-bs-placement="top" data-bs-content="این مبلغ شامل تراکنش‌های تایید نشده است.">
                                        <svg style="width: 13px" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M15 8A7 7 0 1 1 1 8a7 7 0 0 1 14 0ZM9 5a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM6.75 8a.75.75 0 0 0 0 1.5h.75v1.75a.75.75 0 0 0 1.5 0v-2.5A.75.75 0 0 0 8.25 8h-1.5Z"></path></svg>
                                    </span>
                                ` : ""}
                            </span>`;
                        },
                    },
                    {
                        data: "balance",
                        render: data => {
                            let classBadge = data > 0 ? "badge-green" : data < 0 ? "badge-red" : "badge-gray";
                            return `
                            <span class="fbold fs-6 badge ${classBadge}">
                                ${renderMoneyHtml(data)}
                            </span>`;
                        },
                    },
                    {
                        data: "cashier.id",
                        orderable: false,
                        render: function (data) {
                            return `
                                <div class="inline-flex-center gap-1">
                                    <button type="button" style="padding: 6px 7px;box-shadow: none;font-size: 12px" class="buttonCancel2 flex-center" onclick="deleteCashier('${data}')"><i class="fa fa-trash"></i></button>
                                </div>
                            `;
                        },
                    },
                ],
                layout: layoutDatatable,
            });
        };
    </script>
}
