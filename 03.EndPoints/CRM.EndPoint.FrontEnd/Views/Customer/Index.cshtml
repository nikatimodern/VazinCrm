        function I_GetFamillyWayOp() {
            $.get(baseUrl + "BaseItem/GetItemsOp?typeCode=2", (res) => {
                $("#FamillyWay").select2({
                    data: res,
                    dir: "rtl",
                    placeholder: "انتخاب",
                    selectionCssClass: "form-control",
                });
                $("#FamillyWay").val(null).trigger("change");
            })
             .fail(() => {
                 setTimeout(() => {
                     I_GetFamillyWayOp();
                 }, 1000);
             });

        }

        const AbortCus = (id) => {
            return new Promise(resolve => {
                $.get(`${baseUrl}Customer/AbortCustomer?cid=${id}`, () => {
                    getAllCustomers();
                    toastifySuccess("مشتری حذف شد");
                    resolve();
                })
                 .fail(() => {
                     toastifyError("خطا در انجام عملیات مجدد سعی کنید.");
                 });
            });
        };


        const AcceptCus = (id) => {

            return new Promise(resolve => {
                $.get(`${baseUrl}Customer/AcceptCustomer?cid=${id}`, (res) => {
                    getAllCustomers();

                    toastifySuccess("تایید شد");
                    resolve();
                })
                 .fail(() => {
                     setTimeout(() => AcceptCus(id), 3000);
                     toastifyError("خطا در انجام عملیات مجدد سعی کنید.");
                 });
            });

        };


        let senfLoaded = false;
        const ShowModalUpCustomer = async (id) => {
            if (!senfLoaded) {
                GetUpSenfOp();
                senfLoaded = true;
            }
            customerIdUp = id;
            const loadingModal = document.getElementById("loadingModalUp");

            @* loadingModal.classList.remove("d-none"); *@;
            FLshowLoading();
            const res = await axios(`/Customer/GetCustomer/${id}`);
            if (res.status === 200) {
                const data = res.data;
                changeJur(data.juridical);
                mySer.convertJsonToForm(data, "CuInfoUpFormId");
                FLshowLoading(false);
                @* loadingModal.classList.add("d-none"); *@;
            }
            ModalToggle("updateCustomerModal");
        };

        const SubmitUpFormCustomer = async () => {
            if (await mySer.CheckValidForm("#CuInfoUpFormId")) {
                const data = mySer.convertFormToJSON("#CuInfoUpFormId");
                data.id = customerIdUp;

                const workSelect = document.getElementById("workSenfID");
                if (data.workSenf) data.workSenfTxt = workSelect.options[workSelect.selectedIndex].text;

                FLshowLoading();

                try {
                    const res = await axios.post("/Customer/UpCustomer", data);
                    if (res.status === 200) {
                        toastifySuccess("ویرایش مشتری با موفقیت انجام شد");
                        FLshowLoading(false);
                        closeModalUpdate();
                        getAllCustomers();
                    }

                } catch (error) {
                    console.error(error);
                    setTimeout(async () => await SubmitUpFormCustomer(), 3000);
                }
            }
        };

        const closeModalUpdate = () => {
            $("#updateCustomerModal").modal("toggle");
            cancelUpCustomer();
            customerIdUp = null;
        };


        const GetUpSenfOp = () => {
            const select = document.getElementById("workSenfID");

            return axios("/BaseItem/GetItemsOp?typeCode=1").then(res => {
                $(select).select2({
                    data: res.data,
                    dir: "rtl",
                    placeholder: "انتخاب",
                    selectionCssClass: "form-control",
                    dropdownParent: $("#updateCustomerModal"),
                });

                $(select).val(null).trigger("change");
            });
        };

    </script>
