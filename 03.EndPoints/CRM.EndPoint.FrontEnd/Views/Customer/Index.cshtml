        function getAllCustomerJuridical() {

            JuridicalTBL = $("#JuridicalTBL").DataTable(
                {
                    "lengthMenu": [5, 10, 25, 50, 100],
                    "processing": true,
                    "serverSide": true,
                    "filter": true,
                    "ajax": {
                        "url": baseUrl + "Customer/GetAllCustomerJuridical",
                        "type": "POST",
                        "datatype": "json",
                    },
                    "language": {
                        "sEmptyTable": "هیچ مشتری موجود نمی باشد.",
                        "sInfo": "نمایش _START_ تا _END_ از _TOTAL_ ردیف",
                        "sInfoEmpty": "نمایش 0 تا 0 از 0 ردیف",
                        "sInfoFiltered": "(فیلتر شده از _MAX_ ردیف)",
                        "sInfoPostFix": "",
                        "sInfoThousands": ",",
                        "sLengthMenu": "نمایش _MENU_ ردیف",
                        "sLoadingRecords": "در حال بارگزاری...",
                        "sProcessing": "در حال بروز رسانی جدول...",
                        "sSearch": "جستجو:",
                        "sZeroRecords": "رکوردی با این مشخصات پیدا نشد",
                        "oPaginate": {
