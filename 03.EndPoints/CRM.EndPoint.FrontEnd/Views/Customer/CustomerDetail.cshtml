@{
    ViewData["Title"] = "CustomerDetail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="width:100%; display:flex;flex-direction:column;align-items:center;" class="pb-2">
    <div class="flex-column flex-md-row" style=" display:flex;width:97%;justify-content:end;gap:6px;height:100%">
        <div class="gap-1" style="height:60dvh; display:flex; flex-direction:column;flex-basis:55% ">
            <label class="fbold">اطلاعات:</label>
            <div class=" InfoData " style="flex:1">
                <div id="CuInfoUpContainer" class="h-100" dir="rtl">
                    <div class="d-flex flex-column align-items-start h-100 col-lg-10 offset-lg-1 gap-2">

                        <div class="d-flex align-items-center justify-content-between w-100" style="padding:6px 6px 0 6px;">
                            <div id="juridicalTxt" class="badge badge-gray"></div>
                            <div id="openProfileCustomerIcon" data-title="پروفایل" style="cursor: pointer">
                                <svg style="width: 18px;color: #676767" viewBox="0 0 24 24" fill="currentColor"><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" /><path fill-rule="evenodd" d="M1.323 11.447C2.811 6.976 7.028 3.75 12.001 3.75c4.97 0 9.185 3.223 10.675 7.69.12.362.12.752 0 1.113-1.487 4.471-5.705 7.697-10.677 7.697-4.97 0-9.186-3.223-10.675-7.69a1.762 1.762 0 0 1 0-1.113ZM17.25 12a5.25 5.25 0 1 1-10.5 0 5.25 5.25 0 0 1 10.5 0Z" clip-rule="evenodd" /></svg>
                            </div>
                        </div>

                        <div style="width:100%;display:flex;flex-wrap:wrap;">
                            <div class="col-12 col-sm-6" style="padding:6px;">
                                <div class="cu-card">
                                    <div class="cu-label">نام و نام خانوادگی</div>
                                    <div id="agentName" class="cu-value fMedium"></div>
                                </div>
                            </div>

                            <div class="col-12 col-sm-6" style="padding:6px;">
                                <div class="cu-card">
                                    <div class="cu-label">کد ملی</div>
                                    <div id="agentMeliCode" class="cu-value"></div>
                                </div>
                            </div>

                            <div class="col-12 col-sm-6" style="padding:6px;">
                                <div class="cu-card">
                                    <div class="cu-label">تلفن</div>
                                    <div id="tel" class="cu-value"></div>
                                </div>
                            </div>

                            <div class="col-12 col-sm-6" style="padding:6px;">
                                <div class="cu-card">
                                    <div class="cu-label">موبایل</div>
                                    <div id="mobile" class="cu-value"></div>
                                </div>
                            </div>

                            <div class="col-12 col-sm-6" style="padding:6px;">
                                <div class="cu-card">
                                    <div class="cu-label">صنف کاری</div>
                                    <div id="workSenf" class="cu-value"></div>
                                </div>
                            </div>

                            <div class="col-12 col-sm-6" style="padding:6px;">
                                <div class="cu-card">
                                    <div class="cu-label">توضیحات صنف کاری</div>
                                    <div id="workSenfDescription" class="cu-value"></div>
                                </div>
                            </div>

                        </div>

                        <div id="JuridicalUpDiv" class="cu-section" style="display:none;width:100%;flex-wrap:wrap;">
                            <div class="col-12 col-sm-6 col-xl-3" style="padding:6px;">
                                <div class="cu-card">
                                    <div class="cu-label">نام شرکت</div>
                                    <div id="companyName" class="cu-value"></div>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-xl-3" style="padding:6px;">
                                <div class="cu-card">
                                    <div class="cu-label">شناسه ملی</div>
                                    <div id="shenaseMeli" class="cu-value"></div>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-xl-3" style="padding:6px;">
                                <div class="cu-card">
                                    <div class="cu-label">کد اقتصادی</div>
                                    <div id="eghtesadiCode" class="cu-value"></div>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-xl-3" style="padding:6px;">
                                <div class="cu-card">
                                    <div class="cu-label">شماره ثبت</div>
                                    <div id="numberRegister" class="cu-value"></div>
                                </div>
                            </div>
                        </div>

                        <div class="cu-address" style="width:100%;display:flex;flex-wrap:wrap;">
                            <div class="col-6" style="padding:6px;">
                                <div class="cu-card">
                                    <div class="cu-label">کد پستی</div>
                                    <div id="postalCode" class="cu-value"></div>
                                </div>
                            </div>
                            <div class="col-3" style="padding:6px;">
                                <div class="cu-card">
                                    <div class="cu-label">استان</div>
                                    <div id="province" class="cu-value"></div>
                                </div>
                            </div>
                            <div class="col-3" style="padding:6px;">
                                <div class="cu-card">
                                    <div class="cu-label">شهر</div>
                                    <div id="city" class="cu-value"></div>
                                </div>
                            </div>
                            <div class="col-12" style="padding:6px;">
                                <div class="cu-card">
                                    <div class="cu-label">آدرس</div>
                                    <div id="address" class="cu-value"></div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </div>

        </div>

        <div style="height:60dvh; display:flex; flex-direction:column;flex-basis:45%;gap:1rem ">

            <div class="gap-1" style=" display:flex; flex-direction:column ">
                <label class="fbold">وضعیت مشتری:</label>
                <div class="InfoData" style="width:100%;">
                    <label class="fbold" id="statusId"></label>

                </div>
            </div>
            <div class="d-flex flex-column">
                <div class="fbold d-flex gap-1">
                    <span>کارشناسانی که با این مشتری در ارتباط هستند:</span>
                    <div type="button" id="addExpertsBtn" class="mx-2" data-bs-toggle="modal" data-bs-target="#expertsModal" onclick="">
                        <i class="fa fa-plus"></i>
                    </div>
                </div>

                <div class="InfoData" style="width:100%;">
                    <div id="selContentId" style="display:flex; gap:4px ">
                    </div>
                </div>
            </div>
            <div class="gap-1" style=" display:flex;justify-content:end;flex-direction:column; flex:1;overflow:auto">
                <label class="fbold">مشتری هایی که مشابهت نام دارند:</label>
                <div class="InfoData" style="width:100%; overflow:auto;flex:auto" id="custRelId">
                </div>
            </div>

        </div>

    </div>

</div>

<partial name="Modals/_ChangeSaleExpertsModal" />

<script>

    var cust = null;
    var userRel = [];

    document.addEventListener("DOMContentLoaded", async (event) => {
        await GetCustomer();
        await getCustomerSelRelation();
        await getCustomerRel();

    });


    const getCustomerRel = async () => {
        return new Promise((resolve) => {
            $.get(baseUrl + "Customer/GetCustomerRel?id=" + '@ViewBag.CustomerId', (res) => {
                $("#custRelId").append(res);
                resolve();
            });

        });

    };

    const GetCustomer = async (id) => {
        return new Promise((resolve) => {

            customerIdUp = id;

            $("#loadingModalUp").css("display", "flex");
            $.get(baseUrl + "Customer/GetCustomer?id=" + '@ViewBag.CustomerId', (res) => {
                changeJur(res.juridical);
                //mySer.convertJsonToForm(res, "CuInfoUpFormId");

                $("#juridicalTxt").text(res.juridical === 0 ? "حقیقی" : "حقوقی");
                $("#agentName").html((res.Sex === 1 ? "جناب آقای " : "سرکار خانم ") + `<span class="fbold">${res.agentName}</span>`);
                $("#agentMeliCode").text(res.agentMeliCode || "-");
                $("#tel").text(res.tel || "-");
                $("#mobile").text(res.mobile || "-");
                $("#workSenf").text(res.workSenfTxt || "-");
                $("#workSenfDescription").text(res.workSenfDescription || "-");

                if (res.juridical === 1) {
                    $("#JuridicalUpDiv").show();
                    $("#companyName").text(res.companyName || "-");
                    $("#shenaseMeli").text(res.shenaseMeli || "-");
                    $("#eghtesadiCode").text(res.eghtesadiCode || "-");
                    $("#numberRegister").text(res.numberRegister || "-");
                }
                $("#postalCode").text(res.postalCode || "-");
                $("#province").text(res.province || "-");
                $("#city").text(res.city || "-");
                $("#address").text(res.address || "-");

                document.getElementById("openProfileCustomerIcon").addEventListener("click", () => openCustomerProfile(res.id));


                $("#loadingModalUp").css("display", "none");

                cust = res;
                var s = document.getElementById("statusId");

                if (res.accepted) {
                    s.innerText = "تایید شده";
                    s.style.color = "green";
                } else {
                    s.innerText = "در دست تایید";
                    s.style.color = "red";
                }

                resolve();

            });

        });


    };

    const delUser = async (uId, cId) => {
        document.getElementById("FLshowLoading").style.display = "";
        var model = {
            UserId: uId,
            CustomerId: cId,
        };

        fetch("/Customer/RemoveUserCustomer", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
            },
            body: JSON.stringify(model),
        })
            .then(async response => {
                await getCustomerSelRelation();


                return response.text();

            })
            .then(data => {


            })
            .catch(error => {

            });


    };
    const getCustomerSelRelation = async () => {

        document.getElementById("FLshowLoading").style.display = "";

        return new Promise(async (resolve) => {
            let customerId = '@ViewBag.CustomerId';

            $.get(baseUrl + "Customer/GetCustomerSelRelation?id=" + customerId, (res) => {

                userRel = res;
                var s = "<div style='width:100%; display:flex;flex-wrap:wrap;gap:4px'>";

                Array.from(res).forEach((item) => {

                    s += "<lable style='border:2px solid #02514C;border-radius:8px;padding-inline:12px 16px ; text-align:center;' class='fbold d-flex align-items-center gap-2'>";
                    s += `<span onClick= "delUser('${item.id}', '${customerId}')" class="d-flex align-items-center justify-content-center" style="cursor: pointer;">
                            <svg style="width: 16px" viewBox="0 0 16 16" fill="currentColor"><path d="M5.28 4.22a.75.75 0 0 0-1.06 1.06L6.94 8l-2.72 2.72a.75.75 0 1 0 1.06 1.06L8 9.06l2.72 2.72a.75.75 0 1 0 1.06-1.06L9.06 8l2.72-2.72a.75.75 0 0 0-1.06-1.06L8 6.94 5.28 4.22Z" /></svg>
                          </span>`;
                    s += item.fullName;
                    s += "</lable>";

                });

                s += "</div>";


                document.getElementById("selContentId").innerHTML = s;

                document.getElementById("FLshowLoading").style.display = "none";

                resolve();

            });


        });


    };


    document.getElementById("addExpertsBtn").addEventListener("click", () => getSelExperts());

    const getSelExperts = async () => {
        const modalBodyElm = document.querySelector("#expertsModal .modal-body");
        modalBodyElm.innerHTML = "";
        $("#loadingModalUpModal").css("display", "flex");

        let data = await CrmSer.getUsers(2);
        const filteredData = data.filter(item => !userRel.some(i => i.id === item.id));
        showSelExperts(filteredData);
        $("#loadingModalUpModal").css("display", "none");


    };

    let selExperts = [];

    const showSelExperts = (data) => {
        selExperts = [];
        const modalBodyElm = document.querySelector("#expertsModal .modal-body");

        let divElm = document.createElement("div");
        divElm.className = "d-flex gap-2 flex-wrap";


        data.forEach((item) => {
            let labelElm = document.createElement("label");
            labelElm.style.border = "2px solid #02514C";
            labelElm.style.borderRadius = "10px";
            labelElm.style.cursor = "pointer";
            labelElm.className = "fbold p-2 text-center";
            labelElm.innerText = item.text;


            labelElm.addEventListener("click", (e) => {
                const index = selExperts.indexOf(item.id);

                if (index === -1) {
                    selExperts.push(item.id);
                    e.target.style.backgroundColor = "#02514C";
                    e.target.classList.add("text-white");
                } else {
                    selExperts.splice(index, 1);
                    e.target.style.backgroundColor = "#fff";
                    e.target.classList.remove("text-white");

                }


            });

            divElm.appendChild(labelElm);
        });


        modalBodyElm.appendChild(divElm);
    };

    const addSelExperts = () => {

        const model = {
            customerId: cust.id,
            selExperts,
        };
        document.getElementById("FLshowLoading").style.display = "";
        fetch("/Customer/AddSelsToCustomers", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
            },
            body: JSON.stringify(model),
        })
            .then(async response => {

                $("#expertsModal").modal("toggle");
                await getCustomerSelRelation();
                document.getElementById("FLshowLoading").style.display = "none";
            })
            .catch(() => {
                setTimeout(async () => {
                    await addSelExperts();
                }, 2000);
            });
    };


</script>