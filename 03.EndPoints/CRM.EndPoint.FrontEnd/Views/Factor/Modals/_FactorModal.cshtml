<!-- Modal Factor -->
<div class="modal fade factor-modal" id="Factor" tabindex="-1" role="dialog" data-bs-focus="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-xxl">
        <div class="modal-content col-12">
            <div class="modal-header pb-0" style="border:none">
                <div class="factor-modal-title">صدور فاکتور</div>
            </div>

            <div class="modal-body d-flex flex-column justify-content-between w-100">
                <div>
                    <div class="headerPreFactorBox d-flex flex-column flex-column-reverse flex-lg-row gap-3 px-2 align-items-center justify-content-between w-100">
                        <div class="col-12 col-lg-3 d-flex align-items-end justify-content-between flex-grow-1">
                            <form class="d-flex flex-column justify-content-between row-gap-3" id="FHeadFormId" style="flex-grow:0.6">
                                <div class="d-flex justify-content-evenly">
                                    <div class="justify-content-around flex-column gap-1 gap-lg-2" style=" display:flex;width:100%; ">
                                        <div class="d-flex align-items-center gap-1">
                                            <label class="fbold" for="f_official">رسمی</label>
                                            <input type="radio" name="f_official" id="f_official" value="1" checked />
                                        </div>
                                        <div class="d-flex align-items-center gap-1">
                                            <label class="fbold" for="f_unofficial">غیر رسمی</label>
                                            <input type="radio" name="f_official" id="f_unofficial" value="0" />
                                        </div>
                                    </div>
                                    <div class="justify-content-around flex-column gap-1 gap-lg-2" id="F_exportAlert" style=" display:flex;width:100%; ">
                                        <div class="d-flex align-items-center gap-1">
                                            <label class="fbold" for="f_export">صادراتی</label>
                                            <input type="radio" name="f_export" id="f_export" value="1" data-alertid="F_exportAlert" required />
                                        </div>
                                        <div class="d-flex align-items-center gap-1">
                                            <label class="fbold" for="f_unexport">غیر صادراتی</label>
                                            <input type="radio" name="f_export" id="f_unexport" value="0" data-alertid="F_exportAlert" required />
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <label for="F_currencyTypeSelect">نوع ارز</label>
                                    <select class="form-select form-select-sm w-auto" name="currencyType" id="F_currencyTypeSelect">
                                        <option value="0" selected>ریال</option>
                                        @*<option value="1">دلار</option>
                                        <option value="2">یورو</option>*@
                                    </select>
                                </div>
                            </form>
                            <div class="d-lg-none">
                                <button class="btn btn-sm btn-secondary" onclick="ModalToggle('ItemFactorModal')">افزودن</button>
                            </div>
                        </div>
                        <div class="col-12 col-lg-5 col-xl-4 d-flex flex-column gap-1">
                            <form id="snFinancialFormId" class="d-flex align-items-center w-100">
                                <label class="col-4 text-center">شماره فاکتور مالی:</label>
                                <div class="col-8">
                                    <input class="form-control" type="text" name="snFinancial" id="snFinancial" disabled placeholder="شماره فاکتور مالی" />
                                </div>
                            </form>
                            <form id="f_SerialFormId" class="d-flex align-items-center w-100">
                                <label class="col-4 text-center">شماره فاکتور:</label>
                                <div class="col-8">
                                    <input class="sdate form-control" type="text" name="f_serialNumber" id="f_serialNumber" placeholder="شماره فاکتور" disabled />
                                </div>
                            </form>
                            <form id="f_dateFormId" class="d-flex align-items-center w-100">
                                <label class="col-4 text-center">تاریخ:</label>
                                <div class="col-8">
                                    <input class="sdate form-control" type="text" name="f_date" id="f_date" placeholder="تاریخ" required />
                                </div>
                            </form>
                        </div>
                    </div>

                </div>
                <div class="d-none d-lg-block p-3 pb-1 pb-lg-3 w-100">
                    <div class="pf-divider w-100">
                    </div>
                </div>
                <div class="d-flex justify-content-between w-100 flex-column-reverse pf-1500-row">
                    <div class="col-12 pf-1500-main d-flex flex-column justify-content-between">
                        <div id="FacItemContainer" class="d-none d-lg-flex" style="width:100%;  justify-content:space-between;">
                            <form id="FacItem" class="w-100 pf-item-form">
                                <div class="d-flex flex-column align-items-center">
                                    <div class="d-flex justify-content-between column-gap-2 w-100">
                                        <label>محصول</label>
                                        <div id="FprintableAlertId" class="d-flex gap-2" style="font-size:10px">
                                            <div class="d-flex align-items-center gap-1">
                                                <label for="f_printableT">چاپدار</label>
                                                <input type="radio" name="printable" class="valueNumber" id="f_printableT" data-alertId="FprintableAlertId" data-def="true" value="1" required />
                                            </div>
                                            <div class="d-flex align-items-center gap-1">
                                                <label for="f_printableF">غیر چاپدار</label>
                                                <input type="radio" name="printable" class="valueNumber" id="f_printableF" data-alertId="FprintableAlertId" data-def="true" value="0" required />
                                            </div>
                                        </div>
                                    </div>
                                    <select class="w-100 center fs-6 show-dropdown-arrow" name="productCode" id="productCode">
                                    </select>
                                </div>
                                <div class="d-flex flex-column align-items-center">
                                    <label>شرح کالا</label>
                                    <input class="form-control" type="text" name="product" id="product" />
                                </div>
                                <div class="d-flex flex-column align-items-center">
                                    <label>تعداد/مقدار </label>
                                    <input class="form-control" type="number" name="weightCount" id="weightCount" required />
                                </div>
                                <div class="d-flex flex-column align-items-center">
                                    <label>واحد</label>
                                    <select class="form-control valueNumber" style="width:100%;" name="unit" id="unit" disabled required>
                                    </select>
                                </div>
                                <div class="d-flex flex-column align-items-center">
                                    <label>مبلغ واحد</label>
                                    <input inputmode="numeric" class="currencyNumber form-control inpAmount" type="text" name="unitAmount" id="unitAmount" required data-currency-hint="next" />
                                    <span class="currencyHint"></span>
                                </div>

                                <div>
                                    <label for="itemDiscount">تخفیف</label>
                                    <input inputmode="numeric" class="currencyNumber form-control inpAmount" type="text" name="discount" id="itemDiscount" value="0" autocomplete="off" data-currency-hint="next" />
                                    <span class="currencyHint"></span>
                                </div>

                                <div class="d-flex flex-column align-items-center">
                                    <label>مبلغ نهایی</label>
                                    <input inputmode="numeric" class="currencyNumber form-control inpAmount" type="text" name="totalAmount" id="totalAmount" disabled />
                                </div>

                                <div>
                                    <label>&nbsp;</label>
                                    <button id="f_AddBtnId" type="button" class="buttonGreen3 flex-center w-100 p-0" style="height: 2rem" onclick="addFItem()">
                                        <svg style="width: 18px;height: 18px" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                                    </button>
                                    <div id="f_UpBtnId" style="display:none;flex-direction:column">
                                        <button class="buttonGreen3 flex-center w-100 p-0" type="button" onclick="updateFItem()" style="height: 26px">
                                            <svg style="width: 18px;height: 18px" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                                        </button>
                                        <button class="buttonCancel2 flex-center w-100 p-0" type="button" onclick="cancelUpdateFItem()" style="height: 26px">
                                            <svg style="width: 18px;height: 18px" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>

                        <div class="InfoData pf-items-container" id="FactorItemId">
                        </div>
                        <div class="d-flex flex-column flex-lg-row justify-content-end w-100 mt-3 amountsPreFactorModalBox">
                            <div class="d-none d-lg-block pf-1500-hide col-12 col-lg-6 descriptionPreFactorBox">
                                <div class="h-100" style=" width:100%;display:flex;flex-direction:column;">
                                    <div style="width:100%; display:flex;position:relative">
                                        <textarea id="f_descriptionIdTablet" rows="6" class="form-control" style="height:54px !important; width:100%;padding:4px 4px 4px 36px !important" type="text" placeholder="توضیحات"></textarea>
                                        <button style="position: absolute;left: 1px;bottom: 1px;display: flex;justify-content: center;align-items: center;top: 1px;padding-inline: 8px;box-shadow: none" class="buttonGreen3" onclick="addFDescriptionItem()">
                                            <svg style="width: 18px;height: 18px" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                                        </button>
                                    </div>
                                    <div class="flex-grow-1 pe-1" style="margin-top:14px; width:100%; display:flex ;max-height:120px;overflow:auto " id="factorDescIdTablet">
                                    </div>
                                </div>
                            </div>


                            <div class="col-12 col-lg-6 pf-1500-col-11 d-flex flex-column gap-1 pe-1">
                                <div class="col-12 d-flex justify-content-around">
                                    <label class="col-4 col-xl-3 text-center">جمع مبلغ کل :</label>
                                    <label class="col-8 col-xl-9 form-controlLable" name="f_sumTotalAmount" id="f_sumTotalAmount" value="0" disabled></label>
                                </div>
                                <div class="col-12 d-flex justify-content-around">
                                    <label class="col-4 col-xl-3 text-center">تخفیف :</label>
                                    <div class="col-8 col-xl-9">
                                        <input inputmode="numeric" class="form-control currencyNumber" name="f_discount" id="f_discount" type="text" value="0" />
                                    </div>
                                </div>
                                <div class="col-12 d-flex justify-content-around">
                                    <label class="col-4 col-xl-3 text-center">مالیات و عوارض :</label>
                                    <label class="col-8 col-xl-9 form-controlLable" name="f_totalTax" id="f_totalTax" type="text" value="0"></label>
                                </div>
                                <div class="col-12 d-flex justify-content-around">
                                    <label class="col-4 col-xl-3 text-center">مبلغ نهایی :</label>
                                    <label class="col-8 col-xl-9 form-controlLable" name="f_paymentAmount" id="f_paymentAmount" type="text" value="0"></label>
                                </div>

                            </div>

                            <div class="d-lg-none mt-3">
                                <button class="btn btn-sm btn-secondary" onclick="ModalToggle('FactorDescriptionModal')">افزودن توضیحات</button>
                            </div>
                        </div>

                    </div>


                    <div class="d-none pf-1500-show pf-1500-description col-12 ps-3 pt-3 pf-1500-pt-0 descriptionPreFactorBox">
                        <div class="h-100" style=" width:100%;display:flex;flex-direction:column;">
                            <div style="width:100%; display:flex;position:relative">
                                <textarea id="f_descriptionId" rows="6" class="form-control" style="height:100px !important; width:100%;padding:4px 4px 4px 36px !important" type="text" placeholder="توضیحات"></textarea>

                                <button style="position: absolute;left: 1px;bottom: 1px;display: flex;justify-content: center;align-items: center;top: 1px;padding-inline: 8px;box-shadow: none" class="buttonGreen3" onclick="addFDescriptionItem()">
                                    <svg style="width: 18px;height: 18px" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                                </button>
                            </div>
                            <div class="flex-grow-1 pe-1 " style="margin-top:14px; width:100%; display:flex ;max-height:310px;overflow:auto " id="factorDescId">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div>
                <div class="pf-divider"></div>
                <div class="d-flex justify-content-center w-100 gap-1 my-3">
                    <button class="buttonCancel2" onclick="cancelFactor() ">انصراف</button>
                    <button class="buttonGreen3" onclick="submitFactor()">ثبت</button>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="_FactorDescriptionModal.cshtml" />
<partial name="_FactorItemModal.cshtml" />