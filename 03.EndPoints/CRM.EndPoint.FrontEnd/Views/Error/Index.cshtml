@{
    var statusCode = (int)ViewBag.StatusCode;
    var errorMessage = ViewBag.ErrorMessage as string;
    var originalPath = ViewBag.OriginalPath as string;

    Layout = statusCode == 404
        ? User.IsCustomer() ? "_CustomerLayout" : "_Layout"
        : null;

    var errorImage = statusCode switch {
        404 => "/static/404.png",
        403 => "/static/403.png",
        _ => "/static/500.png"
    };
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>خطای @statusCode</title>
    <link rel="stylesheet" href="~/css/site.css?release=7.0.1" asp-append-version="true">
    <style>
        .err-container {
            & {
                width: 100%;
                max-width: 500px;
                margin: auto;
                padding: 24px;
                text-align: center;
            }

            & .icon {
                margin: 0 auto 0;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
            }


            & .icon img {
                width: 100%;
                max-width: 280px;
            }


            & h1 {
                margin: 0 0 14px;
                font-size: 32px;
                color: #00433f;
                font-family: IRANSansBold, serif;
            }

            & h3 {
                margin: 0 0 32px;
                font-size: 18px;
                color: #00433f;
                font-family: IRANSansMedium, serif;
                font-weight: normal;
            }


            & p {
                margin: 0 0 24px;
                font-size: 14px;
                line-height: 1.8;
                color: #4b5563;
            }


            & button {
                all: unset;
                cursor: pointer;
                display: inline-block;
                padding: .55rem 1.1rem;
                border-radius: .5rem;
                background: #004944;
                color: #fff;
                font-size: 1rem;
                font-weight: 500;
                transition: all .15s ease;
                box-sizing: border-box;
            }

            & button:hover {
                background: #00645d;
                transform: translateY(-1px);
                box-shadow: 0 4px 10px rgba(0, 73, 68, .2);
            }

            & button:active {
                transform: translateY(0);
                box-shadow: 0 2px 6px rgba(0, 0, 0, .15) inset;
            }


            & button.btn-back {
                background: transparent;
                color: #004944;
                border: 1px solid #004944;
            }

            & button.btn-back:hover {
                background: #004944;
                color: #fff;
            }


            & button.btn-home {
                background: #004944;
                color: #fff;
            }

            & button.btn-home:hover {
                background: #00645d;
            }


            @@media (max-width: 480px) {
                & h3 {
                    font-size: 16px;
                }

                & h1 {
                    font-size: 26px;
                }

                & .icon img {
                    max-width: 220px;
                }

                & p {
                    font-size: 13px;
                }
            }


        }
    </style>
</head>
<body>

<div class="err-container">

    <div class="icon">
        <img src="@(errorImage)" alt="error">
    </div>
    <h1>خطای @statusCode</h1>
    @switch (statusCode) {
        case 404: {
            <h3>@(string.IsNullOrEmpty(errorMessage) ? "متاسفانه صفحه مورد نظر شما یافت نشد!" : errorMessage)</h3>

            <button class="btn-back" onclick="history.back()">
                بازگشت به صفحه قبل
            </button>

            <a href="/">
                <button class="btn-home">رفتن به صفحه اصلی</button>
            </a>

            break;
        }

        case 403: {
            <h3>شما به این بخش دسترسی ندارید!</h3>

            <a href="/">
                <button class="btn-home">رفتن به صفحه اصلی</button>
            </a>

            break;
        }

        case >= 500: {
            <h3>در حال حاضر امکان پردازش درخواست وجود ندارد!</h3>
            <button onclick="location.reload()">بارگذاری مجدد</button>
            break;
        }

        default: {
            <h3>در انجام درخواست مشکلی به وجود آمده!</h3>
            <button onclick="location.reload()">بارگذاری مجدد</button>
            break;
        }
    }

</div>

</body>
</html>