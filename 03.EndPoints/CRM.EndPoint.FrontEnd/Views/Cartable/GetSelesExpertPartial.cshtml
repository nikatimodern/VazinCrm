                                        <label style="color:gray;min-width:44px">سریال:</label>
                                        <label style="font-family:'IRANSansBold';text-align:center">@item.SerialNumber</label>
                                    </div>

                                    <div class="my-2 d-md-none d-xxl-block " style="background-color: rgba(0, 0, 0, 0.15); width: 85%;height:1px;margin-inline:auto"></div>

                                    <div class="d-flex flex-column align-items-center justify-content-center col gap-1 px-2 flex-wrap" style="min-width:120px">
                                        <div style="display:flex;align-items:center; justify-content:center;gap:8px">
                                            <label style="color:gray;min-width:44px">مشتری:</label>
