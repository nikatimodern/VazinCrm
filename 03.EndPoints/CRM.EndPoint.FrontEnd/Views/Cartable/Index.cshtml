@{
    var canAccessFinancialExpert = User.IsAdmin() || User.IsFinancialExpert();
    var canAccessFinancialAdmin = false; //User.IsAdmin() || User.IsFinancialAdmin();
    var canAccessSalesExpert = User.IsAdmin() || User.IsSalesExpert();
    var canAccessSalesAdmin = User.IsAdmin() || User.IsSalesAdmin();
    var canAccessTaminExpert = User.IsAdmin() || User.IsTamin() || User.IsManagingDirector();
    var canAccessManagingDirector = User.IsAdmin() || User.IsManagingDirector();
}


<div>
    <div id="CartableTabs" class="d-flex justify-content-center flex-wrap-reverse">
        <div class="TCar" id="TPrefactorFactorId" onclick="GetCartable('TPrefactorFactorId')">
            <p>پیش فاکتور و فاکتور</p>
        </div>
        @if (canAccessFinancialExpert) {
            <div class="TCar" id="TFinancialExpertId" onclick="GetCartable('TFinancialExpertId')">
                <span class="badge-count d-none" style="position: absolute;top: -6px;left: 0;z-index: 10"></span>
                <p>کارشناس مالی</p>
            </div>
        }
        @if (canAccessFinancialAdmin) {
            <div class="TCar d-none" id="TFinancialAdminId" onclick="GetCartable('TFinancialAdminId')">
                <p>مدیر مالی</p>
            </div>
        }
        @if (canAccessSalesExpert) {
            <div class="TCar" id="TSalesExpertId" onclick="GetCartable('TSalesExpertId')">
                <span class="badge-count d-none" style="position: absolute;top: -6px;left: 0;z-index: 10"></span>
                <p>کارشناس فروش</p>
            </div>
        }
        @if (canAccessSalesAdmin) {
            <div class="TCar" id="TSalesAdminId" onclick="GetCartable('TSalesAdminId')">
                <span class="badge-count d-none" style="position: absolute;top: -6px;left: 0;z-index: 10"></span>
                <p>مدیر فروش</p>
            </div>
        }
        @if (canAccessTaminExpert) {
            <div class="TCar" id="TTaminExpertId" onclick="GetCartable('TTaminExpertId')">
                <span class="badge-count d-none" style="position: absolute;top: -6px;left: 0;z-index: 10"></span>
                <p>کارشناس تامین</p>
            </div>
        }
        @if (canAccessManagingDirector) {
            <div class="TCar" id="TManagingDirectorId" onclick="GetCartable('TManagingDirectorId')">
                <span class="badge-count d-none" style="position: absolute;top: -6px;left: 0;z-index: 10"></span>
                <p>مدیر عامل</p>
            </div>
        }
    </div>
    <div class="CartableContent mx-auto">

        <partial name="_CartablePreFactorFactor" /> @*کارتابل پیش فاکتور و فاکتور*@

        @if (canAccessFinancialExpert) {
            <partial name="_CartableFinancialExpert" /> @*کارتابل کارشناس مالی*@
        }

        @if (canAccessFinancialAdmin) {
            <partial name="_CartableFinancialAdmin" /> @*کارتابل مدیر مالی*@
        }

        @if (canAccessSalesExpert) {
            <partial name="_CartableSalesExpert" /> @*کارتابل کارشناس فروش*@
        }

        @if (canAccessSalesAdmin) {
            <partial name="_CartableSalesAdmin" /> @*کارتابل مدیر فروش*@
        }

        @if (canAccessTaminExpert) {
            <partial name="_CartableTaminExpert" /> @*کارتابل کارشناس تامین*@
        }

        @if (canAccessManagingDirector) {
            <partial name="_CartableManagingDirector" /> @*کارتابل مدیر عامل*@
        }
    </div>
</div>




