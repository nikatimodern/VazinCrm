@section Styles {

    <link rel="stylesheet" href="~/css/operationsTheme.css?release=7.5.2" asp-append-version="true" />
}

@{
    Layout = "_Layout";
}

<div id="receivedChecksContainer" class="crm-operations-theme">
    <div class="px-2 w-100 d-flex justify-content-between flex-wrap gap-2 align-items-center align-items-md-center">

        <div class="d-flex align-items-center justify-content-start gap-1 fbold" style="font-size:clamp(16px,2vw,18px);color:rgb(84 57 213)">
            تعداد: <span id="receivedChecksCount"></span>
        </div>

        <div class="search-group col-12 order-5 order-md-0 col-md-5">
            <input class="form-control" type="text" id="receivedChecksSearchId" placeholder="جستجو..." />
            <div class="search-icon">
                <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z" clip-rule="evenodd" /></svg>
            </div>
        </div>

        <div class="d-flex gap-2">
            <ul class="filter-switch filter-switch-sm">
                <li class="filter-switch-item">
                    <input type="radio" name="receivedChecksFilter" id="receivedChecksFilterAll" value="-1" checked />
                    <label for="receivedChecksFilterAll">همه</label>
                </li>
                <li class="filter-switch-item">
                    <input type="radio" name="receivedChecksFilter" id="receivedChecksFilter1" value="1" />
                    <label for="receivedChecksFilter1">
                        در انتظار تایید
                        <span class="badge-count filter-count-badge"></span>
                    </label>
                </li>
                <li class="filter-switch-item">
                    <input type="radio" name="receivedChecksFilter" id="receivedChecksFilter2" value="2" />
                    <label for="receivedChecksFilter2">
                        تایید شده
                        <span class="badge-count filter-count-badge"></span>
                    </label>
                </li>
                <li class="filter-switch-item">
                    <input type="radio" name="receivedChecksFilter" id="receivedChecksFilter3" value="3" />
                    <label for="receivedChecksFilter3">
                        رد شده
                        <span class="badge-count filter-count-badge"></span>
                    </label>
                </li>
            </ul>
        </div>
    </div>

    <div class="w-100 mt-3" id="receivedChecksContentId">
    </div>
</div>

<partial name="~/Views/Accountancy/Modals/_InvoiceModal.cshtml" />
<partial name="~/Views/Accountancy/Modals/_InvoiceTransferModal.cshtml" />
<partial name="~/Views/Accountancy/Modals/_InvoiceVosolModal.cshtml" />
<partial name="Modals/_NotAcceptModal" />

@section Scripts {
    <script>document.addEventListener("DOMContentLoaded", () => enableMomentumScrollScope(document.getElementById("receivedChecksContainer")));</script>
    <script data-page-bindings="getReceivedChecks">
        document.addEventListener("DOMContentLoaded", async () => {
            await getReceivedChecks();

            initChangeRadio("receivedChecksFilter", async () => await getReceivedChecks());
            initSearchInput("receivedChecksSearchId", async () => await getReceivedChecks());
        });


        const getReceivedChecks = async () => {
            const val = document.getElementById("receivedChecksSearchId")?.value.trim() ?? "";
            const type = document.querySelector("input[type='radio'][name='receivedChecksFilter']:checked")?.value;
            if (type === undefined) return;

            try {
                await sendApiRequest({
                    url: `/Accountancy/GetAllPaymentCartablePartial`,
                    skeleton: { target: "#receivedChecksContentId" },
                    params: { serVal: val, type: type, cartable: 7, payType: 2 },
                    onSuccess: function (res) {
                        const data = res.data;
                        document.getElementById("receivedChecksContentId").innerHTML = data.html;
                        document.getElementById("receivedChecksCount").textContent = data.count;
                        updateFilterSwitchState({
                            wrapperSelector: "#receivedChecksContainer",
                            filterData: res.data.filterCounts,
                            currentFilterValue: type,
                            searchValue: val,
                            onChange: async () => {
                                await getReceivedChecks();
                            },
                        });
                        initPaymentPartial(55);
                    },
                });
            } catch (err) {
                console.log(err);
            }
        };

    </script>
}
