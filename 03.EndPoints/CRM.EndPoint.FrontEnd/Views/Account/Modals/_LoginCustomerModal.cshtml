<!-- Modal loginCustomer -->
<div class="modal fade" id="loginCustomerModal" tabindex="-1" role="dialog" data-bs-focus="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #f1f1f1;">
                <h1 class="modal-title fs-5" style="color: #333;">احراز هویت</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="loginCustomerContainer">

                    <div id="selectAccountCustomerContainer" style="display: none">
                        <p class="mb-3 text-muted fMedium" style="font-size: 12px">
                            چند حساب با این شماره یافت شد. لطفاً یکی را انتخاب کنید:
                        </p>
                        <div id="accountCustomerList" class="list-group"></div>
                    </div>


                    <div id="loginOtpCustomerContainer" class="flex-column align-items-center w-100" style="display: flex">
                        <div id="otpCustomerSection" class="w-100 d-flex flex-column">
                            <p class="text-muted fMedium" style="font-size: 12px">لطفا کد ارسال شده به شماره
                                <strong id="phoneNumberOtpCustomerLogin"></strong> را وارد نمایید
                            </p>
                            <div class="input-group mb-2" style="height: 33px">
                                <span class="input-group-text h-100">
                                    <svg style="height: 100%;color: #787c83" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z"></path></svg>
                                </span>
                                <input id="otpCustomerLoginInp" class="form-control bootstrap-only h-100 digitNumber text-start" name="otp" autocomplete="one-time-code" inputmode="numeric" type="text" autofocus maxlength="4" placeholder="کد ورود">
                            </div>
                            <div id="verifyOtpCustomerBtnWrapper" class="w-100 justify-content-between" style="display: flex">
                                <p class="text-muted" style="display: flex;align-items: baseline; gap: 4px;font-size: 12px">
                                    <span>زمان باقی‌مانده: </span>
                                    <strong id="remainingSecondsOtpCustomerLogin"></strong>
                                </p>
                                <button id="verifyOtpCustomerBtn" class="btn btn-sm btn-success">تایید کد</button>
                            </div>
                        </div>
                        <div class="d-flex align-items-center justify-content-between w-100">
                            <p class="fMedium" style="color: #dc3545;font-size: 12px" id="otpCustomerLoginMsg"></p>
                            <button id="resendOtpCustomerBtn" class="btn btn-sm btn-secondary" style="display: none">ارسال مجدد کد</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>