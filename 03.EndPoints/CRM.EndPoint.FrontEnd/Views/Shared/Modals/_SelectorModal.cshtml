<!-- Generic Selector Modal -->
<div class="modal fade" id="modalSelector" tabindex="-1" data-bs-focus="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" style="border-radius: 12px; overflow: hidden; box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25)">

            <div class="modal-header">
                <div class="d-flex align-items-center justify-content-between w-100">
                    <span id="modalSelectorTitle" class="fbold"></span>
                    <div>
                        <input id="modalSelectorSearch" type="text" class="form-control" placeholder="جستجو..">
                    </div>
                </div>
            </div>

            <div class="modal-body p-0">
                <div id="modalSelectorContainer"></div>
            </div>

            <div class="modal-footer justify-content-center p-2">
                <button id="modalSelectorCancel" style="padding-block:4px" type="button" class="buttonCancel2"> انصراف</button>
                <button id="modalSelectorSubmit" style="padding-block:4px" type="button" class="buttonGreen3"> ثبت</button>
            </div>
        </div>
    </div>
</div>