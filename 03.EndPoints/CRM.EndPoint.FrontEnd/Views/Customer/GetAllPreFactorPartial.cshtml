@using CRM.Core.Domain.Deals.Enums
@using CRM.Core.Domain.PreFactors.Enum
@model CRM.EndPoint.FrontEnd.Models.PreFactor.PrefactorViewModel;

@{
    Layout = null;
    var passType = ViewBag.PassType; // 1: CustomerProfile | 4: Deal
}

<div class="d-flex flex-column w-100" style="gap: 5px">
    @foreach (var item in Model.data) {
        var isInvalid = item.Pftype is (int)PreFactorEnum.فاقد_اعتبار or (int)PreFactorEnum.بسته_شده
            or (int)PreFactorEnum.حذف_شده or (int)PreFactorEnum.برگشت_خورده_از_طرف_مدیر_فروش;

        var isDealClosed = item.Deal?.FinancialStatus == DealFinancialStausEnum.تایید_شده;
        var hasAccess = !isDealClosed && (User.IsAdmin() || User.IsSalesAdmin() || item.UserCreatorID == User.GetUserId());
        var hideAddInvoiceBtns = isInvalid || !hasAccess;

        <div class="d-flex w-100 position-relative">
            @if (item.IsDeleted) {
                <div style="background-color:rgba(250,250,250,0.63); position:absolute;inset:0;z-index:10;border-radius: 5px 10px 10px 5px;"></div>
                <div style="padding:10px; border-radius:50px; background-color:red; color:aliceblue; opacity:30%;  position:absolute;font-family:'IRANSansBold'; font-size:24px; top: 50%;left: 50%;transform: rotate(350deg) translate(-50%, -70%);z-index:20">
                    <p>حذف شده</p>
                </div>
            }

            <partial name="~/Views/PreFactor/_PreFactorSideLabels.cshtml" model="item" />

            <div data-serialnumber="@item.SerialNumber" class="d-flex flex-column flex-sm-row flex-grow-1 justify-content-between InfoDataItem_Prefactor w-100 py-2" style="@(isDealClosed ? "background-color: #19875414" : "")">
                <div class="d-flex flex-column w-100 justify-content-between">
                    <div class="mp flex-column flex-md-row px-2" style=" display:flex;justify-content:space-between; width:100%;direction:rtl; height:100%">

                        <div class="col-12 col-md-auto flex-md-column flex-wrap column-gap-3 row-gap-2 pe-2 ps-3" style="text-align:center; display:flex;align-items:center; justify-content:space-around">
                            <div class="d-flex align-items-center gap-1">
                                <label style="color:gray">سریال:</label>
                                <label class="fbold">@item.SerialNumber</label>
                            </div>
                            @if (item.DealSerialNumber != null && passType != 4) {
                                <div class="d-flex align-items-center gap-1">
                                    <label style="color:gray">سفارش:</label>
                                    <label class="fbold">@item.DealSerialNumber</label>
                                </div>
                            }
                            <div class="d-flex align-items-center gap-1">
                                <label style="color:gray">تاریخ:</label>
                                <label class="fbold">@item.Date</label>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <label style="color:gray">اعتبار:</label>
                                <label class="fbold">@item.ValidityDade</label>
                            </div>
                        </div>
                        <div class="d-md-none my-2 " style="background-color: rgba(0, 0, 0, 0.15); width: 85%;height:1px;margin-inline:auto"></div>

                        <div class="col-12 col-md flex-wrap column-gap-3 row-gap-2 px-2 ps-0 flex-md-column" style="flex-grow: 1.2;text-align:center; display:flex;align-items:center;justify-content:space-around;column-gap:24px !important">
                            <div style=" display:flex;align-items:center; justify-content:center;gap:6px">
                                <label style="color:gray">مبلغ:</label>
                                <label style="font-family:'IRANSansBold'">@string.Format("{0:n0}", item.SumTotalAmountTax) <span style="font-size: 12px"> @(item.CurrencyTypeTxt ?? "ريال")</span></label>

                            </div>

                            <div style=" display:flex;align-items:center; justify-content:center;gap:6px ">
                                <label style=" color:gray">پیش پرداخت:</label>
                                <label style="font-family:'IRANSansBold'">@string.Format("{0:n0}", item.ReciveAmount) <span style="font-size: 12px"> @(item.CurrencyTypeTxt ?? "ريال")</span></label>
                            </div>
                            <div class="flex-center d-md-none flex-row flex-md-column gap-2 gap-md-0">
                                <label style="color:gray">وضعیت:</label>
                                <label class="text-center" style="font-family:'IRANSansBold'">@item.PftypeTxt</label>
                            </div>
                            @if (item.CustomerId.HasValue) {
                                <div class="d-none d-md-flex" style=" align-items:center; justify-content:center;gap:4px;max-width: 180px;width: 100%">
                                    <button class="buttonPurple p-0 flex-grow-1 fMedium" style="height:auto !important; border-radius:5px;font-size: 13px;max-width: 140px " onclick="ShowModalListInvoice('@item.Id', 1,'@item.SerialNumber', @passType, @hideAddInvoiceBtns.ToString().ToLower())">صورت حساب</button>
                                </div>
                            }
                        </div>
                        <div class="d-md-none my-2" style="background-color: rgba(0, 0, 0, 0.15); width: 85%;height:1px;margin-inline:auto"></div>

                        <div class="col-12 col-md flex-row flex-md-column flex-wrap gap-2 pe-2" style=" display:flex;align-items:center;justify-content:space-around">
                            <div class="flex-center d-none d-md-flex flex-row flex-md-column gap-2 gap-md-0">
                                <label style="color:gray">وضعیت:</label>
                                <label class="text-center fbold" style="font-size: 13px">@item.PftypeTxt </label>
                            </div>
                            @if (item.CustomerId.HasValue) {
                                <div class="d-flex d-md-none" style=" align-items:center; justify-content:center;gap:4px">
                                    <button class="buttonPurple px-4" style="height:auto !important;border-radius:5px;cursor:pointer; font-family:'IRANSansBold'" onclick="ShowModalListInvoice('@item.Id', 1, '@item.SerialNumber', @passType, @hideAddInvoiceBtns.ToString().ToLower())">صورت حساب</button>
                                </div>
                            }
                            @switch (item.Pftype) {
                                case (int)PreFactorEnum.در_انتظار_واگذاری_به_مسئول_تامین:
                                    if (hasAccess) {
                                        <div class="flex-center flex-row flex-md-column gap-2">
                                            <form id="@item.Id">
                                                <select style="width:100%;" id="S_@item.Id" name="S_@item.Id" class="test form-select form-select-sm" required>
                                                    @foreach (var i in Model.UserTamin) {
                                                        <option value="@i.Id">@i.FullName</option>
                                                    }
                                                </select>
                                            </form>
                                            <button style="border-radius:4px;height:auto;width:80px " class="buttonGreen px-2" onclick="regUtamin('@item.Id', @passType)">ثبت</button>
                                        </div>
                                    }

                                    break;
                                case (int)PreFactorEnum.در_انتظار_تایید_مسئول_تامین:
                                    if (hasAccess) {
                                        <button style="font-size: 13px;transition: all 0.3s;" class="ToSend w-auto h-auto flex-center gap-1 px-2 py-1" onclick="resendRegUtamin('@item.Id', '@item.UserTaminId', @passType)">
                                            <i class="mp fa fa-paper-plane" aria-hidden="true"></i>
                                            <span>ارسال مجدد به تامین</span>
                                        </button>
                                    }

                                    break;
                                case (int)PreFactorEnum.در_انتظار_ارسال_به_مشتری:
                                    if (hasAccess) {
                                        <button style="font-size: 13px;transition: all 0.3s" id="BtnSendToId" class="ToSend w-auto h-auto d-flex align-items-center gap-1 px-2 py-1" onclick="showMobileModal('@item.Id', @passType)">
                                            <i class="mp fa fa-paper-plane" aria-hidden="true"></i> ارسال شود
                                        </button>
                                    }

                                    break;
                                case (int)PreFactorEnum.در_انتظار_تایید_مشتری:
                                    if (hasAccess) {
                                        <div class="flex-center flex-wrap flex-row flex-md-column gap-2">
                                            <button style="font-size: 13px;transition: all 0.3s;" id="BtnSendToId" class="ToSend w-auto h-auto flex-center gap-1 px-2 py-1" onclick="showMobileModal('@item.Id')">
                                                <i class="mp fa fa-paper-plane" aria-hidden="true"></i>
                                                <span>ارسال مجدد به مشتری</span>
                                            </button>
                                            <button style="font-size: 13px;transition: all 0.3s;" id="BtnSendToId" class="ToSend w-auto h-auto px-2 py-1" onclick="HandAccepting('@item.Id', @passType)"> تایید به صورت دستی</button>
                                        </div>
                                    }

                                    break;
                                case (int)PreFactorEnum.فاقد_اعتبار:
                                    break;
                                case (int)PreFactorEnum.در_انتظار_تایید_مدیر_فروش:
                                    if (hasAccess) {
                                        <div class="flex-center flex-wrap flex-row flex-md-column gap-2" style="font-size: 13px">
                                            <div style="display:flex;flex-direction:column;align-items:center;justify-content:space-evenly">
                                                <button style="border-radius:4px;height:auto;width:90px;" class="buttonGreen px-2" onclick="showModalCreateOrder(@((int)Model._Setting.SetAmountByRoleType), '@item.Id','@item.CustomerId', '@item.DealId', @item.DealSerialNumber)">حواله تولید</button>
                                            </div>
                                        </div>
                                    }

                                    break;
                                case (int)PreFactorEnum.در_انتظار_تایید_مالی:
                                    if (hasAccess) {
                                        <div class="flex-center flex-wrap flex-row flex-md-column gap-2" style="font-size: 13px">
                                            <div style="display:flex;flex-direction:column;align-items:center;justify-content:space-evenly">
                                                <button style="border-radius:4px;height:auto;width:90px;" class="buttonGreen px-2" onclick="showModalCreateOrder(@((int)Model._Setting.SetAmountByRoleType), '@item.Id','@item.CustomerId', '@item.DealId', @item.DealSerialNumber)">حواله تولید</button>
                                            </div>
                                        </div>
                                    }

                                    break;
                                case (int)PreFactorEnum.در_انتظار_تولید:
                                    <div class="flex-center flex-wrap flex-row flex-md-column gap-2" style="font-size: 13px">
                                        @if (hasAccess) {
                                            <div style="display:flex;flex-direction:column;align-items:center;justify-content:space-evenly">
                                                <button style="border-radius:4px;height:auto;width:90px;" class="buttonGreen px-2" onclick="showModalCreateOrder(@((int)Model._Setting.SetAmountByRoleType), '@item.Id','@item.CustomerId', '@item.DealId', @item.DealSerialNumber)">حواله تولید</button>
                                            </div>
                                        }
                                        <div class="flex-center flex-wrap gap-2">
                                            <button style="border-radius:4px;height:auto;width:80px " class="buttonGreen px-2" onclick="showModalDeliver('@item.Id',1 )">مانده تولید</button>
                                            @if (hasAccess) {
                                                <button style="border-radius:4px;height:auto;width:80px" class="buttonGreen px-2" onclick="delivered('@item.Id', @passType)">اتمام کار</button>
                                            }
                                        </div>
                                    </div>
                                    break;
                                case (int)PreFactorEnum.جنس_به_مشتری_تحویل_داده_شد:
                                    if (hasAccess) {
                                        <button style="border-radius:4px;height:auto;width:90px;" class="buttonGreen px-2" onclick="backDelivered('@item.Id', @passType)">لغو اتمام کار</button>
                                    }

                                    break;
                            }
                        </div>
                        <div class="d-md-none my-2 " style="background-color: rgba(0, 0, 0, 0.15); width: 85%;height:1px;margin-inline:auto"></div>

                        <partial name="~/Views/PreFactor/_PreFactorFactorsCountPartial.cshtml"
                                 model="item"
                                 view-data='new ViewDataDictionary(ViewData) { ["Setting"] = Model._Setting, ["PassType"] = passType }' />

                        <div class="d-sm-none mt-2 " style="background-color: rgba(0, 0, 0, 0.15); width: 85%;height:1px;margin-inline:auto"></div>
                    </div>

                    <partial name="~/Views/PreFactor/_PreFactorProgressTracker.cshtml"
                             model="item"
                             view-data='new ViewDataDictionary(ViewData) { ["IsInvalid"] = isInvalid }' />

                    @if (!User.IsCustomer()) {
                        <partial name="~/Views/PreFactor/_PreFactorDescription.cshtml"
                                 model="item"
                                 view-data='new ViewDataDictionary(ViewData) { ["IsDealClosed"] = isDealClosed }' />
                    }

                    <div class="d-sm-none mt-3" style="background-color: rgba(0, 0, 0, 0.15); width: 85%;height:1px;margin-inline:auto"></div>

                </div>

                <partial name="~/Views/PreFactor/_PreFactorActions.cshtml"
                         model="item"
                         view-data='new ViewDataDictionary(ViewData) { ["PassType"] = passType, ["HasAccess"] = hasAccess }' />
            </div>
        </div>
    }
</div>