@{
    ViewData["Title"] = "مدیریت سطح دسترسی";
}
<section id="accessCatalog" class="ac-page" dir="rtl">
    @Html.AntiForgeryToken()
    <nav class="ac-main-tabs" role="tablist" aria-label="بخش‌های مدیریت سطح دسترسی">
        <button type="button" id="acCatalogTab" data-main-tab="catalog" class="is-active"
                role="tab" aria-controls="acCatalogPanel" aria-selected="true">انتیتی‌ها و دسترسی‌ها</button>
        <button type="button" id="acRolesTab" data-main-tab="roles"
                role="tab" aria-controls="acRolesPanel" aria-selected="false" tabindex="-1">مدیریت نقش‌ها</button>
        <button type="button" id="acUsersTab" data-main-tab="users"
                role="tab" aria-controls="acUsersPanel" aria-selected="false" tabindex="-1">مدیریت کاربران</button>
        <button type="button" id="acHistoryTab" data-main-tab="history"
                role="tab" aria-controls="acHistoryPanel" aria-selected="false" tabindex="-1">تاریخچه و بازگردانی</button>
    </nav>

    <div id="acCatalogPanel" role="tabpanel" aria-labelledby="acCatalogTab">
    <div class="ac-layout">
        <aside class="ac-panel ac-entity-panel" aria-label="فهرست انتیتی‌ها">
            <div class="ac-panel-heading">
                <h2>انتیتی‌ها <span class="ac-count" data-entity-count>۰</span></h2>
                <div class="ac-toolbar-actions">
                    <button type="button" class="ac-btn ac-btn-primary" data-action="new-entity">
                        <i class="fas fa-plus" aria-hidden="true"></i> افزودن انتیتی
                    </button>
                    <button type="button" class="ac-icon-button" data-action="reload" title="تازه‌سازی" aria-label="تازه‌سازی">
                        <i class="fas fa-sync-alt" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
            <label class="ac-search">
                <i class="fas fa-search" aria-hidden="true"></i>
                <input type="search" data-entity-search placeholder="جست‌وجوی انتیتی..." maxlength="150" aria-label="جست‌وجوی انتیتی" />
            </label>
            <div class="ac-entities" data-entities aria-live="polite">
                <p class="ac-muted">در حال دریافت اطلاعات...</p>
            </div>
        </aside>
        <section class="ac-panel ac-permission-panel" aria-label="دسترسی‌های انتیتی">
            <div class="ac-panel-heading ac-permission-heading">
                <div>
                    <h2 data-selected-title>دسترسی‌های انتیتی</h2>
                    <p data-selected-key>برای شروع یک انتیتی انتخاب کنید.</p>
                </div>
                <div class="ac-toolbar-actions">
                    <button type="button" class="ac-btn ac-btn-primary" data-action="new-permission" disabled>
                        <i class="fas fa-plus" aria-hidden="true"></i> افزودن دسترسی
                    </button>
                </div>
            </div>
            <div class="ac-permission-guide">
                <i class="fas fa-info-circle" aria-hidden="true"></i>
                تعریف دسترسی در این مرحله فقط برای ثبت در فهرست است و هنوز روی عملیات برنامه اعمال نمی‌شود.
            </div>
            <div class="ac-permissions" data-permissions aria-live="polite">
                <div class="ac-empty"><i class="fas fa-shield-alt" aria-hidden="true"></i><p>یک انتیتی را از فهرست انتخاب کنید.</p></div>
            </div>
        </section>
    </div>
    </div>

    <div id="acRolesPanel" role="tabpanel" aria-labelledby="acRolesTab" hidden>
        <div class="ac-layout ac-role-layout">
            <aside class="ac-panel" aria-label="فهرست نقش‌ها">
                <div class="ac-panel-heading">
                    <h2>نقش‌ها <span class="ac-count" data-role-count>۰</span></h2>
                    <div class="ac-toolbar-actions">
                        <button class="ac-btn ac-btn-primary" type="button" data-action="new-role">
                            <i class="fas fa-plus" aria-hidden="true"></i> افزودن نقش
                        </button>
                        <button class="ac-icon-button" type="button" data-action="reload-roles"
                                title="تازه‌سازی نقش‌ها" aria-label="تازه‌سازی نقش‌ها">
                            <i class="fas fa-sync-alt" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
                <label class="ac-search">
                    <i class="fas fa-search" aria-hidden="true"></i>
                    <input type="search" data-role-search placeholder="جست‌وجوی نقش..." aria-label="جست‌وجوی نقش" maxlength="150" />
                </label>
                <div class="ac-roles-list" data-roles-list aria-live="polite">
                    <p class="ac-muted">برای مشاهده نقش‌ها این تب را انتخاب کنید.</p>
                </div>
                <p class="ac-role-list-guide">همه نقش‌ها قابل ویرایش و حذف هستند. پیش از حذف، مجوزهای وابسته به کاربران را تعیین تکلیف کنید.</p>
            </aside>
            <section class="ac-panel" aria-label="مجوزهای نقش انتخاب‌شده">
                <div class="ac-panel-heading ac-role-detail-heading">
                    <div>
                        <h2 data-role-title>دسترسی‌های نقش</h2>
                        <p data-role-subtitle>برای شروع یک نقش انتخاب کنید.</p>
                    </div>
                    <div class="ac-toolbar-actions">
                        <button class="ac-btn ac-btn-muted" type="button" data-action="reset-role" disabled>بازگرداندن تغییرات</button>
                        <button class="ac-btn ac-btn-primary" type="button" data-action="save-role" disabled>
                            <i class="fas fa-save" aria-hidden="true"></i> ذخیره دسترسی‌ها
                        </button>
                    </div>
                </div>
                <div class="ac-role-tools">
                    <label class="ac-search ac-role-search">
                        <i class="fas fa-search" aria-hidden="true"></i>
                        <input type="search" data-role-permission-search placeholder="جست‌وجوی انتیتی یا مجوز..."
                               aria-label="جست‌وجوی دسترسی‌ها" maxlength="150" />
                    </label>
                    <span class="ac-selected-count" data-role-selected>۰ دسترسی انتخاب شده</span>
                </div>
                <p class="ac-role-notice">
                    <i class="fas fa-info-circle" aria-hidden="true"></i>
                    برای دسترسی‌های دارای محدوده، «فقط خود» و «همه» مستقل از هم تنظیم می‌شوند. اعمال محدودیت واقعی روی ماژول‌ها مرحله‌ای است.
                </p>
                <p class="ac-error ac-role-error" data-role-error role="alert" hidden></p>
                <div class="ac-role-groups" data-role-groups aria-live="polite">
                    <div class="ac-empty"><i class="fas fa-user-shield" aria-hidden="true"></i>
                        <p>یک نقش انتخاب کنید تا مجوزهای انتیتی‌ها نمایش داده شوند.</p>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <div id="acUsersPanel" class="ac-users-panel" role="tabpanel" aria-labelledby="acUsersTab" hidden>
        <div class="ac-layout ac-role-layout ac-user-layout">
            <aside class="ac-panel ac-user-list-panel" aria-label="کاربران">
                <div class="ac-panel-heading">
                    <h2>کاربران <span class="ac-count" data-users-count>۰</span></h2>
                    <div class="ac-toolbar-actions">
                        <button type="button" class="ac-btn ac-btn-primary" data-action="new-user">
                            <i class="fas fa-user-plus" aria-hidden="true"></i> افزودن کاربر
                        </button>
                        <button type="button" class="ac-icon-button" data-action="reload-users"
                                title="تازه‌سازی" aria-label="تازه‌سازی کاربران">
                            <i class="fas fa-sync-alt" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
                <label class="ac-search">
                    <i class="fas fa-search" aria-hidden="true"></i>
                    <input type="search" data-users-search maxlength="150" placeholder="نام، نام کاربری یا تلفن..."
                           aria-label="جست‌وجوی کاربران" />
                </label>
                <div class="ac-user-type-filter">
                    <label for="acUserTypeFilter">نوع کاربر</label>
                    <select id="acUserTypeFilter" data-users-type aria-label="فیلتر نوع کاربر">
                        <option value="employee" selected>کارمندان</option>
                        <option value="customer">مشتریان</option>
                        <option value="supplier">تأمین‌کنندگان</option>
                        <option value="all">همه کاربران</option>
                    </select>
                </div>
                <div class="ac-users-list" data-users-list aria-live="polite">
                    <p class="ac-muted">برای نمایش کاربران این تب را انتخاب کنید.</p>
                </div>
                <div class="ac-users-pagination">
                    <button class="ac-btn ac-btn-muted" type="button" data-action="user-prev" disabled>قبلی</button>
                    <span data-users-page>صفحه ۱</span>
                    <button class="ac-btn ac-btn-muted" type="button" data-action="user-next" disabled>بعدی</button>
                </div>
            </aside>
            <section class="ac-panel ac-user-access-panel" aria-label="مجوزهای کاربر">
                <div class="ac-panel-heading ac-role-detail-heading">
                    <div>
                        <h2 data-user-title>دسترسی‌های کاربر</h2>
                        <p data-user-position>برای شروع یک کاربر را انتخاب کنید.</p>
                        <p data-user-subtitle></p>
                    </div>
                    <div class="ac-toolbar-actions ac-user-action-buttons">
                        <button class="ac-btn ac-btn-muted" type="button" data-action="edit-user" disabled>
                            <i class="fas fa-pen" aria-hidden="true"></i> ویرایش کاربر
                        </button>
                        <button class="ac-btn ac-btn-outline-purple" type="button" data-action="reset-user"
                                title="لغو تغییرات ذخیره‌نشده و بازگشت به آخرین وضعیت ذخیره‌شده" disabled>
                            <i class="fas fa-undo-alt" aria-hidden="true"></i> بازگردانی
                        </button>
                        <button class="ac-btn ac-btn-purple" type="button" data-action="user-clear-overrides"
                                title="حذف استثناهای اختصاصی و استفاده از مجوزهای نقش‌ها" disabled>
                            <i class="fas fa-history" aria-hidden="true"></i> بازگردانی به نقش‌ها
                        </button>
                        <button class="ac-btn ac-btn-primary" type="button" data-action="save-user" disabled>
                            <i class="fas fa-save" aria-hidden="true"></i> ذخیره دسترسی‌ها
                        </button>
                    </div>
                </div>
                <div class="ac-role-tools">
                    <label class="ac-search ac-role-search">
                        <i class="fas fa-search" aria-hidden="true"></i>
                        <input type="search" data-user-permission-search maxlength="150"
                               placeholder="جست‌وجوی مجوز یا انتیتی..." aria-label="جست‌وجوی دسترسی‌های کاربر" />
                    </label>
                    <label class="ac-user-only-overrides">
                        <input type="checkbox" data-user-only-overrides />
                        فقط استثناهای اختصاصی
                    </label>
                    <span class="ac-selected-count" data-user-effective-count>۰ مجوز مؤثر</span>
                </div>
                <div class="ac-user-access-summary" role="note" aria-label="خلاصه نحوه اعمال دسترسی">
                    <span class="ac-user-summary-description">
                        <i class="fas fa-info-circle" aria-hidden="true"></i>
                        مجوزها از نقش‌ها محاسبه می‌شوند و استثناهای اختصاصی اولویت دارند.
                    </span>
                    <span class="ac-user-summary-pills">
                        <span><i class="fas fa-user-tag" aria-hidden="true"></i> <span data-user-summary-roles>۰ نقش</span></span>
                        <span><i class="fas fa-key" aria-hidden="true"></i> <span data-user-summary-overrides>۰ استثنا</span></span>
                        <span><i class="fas fa-users" aria-hidden="true"></i> <span data-user-summary-selected>۰ مجوز انتخابی</span></span>
                    </span>
                </div>
                <p class="ac-error ac-role-error" data-user-error role="alert" hidden></p>
                <div class="ac-role-groups ac-user-permission-groups" data-user-permissions aria-live="polite">
                    <div class="ac-empty"><i class="fas fa-user-shield" aria-hidden="true"></i>
                        <p>یک کاربر انتخاب کنید تا مجوزهای مؤثر او نمایش داده شوند.</p>
                    </div>
                </div>
            </section>
            <aside class="ac-panel ac-user-roles-panel" aria-label="نقش‌های کاربر انتخاب‌شده">
                <div class="ac-panel-heading">
                    <h2><i class="fas fa-layer-group" aria-hidden="true"></i> نقش‌های کاربر</h2>
                    <span class="ac-count" data-user-roles-count>۰ نقش</span>
                </div>
                <div class="ac-user-role-section">
                    <label class="ac-user-role-label" for="acUserRoleSelect">نقش‌های اختصاص‌یافته</label>
                    <div class="ac-user-role-list" data-user-roles>
                        <p class="ac-muted">برای انتخاب نقش‌ها یک کاربر انتخاب کنید.</p>
                    </div>
                    <p>تغییر نقش‌ها پس از ذخیره دسترسی‌ها اعمال می‌شود.</p>
                </div>
            </aside>
        </div>
    </div>


    <div id="acHistoryPanel" role="tabpanel" aria-labelledby="acHistoryTab" hidden>
        <div class="ac-history-head">
            <div>
                <h2>تاریخچه تغییرات سطح دسترسی</h2>
                <p>هر تغییر ذخیره‌شده به‌صورت خودکار ثبت می‌شود. پیش از بازگردانی، تفاوت وضعیت فعلی بررسی خواهد شد.</p>
            </div>
            <div class="ac-toolbar-actions">
                <button class="ac-btn ac-btn-muted" type="button" data-action="history-reload">
                    <i class="fas fa-sync-alt" aria-hidden="true"></i> تازه‌سازی
                </button>
                <button class="ac-btn ac-btn-primary" type="button" data-action="history-new-point">
                    <i class="fas fa-camera" aria-hidden="true"></i> نقطه بازگردانی دستی
                </button>
            </div>
        </div>
        <div class="ac-layout ac-history-layout">
            <aside class="ac-panel" aria-label="فهرست تاریخچه">
                <div class="ac-panel-heading">
                    <h2>تغییرات ثبت‌شده <span class="ac-count" data-history-count>۰</span></h2>
                </div>
                <div class="ac-history-filters">
                    <label class="ac-search">
                        <i class="fas fa-search" aria-hidden="true"></i>
                        <input type="search" data-history-search maxlength="100"
                               placeholder="جست‌وجوی تغییرات..." aria-label="جست‌وجوی تاریخچه" />
                    </label>
                    <select data-history-kind aria-label="فیلتر نوع تغییر">
                        <option value="">همه تغییرات</option>
                        <option value="roles">نقش‌ها</option>
                        <option value="users">کاربران</option>
                        <option value="catalog">انتیتی‌ها و مجوزها</option>
                        <option value="restore">بازگردانی‌ها</option>
                        <option value="manual">نقاط دستی</option>
                    </select>
                </div>
                <div class="ac-history-items" data-history-list aria-live="polite">
                    <p class="ac-muted">برای نمایش تاریخچه این تب را انتخاب کنید.</p>
                </div>
                <div class="ac-users-pagination">
                    <button class="ac-btn ac-btn-muted" data-action="history-prev" type="button" disabled>قبلی</button>
                    <span data-history-page>صفحه ۱</span>
                    <button class="ac-btn ac-btn-muted" data-action="history-next" type="button" disabled>بعدی</button>
                </div>
            </aside>
            <section class="ac-panel" aria-label="جزئیات و بازگردانی">
                <div class="ac-panel-heading">
                    <div>
                        <h2 data-history-detail-title>جزئیات نسخه</h2>
                        <p data-history-detail-meta>یک تغییر را از تاریخچه انتخاب کنید.</p>
                    </div>
                </div>
                <div class="ac-history-detail">
                    <p class="ac-role-notice">
                        <i class="fas fa-info-circle" aria-hidden="true"></i>
                        بازگردانی تکی فقط همان تغییر را معکوس می‌کند؛ بازگردانی کامل تمام تنظیمات دسترسی را به نسخه انتخابی می‌برد.
                        رمز عبور و اطلاعات حساب کاربران تغییر نمی‌کند.
                    </p>
                    <div data-history-diff-view>
                        <div class="ac-history-diffs" data-history-diffs>
                            <div class="ac-empty"><i class="fas fa-history" aria-hidden="true"></i>
                                <p>برای مشاهده تفاوت نسخه‌ها یک تغییر انتخاب کنید.</p></div>
                        </div>
                        <div class="ac-history-actions" data-history-actions hidden>
                            <button class="ac-btn ac-btn-primary" data-action="history-preview-single" type="button">
                                <i class="fas fa-undo" aria-hidden="true"></i> بازگردانی فقط همین تغییر
                            </button>
                            <button class="ac-btn ac-btn-muted" data-action="history-preview-point" type="button">
                                <i class="fas fa-history" aria-hidden="true"></i> بازگردانی کل تنظیمات به این نقطه
                            </button>
                        </div>
                    </div>
                    <div class="ac-history-preview" data-history-preview-pane hidden>
                        <h3>پیش‌نمایش تغییرات بازگردانی</h3>
                        <p data-history-preview-description></p>
                        <div class="ac-history-warnings" data-history-preview-warnings></div>
                        <div class="ac-history-diffs" data-history-preview-diffs></div>
                        <div class="ac-history-actions">
                            <button class="ac-btn ac-btn-muted" data-action="history-preview-cancel" type="button">بازگشت</button>
                            <button class="ac-btn ac-btn-primary" data-action="history-restore" type="button" disabled>
                                <i class="fas fa-check-circle" aria-hidden="true"></i> تأیید بازگردانی
                            </button>
                        </div>
                    </div>
                    <p class="ac-error" data-history-error role="alert" hidden></p>
                </div>
            </section>
        </div>
    </div>

    <div class="modal fade" id="acHistoryPointModal" tabindex="-1" aria-hidden="true"
         aria-labelledby="acHistoryPointTitle">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content ac-modal" data-history-point-form>
                <div class="modal-header">
                    <h2 class="modal-title" id="acHistoryPointTitle">ایجاد نقطه بازگردانی</h2>
                    <button class="ac-close" type="button" data-bs-dismiss="modal" aria-label="بستن">×</button>
                </div>
                <div class="modal-body ac-fields">
                    <label>عنوان نقطه بازگردانی
                        <input name="title" required minlength="3" maxlength="100"
                               placeholder="مثلاً تنظیمات تأییدشده سطح دسترسی" />
                    </label>
                    <p class="ac-muted">وضعیت فعلی نقش‌ها و مجوزها ثبت می‌شود؛ اطلاعات شخصی کاربران یا رمزهای عبور ذخیره نمی‌شود.</p>
                    <p class="ac-error" data-history-point-error role="alert" hidden></p>
                </div>
                <div class="modal-footer">
                    <button class="ac-btn ac-btn-muted" data-bs-dismiss="modal" type="button">انصراف</button>
                    <button class="ac-btn ac-btn-primary" type="submit">ثبت نقطه بازگردانی</button>
                </div>
            </form>
        </div>
    </div>

    <div class="modal fade" id="acUserProfileModal" tabindex="-1" aria-hidden="true" aria-labelledby="acUserProfileModalTitle">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
            <form class="modal-content ac-modal" data-user-profile-form autocomplete="off">
                <div class="modal-header">
                    <h2 class="modal-title" id="acUserProfileModalTitle">افزودن کاربر</h2>
                    <button class="ac-close" type="button" data-bs-dismiss="modal" aria-label="بستن">×</button>
                </div>
                <div class="modal-body">
                    <div class="ac-user-profile-fields">
                        <label>نام
                            <input name="firstName" maxlength="100" required autocomplete="off" />
                        </label>
                        <label>نام خانوادگی
                            <input name="lastName" maxlength="100" required autocomplete="off" />
                        </label>
                        <label>نام کاربری
                            <input name="userName" maxlength="100" required minlength="3" autocomplete="new-username"
                                   dir="ltr" />
                        </label>
                        <label>شماره همراه
                            <input name="phoneNumber" maxlength="30" minlength="8" required type="tel"
                                   autocomplete="off" dir="ltr" placeholder="09123456789" />
                        </label>
                        <label>ایمیل (اختیاری)
                            <input name="email" maxlength="256" type="email" autocomplete="off" dir="ltr" />
                        </label>
                        <label>شماره داخلی (اختیاری)
                            <input name="internalTels" maxlength="250" autocomplete="off"
                                   dir="ltr" placeholder="101,102" />
                        </label>
                        <label>سمت کاری (اختیاری)
                            <select name="positionId" data-user-profile-position>
                                <option value="">بدون سمت کاری</option>
                            </select>
                        </label>
                        <label>رمز عبور <span data-user-password-hint>برای حساب جدید الزامی است</span>
                            <input name="password" type="password" minlength="3" maxlength="128"
                                   autocomplete="new-password" required />
                        </label>
                    </div>
                    <fieldset class="ac-user-profile-fieldset">
                        <legend>نوع حساب</legend>
                        <div class="ac-user-profile-checks">
                            <label><input type="checkbox" name="isEmployee" /> کارمند</label>
                            <label><input type="checkbox" name="isCustomer" /> مشتری</label>
                            <label><input type="checkbox" name="isSupplier" /> تأمین‌کننده</label>
                        </div>
                        <p>حداقل یک نوع حساب انتخاب کنید. نوع حساب مستقل از نقش‌های دسترسی است.</p>
                    </fieldset>
                    <fieldset class="ac-user-profile-fieldset">
                        <legend>نقش‌های دسترسی <span data-user-profile-role-count>۰ انتخاب</span></legend>
                        <div class="ac-user-profile-roles" data-user-profile-roles>
                            <p class="ac-muted">در حال دریافت نقش‌ها...</p>
                        </div>
                        <p>انتخاب نقش‌ها اختیاری است. مجوزهای اختصاصی را می‌توانید در صفحه اصلی تنظیم کنید.</p>
                    </fieldset>
                    <p class="ac-error" data-user-profile-error role="alert" hidden></p>
                </div>
                <div class="modal-footer">
                    <button class="ac-btn ac-btn-muted" type="button" data-bs-dismiss="modal">انصراف</button>
                    <button class="ac-btn ac-btn-primary" type="submit">ذخیره کاربر</button>
                </div>
            </form>
        </div>
    </div>

    <div class="modal fade" id="acRoleDeleteModal" tabindex="-1" aria-hidden="true"
         data-bs-backdrop="static" aria-labelledby="acRoleDeleteTitle">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
            <form class="modal-content ac-modal" data-role-delete-form>
                <div class="modal-header">
                    <h2 class="modal-title" id="acRoleDeleteTitle">حذف نقش</h2>
                    <button class="ac-close" type="button" data-bs-dismiss="modal" aria-label="بستن">×</button>
                </div>
                <div class="modal-body">
                    <p class="ac-role-delete-guide">
                        در برخی قسمت‌های فعلی CRM هنوز کنترل دسترسی مستقیماً به نام نقش وابسته است؛
                        تغییر نام یا حذف آن نقش‌ها تا زمان انتقال کنترلرها به مجوزمحوری می‌تواند دسترسی قدیمی را قطع کند.
                    </p>
                    <div class="ac-role-delete-summary">
                        <strong data-role-delete-impact>در حال بررسی کاربران...</strong>
                        <span data-role-delete-progress>۰ از ۰ مجوز تعیین تکلیف شده</span>
                    </div>
                    <div class="ac-role-delete-bulk">
                        <strong>تعیین تکلیف کلی</strong>
                        <div class="ac-role-delete-buttons">
                            <button class="ac-btn ac-btn-muted" type="button" data-delete-all="keep">حفظ اختصاصی همه</button>
                            <button class="ac-btn ac-btn-muted" type="button" data-delete-all="remove">حذف مجوزهای همه</button>
                            <button class="ac-btn ac-btn-muted" type="button" data-delete-all="reset">پاک‌کردن انتخاب‌ها</button>
                        </div>
                        <small>انتخاب کلی روی تمام مجوزهای وابسته اعمال می‌شود. سپس می‌توانید تصمیم هر کاربر و هر مجوز را مستقل تغییر دهید.</small>
                    </div>
                    <label class="ac-search ac-role-delete-search">
                        <i class="fas fa-search" aria-hidden="true"></i>
                        <input type="search" data-role-delete-search placeholder="جست‌وجوی کاربر یا مجوز..."
                               maxlength="150" aria-label="جست‌وجوی کاربران وابسته" />
                    </label>
                    <div class="ac-role-delete-users" data-role-delete-users aria-live="polite"></div>
                    <p class="ac-error" data-role-delete-error role="alert" hidden></p>
                </div>
                <div class="modal-footer">
                    <button class="ac-btn ac-btn-muted" type="button" data-bs-dismiss="modal">انصراف</button>
                    <button class="ac-btn ac-btn-primary" type="submit" data-role-delete-confirm disabled>
                        تأیید و حذف نقش
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="modal fade" id="acRoleModal" tabindex="-1" aria-hidden="true" aria-labelledby="acRoleModalTitle">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content ac-modal" data-role-form>
                <div class="modal-header">
                    <h2 class="modal-title" id="acRoleModalTitle">افزودن نقش</h2>
                    <button class="ac-close" type="button" data-bs-dismiss="modal" aria-label="بستن">×</button>
                </div>
                <div class="modal-body">
                    <div class="ac-fields">
                        <label>نام نقش
                            <input name="name" maxlength="100" required autocomplete="off"
                                   placeholder="مانند کارشناس پشتیبانی" />
                        </label>
                    </div>
                    <p class="ac-form-context">نام نقش باید یکتا باشد. پس از ایجاد می‌توانید مجوزهای آن را در همین صفحه تعیین کنید.</p>
                    <p class="ac-error" data-role-form-error role="alert" hidden></p>
                </div>
                <div class="modal-footer">
                    <button class="ac-btn ac-btn-muted" type="button" data-bs-dismiss="modal">انصراف</button>
                    <button class="ac-btn ac-btn-primary" type="submit">ذخیره نقش</button>
                </div>
            </form>
        </div>
    </div>

    <div class="modal fade" id="acEntityModal" tabindex="-1" aria-hidden="true" aria-labelledby="acEntityModalTitle">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content ac-modal" data-entity-form>
                <div class="modal-header"><h2 class="modal-title" id="acEntityModalTitle">انتیتی جدید</h2>
                    <button class="ac-close" type="button" data-bs-dismiss="modal" aria-label="بستن">×</button>
                </div>
                <div class="modal-body">
                    <div class="ac-fields">
                        <label>مدل از DbContext
                            <select name="model" required data-model-select><option value="">انتخاب مدل...</option></select>
                        </label>
                        <label>عنوان فارسی
                            <input name="title" maxlength="150" required placeholder="مانند سفارشات" />
                        </label>
                        <label>کلید یکتا
                            <input name="key" maxlength="64" dir="ltr" required pattern="[A-Za-z][A-Za-z0-9]*" placeholder="Orders" />
                        </label>
                        <label>توضیحات (اختیاری)
                            <textarea name="description" maxlength="1000" rows="2"></textarea>
                        </label>
                        <label class="ac-check"><input type="checkbox" name="isActive" checked /> فعال</label>
                    </div>
                    <p class="ac-error" data-entity-error role="alert" hidden></p>
                </div>
                <div class="modal-footer">
                    <button class="ac-btn ac-btn-muted" type="button" data-bs-dismiss="modal">انصراف</button>
                    <button class="ac-btn ac-btn-primary" type="submit">ذخیره انتیتی</button>
                </div>
            </form>
        </div>
    </div>

    <div class="modal fade" id="acPermissionModal" tabindex="-1" aria-hidden="true" aria-labelledby="acPermissionModalTitle">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content ac-modal" data-permission-form>
                <div class="modal-header"><h2 class="modal-title" id="acPermissionModalTitle">دسترسی جدید</h2>
                    <button class="ac-close" type="button" data-bs-dismiss="modal" aria-label="بستن">×</button>
                </div>
                <div class="modal-body">
                    <p class="ac-form-context" data-permission-entity></p>
                    <div class="ac-fields">
                        <label>عنوان دسترسی
                            <input name="title" maxlength="150" required placeholder="مانند مشاهده" />
                        </label>
                        <label>کلید دسترسی
                            <input name="key" maxlength="64" dir="ltr" required pattern="[A-Za-z][A-Za-z0-9]*" placeholder="View" />
                        </label>
                        <p class="ac-key-preview" data-key-preview></p>
                        <label>توضیحات (اختیاری)
                            <textarea name="description" maxlength="1000" rows="2"></textarea>
                        </label>
                        <label class="ac-check"><input type="checkbox" name="isActive" checked /> فعال</label>
                        <label class="ac-check"><input type="checkbox" name="supportsScope" />
                            امکان تعیین محدوده «فقط خود / همه» برای این دسترسی</label>
                        <p class="ac-form-context">محدوده «فقط خود» فقط پس از اتصال قواعد مالکیت به ماژول، در عملیات برنامه اعمال می‌شود.</p>
                    </div>
                    <p class="ac-error" data-permission-error role="alert" hidden></p>
                </div>
                <div class="modal-footer">
                    <button class="ac-btn ac-btn-muted" type="button" data-bs-dismiss="modal">انصراف</button>
                    <button class="ac-btn ac-btn-primary" type="submit">ذخیره دسترسی</button>
                </div>
            </form>
        </div>
    </div>
</section>
@section Styles {
    <link rel="stylesheet" href="~/css/accessCatalog.css?release=7.5.5" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/accessCatalog.js?release=7.5.5" asp-append-version="true"></script>
    <script src="~/js/accessHistory.js" asp-append-version="true"></script>
}
