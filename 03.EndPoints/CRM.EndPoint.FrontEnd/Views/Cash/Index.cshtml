@model CRM.EndPoint.FrontEnd.Models.Cash.CashIndexVModel

@{
    Layout = "_Layout";
    var isFinancial = User.IsFinancial();
}


<div>
    <div class="d-flex justify-content-between flex-row-reverse gap-1 flex-wrap mb-2">

        <div id="cashBalanceContainer" class="flex-grow-1 d-flex justify-content-end">
        </div>

        <div id="cashSelectionToolbar" class="selection-bar d-none mt-2">
            <div class="d-none d-lg-flex align-items-center gap-3">
                <label class="d-flex align-items-center gap-3">
                    <input type="checkbox" class="select-all" />
                    <span>انتخاب همه</span>
                </label>
            </div>

            <div class="col-12 col-lg-auto flex-center flex-wrap gap-3" style="color: #444">
                <span class="selected-count fbold" style="color: var(--color8)">0</span>
                <span>مورد انتخاب شده</span>

                <button class="clear-selection link-green" style="font-size: 13px">
                    حذف انتخاب
                </button>
            </div>

            <div class="col-12 col-lg-auto d-flex align-items-center justify-content-between justify-content-lg-end gap-3">
                <button class="cancel-selection buttonCancel-white">
                    <svg style="width: 16px" viewBox="0 0 20 20" fill="currentColor"><path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" /></svg>
                    انصراف
                </button>

                <button class="selection-action-btn buttonGreen0" disabled>
                    ارسال همه (<span class="selected-count">0</span>)
                </button>
            </div>
        </div>

        <div class="d-flex flex-column align-items-start gap-2 flex-grow-1">
            <div class="d-flex column-gap-2 align-items-center justify-content-between flex-wrap">
                <ul class="filter-switch mt-2 mt-md-0">
                    <li class="filter-switch-item">
                        <input type="radio" name="cashViewType" id="cashViewTypeAll" value="cashes" @(!isFinancial ? "checked" : "")>
                        <label for="cashViewTypeAll" class="flex-center gap-2">
                            <i class="fa fa-list me-1"></i> ریز تنخواه‌ها
                        </label>
                    </li>
                    <li class="filter-switch-item">
                        <input type="radio" name="cashViewType" id="cashViewTypeGroups" value="groups" @(isFinancial ? "checked" : "")>
                        <label for="cashViewTypeGroups" class="flex-center gap-2">
                            <i class="fa fa-folder-open me-1"></i> گروه‌های ارسالی
                        </label>
                    </li>
                </ul>
            </div>
            <button id="cashModalBtn" class="buttonGray2 d-flex align-items-center gap-1 @(isFinancial ? "d-none" : "")" style="padding: 4px 8px" data-bs-toggle="modal" data-bs-target="#cashModal">
                <span style="line-height: 1">ثبت تنخواه</span>
                <svg style="width: 20px" viewBox="0 0 20 20" fill="currentColor"><path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" /></svg>
            </button>
        </div>
    </div>

    <div id="cashItemsContainer" class="@(isFinancial ? "d-none" : "")" style="width: 99%;">
        <table class="table table-striped table-bordered table-hover nowrap w-100" id="cashTable">
            <thead>
            <tr>
                <th>شماره</th>
                <th>گروه</th>
                <th>تاریخ ثبت</th>
                <th>عنوان هزینه</th>
                <th>مرکز هزینه</th>
                <th>تاریخ پرداخت</th>
                <th>مبلغ</th>
                <th>کارمزد</th>
                <th>مبلغ نهایی</th>
                <th>شرح هزینه</th>
                <th>ثبت توسط</th>
                <th>وضعیت</th>
                <th>عملیات</th>
            </tr>
            </thead>
        </table>
    </div>

    <div id="cashGroupsContainer" class="@(!isFinancial ? "d-none" : "")" style="width: 99%;">
        <table class="table table-striped table-bordered table-hover nowrap w-100" id="cashGroupTable">
            <thead>
            <tr>
                <th>شماره گروه</th>
                <th>تاریخ ارسال</th>
                <th>ثبت توسط</th>
                <th>تعداد اقلام</th>
                <th>مجموع مبلغ</th>
                <th>وضعیت</th>
                <th>عملیات</th>
            </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>


<partial name="Modals/_CashGroupDetailModal" model="Model" />
<partial name="Modals/_CashModal" model="Model" />

@section Scripts {
    <script data-page-bindings="">
        window.isAdminOrFinancial = @(isFinancial || User.IsAdmin() ? "true" : "false");
    </script>
    <script src="~/js/cash.js?release=7.0.5" data-page-bindings="cashAttachments,searchVarCash,cashConfigFilter,cashTbl,cashGroupTbl,cashModalTbl,currentCashGroupId,currentCashGroupExported,cashViewType,cashData,modelCash,cashOrderHeadsSelectedIds,cashModal,cashGroupDetailModal,costCenterElm,refreshCashView,getBalanceCashier,initCashierSelectOpt,showEditCashModal,sendCashToExternalSoftwares,deleteCash,submitCashModal,changeStatusCash,changeStatusAllCashToPending,changeStatusGroupCashToPending,approveCashGroup,rejectCashGroup,getAllCashesDt,callBackCashFilter,initCashierBalanceUI,switchCashView,updateCashModalActionButtons,getAllCashesGroupDt,cashGroupModal,cashModalSelection,getAllCashesModalDt,exportGroupCashToExcel,showAddCashOrderHeadModal" asp-append-version="true"></script>
}
