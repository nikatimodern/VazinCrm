@model IList<CRM.EndPoint.FrontEnd.Models.Cash.CashierDto>

<!-- Modal cashier -->
<div class="modal fade" id="cashierModal" tabindex="-1" role="dialog" data-bs-focus="false">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content col-12 p-2">
            <div class="text-center text-white rounded py-1 fbold" style="background-color: #6c757d">ثبت تنخواه دار</div>
            <div class="modal-body pb-2">
                <form id="cashierForm" class="d-flex flex-column gap-2">
                    <div>
                        <label for="cashierCostTitle">عنوان: </label>
                        <input id="cashierCostTitle" class="form-control" name="title" required>
                    </div>

                    <div>
                        <label for="cashierUser">کاربر:</label>
                        <select id="cashierUser" class="show-dropdown-arrow" name="userId" required></select>
                    </div>

                    @foreach (var item in Model ?? []) {
                        var selectId = $"tafsiliCodeId-{item.ExternalSoftware.Code}";

                        <div>
                            <label for="@selectId">
                                شماره تفصیلی نرم افزار @item.ExternalSoftware.Title
                            </label>
                            <select id="@selectId" class="show-dropdown-arrow tafsili-code-select" data-external-id="@item.ExternalSoftware.Id" required>
                                <option value="">انتخاب کنید</option>

                                @foreach (var option in item.SelectOptions ?? []) {
                                    <option value="@option.Value">@option.Text</option>
                                }
                            </select>
                        </div>
                    }


                    <div class="d-flex justify-content-center gap-1 mt-2">
                        <button type="button" class="buttonCancel2" style="padding-block: 4px" data-bs-dismiss="modal">انصراف</button>
                        <button type="button" class="buttonGreen3" style="padding-block: 4px" onclick="submitCashierModal()">ثبت</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>