        const getCountOfCustomerPartialTop = () => {
            if (window.innerWidth < 1200) {
                return 2;
            } else if (window.innerWidth >= 1200 && window.innerWidth < 1500) {
                return 3;
            } else if (window.innerWidth >= 1500 && window.innerWidth < 1830) {
                return 4;
            } else {
                return 5;
            }
        };


        let skipCus;
        let takeCus;
        const ShowAllCustomer = () => {
            loadCustomers(skipCus, takeCus);
            skipCus += takeCus;
        };

        let isLoading = false;
        function loadCustomers(skip = 0, take) {
            if (isLoading) return;
            if (take === undefined) {
                take = getCountOfCustomerPartialTop();
                takeCus = take * 12;
                skipCus = 0;
            }
            isLoading = true;
            LoadingCustomer.style.display = "flex";

            const { juridicalType = -1, roleType = -1 } = getUrlParams();
            fetch(`/Customer/GetAllCustomerPartial?skip=${skip}&take=${take}&roleType=${roleType}&juridical=${juridicalType}`)
                .then(res => res.text())
                .then(html => {
                    const trimmed = html.trim();
                    if (trimmed.includes("no-customer-found")) {
                        ShowAllBtn.style.display = "none";
                        if (skip === 0) {
                            document.getElementById("CustomerPartial").innerHTML = trimmed;
                        }
                        return;
                    }

                    const container = document.getElementById("CustomerPartial");
                    if (skip === 0) {
                        container.innerHTML = trimmed;
                    } else {
                        const temp = document.createElement("div");
                        temp.innerHTML = trimmed;

                        Array.from(temp.children).forEach(el => container.appendChild(el));
                    }
                })
                .catch(err => {
                    console.error("خطا در بارگذاری مشتری:", err);
                    setTimeout(() => loadCustomers(), 2000);
                })
                .finally(() => {
                    isLoading = false;
                    LoadingCustomer.style.display = "none";
                });

            ShowAllBtn.style.display = "flex";
        }


        const SearchAllCustomer = (search) => {
            LoadingCustomer.style.display = "flex";
            const container = document.getElementById("CustomerPartial");

            const { juridicalType = -1, roleType = -1 } = getUrlParams();
            axios(`/Customer/SearchAllCustomerPartial?val=${search}&roleType=${roleType}&juridical=${juridicalType}`).then((res) => {
                LoadingCustomer.style.display = "none";
                ShowAllBtn.style.display = "none";
                container.innerHTML = res.data;
            }).catch(() => {
                setTimeout(() => SearchAllCustomer(), 3000);
            });
        };

        function getAllCustomers() {
            const { search = "" } = getUrlParams();
            if (search.length !== 0)
                SearchAllCustomer(search);
            else {
                loadCustomers();
            }
