        // ۳. باز کردن مودال و لود دیتاتیبل `#cashTableModal`
        function openGroupDetailModal(groupId, groupNumber, userCreator, sendDate, itemsCount, totalAmount) {
            currentGroupIdForModal = groupId;

            document.getElementById("modalGroupNumber").textContent = groupNumber;
            document.getElementById("modalGroupUser").textContent = userCreator;
            document.getElementById("modalGroupDate").textContent = sendDate ? sendDate.split(" ")[0] : "-";
            document.getElementById("modalGroupCount").textContent = itemsCount;
            document.getElementById("modalGroupTotal").textContent = totalAmount ? totalAmount.toLocaleString() : "0";

            ModalToggle("cashGroupDetailModal");

            const cashTable = document.querySelector("#cashTableModal");
            if (cashTable && typeof $.fn !== "undefined" && $.fn.DataTable && $.fn.DataTable.isDataTable("#cashTableModal")) {
                cashTableModalDt.ajax.reload();
            } else {
                initModalCashDataTable();
            }


        }

        // ۴. ساخت DataTable اقلام مودال
        function initModalCashDataTable() {
            cashTableModalDt = $("#cashTableModal").DataTable({
                paging: false,
                processing: true,
                serverSide: true,
                ajax: {
                    url: `/Cash/GetAllCashesDt`,
                    type: "POST",
                    data: (d) => {
                        d.model = JSON.stringify({ ...modelCash, entityId: currentGroupIdForModal });
                    },
                },
                language: languageDatatable,
                columnDefs: [
                    { targets: [11, 12], orderable: false },
                    { targets: [6, 7], render: data => `<span dir="ltr">${data ? data.toLocaleString() : "-"}</span>` },
                    { targets: [8], render: data => `<span dir="ltr" class="fbold">${data ? data.toLocaleString() : "-"}</span>` },
                ],
                columns: [
                    { data: "serial" },
                    { data: "cashGroup.groupNumber" },
