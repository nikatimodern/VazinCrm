<!-- Modal AddItemFactor -->
<div class="modal fade" id="ItemFactorModal" tabindex="-1" role="dialog" data-bs-focus="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content col-12" style="padding:10px">
            <div class="modal-header p-0 border-0">
                <div class="factor-modal-title">افزودن آیتم فاکتور</div>
            </div>

            <div class="modal-body pb-2">
                <div>
                    <form id="FacItem" class="d-flex flex-column gap-2 w-100">
                        <div class="d-flex flex-column">
                            <div class="d-flex justify-content-between w-100">
                                <label>محصول</label>
                                <div id="FprintableAlertId" class="d-flex gap-2" style="font-size:10px">
                                    <div class="d-flex align-items-center gap-1">
                                        <label for="f_printableF">غیر چاپدار</label>
                                        <input type="radio" name="printable" class="valueNumber" id="f_printableF" data-alertId="FprintableAlertId" value="0" required />
                                    </div>
                                    <div class="d-flex align-items-center gap-1">
                                        <label for="f_printableT">چاپدار</label>
                                        <input type="radio" name="printable" class="valueNumber" id="f_printableT" data-alertId="FprintableAlertId" value="1" required />
                                    </div>
                                </div>
                            </div>
                            <select class="w-100 center fs-6 show-dropdown-arrow" name="productCode" id="productCode">
                            </select>
                        </div>
                        <div class="d-flex flex-column align-items-center">
                            <label>شرح کالا</label>
                            <input class="form-control" type="text" name="product" id="product" style="direction:rtl" />
                        </div>
                        <div class="d-flex flex-column align-items-center">
                            <label>تعداد/مقدار </label>
                            <input class="form-control" type="number" name="weightCount" id="weightCount" required />
                        </div>
                        <div class="d-flex flex-column align-items-center">
                            <label>واحد</label>
                            <select class="form-control valueNumber" style="width:100%;" name="unit" id="unit" disabled required>
                            </select>
                        </div>
                        <div class="d-flex flex-column align-items-center">
                            <label>مبلغ واحد (ریال)</label>
                            <input inputmode="numeric" class="currencyNumber form-control inpAmount" type="text" name="unitAmount" id="unitAmount" required data-currency-hint="next" />
                            <span class="currencyHint"></span>
                        </div>
                        <div class="d-flex flex-column align-items-center">
                            <label for="itemDiscount">تخفیف</label>
                            <input inputmode="numeric" class="currencyNumber form-control inpAmount" type="text" name="discount" id="itemDiscount" value="0" autocomplete="off" data-currency-hint="next" />
                            <span class="currencyHint"></span>
                        </div>
                        <div class="d-flex flex-column align-items-center">
                            <label>مبلغ کل (ریال)</label>
                            <input class="currencyNumber form-control inpAmount" type="text" name="totalAmount" id="totalAmount" disabled />
                        </div>
                    </form>
                </div>

                <div class="my-3 pf-divider"></div>

                <div class="flex-center gap-1">
                    <button id="f_CancelBtnId" class="buttonCancel2" onclick="canselModalItemFactor()">انصراف</button>
                    <button id="f_AddBtnId" class="buttonGreen3" onclick="addItemFactor()">ثبت</button>
                    <div id="f_UpBtnId" class="flex-center gap-1 d-none">
                        <button class="buttonCancel2" onclick="cancelUpdateFItem()">انصراف</button>
                        <button class="buttonGreen3" onclick="updateFItem()">ثبت</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
