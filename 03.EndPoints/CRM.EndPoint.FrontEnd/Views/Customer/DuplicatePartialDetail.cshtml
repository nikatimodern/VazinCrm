@model IList<CRM.Core.Domain.Customers.Entities.Customer>

@{
    Layout = null;
}

<div style="display:flex;flex-flow:wrap;justify-content:center;">

    @if (Model.Any())
    {
        @foreach (var item in Model)
        {


            <div class="m-2" style="width:190px">

                <div class="d-flex flex-column" style="border: 1px solid rgba(0, 0, 0, .125);border-radius:25px;  background-color:white; height:100%  ">
                    <div class="image-content" style="padding: 10px 0;">
                        @if (item.Juridical == 1)
                        {
                            <div class="overlay" style="padding:10px; color:aliceblue; font-size:12px;">
                                <p class="fbold" style=" text-align:end; width:100%;">حقوقی</p>
                            </div>
                        }
                        else
                        {
                            <div class="overlay" ></div>
                        }
                        <div class=" card-image">
                            <img  style="width:100%" src="~/Img/User.png" class="rounded-circle" alt="...">
                        </div>
                    </div>

                    <div class="card-content flex-grow-1" style="margin-block:6px;padding: 0px 6px;display:flex; flex-direction:column; justify-content:space-between; width:100%;  margin-top:10px !important">
                        <div style=" height:100% ; width:100%; display:flex;flex-direction:column;justify-content:center;align-items:center  ">
                            <div style="display:flex;flex-wrap:wrap"> <span> کد مشتری : </span> <span class="fbold text-center"> @item.CustomerCode </span>  </div>
