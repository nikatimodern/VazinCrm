<div class="buttonDiv mt-2">
    <div class="d-flex justify-content-center w-100">
        <div class="flex-center flex-column w-100">
            <div class="buttonDivContent">
                <div class="d-flex align-items-center justify-content-between flex-column flex-lg-row gap-2 gap-lg-3 w-100" style="font-size:clamp(12px,2vw,14px)">
                    <div class="col d-flex justify-content-around flex-wrap gap-2 w-100" id="wallet-details">
                        <div class="gap-1 gap-lg-2 flex-center">
                            <label style="color:lightgray">مبلغ کل فاکتورها: </label>
                            <div class="fbold d-flex align-items-baseline gap-1" style="color:white;">
                                <span id="AllFacAmountId" style="font-size:clamp(14px,1.5vw,18px);">-</span>
                                <span style="color:white;font-size:clamp(12px,2vw,13px);">ريال</span>
                            </div>
                        </div>
                        <div id="AllFacPayment" class="gap-1 gap-lg-2 flex-center cursor-pointer" onclick="ShowModalCustomerListInvoice()">
                            <label style="color:lightgray">پرداخت شده:</label>
                            <div class="fbold d-flex align-items-baseline gap-1" style="color:white;">
                                <span id="AllFacPaymentId" style="font-size:clamp(14px,1.5vw,18px);">-</span>
                                <span style="color:white;font-size:clamp(12px,2vw,13px);">ريال</span>
                            </div>
                        </div>
                        <div class="gap-1 gap-lg-2 flex-center">
                            <label style="color:lightgray" id="AllreminedTitleId">مانده بدهی:</label>
                            <div class="fbold d-flex align-items-baseline gap-1" style="color:white;">
                                <span id="AllRemainedId" style="font-size:clamp(14px,1.5vw,18px);">-</span>
                                <span style="color:white;font-size:clamp(12px,2vw,13px);">ريال</span>
                            </div>
                        </div>
                    </div>
                    @if (User.IsCustomer()) {
                        <div class="walledNotCredit" id="wallet-balance">
                            <div class="d-flex align-items-center justify-content-around gap-1 gap-lg-2">
                                <span class="fMedium" style="color:lightgray">اعتبار کیف پول: </span>
                                <span class="fbold d-flex align-items-baseline gap-1 gap-xl-2" style="color:white;">
                                    <span id="WalletId" style="font-size:22px;">-</span>
                                    <span style="color:white;font-size:clamp(13px,2vw,14px);">ريال</span>
                                </span>
                            </div>
                        </div>
                    } else {
                        <div class="walledNotCredit cursor-pointer" id="wallet-balance" onclick="ShowModalInvoiceWallet()">
                            <div class="d-flex align-items-center justify-content-around gap-1 gap-lg-2">
                                <span class="fMedium" style="color:lightgray">اعتبار کیف پول: </span>
                                <span class="fbold d-flex align-items-baseline gap-1 gap-xl-2" style="color:white;">
                                    <span id="WalletId" style="font-size:22px;">-</span>
                                    <span style="color:white;font-size:clamp(13px,2vw,14px);">ريال</span>
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
