@{
    Layout = "_Layout";
}

<div class="pb-3">
    <div class="mb-3 d-flex align-items-center gap-2">
        <button class="gap-2 dashGridItem" style="padding: 5px 14px;color: #333;border-radius: 4px;border:none" onclick="ShowFilterPopup(this, ['cusFilterItem'])" data-filterVarConfig="filterDashboardConfig" data-filterCallBack="callbackFilterDashboard" data-filterContentId="ContentDashboardFilterId">
            <span>فیلتر</span>
            <svg style="width: 20px; height: 20px;" fill="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke="none"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 0 1-.659 1.591l-5.432 5.432a2.25 2.25 0 0 0-.659 1.591v2.927a2.25 2.25 0 0 1-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 0 0-.659-1.591L3.659 7.409A2.25 2.25 0 0 1 3 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0 1 12 3Z" /></svg>
        </button>
        <div id="ContentDashboardFilterId"></div>

        @*<div class="d-flex gap-2" style="padding:4px;border-radius:4px;background-color:#fff">
			<div class="gap-2" style="display:flex;align-items: center;flex-wrap: wrap;">
				<p class="dashGridItem fbold gap-2" style="padding: 2px 14px;color: #333;border-radius: 8px;background-color:#F0F1F7" data-type="Date">
					<span>اردیبهشت ماه</span>
				</p>
			</div>
			<div class="gap-2" style="display:flex;align-items: center;flex-wrap: wrap;">
				<p class="dashGridItem fbold gap-2" style="padding: 2px 14px;color: #333;border-radius: 8px;background-color:#F0F1F7" data-type="Date">
					<span>هفته جاری</span>
				</p>
			</div>
		</div>*@

    </div>

    <div class="dashGridContainer">
        <div class="dashGridItem" style="container-type: inline-size">
            <div class="dashCardItem">
                <div class="dashCardIcon" style="border-color: #006400;color:#006400;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="2" y2="22" /><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg>
                </div>
                <div class="dashCardContent">
                    <div class="d-flex align-items-center justify-content-between">
                        <span style="font-size: clamp(11px, 3.75cqw, 12px);color:gray">میزان فروش</span>
                        @* <span style="font-size: clamp(11px, 3.75cqw, 12px);color:gray" onclick="notificationChange('پیش فاکتور <b>140432</b> برای مشتری نیروپلاست توسط <b>مهدیه فتحی</b> تایید شد و در کارتابل شما قرار گرفت', '/Cartable/Index?tab=TSalesAdminId', 'actionRequired')">میزان فروش</span> *@
                    </div>
                    <div class="d-flex flex-column align-items-start flex-grow-1">
                        <div class="d-flex align-items-baseline justify-content-between flex-wrap" style="column-gap:.5rem">
                            <div class="d-flex align-items-baseline flex-wrap" style="column-gap:.25rem">
                                <span class="fbold" id="totalAmountId" style="font-size: clamp(19px, 6.4cqw, 22px);"></span>
                                <span style="font-size: clamp(11px, 3.75cqw, 13px);">ريال</span>
                                <div id="infoFactors-icon" class="Admin SalesAdmin TaminAdmin FinancialExpert FinancialAdmin ManagingDirector" style="display:none">
                                    <svg style="width: clamp(17px, 5.94cqw, 20px);height:clamp(17px, 5.94cqw, 20px)" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" /></svg>
                                </div>
                            </div>
                            <div id="infoFactors-dropdown"></div>
                        </div>
                        <div class="d-flex align-items-baseline flex-wrap" style="column-gap:.5rem;">
                            <div class="flex-shrink-0">
                                <span id="totalFactorsCountId" class="fbold" style="font-size: clamp(14px, 4.84cqw, 17px);"></span>
                                <span style="font-size:12px">فاکتور</span>
                            </div>
                            <div class="d-flex align-items-baseline gap-1" style="font-size:clamp(9px, 2.97cqw, 10px);">
                                <div style="color:#008100">
                                    <span style="font-size:8px;">(</span>
                                    <span id="exportFactorsCount" class="fbold" style="font-size: clamp(12px, 3.91cqw, 13px);"></span>
                                    <span>صادراتی</span>
                                </div>
                                /
                                <div>
                                    <span id="notExportFactorsCount" class="fbold" style="font-size: clamp(12px, 3.91cqw, 13px);"></span>
                                    <span>غیر صادراتی</span>
                                    <span style="font-size:8px;">)</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="showFactorsFromDash" onclick="redirectFromDashboard('Cartable')" class="dash-readMore" style="color:#006400;">
                        <span style="font-size:clamp(10px, 3.3cqw, 11px)">فاکتورها</span>
                        <svg style="width:clamp(16px, 5.3cqw, 18px);height:clamp(16px, 5.3cqw, 18px)" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 15.75 3 12m0 0 3.75-3.75M3 12h18" /></svg>
                    </div>
                </div>
            </div>
        </div>

        <div class="dashGridItem" style="container-type: inline-size">
            <div class="dashCardItem">
                <div class="dashCardIcon" style="border-color: #838383;color:#838383;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z" /><path d="M17 18h1" /><path d="M12 18h1" /><path d="M7 18h1" /></svg>
                </div>
                <div class="dashCardContent">
                    <div class="fbold">
                        <span id="ordersAllCount" style="font-size:clamp(19px, 6.1cqw, 20px)"></span>
                        <span style="font-size:clamp(14px, 4.7cqw, 16px)">دستور تولید</span>
                    </div>
                    <div class="d-flex flex-column align-items-start gap-1 flex-grow-1">
                        <div class="d-flex flex-column" style="font-size:11px;">
                            <div class="w-100 d-flex align-items-baseline gap-2">
                                <div style="color:rgb(0 103 139)">
                                    <span id="inOrderCount" class="fbold" style="font-size:clamp(14px, 4.5cqw, 15px)"></span>
                                    <span>ثبت اولیه</span>
                                </div>
                                /
                                <div style="color:rgb(137 139 0)">
                                    <span id="ordersProgressCount" class="fbold" style="font-size:clamp(14px, 4.5cqw, 15px)"></span>
                                    <span>مرحله تولید</span>
                                </div>
                            </div>

                            <div class="w-100 d-flex align-items-baseline gap-2">
                                <div style="color:rgb(0 131 17)">
                                    <span id="ordersDoneCount" class="fbold" style="font-size:clamp(14px, 4.5cqw, 15px)"></span>
                                    <span>آماده تحویل</span>
                                </div>
                                /
                                <div style="color:rgb(120 120 120)">
                                    <span id="ordersDeliverCount" class="fbold" style="font-size:clamp(14px, 4.5cqw, 15px)"></span>
                                    <span>تحویل شده</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="showOrdersFromDash" onclick="redirectFromDashboard('Order')" class="dash-readMore" style="color:#838383;">
                        <span style="font-size:clamp(10px, 3.3cqw, 11px)">دستور تولیدها</span>
                        <svg style="width:clamp(16px, 5.3cqw, 18px);height:clamp(16px, 5.3cqw, 18px)" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 15.75 3 12m0 0 3.75-3.75M3 12h18" /></svg>
                    </div>
                </div>
            </div>
        </div>

        <div class="dashGridItem" style="container-type: inline-size">
            <div class="dashCardItem">
                <div class="dashCardIcon" style="border-color:#b90000;color:#b90000">
                    <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" /></svg>
                </div>
                <div class="dashCardContent justify-content-center">
                    <span style="font-size:clamp(11px, 3.75cqw, 13px);color:gray">تعداد مشتریان فعال</span>
                    <div class="d-flex flex-column align-items-start">
                        <div>
                            <span class="fbold" id="allCustomerCount" style="font-size:clamp(19px, 6.4cqw, 22px);"></span>
                            <span style="font-size:clamp(11px, 3.75cqw, 13px);">مشتری</span>
                        </div>
                        <div class="w-100 d-flex align-items-baseline gap-2" style="font-size:11px;">
                            <div style="color:#008100">
                                <span id="exportCustomerCount" class="fbold" style="font-size:clamp(14px, 4.5cqw, 15px)"></span>
                                <span>صادراتی</span>
                            </div>
                            /
                            <div>
                                <span id="notExportCustomerCount" class="fbold" style="font-size:clamp(14px, 4.5cqw, 15px)"></span>
                                <span>غیر صادراتی</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="dashGridItem" style="container-type: inline-size">
            <div class="dashCardItem">
                <div class="dashCardIcon" style="border-color: #3f5f80;color:#3f5f80;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 7 4 4 20 4 20 7"></polyline><line x1="9" y1="20" x2="15" y2="20"></line><line x1="12" y1="4" x2="12" y2="20"></line></svg>
                </div>
                <div class="dashCardContent">
                    <div class="d-flex flex-column flex-grow-1 justify-content-center">
                        <span style="font-size:clamp(11px, 3.75cqw, 13px);color:gray">تعداد گزارش های ثبت‌ شده</span>
                        <span class="fbold" id="reportsCountDash" style="font-size:clamp(19px, 6.1cqw, 20px)"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="dashGridItem gridItemFinancial">
