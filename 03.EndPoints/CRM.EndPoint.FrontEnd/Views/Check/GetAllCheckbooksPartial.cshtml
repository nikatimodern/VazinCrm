@model List<CRM.EndPoint.FrontEnd.Models.ViewModel.Check.CheckbookVModel>


<div class="checkbook-grid">
    @foreach (var item in Model ?? []) {
        var checkbook = item.Checkbook;
        <div class="checkbook-card" onclick="showChecks('@checkbook.Id', '@checkbook.BankName')">
            <h5 class="checkbook-card__title">@checkbook.BankName</h5>
            @* <p class="text-muted small mb-3">شماره حساب: @checkbook.AccountNumber</p> *@

            <span class="checkbook-card__badge">@item.ChecksCount چک ثبت شده</span>
        </div>
    }
    <div class="checkbook-card" onclick="showChecks('بانک ملت - حساب ۱۲۳۴')">
        <h5 class="checkbook-card__title">بانک ملت</h5>
        <p class="text-muted small mb-3">شماره حساب: ۹۸۷۶۵۴۳۲۱</p>
        <span class="checkbook-card__badge">۱۵ چک ثبت شده</span>
    </div>

    <div class="checkbook-card" onclick="showChecks('بانک صادرات - حساب ۵۶۷۸')">
        <h5 class="checkbook-card__title">بانک صادرات</h5>
        <p class="text-muted small mb-3">شماره حساب: ۴۵۶۷۸۹۱۲۳</p>
        <span class="checkbook-card__badge">۴ چک ثبت شده</span>
    </div>
    <div class="checkbook-card card-add-dashed" onclick="openNewCheckbookModal()">
        <span class="fs-3 fbold">
            <svg style="width: 24px" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
        </span>
        <span class="fMedium small mt-1">تعریف دسته چک جدید</span>
    </div>
</div>