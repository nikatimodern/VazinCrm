@{
    var vouchers = new[] {
        new {
            Id = 1,
            Code = "WH-1405-00128",
            OrderCode = "ORD-1405-00841",
            CreatedBy = "علی رضایی",
            CreatedAt = "۱۴۰۵/۰۶/۱۶ - ۰۹:۴۲",
            Status = "در دست تحویل",
            ProductsCount = 3,
            Products = new[] {
                new { Name = "نایلون شیرینگ", Amount = "۲۵۰", Unit = "کیلوگرم" },
                new { Name = "نایلکس دسته‌دار", Amount = "۱۲۰", Unit = "کیلوگرم" },
                new { Name = "سلفون استرچ", Amount = "۸۰", Unit = "کیلوگرم" }
            }
        },


        new {
            Id = 2,
            Code = "WH-1405-00127",
            OrderCode = "ORD-1405-00839",
            CreatedBy = "محمد احمدی",
            CreatedAt = "۱۴۰۵/۰۶/۱۵ - ۱۴:۱۸",
            Status = "تحویل شد",
            ProductsCount = 5,
            Products = new[] {
                new { Name = "نایلکس رکابی", Amount = "۱۸۰", Unit = "کیلوگرم" },
                new { Name = "نایلون عریض", Amount = "۳۲۰", Unit = "کیلوگرم" }
            }
        },

        new {
            Id = 3,
            Code = "WH-1405-00126",
            OrderCode = "ORD-1405-00835",
            CreatedBy = "رضا کریمی",
            CreatedAt = "۱۴۰۵/۰۶/۱۵ - ۱۱:۰۵",
            Status = "در انتظار تایید تامین",
            ProductsCount = 2,
            Products = new[] {
                new { Name = "سلفون صنعتی", Amount = "۱۵۰", Unit = "کیلوگرم" },
                new { Name = "شیرینگ حرارتی", Amount = "۹۰", Unit = "کیلوگرم" }
            }
        }
    };
}

<div class="warehouse-vouchers-page">
    <!-- Page Header -->
    <div class="warehouse-vouchers-header">

        <div class="warehouse-vouchers-title">
            <div class="warehouse-vouchers-title-icon">
                <i class="fa-solid fa-file-invoice"></i>
            </div>

            <div>
                @* <span>مدیریت انبار</span> *@
                <h1>حواله‌های انبار</h1>
                <p>مشاهده و پیگیری حواله‌های خروج کالا</p>
            </div>
        </div>

        <button type="button" class="warehouse-voucher-create" onclick="createWarehouseVoucher()">
            <i class="fa-solid fa-plus"></i>
            <span>صدور حواله جدید</span>
        </button>
    </div>


    <!-- Filters -->
    <div class="warehouse-vouchers-toolbar">

        <div class="warehouse-vouchers-search">

            <i class="fa-solid fa-magnifying-glass"></i>

            <input type="text" id="warehouseVoucherSearch" placeholder="جستجوی شماره حواله، سفارش یا ثبت‌کننده..." autocomplete="off">

        </div>


        <div class="warehouse-voucher-filters">

            <button type="button" class="voucher-filter active" data-status="all">
                همه
            </button>

            <button type="button" class="voucher-filter" data-status="در انتظار تایید تامین">
                <span class="filter-dot pending"></span>
                در انتظار تایید
            </button>

            <button type="button" class="voucher-filter" data-status="در دست تحویل">
                <span class="filter-dot delivery"></span>
                در دست تحویل
            </button>

            <button type="button" class="voucher-filter" data-status="تحویل شد">
                <span class="filter-dot completed"></span>
                تحویل شده
            </button>

        </div>

    </div>


    <!-- Vouchers -->
    <div class="warehouse-vouchers-grid"
         id="warehouseVouchersGrid">

        @foreach (var voucher in vouchers) {
            <article class="warehouse-voucher-card"
                     data-status="@voucher.Status"
                     data-search="@($"{voucher.Code} {voucher.OrderCode} {voucher.CreatedBy}")">

                <!-- Card Header -->
                <div class="voucher-card-header">

                    <div class="voucher-card-code">

                        <div class="voucher-document-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path d="M192 112L304 112L304 200C304 239.8 336.2 272 376 272L464 272L464 512C464 520.8 456.8 528 448 528L192 528C183.2 528 176 520.8 176 512L176 128C176 119.2 183.2 112 192 112zM352 131.9L444.1 224L376 224C362.7 224 352 213.3 352 200L352 131.9zM192 64C156.7 64 128 92.7 128 128L128 512C128 547.3 156.7 576 192 576L448 576C483.3 576 512 547.3 512 512L512 250.5C512 233.5 505.3 217.2 493.3 205.2L370.7 82.7C358.7 70.7 342.5 64 325.5 64L192 64zM248 320C234.7 320 224 330.7 224 344C224 357.3 234.7 368 248 368L392 368C405.3 368 416 357.3 416 344C416 330.7 405.3 320 392 320L248 320zM248 416C234.7 416 224 426.7 224 440C224 453.3 234.7 464 248 464L392 464C405.3 464 416 453.3 416 440C416 426.7 405.3 416 392 416L248 416z" /></svg>
                        </div>

                        <div>
                            <span>شماره حواله</span>
                            <strong>@voucher.Code</strong>
                        </div>

                    </div>


                    <span class="voucher-status-badge">

                    <span class="status-indicator"></span>

                        @voucher.Status

                </span>

                </div>


                <!-- Card Information -->
                <div class="voucher-card-info">

                    <div class="voucher-card-info-item">

                    <span>
                        <i class="fa-solid fa-receipt"></i>
                        سفارش مرتبط
                    </span>

                        <strong class="order-code">
                            @voucher.OrderCode
                        </strong>

                    </div>


                    <div class="voucher-card-info-item">

                    <span>
                        <i class="fa-regular fa-user"></i>
                        ثبت‌کننده
                    </span>

                        <strong>
                            @voucher.CreatedBy
                        </strong>

                    </div>


                    <div class="voucher-card-info-item">

                    <span>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path d="M400 64h-48V12c0-6.6-5.4-12-12-12h-40c-6.6 0-12 5.4-12 12v52H160V12c0-6.6-5.4-12-12-12h-40c-6.6 0-12 5.4-12 12v52H48C21.5 64 0 85.5 0 112v352c0 26.5 21.5 48 48 48h352c26.5 0 48-21.5 48-48V112c0-26.5-21.5-48-48-48zm-6 400H54c-3.3 0-6-2.7-6-6V160h352v298c0 3.3-2.7 6-6 6z"/></svg>
                        تاریخ ثبت
                    </span>

                        <strong>
                            @voucher.CreatedAt
                        </strong>

                    </div>

                </div>


                <!-- Products -->
                <div class="voucher-card-products">

                    <div class="voucher-products-title">

                        <span>
                            اقلام حواله
                        </span>

                        <b>
                            @voucher.ProductsCount قلم
                        </b>

                    </div>


                    <div class="voucher-products-list">

                        @foreach (var product in voucher.Products.Take(2)) {
                            <div class="voucher-product">

                                <div class="voucher-product-name">
                                    @product.Name
                                </div>

                                <div class="voucher-product-amount">
                                    @product.Amount
                                    <small>@product.Unit</small>
                                </div>

                            </div>
                        }

                    </div>

                    @if (voucher.ProductsCount > 2) {
                        <div class="voucher-more-products">
                            + @(voucher.ProductsCount - 2) قلم دیگر
                        </div>
                    }

                </div>


                <!-- Card Footer -->
                <div class="voucher-card-footer">

                <span>
                    <i class="fa-solid fa-boxes-stacked"></i>
                    @voucher.ProductsCount قلم کالا
                </span>

                    <button type="button" class="voucher-view-btn" onclick="showWarehouseVoucher(@voucher.Id)">
                        مشاهده حواله
                        <i class="fa-solid fa-arrow-left"></i>
                    </button>

                </div>

            </article>
        }

    </div>


    <!-- Empty -->
    <div class="warehouse-vouchers-empty" id="warehouseVouchersEmpty">

        <div class="empty-icon">
            <i class="fa-regular fa-file-circle-xmark"></i>
        </div>

        <strong>حواله‌ای پیدا نشد</strong>

        <span>
        با تغییر فیلتر یا عبارت جستجو دوباره تلاش کنید.
    </span>

    </div>


</div>


@section Styles {
    <link rel="stylesheet" href="~/css/warehouse.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/warehouse.js" asp-append-version="true"></script>
}
