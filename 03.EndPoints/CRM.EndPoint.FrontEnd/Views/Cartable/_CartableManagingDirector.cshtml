<div class="cartable-pane col-12 p-2 d-none" id="CManagingDirectorId">
    <div class="d-flex flex-column w-100">
        <ul class="nav nav-pills" id="ManagingDirectorTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active position-relative" onclick="GetRequestManagingDirector()" id="MDRequestAmountTab" data-bs-target="#MDRequestAmountTab-pane" type="button" role="tab">
                    درخواست ها
                    <span class="badge-count cartable-tab-count d-none"></span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link position-relative" onclick="GetTransferManagingDirector()" id="MDTransferTab" data-bs-target="#MDTransferTab-pane" type="button" role="tab">
                    نقل و انتقال
                    <span class="badge-count cartable-tab-count d-none"></span>
                </button>
            </li>
        </ul>
        <div class="tab-content p-2 px-1 px-sm-2 col-12" id="tabContentManagingDirector">
            <div class="tab-pane fade show active border-0" id="MDRequestAmountTab-pane" role="tabpanel" tabindex="0" style="flex-direction:column;width:100%">

                <div class="d-flex flex-column align-items-center w-100 gap-3">
                    <div class="cartable-list-toolbar">

                        <div class="cartable-column-count">
                            تعداد: <span id="MDRequestAmountCount"></span>
                        </div>

                        <div class="search-group cartable-list-toolbar__search">
                            <input class="form-control" type="text" id="MDRequestAmountSearchId" placeholder="جستجو..." />
                            <div class="search-icon">
                                <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z" clip-rule="evenodd" /></svg>
                            </div>
                        </div>


                        <div class="d-flex gap-2">
                            <ul class="filter-switch">
                                <li class="filter-switch-item">
                                    <input type="radio" name="MDRequestAmountFilter" id="MDRequestAmountFilterAll" value="-1" />
                                    <label for="MDRequestAmountFilterAll">همه</label>
                                </li>
                                <li class="filter-switch-item">
                                    <input type="radio" name="MDRequestAmountFilter" id="MDRequestAmountFilter1" value="1" checked />
                                    <label for="MDRequestAmountFilter1">
                                        در انتظار تایید
                                        <span class="badge-count filter-count-badge"></span>
                                    </label>
                                </li>
                                <li class="filter-switch-item">
                                    <input type="radio" name="MDRequestAmountFilter" id="MDRequestAmountFilter2" value="2" />
                                    <label for="MDRequestAmountFilter2">
                                        در انتظار پرداخت
                                        <span class="badge-count filter-count-badge"></span>
                                    </label>
                                </li>

                                <li class="filter-switch-item">
                                    <input type="radio" name="MDRequestAmountFilter" id="MDRequestAmountFilter3" value="3" />
                                    <label for="MDRequestAmountFilter3">
                                        پرداخت شده
                                        <span class="badge-count filter-count-badge"></span>
                                    </label>
                                </li>

                            </ul>
                        </div>
                    </div>


                    <div class="w-100" id="MDRequestAmountContentId" style="max-height:74dvh; overflow:auto;">
                    </div>
                </div>
            </div>
            <div class="tab-pane fade border-0" id="MDTransferTab-pane" role="tabpanel" tabindex="0">

                <div class="d-flex flex-column align-items-center w-100 gap-3">
                    <div class="cartable-list-toolbar">

                        <div class="cartable-column-count">
                            تعداد: <span id="MDTransferCount"></span>
                        </div>

                        <div class="search-group cartable-list-toolbar__search">
                            <input class="form-control" type="text" id="MDTransferSearchId" placeholder="جستجو..." />
                            <div class="search-icon">
                                <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z" clip-rule="evenodd" /></svg>
                            </div>
                        </div>


                        <div class="d-flex gap-2">
                            <ul class="filter-switch">
                                <li class="filter-switch-item">
                                    <input type="radio" name="MDTransferFilter" id="MDTransferFilterAll" value="-1" />
                                    <label for="MDTransferFilterAll">همه</label>
                                </li>
                                <li class="filter-switch-item">
                                    <input type="radio" name="MDTransferFilter" id="MDTransferFilter1" value="1" checked />
                                    <label for="MDTransferFilter1">
                                        در انتظار تایید
                                        <span class="badge-count filter-count-badge"></span>
                                    </label>
                                </li>
                                <li class="filter-switch-item">
                                    <input type="radio" name="MDTransferFilter" id="MDTransferFilter2" value="2" />
                                    <label for="MDTransferFilter2">
                                        تایید شده
                                        <span class="badge-count filter-count-badge"></span>
                                    </label>
                                </li>

                                @*<li class="filter-switch-item">
                                                <input type="radio" name="MDTransferFilter" id="MDTransferFilter3" value="3" />
                                                <label for="MDTransferFilter3">
                                                    رد شده
                                                    <span class="badge-count filter-count-badge"></span>
                                                </label>
                                            </li>*@

                            </ul>
                        </div>
                    </div>


                    <div class="w-100" id="MDTransferContentId">
                        <partial name="~/Views/Transfer/_TransferTable.cshtml" model='"mdTransferTable"' />
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
