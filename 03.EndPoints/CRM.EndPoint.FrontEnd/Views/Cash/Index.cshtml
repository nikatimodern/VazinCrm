@{
    Layout = "_Layout";
}


<div>
    <div class="d-flex justify-content-between align-items-end flex-row-reverse gap-1 flex-wrap mb-2">

        <div id="cashBalanceContainer" class="flex-grow-1 d-flex justify-content-end">
        </div>

        <div id="cashSelectionToolbar" class="selection-bar d-none mt-2">
            <div class="d-none d-lg-flex align-items-center gap-3">
                <label class="d-flex align-items-center gap-3">
                    <input type="checkbox" class="select-all" />
                    <span>انتخاب همه</span>
                </label>
            </div>

            <div class="col-12 col-lg-auto flex-center flex-wrap gap-3" style="color: #444">
                <span class="selected-count fbold" style="color: var(--color8)">0</span>
                <span>مورد انتخاب شده</span>

                <button class="clear-selection link-green" style="font-size: 13px">
                    حذف انتخاب
                </button>
            </div>

            <div class="col-12 col-lg-auto d-flex align-items-center justify-content-between justify-content-lg-end gap-3">
                <button class="cancel-selection buttonCancel-white">
                    <svg style="width: 16px" viewBox="0 0 20 20" fill="currentColor"><path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" /></svg>
                    انصراف
                </button>

                <button class="selection-action-btn buttonGreen0" disabled>
                    ارسال همه (<span class="selected-count">0</span>)
                </button>
            </div>
        </div>

        <div class="d-flex flex-column align-items-start gap-2 flex-grow-1">
            <div class="d-flex column-gap-2 align-items-center justify-content-between flex-wrap">
                <ul class="filter-switch mt-2 mt-md-0">
                    <li class="filter-switch-item">
                        <input type="radio" name="cashViewType" id="cashViewTypeAll" value="cashes" checked>
                        <label for="cashViewTypeAll" class="flex-center gap-2">
                            <i class="fa fa-list me-1"></i> ریز تنخواه‌ها
                        </label>
                    </li>
                    <li class="filter-switch-item">
                        <input type="radio" name="cashViewType" id="cashViewTypeGroups" value="groups">
                        <label for="cashViewTypeGroups" class="flex-center gap-2">
                            <i class="fa fa-folder-open me-1"></i> گروه‌های ارسالی
                        </label>
                    </li>
                </ul>
            </div>
            <button id="cashModalBtn" class="buttonGray2 d-flex align-items-center gap-1" style="padding: 4px 8px" data-bs-toggle="modal" data-bs-target="#cashModal">
                <span style="line-height: 1">ثبت تنخواه</span>
                <svg style="width: 20px" viewBox="0 0 20 20" fill="currentColor"><path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" /></svg>
            </button>
        </div>
    </div>

    <div id="cashItemsContainer" style="width: 99%;">
        <partial name="_CashTablePartial" model='"cashTable"' />
    </div>

    <div id="cashGroupsContainer" class="d-none" style="width: 99%;">
        <table class="table table-striped table-bordered table-hover nowrap w-100" id="cashGroupTable">
            <thead>
            <tr>
                <th>شماره گروه</th>
                <th>تاریخ ارسال</th>
                <th>ثبت توسط</th>
                <th>تعداد اقلام</th>
                <th>مجموع مبلغ (ریال)</th>
                <th>وضعیت</th>
                <th>عملیات</th>
            </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<!-- ======================================================= -->
<!-- مودال نمایش ریز اقلام گروه (مخصوص مالی بعد از کلیک روی جزئیات) -->
<!-- ======================================================= -->
<div class="modal fade" id="cashGroupDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xxl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header d-flex justify-content-between align-items-center">
                <h5 class="modal-title fbold fs-6">
                    <i class="fa fa-folder-open text-primary me-1"></i>
                    جزئیات گروه تنخواه شماره <span id="modalGroupNumber" class="text-primary fbold"></span>
                </h5>
                <button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <!-- خلاصه وضعیت (Summary Card) بالای مودال -->
                <div class="card bg-light border-0 mb-3" style="border-radius: 8px;">
                    <div class="card-body p-3">
                        <div class="row text-center g-2 align-items-center">
                            <div class="col-6 col-md-3 border-end">
                                <span class="text-muted fs-7 d-block mb-1">ارسال‌کننده</span>
                                <strong id="modalGroupUser" class="fbold text-dark">-</strong>
                            </div>
                            <div class="col-6 col-md-3 border-end">
                                <span class="text-muted fs-7 d-block mb-1">تاریخ ارسال</span>
                                <strong id="modalGroupDate" class="fbold text-dark" dir="ltr">-</strong>
                            </div>
                            <div class="col-6 col-md-3 border-end">
                                <span class="text-muted fs-7 d-block mb-1">تعداد اقلام</span>
                                <strong id="modalGroupCount" class="fbold text-info fs-6">0</strong>
                            </div>
                            <div class="col-6 col-md-3">
                                <span class="text-muted fs-7 d-block mb-1">جمع کل مبلغ</span>
                                <strong id="modalGroupTotal" class="fbold text-success fs-6" dir="ltr">0</strong>
                                <small class="text-muted">ریال</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- فراخوانی Partial جدول اقلام جهت استفاده در داخل مودال -->
                <div style="width: 100%;">
                    <partial name="_CashTablePartial" model='"cashTableModal"' />
                </div>
            </div>

            <div class="modal-footer d-flex justify-content-between align-items-center">
                <div class="d-flex gap-2">
                    <button type="button" class="buttonGreen2 d-flex align-items-center gap-1 px-3" id="btnApproveGroup" onclick="approveCurrentGroup()">
                        <svg style="width:16px;height:16px" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                        تایید کل گروه
                    </button>

                    <button type="button" class="buttonCancel3 d-flex align-items-center gap-1 px-3" id="btnRejectGroup" onclick="rejectCurrentGroup()">
                        <svg style="width:16px;height:16px" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3" /></svg>
                        بازگشت/ارسال به تنخواه‌دار
                    </button>
                </div>

                <button type="button" class="buttonCancel-white" data-bs-dismiss="modal">بستن</button>
            </div>
        </div>
    </div>
</div>


